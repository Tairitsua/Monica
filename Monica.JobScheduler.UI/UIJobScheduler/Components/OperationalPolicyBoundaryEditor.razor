@using Monica.JobScheduler.UI.Localization
@using Monica.UI.Shared.Services

@inject IStringLocalizer<JobSchedulerResource> L
@inject TimeProvider TimeProvider
@inject MoTimeFormatter UiTime

@if (Compact)
{
    <div class="boundary-compact">
        <label><span>@Label</span><select value="@Draft.Mode" disabled="@Disabled" @onchange="SetCompactModeAsync">
            @foreach (var mode in Enum.GetValues<CronBoundaryOverrideMode>()) { <option value="@mode">@L[$"Policy:BoundaryModes:{mode}"]</option> }
        </select></label>
        @if (Draft.Mode == CronBoundaryOverrideMode.Value)
        {
            <input type="datetime-local" step="1" value="@LocalValue" disabled="@Disabled" aria-label="@Label" @onchange="SetLocalValueAsync" />
            @if (Draft.ValidationFailure != CronBoundaryValidationFailure.None) { <p class="boundary-compact__error" role="alert">@L[$"Policy:Schedule:BoundaryFailures:{Draft.ValidationFailure}"]</p> }
            else if (Draft.IsAmbiguousLocalTime) { <p class="boundary-compact__warning">@L["Policy:Schedule:AmbiguousBoundary"]</p> }
        }
        else { <p>@FormatScheduleTime(EffectiveUtc)</p> }
    </div>
}
else
{
<article class="boundary-editor">
    <div class="boundary-editor__heading">
        <MudText Typo="Typo.subtitle2" HtmlTag="h5">@Label</MudText>
        <MudIconButton Icon="@MoIcons.Restore"
                       Size="Size.Small"
                       Disabled="@(Disabled || !Draft.HasOverride)"
                       OnClick="ResetAsync"
                       aria-label="@L["Policy:Actions:ResetField"]" />
    </div>
    <div class="boundary-editor__provenance">
        <div>
            <span>@L["Policy:Provenance:Declared"]</span>
            <strong>@FormatScheduleTime(DeclaredUtc)</strong>
        </div>
        <div class="boundary-editor__operator">
            <span>@L["Policy:Provenance:Override"]</span>
            <MudSelect T="CronBoundaryOverrideMode"
                       Value="@Draft.Mode"
                       ValueChanged="SetModeAsync"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="@Disabled"
                       aria-label="@L["Policy:Schedule:BoundaryMode"]" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                <MudSelectItem T="CronBoundaryOverrideMode" Value="CronBoundaryOverrideMode.Inherit">
                    @L["Policy:BoundaryModes:Inherit"]
                </MudSelectItem>
                <MudSelectItem T="CronBoundaryOverrideMode" Value="CronBoundaryOverrideMode.None">
                    @L["Policy:BoundaryModes:None"]
                </MudSelectItem>
                <MudSelectItem T="CronBoundaryOverrideMode" Value="CronBoundaryOverrideMode.Value">
                    @L["Policy:BoundaryModes:Value"]
                </MudSelectItem>
            </MudSelect>
            @if (Draft.Mode == CronBoundaryOverrideMode.Value)
            {
                <div class="boundary-editor__inputs">
                    <MudDatePicker Date="@Draft.LocalDate"
                                   DateChanged="SetDateAsync"
                                   Label="@L["Policy:Schedule:BoundaryDate"]"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="@Disabled" AdornmentIcon="@MoIcons.Calendar" PreviousIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" ClearIcon="@MoIcons.Close" />
                    <MudTimePicker Time="@Draft.LocalTime"
                                   TimeChanged="SetTimeAsync"
                                   Label="@L["Policy:Schedule:BoundaryTime"]"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Disabled="@Disabled" AdornmentIcon="@MoIcons.Clock" ClearIcon="@MoIcons.Close" />
                </div>
                @if (Draft.ValidationFailure != CronBoundaryValidationFailure.None)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">
                        @L[$"Policy:Schedule:BoundaryFailures:{Draft.ValidationFailure}"]
                    </MudText>
                }
                else if (Draft.IsAmbiguousLocalTime)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">
                        @L["Policy:Schedule:AmbiguousBoundary"]
                    </MudText>
                }
            }
        </div>
        <div>
            <span>@L["Policy:Provenance:Effective"]</span>
            <strong>@FormatScheduleTime(EffectiveUtc)</strong>
        </div>
    </div>
</article>
}

@code {
    /// <summary>Gets whether to show the compact three-state control used by the schedule dialog.</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Gets or sets the localized start or end boundary label.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>Gets or sets the optional declaration boundary in UTC; null means no declaration boundary.</summary>
    [Parameter]
    public DateTimeOffset? DeclaredUtc { get; set; }

    /// <summary>Gets or sets the caller-owned prospective boundary, preserving inherit, no boundary and explicit time modes.</summary>
    [Parameter, EditorRequired]
    public CronBoundaryDraft Draft { get; set; } = null!;

    /// <summary>Gets or sets the immutable configured timezone used to display and validate local draft times.</summary>
    [Parameter, EditorRequired]
    public string TimeZoneId { get; set; } = string.Empty;

    /// <summary>Gets or sets whether native boundary controls are disabled during an admitted save.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Raised after a complete boundary mode, date, time or reset change.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private DateTimeOffset? EffectiveUtc => Draft.HasOverride ? Draft.OverrideUtc : DeclaredUtc;

    private string? LocalValue => Draft.LocalDate is {} date && Draft.LocalTime is {} time
        ? date.Date.Add(time).ToString("yyyy-MM-dd'T'HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture) : null;

    private Task SetCompactModeAsync(ChangeEventArgs args) => Enum.TryParse<CronBoundaryOverrideMode>(args.Value?.ToString(), out var mode)
        ? SetModeAsync(mode) : Task.CompletedTask;

    private async Task SetLocalValueAsync(ChangeEventArgs args)
    {
        var valid = DateTime.TryParseExact(args.Value?.ToString(), ["yyyy-MM-dd'T'HH:mm", "yyyy-MM-dd'T'HH:mm:ss"],
            System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var local);
        Draft.LocalDate = valid ? local.Date : null;
        Draft.LocalTime = valid ? local.TimeOfDay : null;
        await Changed.InvokeAsync();
    }

    private async Task SetModeAsync(CronBoundaryOverrideMode mode)
    {
        Draft.SetMode(mode, DeclaredUtc, TimeProvider.GetUtcNow());
        await Changed.InvokeAsync();
    }

    private async Task SetDateAsync(DateTime? value)
    {
        Draft.LocalDate = value;
        await Changed.InvokeAsync();
    }

    private async Task SetTimeAsync(TimeSpan? value)
    {
        Draft.LocalTime = value;
        await Changed.InvokeAsync();
    }

    private async Task ResetAsync()
    {
        Draft.Reset(DeclaredUtc);
        await Changed.InvokeAsync();
    }

    private string FormatScheduleTime(DateTimeOffset? value) => value is null
        ? L["Common:NotAvailable"]
        : UiTime.FormatWallTime(TimeZoneInfo.ConvertTime(value.Value, TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId)));
}
