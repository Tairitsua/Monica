@using Monica.UI.Shared.Components.Visual
@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation Clock
@implements IAsyncDisposable

<MudDialog DefaultFocus="DefaultFocus.None">
    <TitleContent><h2 class="cleanup-dialog-title">@L["Cleanup:RetireTitle"]</h2></TitleContent>
    <DialogContent>
        <div class="cleanup-dialog">
            <MoSemanticCallout Severity="MoVisualRole.Warning" Title="@L["Cleanup:RetireAction"]">@L["Cleanup:RetireBody"]</MoSemanticCallout>
            @if (_preview is { } preview)
            {
                <code class="cleanup-owner-name">@_owner</code>
                <MoFactGrid Facts="@(new MoFact[] { new(L["Cleanup:DefinitionsUnit"], preview.DefinitionCount.ToString()), new(L["Cleanup:Queued"], preview.QueuedCount.ToString()), new(L["Cleanup:Running"], preview.RunningCount.ToString()) })" />
                <p>@L["Cleanup:LastObserved"] · @Clock.FormatTimestamp(preview.LastObservedAtUtc)</p>
                @if (!preview.CanRetire)
                {
                    <MudAlert Severity="Severity.Warning" Icon="@MoIcons.Warning">@L[preview.HasActivePublisher ? "Cleanup:PublisherActive" : "Cleanup:RetirementBlocked"]</MudAlert>
                }
                <MudTextField T="string" @bind-Value="_typedOwner" Immediate="true" Label="@L["Cleanup:TypeOwner"]" Variant="Variant.Outlined" Disabled="@_busy" autocomplete="off" />
                <MudCheckBox T="bool" @bind-Value="_stopped" Label="@L["Cleanup:PublishersStopped"]" Disabled="@_busy" />
            }
            @if (_busy) { <MudProgressLinear Indeterminate="true" aria-label="@L["Cleanup:Loading"]" /> }
            @if (_error is not null) { <MudAlert Severity="Severity.Error" Icon="@MoIcons.Error">@_error</MudAlert> }
        </div>
    </DialogContent>
    <DialogActions>
        <SchedulerDecisionBackButton Disabled="@_busy" OnClick="Back" />
        <MudButton Disabled="@_busy" OnClick="RebuildAsync">@L["Cleanup:Rebuild"]</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@(!CanConfirm)" OnClick="ConfirmAsync">@L["Cleanup:ConfirmRetirement"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Gets the exact owner captured before dialog admission.</summary>
    [Parameter, EditorRequired] public string Owner { get; set; } = string.Empty;
    /// <summary>Gets the authorized, route-owned retirement preview producer.</summary>
    [Parameter, EditorRequired] public Func<string, Task<JobOwnerRetirementPreview?>> Preview { get; set; } = null!;
    /// <summary>Gets the authorized producer that rechecks the publication fence and active work.</summary>
    [Parameter, EditorRequired] public Func<JobOwnerRetirementPreview, Task<JobDefinitionMaintenanceResult?>> Apply { get; set; } = null!;
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    private readonly SchedulerOperationLifetime _lifetime = new();
    private JobOwnerRetirementPreview? _preview;
    private string _owner = string.Empty, _typedOwner = string.Empty;
    private string? _error;
    private bool _busy, _stopped, _needsRebuild;
    private bool CanConfirm => !_busy && !_needsRebuild && _preview?.CanRetire == true && _stopped
        && string.Equals(_typedOwner, _owner, StringComparison.Ordinal);
    protected override async Task OnInitializedAsync() { _owner = Owner; await RebuildAsync(); }
    private Task RebuildAsync() => RunAsync(async () =>
    {
        var preview = await Preview(_owner);
        _lifetime.TryApply(() =>
        {
            _preview = preview; _stopped = false; _typedOwner = string.Empty; _needsRebuild = preview is null;
            _error = preview is null ? L["Cleanup:Unavailable"].Value : null;
        });
    });
    private Task ConfirmAsync()
    {
        if (!CanConfirm || _preview is not { } exact) return Task.CompletedTask;
        return RunAsync(async () =>
        {
            var result = await Apply(exact);
            if (_lifetime.IsRetired) return;
            if (result?.Status == JobDefinitionMaintenanceStatus.Applied) Dialog.Close(DialogResult.Ok(result));
            else _lifetime.TryApply(() =>
            {
                _stopped = false; _needsRebuild = true;
                if (result is null) { _preview = null; _typedOwner = string.Empty; }
                _error = result?.Status == JobDefinitionMaintenanceStatus.Changed ? L["Cleanup:Changed"]
                    : result?.Status == JobDefinitionMaintenanceStatus.Blocked ? L["Cleanup:RetirementBlocked"] : L["Cleanup:Unavailable"];
            });
        });
    }
    private async Task RunAsync(Func<Task> operation)
    {
        if (_busy || _lifetime.IsRetired) return;
        _busy = true;
        try
        {
            await _lifetime.RunAsync(async _ =>
            {
                await Dialog.SetOptionsAsync(Dialog.Options with { CloseOnEscapeKey = false });
                await operation();
                if (!_lifetime.IsRetired) await Dialog.SetOptionsAsync(Dialog.Options with { CloseOnEscapeKey = true });
            });
        }
        catch (OperationCanceledException) when (_lifetime.IsRetired) { }
        finally { _lifetime.TryApply(() => _busy = false); }
    }
    private void Back() { if (!_busy) Dialog.Cancel(); }
    /// <summary>Drains preview and retirement work before releasing the dialog.</summary>
    public ValueTask DisposeAsync() => _lifetime.RetireAsync(static () => { });
}
