@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using System.Globalization
@using Monica.OpenTelemetry.UI.UIOpenTelemetry.Support
@inject IStringLocalizer<OpenTelemetryUIResource> L

<section class="telemetry-dossier" aria-label="@L["Dossier:Title"]">
    @if (Instrument is not { } instrument)
    {
        <div class="dossier-empty"><MoContentState role="status"><MoIcon Icon="@MoIcons.Sliders" Size="2.25rem" /><h2>@L["Dossier:ChooseTitle"]</h2><p>@L["Dossier:Choose"]</p></MoContentState></div>
    }
    else
    {
        <header class="dossier-heading"><span class="dossier-eyebrow">@L["Dossier:Eyebrow"]</span><code class="dossier-meter">@instrument.MeterName @if (!string.IsNullOrEmpty(instrument.MeterVersion)) { <span>· @instrument.MeterVersion</span> }</code><h2>@instrument.Name</h2>@if (!string.IsNullOrEmpty(instrument.Description)) { <p>@instrument.Description</p> }</header>
        <dl class="dossier-facts"><div><dt>@L["Dossier:Kind"]</dt><dd>@instrument.Kind</dd></div><div><dt>@L["Instrument:Unit"]</dt><dd><code>@(string.IsNullOrEmpty(instrument.Unit) ? L["Series:Unitless"].Value : instrument.Unit)</code></dd></div><div><dt>@L["Dossier:Collection"]</dt><dd>@L[instrument.IsObservable ? "Dossier:Observable" : "Dossier:Recorded"]</dd></div><div><dt>@L["Instrument:TagSets"]</dt><dd>@instrument.TagSets.Count</dd></div></dl>
        @if (instrument.Overflow) { <div class="dossier-overflow" role="note"><MoIcon Icon="@MoIcons.Info" Size="1.25rem" /><p>@L["Dossier:Overflow", instrument.DroppedSamples]</p></div> }
        @if (instrument.TagSets.Count == 0)
        {
            <div class="dossier-no-series"><MoContentState role="status" Compact="true"><h3>@L["Dossier:UnmeasuredTitle"]</h3><p>@L["Dossier:Unmeasured"]</p></MoContentState></div>
        }
        else
        {
            <div class="dossier-series-heading"><div><span class="dossier-eyebrow">@L["Series:Eyebrow"]</span><h3>@L["Series:Title"]</h3></div><span>@L["Series:Available", instrument.TagSets.Count]</span></div>
            <div class="series-frame">
                <table class="series-table"><thead><tr><th scope="col">@L["Table:Tags"]</th><th scope="col">@L["Table:Current"]</th><th scope="col">@L["Table:Samples"]</th></tr></thead><tbody>
                    @foreach (var tagSet in instrument.TagSets.Skip((_seriesPage - 1) * SeriesPageSize).Take(SeriesPageSize))
                    {
                        var selected = ReferenceEquals(Series, tagSet);
                        <tr class="@(selected ? "is-selected" : null)"><td data-label="@L["Table:Tags"]"><button type="button" class="series-choice" aria-pressed="@(selected ? "true" : "false")" data-series-key="@tagSet.Key" @onclick="@(() => OnSelectSeries.InvokeAsync(tagSet))">@if (tagSet.Tags.Count == 0) { <span>@L["Series:Untagged"]</span> } else { @foreach (var tag in tagSet.Tags) { <span><code>@tag.Key</code><span>=</span><code>@tag.Value</code></span> } }</button></td><td data-label="@L["Table:Current"]"><code title="@Raw(tagSet.CurrentValue)">@(tagSet.Samples.Count == 0 ? "—" : Format(tagSet.CurrentValue))</code></td><td data-label="@L["Table:Samples"]"><code>@tagSet.Samples.Count</code></td></tr>
                    }
                </tbody></table>
                <footer class="dossier-pager"><span>@L["Registry:Shown", (_seriesPage - 1) * SeriesPageSize + 1, Math.Min(_seriesPage * SeriesPageSize, instrument.TagSets.Count), instrument.TagSets.Count]</span>@if (SeriesPageCount > 1) { <MudPagination Count="@SeriesPageCount" Selected="_seriesPage" SelectedChanged="SetSeriesPage" Color="Color.Default" Size="Size.Small" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" /> }</footer>
            </div>
            @if (Series is { } series)
            {
                <div class="selected-series" data-selected-series-key="@series.Key"><span class="dossier-eyebrow">@L["Series:Selected"]</span><p class="selected-series-tags">@TagText(series)</p><div class="selected-series-readings"><div><span>@L["Series:LatestReading"]</span><strong data-series-current title="@Raw(series.CurrentValue)">@(series.Samples.Count == 0 ? "—" : Format(series.CurrentValue))</strong></div><div><span>@L["Series:AdjacentDelta"]</span><strong class="series-delta" data-series-delta title="@Raw(series.Delta)">@(series.Samples.Count < 2 ? "—" : Format(series.Delta))</strong></div></div><p class="series-basis">@L["Series:DeltaHelp"]</p><div class="series-timing"><span>@L["Series:LastObservation"] <time datetime="@series.LastUpdatedUtc.ToString("O")" title="@series.LastUpdatedUtc.ToString("O")">@(series.Samples.Count == 0 ? "—" : UiTime.Format(series.LastUpdatedUtc))</time></span><span>@L["Series:Retention", series.Samples.Count, SamplesPerSeries]</span></div></div>
                <div class="series-evidence"><div class="section-heading"><h3>@L["Series:HistoryTitle"]</h3><span>@L["Series:Finite", series.FiniteSampleCount, series.Samples.Count]</span></div><TelemetrySeriesPlot Samples="series.Samples" Unit="@instrument.Unit" Label="@(instrument.Name + " · " + TagText(series))" /><p class="series-basis">@L[instrument.Kind == "Histogram" ? "Series:HistogramBasis" : !instrument.IsObservable && instrument.Kind is "Counter" or "UpDownCounter" ? "Series:CounterBasis" : "Series:MeasurementBasis"]</p></div>
                @if (series.Histogram is { } histogram) { <HistogramView Histogram="histogram" Unit="@instrument.Unit" /> }
                <div class="series-ledger-heading"><div><h3>@L["Ledger:Title"]</h3><p>@L["Ledger:Help"]</p></div><span>@series.Samples.Count</span></div>
                @if (series.Samples.Count == 0) { <MoContentState role="status" Compact="true">@L["Series:NoSamples"]</MoContentState> }
                else
                {
                    <div class="sample-frame"><table class="sample-table"><thead><tr><th scope="col">@L["Ledger:Timestamp"]</th><th scope="col">@L["Ledger:Raw"]</th><th scope="col">@L["Ledger:Value"]</th><th scope="col"><span class="visually-hidden">@L["Inspector:Open"]</span></th></tr></thead><tbody>
                        @foreach (var row in series.Samples.Select((point, index) => (point, index)).Skip((_samplePage - 1) * SamplePageSize).Take(SamplePageSize))
                        {
                            <tr data-sample-index="@row.index"><td data-label="@L["Ledger:Timestamp"]"><time datetime="@row.point.TimestampUtc.ToString("O")" title="@row.point.TimestampUtc.ToString("O")">@UiTime.Format(row.point.TimestampUtc)</time></td><td data-label="@L["Ledger:Raw"]"><code data-raw-value="@Raw(row.point.Value)">@Raw(row.point.Value)</code></td><td data-label="@L["Ledger:Value"]">@Format(row.point.Value)</td><td class="sample-inspect"><MudButton Variant="Variant.Text" Color="Color.Default" OnClick="@(() => OnInspect.InvokeAsync(new TelemetrySampleRequest(series, row.index)))" aria-label="@L["Inspector:OpenSample", UiTime.Format(row.point.TimestampUtc)]">@L["Inspector:Open"]<MoIcon Icon="@MoIcons.ArrowRight" Size="1.25rem" /></MudButton></td></tr>
                        }
                    </tbody></table><footer class="dossier-pager"><span>@L["Registry:Shown", (_samplePage - 1) * SamplePageSize + 1, Math.Min(_samplePage * SamplePageSize, series.Samples.Count), series.Samples.Count]</span>@if (SamplePageCount > 1) { <MudPagination Count="@SamplePageCount" Selected="_samplePage" SelectedChanged="SetSamplePageAsync" ShowFirstButton="true" ShowLastButton="true" Color="Color.Default" Size="Size.Small" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" /> }</footer></div>
                }
            }
            else { <MoContentState role="status" Compact="true">@L["Series:Choose"]</MoContentState> }
        }
    }
</section>

@code {
    /// <summary>Gets or sets the exact selected instrument from the current detached view.</summary>
    [Parameter] public InstrumentSnapshot? Instrument { get; set; }
    /// <summary>Gets or sets the exact selected series within that instrument.</summary>
    [Parameter] public TagSetSamples? Series { get; set; }
    /// <summary>Gets or sets the successful adoption instant; source and sample UTC times remain distinct.</summary>
    [Parameter] public DateTimeOffset? CapturedAt { get; set; }
    /// <summary>Gets or sets the collector-reported per-series retained sample capacity.</summary>
    [Parameter] public int SamplesPerSeries { get; set; }
    /// <summary>Requests selection of an exact rendered series.</summary>
    [Parameter] public EventCallback<TagSetSamples> OnSelectSeries { get; set; }
    /// <summary>Requests inspection of the exact source series and original sample index.</summary>
    [Parameter] public EventCallback<TelemetrySampleRequest> OnInspect { get; set; }
    /// <summary>Notifies the dialog owner when rendered sample triggers were replaced.</summary>
    [Parameter] public EventCallback OnInspectTriggerRemoved { get; set; }
    private const int SeriesPageSize = 6;
    private const int SamplePageSize = 12;
    private int _seriesPage = 1;
    private int _samplePage = 1;
    private InstrumentSnapshot? _previousInstrument;
    private TagSetSamples? _previousSeries;
    private IReadOnlyList<MetricPointSnapshot> _visibleSamples = [];
    private int SeriesPageCount => Math.Max(1, ((Instrument?.TagSets.Count ?? 0) + SeriesPageSize - 1) / SeriesPageSize);
    private int SamplePageCount => Math.Max(1, ((Series?.Samples.Count ?? 0) + SamplePageSize - 1) / SamplePageSize);
    protected override async Task OnParametersSetAsync()
    {
        var sameInstrument = _previousInstrument is null ? Instrument is null : Instrument is not null &&
            OpenTelemetrySelectionIdentity.ReconcileInstrument(_previousInstrument, [Instrument]) is not null;
        var sameSeries = _previousSeries is null ? Series is null : Series is not null &&
            OpenTelemetrySelectionIdentity.ReconcileSeries(_previousSeries, [Series]) is not null;
        if (!sameInstrument) _seriesPage = 1;
        if (!sameInstrument || !sameSeries) _samplePage = 1;
        _previousInstrument = Instrument; _previousSeries = Series;
        _seriesPage = Math.Clamp(_seriesPage, 1, SeriesPageCount); _samplePage = Math.Clamp(_samplePage, 1, SamplePageCount);
        var visible = Series?.Samples.Skip((_samplePage - 1) * SamplePageSize).Take(SamplePageSize).ToArray() ?? [];
        var replaced = !_visibleSamples.SequenceEqual(visible); _visibleSamples = visible;
        if (replaced) await OnInspectTriggerRemoved.InvokeAsync();
    }
    private void SetSeriesPage(int page) => _seriesPage = Math.Clamp(page, 1, SeriesPageCount);
    private async Task SetSamplePageAsync(int page) { _samplePage = Math.Clamp(page, 1, SamplePageCount); _visibleSamples = Series?.Samples.Skip((_samplePage - 1) * SamplePageSize).Take(SamplePageSize).ToArray() ?? []; await OnInspectTriggerRemoved.InvokeAsync(); }
    private string Format(double value) => MetricValueFormatter.Format(value, Instrument?.Unit, L);
    private static string Raw(double value) => value.ToString("G17", CultureInfo.InvariantCulture);
    private string TagText(TagSetSamples series) => series.Tags.Count == 0 ? L["Series:Untagged"] : string.Join(" · ", series.Tags.Select(tag => $"{tag.Key}={tag.Value}"));
}
