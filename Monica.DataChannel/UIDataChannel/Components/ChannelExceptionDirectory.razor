@using Monica.UI.Shared.Services
@inject IStringLocalizer<DataChannelResource> L
@inject MoTimeFormatter UiTime

@{
    var rows = View.ExceptionRows(Query).ToArray();
    var facet = View.ExceptionRows(Query, ignoreEvidence: true).ToArray();
    (string? Key, string Label, MoVisualRole Role, int Count)[] chips =
    [
        (null, L["Design:ExFilterAll"], MoVisualRole.Primary, facet.Length),
        ("retained", L["Design:ExFilterRetained"], MoVisualRole.Error, facet.Count(c => c.Retained > 0)),
        ("historical", L["Design:ExFilterHistorical"], MoVisualRole.Warning, facet.Count(c => c.HistoricalOnly)),
        ("none", L["Design:ExFilterNone"], MoVisualRole.Neutral, facet.Count(c => c.Retained == 0)),
    ];
    var missingExact = Query.Channel is not null && !View.ById.ContainsKey(Query.Channel);
}
<section class="mo-vl-surface dc-ex-ledger" aria-labelledby="dc-ex-title">
    <header class="mo-vl-surface-heading dc-dir-head">
        <span class="mo-vl-tile mo-vl-role--error"><MoIcon Icon="@MoIcons.Warning" Size="16px" /></span>
        <div class="surface-title"><h2 id="dc-ex-title">@L["Design:ExLedgerTitle"]</h2><p>@L["Design:ExLedgerDesc"]</p></div>
        <span class="count mono">@L["Design:DirShown", rows.Length, View.Total]</span>
    </header>
    @if (Query.Channel is { } exact)
    {
        <div class="dc-exact">
            <MoIcon Icon="@MoIcons.Crosshair" Size="15px" /><span>@L["Design:ExactChannel"]</span><code class="mono">@exact</code>
            <button type="button" class="btn btn-soft btn-sm mo-vl-role--primary" @onclick="ClearScope">@L["Design:ShowAllChannels"]</button>
        </div>
    }
    <div class="dc-toolbar">
        <div class="dc-search">
            <MoIcon Icon="@MoIcons.Search" Size="15px" />
            <input type="search" value="@Query.Search" placeholder="@L["Design:ExSearchPlaceholder"]" aria-label="@L["Design:ExLedgerTitle"]"
                   @oninput="e => Change(Query with { Search = Filter(e.Value?.ToString()) })" />
            @if (!string.IsNullOrEmpty(Query.Search))
            {
                <button type="button" class="icon-btn" aria-label="@L["Design:ClearSearch"]" @onclick="() => Change(Query with { Search = null })">
                    <MoIcon Icon="@MoIcons.Close" Size="14px" />
                </button>
            }
        </div>
        <MudSelect T="string" Class="dc-select" Value="@(Query.Sort ?? string.Empty)" ValueChanged="value => Change(Query with { Sort = Filter(value) })"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" aria-label="@L["Design:SortLabel"]">
            <MudSelectItem Value="@string.Empty">@L["Design:ExSorts:Retained"]</MudSelectItem>
            <MudSelectItem Value="@("lifetime")">@L["Design:ExSorts:Lifetime"]</MudSelectItem>
            <MudSelectItem Value="@("latest")">@L["Design:ExSorts:Latest"]</MudSelectItem>
            <MudSelectItem Value="@("name")">@L["Design:ExSorts:Name"]</MudSelectItem>
        </MudSelect>
        @if (Query.Evidence is not null || !string.IsNullOrWhiteSpace(Query.Search))
        {
            <button type="button" class="btn btn-ghost btn-sm" @onclick="Reset">@L["Design:ResetFilters"]</button>
        }
    </div>

    <div class="dc-state-chips fchips" role="group" aria-label="@L["Design:EvidenceLabel"]">
        @foreach (var chip in chips)
        {
            <MoFilterChip Pill="true" ShowDot="@(chip.Key is not null)" Class="dc-chip-mark" Label="@chip.Label" Count="@chip.Count"
                          Role="chip.Role" Selected="@(Query.Evidence == chip.Key)" SelectedChanged="@(_ => Change(Query with { Evidence = chip.Key }))" />
        }
    </div>
    @if (rows.Length == 0)
    {
        <MoContentState Compact="true" Class="dc-empty">
            <span class="mo-vl-tile mo-vl-role--neutral"><MoIcon Icon="@(missingExact ? MoIcons.SearchOff : MoIcons.FilterOff)" Size="18px" /></span>
            <h2>@L[missingExact ? "Design:MissingChannelTitle" : "Design:NoMatchesTitle"]</h2>
            <p>@L[missingExact ? "Design:MissingChannelBody" : "Design:NoMatchesBody"]</p>
            <button type="button" class="btn btn-outline btn-sm" @onclick="@(missingExact ? ClearScope : Reset)">
                @L[missingExact ? "Design:ShowAllChannels" : "Design:ResetFilters"]
            </button>
        </MoContentState>
    }
    else
    {
        <div class="table-wrap dc-table-wrap">
            <table class="table dc-table dc-ex-table" aria-labelledby="dc-ex-title">
                <thead>
                    <tr>
                        <th scope="col">@L["Design:ExCols:ChannelPipeline"]</th><th scope="col">@L["Design:ExCols:Runtime"]</th>
                        <th scope="col">@L["Design:ExCols:Retained"]</th><th scope="col" class="is-num">@L["Design:ExCols:Lifetime"]</th>
                        <th scope="col">@L["Design:ExCols:Latest"]</th><th scope="col" class="is-end">@L["Design:ExCols:Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ch in rows)
                    {
                        var evidence = Query.Open(ch.Id, "exceptions").Url(true);
                        <tr class="dc-ch-row @(ch.Retained > 0 ? "is-attention" : null)" @key="ch.Id">
                            <td data-label="@L["Design:ExCols:ChannelPipeline"]">
                                <div class="dc-cell-channel">
                                    <div class="dc-ex-id-row">
                                        <a class="dc-link mono" href="@evidence">@ch.Id</a>
                                        <span class="dc-sub">@(ch.Group ?? L["Workbench:Ungrouped"].Value)</span>
                                    </div>
                                    <div class="dc-pipe-id">
                                        <code class="mono" title="@ch.PipelineId">@ch.PipelineId</code>
                                        <MoCopyButton Value="@ch.PipelineId" Label="@L["Design:CopyPipeline"]" />
                                    </div>
                                </div>
                            </td>
                            <td data-label="@L["Design:ExCols:Runtime"]"><DataChannelInitBadge State="@ch.Initialization" /></td>
                            <td data-label="@L["Design:ExCols:Retained"]"><DataChannelPoolCell Channel="ch" Href="@evidence" /></td>
                            <td data-label="@L["Design:ExCols:Lifetime"]" class="is-num">
                                <div class="dc-life-cell">
                                    <b class="mono">@ch.Lifetime.ToString("N0")</b>
                                    @if (ch.Trimmed > 0) { <small class="dc-evicted-note">@L["Design:ExEvictedSub", ch.Trimmed]</small> }
                                </div>
                            </td>
                            <td data-label="@L["Design:ExCols:Latest"]">
                                <time class="mono dc-latest @(ch.Latest is null ? "is-muted" : null)">@(ch.Latest is { } latest ? UiTime.Format(latest) : L["Design:None"].Value)</time>
                            </td>
                            <td data-label="@L["Design:ExCols:Actions"]" class="is-end">
                                <div class="dc-row-actions">
                                    <a class="btn btn-soft btn-sm mo-vl-role--error" href="@evidence">@L["Channel:Actions:Inspect"]</a>
                                    <a class="icon-btn" href="@Query.Open(ch.Id, "pipeline").Url(true)" title="@L["Design:Sheet:Tabs:Pipeline"]" aria-label="@L["Design:Sheet:Tabs:Pipeline"]"><MoIcon Icon="@MoIcons.Route" Size="15px" /></a>
                                    <button type="button" class="icon-btn" disabled="@IsBusy(ch.Id)" title="@L["Design:ClearHistoryBtn"]"
                                            aria-label="@L["Design:ClearHistoryBtn"]" @onclick="() => OnClear.InvokeAsync(ch.Id)"><MoIcon Icon="@MoIcons.ClearList" Size="15px" /></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    /// <summary>Gets or sets detached channel evidence for the ledger.</summary>
    [Parameter, EditorRequired] public DataChannelView View { get; set; } = null!;
    /// <summary>Gets or sets URL-held ledger options.</summary>
    [Parameter, EditorRequired] public DataChannelQuery Query { get; set; } = new();
    /// <summary>Applies ledger filters to the URL.</summary>
    [Parameter] public EventCallback<DataChannelQuery> OnQuery { get; set; }
    /// <summary>Requests confirmation to clear the selected channel's history.</summary>
    [Parameter] public EventCallback<string> OnClear { get; set; }
    /// <summary>Reports whether a channel is busy.</summary>
    [Parameter, EditorRequired] public Func<string, bool> IsBusy { get; set; } = null!;

    private Task Change(DataChannelQuery query) => OnQuery.InvokeAsync(query);
    private Task ClearScope() => Change(Query with { Channel = null });
    private Task Reset() => Change(Query with { Evidence = null, Search = null, Sort = null });
    private static string? Filter(string? value) => string.IsNullOrEmpty(value) ? null : value;
}
