@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Microsoft.Extensions.Localization
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.State
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<ModuleSystemResource> L
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<header class="mo-vl-masthead">
    <div class="mo-vl-masthead__identity">
        <p class="mo-vl-crumb">@L["Page:Eyebrow"]</p>
        <h1 class="mo-vl-title">@L["Page:Title"]</h1>
        @if (Session.Snapshot is { } current)
        {
            <div class="mo-vl-meta" aria-label="@L["Aria:SnapshotIdentity"]">
                <span class="mo-vl-status @OutcomeRoleClass(current.Outcome)">
                    <span class="mo-vl-status-dot" aria-hidden="true"></span>
                    @(current.IsFinal ? L["Common:Final"] : L["Common:Live"]) · @ModuleDiagnosticsDisplay.Outcome(current.Outcome, L)
                </span>
                <span class="mo-vl-sep" aria-hidden="true"></span>
                <span>@L["Common:Revision"] <span class="mo-vl-mono">#@current.Revision</span></span>
                <span class="mo-vl-sep" aria-hidden="true"></span>
                <MudTooltip Text="@current.CompositionId">
                    <button type="button" class="mo-vl-id-chip" aria-label="@L["Actions:CopyCompositionId"]" @onclick="() => CopyCompositionIdAsync(current.CompositionId)">
                        <span class="mo-vl-mono">@ShortIdentity(current.CompositionId)</span>
                        <MoIcon Size="1.5rem" Icon="@MoIcons.Copy" />
                    </button>
                </MudTooltip>
                <span class="mo-vl-sep" aria-hidden="true"></span>
                <span>@L["Common:CapturedAt", UiTime.FormatTime(current.CapturedAtUtc)]</span>
            </div>
        }
    </div>

    <div class="mo-vl-actions">
        <label class="baseline-file-button">
            <MoIcon Icon="@MoIcons.ArrowLeftRight" Size="1.25rem" />
            <span>@L["Actions:ImportBaseline"]</span>
            <InputFile OnChange="@BaselineSelected" accept="application/json,.json" />
        </label>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@MoIcons.Download"
                   OnClick="@ExportRequested">
            @L["Actions:Export"]
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@MoIcons.Refresh"
                   OnClick="@RefreshRequested"
                   Disabled="@(Session.LoadState == ModuleSystemWorkbenchLoadState.Refreshing)">
            @L["Actions:Refresh"]
        </MudButton>
        <MudIconButton Icon="@MoIcons.Help"
                       OnClick="@HelpRequested"
                       aria-label="@L["Aria:OpenHelp"]" />
    </div>
</header>

@if (Session.Comparison is { } comparison)
{
    <div class="comparison-banner">
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Info">
            @L["Comparison:Active",
                SignedDuration(comparison.TotalDurationDeltaMs),
                comparison.AddedModules.Count,
                comparison.RemovedModules.Count]
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@Session.RemoveBaseline">
                @L["Actions:RemoveBaseline"]
            </MudButton>
        </MudAlert>
    </div>
}
else if (Session.BaselineError != ModuleDiagnosticsBaselineError.None)
{
    <div class="comparison-banner">
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Error">
            @L[$"Comparison:Errors:{Session.BaselineError}"]
        </MudAlert>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Session.RefreshError))
{
    <div class="comparison-banner">
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Warning">
            @L["Load:RefreshFailed"]
            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@RefreshRequested">
                @L["Actions:Retry"]
            </MudButton>
        </MudAlert>
    </div>
}

@code {
    [Parameter, EditorRequired] public ModuleSystemWorkbenchSession Session { get; set; } = default!;
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public EventCallback ExportRequested { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> BaselineSelected { get; set; }
    [Parameter] public EventCallback HelpRequested { get; set; }

    private static string ShortIdentity(string identity) => identity.Length > 16
        ? $"{identity[..8]}…{identity[^4..]}"
        : identity;

    private async Task CopyCompositionIdAsync(string identity)
    {
        try
        {
            if (await JS.InvokeAsync<bool>("MoClipboard.copyText", identity))
            {
                Snackbar.Add(L["Common:Copied"], Severity.Success);
                return;
            }
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (Exception exception) when (exception is JSException or TaskCanceledException)
        {
            // A denied browser clipboard write receives the same localized feedback as a refused copy.
        }

        Snackbar.Add(L["Common:CopyFailed"], Severity.Error);
    }

    private static string OutcomeRoleClass(ModuleCompositionOutcome? outcome) => outcome switch
    {
        ModuleCompositionOutcome.Succeeded => "mo-vl-role--success",
        ModuleCompositionOutcome.Degraded => "mo-vl-role--warning",
        ModuleCompositionOutcome.Failed => "mo-vl-role--error",
        _ => "mo-vl-role--info"
    };

    private static string SignedDuration(double duration) =>
        $"{(duration > 0 ? "+" : duration < 0 ? "-" : string.Empty)}{ModuleDiagnosticsDisplay.Duration(Math.Abs(duration))}";
}
