@inject ConfigurationValueVisibility Visibility
@using Monica.UI.Shared.Components.Json
@using Monica.UI.Shared.Components.Dialogs
@implements IAsyncDisposable
@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent><MoDialogHeading Text="@L["Sources:File:Title", _fileView?.Source.DisplayName ?? SourceKey]" /></TitleContent>
    <DialogContent>
        <div class="configuration-source-file" aria-busy="@(_loading ? "true" : "false")">
            @if (_loading) { <MudProgressLinear Indeterminate="true" Color="Color.Info" /> }
            @if (_error is not null) { <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_error</MudAlert> }
            @if (_fileView is not null)
            {
                <header class="configuration-source-file-target">
                    <MoIcon Icon="@MoIcons.FileText" Size="1.5rem" />
                    <div><h3>@_fileView.Source.DisplayName</h3><code>@_fileView.Source.SourceKey</code><div class="configuration-source-file-badges"><span data-tone="@(_fileView.Source.IsWritable ? "info" : "secondary")">@(_fileView.Source.IsWritable ? L["Sources:Writable"] : L["Sources:ReadOnly"])</span>@if (_fileView.HasRedactions) { <span data-tone="warning">@L["Sources:File:Redacted"]</span> }</div></div>
                </header>
                <dl class="configuration-source-file-facts">
                    <div><dt>@L["Sources:File:SourceKey"]</dt><dd><code>@_fileView.Source.SourceKey</code></dd></div>
                    <div><dt>@L["Sources:File:ProviderType"]</dt><dd><code>@_fileView.Source.ProviderType</code></dd></div>
                    @if (_fileView.Source.PhysicalPath is not null) { <div class="configuration-source-file-fact-wide"><dt>@L["Sources:File:PhysicalPath"]</dt><dd><code>@_fileView.Source.PhysicalPath</code></dd></div> }
                    @if (_fileView.Source.SourcePath is not null) { <div class="configuration-source-file-fact-wide"><dt>@L["Sources:File:DeclaredPath"]</dt><dd><code>@_fileView.Source.SourcePath</code></dd></div> }
                </dl>
                @if (!Visibility.ShowSensitiveValues)
                {
                    <p class="configuration-source-file-redaction">@L["Sources:File:RedactionHelp"]</p>
                }
                <section class="configuration-source-file-content"><header><h4>@L["Sources:File:Content"]</h4></header><MoJson Value="@_fileView.Content" AllowPlainText="true" FormatOnDisplay="false" /></section>
            }
            else
            {
                <dl class="configuration-source-file-facts"><div class="configuration-source-file-fact-wide"><dt>@L["Sources:File:SourceKey"]</dt><dd><code>@SourceKey</code></dd></div></dl>
                @if (_loading) { <MoContentState Loading="true" Compact="true"><p>@L["Common:States:Loading"]</p></MoContentState> }
            }
        </div>
    </DialogContent>
    <DialogActions><div class="configuration-source-file-actions"><MudButton OnClick="Close">@L["Common:Actions:Close"]</MudButton></div></DialogActions>
</MudDialog>
