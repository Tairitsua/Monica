@using Monica.ServiceDiscovery.Facades
@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@using Monica.ServiceDiscovery.Pages
@using Monica.Core.Results
@inject ServiceDiscoveryFacade Facade
@inject IStringLocalizer<ServiceDiscoveryResource> L
@inject NavigationManager Navigation
@implements IAsyncDisposable

<section class="domain-directory">
    <header class="domain-directory-heading"><div><span>@L["Workbench:CatalogScope"]</span><h2>@L["Workbench:DomainCatalog"]</h2><p>@L["Workbench:CatalogHelp"]</p></div><MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" OnClick="RefreshAsync" Disabled="@_loading">@L["Shared:Actions:Refresh"]</MudButton></header>
    @if (_loading && !_hasCatalog) { <MudProgressLinear Indeterminate="true" /> }
    @if (_catalogError is not null) { <div class="domain-notice" role="alert"><strong>@L["Workbench:CatalogReadFailed"]</strong><p>@_catalogError</p>@if (_hasCatalog) { <p>@L["Workbench:LastSuccessfulCapture"]</p> }</div> }
    <div class="domain-directory-body">
        <aside class="domain-index">
            <div class="domain-search"><MudTextField T="string" @bind-Value="_search" Placeholder="@L["Workbench:FindDomain"]" aria-label="@L["Workbench:FindDomain"]" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" /></div>
            <div class="domain-index-label"><span>@L["Workbench:CatalogEntries"]</span><span>@(_hasCatalog ? _domains.Count.ToString() : L["Shared:Values:NotAvailable"].Value)</span></div>
            <nav aria-label="@L["Workbench:DomainCatalog"]">
                @foreach (var domain in VisibleDomains)
                {
                    <button type="button" aria-pressed="@(Selected?.Name.Equals(domain.Name,StringComparison.OrdinalIgnoreCase) == true ? "true" : "false")" @onclick="() => Select(domain.Name)"><span>@(domain.DisplayName ?? domain.Name)</span><code>@domain.Name</code><MoIcon Icon="@MoIcons.ChevronRight" Size="1.25rem" /></button>
                }
            </nav>
            @if (_hasCatalog && _domains.Count == 0) { <p class="domain-index-empty">@L["Workbench:CatalogEmpty"]</p> }
            else if (_hasCatalog && !VisibleDomains.Any()) { <p class="domain-index-empty">@L["Workbench:FilterMiss"]</p> }
        </aside>
        <div class="domain-detail-workspace">
            @if (Selected is { } selected)
            {
                <header class="domain-identity"><span>@L["Workbench:SelectedDomain"]</span><h3>@(selected.DisplayName ?? selected.Name)</h3><code>@selected.Name</code><p>@(selected.Description ?? L["Workbench:NoCatalogDescription"].Value)</p>@if (_catalogCapturedAt is { } stamp) { <small>@L["Workbench:CapturedUTC"] · <time>@stamp.ToString("HH:mm:ss")</time></small> }</header>
                @if (_servicesError is not null) { <div class="domain-notice" role="alert"><strong>@L["Workbench:DomainServicesFailed"]</strong><p>@_servicesError</p><p>@L["Workbench:DomainServicesUnavailable"]</p></div> }
                else if (_hasServices)
                {
                    <div class="domain-service-columns">
                        <section><header><span>@L["Workbench:Ownership"]</span><h4>@L["Workbench:OwnedServices"]<em>@OwnedServices.Count</em></h4><p>@L["Workbench:OwnedServicesHelp"]</p></header><div class="domain-service-ledger">@foreach (var service in OwnedServices) { <button type="button" @onclick="() => InspectAsync(service)"><span>@service.AppName</span><code>@service.AppId</code><small>@L["Workbench:InstancesCount",service.TotalInstanceCount]</small><MoIcon Icon="@MoIcons.ArrowUpRight" Size="1.25rem" /></button> } @if (OwnedServices.Count == 0) { <p>@L["Workbench:NoOwnedServices"]</p> }</div></section>
                        <section><header><span>@L["Workbench:Declarations"]</span><h4>@L["Workbench:DependentServices"]<em>@DependentServices.Count</em></h4><p>@L["Workbench:DependentServicesHelp"]</p></header><div class="domain-service-ledger">@foreach (var service in DependentServices) { <button type="button" @onclick="() => InspectAsync(service)"><span>@service.AppName</span><code>@service.AppId</code><small>@(string.Join(", ", service.GetDomainNames().DefaultIfEmpty(L["Shared:Values:Unknown"].Value)))</small><MoIcon Icon="@MoIcons.ArrowUpRight" Size="1.25rem" /></button> } @if (DependentServices.Count == 0) { <p>@L["Workbench:NoDependentServices"]</p> }</div></section>
                    </div>
                }
            }
            else if (_hasCatalog)
            {
                <div class="domain-selection-empty"><MoIcon Icon="@MoIcons.Building" Size="1.5rem" /><h3>@L[string.IsNullOrWhiteSpace(SelectedDomainName) ? "Workbench:ChooseDomain" : "Workbench:DomainUnlisted"]</h3><p>@L[string.IsNullOrWhiteSpace(SelectedDomainName) ? "Workbench:ChooseDomainHelp" : "Workbench:DomainUnlistedHelp",SelectedDomainName ?? string.Empty]</p>@if (!string.IsNullOrEmpty(SelectedDomainName)) { <code>@SelectedDomainName</code> }</div>
            }
            else
            {
                <div class="domain-selection-empty" role="status"><MoIcon Icon="@MoIcons.Building" Size="1.5rem" /><h3>@L[_loading ? "Workbench:LoadingRegistry" : "Workbench:CatalogReadFailed"]</h3><p>@L["Workbench:CatalogUnavailable"]</p></div>
            }
        </div>
    </div>
</section>
<DiscoveryInspectorHost @ref="_inspector" />

@code {
    [Parameter] public string? SelectedDomainName { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private readonly SemaphoreSlim _gate = new(1,1);
    private CancellationToken _token;
    private bool _disposed, _loading, _hasCatalog, _hasServices;
    private string _search = string.Empty;
    private string? _catalogError, _servicesError;
    private DateTime? _catalogCapturedAt, _servicesCapturedAt;
    private List<DomainInfo> _domains = [];
    private List<RegisteredServiceStatus> _services = [];
    private DiscoveryInspectorHost? _inspector;
    private DomainInfo? Selected => string.IsNullOrWhiteSpace(SelectedDomainName) ? _domains.FirstOrDefault() : _domains.FirstOrDefault(d => d.Name.Equals(SelectedDomainName,StringComparison.OrdinalIgnoreCase));
    private IEnumerable<DomainInfo> VisibleDomains => _domains.Where(d => (d.DisplayName ?? d.Name).Contains(_search,StringComparison.OrdinalIgnoreCase) || d.Name.Contains(_search,StringComparison.OrdinalIgnoreCase));
    private List<RegisteredServiceStatus> OwnedServices => _services.Where(s => s.BelongsToDomain(Selected?.Name)).OrderBy(s=>s.AppName).ToList();
    private List<RegisteredServiceStatus> DependentServices => _services.Where(s => !s.BelongsToDomain(Selected?.Name) && s.DependentSubDomains?.Contains(Selected?.Name ?? string.Empty,StringComparer.OrdinalIgnoreCase) == true).OrderBy(s=>s.AppName).ToList();
    protected override async Task OnInitializedAsync() { _token=_lifetime.Token; await RefreshAsync(); }
    private async Task RefreshAsync()
    {
        if (_disposed) return;
        try
        {
            await _gate.WaitAsync(_token);
            try
            {
                _loading=true;
                // Catalog identity and registration evidence have independent success/failure boundaries.
                var catalogTask=Facade.CaptureDomainsAsync(_token);
                var servicesTask=Facade.CaptureServicesAsync(_token);
                await Task.WhenAll(catalogTask,servicesTask);
                _token.ThrowIfCancellationRequested();
                var catalog=await catalogTask;
                if(catalog.IsFailed(out var catalogError,out var domains)) _catalogError=catalogError.Message;
                else { _domains=domains.OrderBy(d=>d.DisplayName ?? d.Name).ToList();_hasCatalog=true;_catalogCapturedAt=DateTime.UtcNow;_catalogError=null; }
                var registry=await servicesTask;
                if(registry.IsFailed(out var registryError,out var services)) _servicesError=registryError.Message;
                else { _services=services;_hasServices=true;_servicesCapturedAt=DateTime.UtcNow;_servicesError=null; }
            }
            finally { _loading=false;_gate.Release(); }
        }
        catch(OperationCanceledException) when(_token.IsCancellationRequested) { }
    }
    private void Select(string domain) => Navigation.NavigateTo(UIServiceDiscoveryDomainsPage.PAGE_URL+"?domain="+Uri.EscapeDataString(domain),replace:true);
    private Task InspectAsync(RegisteredServiceStatus service) => _inspector?.ShowAsync(service,_servicesCapturedAt) ?? Task.CompletedTask;
    public async ValueTask DisposeAsync()
    {
        if(_disposed)return;_disposed=true;await _lifetime.CancelAsync();await _gate.WaitAsync();_gate.Release();_lifetime.Dispose();
    }
}
