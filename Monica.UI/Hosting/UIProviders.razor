@inject IStringLocalizer<SharedResource> L
@* One owner per interactive root, shared across every product and operational layout. *@
<ThemeProviderHost>
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />
    @ChildContent
<div id="blazor-error-ui" data-nosnippet role="alert">
    <div class="blazor-error-ui__content">
        <span class="blazor-error-ui__icon" aria-hidden="true">
            <MoIcon Icon="@MoIcons.Error" />
        </span>
        <div class="blazor-error-ui__copy">
            <p class="blazor-error-ui__message">@L["Layout:Error"]</p>
            <p>@L["Layout:ErrorRecovery"]</p>
        </div>
        <a href="." class="reload">@L["Layout:Reload"]</a>
        <button type="button" class="dismiss" aria-label="@L["Layout:DismissError"]"><span aria-hidden="true">×</span></button>
    </div>
</div>

</ThemeProviderHost>

@code {
    /// <summary>The interactive application content. Layouts must not duplicate these providers.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
