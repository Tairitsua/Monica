@using Markdig
@using MudBlazor.Utilities
@using Markdig.Syntax.Inlines
@inject IMoMarkdownAssetResolver AssetResolver

<div class="@HostClass">
    <MoMudMarkdown Value="@Value"
                   SourceType="@SourceType"
                   MarkdownPipeline="@ResolvedMarkdownPipeline"
                   Props="@_resolvedProps"
                   Styling="@_resolvedStyling"
                   HasTableOfContents="@HasTableOfContents"
                   TableOfContentsHeader="@TableOfContentsHeader"
                   EnableMermaid="@EnableMermaid"
                   MermaidNodes="@MermaidNodes"
                   MermaidNodeActivated="@MermaidNodeActivated"
                   EnableCodeCopy="@EnableCodeCopy"
                   LinkTemplate="@LinkTemplate"
                   HeadingsChanged="@HeadingsChanged" />
</div>

@code {
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public MarkdownSourceType SourceType { get; set; } = MarkdownSourceType.RawValue;

    [Parameter]
    public string? ScopeKey { get; set; }

    [Parameter]
    public string? DocumentRelativePath { get; set; }

    [Parameter]
    public string? DocumentCulture { get; set; }

    [Parameter]
    public string StyleKey { get; set; } = "default";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool HasTableOfContents { get; set; }

    [Parameter]
    public string? TableOfContentsHeader { get; set; }

    [Parameter]
    public bool EnableMermaid { get; set; } = true;

    /// <summary>Trusted flowchart node aliases mapped to accessible labels; authored callbacks remain disabled.</summary>
    [Parameter] public IReadOnlyDictionary<string, MoMermaidNode>? MermaidNodes { get; set; }

    /// <summary>Invoked only for an alias explicitly supplied through MermaidNodes.</summary>
    [Parameter] public EventCallback<string> MermaidNodeActivated { get; set; }

    /// <summary>
    /// Enables click-to-copy for recognizable file paths in prose or inline code. Defaults to true.
    /// Other inline code, including identifiers and commands, keeps standard Markdown rendering.
    /// Authored links and fenced code blocks retain their existing interactions.
    /// </summary>
    [Parameter]
    public bool EnableCodeCopy { get; set; } = true;

    /// <summary>
    /// Gets or sets whether Markdig must treat raw HTML as plain Markdown text instead of renderable markup.
    /// </summary>
    [Parameter]
    public bool DisableHtml { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<MoMarkdownHeading>> HeadingsChanged { get; set; }

    /// <summary>
    /// Optionally renders selected non-image links using their authored destination and formatted label.
    /// Return null to retain ordinary URL resolution and navigation.
    /// </summary>
    [Parameter]
    public Func<MoMarkdownLink, RenderFragment?>? LinkTemplate { get; set; }

    [Parameter]
    public MudMarkdownProps? Props { get; set; }

    [Parameter]
    public MudMarkdownStyling? Styling { get; set; }

    private MudMarkdownProps _resolvedProps = new();
    private MudMarkdownStyling _resolvedStyling = new();

    private static readonly MarkdownPipeline HtmlDisabledPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private string HostClass => new CssBuilder("mo-markdown-host")
        .AddClass($"mo-markdown-style-{NormalizeCssSegment(StyleKey)}")
        .AddClass(Class)
        .Build();

    private MarkdownPipeline? ResolvedMarkdownPipeline => DisableHtml ? HtmlDisabledPipeline : null;

    protected override void OnParametersSet()
    {
        _resolvedProps = CreateResolvedProps();
        _resolvedStyling = CreateResolvedStyling();
    }

    private MudMarkdownProps CreateResolvedProps()
    {
        var resolved = new MudMarkdownProps();
        var source = Props;

        resolved.Link.Command = source?.Link.Command;
        resolved.Link.DisableTargetBlank = source?.Link.DisableTargetBlank ?? false;
        resolved.Link.OverrideUrl = link => ResolveUrl(link, source?.Link.OverrideUrl?.Invoke(link) ?? link.Url);
        resolved.Heading.OverrideTypo = source?.Heading.OverrideTypo;

        return resolved;
    }

    private MudMarkdownStyling CreateResolvedStyling()
    {
        var resolved = new MudMarkdownStyling();
        var source = Styling;

        if (source is null)
        {
            return resolved;
        }

        resolved.Table.IsStriped = source.Table.IsStriped;
        resolved.Table.IsBordered = source.Table.IsBordered;
        resolved.Table.Elevation = source.Table.Elevation;
        resolved.Table.CellMinWidth = source.Table.CellMinWidth;
        resolved.Table.Dense = source.Table.Dense;

        resolved.Link.Underline = source.Link.Underline;

        resolved.CodeBlock.Theme = source.CodeBlock.Theme;
        resolved.CodeBlock.CopyButton = source.CodeBlock.CopyButton;
        resolved.CodeBlock.CopyButtonText = source.CodeBlock.CopyButtonText;

        return resolved;
    }

    private string? ResolveUrl(LinkInline link, string? originalUrl)
    {
        return AssetResolver.ResolveUrl(
            originalUrl,
            link.IsImage,
            ScopeKey,
            DocumentRelativePath,
            DocumentCulture);
    }

    private static string NormalizeCssSegment(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "default";
        }

        return value.Trim().ToLowerInvariant().Replace(' ', '-');
    }
}
