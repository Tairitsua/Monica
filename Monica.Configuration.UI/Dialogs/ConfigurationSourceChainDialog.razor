@using Monica.Configuration.UI.Localization
@inject ConfigurationFacade Facade
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L
@implements IDisposable

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
        else if (_chain is null || _chain.Values.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@L["Sources:Chain:Empty"]</MudAlert>
        }
        else
        {
            <MudStack Spacing="2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">@_chain.ConfigurationPath</MudText>
                @foreach (var value in _chain.Values)
                {
                    <MudPaper Outlined="true" Class="@SourceCardClass(value)">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                            <MudStack Spacing="0">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudText Typo="Typo.subtitle2">@value.Source.DisplayName</MudText>
                                    @if (value.IsEffective)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">@L["Sources:Effective"]</MudChip>
                                    }
                                    <MudChip T="int" Size="Size.Small" Variant="Variant.Outlined">@value.Source.PriorityIndex</MudChip>
                                </MudStack>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@SourcePath(value.Source)</MudText>
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                <MudChip T="string" Size="Size.Small" Color="@(value.Source.IsWritable ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                                    @(value.Source.IsWritable ? L["Sources:Writable"] : L["Sources:ReadOnly"])
                                </MudChip>
                                @if (AllowSourceEdit && value.Source.IsWritable && value.Source.Kind == ConfigurationSourceKind.JsonFile)
                                {
                                    <MudTooltip Text="@L["Sources:Actions:EditSource"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       Color="Color.Primary"
                                                       OnClick="() => EditSourceAsync(value)" />
                                    </MudTooltip>
                                }
                            </MudStack>
                        </MudStack>
                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.body2">@DisplayValue(value)</MudText>
                        @if (!value.Source.IsWritable && !string.IsNullOrWhiteSpace(value.Source.ReadOnlyReason))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@value.Source.ReadOnlyReason</MudText>
                        }
                    </MudPaper>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@L["Common:Actions:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public ConfigurationDefinition Definition { get; set; } = null!;
    [Parameter, EditorRequired] public ConfigurationNodeDefinition Node { get; set; } = null!;
    [Parameter] public LogicalPath? LogicalPath { get; set; }
    [Parameter] public bool AllowSourceEdit { get; set; } = true;

    private ConfigurationSourceChain? _chain;
    private string? _error;
    private bool _loading = true;
    private bool _disposed;
    private long _loadGeneration;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_disposed)
        {
            return;
        }

        var generation = ++_loadGeneration;
        _loading = true;
        var result = await Facade.GetSourceChainAsync(Definition.DefinitionKey, LogicalPath ?? Node.RelativePath);
        if (_disposed || generation != _loadGeneration)
        {
            return;
        }
        if (result.IsFailed(out var error, out var chain))
        {
            _error = error.Message;
        }
        else
        {
            _chain = chain;
            _error = null;
        }

        _loading = false;
    }

    private async Task EditSourceAsync(ConfigurationSourceValue value)
    {
        var parameters = new DialogParameters<ConfigurationSourceValueEditDialog>();
        parameters.Add(dialog => dialog.Definition, Definition);
        parameters.Add(dialog => dialog.Node, Node);
        parameters.Add(dialog => dialog.SourceValue, value);
        var dialog = await DialogService.ShowAsync<ConfigurationSourceValueEditDialog>(L["Sources:Edit:Title"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        });
        if (_disposed)
        {
            dialog.Close();
            return;
        }

        var result = await dialog.Result;
        if (_disposed)
        {
            return;
        }
        if (result is { Canceled: false })
        {
            var applied = result.Data as ConfigurationMutationGroupApplyResult;
            var issues = applied?.PostCommitIssues ?? [];
            Snackbar.Add(applied?.Status == ConfigurationMutationGroupApplyStatus.PartiallyApplied
                    ? L["Group:PartiallyApplied"] : L["Sources:Edit:Saved"],
                issues.Count == 0 && applied?.Status == ConfigurationMutationGroupApplyStatus.Applied ? Severity.Success : Severity.Warning);
            await LoadAsync();
            if (!_disposed && issues.Count > 0)
            {
                var issueParameters = new DialogParameters<ConfigurationPostCommitIssuesDialog>();
                issueParameters.Add(dialog => dialog.Issues, issues);
                var issueDialog = await DialogService.ShowAsync<ConfigurationPostCommitIssuesDialog>(
                    L["Dialogs:PostCommitIssues:Title"], issueParameters,
                    ConfigurationPostCommitIssuesDialog.DefaultOptions);
                if (_disposed)
                {
                    issueDialog.Close();
                    return;
                }

                await issueDialog.Result;
            }
        }
    }

    private string SourcePath(ConfigurationSourceDescriptor source)
    {
        return source.PhysicalPath ?? source.SourcePath ?? source.ProviderType;
    }

    private string DisplayValue(ConfigurationSourceValue value)
    {
        return value.IsSensitive ? L["State:Value:Sensitive"] : value.DisplayValue ?? L["Value:States:Empty"];
    }

    private static string SourceCardClass(ConfigurationSourceValue value)
    {
        return value.IsEffective ? "pa-3 configuration-source-card effective-source" : "pa-3 configuration-source-card";
    }

    private void Close()
    {
        MudDialog.Close();
    }

    public void Dispose()
    {
        _disposed = true;
        ++_loadGeneration;
    }
}
