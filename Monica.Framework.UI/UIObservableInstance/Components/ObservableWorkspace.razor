@using Microsoft.Extensions.Options
@using Monica.Modules
@implements IAsyncDisposable
@inject ObservableWorkspaceState Workspace
@inject ObservableInstanceMonitorService MonitorService
@inject NavigationManager Navigation
@inject MoTimeFormatter Time
@inject IStringLocalizer<ObservableInstanceResource> L
@inject IOptions<ModuleShellUIOption> Shell
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<div class="mo-page-shell mo-page-shell--workbench mo-page-shell--full-width oi-page" @ref="_root">
    <MoPageMasthead Icon="@(IsExceptions ? MoIcons.Error : MoIcons.Pulse)" Title="@L[IsExceptions ? "Design:ExceptionsTitle" : "Design:MonitorTitle"]" Crumb="@L["Design:Eyebrow"]">
        <Meta>
            <span class="mo-vl-status mo-vl-status--pill @StatusRole.ToCssClass()">
                <i class="mo-vl-status-dot" aria-hidden="true"></i>@L[StatusKey]
            </span>
            <MoCopyButton Value="@Environment.MachineName" Label="@L["Design:CopyHost", Environment.MachineName]">
                <MoIcon Icon="@MoIcons.Server" Size="13px" />
                <span>@L["Design:ScopeChip", Shell.Value.GetAppName()]</span>
            </MoCopyButton>
            <span class="mo-vl-capsule mo-vl-capsule--outline mo-vl-role--neutral" title="@Time.TimeZone.Id">
                @L["Design:TzChip", Time.FormatZoneLabel(Workspace.Evidence?.ReadAt)]
            </span>
        </Meta>
        <Actions>
            <div class="oi-stamp">
                <span>@L["Design:Captured"]</span>
                @if (Workspace.Evidence is { } read)
                {
                    <time datetime="@read.ReadAt.ToString("O")" title="@Time.Format(read.ReadAt)">@Time.FormatTime(read.ReadAt)</time>
                }
                else
                {
                    <b>@L["Design:NotCaptured"]</b>
                }
            </div>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" StartIcon="@MoIcons.Refresh" Class="oi-refresh"
                       Disabled="@_busy" OnClick="RefreshAsync">@L["Design:Refresh"]</MudButton>
        </Actions>
    </MoPageMasthead>

    <MoWorkbenchNavigation Label="@L["Design:NavLabel"]" Class="oi-nav" Compact="true">
        <a href="@Link(ObservableViewQuery.MonitorPath)" aria-current="@(!IsExceptions ? "page" : null)">
            <MoIcon Icon="@MoIcons.Pulse" />
            @L["Design:MonitorTitle"]
            @if (Workspace.Evidence is { } counts)
            {
                <span class="oi-nav-count @ReviewRole(counts).ToCssClass()">@(counts.ReviewCount == 0 ? counts.Trackers.Length.ToString() : $"{counts.ReviewCount}/{counts.Trackers.Length}")</span>
            }
        </a>
        <a href="@Link(ObservableViewQuery.ExceptionsPath)" aria-current="@(IsExceptions ? "page" : null)">
            <MoIcon Icon="@MoIcons.Error" />
            @L["Design:ExceptionsTitle"]
            @if (Workspace.Evidence is { } exceptionCounts)
            {
                <span class="oi-nav-count @((exceptionCounts.Exceptions.Length > 0 ? MoVisualRole.Error : MoVisualRole.Neutral).ToCssClass())">@exceptionCounts.Exceptions.Length</span>
            }
        </a>
    </MoWorkbenchNavigation>

    @if (Workspace.ReadError is { } error && Workspace.Evidence is { } prior)
    {
        <div class="mo-vl-callout mo-vl-role--warning oi-stale" role="status">
            <span class="mo-vl-callout-mark"><MoIcon Icon="@MoIcons.Warning" Size="16px" /></span>
            <div class="mo-vl-callout-content">
                <h2 class="mo-vl-callout-title">@L["Design:StaleTitle"]</h2>
                <p class="mo-vl-callout-body">@L["Design:StaleBody", Time.Format(prior.ReadAt)] <code class="mo-vl-mono">@error</code></p>
            </div>
        </div>
    }

    @if (Workspace.Evidence is not { } evidence || evidence.Trackers.Length == 0)
    {
        var initial = Workspace.Evidence is null;
        var loading = initial && _busy;
        var failed = initial && Workspace.ReadError is not null;
        <section class="mo-vl-surface oi-state">
            <MoContentState Loading="@loading">
                <div class="mo-vl-tile @StatusRole.ToCssClass()"><MoIcon Icon="@(loading ? MoIcons.Refresh : failed ? MoIcons.Error : MoIcons.Package)" Size="18px" /></div>
                <h2>@L[loading ? "Design:LoadingTitle" : failed ? "Design:LoadFailedTitle" : "Design:EmptyTitle"]</h2>
                <p>@L[loading ? "Design:LoadingBody" : failed ? "Design:LoadFailedBody" : "Design:EmptyBody"]</p>
                @if (!loading)
                {
                    <MudButton Color="Color.Primary" Variant="@(failed ? Variant.Filled : Variant.Outlined)"
                               Size="Size.Small" StartIcon="@MoIcons.Refresh" Disabled="@_busy" OnClick="RefreshAsync">
                        @L[failed ? "Design:Retry" : "Design:Refresh"]
                    </MudButton>
                }
            </MoContentState>
        </section>
    }
    else
    {
        @if (IsExceptions)
        {
            <ObservableExceptions Evidence="evidence" Query="_query" ChangeFilters="SetFilters" Inspect="OpenInspection" />
            @ScopeFooter
        }
        else
        {
            <ObservableRegistry Evidence="evidence" Query="_query" ChangeFilters="SetFilters" Inspect="OpenInspection" Clear="ClearHistoryAsync" Busy="_busy">
                @ScopeFooter
            </ObservableRegistry>
        }
    }

    @if (_query.Inspector is { } id && Workspace.Evidence is { } capture)
    {
        <ObservableSnapshotSheet @key="id" InstanceId="@id" Snapshot="@(capture.ById.GetValueOrDefault(id)?.Snapshot)"
                                 Query="_query" ChangeInspection="OpenInspection" Closed="CloseInspection" Clear="ClearHistoryAsync" Busy="_busy" />
    }
</div>

@code {
    private RenderFragment ScopeFooter => @<footer class="oi-scope-foot"><MoIcon Icon="@MoIcons.Info" Size="14px" /><span>@L["Design:ScopeFooter"]</span></footer>;
}
