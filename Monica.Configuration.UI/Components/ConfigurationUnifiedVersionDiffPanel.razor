@inject ConfigurationValueVisibility Visibility
@using Monica.Configuration.UI.Localization
@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L
@implements IAsyncDisposable

<div class="configuration-unified-version-diff-panel" aria-busy="@((_session?.Loading ?? true) ? "true" : "false")">
    @if (_session?.Loading ?? true)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_session?.Prepared is not { } prepared)
    {
        <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@L["Common:Errors:LoadFailed"]</MudAlert>
    }
    else if (prepared.Rows.Count == 0)
    {
        <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["Versions:Diff:NoChanges"]</MudAlert>
    }
    else
    {
        <MudStack Spacing="2">
            @if (ShowSummaryHeader)
            {
                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle1">
                            @L["Versions:Diff:Title", VersionLabel(prepared.OriginVersion), VersionLabel(prepared.TargetVersion)]
                        </MudText>
                        <MudText Typo="Typo.caption">@L["Versions:Diff:ChangedDefinitions", prepared.Rows.Count]</MudText>
                    </MudStack>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                        @L["Versions:Diff:UnifiedView"]
                    </MudChip>
                </MudStack>
            }

            @foreach (var row in prepared.Rows)
            {
                <section class="configuration-unified-version-diff-definition" @key="row.DefinitionKey">
                    <MudStack Spacing="2">
                        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
                                <MudChip T="string" Size="Size.Small" Color="@ChangeColor(row.ChangeKind)" Variant="Variant.Outlined">
                                    @ChangeKindText(row.ChangeKind)
                                </MudChip>
                                <MudText Typo="Typo.subtitle2">@row.DisplayName</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="configuration-unified-version-diff-key">@row.DefinitionKey</MudChip>
                            </MudStack>
                            <MudText Typo="Typo.caption">
                                @L["Versions:Diff:Direction", VersionLabel(prepared.OriginVersion), VersionLabel(prepared.TargetVersion)]
                            </MudText>
                        </MudStack>

                        @if (row.HasSchemaDrift && !Visibility.ShowSensitiveValues)
                        {
                            <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                @L["State:Value:SchemaDriftNotice"]
                            </MudAlert>
                        }
                        @if (row.HasHiddenChanges)
                        {
                            <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                @L["State:Value:HiddenChangedNotice"]
                            </MudAlert>
                        }

                        <DiffViewer OriginText="@row.OriginText"
                                    NewText="@row.TargetText"
                                    Options="@_diffOptions"
                                    ViewMode="EDiffViewMode.Split" />
                    </MudStack>
                </section>
            }
        </MudStack>
    }
</div>

@code {
    private readonly DiffHighlightOptions _diffOptions = new()
    {
        Mode = EDiffHighlightMode.Line,
        ContextLines = 4,
        MaxCharacterDiffLength = 20000
    };
    private PreparationSession? _session;
    private ConfigurationUnifiedVersionComparison? _lastComparison;
    private DisplayLabels? _lastLabels;

    /// <summary>Gets or sets the raw saved-snapshot comparison to prepare for schema-aware display.</summary>
    /// <remarks>Changed comparisons must be supplied as a new record. The admitted snapshot is copied before awaiting schema reads.</remarks>
    [Parameter, EditorRequired] public ConfigurationUnifiedVersionComparison Comparison { get; set; } = null!;

    /// <summary>Gets or sets whether to show the captured comparison's summary heading; defaults to true.</summary>
    [Parameter] public bool ShowSummaryHeader { get; set; } = true;

    protected override void OnInitialized() => _session = new(async key =>
    {
        var result = await Facade.GetDefinitionAsync(key);
        var detail = result.Data;
        return result.IsFailure() ? null : detail?.Definition;
    }, Visibility.ShowSensitiveValues);

    protected override Task OnParametersSetAsync()
    {
        var labels = new DisplayLabels(L["State:Value:Sensitive"], L["State:Value:Hidden"],
            L["State:Value:HiddenBeforeChange"], L["State:Value:HiddenAfterChange"]);
        if (ReferenceEquals(_lastComparison, Comparison) && _lastLabels == labels) return Task.CompletedTask;
        _lastComparison = Comparison;
        _lastLabels = labels;
        return _session!.PrepareAsync(Comparison, labels);
    }

    public ValueTask DisposeAsync() => _session?.DisposeAsync() ?? ValueTask.CompletedTask;

    private string ChangeKindText(ConfigurationUnifiedVersionDefinitionChangeKind kind) => kind switch
    {
        ConfigurationUnifiedVersionDefinitionChangeKind.Added => L["Versions:Diff:Kinds:Added"],
        ConfigurationUnifiedVersionDefinitionChangeKind.Removed => L["Versions:Diff:Kinds:Removed"],
        _ => L["Versions:Diff:Kinds:Modified"]
    };

    private static Color ChangeColor(ConfigurationUnifiedVersionDefinitionChangeKind kind) => kind switch
    {
        ConfigurationUnifiedVersionDefinitionChangeKind.Added => Color.Success,
        ConfigurationUnifiedVersionDefinitionChangeKind.Removed => Color.Warning,
        _ => Color.Info
    };

    private static string VersionLabel(long version) => ConfigurationUnifiedVersionJsonFormatter.VersionLabel(version);

    internal sealed record DisplayLabels(string Sensitive, string Hidden, string BeforeChange, string AfterChange);
    internal sealed record PreparedComparison(long OriginVersion, long TargetVersion, IReadOnlyList<PreparedRow> Rows);
    internal sealed record PreparedRow(string DefinitionKey, string DisplayName,
        ConfigurationUnifiedVersionDefinitionChangeKind ChangeKind, string OriginText, string TargetText,
        bool HasHiddenChanges, bool HasSchemaDrift);

    /// <summary>Owns actual tokenless schema reads and publishes only the current fully redacted comparison.</summary>
    internal sealed class PreparationSession(Func<string, Task<ConfigurationDefinition?>> loadDefinition, bool showSensitiveValues = false) : IAsyncDisposable
    {
        private readonly ConfigurationOperationLifetime _lifetime = new();
        private long _generation;
        internal bool Loading { get; private set; }
        internal PreparedComparison? Prepared { get; private set; }

        internal Task PrepareAsync(ConfigurationUnifiedVersionComparison comparison, DisplayLabels labels)
        {
            // Facade records carry IReadOnlyList collections; copy them before the first asynchronous boundary.
            var captured = comparison with
            {
                Origin = comparison.Origin with { Definitions = comparison.Origin.Definitions.ToArray() },
                Target = comparison.Target with { Definitions = comparison.Target.Definitions.ToArray() },
                Changes = comparison.Changes.ToArray()
            };
            return _lifetime.RunAsync(async _ =>
            {
                long generation = 0;
                _lifetime.TryApply(() => { generation = ++_generation; Loading = true; Prepared = null; });
                var definitions = new Dictionary<string, ConfigurationDefinition>(StringComparer.OrdinalIgnoreCase);
                foreach (var key in captured.Changes.Select(change => change.DefinitionKey).Distinct(StringComparer.OrdinalIgnoreCase))
                {
                    ConfigurationDefinition? definition;
                    try { definition = await loadDefinition(key); }
                    catch (Exception) { definition = null; }
                    if (_lifetime.IsRetired || generation != _generation) return;
                    if (definition is not null) definitions[key] = definition;
                }

                var rows = captured.Changes.Select(change =>
                {
                    definitions.TryGetValue(change.DefinitionKey, out var definition);
                    var unproven = ConfigurationUnifiedVersionValuePrivacy.HasSchemaDrift(captured, change, definition);
                    var display = ConfigurationUnifiedVersionJsonFormatter.FormatComparisonForDisplay(
                        change.OriginJson, change.TargetJson, definition, labels.Sensitive, labels.Hidden,
                        labels.BeforeChange, labels.AfterChange, showSensitiveValues);
                    return new PreparedRow(change.DefinitionKey,
                        string.IsNullOrWhiteSpace(change.DisplayName) ? change.DefinitionKey : change.DisplayName,
                        change.ChangeKind, display.OriginText, display.TargetText, display.HasHiddenChanges, unproven);
                }).ToArray();
                _lifetime.TryApply(() =>
                {
                    if (generation != _generation) return;
                    Prepared = new(captured.Origin.Summary.Version, captured.Target.Summary.Version, Array.AsReadOnly(rows));
                    Loading = false;
                });
            });
        }

        public ValueTask DisposeAsync() => _lifetime.RetireAsync();
    }
}
