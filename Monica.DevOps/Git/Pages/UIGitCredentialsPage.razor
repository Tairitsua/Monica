@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@attribute [Route(PAGE_URL)]
@using Monica.DevOps.Git.Components
@using Monica.DevOps.Git.Models
@using Monica.DevOps.Git.Support

<PageTitle>@L["Pages:GitCredentials:Title"]</PageTitle>

<div class="git-credentials-page">
    <div class="workspace-frame"><GitWorkspaceHeader Title="@L["Workspace:Credentials:Title"]" Description="@L["Workspace:Credentials:Description"]" IsCredentialsPage="true">
        <Actions>
            <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" OnClick="RefreshAsync" Disabled="@(_controller?.IsBusy != false)">@L["GitDashboard:Actions:Refresh"]</MudButton>
        </Actions>
    </GitWorkspaceHeader></div>
    <div class="metadata-introduction">
        <p class="metadata-rule">@L["Workspace:Credentials:PresenceHint"]</p>
        @if (_controller?.MetadataObservedAt is { } observedAt)
        { <p class="metadata-observation">@L["Workspace:Credentials:Observed"] <code>@GitWorkspacePresentation.FormatDate(observedAt, L, UiTime)</code></p> }
    </div>
    @if (_controller is { } state)
    {
        @if (state.IsLoading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@L["Workspace:Credentials:Loading"]" /> }
        @if (state.MetadataFailure is { } failure)
        {
            <div class="metadata-feedback" role="alert">
                <MudAlert Severity="Severity.Error" Dense="true" Icon="@MoIcons.Error">@L["Workspace:Credentials:ReadFailed"]<span class="metadata-error">@Safe(failure.Detail)</span></MudAlert>
                @if (state.MetadataObservedAt.HasValue) { <p>@L["Workspace:Credentials:PreviousData"]</p> }
            </div>
        }
        @if (state.MetadataObservedAt.HasValue)
        {
            @if (!string.IsNullOrWhiteSpace(Credential) && TargetCredential is null)
            { <MudAlert Severity="Severity.Info" Dense="true" Icon="@MoIcons.Info">@L["Workspace:Credentials:ReferenceMissing", Safe(Credential)]</MudAlert> }
            else if (TargetCredential is not null && !VisibleCredentials.Any(IsTarget))
            { <MudAlert Severity="Severity.Info" Dense="true" Icon="@MoIcons.Info">@L["Workspace:Credentials:ReferenceFiltered"]</MudAlert> }
            <section class="credential-registry" aria-labelledby="git-credential-registry-title">
                <div class="credential-toolbar">
                    <div><h2 id="git-credential-registry-title">@L["Workspace:Credentials:Registrations"]</h2><p>@L["Workspace:Credentials:Results", VisibleCredentials.Count, state.Credentials.Count]</p></div>
                    <div class="credential-search">
                        <MudTextField @key="_parameterVersion" T="string" Value="@_query" ValueChanged="SetQuery" Label="@L["Workspace:Credentials:Search"]" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" />
                    </div>
                </div>
                @if (VisibleCredentials.Count == 0)
                {
                    <div class="credential-empty" role="status"><MoContentState Compact="true">@L[state.Credentials.Count == 0 ? "GitDashboard:Messages:NoCredentials" : "Workspace:Credentials:NoMatches"]</MoContentState></div>
                }
                else
                {
                <MudTable T="GitCredentialInfo" Items="@VisibleCredentials" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Xs" RowsPerPage="12" @bind-CurrentPage="_currentPage" RowClassFunc="CredentialRowClass" PagerContent="@CredentialPager" Class="credential-table">
                    <HeaderContent>
                        <MudTh>@L["Workspace:Credentials:Id"]</MudTh><MudTh>@L["Workspace:Credentials:AuthenticationType"]</MudTh><MudTh>@L["Workspace:Credentials:UserName"]</MudTh><MudTh>@L["Workspace:Credentials:Secret"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@(L["Workspace:Credentials:Id"])">
                            @if (IsTarget(context)) { <span class="credential-reference" tabindex="-1" @ref="_targetElement"><code>@Safe(context.Id)</code></span> }
                            else { <code>@Safe(context.Id)</code> }
                        </MudTd>
                        <MudTd DataLabel="@(L["Workspace:Credentials:AuthenticationType"])">@GitWorkspacePresentation.CredentialTypeText(context.AuthenticationType, L)</MudTd>
                        <MudTd DataLabel="@(L["Workspace:Credentials:UserName"])"><code>@GitWorkspacePresentation.Display(Safe(context.UserName), L)</code></MudTd>
                        <MudTd DataLabel="@(L["Workspace:Credentials:Secret"])">@L[context.HasSecret ? "Workspace:Credentials:Present" : "Workspace:Credentials:NotPresent"]</MudTd>
                    </RowTemplate>
                </MudTable>
                }
            </section>
            <section class="resolver-ledger" aria-labelledby="git-resolver-ledger-title">
                <div class="resolver-heading"><h2 id="git-resolver-ledger-title">@L["Workspace:Credentials:EvaluationOrder"]</h2><p>@L["Workspace:Credentials:ResolverRule"]</p></div>
                @if (state.Resolvers.Count == 0) { <MoContentState Compact="true">@L["GitDashboard:Messages:NoResolvers"]</MoContentState> }
                else
                {
                    <ol>
                        @foreach (var resolver in state.Resolvers)
                        {
                            <li>
                                <div class="resolver-order"><small>@L["Workspace:Credentials:Order"]</small><strong>@resolver.Order</strong></div>
                                <div class="resolver-identity"><h3>@Safe(resolver.DisplayName)</h3><dl><div><dt>@L["Workspace:Credentials:ResolverId"]</dt><dd><code>@Safe(resolver.ResolverId)</code></dd></div><div><dt>@L["Workspace:Credentials:ImplementationType"]</dt><dd><code>@Safe(resolver.ImplementationType)</code></dd></div></dl></div>
                            </li>
                        }
                    </ol>
                }
            </section>
        }
    }
</div>

@code {
    private RenderFragment? CredentialPager => VisibleCredentials.Count > 12
        ? @<MudTablePager PageSizeOptions="@(new[] { 12 })" HideRowsPerPage="true" RowsPerPageString="@L["Workspace:Credentials:RowsPerPage"]" InfoFormat="@L["Workspace:Credentials:PageInfo"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" />
        : null;
}
