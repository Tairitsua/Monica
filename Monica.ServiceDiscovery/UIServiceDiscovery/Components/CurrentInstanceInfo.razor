@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.ServiceDiscovery.UIServiceDiscovery.Support
@implements IAsyncDisposable

<div class="current-host-dossier">
    <header class="host-heading">
        <div><span class="host-eyebrow">@L["Workbench:QueryingHost"]</span><h2>@L["CurrentInstance:HeaderTitle"]</h2><p>@L["Workbench:CurrentHostScope"]</p></div>
        <div class="host-controls">
            <MudSwitch T="bool" Value="@State.AutoRefreshEnabled" ValueChanged="AutoRefreshChanged" Color="Color.Primary" Label="@L["Shared:Labels:AutoRefresh"]" />
            <div class="host-interval"><MudNumericField T="int" Value="@State.RefreshInterval" ValueChanged="IntervalChanged" Label="@L["Shared:Labels:RefreshIntervalSeconds"]" Min="1" Max="60" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(!State.AutoRefreshEnabled)" Immediate="true" /></div>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.Refresh" OnClick="RefreshAsync" Disabled="@_refreshing">@L["Shared:Actions:Refresh"]</MudButton>
        </div>
    </header>

    @if (_refreshing && Instance is null) { <MudProgressLinear Color="Color.Primary" Indeterminate="true" /> }
    @if (!string.IsNullOrEmpty(State.ErrorMessage))
    {
        <MudAlert Severity="Severity.Warning" Class="host-read-error" Icon="@MoIcons.Warning"><strong>@L["Workbench:CurrentHostReadFailed"]</strong><div>@State.ErrorMessage</div>@if (Instance is not null) { <div>@L["Workbench:LastSuccessfulCapture"]</div> }</MudAlert>
    }

    @if (Instance is { } instance)
    {
        <section class="host-identity">
            <div class="host-identity-main"><span class="host-eyebrow">@L["CurrentInstance:Fields:AppName"]</span><h3>@instance.AppName</h3><code>@instance.AppId</code><div class="host-context"><span>@Value(instance.ProjectName)</span><span>@Value(string.Join(", ", instance.GetDomainNames()))</span><span>@L["Shared:Values:Roles"]: @Value(string.Join(", ", instance.RoleIds))</span></div></div>
            <div class="host-instance-identity"><span>@L["CurrentInstance:Fields:InstanceId"]</span><code>@instance.InstanceId</code><small>@L["Workbench:CapturedUTC"]</small><time datetime="@State.CapturedAt?.ToString("O")">@UiTime.Format(State.CapturedAt)</time></div>
        </section>

        <section class="host-registration">
            <div class="host-section-heading"><h3>@L["Workbench:RegistrationEvidence"]</h3><p>@L["Workbench:LocalTimes"]</p></div>
            <dl class="host-registration-strip"><div><dt>@L["CurrentInstance:Fields:RegistrationTime"]</dt><dd>@Time(instance.RegistrationTime)</dd></div><div><dt>@L["CurrentInstance:Fields:LastHeartbeat"]</dt><dd>@Time(instance.LastHeartbeatTime)</dd></div><div><dt>@L["Workbench:HeartbeatAgeAtCapture"]</dt><dd>@HeartbeatAge()</dd></div><div><dt>@L["CurrentInstance:Fields:CurrentStatus"]</dt><dd>@instance.Status.GetText(L)</dd></div></dl>
        </section>

        <div class="host-evidence-columns">
            <section class="host-evidence">
                <div class="host-section-heading"><h3>@L["Workbench:BuildIdentity"]</h3></div>
                <dl class="host-facts"><div><dt>@L["CurrentInstance:Fields:AssemblyVersion"]</dt><dd>@Value(instance.AssemblyVersion)</dd></div><div><dt>@L["CurrentInstance:Fields:ReleaseVersion"]</dt><dd>@Value(instance.ReleaseVersion)</dd></div><div><dt>@L["CurrentInstance:Fields:BuildTime"]</dt><dd>@Time(instance.BuildTime)</dd></div></dl>
            </section>

            <section class="host-evidence host-election">
                <div class="host-section-heading"><h3>@L["CurrentInstance:Sections:LeaderStatus"]</h3><p>@L["Workbench:LocalElectionScope"]</p></div>
                @if (Snapshot is { IsLeaderElectionEnabled: true } snapshot)
                {
                    <MudChip T="string" Color="@snapshot.CurrentLeaderStatus.GetColor()" Icon="@snapshot.CurrentLeaderStatus.GetIcon()" Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@snapshot.CurrentLeaderStatus.GetText(L)</MudChip>
                    <dl class="host-facts"><div><dt>@L["CurrentInstance:Fields:LeaderBecomeTime"]</dt><dd>@Time(snapshot.LeaderBecomeTime)</dd></div><div><dt>@L["CurrentInstance:Fields:CurrentTermId"]</dt><dd><code>@Value(snapshot.CurrentTermId)</code></dd></div></dl>
                }
                else { <p class="host-empty-note">@L["CurrentInstance:States:LeaderElectionDisabled"]</p> }
                <div class="host-cluster-lease"><h4>@L["CurrentInstance:Sections:ClusterLeaderInfo"]</h4><p>@L["Workbench:LeaseScope"]</p>@if (ClusterLeader is { } leader) { <dl class="host-facts"><div><dt>@L["CurrentInstance:Fields:AppId"]</dt><dd><code>@leader.AppId</code></dd></div><div><dt>@L["CurrentInstance:Fields:LeaderInstanceId"]</dt><dd><code>@leader.InstanceId</code></dd></div><div><dt>@L["CurrentInstance:Fields:LeaderBecomeTime"]</dt><dd>@Time(leader.BecomeLeaderTime)</dd></div></dl> } else { <p class="host-empty-note">@L["Workbench:NoLeaderLease"]</p> }</div>
            </section>
        </div>

        <section class="host-metadata">
            <div class="host-section-heading"><h3>@L["CurrentInstance:Fields:Metadata"] <span>@instance.Metadata.Count</span></h3><p>@L["Workbench:MetadataScope"]</p></div>
            @if (instance.Metadata.Count == 0) { <p class="host-empty-note">@L["ServiceDetail:Metadata:States:NoMetadata"]</p> }
            else { <dl class="host-metadata-list">@foreach (var item in instance.Metadata.OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)) { <div><dt><code>@item.Key</code></dt><dd><code>@item.Value</code></dd></div> }</dl> }
        </section>
    }
    else if (!_refreshing) { <div class="host-empty"><MoIcon Icon="@MoIcons.Server" Size="2.25rem" /><h3>@L["Workbench:NoCurrentHostCapture"]</h3><p>@L["Workbench:NoCurrentHostCaptureHelp"]</p></div> }
</div>
