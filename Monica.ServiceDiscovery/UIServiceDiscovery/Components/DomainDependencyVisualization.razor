    }

    private object PrepareGraphData()
    {
        var nodes = _filteredDomains.Select(domain => new
        {
            id = domain.Id,
            name = domain.DisplayName ?? domain.Id,
            description = domain.Description,
            isCatalogDomain = !_unlistedDomains.Contains(domain.Id),
            colorRole = DomainColorResolver.GetDomainColorRole(domain.Id),
            services = _domainServicesMap.GetValueOrDefault(domain.Id, new List<RegisteredServiceStatus>())
                .Select(s => new
                {
                    name = s.AppName,
                    appName = s.AppName,
                    appId = s.AppId,
                    roles = s.RoleIds,
                    status = s.OverallStatus.ToString(),
                    overallStatus = s.OverallStatus.ToString()
                }).ToList()
        }).ToList();

        var links = _filteredDependencies.Select(dep => new
        {
            source = dep.SourceDomain,
            target = dep.TargetDomain,
            evidenceCount = dep.Evidence.Count,
            colorRole = DomainColorResolver.GetDomainColorRole(dep.SourceDomain)
        }).ToList();

        return new { nodes, links };
    }

