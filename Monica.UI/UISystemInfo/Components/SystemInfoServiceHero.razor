@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using System.Globalization
@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@using Monica.UI.UISystemInfo.Models
@using Monica.UI.UISystemInfo.Support
@inject IStringLocalizer<SystemInfoResource> L

<section class="system-info-hero" aria-labelledby="system-info-service-name">
    <div class="system-info-profile">
        <div class="system-info-identity">
            <div class="system-info-identity__meta">
                <span class="system-info-process-state"><i></i>@L["Page:Status:Running"]</span>
                <span>@Snapshot.Application.EnvironmentName</span>
                <span class="system-info-version">@Snapshot.Application.Version</span>
            </div>
            <div class="system-info-identity__heading">
                <span class="system-info-identity__seal" aria-hidden="true">@Monogram</span>
                <div>
                    <h2 id="system-info-service-name">@Snapshot.Application.Name</h2>
                    <p class="system-info-application-id">@Snapshot.Application.Id</p>
                </div>
            </div>
            <dl class="system-info-identity__facts">
                <div><dt>@L["Page:ServiceIdentity:ProcessStarted"]</dt><dd>@UiTime.Format(Snapshot.Process.StartedAtUtc)</dd></div>
                <div><dt>@L["Page:ServiceIdentity:ProductVersion"]</dt><dd>@(Snapshot.Artifact.ProductVersion ?? "—")</dd></div>
            </dl>
        </div>
        @if (Snapshot.Startup is { } startup)
        {
            <aside class="system-info-startup" aria-label="@L["Page:Startup:AriaLabel"]">
                <div class="system-info-startup__heading">
                    <h3>@L["Page:Startup:Title"]</h3>
                    <span>@L["Page:Status:Tracked"]</span>
                </div>
                <strong class="system-info-startup__duration">@L["Page:Startup:DurationValue", startup.DurationMs]</strong>
                <p>@L["Page:Startup:Scope"]</p>
                <dl>
                    <div><dt>@L["Page:Startup:StartMarker"]</dt><dd>@UiTime.FormatTime(startup.StartedAtUtc)</dd></div>
                    <div><dt>@L["Page:Startup:ReadyAt"]</dt><dd>@UiTime.FormatTime(startup.ReadyAtUtc)</dd></div>
                </dl>
            </aside>
        }
    </div>
    <SystemInfoPulseStrip Snapshot="@Snapshot" NowUtc="@NowUtc" />
</section>

@code {
    [Parameter, EditorRequired] public SystemInfoSnapshot Snapshot { get; set; } = null!;
    [Parameter] public DateTimeOffset NowUtc { get; set; }

    private string Monogram => string.IsNullOrWhiteSpace(Snapshot.Application.Name)
        ? "M"
        : StringInfo.GetNextTextElement(Snapshot.Application.Name);
}
