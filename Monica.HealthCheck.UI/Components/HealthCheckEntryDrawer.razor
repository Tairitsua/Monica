@inject IStringLocalizer<HealthCheckResource> L

<div class="health-detail-host">
    <MudDrawer Open="@Session.IsDetailsOpen"
               OpenChanged="@OnOpenChangedAsync"
               Anchor="Anchor.End"
               Variant="DrawerVariant.Temporary"
               Overlay="true"
               OverlayAutoClose="true"
               Fixed="true"
               Width="min(34rem, 100vw)"
               Class="health-detail-panel mo-viewport-drawer"
               role="dialog"
               aria-modal="true"
               aria-hidden="@(Session.IsDetailsOpen ? "false" : "true")"
               aria-label="@Session.SelectedEntry?.Name"
               Elevation="1">
        @if (Session.IsDetailsOpen && Session.SelectedEntry is { } entry)
        {
            <MudFocusTrap DefaultFocus="DefaultFocus.FirstChild" Class="health-detail-focus-trap">
                <div class="health-detail-drawer" @onkeydown="OnKeyDownAsync">
                    <header class="health-detail-header">
                        <div class="health-detail-header__topline">
                            <span class="health-detail-eyebrow">@L["Details:Eyebrow"]</span>
                            <MudIconButton Icon="@MoIcons.Close"
                                           Size="Size.Small"
                                           Class="health-detail-close"
                                           OnClick="@Session.CloseDetailsAsync"
                                           aria-label="@L["Actions:Close"]" />
                        </div>
                        <h2>@entry.Name</h2>
                        <span class="health-detail-status">
                            <MoIcon Icon="@StatusIcon(entry.Status)"
                                     Size="1.25rem" Style="@HealthCheckDisplay.IconStyle(entry.Status)" />
                            <span>@L.GetStatusText(entry.Status)</span>
                        </span>
                    </header>

                    <div class="health-detail-content">
                        <section class="health-detail-section">
                            <h3>@L["Details:Description"]</h3>
                            <p class="health-detail-description">
                                @(string.IsNullOrWhiteSpace(entry.Description)
                                    ? L["Details:NoDescription"]
                                    : entry.Description)
                            </p>
                        </section>

                        <dl class="health-detail-facts">
                            <div>
                                <dt>@L["Details:Duration"]</dt>
                                <dd>@L["Common:DurationMilliseconds", entry.Duration.TotalMilliseconds]</dd>
                            </div>
                            <div>
                                <dt>@L["Details:Tags"]</dt>
                                <dd>
                                    @if (entry.Tags.Count == 0)
                                    {
                                        @L["Details:NoTags"]
                                    }
                                    else
                                    {
                                        <span class="health-detail-tags">
                                            @foreach (var tag in entry.Tags)
                                            {
                                                <span class="health-detail-tag">@tag</span>
                                            }
                                        </span>
                                    }
                                </dd>
                            </div>
                        </dl>

                        <section class="health-detail-section">
                            <h3>@L["Details:Data"]</h3>
                            @if (entry.Data.Count == 0)
                            {
                                <p class="health-detail-empty">@L["Details:NoData"]</p>
                            }
                            else
                            {
                                <dl class="health-detail-data">
                                    @foreach (var pair in entry.Data.OrderBy(static pair => pair.Key, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <div>
                                            <dt>@pair.Key</dt>
                                            <dd><code>@pair.Value</code></dd>
                                        </div>
                                    }
                                </dl>
                            }
                        </section>

                        @if (entry.Error is { } error)
                        {
                            <section class="health-detail-section health-detail-section--error">
                                <h3>
                                    <MoIcon Icon="@MoIcons.Error" Size="1.25rem" Style="color:var(--mud-palette-error);" />
                                    @L["Details:Error"]
                                </h3>
                                <dl class="health-detail-error">
                                    <div>
                                        <dt>@L["Details:ErrorType"]</dt>
                                        <dd><code>@error.Type</code></dd>
                                    </div>
                                    <div>
                                        <dt>@L["Details:ErrorMessage"]</dt>
                                        <dd>@error.Message</dd>
                                    </div>
                                </dl>
                            </section>
                        }
                    </div>
                </div>
            </MudFocusTrap>
        }
    </MudDrawer>
</div>

@code {
    [Parameter, EditorRequired] public HealthCheckPageSession Session { get; set; } = default!;

    private static string StatusIcon(HealthCheckState status) => status switch
    {
        HealthCheckState.Healthy => MoIcons.Success,
        HealthCheckState.Degraded => MoIcons.Warning,
        HealthCheckState.Unhealthy => MoIcons.Error,
        _ => MoIcons.Help
    };

    private Task OnOpenChangedAsync(bool open) => open
        ? Task.CompletedTask
        : Session.CloseDetailsAsync();

    private Task OnKeyDownAsync(KeyboardEventArgs args) => args.Key == "Escape"
        ? Session.CloseDetailsAsync()
        : Task.CompletedTask;

}
