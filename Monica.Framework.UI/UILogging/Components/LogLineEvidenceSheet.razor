@using Monica.Framework.UI.UILogging.Models
@using Monica.Framework.UI.UILogging.Support
@using Monica.UI.Shared.Components.Dialogs
@using Monica.UI.Shared.Components.Visual
@inject IStringLocalizer<LoggingResource> L
@inject IJSRuntime JS

<MoSideSheet Open="true" OpenChanged="Close" CloseLabel="@L["Design:Close"]" Width="560px" Compact="true">
    <TitleContent>
        @{
            var severity = _evidence?.Line.Severity;
            var role = severity is { } level ? LogSeverityStrip.Role(level) : MoVisualRole.Neutral;
            var icon = severity is LogSeverity.Error or LogSeverity.Critical ? MoIcons.Error :
                severity == LogSeverity.Warning ? MoIcons.Warning : _evidence is null ? MoIcons.FileSearch : MoIcons.FileText;
        }
        <div class="lm-insp-heading">
            <span class="mo-vl-tile @role.ToCssClass()"><MoIcon Icon="@icon" Size="16px" /></span>
            <div class="lm-insp-id">
                <p>@L["Design:InspEyebrow", Number]</p>
                <h2>@(_evidence is null ? L["Design:InspNotFoundTitle"].Value : $"L{Number} · {L["Design:InspTitle"]}")</h2>
                @if (_evidence is { } record)
                {
                    <div class="lm-insp-flags">
                        <span class="mo-vl-status mo-vl-status--pill @role.ToCssClass()"><i class="mo-vl-status-dot" aria-hidden="true"></i>@L[$"Workbench:Levels:{record.Line.Severity}"]</span>
                        @if (record.Line.Thread.Length > 0) { <span class="mo-vl-capsule mo-vl-capsule--outline mo-vl-role--neutral">@record.Line.Thread</span> }
                    </div>
                }
            </div>
            @if (_evidence is not null)
            {
                <div class="lm-insp-step">
                    <MudIconButton Icon="@MoIcons.ChevronUp" Size="Size.Small" aria-label="@L["Design:InspPrevLine"]" title="@L["Design:InspPrevLine"]" Disabled="@(_index <= 0)" OnClick="@(() => Step(-1))" />
                    <MudIconButton Icon="@MoIcons.ChevronDown" Size="Size.Small" aria-label="@L["Design:InspNextLine"]" title="@L["Design:InspNextLine"]" Disabled="@(_index < 0 || _index >= _frozen.Count - 1)" OnClick="@(() => Step(1))" />
                </div>
            }
        </div>
    </TitleContent>
    <ChildContent>
        @if (_evidence is { } evidence)
        {
            <div class="lm-insp-work">
                <p class="lm-insp-frozen"><MoIcon Icon="@MoIcons.Lock" Size="16px" />@L["Workbench:Inspector:Frozen"]</p>
                <div class="lm-insp-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@MoIcons.Copy" OnClick="@(() => Copy(evidence.Line.Raw))">@L["Design:CopyRaw"]</MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@MoIcons.UnfoldVertical" Disabled="@(evidence.Source is null || evidence.Line.AbsoluteLineNumber is null)"
                               OnClick="@(() => ShowContext.InvokeAsync(evidence))">@L["LogChart:ShowContextWindow"]</MudButton>
                    <button type="button" class="mo-vl-soft-action @LogSeverityStrip.Role(evidence.Line.Severity).ToCssClass()"
                            @onclick="@(() => FilterSeverity.InvokeAsync(evidence.Line.Severity))">
                        <MoIcon Icon="@MoIcons.Filter" Size="15px" />@L["Page:Components:Viewer:ContextMenu:FilterSeverity"]
                    </button>
                </div>
                <LogLineEvidenceContent Evidence="@evidence" CopyFormattedRequested="CopyFormat" />
            </div>
        }
        else
        {
            <MoSemanticCallout Severity="MoVisualRole.Warning" Icon="@MoIcons.FileSearch" Title="@L["Design:InspNotFoundTitle"]">@L["Design:InspNotFoundBody", Number]</MoSemanticCallout>
        }
    </ChildContent>
</MoSideSheet>

@code {
    [Parameter, EditorRequired] public string Number { get; set; } = string.Empty;
    [Parameter] public string? Generation { get; set; }
    [Parameter] public IReadOnlyList<LogLineViewModel> Lines { get; set; } = [];
    [Parameter] public LogSourceIdentity? Source { get; set; }
    [Parameter] public DateTimeOffset? ReadAt { get; set; }
    [Parameter] public LogLineEvidence? Initial { get; set; }
    [Parameter] public EventCallback<long?> Navigate { get; set; }
    /// <summary>Opens physical neighbors verified against the frozen source and line.</summary>
    [Parameter] public EventCallback<LogLineEvidence> ShowContext { get; set; }
    /// <summary>Applies the inspected severity to the working ledger and closes the sheet.</summary>
    [Parameter] public EventCallback<LogSeverity> FilterSeverity { get; set; }
    private IReadOnlyList<LogLineViewModel> _frozen = [];
    private LogSourceIdentity? _source;
    private DateTimeOffset? _readAt;
    private LogLineEvidence? _evidence;
    private string? _previous;
    private int _index;

    protected override void OnInitialized()
    {
        _source = Initial?.Source ?? Source;
        _readAt = Initial?.ViewReadAt ?? ReadAt;
        _frozen = (Generation is null || Generation == _source?.Generation) && Equals(_source, Source) ? Lines : [];
    }

    protected override void OnParametersSet()
    {
        if (Number == _previous) return;
        _previous = Number;
        _index = -1;
        _evidence = null;
        if (!long.TryParse(Number, out var number)) return;
        for (var i = 0; i < _frozen.Count; i++)
        {
            if (_frozen[i].AbsoluteLineNumber != number) continue;
            _index = i;
            _evidence = LogLineEvidence.Capture(_frozen[i], _source, _readAt, i);
            break;
        }
        if (Initial?.Line.AbsoluteLineNumber == number && (Generation is null || Generation == Initial.Source?.Generation))
            _evidence = Initial;
    }

    private Task Step(int offset) => Navigate.InvokeAsync(_frozen[_index + offset].AbsoluteLineNumber);
    private Task Close(bool open) => open ? Task.CompletedTask : Navigate.InvokeAsync(null);
    private Task CopyFormat(LogCopyFormat format) => _evidence is { } evidence ? Copy(evidence.Line.GetCopyText(format)) : Task.CompletedTask;
    private Task Copy(string raw) => JS.InvokeVoidAsync("navigator.clipboard.writeText",raw).AsTask();
}
