@using Microsoft.Extensions.Options
@using Monica.Core.Results
@using Monica.Modules
@using Monica.ServiceDiscovery.Abstractions
@using Monica.ServiceDiscovery.Facades
@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Support
@using Monica.Tool.Extensions
@using Monica.UI.Shared.Components.Dialogs
@implements IAsyncDisposable
@inject IOptions<ModuleServiceDiscoveryOption> ServiceDiscoveryOptions
@inject ILeaderElectionService LeaderElectionService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ServiceDiscoveryFacade ServiceDiscoveryFacade
@inject IStringLocalizer<ServiceDiscoveryResource> L

@if (_service is { } service)
{
    <div class="service-inspector">
        <header class="inspector-identity">
            <div><span class="inspector-eyebrow">@L["Workbench:FrozenServiceCapture"]</span><h3 @ref="_identityHeading" tabindex="-1">@service.AppName</h3><code>@service.AppId</code></div>
            <div class="inspector-capture">@if (_hasCaptureTime) { <span>@L["Workbench:CapturedUTC"]</span><time datetime="@_capturedAt.ToString("O")">@_capturedAt.ToString("O")</time> }<span>@L["Workbench:FrozenUTC"]</span><time datetime="@_frozenAt.ToString("O")">@_frozenAt.ToString("O")</time><MudChip T="string" Color="@service.OverallStatus.GetColor()" Icon="@service.OverallStatus.GetIcon()" Size="Size.Small" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@service.OverallStatus.GetText(L)</MudChip></div>
        </header>
        <p class="inspector-scope">@L["Workbench:FrozenServiceHelp"]</p>
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="inspector-tabs" PrevIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight">
            <MudTabPanel Text="@L["ServiceDetail:Tabs:Overview"]">
                <section class="inspector-section">
                    <dl class="inspector-facts"><div><dt>@L["ServiceDetail:Overview:Fields:AppId"]</dt><dd><code>@service.AppId</code></dd></div><div><dt>@L["ServiceDetail:Overview:Fields:ServiceName"]</dt><dd>@service.AppName</dd></div><div><dt>@L["ServiceDetail:Overview:Fields:ProjectName"]</dt><dd>@Value(service.ProjectName)</dd></div><div><dt>@L["ServiceDetail:Overview:Fields:DomainName"]</dt><dd>@Value(string.Join(", ", service.GetDomainNames()))</dd></div><div><dt>@L["Shared:Values:Roles"]</dt><dd>@Value(string.Join(", ", service.RoleIds))</dd></div></dl>
                    <div class="inspector-registration-summary"><h4>@L["ServiceDetail:Status:Title"]</h4><span>@L["ServiceDetail:Status:RunningInstances", service.RunningInstanceCount]</span><span>@L["ServiceDetail:Status:TotalInstances", service.TotalInstanceCount]</span></div>
                    <section class="inspector-dependencies"><h4>@L["Workbench:DeclaredDependencies"]</h4>@if (service.DependentSubDomains is { Count: > 0 } dependencies) { <div class="inspector-tags">@foreach (var domain in dependencies) { <span>@domain</span> }</div> } else { <p>@L["Workbench:NoDeclaredDependencies"]</p> }</section>
                </section>
            </MudTabPanel>
            <MudTabPanel Text="@L["ServiceDetail:Tabs:Instances", _instances.Count]">
                <section class="inspector-section">
                    <p class="inspector-note">@L["Workbench:InstanceEvidenceScope"]</p><p class="inspector-note">@L[_hasCaptureTime ? "Workbench:HeartbeatInferenceScope" : "Workbench:HeartbeatInferenceFrozenScope"]</p>
                    <div class="inspector-table-frame">
                        <MudDataGrid T="InstanceDisplayItem" Items="@_instances" Square="true" Hover="true" Dense="true" Breakpoint="Breakpoint.Xs" RowsPerPage="10" SortIcon="@MoIcons.ArrowUp" DragIndicatorIcon="@MoIcons.GripVertical" FilterIconEmpty="@MoIcons.Filter" FilterIconFilled="@MoIcons.Filter" FilterIconClear="@MoIcons.FilterOff" ColumnOptionsIcon="@MoIcons.MoreVertical">
                            <Columns>
                                <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:InstanceId"]"><CellTemplate><div class="inspector-instance-id"><code>@context.Item.Instance.InstanceId</code>@if (context.Item.IsEvicted) { <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@L["Workbench:ObservedDisappearance"]</MudChip> }</div></CellTemplate></TemplateColumn>
                                <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:Status"]"><CellTemplate><MudChip T="string" Color="@context.Item.Instance.Status.GetColor()" Size="Size.Small" Icon="@context.Item.Instance.Status.GetIcon()" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@context.Item.Instance.Status.GetText(L)</MudChip></CellTemplate></TemplateColumn>
                                <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:Role"]"><CellTemplate><MudChip T="string" Color="@(context.Item.Instance.IsLeader ? Color.Warning : Color.Default)" Size="Size.Small" Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@L[context.Item.Instance.IsLeader ? "Shared:LeaderStatuses:Leader" : "Shared:LeaderStatuses:Follower"]</MudChip></CellTemplate></TemplateColumn>
                                <PropertyColumn Property="x => x.Instance.AssemblyVersion" Title="@L["ServiceDetail:Instances:Columns:AssemblyVersion"]" />
                                <PropertyColumn Property="x => x.Instance.ReleaseVersion" Title="@L["ServiceDetail:Instances:Columns:ReleaseVersion"]" />
                                <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:BuildTime"]"><CellTemplate><span class="inspector-time">@Time(context.Item.Instance.BuildTime)</span></CellTemplate></TemplateColumn>
                                <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:LastHeartbeat"]"><CellTemplate><span class="inspector-time">@Time(context.Item.Instance.LastHeartbeatTime)</span></CellTemplate></TemplateColumn>
                                <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:RegistrationTime"]"><CellTemplate><span class="inspector-time">@Time(context.Item.Instance.RegistrationTime)</span></CellTemplate></TemplateColumn>
                                @if (service.EvictedInstances.Count > 0) { <TemplateColumn Title="@L["Workbench:DisappearanceObservedAt"]"><CellTemplate><span class="inspector-time">@Time(context.Item.EvictionTime)</span></CellTemplate></TemplateColumn> }
                                <TemplateColumn Title="@L["ServiceDetail:Instances:Columns:HeartbeatHealth"]"><CellTemplate><span>@HeartbeatHealth(context.Item.Instance.LastHeartbeatTime)</span></CellTemplate></TemplateColumn>
                            </Columns>
                            <NoRecordsContent><div class="inspector-empty">@L["ServiceDetail:Metadata:States:NoInstances"]</div></NoRecordsContent>
                            <PagerContent><MudDataGridPager T="InstanceDisplayItem" PageSizeOptions="@(new[] { 10, 25, 50 })" /></PagerContent>
                        </MudDataGrid>
                    </div>
                </section>
            </MudTabPanel>
            <MudTabPanel Text="@L["ServiceDetail:Tabs:Configuration"]">
                <section class="inspector-section">
                    <div class="inspector-host-scope"><span>@L["Workbench:QueryingHost"]</span><p>@L["Workbench:ConfigurationScope"]</p></div>
                    <section class="inspector-config-group"><h4>@L["ServiceDetail:Configuration:Sections:ElectionConfig"]</h4><dl class="inspector-facts"><div><dt>@L["ServiceDetail:Configuration:Fields:HeartbeatPeriodSeconds"]</dt><dd>@_election.HeartbeatPeriodSeconds <small>@L["ServiceDetail:Configuration:Fields:HeartbeatPeriodHelper"]</small></dd></div><div><dt>@L["ServiceDetail:Configuration:Fields:HeartbeatJitterMilliseconds"]</dt><dd>@_election.HeartbeatJitterMilliseconds <small>@L["ServiceDetail:Configuration:Fields:HeartbeatJitterHelper"]</small></dd></div></dl></section>
                    <section class="inspector-config-group"><h4>@L["ServiceDetail:Configuration:Sections:TtlConfig"]</h4><div class="inspector-ttl-columns"><section><h5>@L["ServiceDetail:Configuration:Fields:InstanceTtl"]</h5><dl class="inspector-facts compact"><div><dt>@L["ServiceDetail:Configuration:Fields:Multiplier"]</dt><dd>@_election.RegistrationOfflineTTLMultiplier</dd></div><div><dt>@L["ServiceDetail:Configuration:Fields:AdditionalSeconds"]</dt><dd>@_election.RegistrationOfflineTTLAdditionalSeconds</dd></div><div><dt>@L["ServiceDetail:Configuration:Fields:CalculatedValue"]</dt><dd>@L["Shared:Formats:SecondsValue", _election.RegistrationTTL.TotalSeconds]</dd></div></dl></section><section><h5>@L["ServiceDetail:Configuration:Fields:LeaderTtl"]</h5><dl class="inspector-facts compact"><div><dt>@L["ServiceDetail:Configuration:Fields:Multiplier"]</dt><dd>@_election.LeaderOfflineTTLMultiplier</dd></div><div><dt>@L["ServiceDetail:Configuration:Fields:AdditionalSeconds"]</dt><dd>@_election.LeaderOfflineTTLAdditionalSeconds</dd></div><div><dt>@L["ServiceDetail:Configuration:Fields:CalculatedValue"]</dt><dd>@L["Shared:Formats:SecondsValue", _election.LeaderTTL.TotalSeconds]</dd></div></dl></section></div></section>
                    <section class="inspector-config-group"><h4>@L["ServiceDetail:Configuration:Sections:RuntimeMode"]</h4><dl class="inspector-facts"><div><dt>@L["ServiceDetail:Configuration:Fields:StateStoreMode"]</dt><dd>@StorageModeText()</dd></div><div><dt>@L["ServiceDetail:Configuration:Fields:IsolationHandlingMode"]</dt><dd>@IsolationModeText()<small>@L["ServiceDetail:Configuration:Fields:IsolationHandlingHelper"]</small></dd></div><div><dt>@L["ServiceDetail:Configuration:Fields:HostRole"]</dt><dd>@HostRoleText()</dd></div></dl><p class="inspector-note">@L["ServiceDetail:Configuration:Messages:StateTransition"]</p><p class="inspector-note">@L["Workbench:IsolationBehaviorCaveat"]</p></section>
                </section>
            </MudTabPanel>
            <MudTabPanel Text="@L["ServiceDetail:Tabs:ElectionStatus"]">
                <section class="inspector-section">
                    <div class="inspector-host-scope"><span>@L["Workbench:QueryingHost"]</span><p>@L["Workbench:LocalElectionScope"]</p></div>
                    <div class="inspector-election-columns">
                        <section><h4>@L["ServiceDetail:ElectionStatus:Sections:CurrentStatus"]</h4>@if (_hostRole == ServiceDiscoveryRole.Worker) { <p class="inspector-note">@L["CurrentInstance:States:LeaderElectionDisabled"]</p> } else { <MudChip T="string" Color="@_localStatus.GetColor()" Icon="@_localStatus.GetIcon()" Size="Size.Small" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@_localStatus.GetText(L)</MudChip> }<dl class="inspector-facts compact"><div><dt>@L["ServiceDetail:ElectionStatus:Fields:BecameLeaderAt"]</dt><dd>@Time(_localBecomeTime)</dd></div><div><dt>@L["ServiceDetail:ElectionStatus:Fields:CurrentETag"]</dt><dd><code>@Value(_localETag)</code><small>@L["ServiceDetail:ElectionStatus:Tooltips:CurrentETag"]</small></dd></div></dl></section>
                        <section><h4>@L["ServiceDetail:ElectionStatus:Sections:Description"]</h4><dl class="inspector-status-guide"><div><dt>@L["Shared:LeaderStatuses:Leader"]</dt><dd>@L["ServiceDetail:ElectionStatus:Descriptions:Leader"]</dd></div><div><dt>@L["Shared:LeaderStatuses:Follower"]</dt><dd>@L["ServiceDetail:ElectionStatus:Descriptions:Follower"]</dd></div><div><dt>@L["Shared:LeaderStatuses:Looking"]</dt><dd>@L["ServiceDetail:ElectionStatus:Descriptions:Looking"]</dd></div></dl></section>
                    </div>
                    <section class="inspector-maintenance"><h4>@L["ServiceDetail:ElectionStatus:Sections:Management"]</h4><p>@L["Workbench:ForceDeleteScope", service.AppId]</p><MudAlert Severity="Severity.Warning" Dense="true" Icon="@MoIcons.Warning">@L["ServiceDetail:ElectionStatus:Warnings:ForceDeleteLeader"]</MudAlert><MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@MoIcons.Delete" OnClick="OnForceDeleteLeaderClicked" Disabled="@(!HasLeader || _actionBusy || _leaderDeleted)">@L["ServiceDetail:ElectionStatus:Actions:ForceDeleteLeader"]</MudButton>@if (_leaderDeleted) { <p role="status">@L["Workbench:LeaderDeleteCaptureUnchanged"]</p> }</section>
                </section>
            </MudTabPanel>
            <MudTabPanel Text="@L["ServiceDetail:Tabs:Metadata"]">
                <section class="inspector-section">
                    @foreach (var instance in service.Instances.Values)
                    {
                        <section class="inspector-instance-metadata"><header><h4>@L["ServiceDetail:Metadata:InstanceTitle", instance.InstanceId]</h4><MudChip T="string" Color="@instance.Status.GetColor()" Size="Size.Small" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@instance.Status.GetText(L)</MudChip>@if (instance.IsLeader) { <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@L["Shared:LeaderStatuses:Leader"]</MudChip> }</header>@if (instance.Metadata.Count > 0) { <dl class="inspector-metadata">@foreach (var item in instance.Metadata.OrderBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase)) { <div><dt><code>@item.Key</code></dt><dd><MetadataValueDisplay Value="@item.Value" /></dd></div> }</dl> } else { <p class="inspector-note">@L["ServiceDetail:Metadata:States:NoMetadata"]</p> }</section>
                    }
                    @if (service.Instances.Count == 0) { <div class="inspector-empty">@L["ServiceDetail:Metadata:States:NoInstances"]</div> }
                </section>
            </MudTabPanel>
        </MudTabs>
    </div>
}

@code {
    /// <summary>Gets or sets the service read to detach once when this inspector is created.</summary>
    [Parameter, EditorRequired] public RegisteredServiceStatus Service { get; set; } = null!;
    /// <summary>Gets or sets the UTC capture time of the originating directory read.</summary>
    [Parameter] public DateTime? CapturedAt { get; set; }
    private RegisteredServiceStatus? _service;
    private DateTime _capturedAt;
    private DateTime _frozenAt;
    private bool _hasCaptureTime;
    private ElectionConfig _election = new();
    private ServiceDiscoveryRole _hostRole;
    private ServiceDiscoveryStorageMode? _storageMode;
    private EIsolationHandlingMode _isolationMode;
    private LeaderStatus _localStatus;
    private DateTime? _localBecomeTime;
    private string? _localETag;
    private List<InstanceDisplayItem> _instances = [];
    private IDialogReference? _confirmation;
    private Task? _actionTask;
    private Task? _disposeTask;
    private Task? _focusTask;
    private ElementReference _identityHeading;
    private bool _restoreHeadingFocus;
    private bool _retired;
    private bool _actionBusy;
    private bool _leaderDeleted;
    private bool HasLeader => _service?.Instances.Values.Any(instance => instance.IsLeader) == true;

    protected override void OnParametersSet()
    {
        if (_service is not null || Service is null) return;
        _service = ServiceDiscoverySnapshot.Copy(Service);
        _frozenAt = DateTime.UtcNow;
        _hasCaptureTime = CapturedAt.HasValue;
        var captured = CapturedAt ?? _frozenAt;
        _capturedAt = captured.Kind == DateTimeKind.Local ? captured.ToUniversalTime() : DateTime.SpecifyKind(captured, DateTimeKind.Utc);
        var options = ServiceDiscoveryOptions.Value;
        var election = options.Election;
        _election = new ElectionConfig
        {
            HeartbeatPeriodSeconds = election.HeartbeatPeriodSeconds,
            HeartbeatJitterMilliseconds = election.HeartbeatJitterMilliseconds,
            RegistrationOfflineTTLMultiplier = election.RegistrationOfflineTTLMultiplier,
            RegistrationOfflineTTLAdditionalSeconds = election.RegistrationOfflineTTLAdditionalSeconds,
            LeaderOfflineTTLMultiplier = election.LeaderOfflineTTLMultiplier,
            LeaderOfflineTTLAdditionalSeconds = election.LeaderOfflineTTLAdditionalSeconds
        };
        _hostRole = options.Role;
        _storageMode = options.StorageMode;
        _isolationMode = options.IsolationHandlingMode;
        _localStatus = LeaderElectionService.CurrentStatus;
        _localBecomeTime = LeaderElectionService.LeaderBecomeTime;
        _localETag = LeaderElectionService.CurrentETag;
        _instances = _service.Instances.Values.Select(instance => new InstanceDisplayItem(instance, false, null))
            .Concat(_service.EvictedInstances.Select(instance => new InstanceDisplayItem(instance.ToInstanceState(), true, instance.EvictionTime)))
            .OrderBy(instance => instance.IsEvicted).ThenByDescending(instance => instance.EvictionTime ?? DateTime.MinValue).ToList();
    }

    private sealed record InstanceDisplayItem(InstanceState Instance, bool IsEvicted, DateTime? EvictionTime);
    private string Value(string? value) => string.IsNullOrWhiteSpace(value) ? L["Shared:Values:NotSpecified"].Value : value;
    private string Time(DateTime? timestamp) => timestamp is null || timestamp == DateTime.MinValue
        ? L["Shared:Values:NotAvailable"].Value : timestamp.Value.FromUtcToLocal().ToString("yyyy-MM-dd HH:mm:ss");
    private string HeartbeatHealth(DateTime heartbeat)
    {
        if (heartbeat == DateTime.MinValue) return L["Shared:Values:NotAvailable"].Value;
        var age = Math.Max(0, (_capturedAt - DateTime.SpecifyKind(heartbeat, DateTimeKind.Utc)).TotalSeconds);
        return L[age < _election.HeartbeatPeriodSeconds * 1.5 ? "Shared:HeartbeatHealth:Healthy"
            : age < _election.RegistrationTTL.TotalSeconds ? "Shared:HeartbeatHealth:Unhealthy" : "Shared:HeartbeatHealth:Offline"].Value;
    }

    private Task OnForceDeleteLeaderClicked()
    {
        if (_retired || _actionBusy || _leaderDeleted || !HasLeader) return Task.CompletedTask;
        return _actionTask = ForceDeleteLeaderAsync();
    }

    private async Task ForceDeleteLeaderAsync()
    {
        if (_service is null) return;
        _actionBusy = true;
        try
        {
            var title = L["ServiceDetail:Dialogs:ConfirmActionTitle"].Value;
            RenderFragment heading = builder =>
            {
                builder.OpenComponent<MoDialogHeading>(0);
                builder.AddAttribute(1, nameof(MoDialogHeading.Text), title);
                builder.CloseComponent();
            };
            var parameters = new DialogParameters
            {
                [nameof(MudMessageBox.Title)] = title,
                [nameof(MudMessageBox.TitleContent)] = heading,
                [nameof(MudMessageBox.Message)] = L["Workbench:ForceDeleteConfirmation", _service.AppId].Value,
                [nameof(MudMessageBox.YesText)] = L["ServiceDetail:Dialogs:ConfirmDelete"].Value,
                [nameof(MudMessageBox.CancelText)] = L["Shared:Actions:Cancel"].Value
            };
            var reference = await DialogService.ShowAsync<MudMessageBox>(title, parameters,
                new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
            if (_retired) { CancelConfirmation(reference); return; }
            _confirmation = reference;
            var confirmation = await reference.Result;
            _confirmation = null;
            if (_retired || confirmation is null || confirmation.Canceled || confirmation.Data is not true) return;
            var result = await ServiceDiscoveryFacade.ForceDeleteLeaderAsync(_service.AppId);
            if (_retired) return;
            if (result.IsFailed(out var error))
                Snackbar.Add(L["ServiceDetail:Messages:DeleteLeaderFailed", error.Message ?? L["Shared:Values:Unknown"].Value].Value, Severity.Error);
            else
            {
                _leaderDeleted = true;
                Snackbar.Add(L["ServiceDetail:Messages:DeleteLeaderSucceeded"].Value, Severity.Success);
            }
        }
        finally
        {
            if (!_retired)
            {
                _actionBusy = false;
                _restoreHeadingFocus = true;
            }
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (_retired || !_restoreHeadingFocus) return Task.CompletedTask;
        _restoreHeadingFocus = false;
        return _focusTask = RestoreHeadingFocusAsync(_focusTask);
    }

    private async Task RestoreHeadingFocusAsync(Task? previous)
    {
        if (previous is not null) await previous;
        if (_retired || _actionBusy) return;
        try { await _identityHeading.FocusAsync(preventScroll: true); }
        catch (JSDisconnectedException) { }
    }

    private string IsolationModeText() => L[_isolationMode switch
    {
        EIsolationHandlingMode.ContinueRunning => "ServiceDetail:Configuration:Values:ContinueRunning",
        EIsolationHandlingMode.FastShutdown => "ServiceDetail:Configuration:Values:FastShutdown",
        _ => "Shared:Values:Unknown"
    }].Value;
    private string StorageModeText() => L[_storageMode switch
    {
        ServiceDiscoveryStorageMode.Memory => "ServiceDetail:Configuration:Values:MemoryStorage",
        ServiceDiscoveryStorageMode.Distributed => "ServiceDetail:Configuration:Values:DistributedStorage",
        ServiceDiscoveryStorageMode.ExternalKeyed => "ServiceDetail:Configuration:Values:ExternalKeyedStorage",
        _ => "Shared:Values:Unknown"
    }].Value;
    private string HostRoleText() => L[_hostRole switch
    {
        ServiceDiscoveryRole.Worker => "ServiceDetail:Configuration:Values:WorkerRole",
        ServiceDiscoveryRole.Registry => "ServiceDetail:Configuration:Values:RegistryRole",
        ServiceDiscoveryRole.Standalone => "ServiceDetail:Configuration:Values:StandaloneRole",
        _ => "Shared:Values:Unknown"
    }].Value;

    public ValueTask DisposeAsync() => new(_disposeTask ??= DisposeCoreAsync());

    private static void CancelConfirmation(IDialogReference reference)
    {
        var result = DialogResult.Cancel();
        reference.Close(result);
        reference.Dismiss(result);
    }

    private async Task DisposeCoreAsync()
    {
        _retired = true;
        if (_confirmation is { } confirmation) CancelConfirmation(confirmation);
        if (_actionTask is not null) await _actionTask;
        if (_focusTask is not null) await _focusTask;
    }
}
