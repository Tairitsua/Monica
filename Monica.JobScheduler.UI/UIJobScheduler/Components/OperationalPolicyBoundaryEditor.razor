@using System.Globalization
@using Monica.JobScheduler.UI.Localization
@using Monica.UI.Shared.Services

@inject IStringLocalizer<JobSchedulerResource> L
@inject TimeProvider TimeProvider
@inject MoTimeFormatter UiTime

@if (Compact)
{
    <div class="boundary-compact">
        <div class="boundary-compact__heading">
            <span>@Label</span>
            <div class="boundary-compact__mode">@ModeSelector</div>
        </div>
        @if (Draft.Mode == CronBoundaryOverrideMode.Value)
        {
            @BoundaryInputs
        }
        else
        {
            <p class="boundary-compact__effective">@FormatScheduleTime(EffectiveUtc)</p>
        }
    </div>
}
else
{
<article class="boundary-editor">
    <div class="boundary-editor__heading">
        <MudText Typo="Typo.subtitle2" HtmlTag="h5">@Label</MudText>
        <MudIconButton Icon="@MoIcons.Restore"
                       Size="Size.Small"
                       Disabled="@(Disabled || !Draft.HasOverride)"
                       OnClick="ResetAsync"
                       aria-label="@L["Policy:Actions:ResetField"]" />
    </div>
    <div class="boundary-editor__provenance">
        <div>
            <span>@L["Policy:Provenance:Declared"]</span>
            <strong>@FormatScheduleTime(DeclaredUtc)</strong>
        </div>
        <div class="boundary-editor__operator">
            <span>@L["Policy:Provenance:Override"]</span>
            @ModeSelector
            @if (Draft.Mode == CronBoundaryOverrideMode.Value)
            {
                @BoundaryInputs
            }
        </div>
        <div>
            <span>@L["Policy:Provenance:Effective"]</span>
            <strong>@FormatScheduleTime(EffectiveUtc)</strong>
        </div>
    </div>
</article>
}

@code {
    private TimeSpan? _clockRemainder;
    private IConverter<DateTime?, string?> _dateConverter = null!;
    private IConverter<TimeSpan?, string?> _timeConverter = null!;

    /// <summary>Gets whether to show the compact three-state control used by the schedule dialog.</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Gets or sets the localized start or end boundary label.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>Gets or sets the optional declaration boundary in UTC; null means no declaration boundary.</summary>
    [Parameter]
    public DateTimeOffset? DeclaredUtc { get; set; }

    /// <summary>Gets or sets the caller-owned prospective boundary, preserving inherit, no boundary and explicit time modes.</summary>
    [Parameter, EditorRequired]
    public CronBoundaryDraft Draft { get; set; } = null!;

    /// <summary>Gets or sets the immutable configured timezone used to display and validate local draft times.</summary>
    [Parameter, EditorRequired]
    public string TimeZoneId { get; set; } = string.Empty;

    /// <summary>Gets or sets whether native boundary controls are disabled during an admitted save.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Raised after a complete boundary mode, date, time or reset change.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private DateTimeOffset? EffectiveUtc => Draft.HasOverride ? Draft.OverrideUtc : DeclaredUtc;

    private RenderFragment ModeSelector => @<MudSelect T="CronBoundaryOverrideMode"
                                                       Value="@Draft.Mode"
                                                       ValueChanged="SetModeAsync"
                                                       Variant="Variant.Outlined"
                                                       Margin="Margin.Dense"
                                                       Disabled="@Disabled"
                                                       aria-label="@($"{Label} · {L["Policy:Schedule:BoundaryMode"]}")"
                                                       OpenIcon="@MoIcons.ChevronDown"
                                                       CloseIcon="@MoIcons.ChevronUp">
        <MudSelectItem T="CronBoundaryOverrideMode" Value="CronBoundaryOverrideMode.Inherit">@L["Policy:BoundaryModes:Inherit"]</MudSelectItem>
        <MudSelectItem T="CronBoundaryOverrideMode" Value="CronBoundaryOverrideMode.None">@L["Policy:BoundaryModes:None"]</MudSelectItem>
        <MudSelectItem T="CronBoundaryOverrideMode" Value="CronBoundaryOverrideMode.Value">@L["Policy:BoundaryModes:Value"]</MudSelectItem>
    </MudSelect>;

    private RenderFragment BoundaryInputs => @<div class="boundary-editor__date-time">
        <div class="boundary-editor__inputs">
            <MudDatePicker Date="@Draft.LocalDate"
                           DateChanged="SetDateAsync"
                           Converter="@_dateConverter"
                           Label="@L["Policy:Schedule:BoundaryDate"]"
                           DateFormat="yyyy-MM-dd"
                           Editable="true"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Disabled="@Disabled"
                           AdornmentIcon="@MoIcons.Calendar"
                           AdornmentAriaLabel="@L["Policy:Schedule:BoundaryDate"]"
                           PreviousIcon="@MoIcons.ChevronLeft"
                           NextIcon="@MoIcons.ChevronRight"
                           ClearIcon="@MoIcons.Close" />
            <MudTimePicker Time="@Draft.LocalTime"
                           TimeChanged="SetTimeAsync"
                           Converter="@_timeConverter"
                           PickerOpened="RememberClockSeconds"
                           PickerClosed="ClearClockSeconds"
                           Label="@L["Policy:Schedule:BoundaryTime"]"
                           TimeFormat="HH:mm:ss"
                           AmPm="false"
                           Editable="true"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Disabled="@Disabled"
                           AdornmentIcon="@MoIcons.Clock"
                           AdornmentAriaLabel="@L["Policy:Schedule:BoundaryTime"]"
                           ClearIcon="@MoIcons.Close" />
        </div>
        <p class="boundary-editor__time-hint">@L["Policy:Schedule:BoundaryTimeHint"]</p>
        @if (Draft.ValidationFailure != CronBoundaryValidationFailure.None)
        {
            <p class="boundary-editor__error" role="alert">@L[$"Policy:Schedule:BoundaryFailures:{Draft.ValidationFailure}"]</p>
        }
        else if (Draft.IsAmbiguousLocalTime)
        {
            <p class="boundary-editor__warning">@L["Policy:Schedule:AmbiguousBoundary"]</p>
        }
    </div>;

    protected override void OnInitialized()
    {
        _dateConverter = Conversions.From<DateTime?, string?>(
            value => value?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), ParseDate);
        _timeConverter = Conversions.From<TimeSpan?, string?>(
            value => value?.ToString(@"hh\:mm\:ss", CultureInfo.InvariantCulture), ParseTime);
    }

    private DateTime? ParseDate(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        return DateTime.TryParseExact(text.Trim(), "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var date)
            ? date
            : throw new FormatException(L["Policy:Schedule:BoundaryValidationError"]);
    }

    private TimeSpan? ParseTime(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return null;
        }

        return DateTime.TryParseExact(text.Trim(), ["HH:mm:ss", "HH:mm"], CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var time)
            ? time.TimeOfDay
            : throw new FormatException(L["Policy:Schedule:BoundaryValidationError"]);
    }

    private async Task SetModeAsync(CronBoundaryOverrideMode mode)
    {
        Draft.SetMode(mode, DeclaredUtc, TimeProvider.GetUtcNow());
        await Changed.InvokeAsync();
    }

    private async Task SetDateAsync(DateTime? value)
    {
        Draft.LocalDate = value;
        await Changed.InvokeAsync();
    }

    private async Task SetTimeAsync(TimeSpan? value)
    {
        // MudBlazor's clock edits hours and minutes; the text input still accepts exact seconds.
        Draft.LocalTime = _clockRemainder is { } remainder && value is { } selected
            ? new TimeSpan(selected.Hours, selected.Minutes, 0) + remainder
            : value;
        await Changed.InvokeAsync();
    }

    private void RememberClockSeconds() => _clockRemainder = TimeSpan.FromTicks(
        (Draft.LocalTime?.Ticks ?? 0) % TimeSpan.TicksPerMinute);

    private void ClearClockSeconds() => _clockRemainder = null;

    private async Task ResetAsync()
    {
        Draft.Reset(DeclaredUtc);
        await Changed.InvokeAsync();
    }

    private string FormatScheduleTime(DateTimeOffset? value) => value is null
        ? L["Common:NotAvailable"]
        : UiTime.FormatWallTime(TimeZoneInfo.ConvertTime(value.Value, TimeZoneInfo.FindSystemTimeZoneById(TimeZoneId)));
}
