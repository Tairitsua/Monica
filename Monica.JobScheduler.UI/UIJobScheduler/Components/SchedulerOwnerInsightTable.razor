@using Monica.JobScheduler.Models.Operations
@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Support
@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation

<section class="runtime-owners" aria-labelledby="runtime-owners-heading">
    <header class="runtime-owners__heading">
        <MoIcon Icon="@MoIcons.Network" aria-hidden="true" Size="1.5rem" />
        <div>
            <h2 id="runtime-owners-heading">@L["Runtime:Owners:Title"]</h2>
            <p>
                <MudTooltip Text="@($"{L["Runtime:Config:ExactInterval"]}: {SchedulerRuntimePresentation.FormatExactInterval(Overview.OwnerOnlineThreshold)}")">
                    <span class="runtime-owners__threshold" tabindex="0">@L["Runtime:Owners:Description", SchedulerRuntimePresentation.FormatInterval(Overview.OwnerOnlineThreshold, L)]</span>
                </MudTooltip>
            </p>
        </div>
    </header>
    <div class="runtime-owners__table">
        <MudTable T="JobOwnerSummary" Items="@Overview.Owners" Dense="true" Hover="true" Square="true" Elevation="0" Breakpoint="Breakpoint.None">
            <ColGroup>
                <col class="runtime-owners__identity-column" />
                <col class="runtime-owners__observation-column" />
                <col class="runtime-owners__counts-column" />
                <col class="runtime-owners__counts-column" />
            </ColGroup>
            <HeaderContent>
                <MudTh>@L["Runtime:Owners:Owner"]</MudTh>
                <MudTh>@L["Runtime:Owners:Liveness"]</MudTh>
                <MudTh>@L["Runtime:Owners:Jobs"]</MudTh>
                <MudTh>@L["Runtime:Owners:Active"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{ var freshness = SchedulerRuntimePresentation.ClassifyOwnerObservation(Overview.CapturedAtUtc, context.LastObservedAtUtc, Overview.OwnerOnlineThreshold); }
                <MudTd DataLabel="@L["Runtime:Owners:Owner"]">
                    <a class="runtime-owners__owner-link" href="@CatalogUrl(context.OwnerKey)" aria-label="@L["Runtime:Owners:OpenCatalog", context.OwnerKey]">
                        <code>@context.OwnerKey</code>
                        <MoIcon Icon="@MoIcons.ArrowRight" aria-hidden="true" Size="1.5rem" />
                    </a>
                </MudTd>
                <MudTd DataLabel="@L["Runtime:Owners:Liveness"]">
                    <div class="runtime-owners__observation">
                        <span class="runtime-owners__status" data-freshness="@freshness.ToString().ToLowerInvariant()">
                            <MoIcon Icon="@ObservationIcon(freshness)" aria-hidden="true" Size="1.5rem" />
                            @ObservationText(freshness)
                        </span>
                        <div class="runtime-owners__time">
                            <span>@L["Runtime:Owners:ManifestPublished"]</span>
                            <time datetime="@context.ManifestPublishedAtUtc?.ToString("O")">@TimePresentation.FormatTimestamp(context.ManifestPublishedAtUtc)</time>
                            <span>@L["Runtime:Owners:LastObserved"]</span>
                            <time datetime="@context.LastObservedAtUtc.ToString("O")">@TimePresentation.FormatTimestamp(context.LastObservedAtUtc)</time>
                        </div>
                        @if (context.ManifestHash is { } hash)
                        {
                            <details>
                                <summary>@L["Runtime:Owners:ManifestHash"]</summary>
                                <code>@hash</code>
                            </details>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="@L["Runtime:Owners:Jobs"]">
                    <span class="runtime-owners__counts" title="@L["Runtime:Owners:JobsHelp"]">@L["Runtime:Owners:JobsCounts", context.PresentCount, context.AbsentCount]</span>
                </MudTd>
                <MudTd DataLabel="@L["Runtime:Owners:Active"]">
                    <span class="runtime-owners__counts">@L["Runtime:Owners:ActiveCounts", context.QueuedCount, context.RunningCount]</span>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="runtime-owners__empty">
                    <MoIcon Icon="@MoIcons.Network" aria-hidden="true" Size="1.5rem" />
                    <p>@L["Runtime:Owners:Empty"]</p>
                </div>
            </NoRecordsContent>
        </MudTable>
    </div>
</section>

@code {
    /// <summary>Gets or sets the captured durable footprint of definition-backed owners in one scheduler scope.</summary>
    /// <remarks>
    /// Freshness is relative to this snapshot's capture and supplied threshold. It is not remote process health.
    /// The caller owns authorization and refresh; native links preserve each exact ordinal owner identity.
    /// </remarks>
    [Parameter, EditorRequired]
    public JobSchedulerRuntimeOverview Overview { get; set; } = null!;

    private static string CatalogUrl(string ownerKey) => $"/job-scheduler/catalog?owner={Uri.EscapeDataString(ownerKey)}";

    private string ObservationText(SchedulerOwnerObservationFreshness freshness) => freshness switch
    {
        SchedulerOwnerObservationFreshness.Recent => L["Runtime:Owners:RecentObservation"],
        SchedulerOwnerObservationFreshness.Stale => L["Runtime:Owners:StaleObservation"],
        _ => L["Runtime:Owners:AheadOfCapture"]
    };

    private static string ObservationIcon(SchedulerOwnerObservationFreshness freshness) => freshness switch
    {
        SchedulerOwnerObservationFreshness.Recent => MoIcons.Success,
        SchedulerOwnerObservationFreshness.Stale => MoIcons.Clock,
        _ => MoIcons.Warning
    };
}
