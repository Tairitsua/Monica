@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@using Monica.UI.UISystemInfo.Models
@using Monica.UI.UISystemInfo.Components
@inject IStringLocalizer<SystemInfoResource> L

<MudDialog DefaultFocus="DefaultFocus.FirstChild" Style="width:min(480px,calc(100vw - 32px)); max-width:calc(100vw - 32px); margin:16px;">
    <TitleContent>
        <SystemInfoDialogHeading Text="@L["Page:Dialogs:Restart:Title"]" Tone="MoVisualRole.Error" Icon="@MoIcons.Power" Close="Cancel" />
    </TitleContent>
    <DialogContent>
        <div class="system-info-restart-dialog">
            <p>@L["Page:Dialogs:Restart:Summary"]</p>
            @if (Deployment is { } deployment)
            {
                <section class="system-info-dialog-impact"><h3>@L["Page:Recovery:Impact"]</h3>
                    <SystemInfoRestartImpact Deployment="@deployment" Compact="true" />
                </section>
            }
            <div class="system-info-restart-dialog__delay">
                <MoIcon Icon="@MoIcons.Clock" Size="1.25rem" />
                @L["Page:Dialogs:Restart:DelayNotice", DelaySeconds]
            </div>
            <div class="system-info-restart-dialog__fact">
                <MoIcon Icon="@MoIcons.Info" Size="1.25rem" />
                <div><p>@L["Page:Dialogs:Restart:SupervisorNote"]</p><p>@L["Page:Dialogs:Restart:Fact"]</p></div>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">@L["Page:Dialogs:Restart:Cancel"]</MudButton>
        <MudButton OnClick="Confirm"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@MoIcons.Power">
            @L["Page:Dialogs:Restart:Confirm"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public double DelaySeconds { get; set; }
    [Parameter] public SystemInfoRoleDeployment? Deployment { get; set; }

    private void Cancel() => MudDialog?.Cancel();
    private void Confirm() => MudDialog?.Close(DialogResult.Ok(true));
}
