@using Monica.EventBus.Models
@using Monica.Framework.UI.Pages
@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.Support
@using Monica.UI.Shared.Components.States
@inject IStringLocalizer<EventBusResource> L

@{
    var model = Workbench.Model!;
    var providers = model.Snapshot.Providers;
    var subscriptions = model.Snapshot.Subscriptions;
    var distributed = providers.Count(item => item.IsDistributed);
    var scope = Workbench.Query["scope"];
    var query = Workbench.Query["q"] ?? "";
    var search = query.Trim();
    var filtered = providers.Where(provider => (scope != "Distributed" || provider.IsDistributed)
        && (scope != "Local" || !provider.IsDistributed) && MatchesSearch(provider, search)).ToArray();
    var atRisk = providers.FirstOrDefault(provider => provider.UnhealthyTopicCount > 0);
    var keyed = providers.Count(provider => provider.ServiceKey is not null);
    var emptyKey = providers.FirstOrDefault(provider => provider.ServiceKey == "");
}
<section class="eb-sig">
    <EventBusDecision Role="third" Label="@L["Precision:PvLabel"]" Value="@providers.Count" Population="@L["Precision:PvUnit", distributed, providers.Count - distributed]">
        <Reasons>
            <EventBusReason Role="third" Count="@model.Distributed">@L.GetProviderModeText(true)</EventBusReason>
            <EventBusReason Role="info" Count="@(subscriptions.Count - model.Distributed)">@L.GetProviderModeText(false)</EventBusReason>
            <EventBusReason Role="error" Count="@(model.Failed + model.Recovering)">@L["Precision:OvReasonFailed"] / @L["Precision:OvReasonRecovering"]</EventBusReason>
        </Reasons>
        <Finding>
            @if (atRisk is null && keyed == 0)
            {
                @L["Precision:PvCalm", providers.Count, subscriptions.Count]
            }
            else
            {
                @if (atRisk is not null)
                {
                    <a class="vmark is-link mo-vl-role--error" href="@Workbench.InspectionLink("provider", atRisk.UniqueId)">@L.GetProviderKindText(atRisk.ProviderType) · @EventBusPresentation.KeyText(atRisk.ServiceKey, L)</a>
                    @L["Precision:PvReports"]
                    <span class="vmark mo-vl-role--error">@L["Precision:PvUnhealthy", atRisk.UnhealthyTopicCount]</span>
                }
                else { @L["Precision:PvNoFaults", distributed] }
                @if (keyed > 0)
                {
                    @L["Precision:PvKeyed", keyed]
                    @if (emptyKey is not null)
                    {
                        @L["Precision:PvEmptyFinding"]
                        <a class="vmark is-link mo-vl-role--info mono" href="@Workbench.InspectionLink("provider", emptyKey.UniqueId, "options")">""</a>
                    }
                }
            }
        </Finding>
    </EventBusDecision>
</section>

<section class="surface eb-pv-surface" aria-label="@L["Precision:PvLabel"]">
    <div class="eb-toolbar eb-pv-toolbar">
        <div class="fchips" role="group" aria-label="@L["Precision:SubFilterScope"]">
            <EventBusFilterChip Count="@providers.Count" Selected="@(scope is null)" Select='() => Workbench.EditQuery(("scope", null))'>@L["Precision:PvFilterAll"]</EventBusFilterChip>
            <EventBusFilterChip Role="third" Count="@distributed" Selected='@(scope == "Distributed")' Select='() => Workbench.EditQuery(("scope", "Distributed"))'>@L["Precision:PvFilterDist"]</EventBusFilterChip>
            <EventBusFilterChip Role="info" Count="@(providers.Count - distributed)" Selected='@(scope == "Local")' Select='() => Workbench.EditQuery(("scope", "Local"))'>@L["Precision:PvFilterLocal"]</EventBusFilterChip>
        </div>
        <div class="eb-toolbar-end">
            <label class="eb-search"><MoIcon Class="i" Icon="@MoIcons.Search" Size="15px" />
                <input type="search" value="@query" placeholder="@L["Precision:PvSearchPh"]" aria-label="@L["Precision:PvSearchPh"]"
                       @oninput='args => Workbench.EditQuery(("q", args.Value is string { Length: > 0 } value ? value : null))' />
            </label>
            <span class="eb-shown">@L["Precision:PvShown", filtered.Length, providers.Count]</span>
        </div>
    </div>
    @if (filtered.Length == 0)
    {
        <MoContentState>
            <MoIcon Icon="@MoIcons.SearchOff" Size="18px" /><h2>@L["Precision:PvEmptySearch"]</h2>
            <button class="btn btn-outline btn-sm" type="button" @onclick='() => Workbench.EditQuery(("q", null), ("scope", null))'>@L["Precision:PvClearSearch"]</button>
        </MoContentState>
    }
    else
    {
        <div class="eb-pv-groups">
            @foreach (var group in filtered.GroupBy(provider => provider.ServiceKey is not null).OrderBy(group => group.Key))
            {
                <div class="eb-pv-group">
                    <header class="eb-pv-group-head"><h3>@L[group.Key ? "Precision:PvGroupKeyed" : "Precision:PvGroupDefault"]</h3><span class="count">@group.Count()</span></header>
                    <div class="eb-pv-rows">
                        @foreach (var provider in group)
                        {
                            var href = Workbench.InspectionLink("provider", provider.UniqueId);
                            var rows = subscriptions.Where(row => row.Scope == (provider.IsDistributed ? EventSubscriptionScope.Distributed : EventSubscriptionScope.Local)
                                && string.Equals(row.ServiceKey, provider.ServiceKey, StringComparison.Ordinal)).ToArray();
                            var denominator = Math.Max(1, subscriptions.Count);
                            <article class="eb-pv-row" @key="provider.UniqueId">
                                <div class="eb-pv-id">
                                    <a href="@href" class="eb-tbadge-btn"><EventBusTransportBadge Distributed="@provider.IsDistributed" Kind="@provider.ProviderType" ServiceKey="@provider.ServiceKey" Large="true" /></a>
                                    <span class="eb-pv-impl mono">@provider.ImplementationType</span>
                                </div>
                                <div class="eb-pv-share">
                                    <div class="eb-pv-share-head"><span class="mono"><b>@provider.ActiveSubscriptionCount</b> / @provider.SubscriptionCount</span><span class="eb-row-sub">@L.GetSubscriptionStateText(EventSubscriptionState.Active)</span></div>
                                    <div class="meter" role="img" aria-label="@($"{provider.SubscriptionCount} / {subscriptions.Count}")">
                                        @foreach (var segment in rows.GroupBy(row => EventBusVisuals.Role(row.State)).OrderBy(group => SegmentOrder(group.Key)))
                                        {
                                            <span class="mo-vl-role--@segment.Key @(segment.Key == "neutral" ? "is-light" : null)" style="@FormattableString.Invariant($"width:{100d * segment.Count() / denominator:0.##}%")"></span>
                                        }
                                    </div>
                                </div>
                                <div class="eb-pv-topics">
                                    @if (!provider.IsDistributed) { <span class="eb-row-sub">@L.CoverageText(EventBusCoverage.Local)</span> }
                                    else
                                    {
                                        <div class="eb-pv-topic-pills">
                                            @foreach (var status in model.Topics.Where(topic => topic.ServiceKey == provider.ServiceKey)
                                                .GroupBy(topic => topic.Coverage == EventBusCoverage.HealthyErr ? EventBusCoverage.Healthy : topic.Coverage)
                                                .OrderBy(status => status.Key))
                                            {
                                                @if (status.Key == EventBusCoverage.Unreported)
                                                {
                                                    <span class="eb-rt-unreported"><span class="sw is-hatch"></span>@L.CoverageText(status.Key) @status.Count()</span>
                                                }
                                                else
                                                {
                                                    <span class="status is-pill mo-vl-role--@EventBusVisuals.Role(status.Key)"><span class="status-dot"></span>@L.CoverageText(status.Key) @status.Count()</span>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="eb-pv-caps"><EventBusCapabilityChips Provider="@provider" /></div>
                                <div class="eb-pv-act">
                                    <a class="btn btn-ghost btn-sm" href="@EventBusRouteQuery.To(UIEventBusSubscriptionsPage.PAGE_URL, ("provider", provider.UniqueId))">@L["Precision:PvFilterSubs"]</a>
                                    <a class="btn btn-outline btn-sm" href="@href">@L["Precision:PvViewDetails"]</a>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            }
        </div>
    }
    <footer class="eb-surface-foot"><MoIcon Icon="@MoIcons.Info" Size="14px" />@L["Precision:PvFoot"]</footer>
</section>

@code {
    /// <summary>Gets the workbench that owns the captured provider group and route selection.</summary>
    [CascadingParameter] public EventBusWorkbench Workbench { get; set; } = null!;

    private bool MatchesSearch(EventBusProviderInfo item, string search) => search.Length == 0 ||
        new[] { item.ServiceKey, item.ImplementationType, L.GetProviderKindText(item.ProviderType),
            L.GetProviderModeText(item.IsDistributed), EventBusPresentation.KeyText(item.ServiceKey, L) }
        .Any(value => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true);

    private static int SegmentOrder(string role) => role switch { "success" => 0, "info" => 1, "warning" => 2, _ => 3 };
}
