@using Monica.EventBus.Models
@using Monica.Framework.UI.UIEventBus.Support
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@inject IStringLocalizer<EventBusResource> L

@if (Status is { } status)
{
    <div class="eb-te">
        <div class="eb-te-head">
            <EventBusRuntimeBadge Status="@status" />
            <span class="eb-te-since">@L["SubscriptionDetail:Runtime:StateSince"]
                <time class="mono" datetime="@EventBusVisuals.TimeTag(status.StateChangedAt)">@UiTime.Format(status.StateChangedAt)</time>
            </span>
        </div>
        <dl class="eb-te-counts">
            <div><dt>@L["SubscriptionDetail:Runtime:ProcessedMessages"]</dt><dd class="mono">@status.ProcessedMessages.ToString("N0")</dd></div>
            <div><dt>@L["SubscriptionDetail:Runtime:MessageErrorCount"]</dt><dd class="mono @(status.MessageErrorCount > 0 ? "eb-ink-warn" : null)">@status.MessageErrorCount</dd></div>
            <div><dt>@L["SubscriptionDetail:Runtime:ConsecutiveFailures"]</dt><dd class="mono @(status.ConsecutiveFailures > 0 ? "eb-ink-err" : null)">@status.ConsecutiveFailures</dd></div>
            <div><dt>@L["SubscriptionDetail:Runtime:RecoveryCount"]</dt><dd class="mono">@status.RecoveryCount</dd></div>
        </dl>
        <p class="eb-note">@L["Inspector:CounterScope"]</p>
        <dl class="eb-kv">
            <EventBusEvidenceField Label="@L["SubscriptionDetail:Runtime:Provider"]" Value="@L.GetProviderKindText(status.Provider)" Code="false" />
            <EventBusEvidenceField Label="@L["SubscriptionDetail:Runtime:LastMessageAt"]" Value="@FormatOptional(status.LastMessageReceivedAt)" />
            <EventBusEvidenceField Label="@L["SubscriptionDetail:Runtime:LastErrorAt"]" Value="@FormatOptional(status.LastErrorAt)" />
        </dl>
        @if (!string.IsNullOrWhiteSpace(status.LastErrorMessage))
        {
            var failed = status.State == TopicSubscriptionRuntimeState.Failed;
            <div class="callout mo-vl-role--@(failed ? "error" : "warning")">
                <span class="tile"><MoIcon Icon="@(failed ? MoIcons.Error : MoIcons.Warning)" Size="16px" /></span>
                <div><b>@L["SubscriptionDetail:Runtime:LastError"]</b><span class="eb-te-errmsg">@status.LastErrorMessage</span><p>@L["Inspector:RetainedError"]</p></div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(status.LastErrorException))
        {
            <details class="eb-te-details"><summary>@L["SubscriptionDetail:Runtime:ExceptionDetails"]</summary><pre class="mono eb-break">@status.LastErrorException</pre></details>
        }
        @if (status.RecentErrors.Count > 0)
        {
            <section class="eb-insp-sec">
                <h3>@L["Inspector:RetainedErrors", status.RecentErrors.Count]</h3>
                <div class="eb-te-errbox">
                    @foreach (var error in status.RecentErrors.Reverse())
                    {
                        <article class="eb-receipt-item">
                            <time class="mono" datetime="@EventBusVisuals.TimeTag(error.OccurredAt)">@UiTime.Format(error.OccurredAt)</time>
                            <p class="eb-te-errmsg">@error.Message</p>
                            @if (!string.IsNullOrWhiteSpace(error.ExceptionText))
                            {
                                <details class="eb-te-details"><summary>@L["SubscriptionDetail:Runtime:ExceptionDetails"]</summary><pre class="mono eb-break">@error.ExceptionText</pre></details>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}
else
{
    <div class="callout mo-vl-role--neutral"><span class="tile"><MoIcon Icon="@MoIcons.RadioOff" Size="16px" /></span>
        <div><b>@L.CoverageText(EventBusCoverage.Unreported)</b><p>@L["Precision:InspUnreportedHelp"]</p></div>
    </div>
}

@code {
    /// <summary>Gets or sets the sampled transport evidence, with null indicating an unreported distributed topic.</summary>
    [Parameter] public TopicSubscriptionStatus? Status { get; set; }

    private string? FormatOptional(DateTime? instant) => instant is null ? null : UiTime.Format(instant);
}
