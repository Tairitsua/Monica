    <NoWarn>$(NoWarn);CS1998</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageDescription>Framework UI dashboards and admin panels for Monica framework, providing monitoring and management interfaces for framework components.</PackageDescription>
