@using Monica.UI.Shared.Components.States
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@attribute [Route(PAGE_URL)]
@using Monica.Profiling.ExecutionTiming.Models
@using Monica.Profiling.UIExecutionTiming.Components
@inject ExecutionTimingPageStateFactory PageStateFactory
@using Monica.UI.Shared.Components.Visual
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IStringLocalizer<ExecutionTimingResource> L
@inject ILogger<UIExecutionTimingPage> Logger
@implements IAsyncDisposable

<PageTitle>@L["Pages:ExecutionTiming:Title"]</PageTitle>
<div class="execution-timing-page mo-page-shell mo-page-shell--full-width">
    <MoPageMasthead Icon="@MoIcons.Timer" Title="@L["Design:Title"]" Crumb="@L["Page:Eyebrow"]">
        <Meta><span class="mo-vl-status mo-vl-role--info"><i class="mo-vl-status-dot"></i>@PollingLabel</span><code>@Environment.MachineName</code><span>@UiTime.TimeZone.Id</span></Meta>
        <Actions>@if (PageState.SnapshotCapturedAt is { } at) { <div class="timing-stamp"><span>@L["Page:Captured"]</span><time datetime="@at.ToString("O")">@UiTime.FormatTime(at)</time></div> }
            <MudSwitch T="bool" Value="PageState.AutoRefresh" ValueChanged="SetAutoRefresh" Disabled="@(!PageState.CanAutoRefresh)" Color="Color.Primary" Label="@L["Page:Actions:AutoRefresh"]" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Refresh" OnClick="RefreshDataAsync" Disabled="@PageState.IsLoading">@L["Design:Refresh"]</MudButton>
        </Actions>
    </MoPageMasthead>
    @if (!PageState.AutoRefresh && PageState.HasSnapshot) { <small>@L["Design:PauseNotice",UiTime.FormatTime(PageState.SnapshotCapturedAt)!]</small> }
    @if (PageState.LoadError is not null)
    {
        <div class="timing-error" role="status">
            <MoIcon Icon="@MoIcons.Info" Size="1.25rem" />
            <div><strong>@L["Page:Messages:RefreshFailed"]</strong><p>@(PageState.HasSnapshot ? L["Page:Messages:Retained"] : L["Page:Messages:NoSnapshot"])</p>
                @if (!string.IsNullOrEmpty(PageState.LoadError)) { <p>@PageState.LoadError</p> }
            </div>
        </div>
    }
    @if (PageState.IsLoading)
    {
        <div class="timing-loading" role="status" aria-label="@L["Page:Loading"]"><MudProgressLinear Indeterminate="true" Color="Color.Primary" /></div>
    }
    @if (PageState.HasSnapshot && PageState.SnapshotCapturedAt is { } snapshotAt)
    {
        @if (PageState.Statistics.Count == 0 && PageState.RunningOperations.Count == 0)
        { <MoContentState><h2>@L["Design:EmptyTitle"]</h2><p>@L["Design:EmptyBody"]</p></MoContentState> }
        else
        {
            <TimingLatencyBench Statistics="@PageState.Statistics" Running="@PageState.RunningOperations" CapturedAt="@snapshotAt" />
            <TimingStatisticsPanel Statistics="@PageState.Statistics" Running="@PageState.RunningOperations" CapturedAt="@snapshotAt" OnInspect="InspectCompletedAsync" Search="@Search" Point="@Point" Signal="@Signal" Sort="@Sort" PageNumber="@LedgerPage" />
            <TimingRunningPanel Operations="@PageState.RunningOperations" Statistics="@PageState.Statistics" CapturedAt="@snapshotAt" OnInspect="InspectRunningAsync" Search="@RunningSearch" PageNumber="@RunningPage" />
        }
        @if (Operation is not null || Invocation is not null) { <TimingEvidenceSheet @key="(Operation,Invocation)" State="@PageState" Operation="@Operation" Invocation="@Invocation" /> }
    }
    else if (PageState.LoadError is null)
    {
        <div class="timing-awaiting"><MoContentState Loading="true">@L["Page:Loading"]</MoContentState></div>
    }
</div>

@code {
    public const string PAGE_URL = "/execution-timing";
    private ExecutionTimingPageState PageState { get; set; } = null!;
    private readonly HashSet<Task> _renderTasks = [];
    private readonly object _renderLock = new();
    [SupplyParameterFromQuery(Name = "op")] public string? Operation { get; set; }
    [SupplyParameterFromQuery(Name = "inv")] public string? Invocation { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "point")] public string? Point { get; set; }
    [SupplyParameterFromQuery(Name = "signal")] public string? Signal { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public string? LedgerPage { get; set; }
    [SupplyParameterFromQuery(Name = "rq")] public string? RunningSearch { get; set; }
    [SupplyParameterFromQuery(Name = "rpage")] public string? RunningPage { get; set; }
    private bool _disposed;

    private string PollingLabel => !PageState.CanAutoRefresh ? L["Page:Status:Manual"]
        : PageState.AutoRefresh ? L["Page:Status:Live", PageState.RefreshIntervalMs / 1000d] : L["Page:Status:Paused"];

    protected override async Task OnInitializedAsync()
    {
        PageState = PageStateFactory.Create();
        PageState.StateChanged += HandleStateChanged;
        await PageState.InitializeAsync();
    }
    private async Task RefreshDataAsync()
    {
        var result = await PageState.RefreshAsync();
        if (!_disposed && result.Status != ResultStatus.Conflict && result.IsFailure())
            Snackbar.Add(L["Page:Messages:RefreshFailed"], Severity.Error);
    }
    private Task SetAutoRefresh(bool value) => PageState.SetAutoRefreshAsync(value);
    private void InspectCompletedAsync(TimingCompletedEvidence evidence) => Nav.NavigateTo(Nav.GetUriWithQueryParameters(
        new Dictionary<string,object?> { ["op"] = evidence.Statistics.OperationKey, ["inv"] = null }));
    private void InspectRunningAsync(TimingRunningEvidence evidence) => Nav.NavigateTo(Nav.GetUriWithQueryParameters(
        new Dictionary<string,object?> { ["inv"] = evidence.Operation.InvocationId, ["op"] = null }));
    private void HandleStateChanged()
    {
        if (_disposed) return;
        var render = ObserveRenderAsync(InvokeAsync(() => { if (!_disposed) StateHasChanged(); }));
        lock (_renderLock) _renderTasks.Add(render);
        _ = RemoveRenderAsync(render);
    }
    private async Task ObserveRenderAsync(Task render)
    {
        try { await render; }
        catch (Exception exception) { Logger.LogError(exception, "Execution timing page rendering failed."); }
    }
    private async Task RemoveRenderAsync(Task render)
    {
        await render;
        lock (_renderLock) _renderTasks.Remove(render);
    }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        PageState.StateChanged -= HandleStateChanged;
        try { await PageState.DisposeAsync(); }
        finally
        {
            Task[] renders;
            lock (_renderLock) renders = _renderTasks.ToArray();
            await Task.WhenAll(renders);
        }
    }
}
