@using Monica.UI.Shared.Components.States
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.SignalR.Models
@inject IStringLocalizer<SignalRResource> L

<section class="signalr-send-diagnostics" aria-label="@L["UISignalR:SendDiagnostics:Title"]">
    <header class="signalr-evidence-heading">
        <div>
            <span class="signalr-evidence-scope">@L["UISignalR:SendDiagnostics:Scope"]</span>
            <h2>@L["UISignalR:SendDiagnostics:Title"]</h2>
        </div>
        <MudButton OnClick="OnRefreshClicked" StartIcon="@MoIcons.Refresh"
                   Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined" Disabled="IsLoading">
            @L["UISignalR:SendDiagnostics:Refresh"]
        </MudButton>
    </header>

    @if (Snapshot is not null)
    {
        <time class="signalr-evidence-captured" datetime="@Snapshot.SnapshotTimeUtc.ToString("O")">
            @L["UISignalR:SendDiagnostics:SnapshotTime", UiTime.Format(Snapshot.SnapshotTimeUtc)]
        </time>
    }

    @if (IsLoading)
    {
        @if (Snapshot is null)
        {
            <MoContentState Loading="true" Compact="true"><MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" /><span>@L["UISignalR:SendDiagnostics:Loading"]</span></MoContentState>
        }
        else
        {
            <div class="signalr-evidence-loading">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@L["UISignalR:SendDiagnostics:Loading"]" />
            <span>@L["UISignalR:SendDiagnostics:Loading"]</span>
        </div>
        }
    }

    @if (Snapshot is null)
    {
        @if (LoadFailed)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="signalr-evidence-state" Icon="@MoIcons.Error">@L["UISignalR:SendDiagnostics:LoadFailed"]</MudAlert>
        }
        else if (!IsLoading)
        {
            <div class="signalr-evidence-empty"><MoContentState Compact="true">@L["UISignalR:SendDiagnostics:NotLoaded"]</MoContentState></div>
        }
    }
    else
    {
        @if (LoadFailed)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="signalr-evidence-state" Icon="@MoIcons.Warning">@L["UISignalR:SendDiagnostics:RefreshFailed"]</MudAlert>
        }

        @if (!Snapshot.IsEnabled)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="signalr-evidence-state" Icon="@MoIcons.Info">@L["UISignalR:SendDiagnostics:Disabled"]</MudAlert>
        }
        else
        {
            <p class="signalr-evidence-note">@L["UISignalR:SendDiagnostics:EvidenceNote"]</p>
            @if (!string.IsNullOrWhiteSpace(Snapshot.Description))
            {
                <p class="signalr-evidence-description">@Snapshot.Description</p>
            }

            <dl class="signalr-send-totals">
                <div><dt>@L["UISignalR:SendDiagnostics:Summary:Pending"]</dt><dd class="@(Snapshot.PendingSendCount > 0 ? "signalr-count--info" : string.Empty)">@Snapshot.PendingSendCount</dd></div>
                <div><dt>@L["UISignalR:SendDiagnostics:Summary:Started"]</dt><dd>@Snapshot.TotalStartedCount</dd></div>
                <div><dt>@L["UISignalR:SendDiagnostics:Summary:Completed"]</dt><dd class="@(Snapshot.TotalCompletedCount > 0 ? "signalr-count--success" : string.Empty)">@Snapshot.TotalCompletedCount</dd></div>
                <div><dt>@L["UISignalR:SendDiagnostics:Summary:Failed"]</dt><dd class="@(Snapshot.TotalFailedCount > 0 ? "signalr-count--error" : string.Empty)">@Snapshot.TotalFailedCount</dd></div>
            </dl>

            var methodMetrics = TopMethodMetrics;
            @if (methodMetrics.Count == 0)
            {
                <div class="signalr-evidence-empty"><MoContentState Compact="true">@L["UISignalR:SendDiagnostics:Empty"]</MoContentState></div>
            }
            else
            {
                <p class="signalr-evidence-ranking">@L["UISignalR:SendDiagnostics:RankedMethods", methodMetrics.Count, Snapshot.MethodMetrics.Count]</p>
                <div class="signalr-evidence-table-frame">
                    <MudTable T="SignalRSendMethodMetricInfo" Items="methodMetrics" Dense="true" Hover="true"
                              Square="true" Elevation="0" Breakpoint="Breakpoint.Xs" Class="signalr-evidence-table">
                        <HeaderContent>
                            <MudTh>@L["UISignalR:SendDiagnostics:Columns:Method"]</MudTh>
                            <MudTh>@L["UISignalR:SendDiagnostics:Columns:SendTasks"]</MudTh>
                            <MudTh>@L["UISignalR:SendDiagnostics:Columns:Durations"]</MudTh>
                            <MudTh>@L["UISignalR:SendDiagnostics:Columns:TargetBreakdown"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="methodMetric">
                            <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:Method"]">
                                <div class="signalr-method-identity"><span>@methodMetric.MethodName</span><code>@methodMetric.HubName</code></div>
                            </MudTd>
                            <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:SendTasks"]">
                                @TaskCounts(methodMetric.PendingSendCount, methodMetric.StartedCount, methodMetric.CompletedCount, methodMetric.FailedCount)
                            </MudTd>
                            <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:Durations"]">
                                @Durations(methodMetric.LastDurationMilliseconds, methodMetric.MaxDurationMilliseconds, methodMetric.AverageDurationMilliseconds, methodMetric.CompletedCount + methodMetric.FailedCount > 0)
                            </MudTd>
                            <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:TargetBreakdown"]">
                                <MudTooltip Text="@GetDetailsToggleLabel(methodMetric)">
                                    <MudButton StartIcon="@GetDetailsToggleIcon(methodMetric)" Size="Size.Small"
                                               Color="Color.Primary" Variant="Variant.Outlined"
                                               Class="signalr-target-toggle"
                                               Disabled="@(methodMetric.TargetMetrics.Count == 0)"
                                               OnClick="@(() => ToggleMethodDetails(methodMetric))"
                                               aria-label="@($"{GetDetailsToggleLabel(methodMetric)}: {FormatMethod(methodMetric)}")"
                                               aria-expanded="@(IsMethodExpanded(methodMetric) ? "true" : "false")">
                                        @methodMetric.TargetMetricCount
                                    </MudButton>
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                        <ChildRowContent Context="methodMetric">
                            @if (IsMethodExpanded(methodMetric) && methodMetric.TargetMetrics.Count > 0)
                            {
                                <MudTr>
                                    <td colspan="4" class="mud-table-cell signalr-evidence-detail-cell">
                                        <section class="signalr-target-evidence">
                                            <h3>@L["UISignalR:SendDiagnostics:TargetEvidence", FormatMethod(methodMetric)]</h3>
                                            <p>@L["UISignalR:SendDiagnostics:TargetScope"]</p>
                                            <div class="signalr-evidence-table-frame signalr-target-table-frame">
                                                <MudTable T="SignalRSendMetricInfo" Items="methodMetric.TargetMetrics" Dense="true"
                                                          Hover="true" Square="true" Elevation="0" Breakpoint="Breakpoint.Xs"
                                                          Class="signalr-target-table" RowsPerPage="5">
                                                    <HeaderContent>
                                                        <MudTh>@L["UISignalR:SendDiagnostics:Columns:Target"]</MudTh>
                                                        <MudTh>@L["UISignalR:SendDiagnostics:Columns:SendTasks"]</MudTh>
                                                        <MudTh>@L["UISignalR:SendDiagnostics:Columns:Durations"]</MudTh>
                                                        <MudTh>@L["UISignalR:SendDiagnostics:Columns:ActivityTime"]</MudTh>
                                                    </HeaderContent>
                                                    <RowTemplate Context="targetMetric">
                                                        <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:Target"]">
                                                            @if (IsUserIdentifierTarget(targetMetric))
                                                            {
                                                                <div class="signalr-user-targets">
                                                                    <span>@GetUserTargetLabel(targetMetric)</span>
                                                                    @for (var index = 0; index < targetMetric.TargetIdentifiers.Count; index++)
                                                                    {
                                                                        var identifier = targetMetric.TargetIdentifiers[index];
                                                                        var displayName = targetMetric.TargetIdentifierDisplayNames.ElementAtOrDefault(index);
                                                                        <div class="signalr-user-target">
                                                                            @if (!string.IsNullOrEmpty(displayName))
                                                                            {
                                                                                <MudTooltip Text="@identifier"><span class="signalr-target-name">@displayName</span></MudTooltip>
                                                                            }
                                                                            <code>@identifier</code>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <span class="signalr-target-label">@FormatTarget(targetMetric)</span>
                                                            }
                                                        </MudTd>
                                                        <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:SendTasks"]">
                                                            @TaskCounts(targetMetric.PendingSendCount, targetMetric.StartedCount, targetMetric.CompletedCount, targetMetric.FailedCount)
                                                        </MudTd>
                                                        <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:Durations"]">
                                                            @Durations(targetMetric.LastDurationMilliseconds, targetMetric.MaxDurationMilliseconds, targetMetric.AverageDurationMilliseconds, targetMetric.CompletedCount + targetMetric.FailedCount > 0)
                                                        </MudTd>
                                                        <MudTd DataLabel="@L["UISignalR:SendDiagnostics:Columns:ActivityTime"]">
                                                            <dl class="signalr-observed-times">
                                                                <div><dt>@L["UISignalR:SendDiagnostics:LastStarted"]</dt><dd>@FormatTimestamp(targetMetric.LastStartedAtUtc)</dd></div>
                                                                <div><dt>@L["UISignalR:SendDiagnostics:LastCompleted"]</dt><dd>@FormatTimestamp(targetMetric.LastCompletedAtUtc)</dd></div>
                                                            </dl>
                                                        </MudTd>
                                                    </RowTemplate>
                                                    <PagerContent>
                                                        <MudTablePager PageSizeOptions="@(new[] { 5, 10, 25 })"
                                                                       RowsPerPageString="@L["UISignalR:SendDiagnostics:TargetRowsPerPage"]"
                                                                       InfoFormat="@L["UISignalR:SendDiagnostics:TargetPageInfo"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" />
                                                    </PagerContent>
                                                </MudTable>
                                            </div>
                                        </section>
                                    </td>
                                </MudTr>
                            }
                        </ChildRowContent>
                    </MudTable>
                </div>
            }
        }
    }
</section>

@code {
    /// <summary>Gets or sets the latest successful host send-evidence snapshot.</summary>
    [Parameter] public SignalRSendDiagnosticsSnapshot? Snapshot { get; set; }

    /// <summary>Gets or sets whether the owning state is reading a new snapshot.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Gets or sets whether the most recent read failed; a successful retained snapshot remains visible.</summary>
    [Parameter] public bool LoadFailed { get; set; }

    /// <summary>Requests a new snapshot from the existing state owner.</summary>
    [Parameter] public EventCallback OnRefreshClicked { get; set; }

    private const int MethodLimit = 10;
    private readonly HashSet<string> _expandedMethodKeys = new(StringComparer.Ordinal);

    private IReadOnlyList<SignalRSendMethodMetricInfo> TopMethodMetrics => Snapshot?.MethodMetrics
        .OrderByDescending(metric => metric.PendingSendCount)
        .ThenByDescending(metric => metric.MaxDurationMilliseconds)
        .Take(MethodLimit)
        .ToList() ?? [];

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _expandedMethodKeys.IntersectWith(Snapshot?.MethodMetrics.Select(CreateMethodKey) ?? []);
    }

    private RenderFragment TaskCounts(long pending, long started, long completed, long failed) => @<dl class="signalr-evidence-measures">
        <div><dt>@L["UISignalR:SendDiagnostics:Columns:Pending"]</dt><dd class="@(pending > 0 ? "signalr-count--info" : string.Empty)">@pending</dd></div>
        <div><dt>@L["UISignalR:SendDiagnostics:Columns:Started"]</dt><dd>@started</dd></div>
        <div><dt>@L["UISignalR:SendDiagnostics:Columns:Completed"]</dt><dd>@completed</dd></div>
        <div><dt>@L["UISignalR:SendDiagnostics:Columns:Failed"]</dt><dd class="@(failed > 0 ? "signalr-count--error" : string.Empty)">@failed</dd></div>
    </dl>;

    private RenderFragment Durations(double last, double max, double average, bool hasObservation) => @<dl class="signalr-evidence-measures">
        <div><dt>@L["UISignalR:SendDiagnostics:Columns:LastDuration"]</dt><dd>@FormatDuration(last, hasObservation)</dd></div>
        <div><dt>@L["UISignalR:SendDiagnostics:Columns:MaxDuration"]</dt><dd>@FormatDuration(max, hasObservation)</dd></div>
        <div><dt>@L["UISignalR:SendDiagnostics:Columns:AverageDuration"]</dt><dd>@FormatDuration(average, hasObservation)</dd></div>
    </dl>;

    private string FormatDuration(double milliseconds, bool hasObservation) => hasObservation
        ? $"{milliseconds:0.###} ms"
        : L["UISignalR:SendDiagnostics:NoTimestamp"].Value;

    private string FormatTimestamp(DateTime? timestamp) => timestamp is { } value
        ? UiTime.Format(value)
        : L["UISignalR:SendDiagnostics:NoTimestamp"].Value;

    private static string FormatMethod(SignalRSendMethodMetricInfo metric) => $"{metric.HubName}.{metric.MethodName}";
    private bool IsMethodExpanded(SignalRSendMethodMetricInfo metric) => _expandedMethodKeys.Contains(CreateMethodKey(metric));
    private static string CreateMethodKey(SignalRSendMethodMetricInfo metric) => $"{metric.HubName}\u001f{metric.MethodName}";

    private void ToggleMethodDetails(SignalRSendMethodMetricInfo metric)
    {
        var key = CreateMethodKey(metric);
        if (!_expandedMethodKeys.Add(key))
        {
            _expandedMethodKeys.Remove(key);
        }
    }

    private string GetDetailsToggleIcon(SignalRSendMethodMetricInfo metric) => IsMethodExpanded(metric)
        ? MoIcons.ChevronUp
        : MoIcons.ChevronDown;

    private string GetDetailsToggleLabel(SignalRSendMethodMetricInfo metric) => IsMethodExpanded(metric)
        ? L["UISignalR:SendDiagnostics:Details:Collapse"].Value
        : L["UISignalR:SendDiagnostics:Details:Expand"].Value;

    private static bool IsUserIdentifierTarget(SignalRSendMetricInfo metric) => metric.TargetKind is SignalRSendTargetKind.User or SignalRSendTargetKind.Users
        && metric.TargetIdentifiers.Count > 0;

    private string GetUserTargetLabel(SignalRSendMetricInfo metric) => metric.TargetKind == SignalRSendTargetKind.User
        ? L["UISignalR:SendDiagnostics:Targets:UserTargetLabel"].Value
        : L["UISignalR:SendDiagnostics:Targets:UsersTargetLabel"].Value;

    private string FormatTarget(SignalRSendMetricInfo metric) => metric.TargetKind switch
    {
        SignalRSendTargetKind.All => L["UISignalR:SendDiagnostics:Targets:AllClients"].Value,
        SignalRSendTargetKind.AllExcept => FormatIdentifierTarget("UISignalR:SendDiagnostics:Targets:AllExceptIdentifiers", "UISignalR:SendDiagnostics:Targets:AllExceptCount", metric),
        SignalRSendTargetKind.Client => FormatIdentifierTarget("UISignalR:SendDiagnostics:Targets:ClientIdentifiers", "UISignalR:SendDiagnostics:Targets:ClientCount", metric),
        SignalRSendTargetKind.Clients => FormatIdentifierTarget("UISignalR:SendDiagnostics:Targets:ClientsIdentifiers", "UISignalR:SendDiagnostics:Targets:ClientsCount", metric),
        SignalRSendTargetKind.Group => FormatIdentifierTarget("UISignalR:SendDiagnostics:Targets:GroupIdentifiers", "UISignalR:SendDiagnostics:Targets:GroupCount", metric),
        SignalRSendTargetKind.Groups => FormatIdentifierTarget("UISignalR:SendDiagnostics:Targets:GroupsIdentifiers", "UISignalR:SendDiagnostics:Targets:GroupsCount", metric),
        SignalRSendTargetKind.GroupExcept => FormatIdentifierTarget("UISignalR:SendDiagnostics:Targets:GroupExceptIdentifiers", "UISignalR:SendDiagnostics:Targets:GroupExceptCount", metric),
        SignalRSendTargetKind.User => L["UISignalR:SendDiagnostics:Targets:UserCount", metric.TargetCount].Value,
        SignalRSendTargetKind.Users => L["UISignalR:SendDiagnostics:Targets:UsersCount", metric.TargetCount].Value,
        _ => FormatIdentifierTarget("UISignalR:SendDiagnostics:Targets:UnknownIdentifiers", "UISignalR:SendDiagnostics:Targets:UnknownCount", metric)
    };

    private string FormatIdentifierTarget(string identifiersKey, string countKey, SignalRSendMetricInfo metric) => metric.TargetIdentifiers.Count > 0
        ? L[identifiersKey, string.Join(", ", metric.TargetIdentifiers)].Value
        : L[countKey, metric.TargetCount].Value;
}
