@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.Core.Results
@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.State
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject EventBusTestService TestService
@inject ISnackbar Snackbar
@inject IStringLocalizer<EventBusResource> L
@inject ILogger<EventBusTestPanel> Logger

<section class="event-test-bench">
    <header class="test-bench-scope">
        <div class="test-bench-scope-icon"><MoIcon Icon="@MoIcons.Cloud" Size="1.5rem" /></div>
        <div><span class="test-bench-kicker">@L["TestBench:Eyebrow"]</span><h2>@L["TestBench:Title"]</h2><p>@L["TestBench:Scope"]</p></div>
        <div class="test-bench-contract"><span>@L["TestBench:EventContract"]</span><code>@nameof(TestEventMessage)</code></div>
    </header>
    <div class="test-bench-workspace">
        <section class="test-bench-publish">
            <header class="test-bench-section-heading"><span class="test-bench-step">01</span><div><h3>@L["TestPanel:Publish:Title"]</h3><p>@L["TestBench:PublishHelp"]</p></div></header>
            <div class="test-bench-form">
                <MudTextField T="string" @bind-Value="_publishTopicName" Label="@L["TestPanel:Publish:TopicName"]" Variant="Variant.Outlined" Immediate="true" Disabled="@(_retired || _commandBusy)" />
                <MudTextField T="string" @bind-Value="_publishMessage" Label="@L["TestPanel:Publish:MessageContent"]" Placeholder="@L["TestPanel:Publish:MessagePlaceholder"]" Variant="Variant.Outlined" Immediate="true" Lines="6" Disabled="@(_retired || _commandBusy)" />
                <p class="test-bench-help">@L["TestBench:AcceptanceHelp"]</p>
                <div class="test-bench-publish-actions"><MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@MoIcons.Send" OnClick="PublishMessageAsync" Disabled="@_retired" aria-disabled="@BusyAttribute" aria-busy="@(_publishing ? "true" : "false")">@(_publishing ? L["TestPanel:Publish:Sending"] : L["TestPanel:Publish:Send"])</MudButton></div>
                @if (_accepted) { <p class="test-bench-accepted" role="status"><MoIcon Icon="@MoIcons.Success" Size="1.25rem" />@L["TestBench:Accepted"]</p> }
            </div>
        </section>
        <section class="test-bench-receive">
            <header class="test-bench-section-heading"><span class="test-bench-step">02</span><div><h3>@L["TestBench:ReceiveTitle"]</h3><p>@L["TestBench:ReceiveHelp"]</p></div><span class="test-bench-listener-state" data-listening="@(_ownsSubscription ? "true" : "false")" role="status">@ListenerStateText</span></header>
            <div class="test-bench-listener">
                <MudTextField T="string" @bind-Value="_subscribeTopicName" Label="@L["TestPanel:Subscribe:TopicName"]" Variant="Variant.Outlined" Immediate="true" Disabled="@(_retired || _commandBusy || _ownsSubscription || !_listenerReady)" />
                <div class="test-bench-listener-actions">
                    <MudButton Color="@(_ownsSubscription ? Color.Warning : Color.Primary)" Variant="Variant.Outlined" StartIcon="@(_ownsSubscription ? MoIcons.StopCircle : MoIcons.Play)" OnClick="ToggleListeningAsync" Disabled="@_retired" aria-disabled="@ListenerBusyAttribute" aria-busy="@(_listenerBusy ? "true" : "false")">@(_ownsSubscription ? L["TestPanel:Subscribe:Stop"] : L["TestPanel:Subscribe:Start"])</MudButton>
                    <MudButton Color="Color.Default" OnClick="ClearMessages" Disabled="@_retired" aria-disabled="@(_commandBusy || !_listenerReady || _messages.Count == 0 ? "true" : "false")">@L["TestPanel:Subscribe:Clear"]</MudButton>
                </div>
            </div>
            <div class="test-bench-receipt-heading"><span>@L["TestBench:Retained", _messages.Count]</span><span>@L["TestBench:Retention"]</span></div>
            @if (_messages.Count == 0)
            {
                <div class="test-bench-empty"><MoIcon Icon="@MoIcons.Inbox" Size="1.5rem" /><h4>@L["TestPanel:Subscribe:NoMessages"]</h4><p>@L["TestBench:EmptyHelp"]</p></div>
            }
            else
            {
                <ol class="test-bench-receipts">
                    @foreach (var message in _messages.AsEnumerable().Reverse())
                    {
                        <li @key="message">
                            <header><span class="test-bench-received-mark"><MoIcon Icon="@MoIcons.ArrowDownLeft" Size="1.25rem" />@L["TestBench:Received"]</span><time>@UiTime.FormatTime(message.ReceivedAt)</time></header>
                            <p class="test-bench-message">@message.EventData.Message</p>
                            <dl><div><dt>@L["TestPanel:Publish:TopicName"]</dt><dd><code>@message.TopicName</code></dd></div><div><dt>@L["TestBench:MessageId"]</dt><dd><code>@message.EventData.MessageId</code></dd></div><div><dt>@L["TestBench:CreatedUtc"]</dt><dd><time>@UiTime.Format(message.EventData.CreatedAt)</time></dd></div></dl>
                        </li>
                    }
                </ol>
            }
            <footer class="test-bench-listener-help"><MoIcon Icon="@MoIcons.Info" Size="1.25rem" /><p>@L["TestBench:ListenerLifetime"]</p></footer>
        </section>
    </div>
</section>

@code {
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly object _disposeSync = new();
    private CancellationToken _lifetimeToken;
    private CancellationTokenSource? _refreshCancellation;
    private PeriodicTimer? _refreshTimer;
    private Task? _refreshTask;
    private Task? _acquireTask;
    private Task? _commandTask;
    private Task? _disposeTask;
    private List<ReceivedTestMessage> _messages = [];
    private EventBusStandaloneListenerLease? _listenerLease;
    private string _publishTopicName = string.Empty;
    private string _publishMessage = string.Empty;
    private string _subscribeTopicName = string.Empty;
    private bool _commandBusy;
    private bool _publishing;
    private bool _listenerBusy;
    private bool _ownsSubscription;
    private bool _listenerReady;
    private bool _listenerFailed;
    private bool _accepted;
    private bool _retired;
    private string BusyAttribute => _commandBusy ? "true" : "false";
    private string ListenerBusyAttribute => _commandBusy || !_listenerReady ? "true" : "false";
    private string ListenerStateText => _listenerReady ? L[_ownsSubscription ? "TestBench:Listening" : "TestBench:Stopped"].Value
        : L[_listenerFailed ? "TestBench:ListenerUnavailable" : "TestBench:PreparingListener"].Value;

    protected override async Task OnInitializedAsync()
    {
        _lifetimeToken = _lifetimeCancellation.Token;
        _publishTopicName = typeof(TestEventMessage).FullName!;
        _subscribeTopicName = _publishTopicName;
        RefreshMessages();
        await (_acquireTask = AcquireListenerAsync());
    }

    private async Task AcquireListenerAsync()
    {
        try
        {
            _listenerLease = await TestService.AcquireStandaloneListenerLeaseAsync(_lifetimeToken);
            if (_retired) return;
            _listenerReady = true;
            AdoptListenerSnapshot();
            if (_ownsSubscription) StartRefreshLoop();
        }
        catch (OperationCanceledException) when (_lifetimeToken.IsCancellationRequested)
        {
            // Retirement cancels an ownership wait and still drains its actual acquisition task.
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Acquiring the standalone EventBus test listener failed");
            if (!_retired) _listenerFailed = true;
        }
    }

    private void AdoptListenerSnapshot()
    {
        var snapshot = _listenerLease?.Snapshot;
        _ownsSubscription = snapshot is not null;
        if (snapshot is not null) _subscribeTopicName = snapshot.TopicName;
    }

    private Task PublishMessageAsync()
    {
        if (_retired || _commandBusy) return Task.CompletedTask;
        if (string.IsNullOrWhiteSpace(_publishMessage))
        {
            Snackbar.Add(L["TestPanel:Validation:MessageRequired"], Severity.Warning);
            return Task.CompletedTask;
        }
        var message = _publishMessage;
        var topic = _publishTopicName;
        _publishing = true;
        _accepted = false;
        return AdmitCommandAsync(async () =>
        {
            var result = await TestService.PublishTestMessageAsync(message, topic, _lifetimeToken);
            if (_retired) return;
            if (result.IsFailed(out var error))
            {
                Snackbar.Add(L["TestPanel:Snackbars:PublishFailed", error.Message ?? string.Empty], Severity.Error);
                return;
            }
            _accepted = true;
            _publishMessage = string.Empty;
            Snackbar.Add(L["TestBench:Accepted"], Severity.Success);
        });
    }

    private Task ToggleListeningAsync() => _ownsSubscription ? StopListeningAsync() : StartListeningAsync();

    private Task StartListeningAsync()
    {
        if (_retired || _commandBusy || !_listenerReady || _ownsSubscription || _listenerLease is not { } lease) return Task.CompletedTask;
        if (string.IsNullOrWhiteSpace(_subscribeTopicName))
        {
            Snackbar.Add(L["TestPanel:Validation:TopicRequired"], Severity.Warning);
            return Task.CompletedTask;
        }
        var topic = _subscribeTopicName;
        _listenerBusy = true;
        return AdmitCommandAsync(async () =>
        {
            var result = await lease.SubscribeAsync(topic);
            if (_retired) return;
            AdoptListenerSnapshot();
            if (result.IsFailed(out var error, out _))
            {
                if (!_retired) Snackbar.Add(L["TestPanel:Snackbars:SubscribeFailed", error.Message ?? string.Empty], Severity.Error);
                return;
            }
            StartRefreshLoop();
            RefreshMessages();
            Snackbar.Add(L["TestPanel:Snackbars:SubscribeSucceeded"], Severity.Success);
        });
    }

    private Task StopListeningAsync()
    {
        if (_retired || _commandBusy || !_listenerReady || !_ownsSubscription || _listenerLease is not { } lease) return Task.CompletedTask;
        _listenerBusy = true;
        return AdmitCommandAsync(async () =>
        {
            var result = await lease.UnsubscribeAsync();
            if (_retired) return;
            AdoptListenerSnapshot();
            if (result.IsFailed(out var error))
            {
                if (!_retired) Snackbar.Add(L["TestPanel:Snackbars:UnsubscribeFailed", error.Message ?? string.Empty], Severity.Warning);
                return;
            }
            await StopRefreshLoopAsync();
            if (_retired) return;
            RefreshMessages();
            Snackbar.Add(L["TestPanel:Snackbars:UnsubscribeSucceeded"], Severity.Info);
        });
    }

    private Task AdmitCommandAsync(Func<Task> command)
    {
        if (_retired || _commandBusy) return Task.CompletedTask;
        _commandBusy = true;
        return _commandTask = ExecuteCommandAsync(command);
    }

    private async Task ExecuteCommandAsync(Func<Task> command)
    {
        try { await command(); }
        finally
        {
            _commandBusy = false;
            _publishing = false;
            _listenerBusy = false;
            if (!_retired) StateHasChanged();
        }
    }

    private void StartRefreshLoop()
    {
        if (_retired || _refreshTask is not null) return;
        _refreshCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeToken);
        _refreshTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        _refreshTask = RefreshLoopAsync(_refreshTimer, _refreshCancellation.Token);
    }

    private async Task RefreshLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(() =>
                {
                    if (_retired || token.IsCancellationRequested) return;
                    RefreshMessages();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // The component owns this loop and cancels it on stop or retirement.
        }
    }

    private async Task StopRefreshLoopAsync()
    {
        var cancellation = _refreshCancellation;
        var timer = _refreshTimer;
        var task = _refreshTask;
        _refreshCancellation = null;
        _refreshTimer = null;
        _refreshTask = null;
        var failures = new List<Exception>();
        try
        {
            try { cancellation?.Cancel(); }
            catch (Exception error) { failures.Add(error); }
            try { timer?.Dispose(); }
            catch (Exception error) { failures.Add(error); }
            if (task is not null)
            {
                try { await task; }
                catch (Exception error) { failures.Add(error); }
            }
        }
        finally { cancellation?.Dispose(); }
        if (failures.Count > 0) throw new AggregateException(failures);
    }

    private void RefreshMessages() => _messages = TestService.GetReceivedMessages();

    private void ClearMessages()
    {
        if (_retired || _commandBusy || !_listenerReady || _messages.Count == 0) return;
        TestService.ClearReceivedMessages();
        RefreshMessages();
        Snackbar.Add(L["TestPanel:Snackbars:ClearSucceeded"], Severity.Info);
    }

    public ValueTask DisposeAsync()
    {
        lock (_disposeSync) return new(_disposeTask ??= RetireAsync());
    }

    private async Task RetireAsync()
    {
        _retired = true;
        var failures = new List<Exception>();
        try
        {
            try { _lifetimeCancellation.Cancel(); }
            catch (Exception error) { failures.Add(error); }
            if (_acquireTask is not null)
            {
                try { await _acquireTask; }
                catch (Exception error) { failures.Add(error); }
            }
            // Drain the actual command even when a provider ignores cancellation.
            if (_commandTask is not null)
            {
                try { await _commandTask; }
                catch (OperationCanceledException) when (_lifetimeToken.IsCancellationRequested) { }
                catch (Exception error) { failures.Add(error); }
            }
            try { await StopRefreshLoopAsync(); }
            catch (Exception error) { failures.Add(error); }
            if (_listenerLease?.Snapshot is not null)
            {
                try
                {
                    var result = await _listenerLease.UnsubscribeAsync();
                    if (result.IsFailed(out var error))
                        Logger.LogWarning("Retiring the standalone EventBus test listener failed; its exact subscription remains available for a later owner to retry: {Error}", error.Message);
                    else _ownsSubscription = false;
                }
                catch (Exception error) { failures.Add(error); }
            }
        }
        finally
        {
            try
            {
                if (_listenerLease is { } lease) await lease.DisposeAsync();
            }
            catch (Exception error) { failures.Add(error); }
            finally { _lifetimeCancellation.Dispose(); }
        }
        if (failures.Count > 0) throw new AggregateException(failures);
    }
}
