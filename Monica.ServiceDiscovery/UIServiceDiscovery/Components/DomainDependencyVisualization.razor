    public ValueTask DisposeAsync()
    {
        lock (_disposeSync)
        {
            return new ValueTask(_disposeTask ??= DisposeCoreAsync());
        }
    }

    private async Task DisposeCoreAsync()
    {
        _disposed = true;
        await _lifetimeCancellation.CancelAsync();

        // Providers can finish work that does not accept cancellation. Wait for the actual read and its
        // continuation to settle before releasing resources owned by this retired component.
        await _captureGate.WaitAsync();
        _captureGate.Release();

        await _interopGate.WaitAsync();
        try
        {
            var graphController = Interlocked.Exchange(ref _graphController, null);
            var dotNetReference = Interlocked.Exchange(ref _dotNetReference, null);

            await DisposeGraphControllerAsync(graphController);
            dotNetReference?.Dispose();
        }
        finally
        {
            _interopGate.Release();
        }

        // A caller may have observed the pre-disposal state immediately before teardown began and still be
        // approaching the gate. Keep these lightweight primitives alive so cancellation settles that admission
        // race without turning an expected lifetime transition into ObjectDisposedException.
    }

    private async Task InvokeGraphAsync(string identifier, params object?[] arguments)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await _interopGate.WaitAsync(_lifetimeCancellation.Token);
            try
            {
                if (!_disposed && _graphController is not null)
                {
                    await _graphController.InvokeVoidAsync(identifier, _lifetimeCancellation.Token, arguments);
                }
            }
            finally
            {
                _interopGate.Release();
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
        catch (JSException)
        {
            if (!_disposed)
            {
                _graphAvailable = false;
                _graphError = L["Atlas:Shared:GraphUnavailable"].Value;
                StateHasChanged();
            }
        }
    }

    private async Task<bool> CopyToClipboardAsync(string value)
    {
        if (_disposed)
        {
            return false;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                _lifetimeCancellation.Token,
                value);
            return !_disposed;
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
        catch (JSException)
        {
            if (!_disposed) Snackbar.Add(L["Atlas:Shared:ClipboardFailed"].Value, Severity.Error);
        }
        return false;
    }

    private static async ValueTask DisposeGraphControllerAsync(IJSObjectReference? graphController)
    {
        if (graphController is null)
        {
            return;
        }

        try
        {
            await graphController.InvokeVoidAsync("dispose");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        try
        {
            await graphController.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private static async ValueTask ReleaseModuleReferenceAsync(IJSObjectReference? module)
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

