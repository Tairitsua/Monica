@inherits SignalRWorkspaceView
@inject NavigationManager Navigation

<section class="mo-vl-surface sr-trace" aria-label="@T("Workspace:TrTitle")">
    <header class="mo-vl-surface-heading"><span class="mo-vl-tile mo-vl-role--info"><MoIcon Icon="@MoIcons.Terminal" Size="16px" /></span><div class="sr-surface-title"><h2>@T("Workspace:TrTitle")</h2><p>@T("Workspace:TrScope")</p></div><span class="sr-count">@S.Messages.Count</span><div class="sr-aside"><button class="sr-btn sr-btn-outline sr-btn-sm" disabled="@(S.Messages.Count == 0)" title="@T("Workspace:TrClearNote")" @onclick="Clear"><MoIcon Icon="@MoIcons.ClearList" Size="14px" />@T("Workspace:TrClear")</button></div></header>
    <div class="sr-trace-controls"><div class="sr-search"><MoIcon Icon="@MoIcons.Search" Size="14px" /><input type="search" aria-label="@T("Workspace:TrSearchPlaceholder")" placeholder="@T("Workspace:TrSearchPlaceholder")" value="@Query" @oninput='args => Filter("traceQ", args.Value?.ToString())' /></div><div class="mo-vl-chips" role="group" aria-label="@T("Workspace:TrTitle")"><MoFilterChip Pill="true" Label="@T("Workspace:TrAllTypes")" Count="TextMatched.Count" Role="MoVisualRole.Primary" Selected="@(Type.Length == 0)" SelectedChanged='() => Filter("traceType", null)' />
        @foreach (var type in TraceTypes)
        {
            <MoFilterChip Pill="true" Class="mo-vl-chip--instrument" Label="@T($"Workspace:TrTypes:{type}")" Count="@(TextMatched.Count(message => EffectiveType(message) == type))" Role="@SignalRDiagnosticRules.TraceRole(type)" ShowDot="true" Selected="@(Type == type)" SelectedChanged='() => Filter("traceType", Type == type ? null : type)' />
        }
    </div></div>
    @if (S.Messages.Count == 0)
    {
        <MoContentState Compact="true" Class="sr-trace-empty"><span class="mo-vl-tile mo-vl-role--neutral"><MoIcon Icon="@MoIcons.Messages" Size="18px" /></span><p>@T("Workspace:TrEmpty")</p>@if (!S.ConnectionState.IsConnected && S.AvailableHubs.Count > 0 && S.CanGenerateTestToken) { <button class="sr-btn sr-btn-sm mo-vl-soft-action mo-vl-role--primary" @onclick="TestConnect"><MoIcon Icon="@MoIcons.Flask" Size="14px" />@T("Workspace:WbTestUserConnect")</button> }</MoContentState>
    }
    else if (Filtered.Count == 0)
    {
        <MoContentState Compact="true" Class="sr-trace-empty"><p>@T("Workspace:TrNoMatch")</p><button class="sr-btn sr-btn-outline sr-btn-sm" @onclick="Reset">@T("Workspace:ResetFilters")</button></MoContentState>
    }
    else
    {
        <ol class="sr-trace-list">
            @foreach (var message in Filtered.Skip((Page - 1) * 20).Take(20))
            {
                var type = EffectiveType(message);
                <li class="sr-trace-item @(type == "Error" ? "is-err" : null)" @key="message.Id"><button type="button" class="sr-trace-btn" @onclick='() => Context.Set("event", message.Id, true)'><div class="sr-trace-meta"><SignalRBadge Text="@T($"Workspace:TrTypes:{type}")" Role="@SignalRDiagnosticRules.TraceRole(type)" Icon="@Icon(type)" /><time class="mono" datetime="@message.Timestamp.ToString("O")" title="@UiTime.Format(message.Timestamp)">@UiTime.FormatTime(message.Timestamp)</time><span class="sr-trace-src">@Source(message.Source)</span><MoIcon Icon="@MoIcons.ChevronRight" Size="14px" Class="sr-trace-chev" /></div><p class="sr-trace-text mono">@message.Content</p></button></li>
            }
        </ol>
        <MoCompactPager Page="@Page" PageSize="20" Total="@Filtered.Count" ShowSinglePage="true" ShowSinglePageControls="false"
                        PageChanged='page => Context.Set("tracePage", page.ToString(CultureInfo.InvariantCulture))' />
    }
</section>

@code {
    private static readonly string[] TraceTypes = ["Sent", "Received", "Success", "Error", "System", "Info"];
    private string Query => Context.Get("traceQ");
    private string Type => Context.Get("traceType");
    private int Page => Math.Clamp(int.TryParse(Context.Get("tracePage"), out var page) ? page : 1, 1, Math.Max(1, (Filtered.Count + 19) / 20));
    private List<SignalRMessage> TextMatched => S.Messages.Where(message => string.IsNullOrWhiteSpace(Query) || $"{message.Source} {message.Content} {message.Details}".Contains(Query.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    private List<SignalRMessage> Filtered => TextMatched.Where(message => Type.Length == 0 || EffectiveType(message) == Type).ToList();
    private static string EffectiveType(SignalRMessage message) => message.IsError ? "Error" : message.Type.ToString();
    private string Source(string value) => Enum.TryParse<MessageType>(value, out _) ? T($"Workspace:TrTypes:{value}") : value;
    private static string Icon(string type) => type switch { "Sent" => MoIcons.Send, "Received" => MoIcons.Inbox, "Success" => MoIcons.Success, "Error" => MoIcons.Error, "System" => MoIcons.Radio, _ => MoIcons.Info };
    private void Filter(string key, string? value) => Context.Set(new Dictionary<string, object?> { [key] = string.IsNullOrEmpty(value) ? null : value, ["tracePage"] = null });
    private void Reset() => Context.Set(new Dictionary<string, object?> { ["traceType"] = null, ["traceQ"] = null, ["tracePage"] = null });
    private void Clear() { S.ClearMessages(); Context.Set("tracePage", null); }
    private Task TestConnect() => Context.Run(async () => { await S.TestUserConnectAsync(Navigation.BaseUri); });
}
