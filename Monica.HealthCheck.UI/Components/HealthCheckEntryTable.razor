@inject IStringLocalizer<HealthCheckResource> L
@inject NavigationManager Nav
<section class="hc-registry">
    <header><div><h2>@L["Design:RegistryTitle"]</h2><p>@L["Design:RegistryDesc"]</p></div><small>@L["Filters:Results", Session.FilteredEntries.Count, Session.Snapshot?.Entries.Count ?? 0]</small></header>
    <HealthCheckFilters Session="@Session" />
    @if (Session.FilteredEntries.Count == 0)
    {
        <MoContentState><h3>@L["Design:NoMatchTitle"]</h3><p>@L["Design:NoMatchDesc"]</p><MudButton Href="@Nav.ToAbsoluteUri("health-checks").ToString()">@L["Actions:ClearFilters"]</MudButton></MoContentState>
    }
    else
    {
        <div class="hc-table-wrap"><table class="hc-table"><thead><tr><th>@L["Design:Cols:Name"]</th><th>@L["Design:Cols:Probe"]</th><th>@L["Design:Cols:Status"]</th><th>@L["Design:Cols:Duration"]</th><th></th></tr></thead><tbody>
        @foreach (var item in Session.FilteredEntries)
        {
            var url = Nav.GetUriWithQueryParameter("entry",item.Name);
            var share = Session.Snapshot!.Duration > TimeSpan.Zero ? item.Duration / Session.Snapshot.Duration : (double?)null;
            <tr><td><a class="hc-name" href="@url">@item.Name</a><p>@item.Description</p><div class="hc-tags">@foreach (var tag in item.Tags) { <a class="mo-vl-id-chip" href="@Nav.GetUriWithQueryParameter("tag",tag)">@tag</a> }
                @if (item.Data.Count > 0) { <small>@L["Design:DataCountBadge",item.Data.Count]</small> }
                @if (item.Data.Values.Count(v => v == "[redacted]") is > 0 and var n) { <small>@L["Design:RedactedBadge",n]</small> }</div></td>
                <td>@foreach (var (id, label) in Probes.Where(p => HealthCheckPageSession.MatchesProbe(item,p.Id))) { <span class="hc-probe">@L[label]</span> }</td>
                <td><span class="hc-status" style="@HealthCheckDisplay.IconStyle(item.Status)">@L.GetStatusText(item.Status)</span></td>
                <td><b>@L["Common:DurationMilliseconds",item.Duration.TotalMilliseconds]</b><div class="hc-meter"><i style="@FormattableString.Invariant($"width:{Math.Clamp(share ?? 0,0,1)*100:0.###}%")"></i></div><small>@L["Design:WallShareSub",share?.ToString("P1") ?? "—"]</small></td>
                <td><a href="@url" aria-label="@L["Actions:DetailsFor",item.Name]"><MoIcon Icon="@MoIcons.ChevronRight" Size="1rem" /></a></td></tr>
        }</tbody></table></div>
    }
    <footer>@L[Session.Paused ? "Design:FooterAutoPaused" : "Design:FooterAutoActive"]</footer>
</section>
@code {
    [Parameter, EditorRequired] public HealthCheckPageSession Session { get; set; } = default!;
    internal static readonly (string Id,string Label)[] Probes = [("ready","Design:ReadinessLabel"),("live","Design:LivenessLabel"),("other","Design:AuxiliaryLabel")];
}
