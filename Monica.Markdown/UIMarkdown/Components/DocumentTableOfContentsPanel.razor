@using Microsoft.Extensions.Localization
@using System.Net
@using Monica.Markdown.Localization
@using Monica.Markdown.Models
@using Monica.UI.Shared.Components.Markdown
@inject IStringLocalizer<MarkdownResource> L

<div class="toc-panel">
    <div class="toc-header">
        <div class="toc-header-copy">
            <h2 class="toc-title">@L["MarkdownViewer:Navbar:Outline"]</h2>
            <p class="toc-description">@L["MarkdownViewer:Toolbar:OutlineDescription"]</p>
        </div>
        @if (OnClose.HasDelegate)
        {
            <MudIconButton Icon="@MoIcons.Close"
                           Size="Size.Small"
                           OnClick="OnClose"
                           title="@L["MarkdownViewer:Toolbar:HideOutline"]"
                           aria-label="@L["MarkdownViewer:Toolbar:HideOutline"]"
                           Class="toc-close-button" />
        }
    </div>

    @if (Document is null)
    {
        <div class="toc-empty-state">
            <MoIcon Icon="@MoIcons.FileText"
                     Size="2.25rem"
                     Class="toc-empty-icon" />
            <MudText Typo="Typo.body2" Align="Align.Center" Class="toc-empty-copy">
                @L["MarkdownViewer:Toolbar:NoDocumentOutline"]
            </MudText>
        </div>
    }
    else if (_outlineHeadings.Count == 0)
    {
        <div class="toc-empty-state">
            <MoIcon Icon="@MoIcons.List"
                     Size="2.25rem"
                     Class="toc-empty-icon" />
            <MudText Typo="Typo.body2" Align="Align.Center" Class="toc-empty-copy">
                @L["MarkdownViewer:Toolbar:NoOutlineAvailable"]
            </MudText>
        </div>
    }
    else
    {
        <div class="toc-list" role="navigation" aria-label="@L["MarkdownViewer:Navbar:Outline"]">
            @foreach (var heading in _outlineHeadings)
            {
                <button type="button"
                        class="@GetHeadingClass(heading)"
                        title="@heading.Title"
                        data-anchor-id="@heading.Id"
                        @onclick="@(() => SelectHeadingAsync(heading.Id))"
                        aria-current="@(IsCurrentHeading(heading) ? "location" : null)">
                    <span class="toc-link-text">@heading.Title</span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public MarkdownDocument? Document { get; set; }

    [Parameter]
    public IReadOnlyList<MoMarkdownHeading> Headings { get; set; } = [];

    [Parameter]
    public string? CurrentAnchorId { get; set; }

    [Parameter]
    public EventCallback<string> OnHeadingSelected { get; set; }

    /// <summary>
    /// Requests that the page close its outline pane and restore focus where appropriate.
    /// The close control is omitted when no callback is supplied; this component does not own pane visibility.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private IReadOnlyList<MoMarkdownHeading> _outlineHeadings = [];

    protected override void OnParametersSet()
    {
        _outlineHeadings = Headings
            .Where(static heading => heading.Level <= 3)
            .ToArray();
    }

    private string GetHeadingClass(MoMarkdownHeading heading)
    {
        var classes = new List<string>
        {
            "toc-link",
            $"level-{Math.Clamp(heading.Level, 1, 3)}"
        };

        if (IsCurrentHeading(heading))
        {
            classes.Add("is-active");
        }

        return string.Join(" ", classes);
    }

    private bool IsCurrentHeading(MoMarkdownHeading heading)
    {
        var normalizedCurrentAnchorId = NormalizeAnchorId(CurrentAnchorId);
        if (normalizedCurrentAnchorId is null)
        {
            return false;
        }

        foreach (var candidate in GetAnchorCandidates(normalizedCurrentAnchorId))
        {
            if (string.Equals(heading.Id, candidate, StringComparison.Ordinal))
            {
                return true;
            }
        }

        return false;
    }

    private static IEnumerable<string> GetAnchorCandidates(string anchorId)
    {
        yield return anchorId;

        string? decodedAnchorId = null;
        try
        {
            decodedAnchorId = Uri.UnescapeDataString(anchorId);
        }
        catch (UriFormatException)
        {
        }

        if (!string.IsNullOrWhiteSpace(decodedAnchorId)
            && !string.Equals(decodedAnchorId, anchorId, StringComparison.Ordinal))
        {
            yield return decodedAnchorId;

            var encodedDecodedAnchorId = WebUtility.UrlEncode(decodedAnchorId);
            if (!string.Equals(encodedDecodedAnchorId, anchorId, StringComparison.Ordinal))
            {
                yield return encodedDecodedAnchorId;
            }
        }
    }

    private static string? NormalizeAnchorId(string? anchorId)
    {
        if (string.IsNullOrWhiteSpace(anchorId))
        {
            return null;
        }

        var normalizedAnchorId = anchorId.Trim();
        if (normalizedAnchorId.StartsWith('#'))
        {
            normalizedAnchorId = normalizedAnchorId[1..];
        }

        return string.IsNullOrWhiteSpace(normalizedAnchorId) ? null : normalizedAnchorId;
    }

    private Task SelectHeadingAsync(string headingId)
    {
        return OnHeadingSelected.InvokeAsync(headingId);
    }
}
