@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@attribute [Route(PAGE_URL)]
@using Monica.Framework.UI.UILogging.Models
@using Monica.Framework.UI.UILogging.State
@using Monica.Framework.UI.UILogging.Support
@using Monica.UI.Shared.Components.Visual
@inject LogFileQueryService FileQuery
@inject LoggingService LoggingService
@inject LoggingWorkspaceSession Workspace
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<LoggingResource> L
@implements IAsyncDisposable

<PageTitle>@L["Workbench:ReaderTitle"]</PageTitle>

<div class="mo-workbench-container">
<div class="logging-workbench mo-page-shell mo-page-shell--workbench">
    <LoggingWorkspaceHeader Identity="@(Source?.FilePath ?? LoggingService.CurrentLogFilePath)" IdentityLabel="@(Source?.RelativePath ?? Path.GetFileName(LoggingService.CurrentLogFilePath))"
                            Failed="@(_error is not null || _snapshot?.Error is not null)" FilesUrl="@FilesUrl" ReaderUrl="@ReaderUrl" Following="@IsRunning" ReadAt="@_snapshot?.GeneratedAt" Count="@_fileCount">
        <Commands>
            <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" Disabled="@(_busy || _initializing)" OnClick="ReadLatestAsync">@L["Workbench:ReadLatest"]</MudButton>
            <MudMenu Label="@L["Design:ExportShort"]" StartIcon="@MoIcons.Download" EndIcon="@MoIcons.ChevronDown" Variant="Variant.Outlined" Disabled="@(_busy || _snapshot is null)">
                <MudMenuItem Icon="@MoIcons.Archive" OnClick="ExportRetainedAsync">@L["LogChart:ExportCount", L["Design:ExportRetained"], _snapshot?.RetainedLines.Count ?? 0]</MudMenuItem>
                <MudMenuItem Icon="@MoIcons.Filter" OnClick="ExportVisibleAsync">@L["LogChart:ExportCount", L["Design:ExportVisible"], ViewLines.Count]</MudMenuItem>
            </MudMenu>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@(IsRunning ? MoIcons.Pause : MoIcons.Play)" Disabled="@(_busy || _initializing)" OnClick="ToggleFollowingAsync">@L[IsRunning ? "Workbench:Pause" : "Workbench:Follow"]</MudButton>
        </Commands>
    </LoggingWorkspaceHeader>
    @if (!_initializing && (_error is not null || _snapshot?.Error is not null))
    {
        <div class="logging-notice is-error" role="alert"><MoIcon Icon="@MoIcons.Error" Size="1.5rem" /><div><strong>@L["Workbench:ReadFailed"]</strong><p>@(_error ?? _snapshot?.Error)</p><span>@L["Workbench:StaleEvidence"]</span></div></div>
    }
    else if (!_initializing && _snapshot is { FileExists: false })
    {
        <div class="logging-notice" role="status"><MoIcon Icon="@MoIcons.FileSearch" Size="1.5rem" /><div><strong>@L["Workbench:FileMissing"]</strong><p>@L["Workbench:MissingHelp"]</p></div><a href="@FilesUrl">@L["Workbench:ChooseFile"]</a></div>
    }

    @if (!_initializing && _snapshot is { } snapshot)
    {
        <LogSeverityStrip Snapshot="@snapshot" Visible="@PageLines" FilesUrl="@FilesUrl" Frozen="@(_context is not null)" Range="@_range"
            OnSeverity="FilterSeverity" OnSpan="SetSpan" OnInspect="InspectRetained" Jump="JumpAsync" Earlier="@(() => LoadEarlierAsync(50))" />
    }
    <section class="logging-reader mo-vl-surface" aria-label="@L["Workbench:Reader"]">
        <div class="logging-search-rail">
            <form class="reader-search mo-vl-search-clearable" @onsubmit="SubmitKeyword" @onsubmit:preventDefault>
                <MoIcon Icon="@MoIcons.Search" Size="15px" />
                <input type="search" spellcheck="false" autocomplete="off" aria-label="@L["Design:KeywordLabel"]"
                       placeholder="@L["Design:KeywordPlaceholder"]" @bind="_keyword" @bind:event="oninput" disabled="@(!CanChangeFilters)" />
                @if (!string.IsNullOrEmpty(_keyword) || _snapshot?.Filter.HasKeyword == true)
                {
                    <button type="button" class="reader-clear mo-vl-search-clear" @onclick="ClearKeyword" aria-label="@L["Design:ClearFilter"]" disabled="@(!CanChangeFilters)">
                        <MoIcon Icon="@MoIcons.Close" Size="14px" />
                    </button>
                }
                <button type="submit" class="reader-apply mo-vl-soft-action mo-vl-role--primary" disabled="@(!CanChangeFilters)">@L["Design:Apply"]</button>
            </form>
            <MudCheckBox T="bool" Color="Color.Primary" Value="@_onlyMatches" ValueChanged="ChangeMatchMode" Label="@L["Design:OnlyMatches"]" Dense="true" />
            <div class="reader-window">
                <span>@L["Design:ReadWindow"]</span>
                <MudSelect T="int" Value="@_lineLimit" ValueChanged="ChangeLineLimitAsync" aria-label="@L["Design:ReadWindow"]" Margin="Margin.Dense" Variant="Variant.Outlined" Disabled="@_busy">
                    @foreach (var count in LineCounts) { <MudSelectItem Value="@count">@count.ToString("N0")</MudSelectItem> }
                </MudSelect>
            </div>
            <MudCheckBox T="bool" Color="Color.Primary" @bind-Value="_autoScroll" Label="@L["Design:KeepNewest"]" Dense="true" />
        </div>
        <div class="reader-levels">
            @{ var levels = FacetLines.CountBy(l => l.Severity).ToDictionary(); }
            <MoFilterChip Label="@L["Design:StripAllLevels"]" Count="@levels.Values.Sum()" Role="MoVisualRole.Primary" Selected="@(!_severity.HasValue)" SelectedChanged="@(() => { _severity = null; ApplyFilter(); })" Pill="true" Class="mo-vl-chip--instrument" />
            @foreach (var level in LogSeverityStrip.Levels) { <MoFilterChip Label="@L[$"Workbench:Levels:{level}"]" Count="@levels.GetValueOrDefault(level)" ShowDot="true" Selected="@(_severity == level)" Role="@LogSeverityStrip.Role(level)" SelectedChanged="@(() => FilterSeverity(level))" Pill="true"
                              Class="@(level == LogSeverity.Critical ? "mo-vl-chip--instrument mo-vl-chip--diamond" : "mo-vl-chip--instrument")" /> }
            @if (_range is { } range) { <MudButton Size="Size.Small" StartIcon="@MoIcons.Close" OnClick="@(() => SetSpan(null))" title="@L["Design:ClearSpan"]">@L["Design:SpanLensLabel",range.From,range.To]</MudButton> }
        </div>
        @if (_context is { } context)
        {
            <div class="logging-context-banner" role="status"><span class="mo-vl-tile mo-vl-role--info"><MoIcon Icon="@MoIcons.Lock" Size="16px" /></span><div><strong>@L["Workbench:FrozenContext", context.TargetLineNumber]</strong><span>@L["Workbench:ContextScope", context.StartLineNumber, context.EndLineNumber]</span><code>@context.Source?.RelativePath</code></div><MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.ArrowLeft" OnClick="ExitContext">@L["Workbench:BackToReader"]</MudButton></div>
        }
        @if (_initializing)
        {
            <div class="logging-loading" role="status"><MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" /><span>@L["Workbench:Loading"]</span></div>
        }
        else
        {
            <LogViewer @ref="_viewer" Workbench="true" Lines="@ViewLines" Version="@ViewVersion"
                       Source="@ViewSource" SnapshotReadAt="@ViewReadAt"
                       FirstRetainedLineNumber="@(_context is null ? _snapshot?.FirstRetainedLineNumber : null)"
                       AutoScroll="@(_autoScroll && _context is null)" Filter="@(_context is null ? _snapshot?.Filter : null)"
                       OnInspect="Inspect"
                       OnShowContext="@(LiveReaderAction<(LogLineViewModel line, int lineIndex)>(ShowContext))"
                       OnApplyFilter="@(LiveReaderAction<(LogLineViewModel line, string keyword)>(ApplySelectedText))"
                       OnFilterSeverity="@(LiveReaderAction<LogSeverity>(ApplyRowSeverity))"
                       LoadMoreRequested="@(_context is null ? LoadEarlierAsync : null)" PositionChanged="PositionChanged" />
        }
        <footer class="reader-footnote"><span>@L["Workbench:RetentionScope", _snapshot?.TotalStoredLines ?? 0, Math.Max(1, LoggingService.UIOption.MaxDisplayLines)]</span><span>@L["Workbench:PhysicalLineHelp"]</span></footer>
    </section>
</div>
</div>

@if (!_initializing && Line is not null)
{
    <LogLineEvidenceSheet @key="(File, Generation)" Number="@Line" Generation="@Generation" Lines="@(_context?.Lines ?? _snapshot?.RetainedLines ?? [])" Source="@ViewSource" ReadAt="@ViewReadAt" Initial="@_initialEvidence" Navigate="NavigateLine" ShowContext="ShowContextFromEvidence" FilterSeverity="FilterFromEvidence" />
}
