@using System.Globalization
@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation
<section class="an-trend" aria-labelledby="an-trend-title">
    <header class="an-sectionhead"><div><h2 id="an-trend-title">@L["Analytics:Trend:Title"]</h2><p>@L["Analytics:Trend:Description"]</p></div><span>@L[Snapshot.BucketSize == JobExecutionAnalyticsBucketSize.Hour ? "Analytics:Trend:HourBuckets" : "Analytics:Trend:DayBuckets"]</span></header>
    <div class="an-lanes" @key="_marks">@foreach(var state in States)
    {
        var lane = Array.IndexOf(States, state);
        var peak=Snapshot.Trend.Select(bucket=>Count(bucket,state)).DefaultIfEmpty(0).Max();
        <div class="an-lane" data-state="@state"><div class="an-lane-name"><span><i></i>@L[$"ExecutionStates:{state}"]</span><small>@L["Workspace:PeakValue",peak]</small></div><div class="an-bars" style="@($"--buckets:{Math.Max(1,Snapshot.Trend.Count)}")">@for(var index=0;index<Snapshot.Trend.Count;index++)
        {
            var column=index;var bucket=Snapshot.Trend[column];var value=Count(bucket,state);
            <a @ref="_marks[lane * Snapshot.Trend.Count + column]" @onkeydown="@(e => MoveAsync(e, lane, column))" class="an-bar @(column==Selected ? "is-selected" : null) @(value==0 ? "is-zero" : null)" href="@Ledger(bucket,state)" title="@Label(bucket,state)" aria-label="@Label(bucket,state)" @onfocus="@(()=>_selected=column)" @onmouseenter="@(()=>_hover=column)" @onmouseleave="@(()=>_hover=null)"><i style="@($"height:{(peak==0 ? 0 : Math.Max(value>0 ? 5 : 0,value*100d/peak)).ToString("0.###",CultureInfo.InvariantCulture)}%")"></i></a>
        }</div></div>
    }<div class="an-axis"><span>@ShortTime(Snapshot.StartTimeUtc)</span><span>@ShortTime(Snapshot.StartTimeUtc+(Snapshot.EndTimeUtc-Snapshot.StartTimeUtc)/2)</span><span>@ShortTime(Snapshot.EndTimeUtc)</span></div></div>
    @if(Current is {} current) { <div class="an-readout" aria-live="polite"><time>@TimePresentation.FormatRange(current.StartTimeUtc,current.EndTimeUtc)</time><span>@L["Workspace:BucketOutcomes",current.SucceededCount,current.FailedCount,current.SkippedCount]</span><a href="@Ledger(current,null)">@L["Workspace:OpenRecords"] <MoIcon Icon="@MoIcons.ArrowRight" Size=".875rem" /></a></div> }
    <p class="an-chart-foot">@L["Workspace:TrendHint"]</p>
    <details class="an-data"><summary>@L["Analytics:Trend:ViewData"]</summary><div class="an-bucket-table"><table><thead><tr><th>@L["Analytics:Trend:Interval"]</th>@foreach(var state in States.Append(JobExecutionState.Cancelled)) { <th>@L[$"ExecutionStates:{state}"]</th> }</tr></thead><tbody>@foreach(var bucket in Snapshot.Trend) { <tr><td>@TimePresentation.FormatRange(bucket.StartTimeUtc,bucket.EndTimeUtc)</td>@foreach(var state in States.Append(JobExecutionState.Cancelled)) { <td>@Count(bucket,state)</td> }</tr> }</tbody></table></div></details>
</section>
@code {
    /// <summary>Gets fixed completion buckets from one accepted analytics query.</summary>
    [Parameter,EditorRequired] public JobExecutionAnalyticsSnapshot Snapshot { get; set; } = null!;
    /// <summary>Gets the exact owner carried into every interval drilldown.</summary>
    [Parameter] public string? Owner { get; set; }
    /// <summary>Gets the exact job carried into every interval drilldown.</summary>
    [Parameter] public string? Job { get; set; }
    private static readonly JobExecutionState[] States=[JobExecutionState.Succeeded,JobExecutionState.Failed,JobExecutionState.Skipped];
    private int? _selected,_hover;
    private ElementReference[] _marks = [];
    protected override void OnParametersSet()
    {
        if (_marks.Length != States.Length * Snapshot.Trend.Count)
            _marks = new ElementReference[States.Length * Snapshot.Trend.Count];
    }
    private async Task MoveAsync(KeyboardEventArgs args, int lane, int column)
    {
        var count = Snapshot.Trend.Count;
        var target = args.Key switch
        {
            "ArrowLeft" => lane * count + Math.Max(0, column - 1),
            "ArrowRight" => lane * count + Math.Min(count - 1, column + 1),
            "ArrowUp" => Math.Max(0, lane - 1) * count + column,
            "ArrowDown" => Math.Min(States.Length - 1, lane + 1) * count + column,
            "Home" => lane * count,
            "End" => (lane + 1) * count - 1,
            _ => -1
        };
        if (target >= 0) { _hover = null; _selected = target % count; await _marks[target].FocusAsync(preventScroll: true); }
    }
    private int Selected=>Math.Clamp(_hover??_selected??Snapshot.Trend.Count-1,0,Math.Max(0,Snapshot.Trend.Count-1));
    private JobExecutionAnalyticsBucket? Current=>Snapshot.Trend.ElementAtOrDefault(Selected);
    private static long Count(JobExecutionAnalyticsBucket b,JobExecutionState state)=>state switch { JobExecutionState.Succeeded=>b.SucceededCount,JobExecutionState.Failed=>b.FailedCount,JobExecutionState.Skipped=>b.SkippedCount,_=>b.CancelledCount };
    private string Label(JobExecutionAnalyticsBucket b,JobExecutionState state)=>$"{L[$"ExecutionStates:{state}"]}: {Count(b,state)} · {TimePresentation.FormatRange(b.StartTimeUtc,b.EndTimeUtc)}";
    private string ShortTime(DateTimeOffset at)=>TimePresentation.FormatChartTimestamp(at);
    private string Ledger(JobExecutionAnalyticsBucket b,JobExecutionState? state)=>SchedulerRouteBuilder.Ledger(new JobExecutionQuery { SchedulerScopeKey=string.Empty,OwnerKey=Owner,JobKey=Job,States=state is {} value ? new[]{value}:null,CompletedAfterUtc=b.StartTimeUtc,CompletedBeforeUtc=b.EndTimeUtc.AddTicks(-1) },b.StartTimeUtc,b.EndTimeUtc);
}
