@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.EventBus.Models
@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.Support
@using Monica.Framework.UI.Pages
@inject IStringLocalizer<EventBusResource> L

@if (Snapshot is { } capture)
{
    var stats = capture.Statistics;
    <div class="eventbus-overview">
        <div class="eventbus-overview-lead">
            <section class="eventbus-registration">
                <div class="eventbus-registration-top"><span class="eventbus-eyebrow">@L["Overview:RegistrationKicker"]</span><MoIcon Icon="@MoIcons.Network" Size="1.5rem" /></div>
                <div class="eventbus-registration-headline"><strong>@stats.TotalSubscriptions</strong><div><h2>@L["Overview:RegisteredHandlers"]</h2><p>@L["Overview:RegistrationHelp"]</p></div></div>
                <div class="eventbus-registration-distribution" aria-hidden="true">
                    @foreach (var state in Enum.GetValues<EventSubscriptionState>())
                    {
                        var count = capture.Subscriptions.Count(row => row.State == state);
                        if (count > 0) { <span data-state="@state" style="@($"flex-grow:{count}")"></span> }
                    }
                </div>
                <div class="eventbus-registration-states">
                    <div data-state="Active"><span>@L.GetSubscriptionStateText(EventSubscriptionState.Active)</span><strong>@stats.ActiveSubscriptions</strong></div>
                    <div data-state="Inactive"><span>@L.GetSubscriptionStateText(EventSubscriptionState.Inactive)</span><strong>@stats.InactiveSubscriptions</strong></div>
                    <div data-state="Pending"><span>@L.GetSubscriptionStateText(EventSubscriptionState.Pending)</span><strong>@stats.PendingSubscriptions</strong></div>
                    <div data-state="Disposed"><span>@L.GetSubscriptionStateText(EventSubscriptionState.Disposed)</span><strong>@stats.DisposedSubscriptions</strong></div>
                    <div data-state="Held"><span>@L.GetSubscriptionStateText(EventSubscriptionState.Held)</span><strong>@stats.HeldSubscriptions</strong></div>
                    <div data-state="Disabled"><span>@L.GetSubscriptionStateText(EventSubscriptionState.Disabled)</span><strong>@stats.DisabledSubscriptions</strong></div>
                </div>
                <div class="eventbus-registration-footer"><span>@L["Overview:DiscoveryCounts", stats.AutoDiscoveredCount, stats.ManualSubscriptionCount]</span><MudButton Href="@UIEventBusSubscriptionsPage.PAGE_URL" EndIcon="@MoIcons.ArrowRight">@L["Overview:ExploreRegistry"]</MudButton></div>
            </section>
            <section class="eventbus-runtime-summary">
                <span class="eventbus-eyebrow">@L["Overview:RuntimeKicker"]</span>
                <h2>@L["Overview:ReportedTopics", capture.TopicStatuses.Count]</h2>
                <p>@L["Overview:RuntimeHelp"]</p>
                <div class="eventbus-runtime-counts">
                    <div><EventBusStatusBadge Tone="@(capture.TopicStatuses.Any(status => status.State == TopicSubscriptionRuntimeState.Failed) ? Color.Error : capture.TopicStatuses.Any(status => status.State == TopicSubscriptionRuntimeState.Recovering) ? Color.Warning : Color.Default)">@L["Overview:ReportedProblems"]</EventBusStatusBadge><strong>@stats.UnhealthyTopics</strong></div>
                    <div><span>@L["Overview:ReportedCoverage"]</span><strong>@capture.Subscriptions.Count(row => row.Scope == EventSubscriptionScope.Distributed && row.TopicStatus != null)<small> / @stats.DistributedSubscriptions</small></strong></div>
                    <div><span>@L["Overview:LocalHandlers"]</span><strong>@stats.LocalSubscriptions</strong></div>
                </div>
                <p class="eventbus-runtime-note">@L["Overview:CoverageHelp"]</p>
                <MudButton Href="@UIEventBusProvidersPage.PAGE_URL" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" EndIcon="@MoIcons.ArrowRight">@L["Overview:ExploreProviders", capture.Providers.Count]</MudButton>
            </section>
        </div>
        <section class="eventbus-topic-ledger">
            <header class="eventbus-section-heading"><div><span class="eventbus-eyebrow">@L["Overview:TransportEvidence"]</span><h2>@L["Overview:TopicLedger"]</h2><p>@L["Overview:TopicLedgerHelp"]</p></div><span class="eventbus-section-count">@L["Overview:TopicCount", capture.TopicStatuses.Count]</span></header>
            <div class="eventbus-clipped-table">
                <MudTable T="TopicSubscriptionStatus" Items="capture.TopicStatuses.OrderByDescending(status => status.State is TopicSubscriptionRuntimeState.Failed or TopicSubscriptionRuntimeState.Recovering).ThenBy(status => status.TopicName, StringComparer.Ordinal)" Square="true" Elevation="0" Breakpoint="Breakpoint.Xs" Hover="true" RowsPerPage="10">
                    <HeaderContent><MudTh>@L["SubscriptionTable:Columns:TopicName"]</MudTh><MudTh>@L["SubscriptionFilter:Provider"]</MudTh><MudTh>@L["Registry:ReportedRuntime"]</MudTh><MudTh>@L["Overview:MatchedHandlers"]</MudTh><MudTh>@L["Overview:StateChanged"]</MudTh><MudTh>@L["SubscriptionTable:Columns:Actions"]</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["SubscriptionTable:Columns:TopicName"]"><div class="eventbus-cell"><code class="eventbus-topic-name">@context.TopicName</code>@if (context.State is TopicSubscriptionRuntimeState.Failed or TopicSubscriptionRuntimeState.Recovering) { <p class="eventbus-topic-error">@context.LastErrorMessage</p> }</div></MudTd>
                        <MudTd DataLabel="@L["SubscriptionFilter:Provider"]"><div class="eventbus-cell"><code>@EventBusPresentation.KeyText(context.ServiceKey, L)</code><span class="eventbus-muted">@L.GetProviderKindText(context.Provider)</span></div></MudTd>
                        <MudTd DataLabel="@L["Registry:ReportedRuntime"]"><div class="eventbus-cell"><EventBusStatusBadge Tone="@EventBusPresentation.RuntimeColor(context.State)">@L.GetTopicRuntimeStateText(context.State)</EventBusStatusBadge></div></MudTd>
                        <MudTd DataLabel="@L["Overview:MatchedHandlers"]"><div class="eventbus-cell">@capture.Subscriptions.Count(row => row.Scope == EventSubscriptionScope.Distributed && row.ServiceKey == context.ServiceKey && row.TopicName == context.TopicName)</div></MudTd>
                        <MudTd DataLabel="@L["Overview:StateChanged"]"><div class="eventbus-cell"><time>@UiTime.Format(context.StateChangedAt)</time></div></MudTd>
                        <MudTd DataLabel="@L["SubscriptionTable:Columns:Actions"]"><div class="eventbus-cell"><MudIconButton Icon="@MoIcons.ExternalLink" Size="Size.Small" Color="Color.Primary" aria-label="@L["Overview:InspectTopic", context.TopicName]" title="@L["Overview:TopicInspector"]" OnClick="() => OnTopicClick.InvokeAsync(context)" /></div></MudTd>
                    </RowTemplate>
                    <NoRecordsContent><div class="eventbus-empty">@L["Overview:NoReportedTopics"]</div></NoRecordsContent>
                    <PagerContent><MudTablePager FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" PageSizeOptions="@(new[] { 10, 20, 50 })" /></PagerContent>
                </MudTable>
            </div>
        </section>
        <div class="eventbus-route-groups">
            <section>
                <header class="eventbus-section-heading"><div><span class="eventbus-eyebrow">@L["Overview:RegistrationMap"]</span><h2>@L["Overview:EventTypes"]</h2><p>@L["Overview:EventTypesHelp"]</p></div><strong class="eventbus-section-count">@_eventTypes.Count</strong></header>
                <div class="eventbus-clipped-table">
                    <MudTable T="EventTypeCount" Items="_eventTypes" Square="true" Elevation="0" RowsPerPage="5" Breakpoint="Breakpoint.None" Hover="true">
                        <HeaderContent><MudTh>@L["SubscriptionTable:Columns:EventType"]</MudTh><MudTh>@L["Overview:Handlers"]</MudTh></HeaderContent>
                        <RowTemplate><MudTd><div class="eventbus-cell"><MudButton Href="@RegistryLink("event", context.EventType)" Class="eventbus-group-link" title="@context.EventType">@context.EventTypeShortName</MudButton><code class="eventbus-muted">@context.EventType</code></div></MudTd><MudTd><div class="eventbus-cell"><strong>@context.Count</strong></div></MudTd></RowTemplate>
                        <NoRecordsContent><div class="eventbus-empty">@L["Overview:NoRegistrations"]</div></NoRecordsContent>
                        <PagerContent><MudTablePager FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" PageSizeOptions="@(new[] { 5, 10, 20 })" /></PagerContent>
                    </MudTable>
                </div>
            </section>
            <section>
                <header class="eventbus-section-heading"><div><span class="eventbus-eyebrow">@L["Overview:RegistrationMap"]</span><h2>@L["Overview:Topics"]</h2><p>@L["Overview:TopicsHelp"]</p></div><strong class="eventbus-section-count">@_topics.Count</strong></header>
                <div class="eventbus-clipped-table">
                    <MudTable T="TopicCount" Items="_topics" Square="true" Elevation="0" RowsPerPage="5" Breakpoint="Breakpoint.None" Hover="true">
                        <HeaderContent><MudTh>@L["SubscriptionTable:Columns:TopicName"]</MudTh><MudTh>@L["Overview:Handlers"]</MudTh></HeaderContent>
                        <RowTemplate><MudTd><div class="eventbus-cell"><MudButton Href="@RegistryLink("topic", context.TopicName)" Class="eventbus-group-link">@context.TopicName</MudButton></div></MudTd><MudTd><div class="eventbus-cell"><strong>@context.Count</strong></div></MudTd></RowTemplate>
                        <NoRecordsContent><div class="eventbus-empty">@L["Overview:NoRegistrations"]</div></NoRecordsContent>
                        <PagerContent><MudTablePager FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" PageSizeOptions="@(new[] { 5, 10, 20 })" /></PagerContent>
                    </MudTable>
                </div>
            </section>
        </div>
    </div>
}

@code {
    [Parameter] public EventBusWorkbenchSnapshot? Snapshot { get; set; }
    [Parameter] public EventCallback<TopicSubscriptionStatus> OnTopicClick { get; set; }
    private List<EventTypeCount> _eventTypes = [];
    private List<TopicCount> _topics = [];
    protected override void OnParametersSet()
    {
        _eventTypes = (Snapshot?.Subscriptions ?? []).GroupBy(row => row.EventType, StringComparer.Ordinal).OrderByDescending(group => group.Count()).ThenBy(group => group.Key, StringComparer.Ordinal).Select(group => new EventTypeCount { EventType = group.Key, EventTypeShortName = group.First().EventTypeShortName, Count = group.Count() }).ToList();
        _topics = (Snapshot?.Subscriptions ?? []).GroupBy(row => row.TopicName, StringComparer.Ordinal).OrderByDescending(group => group.Count()).ThenBy(group => group.Key, StringComparer.Ordinal).Select(group => new TopicCount { TopicName = group.Key, Count = group.Count() }).ToList();
    }
    private static string RegistryLink(string key, string value) => $"{UIEventBusSubscriptionsPage.PAGE_URL}?{key}={Uri.EscapeDataString(value)}";
}
