@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@namespace Monica.ServiceDiscovery.Pages
@attribute [Route(SERVICE_DISCOVERY_DEBUG_URL)]
@using Monica.ServiceDiscovery.UIServiceDiscovery.Components
@using Monica.ServiceDiscovery.UIServiceDiscovery.State
@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@inject ServiceDiscoveryPageState State
@inject IStringLocalizer<ServiceDiscoveryResource> L
@implements IAsyncDisposable

<PageTitle>@L["Workbench:Views:Registry:Title"]</PageTitle>
<DiscoveryWorkbench View="Registry">
    <section class="discovery-registry-summary" aria-label="@L["Workbench:RegistryScope"]">
        <div class="registry-summary-copy"><span>@L["Workbench:Membership"]</span><strong>@(State.CapturedAt is null ? L["Shared:Values:NotAvailable"] : L["Workbench:RegistryComposition", State.Services.Count(s => s.TotalInstanceCount > 0), State.Services.Sum(s => s.TotalInstanceCount)])</strong><p>@L["Workbench:MembershipHelp"]</p></div>
        <div class="registry-summary-stamp"><span>@L["Workbench:CapturedUTC"]</span><time>@(UiTime.FormatTime(State.CapturedAt))</time><MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" Disabled="@State.IsLoading" OnClick="() => RefreshAsync()">@L["Shared:Actions:Refresh"]</MudButton></div>
    </section>
    @if (State.ErrorMessage is not null)
    {
        <div class="registry-notice registry-notice--error" role="alert"><MoIcon Icon="@MoIcons.Error" Size="1.5rem" /><div><strong>@L["Workbench:RegistryReadFailed"]</strong><p>@State.ErrorMessage</p>@if (State.CapturedAt is not null) { <p>@L["Workbench:LastSuccessfulCapture"]</p> }</div></div>
    }
    <section class="registry-work-area">
        <header class="registry-work-heading"><div><span>@L["Workbench:RegistryScope"]</span><h2>@L["Workbench:RegistryTitle"]</h2><p>@(State.CapturedAt is null ? L["Shared:Values:NotAvailable"] : L["Workbench:ExpectedCount", State.Services.Count(s => s.TotalInstanceCount == 0)])</p></div><div class="registry-polling"><MudSwitch T="bool" @bind-Value="State.AutoRefreshEnabled" Label="@L["Shared:Labels:AutoRefresh"]" Color="Color.Primary" /><MudNumericField T="int" Value="State.RefreshInterval" ValueChanged="SetInterval" Min="1" Max="60" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(!State.AutoRefreshEnabled)" Label="@L["Shared:Labels:RefreshIntervalSeconds"]" /></div></header>
        <ServiceFilterPanel @ref="_filters" AllServices="@State.Services" FilterText="@State.FilterText" FilterTextChanged="SetSearch" SelectedStatuses="@State.SelectedStatuses" SelectedStatusesChanged="SetStatuses" SelectedDomains="@State.SelectedDomains" SelectedDomainsChanged="SetDomains" DomainSelectionIntentChanged="SetDomainIntent" ShowOnlyWithInstances="@State.ShowOnlyWithInstances" ShowOnlyWithInstancesChanged="SetOnlyRegistered" />
        @if (State.CapturedAt is null && State.IsLoading)
        {
            <div class="registry-empty" role="status"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><h3>@L["Workbench:LoadingRegistry"]</h3></div>
        }
        else if (State.CapturedAt is not null && State.Services.Count == 0)
        {
            <div class="registry-empty"><MoIcon Icon="@MoIcons.Server" Size="1.5rem" /><h3>@L["Workbench:EmptyRegistry"]</h3><p>@L["Workbench:EmptyRegistryHelp"]</p></div>
        }
        else if (State.CapturedAt is not null && State.FilteredServices.Count == 0)
        {
            <div class="registry-empty"><MoIcon Icon="@MoIcons.SearchOff" Size="1.5rem" /><h3>@L["Workbench:FilterMiss"]</h3><p>@L["Workbench:FilterMissHelp"]</p><MudButton OnClick="ResetFilters" Color="Color.Primary">@L["Workbench:ResetFilters"]</MudButton></div>
        }
        else if (State.CapturedAt is not null)
        {
            <ServiceDiscoveryServiceList Services="@State.FilteredServices" IsLoading="@State.IsLoading" OnRefresh="() => RefreshAsync()" CapturedAt="@State.CapturedAt" />
        }
        <footer class="registry-work-footer"><span>@(State.CapturedAt is null ? L["Shared:Values:NotAvailable"] : L["Workbench:ShownCount", State.FilteredServices.Count, State.Services.Count])</span><span>@L["Workbench:ObservedInstanceHelp"]</span></footer>
    </section>
</DiscoveryWorkbench>

@code {
    public const string SERVICE_DISCOVERY_DEBUG_URL = "/service-discovery-manage";
    private readonly CancellationTokenSource _lifetime = new();
    private readonly SemaphoreSlim _refreshGate = new(1,1);
    private CancellationToken _token;
    private Task? _polling;
    private bool _disposed;
    private bool _selectAllDomains = true;
    private ServiceFilterPanel? _filters;
    protected override async Task OnInitializedAsync()
    {
        _token = _lifetime.Token;
        State.UnknownDomainLabel = L["Shared:Values:Unknown"].Value;
        await RefreshAsync();
        if (!_disposed) _polling = PollAsync();
    }
    private async Task RefreshAsync(bool showLoading = true)
    {
        if (_disposed) return;
        try
        {
            if (!await _refreshGate.WaitAsync(0,_token)) return;
            try { await State.RefreshServicesAsync(showLoading, _token); }
            finally { _refreshGate.Release(); }
            if (!_disposed) StateHasChanged();
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
    }
    private async Task PollAsync()
    {
        try
        {
            while (!_token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(Math.Clamp(State.RefreshInterval, 1, 60)), _token);
                if (State.AutoRefreshEnabled) await InvokeAsync(() => RefreshAsync(false));
            }
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
    }
    private void SetInterval(int value) => State.RefreshInterval = Math.Clamp(value, 1, 60);
    private void SetSearch(string value) { State.FilterText = value; State.ApplyFilters(); }
    private void SetStatuses(IReadOnlyCollection<ServiceStatus> values) { State.SelectedStatuses = values.ToHashSet(); State.ApplyFilters(); }
    private void SetDomainIntent(bool selectAll) => _selectAllDomains = selectAll;
    private void SetDomains(IReadOnlyCollection<string> values) { State.SetSelectedDomains(values,_selectAllDomains); State.ApplyFilters(); }
    private void SetOnlyRegistered(bool value) { State.ShowOnlyWithInstances = value; State.ApplyFilters(); }
    private async Task ResetFilters()
    {
        State.FilterText = string.Empty; State.SelectedStatuses = Enum.GetValues<ServiceStatus>().ToHashSet();
        State.SelectAllDomains();
        State.ShowOnlyWithInstances = false; State.ApplyFilters();
        _selectAllDomains = true;
        if (!_disposed && _filters is not null) await _filters.SetSearchAsync(string.Empty);
    }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        await _lifetime.CancelAsync();
        if (_polling is not null) await _polling;
        await _refreshGate.WaitAsync();
        _refreshGate.Release();
        // The circuit state is borrowed; its serialized captures reject this canceled route's results.
        _lifetime.Dispose();
    }
}
