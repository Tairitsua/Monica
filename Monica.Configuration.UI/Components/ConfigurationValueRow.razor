@inject ConfigurationValueVisibility Visibility
@using Monica.Configuration.UI.Localization
@using System.Text.Json.Nodes
@inject ConfigurationFacade Facade
@inject ConfigurationStateStore StateStore
@inject ConfigurationParameterPackageService PackageService
@inject ConfigurationPendingChangeCompactor ChangeCompactor
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L
@implements IAsyncDisposable

<section class="@RowShellClass" aria-busy="@(_openingDialog ? "true" : "false")">
    <div class="configuration-value-row">
        <header class="configuration-value-identity">
            <div class="configuration-value-name"><h4>@DisplayName</h4>
                @if (IsExternalEffectiveSource)
                {
                    <MudTooltip Text="@EffectiveSourceTooltip"><span class="configuration-inline-icon"><MoIcon Icon="@MoIcons.Layers" Size="1.25rem" /></span></MudTooltip>
                }
            </div>
            <code class="configuration-value-path">@PathLabel</code>
            @if (!string.IsNullOrWhiteSpace(Node.Description))
            {
                <p class="configuration-value-description">@Node.Description</p>
            }
            <div class="configuration-value-flags">
                @if (Node.IsSensitive) { <span class="configuration-value-flag configuration-value-flag--warning">@L["State:Value:Sensitive"]</span> }
                @if (Node.ValidationRules.OfType<RequiredRule>().Any()) { <span class="configuration-value-flag configuration-value-flag--required">@L["State:Value:Required"]</span> }
                @if (Definition.Kind != ConfigurationKind.Startup && EffectiveReloadBehavior.RequiresProcessRestart()) { <span class="configuration-value-flag configuration-value-flag--warning">@L["State:Value:RestartNeeded"]</span> }
                @if (NonScalarEditorHint is { } editorHint)
                {
                    <MudTooltip Text="@L["State:Editor:EditorHintTooltip", editorHint]"><span class="configuration-value-flag configuration-value-flag--info">@editorHint</span></MudTooltip>
                }
            </div>
        </header>
        <div class="configuration-value-control">
            @if (Definition.Kind == ConfigurationKind.Startup)
            {
                <ConfigurationStartupValues Value="@EffectiveValue" />
            }
            else if (Node.NodeKind == ConfigurationNodeKind.Scalar)
            {
                <ConfigurationScalarEditor Node="@Node" EffectiveValue="@EffectiveValue" IsModified="@(PendingChange is not null)" PendingChange="@PendingChange" Disabled="@IsCurrentSourceReadOnly" ValidationIssue="@ValidationIssue" ValueChanged="StageScalar" />
                @if (ValidationIssue is not null && !ScalarEditorShowsInlineError)
                {
                    <p class="configuration-scalar-validation-error" role="alert">@ValidationIssue.ValidationError</p>
                }
            }
            else if (Node.IsScalarCollection())
            {
                <ConfigurationScalarCollectionEditor Node="@Node" EffectiveValue="@EffectiveValue" PendingChange="@PendingChange" ScopedPendingChanges="@ScopedPendingChanges" Disabled="@IsCurrentSourceReadOnly" ValidationIssue="@ValidationIssue" ValueChanged="StageScalarCollection" />
            }
            else
            {
                <div class="configuration-value-complex-actions">
                    <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Eye" OnClick="PreviewComplexValue">@L["State:Actions:PreviewValue"]</MudButton>
                    @if (Node.NodeKind is ConfigurationNodeKind.Dictionary or ConfigurationNodeKind.List)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Braces" Disabled="@IsCurrentSourceReadOnly" OnClick="EditComplexValue">@L["State:Actions:EditComplex"]</MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Braces" Disabled="@IsCurrentSourceReadOnly" OnClick="EditComplexJsonAsync">@L["Common:Actions:EditJson"]</MudButton>
                    }
                </div>
            }
        </div>
        <div class="configuration-value-actions">
            @if (CanInspectSourceChain)
            {
                <MudTooltip Text="@L["Sources:Chain:Title"]"><MudIconButton Icon="@MoIcons.Workflow" Size="Size.Small" aria-label="@L["Sources:Chain:Title"]" OnClick="OpenSourceChainAsync" /></MudTooltip>
            }
            @if (Definition.Kind != ConfigurationKind.Startup)
            {
                <MudTooltip Text="@L["History:Title"]"><MudIconButton Icon="@MoIcons.History" Size="Size.Small" aria-label="@L["History:Title"]" OnClick="OpenHistoryAsync" /></MudTooltip>
            }
            @if (HasPendingChanges)
            {
                <MudTooltip Text="@L["State:Actions:Undo"]"><MudIconButton Icon="@MoIcons.Undo" Size="Size.Small" aria-label="@L["State:Actions:Undo"]" OnClick="Undo" /></MudTooltip>
            }
        </div>
    </div>
</section>

@code {
    /// <summary>Gets the immutable definition owning this row; the caller must provide authoritative management metadata.</summary>
    [Parameter, EditorRequired] public ConfigurationDefinition Definition { get; set; } = null!;
    /// <summary>Gets the exact schema path rendered and edited by this row.</summary>
    [Parameter, EditorRequired] public ConfigurationNodeDefinition Node { get; set; } = null!;
    /// <summary>Gets the captured effective value and its physical source and version; sensitive values remain hidden.</summary>
    [Parameter] public ConfigurationEffectiveValue? EffectiveValue { get; set; }
    /// <summary>Gets optional external-source evidence when the effective value itself is unavailable.</summary>
    [Parameter] public ConfigurationSourceDescriptor? ExternalEffectiveSource { get; set; }
    /// <summary>Gets the path emphasized after native review navigation.</summary>
    [Parameter] public LogicalPath? HighlightedPath { get; set; }
    /// <summary>Gets whether editing and source mutation capabilities are unavailable for this row.</summary>
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Gets the active-row callback after staged changes or validation issues change.</summary>
    [Parameter] public EventCallback Changed { get; set; }
    /// <summary>Gets the active-row callback after a native history operation returns an actual persisted outcome.</summary>
    [Parameter] public EventCallback CommittedChanged { get; set; }

    private readonly ConfigurationOperationLifetime _operations = new();
    private bool _openingDialog;

    private PendingChange? PendingChange => StateStore.Get(Definition.DefinitionKey, Node.RelativePath);

    private ConfigurationValidationIssue? ValidationIssue => StateStore.GetValidationIssue(Definition.DefinitionKey, Node.RelativePath);

    private IReadOnlyList<PendingChange> ScopedPendingChanges => StateStore.GetScope(Definition.DefinitionKey, Node.RelativePath);

    private bool HasPendingChanges => Node.NodeKind == ConfigurationNodeKind.Scalar
        ? PendingChange is not null || ValidationIssue is not null
        : Node.IsScalarCollection()
            ? PendingChange is not null || ScopedPendingChanges.Count > 0 || ValidationIssue is not null
        : ScopedPendingChanges.Count > 0;

    private bool IsComplexNode => Node.NodeKind != ConfigurationNodeKind.Scalar && !Node.IsScalarCollection();

    private string RowShellClass => string.Join(' ', new[]
    {
        "configuration-value-row-shell",
        IsHighlighted ? "jump-highlight" : null,
        IsComplexNode && HasPendingChanges ? "modified-input" : null
    }.Where(static value => !string.IsNullOrWhiteSpace(value)));

    private bool IsHighlighted =>
        HighlightedPath is not null
        && (Node.RelativePath.Equals(HighlightedPath)
            || Node.IsScalarCollection() && IsPathPrefix(Node.RelativePath, HighlightedPath));

    private bool ScalarEditorShowsInlineError => Node.ValueKind == ConfigurationValueKind.TimeSpan;

    private string DisplayName => string.IsNullOrWhiteSpace(Node.DisplayName) ? Node.Name : Node.DisplayName!;

    private string PathLabel => Node.RelativePath.Depth == 0 ? L["State:Tree:Root"] : Node.RelativePath.ToCanonicalString();

    private ConfigurationSourceDescriptor? EffectiveSource => EffectiveValue?.EffectiveSource;

    private ConfigurationSourceDescriptor? EffectiveSourceForDisplay => EffectiveSource ?? ExternalEffectiveSource;

    private bool IsExternalEffectiveSource => EffectiveSourceForDisplay is { Kind: not ConfigurationSourceKind.MonicaEffectiveStore };

    private bool IsCurrentSourceReadOnly =>
        _operations.IsRetired || ReadOnly || Definition.Kind == ConfigurationKind.Startup
        || EffectiveSource is { Kind: not ConfigurationSourceKind.MonicaEffectiveStore, IsWritable: false };

    private bool CanInspectSourceChain => Definition.Origin == ConfigurationDefinitionOrigin.LocalScan;

    private string EffectiveSourceTooltip => EffectiveSourceForDisplay is not { } source
        ? string.Empty
        : source.IsWritable
            ? L["Sources:EffectiveSource:ExternalWritable", source.DisplayName, SourcePath(source)]
            : L["Sources:EffectiveSource:ExternalReadOnly", source.DisplayName, source.ReadOnlyReason ?? L["Sources:ReadOnly"]];

    private ConfigurationReloadBehavior EffectiveReloadBehavior => Node.ResolveEffectiveReloadBehavior(Definition);

    // Scalar string rows show the hint badge inside their editor; every other node kind surfaces the hint here.
    private string? NonScalarEditorHint => Node.EditorHint is null
                                          || (Node.NodeKind == ConfigurationNodeKind.Scalar
                                              && Node.ValueKind == ConfigurationValueKind.String)
        ? null
        : Node.EditorHint;

    private static bool IsPathPrefix(LogicalPath ancestor, LogicalPath path)
    {
        if (ancestor.Depth > path.Depth)
        {
            return false;
        }

        for (var index = 0; index < ancestor.Depth; index++)
        {
            if (!ancestor.Segments[index].Equals(path.Segments[index]))
            {
                return false;
            }
        }

        return true;
    }

    private bool IsCollectionSensitive =>
        Node.IsSensitive
        || Node.ListTemplate?.ItemTemplate.IsSensitive is true
        || Node.DictionaryTemplate?.ValueTemplate.IsSensitive is true;

    private IReadOnlyList<ConfigurationValidationRule> CollectionItemValidationRules =>
        Node.ListTemplate?.ItemTemplate.ValidationRules
        ?? Node.DictionaryTemplate?.ValueTemplate.ValidationRules
        ?? Node.ValidationRules;

    private Task StageScalar(ConfigurationScalarEditResult result) => RunCallbackAsync(() => StageScalarCore(result));

    private async Task StageScalarCore(ConfigurationScalarEditResult result)
    {
        if (IsCurrentSourceReadOnly)
        {
            return;
        }

        if (!result.IsValid || result.StoredValue is null)
        {
            StateStore.ReportValidationIssue(new ConfigurationValidationIssue
            {
                DefinitionKey = Definition.DefinitionKey,
                DefinitionDisplayName = Definition.DisplayName,
                LogicalPath = Node.RelativePath,
                NodeDisplayName = DisplayName,
                InvalidDisplayValue = Node.IsSensitive ? L["State:Value:Sensitive"].Value : result.DisplayValue,
                ValidationError = result.ValidationError ?? L["State:Editor:InvalidPattern"],
                IsSensitive = Node.IsSensitive,
                ValidationRules = Node.ValidationRules
            });
            await Changed.InvokeAsync();
            return;
        }

        if (IsSameAsEffectiveValue(result))
        {
            await UndoScalarState();
            return;
        }

        StateStore.Stage(new PendingChange
        {
            DefinitionKey = Definition.DefinitionKey,
            DefinitionDisplayName = Definition.DisplayName,
            LogicalPath = Node.RelativePath,
            NodeDisplayName = DisplayName,
            MutationKind = ConfigurationMutationKind.Set,
            NewValue = result.StoredValue,
            OriginalDisplayValue = NormalizeEffectiveDisplayValue(),
            NewDisplayValue = result.DisplayValue,
            ExpectedSchemaVersion = Definition.SchemaVersion,
            IsSensitive = Node.IsSensitive,
            NodeKind = Node.NodeKind,
            ValueKind = Node.ValueKind,
            ReloadBehavior = EffectiveReloadBehavior
        }.WithTarget(Definition, EffectiveSource, EffectiveValue?.Version));
        await Changed.InvokeAsync();
    }

    private Task StageScalarCollection(ConfigurationScalarCollectionEditResult result) => RunCallbackAsync(() => StageScalarCollectionCore(result));

    private async Task StageScalarCollectionCore(ConfigurationScalarCollectionEditResult result)
    {
        if (IsCurrentSourceReadOnly)
        {
            return;
        }

        if (!result.IsValid || result.StoredValue is null)
        {
            StateStore.ReportValidationIssue(new ConfigurationValidationIssue
            {
                DefinitionKey = Definition.DefinitionKey,
                DefinitionDisplayName = Definition.DisplayName,
                LogicalPath = Node.RelativePath,
                NodeDisplayName = DisplayName,
                InvalidDisplayValue = IsCollectionSensitive ? L["State:Value:Sensitive"].Value : result.InvalidDisplayValue ?? result.DisplayValue,
                ValidationError = result.ValidationError ?? L["State:Editor:InvalidPattern"],
                IsSensitive = IsCollectionSensitive,
                ValidationRules = CollectionItemValidationRules
            });
            await Changed.InvokeAsync();
            return;
        }

        if (IsSameAsEffectiveCollection(result.StoredValue.Json))
        {
            await UndoScalarState();
            return;
        }

        var originalJson = EffectiveCollectionJson();
        StateStore.Stage(new PendingChange
        {
            DefinitionKey = Definition.DefinitionKey,
            DefinitionDisplayName = Definition.DisplayName,
            LogicalPath = Node.RelativePath,
            NodeDisplayName = DisplayName,
            MutationKind = ConfigurationMutationKind.Set,
            NewValue = result.StoredValue,
            OriginalValue = originalJson is null ? null : ConfigurationStoredValue.FromJson(originalJson),
            OriginalDisplayValue = EffectiveValue?.DisplayValue,
            NewDisplayValue = result.DisplayValue,
            ExpectedSchemaVersion = Definition.SchemaVersion,
            IsSensitive = IsCollectionSensitive,
            NodeKind = Node.NodeKind,
            ValueKind = Node.ValueKind,
            ReloadBehavior = EffectiveReloadBehavior
        }.WithTarget(Definition, EffectiveSource, EffectiveValue?.Version));
        await Changed.InvokeAsync();
    }

    private bool IsSameAsEffectiveValue(ConfigurationScalarEditResult result)
    {
        var effectiveDisplayValue = EffectiveValue?.DisplayValue ?? string.Empty;
        if (Node.ValueKind == ConfigurationValueKind.TimeSpan)
        {
            return ConfigurationScalarTextCodec.TimeSpanEquals(result.DisplayValue, effectiveDisplayValue);
        }

        var effectiveStoredValue = TryCreateStoredValueFromDisplay(effectiveDisplayValue);
        if (effectiveStoredValue is not null && result.StoredValue is not null)
        {
            return StoredJsonEquals(effectiveStoredValue.Json, result.StoredValue.Json);
        }

        return string.Equals(result.DisplayValue, effectiveDisplayValue, StringComparison.Ordinal);
    }

    private string? NormalizeEffectiveDisplayValue()
    {
        return EffectiveValue?.DisplayValue is null
            ? null
            : ConfigurationScalarValueCodec.NormalizeDisplayValue(Node, EffectiveValue.DisplayValue);
    }

    private ConfigurationStoredValue? TryCreateStoredValueFromDisplay(string displayValue)
    {
        try
        {
            return ConfigurationScalarValueCodec.ConvertDisplayValue(Node, displayValue, L).StoredValue;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private bool IsSameAsEffectiveCollection(string storedJson)
    {
        var effectiveJson = EffectiveCollectionJson();
        return effectiveJson is not null && StoredJsonEquals(effectiveJson, storedJson);
    }

    private string? EffectiveCollectionJson()
    {
        if (string.IsNullOrWhiteSpace(EffectiveValue?.DisplayValue))
        {
            return Node.NodeKind switch
            {
                ConfigurationNodeKind.List => "[]",
                ConfigurationNodeKind.Dictionary => "{}",
                _ => null
            };
        }

        try
        {
            return JsonNode.Parse(EffectiveValue.DisplayValue)?.ToJsonString();
        }
        catch (JsonException)
        {
            return EffectiveValue.DisplayValue;
        }
    }

    private static bool StoredJsonEquals(string left, string right)
    {
        try
        {
            return JsonNode.DeepEquals(JsonNode.Parse(left), JsonNode.Parse(right));
        }
        catch (JsonException)
        {
            return string.Equals(left, right, StringComparison.Ordinal);
        }
    }

    private async Task UndoScalarState()
    {
        if (PendingChange is null && ValidationIssue is null)
        {
            return;
        }

        StateStore.Undo(Definition.DefinitionKey, Node.RelativePath);
        await Changed.InvokeAsync();
    }

    private Task EditComplexValue() => RunModalAsync(async context =>
    {
        if (context.CurrentValueReadOnly) return;
        var effectiveValue = await LoadComplexEffectiveValueAsync(context);
        if (effectiveValue is null || !IsCurrent(context)) return;
        var parameters = new DialogParameters<ComplexValueEditorDialog>();
        parameters.Add(dialog => dialog.Definition, context.Definition);
        parameters.Add(dialog => dialog.Node, context.Node);
        parameters.Add(dialog => dialog.EffectiveValue, effectiveValue);
        parameters.Add(dialog => dialog.PendingChanges, context.PendingChanges);
        var result = await _operations.ShowDialogAsync(() => DialogService.ShowAsync<ComplexValueEditorDialog>(L["Dialogs:ComplexEditor:Title"], parameters, EditorOptions));
        if (result is not { Canceled: false, Data: IReadOnlyList<PendingChange> changes } || !IsCurrent(context) || IsCurrentSourceReadOnly) return;
        var scalarValues = await PackageService.LoadScalarEffectiveValuesAsync(context.Definition, context.Node, effectiveValue);
        if (!IsCurrent(context) || IsCurrentSourceReadOnly) return;
        var compacted = ChangeCompactor.Compact(context.Definition, context.Node, effectiveValue, changes, scalarValues);
        if (!IsCurrent(context)) return;
        // StateStore notifies subscribers; invoke it outside the admission gate on the renderer.
        StateStore.ReplaceScope(context.Definition.DefinitionKey, context.Node.RelativePath, compacted);
        if (IsCurrent(context)) await Changed.InvokeAsync();
    });

    private Task PreviewComplexValue() => RunModalAsync(async context =>
    {
        var effectiveValue = await LoadComplexEffectiveValueAsync(context);
        if (effectiveValue is null || !IsCurrent(context)) return;
        var parameters = new DialogParameters<ConfigurationCurrentValuePreviewDialog>();
        parameters.Add(dialog => dialog.Definition, context.Definition);
        parameters.Add(dialog => dialog.Node, context.Node);
        parameters.Add(dialog => dialog.EffectiveValue, effectiveValue);
        parameters.Add(dialog => dialog.PendingChanges, context.PendingChanges);
        parameters.Add(dialog => dialog.AllowJsonEdit, !context.CurrentValueReadOnly);
        var result = await _operations.ShowDialogAsync(() => DialogService.ShowAsync<ConfigurationCurrentValuePreviewDialog>(L["Dialogs:CurrentValue:Title"], parameters, EditorOptions));
        if (result is { Canceled: false, Data: ConfigurationCurrentValuePreviewResult.EditJson } && IsCurrent(context) && !IsCurrentSourceReadOnly)
            await OpenJsonEditDialogAsync(context, effectiveValue);
    });

    private Task EditComplexJsonAsync() => RunModalAsync(async context =>
    {
        if (context.CurrentValueReadOnly) return;
        var effectiveValue = await LoadComplexEffectiveValueAsync(context);
        if (effectiveValue is not null && IsCurrent(context)) await OpenJsonEditDialogAsync(context, effectiveValue);
    });

    private async Task OpenJsonEditDialogAsync(RowContext context, ConfigurationEffectiveValue effectiveValue)
    {
        var scalarValues = await PackageService.LoadScalarEffectiveValuesAsync(context.Definition, context.Node, effectiveValue);
        if (!IsCurrent(context) || IsCurrentSourceReadOnly) return;
        var parameters = new DialogParameters<ConfigurationJsonEditDialog>();
        parameters.Add(dialog => dialog.Definition, context.Definition);
        parameters.Add(dialog => dialog.Node, context.Node);
        parameters.Add(dialog => dialog.EffectiveValue, effectiveValue);
        parameters.Add(dialog => dialog.ScalarEffectiveValues, scalarValues);
        parameters.Add(dialog => dialog.PendingChanges, context.PendingChanges);
        parameters.Add(dialog => dialog.CompactChanges, false);
        var result = await _operations.ShowDialogAsync(() => DialogService.ShowAsync<ConfigurationJsonEditDialog>(L["ImportExport:JsonEditor:Title"], parameters, EditorOptions));
        if (result is not { Canceled: false, Data: ConfigurationJsonEditResult edit } || !IsCurrent(context) || IsCurrentSourceReadOnly) return;
        // Borrowed store notifications must never run under the operation owner's gate.
        var replaced = StateStore.TryReplaceJsonEditorScope(edit);
        if (!replaced)
        {
            Snackbar.Add(L["ImportExport:JsonEditor:PendingStateUnavailable"], Severity.Warning);
            return;
        }
        await Changed.InvokeAsync();
    }

    private async Task<ConfigurationEffectiveValue?> LoadComplexEffectiveValueAsync(RowContext context)
    {
        var result = await Facade.GetEffectiveValueAsync(context.Definition.DefinitionKey, context.Node.RelativePath, Visibility.ShowSensitiveValues);
        if (!IsCurrent(context)) return null;
        if (result.IsFailed(out var error, out var value))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            return null;
        }
        return value;
    }

    private Task OpenHistoryAsync() => RunModalAsync(async context =>
    {
        var request = new ConfigurationHistoryPageRequest { DefinitionKey = context.Definition.DefinitionKey, LogicalPath = context.Node.RelativePath };
        var loaded = await Facade.QueryHistoryPageAsync(request);
        if (!IsCurrent(context)) return;
        if (loaded.IsFailed(out var error, out var page))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            return;
        }
        var parameters = new DialogParameters<ConfigurationHistoryDiffDialog>();
        parameters.Add(dialog => dialog.HistoryRequest, request);
        parameters.Add(dialog => dialog.InitialPage, page);
        parameters.Add(dialog => dialog.Definition, context.Definition);
        parameters.Add(dialog => dialog.AllowRollback, !context.ReadOnly);
        parameters.Add(dialog => dialog.FocusPath, context.Node.RelativePath);
        parameters.Add(dialog => dialog.Title, L["History:Dialog:MutationTitle", context.Definition.DisplayName]);
        var result = await _operations.ShowDialogAsync(() => DialogService.ShowAsync<ConfigurationHistoryDiffDialog>(L["History:Dialog:Title"], parameters, EditorOptions));
        if (result is { Canceled: false, Data: ConfigurationHistoryRollbackDialogResult rollback } && IsCurrent(context))
        {
            if (rollback.PostCommitIssues.Count == 0) Snackbar.Add(L["Rollback:Success"], Severity.Success);
            else
            {
                var summary = L["Rollback:AppliedWithIssues"].Value;
                Snackbar.Add(summary, Severity.Warning);
                var issueParameters = new DialogParameters<ConfigurationPostCommitIssuesDialog>();
                issueParameters.Add(dialog => dialog.Issues, rollback.PostCommitIssues);
                issueParameters.Add(dialog => dialog.SummaryText, summary);
                await _operations.ShowDialogAsync(() => DialogService.ShowAsync<ConfigurationPostCommitIssuesDialog>(
                    L["Dialogs:PostCommitIssues:Title"], issueParameters, ConfigurationPostCommitIssuesDialog.DefaultOptions));
            }
            if (!IsCurrent(context)) return;
            await CommittedChanged.InvokeAsync();
            if (IsCurrent(context)) await Changed.InvokeAsync();
        }
    });

    private Task OpenSourceChainAsync() => RunModalAsync(async context =>
    {
        if (context.Definition.Origin != ConfigurationDefinitionOrigin.LocalScan) return;
        var parameters = new DialogParameters<ConfigurationSourceChainDialog>();
        parameters.Add(dialog => dialog.Definition, context.Definition);
        parameters.Add(dialog => dialog.Node, context.Node);
        parameters.Add(dialog => dialog.AllowSourceEdit, !context.ReadOnly);
        await _operations.ShowDialogAsync(() => DialogService.ShowAsync<ConfigurationSourceChainDialog>(L["Sources:Chain:Title"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true }));
    });

    private static DialogOptions EditorOptions => new() { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true };

    private bool IsCurrent(RowContext context) => !_operations.IsRetired
        && string.Equals(Definition.DefinitionKey, context.Definition.DefinitionKey, StringComparison.Ordinal)
        && Node.RelativePath.Equals(context.Node.RelativePath);

    private async Task RunModalAsync(Func<RowContext, Task> callback)
    {
        if (_operations.IsRetired || _openingDialog) return;
        var context = new RowContext(Definition, Node, ReadOnly, IsCurrentSourceReadOnly, StateStore.GetPending().ToArray());
        _openingDialog = true; // Admission only; native openers stay enabled for focus restoration.
        try
        {
            await InvokeAsync(() => { if (!_operations.IsRetired) StateHasChanged(); });
            await _operations.RunAsync(_ => callback(context));
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
        finally
        {
            _openingDialog = false;
            if (!_operations.IsRetired)
                await InvokeAsync(() => { if (!_operations.IsRetired) StateHasChanged(); });
        }
    }

    private async Task RunCallbackAsync(Func<Task> callback)
    {
        try { await _operations.RunAsync(_ => callback()); }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
    }

    /// <summary>Closes and drains actual row-owned dialog references and callbacks before retirement completes.</summary>
    /// <remarks>The shared state store is borrowed and is never disposed by this presentation row.</remarks>
    public ValueTask DisposeAsync() => _operations.RetireAsync();

    private sealed record RowContext(ConfigurationDefinition Definition, ConfigurationNodeDefinition Node, bool ReadOnly, bool CurrentValueReadOnly, IReadOnlyList<PendingChange> PendingChanges);

    private static string SourcePath(ConfigurationSourceDescriptor source)
    {
        return source.PhysicalPath ?? source.SourcePath ?? source.ProviderType;
    }

    private Task Undo() => RunCallbackAsync(UndoCore);

    private async Task UndoCore()
    {
        if (_operations.IsRetired) return;
        if (Node.IsScalarCollection())
        {
            StateStore.UndoScope(Definition.DefinitionKey, Node.RelativePath);
        }
        else if (Node.NodeKind == ConfigurationNodeKind.Scalar)
        {
            StateStore.Undo(Definition.DefinitionKey, Node.RelativePath);
        }
        else
        {
            StateStore.UndoScope(Definition.DefinitionKey, Node.RelativePath);
        }

        await Changed.InvokeAsync();
    }

}
