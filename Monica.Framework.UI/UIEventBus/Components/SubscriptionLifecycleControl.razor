@using Monica.Framework.UI.UIEventBus.Models
@using Monica.EventBus.Models
@inject IStringLocalizer<EventBusResource> L

@if (Subscription is { State: not EventSubscriptionState.Disposed })
{
    <MudStack Row="true" Spacing="0">
        <MudIconButton Icon="@MoIcons.Flask" Color="@(IsTestListening ? Color.Success : Color.Info)" Size="Size.Small"
            aria-label="@L["SubscriptionLifecycle:Actions:Test"]" title="@L["SubscriptionLifecycle:Actions:Test"]" aria-disabled="@(IsBusy ? "true" : "false")"
            OnClick="() => DispatchAsync(OnTest)" />
        @if (Subscription.State == EventSubscriptionState.Active)
        {
            <MudIconButton Icon="@MoIcons.PauseCircle" Color="Color.Warning" Size="Size.Small"
                aria-label="@L["SubscriptionLifecycle:Actions:Deactivate"]" title="@L["SubscriptionLifecycle:Actions:Deactivate"]" aria-disabled="@(IsBusy ? "true" : "false")"
                OnClick="() => DispatchAsync(OnDeactivate)" />
        }
        else if (Subscription.CanActivate)
        {
            <MudIconButton Icon="@MoIcons.PlayCircle" Color="Color.Success" Size="Size.Small"
                aria-label="@L["SubscriptionLifecycle:Actions:Activate"]" title="@L["SubscriptionLifecycle:Actions:Activate"]" aria-disabled="@(IsBusy ? "true" : "false")"
                OnClick="() => DispatchAsync(OnActivate)" />
        }
        <MudIconButton Icon="@MoIcons.Delete" Color="Color.Error" Size="Size.Small"
            aria-label="@L["SubscriptionLifecycle:Actions:Remove"]" title="@L["SubscriptionLifecycle:Actions:Remove"]" aria-disabled="@(IsBusy ? "true" : "false")"
            OnClick="() => DispatchAsync(OnUnsubscribe)" />
    </MudStack>
}

@code {
    [Parameter] public SubscriptionViewModel? Subscription { get; set; }
    [Parameter] public EventCallback OnActivate { get; set; }
    [Parameter] public EventCallback OnDeactivate { get; set; }
    [Parameter] public EventCallback OnUnsubscribe { get; set; }
    [Parameter] public EventCallback OnTest { get; set; }
    [Parameter] public bool IsTestListening { get; set; }
    [Parameter] public bool IsBusy { get; set; }

    private Task DispatchAsync(EventCallback callback) => IsBusy ? Task.CompletedTask : callback.InvokeAsync();
}
