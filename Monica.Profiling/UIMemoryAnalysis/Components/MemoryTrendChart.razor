@using Monica.UI.Shared.Components.States
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.Profiling.RuntimeMetrics.Models
@using Monica.Profiling.UIRuntimeMetrics.Components
@using Monica.Profiling.UIRuntimeMetrics.Support
@using Monica.Profiling.UIMemoryAnalysis.Support
@inject IStringLocalizer<MemoryAnalysisResource> L

<section class="memory-history">
    <article class="memory-history-window">
        <header class="memory-history-heading"><div><span class="memory-history-eyebrow">@L["Trend:WindowEyebrow"]</span><h2>@L["Trend:WindowTitle"]</h2><p>@L["Trend:WindowHelp"]</p></div></header>
        <dl class="memory-history-summary">
            <div><dt>@L["Trend:Summary:Samples"]</dt><dd data-window-count="@Points.Count">@(TrendData is null ? L["Common:Unavailable"] : L["Trend:Capacity", Points.Count, TrendData.MaxHistoryPoints])</dd></div>
            <div><dt>@L["Trend:Window"]</dt><dd>@WindowDuration</dd><small><time datetime="@MachineTime(TrendData?.StartTime)">@UiTime.FormatTime(RuntimeMetricsDisplayFormatter.AsUtc(TrendData?.StartTime))</time><span aria-hidden="true"> → </span><time datetime="@MachineTime(TrendData?.EndTime)">@UiTime.FormatTime(RuntimeMetricsDisplayFormatter.AsUtc(TrendData?.EndTime))</time></small></div>
            <div><dt>@L["Trend:CollectorInterval"]</dt><dd data-sample-interval="@TrendData?.SampleIntervalMs">@(TrendData is null ? L["Common:Unavailable"] : L["Trend:Seconds", TrendData.SampleIntervalMs / 1000d])</dd></div>
        </dl>
        <dl class="memory-history-means">
            <div><dt>@L["Trend:Summary:AverageHeap"]</dt><dd>@RuntimeMetricsDisplayFormatter.Megabytes(Points.Count > 0 ? TrendData!.AverageHeapSizeMB : null)</dd></div>
            <div><dt>@L["Trend:Summary:MaximumHeap"]</dt><dd>@RuntimeMetricsDisplayFormatter.Megabytes(Points.Count > 0 ? TrendData!.MaxHeapSizeMB : null)</dd></div>
            <div><dt>@L["Trend:Summary:AverageAllocation"]</dt><dd>@RuntimeMetricsDisplayFormatter.ReportedAllocationRate(Points.Count > 0 ? TrendData!.AverageAllocationRate : null)</dd></div>
        </dl>
    </article>
    @if (Points.Count >= 2)
    {
        <div class="memory-history-plots">
            <article class="memory-history-plot" data-metric="heap" data-unit="MB"><header><span class="memory-history-eyebrow">@L["Trend:Heap:Eyebrow"]</span><h2>@L["Trend:Heap:Title"]</h2><p>@L["Trend:HeapUnit"]</p></header>
                <div class="memory-history-canvas"><MemoryHistoryPlot Points="@Points" Metric="MemoryHistoryMetric.HeapMegabytes" SeriesLabel="@L["Trend:Series:Heap"]" Description="@L["Trend:MeasurementHelp"]" UnavailableText="@L["Common:Unavailable"]" /></div></article>
            <article class="memory-history-plot" data-metric="allocation" data-unit="MiB/s"><header><span class="memory-history-eyebrow">@L["Trend:Allocation:Eyebrow"]</span><h2>@L["Trend:Allocation:Title"]</h2><p>@L["Trend:AllocationUnit"]</p></header>
                <div class="memory-history-canvas"><MemoryHistoryPlot Points="@Points" Metric="MemoryHistoryMetric.AllocationMebibytesPerSecond" SeriesLabel="@L["Trend:Series:Allocation"]" StrokeColor="var(--mud-palette-info)" Description="@L["Trend:MeasurementHelp"]" UnavailableText="@L["Common:Unavailable"]" /></div></article>
        </div>
    }
    else
    {
        <div class="memory-history-empty" role="status"><MoIcon Icon="@MoIcons.ChartLine" Size="1.5rem" /><h2>@EmptyTitle</h2><p>@EmptyHelp</p></div>
    }
    <p class="memory-history-note">@L["Trend:MeasurementHelp"]</p>
    <article class="memory-generation-lens">
        <header class="memory-history-heading"><div><span class="memory-history-eyebrow">@L["Trend:Generations:Eyebrow"]</span><h2>@L["Trend:Generations:Title"]</h2><p>@L["Trend:Generations:Help"]</p></div>
            @if (Points.Count > 0) { <time datetime="@MemoryAnalysisDisplayFormatter.MachineTime(Points[^1].Timestamp)">@UiTime.Format(RuntimeMetricsDisplayFormatter.AsUtc(Points[^1].Timestamp))</time> }</header>
        @if (Points.Count > 0)
        {
            var latest = Points[^1];
            <dl class="memory-generation-values">
                <div><dt>@L["Common:Generation", 0]</dt><dd>@MemoryAnalysisDisplayFormatter.ReportedBytes(latest.Gen0SizeBytes)</dd></div>
                <div><dt>@L["Common:Generation", 1]</dt><dd>@MemoryAnalysisDisplayFormatter.ReportedBytes(latest.Gen1SizeBytes)</dd></div>
                <div><dt>@L["Common:Generation", 2]</dt><dd>@MemoryAnalysisDisplayFormatter.ReportedBytes(latest.Gen2SizeBytes)</dd></div>
                <div><dt>@L["Gc:Generations:Names:Loh"]</dt><dd>@MemoryAnalysisDisplayFormatter.ReportedBytes(latest.LohSizeBytes)</dd></div>
                <div><dt>@L["Gc:Generations:Names:Poh"]</dt><dd>@MemoryAnalysisDisplayFormatter.ReportedBytes(latest.PohSizeBytes)</dd></div>
            </dl>
        }
        else { <MoContentState Compact="true">@L["Trend:Recent:Empty"]</MoContentState> }
    </article>
    <article class="memory-sample-ledger">
        <header class="memory-history-heading"><div><span class="memory-history-eyebrow">@L["Trend:Recent:Eyebrow"]</span><h2>@L["Trend:Recent:Title"]</h2></div><p>@L["Trend:Recent:Help"]</p></header>
        @if (Points.Count > 0)
        {
            <div class="memory-sample-frame"><MudSimpleTable Hover="true" Elevation="0">
                <thead><tr><th scope="col">@L["Trend:Recent:Columns:Time"]</th><th scope="col">@L["Trend:Recent:Columns:Heap"]</th><th scope="col">@L["Trend:Recent:Columns:Allocation"]</th><th scope="col">@L["Trend:Recent:Columns:GcTime"]</th><th scope="col">@L["Trend:Recent:Columns:Fragmentation"]</th><th scope="col"><span class="memory-visually-hidden">@L["Trend:Recent:Columns:Inspect"]</span></th></tr></thead>
                <tbody>@foreach (var point in VisiblePoints)
                {
                    <tr @key="point.Timestamp" data-sample-timestamp="@MemoryAnalysisDisplayFormatter.MachineTime(point.Timestamp)">
                        <td data-label="@L["Trend:Recent:Columns:Time"]"><time datetime="@MemoryAnalysisDisplayFormatter.MachineTime(point.Timestamp)" title="@UiTime.Format(RuntimeMetricsDisplayFormatter.AsUtc(point.Timestamp))">@UiTime.FormatTime(RuntimeMetricsDisplayFormatter.AsUtc(point.Timestamp))</time></td>
                        <td data-label="@L["Trend:Recent:Columns:Heap"]">@RuntimeMetricsDisplayFormatter.Megabytes(point.GcHeapSizeMB)</td>
                        <td data-label="@L["Trend:Recent:Columns:Allocation"]">@RuntimeMetricsDisplayFormatter.ReportedAllocationRate(point.AllocationRateBps)</td>
                        <td data-label="@L["Trend:Recent:Columns:GcTime"]">@MemoryAnalysisDisplayFormatter.Percent(point.TimeInGcPercent)</td>
                        <td data-label="@L["Trend:Recent:Columns:Fragmentation"]">@MemoryAnalysisDisplayFormatter.Percent(point.GcFragmentation)</td>
                        <td class="memory-sample-action"><MudIconButton Icon="@MoIcons.ArrowUpRight" Size="Size.Small" Color="Color.Primary" aria-label="@L["Trend:Recent:Inspect", MemoryAnalysisDisplayFormatter.MachineTime(point.Timestamp)]" OnClick="@(() => InspectAsync(point))" Disabled="@(CapturedAt is null)" /></td>
                    </tr>
                }</tbody>
            </MudSimpleTable></div>
            <footer class="memory-ledger-footer"><span>@L["Trend:Recent:Range", (_page - 1) * PageSize + 1, Math.Min(_page * PageSize, Points.Count), Points.Count]</span>
                @if (PageCount > 1) { <MudPagination Count="PageCount" Selected="_page" SelectedChanged="ChangePage" ShowFirstButton="true" ShowLastButton="true" Size="Size.Small" Color="Color.Default" aria-label="@L["Trend:Recent:Pagination"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" /> }</footer>
        }
        else { <MoContentState Compact="true">@L["Trend:Recent:Empty"]</MoContentState> }
    </article>
</section>

@code {
    [Parameter] public RuntimeMetricsTrend? TrendData { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    /// <summary>Gets or sets the successful view-read time associated with retained samples.</summary>
    [Parameter] public DateTimeOffset? CapturedAt { get; set; }
    /// <summary>Requests frozen sample inspection and completes when the native dialog closes.</summary>
    [Parameter] public EventCallback<RuntimeSampleEvidence> OnInspect { get; set; }
    /// <summary>Restores focus to a stable page action when the selected row is no longer mounted.</summary>
    [Parameter] public EventCallback OnInspectTriggerRemoved { get; set; }
    private const int PageSize = 12;
    private int _page = 1;
    private IReadOnlyList<RuntimeMetricsPoint> Points => TrendData?.DataPoints ?? [];
    private int PageCount => Math.Max(1, (Points.Count + PageSize - 1) / PageSize);
    private IEnumerable<RuntimeMetricsPoint> VisiblePoints => Points.Reverse().Skip((_page - 1) * PageSize).Take(PageSize);
    private string WindowDuration => TrendData?.StartTime is { } start && TrendData.EndTime is { } end ? L["Trend:Seconds", (end-start).TotalSeconds] : L["Common:Unavailable"];
    private string EmptyTitle => TrendData is null && IsLoading ? L["Common:LoadingValue"] : TrendData?.MaxHistoryPoints == 0 ? L["Trend:NoRetentionTitle"] : Points.Count == 1 ? L["Trend:SingleTitle"] : L["Trend:WaitingTitle"];
    private string EmptyHelp => TrendData?.MaxHistoryPoints == 0 ? L["Trend:NoRetention"] : TrendData?.MaxHistoryPoints == 1 ? L["Trend:SingleRetention"] : Points.Count == 1 ? L["Trend:SingleWaiting"] : L["Trend:Waiting"];
    protected override void OnParametersSet()
    {
        _page = Math.Min(_page, PageCount);
    }
    private void ChangePage(int value) => _page=Math.Clamp(value,1,PageCount);
    private static string? MachineTime(DateTime? timestamp) => timestamp is { } value ? MemoryAnalysisDisplayFormatter.MachineTime(value) : null;
    private async Task InspectAsync(RuntimeMetricsPoint point)
    {
        if (CapturedAt is not { } capturedAt) return;
        await OnInspect.InvokeAsync(new RuntimeSampleEvidence(point,capturedAt));
        if (!VisiblePoints.Any(item=>item.Timestamp==point.Timestamp)) await OnInspectTriggerRemoved.InvokeAsync();
    }
}
