@using Monica.JobScheduler.Models.Operations
@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Support
@inject IStringLocalizer<JobSchedulerResource> L

<section class="runtime-config" aria-labelledby="runtime-config-heading">
    <header class="runtime-config__heading">
        <MoIcon Icon="@MoIcons.Sliders" aria-hidden="true" Size="1.5rem" />
        <div>
            <h2 id="runtime-config-heading">@L["Runtime:Config:Title"]</h2>
            <p>@L["Runtime:Config:Description"]</p>
        </div>
    </header>
    <div class="runtime-config__grid">
        <section class="runtime-config__group" aria-labelledby="runtime-config-cadence-heading">
            <h3 id="runtime-config-cadence-heading">@L["Runtime:Config:Group:Cadence"]</h3>
            <dl>
                <div><dt>@L["Runtime:Config:SchedulingPollInterval"]</dt><dd>@Interval(c.SchedulingPollInterval)</dd></div>
                <div><dt>@L["Runtime:Config:WorkerPollInterval"]</dt><dd>@Interval(c.WorkerPollInterval)</dd></div>
                <div><dt>@L["Runtime:Config:SnapshotSyncInterval"]</dt><dd>@Interval(c.SnapshotSyncInterval)</dd></div>
                <div><dt>@L["Runtime:Config:CoordinatorLeaseDuration"]</dt><dd>@Interval(c.CoordinatorLeaseDuration)</dd></div>
            </dl>
        </section>
        <section class="runtime-config__group" aria-labelledby="runtime-config-lease-heading">
            <h3 id="runtime-config-lease-heading">@L["Runtime:Config:Group:Lease"]</h3>
            <dl>
                <div><dt>@L["Runtime:Config:ExecutionLeaseDuration"]</dt><dd>@Interval(c.ExecutionLeaseDuration)</dd></div>
                <div><dt>@L["Runtime:Config:ExecutionLeaseRenewInterval"]</dt><dd>@Interval(c.ExecutionLeaseRenewInterval)</dd></div>
                <div><dt>@L["Runtime:Config:ExecutionRetryDelay"]</dt><dd>@Interval(c.ExecutionRetryDelay)</dd></div>
                <div><dt>@L["Runtime:Config:ExecutionCancellationGracePeriod"]</dt><dd>@Interval(c.ExecutionCancellationGracePeriod)</dd></div>
                <div><dt>@L["Runtime:Config:WorkerShutdownGracePeriod"]</dt><dd>@Interval(c.WorkerShutdownGracePeriod)</dd></div>
            </dl>
        </section>
        <section class="runtime-config__group" aria-labelledby="runtime-config-capacity-heading">
            <h3 id="runtime-config-capacity-heading">@L["Runtime:Config:Group:Capacity"]</h3>
            <dl>
                <div><dt>@L["Runtime:Config:MaxWorkerExecutionThreads"]</dt><dd>@c.MaxWorkerExecutionThreads</dd></div>
                <div><dt>@L["Runtime:Config:MaxClaimBatchSize"]</dt><dd>@c.MaxClaimBatchSize</dd></div>
                <div><dt>@L["Runtime:Config:MaxRecurringMaterializationsPerCycle"]</dt><dd>@c.MaxRecurringMaterializationsPerCycle</dd></div>
                <div><dt>@L["Runtime:Config:MaxExpiredLeaseRecoveriesPerCycle"]</dt><dd>@c.MaxExpiredLeaseRecoveriesPerCycle</dd></div>
                <div><dt>@L["Runtime:Config:MaxConcurrentStoreOperations"]</dt><dd>@c.MaxConcurrentStoreOperations</dd></div>
                <div><dt>@L["Runtime:Config:ReservedLeaseStoreOperations"]</dt><dd>@c.ReservedLeaseStoreOperations</dd></div>
                <div><dt>@L["Runtime:Config:StoreOperationTimeout"]</dt><dd>@Interval(c.StoreOperationTimeout)</dd></div>
            </dl>
        </section>
        <section class="runtime-config__group" aria-labelledby="runtime-config-history-heading">
            <h3 id="runtime-config-history-heading">@L["Runtime:Config:Group:History"]</h3>
            <dl>
                <div><dt>@L["Runtime:Config:EnableHistoryCleanup"]</dt><dd>@FormatFlag(c.EnableHistoryCleanup)</dd></div>
                <div><dt>@L["Runtime:Config:HistoryCleanupInterval"]</dt><dd>@Interval(c.HistoryCleanupInterval)</dd></div>
                <div><dt>@L["Runtime:Config:MaxHistoryDeletionsPerCycle"]</dt><dd>@c.MaxHistoryDeletionsPerCycle</dd></div>
                <div><dt>@L["Runtime:Config:MaxExecutionHistoryEntriesPerExecution"]</dt><dd>@c.MaxExecutionHistoryEntriesPerExecution</dd></div>
                <div><dt>@L["Runtime:Config:MaxExecutionHistoryMessageLength"]</dt><dd>@c.MaxExecutionHistoryMessageLength</dd></div>
                <div><dt>@L["Runtime:Config:MaxRetainedOrphanedExecutions"]</dt><dd>@c.MaxRetainedOrphanedExecutions</dd></div>
            </dl>
        </section>
    </div>
</section>

@code {
    /// <summary>Gets or sets all scalar effective options from one captured serving-host runtime snapshot.</summary>
    /// <remarks>
    /// Values remain read-only, including configured budgets while cleanup is disabled. Readable localized units
    /// expose exact invariant intervals on hover or focus; the caller owns authorization and snapshot refresh.
    /// </remarks>
    [Parameter, EditorRequired]
    public JobSchedulerRuntimeOverview Overview { get; set; } = null!;

    private JobSchedulerRuntimeConfiguration c => Overview.Configuration;

    private RenderFragment Interval(TimeSpan value) => @<MudTooltip Text="@($"{L["Runtime:Config:ExactInterval"]}: {SchedulerRuntimePresentation.FormatExactInterval(value)}")">
        <span class="runtime-config__interval" tabindex="0">@SchedulerRuntimePresentation.FormatInterval(value, L)</span>
    </MudTooltip>;

    private string FormatFlag(bool value) => value ? L["Runtime:Config:Enabled"] : L["Runtime:Config:Disabled"];
}
