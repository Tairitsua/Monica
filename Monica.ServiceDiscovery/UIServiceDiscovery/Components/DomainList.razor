@using Monica.ServiceDiscovery.Facades
@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Support
@using Monica.Core.Results;
@inject ServiceDiscoveryFacade ServiceDiscoveryFacade
@inject ServiceDiscoveryDomainColorResolver DomainColorResolver
@inject ISnackbar Snackbar
@inject IStringLocalizer<ServiceDiscoveryResource> L

<div class="domain-list">
    <MudPaper Class="domain-list__header" Elevation="0" Outlined="true">
        <div class="domain-list__header-row">
            <MudText Typo="Typo.h6">@L["DomainList:Title"]</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshDomainsAsync" Disabled="@_isLoading">
                <MoIcon Icon="@MoIcons.Refresh" Class="mr-1" Size="1.5rem" />
                @L["Shared:Actions:Refresh"]
            </MudButton>
        </div>
    </MudPaper>

    @if (_isLoading)
    {
        <MudPaper Class="domain-list__state" Elevation="0" Outlined="true">
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-2">@L["DomainList:States:Loading"]</MudText>
        </MudPaper>
    }
    else if (!_domains.Any())
    {
        <MudPaper Class="domain-list__state" Elevation="0" Outlined="true">
            <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">
                @L["DomainList:States:Empty"]
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudGrid>
            @foreach (var domain in _domains)
            {
                var colorRole = GetDomainColorRole(domain.Id);
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="0"
                             Class="@($"cursor-pointer domain-card domain-card--{colorRole}")"
                             tabindex="0"
                             role="button"
                             @onclick="() => HandleDomainClick(domain)"
                             @onkeydown="args => HandleDomainKeyDownAsync(args, domain)">
                        <MudCardContent>
                            <MudStack Spacing="2">
                                <div class="domain-card__header">
                                    <div class="domain-card__identity">
                                        <span class="domain-card__icon" aria-hidden="true">
                                            <MoIcon Icon="@MoIcons.Building" Size="1.5rem" />
                                        </span>
                                        <MudText Typo="Typo.h6" Class="domain-card__title">
                                            @(domain.DisplayName ?? domain.Id)
                                        </MudText>
                                    </div>
                                    <div class="domain-card__counts">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Text="@L["DomainList:Counts:OwnedServices", GetOwnedServiceCount(domain.Id)]" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close" />
                                        @if (GetRelatedServiceCount(domain.Id) > 0)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Text="@L["DomainList:Counts:RelatedDependencies", GetRelatedServiceCount(domain.Id)]" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close" />
                                        }
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(domain.Description))
                                {
                                    <MudText Typo="Typo.body2" Class="domain-card__description">
                                        @domain.Description
                                    </MudText>
                                }

                                <MudStack Spacing="1">
                                    <MudText Typo="Typo.caption" Class="domain-card__meta">
                                        @L["DomainList:Summary:DomainName", domain.Id]
                                    </MudText>
                                    @{
                                        var ownedCount = GetOwnedServiceCount(domain.Id);
                                        var relatedCount = GetRelatedServiceCount(domain.Id);
                                    }
                                    <MudText Typo="Typo.caption" Class="domain-card__meta domain-card__meta--strong">
                                        @L["DomainList:Summary:OwnedServices", ownedCount]
                                        @if (relatedCount > 0)
                                        {
                                            <span> • @L["DomainList:Summary:DependentBy", relatedCount]</span>
                                        }
                                    </MudText>
                                </MudStack>
                            </MudStack>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</div>

@code {
    [Parameter] public EventCallback<DomainInfo> OnDomainSelected { get; set; }

    private bool _isLoading = false;
    private List<DomainInfo> _domains = [];
    private List<RegisteredServiceStatus> _allServices = [];
    private ApplicationTopologySnapshot _topology = new(false, []);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshDomainsAsync();
        }
    }

    private async Task RefreshDomainsAsync()
    {
        _isLoading = true;
        StateHasChanged();

        try
        {
            var domainsResult = await ServiceDiscoveryFacade.GetDomainsAsync();
            if (domainsResult.IsFailed(out var error, out var domains))
            {
                Snackbar.Add(L["DomainList:Messages:LoadFailed", error.Message ?? L["Shared:Values:Unknown"].Value].Value, Severity.Error);
                _domains = [];
            }
            else
            {
                _domains = domains ?? [];
                DomainColorResolver.AssignColors(_domains);
            }

            var topologyResult = await ServiceDiscoveryFacade.CaptureTopologyAsync();
            _topology = topologyResult.IsFailed(out _, out var topology) ? new(false, []) : topology!;
            var servicesResult = await ServiceDiscoveryFacade.GetMergedServicesStatusAsync();
            if (!servicesResult.IsFailed(out _, out var services))
            {
                _allServices = services ?? [];
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["DomainList:Messages:RefreshFailed", ex.Message].Value, Severity.Error);
            _domains = [];
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private string GetDomainColorRole(string domainName) => DomainColorResolver.GetDomainColorRole(domainName);

    private int GetOwnedServiceCount(string domainName)
        => _allServices.Count(s => s.BelongsToDomain(domainName));

    private int GetRelatedServiceCount(string domainName)
    {
        return _allServices.Count(s =>
            !s.BelongsToDomain(domainName) &&
            _topology.Dependencies.Any(dependency => dependency.TargetDomainId == domainName && dependency.IsOwnedBy(s)));
    }

    private async Task HandleDomainClick(DomainInfo domain)
    {
        await OnDomainSelected.InvokeAsync(domain);
    }

    private Task HandleDomainKeyDownAsync(KeyboardEventArgs args, DomainInfo domain)
    {
        return args.Key is "Enter" or " "
            ? HandleDomainClick(domain)
            : Task.CompletedTask;
    }
}
