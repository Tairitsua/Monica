    private async Task CopyFullNameAsync(ProjectUnitSummary? unit)
    {
        var targetUnit = unit ?? _contextMenuUnit;
        if (targetUnit is null)
        {
            return;
        }

        if (_disposed)
        {
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                _lifetimeCancellation.Token,
                targetUnit.Key);
        }
        catch (OperationCanceledException) when (_disposed)
        {
            return;
        }
        catch (JSDisconnectedException) when (_disposed)
        {
            return;
        }
        if (!_disposed)
        {
            Snackbar.Add(L["ProjectUnitVisualization:Messages:CopiedToClipboard"], Severity.Success);
        }
    }

    private HashSet<string> GetAllRelatedNodes(string nodeId)
    {
        var catalog = _allProjectUnits.ToDictionary(unit => unit.Key, StringComparer.Ordinal);
        var incoming = _allProjectUnits.SelectMany(unit => unit.Dependencies.Select(reference => (reference.Key, Unit: unit)))
            .ToLookup(edge => edge.Key, edge => edge.Unit, StringComparer.Ordinal);
        var related = new HashSet<string>(StringComparer.Ordinal) { nodeId };
        var queue = new Queue<string>();
        queue.Enqueue(nodeId);
        while (queue.TryDequeue(out var currentId))
        {
            if (catalog.TryGetValue(currentId, out var currentUnit))
            {
                foreach (var dependency in currentUnit.Dependencies)
                {
                    if (related.Add(dependency.Key))
                    {
                        queue.Enqueue(dependency.Key);
                    }
                }
            }

            foreach (var dependent in incoming[currentId])
            {
                if (related.Add(dependent.Key))
                {
                    queue.Enqueue(dependent.Key);
                }
            }
        }

        return related;
    }

