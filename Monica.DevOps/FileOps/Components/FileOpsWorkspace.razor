@using Microsoft.AspNetCore.Components.Routing
@implements IAsyncDisposable

<NavigationLock OnBeforeInternalNavigation="BeforeNavigationAsync" ConfirmExternalNavigation="@IsDirty" />
<div class="mo-workbench-container">
<div class="fo-page mo-page-shell mo-page-shell--workbench">
    <FileOpsFamilyHeader Controller="_controller" Browse="_browse" Config="_config" IsPolicy="IsPolicy"
                         FilesHref="@FilesHref" AccessDenied="_accessDenied" PolicyWorking="_policyWorking"
                         PolicyDirty="@(PolicyDraft?.IsDirty == true)" Refresh="RefreshAsync" Upload="OpenUploadAsync" />
    @if (_initializing || _legacyRedirect)
    {
        <MoContentState Class="fo-loading" Loading="true">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
            <strong>@L["Design:LoadingTitle"]</strong>
        </MoContentState>
    }
    else if (IsPolicy)
    {
        @if (_accessDenied)
        {
            <MoSemanticCallout Severity="MoVisualRole.Error" Icon="@MoIcons.Lock" Title="@L["Design:PolDeniedTitle"]">
                <p>@L["Design:PolDeniedBody"]</p>
                <MudButton Variant="Variant.Outlined" Href="@FilesHref" StartIcon="@MoIcons.ArrowLeft">@L["Design:BackToFiles"]</MudButton>
            </MoSemanticCallout>
        }
        else
        {
            <FileOpsPolicyEditor Form="PolicyDraft" Controller="_controller" ReadOutcome="_policyRead" Changed="StateHasChanged"
                                 Busy="@(_policyWorking || _controller.IsBusy)" Apply="ApplyPolicyAsync" Reload="ReloadPolicyAsync" />
        }
    }
    else
    {
        @if (_accessDenied && FileOpsViewQuery.Read(new Uri(Navigation.Uri)).LegacyPolicy)
        {
            <MoSemanticCallout Severity="MoVisualRole.Error" Icon="@MoIcons.Lock" Title="@L["Design:PolDeniedTitle"]">
                @L["Design:PolDeniedBody"]
            </MoSemanticCallout>
        }
        @if (_browse is not null && (_controller.BrowseStale || _controller.LastRead is { Succeeded: false, Kind: FileOpsOperationKind.LoadPolicy }))
        {
            <MoSemanticCallout Severity="MoVisualRole.Warning" Title="@L["Design:InvRetainedTitle"]">
                @L["Design:InvRetainedBody"] @_controller.LastRead?.Message
            </MoSemanticCallout>
        }
        @if (_controller.NavigationNotice is { } notice)
        {
            <MoSemanticCallout Severity="MoVisualRole.Warning" Title="@L["Workspace:ReturnFallback"]">@notice.Message</MoSemanticCallout>
        }
        @if (_controller.LastCommand is { } command && command.Kind is not (FileOpsOperationKind.SaveText or FileOpsOperationKind.SavePolicy))
        {
            <FileOpsOutcomeView Outcome="command" Target="@_commandTarget" ShowSuccess="true" />
        }
        <FileOpsDirectorySignature Controller="_controller" Browse="_browse" Config="_config" Inventory="_inventory"
                                   Query="_query" Filter="SetFiltersAsync" Navigate="NavigateAsync" Inspect="OpenFileAsync"
                                   Create="CreateAsync" CreateActive="_createActive" />
        @if (_browse is { IsTruncated: true } capped)
        {
            <MoSemanticCallout Severity="MoVisualRole.Warning" Title="@L["Design:InvTruncatedTitle", capped.EntryLimit]">
                @L["Design:InvTruncatedBanner", capped.EntryLimit]
                @if (!_accessDenied) { <a class="fo-inline-link" href="@UIFileOpsPolicyPage.PAGE_URL">@L["Design:InvAdjustCap"]</a> }
            </MoSemanticCallout>
        }
        <FileOpsInventory Controller="_controller" Browse="_browse" View="_inventory" Query="_query" Filter="SetFiltersAsync"
                          Open="OpenAsync" Download="DownloadAsync" Delete="DeleteAsync" DownloadSelection="DownloadSelectionAsync"
                          DeleteSelection="DeleteSelectionAsync" Refresh="RefreshAsync" Create="CreateAsync" />
        @if (SelectedPath is not null)
        {
            <FileOpsInspector @ref="_inspector" Controller="_controller" Inventory="_inventory" Command="_controller.LastCommand" CommandTarget="@_commandTarget" DraftChanged="EditDraft" Browse="_browse" Config="_config" InspectedPath="@SelectedPath"
                              Save="SaveTextAsync" Reload="ReloadTextAsync" Close="CloseInspectorAsync" Inspect="OpenFileAsync"
                              Download="DownloadAsync" Delete="DeleteAsync" PolicyAvailable="@(!_accessDenied)" />
        }
    }
</div>
</div>
