@using Monica.Framework.UI.UILogging.Models
@using Monica.UI.Shared.Components.Visual
@inject IStringLocalizer<LoggingResource> L
@inject Monica.UI.Shared.Services.MoTimeFormatter Time
<section class="lm-sig">
    <header class="lm-source-bar"><MoIcon Icon="@MoIcons.FileText" Size="1rem" /><code>@Snapshot.Source?.RelativePath</code><span>@L["Design:SourceEncoding"]</span>
        <code>@L["LogChart:Generation",Snapshot.Source?.Generation ?? "—"]</code><a href="@FilesUrl">@L["Design:SwitchFile"] ↗</a></header>
    <div class="lm-decision"><div class="lm-decision-main @(Attention > 0 ? "lm-alert" : null)"><p>@L["Design:DisplayLabel"]</p>
        <MoDisplayValue Class="lm-attention" Value="@(_available ? Attention.ToString("N0") : "—")" Unit="@L["Design:DisplayUnit",Snapshot.RetainedLines.Count]" />
        <div class="lm-pills">@foreach (var severity in Levels) { <MoFilterChip Label="@L[$"Workbench:Levels:{severity}"]" ShowDot="true" Pill="true" Role="@Role(severity)" Count="@_counts.GetValueOrDefault(severity)" Selected="@(Snapshot.Filter.Severity == severity)" SelectedChanged="@(() => OnSeverity.InvokeAsync(severity))" /> }</div>
    </div><p class="lm-finding">
        @if (!_available) { @L["Design:FindingMissing"] }
        else if (_buckets.Length == 0) { @L["Design:FindingEmpty"] }
        else {
            @L["LogChart:Summary",Snapshot.FirstRetainedLineNumber!,Snapshot.LastRetainedLineNumber!,_counts.GetValueOrDefault(LogSeverity.Warning),_counts.GetValueOrDefault(LogSeverity.Unknown)]
            @if (Attention > 0 && _peakBucket is { } peak) { <button type="button" class="mo-vl-link" @onclick="@(() => OnSpan.InvokeAsync($"{peak.First}-{peak.Last}"))">@L["LogChart:Peak",peak.First,peak.Last,peak.Errors]</button> }
            @if (_lastError is { } error) { <button class="mo-vl-link" @onclick="@(() => OnInspect.InvokeAsync(error))">@L["LogChart:Latest",error.AbsoluteLineNumber!]</button> }
            @if (Attention == 0) { <strong>@L["LogChart:Calm"]</strong> }
        }</p></div>
    @if (_buckets.Length > 0)
    {
        <div class="lm-tape"><div class="lm-tape-head"><strong>@L["Design:TapeTitle"]</strong><span>@L["Design:TapeRetained",Snapshot.FirstRetainedLineNumber!,Snapshot.LastRetainedLineNumber!,Snapshot.TotalStoredLines]</span>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@(Snapshot.FirstRetainedLineNumber <= 1 || Frozen)" OnClick="@(() => Earlier.InvokeAsync())">@L["Workbench:Viewer:Earlier"]</MudButton></div>
            <div class="lm-extent">
                @foreach (var extent in _extents) { <i style="@RangeStyle(extent.First,extent.Last)"></i> }
                @if (Visible.Count > 0 && Visible[0].AbsoluteLineNumber is { } from && Visible[^1].AbsoluteLineNumber is { } to)
                { <span class="lm-tape-vp" style="@RangeStyle(from,to)"></span> }
                @foreach (var bucket in _buckets.Where(b => b.Errors > 0 || b.Warning > 0))
                { <b class="lm-tick @(bucket.Errors > 0 ? "err" : "warn")" style="left:@Percent(bucket.First-1,Snapshot.TotalFileLineCount)"></b> }
            </div><div class="lm-tape-axis"><span>L1</span><span>L@(Snapshot.TotalFileLineCount)</span></div>
        </div>
        <div class="lm-strip"><header><h2>@L["Design:StripTitle"]</h2><p>@L["Design:StripDesc"]</p></header>
            <div class="lm-legend">@foreach (var key in Legend) { <span>@L[key]</span> }<code>@L["Design:StripPer",_size]</code></div>
            <div class="lm-plot" @onpointercancel="@(() => _start = null)" @onpointerleave="@(() => _start = null)">
                <div class="lm-labels">@foreach (var (name,peak) in new[] {("Design:StripLaneError",_errorMax),("Design:StripLaneWarn",_warnMax),("Design:StripLaneNormal",_normalMax)})
                    { <div><b>@L[name]</b><small>@L["LogChart:BucketMax",peak]</small></div> }
                    @if (Snapshot.Filter.HasKeyword) { <div><b>@L["LogChart:Matches"]</b><small>@L["LogChart:BucketMax",_matchMax]</small></div> }</div>
                <div class="lm-buckets">@for (var i = 0; i < _buckets.Length; i++)
                {
                    var index = i; var b = _buckets[i];
                    <button type="button" class="lm-bucket @(_selected == index ? "is-current" : null)" @ref="_elements[index]" tabindex="@(index == _selected ? 0 : -1)" aria-label="@L["LogChart:Bucket",b.First,b.Last,b.Errors,b.Warning,b.Normal]"
                        @onfocus="@(() => _selected=index)" @onpointerenter="@(() => _selected=index)" @onpointerdown="@(() => _start = index)" @onpointerup="@(() => EndBrush(index))" @onkeydown="@(e => Key(e,index))" @onclick="@(e => Activate(e,index))">
                        <span class="lm-lane err"><i style="height:@Percent(b.Errors,_errorMax)">@if (b.Critical > 0) { <em>◆</em> }</i></span>
                        <span class="lm-lane warn"><i style="height:@Percent(b.Warning,_warnMax)"></i></span>
                        <span class="lm-lane normal"><i style="height:@Percent(b.Normal,_normalMax)"><u style="height:@Percent(b.Unknown,b.Normal)"></u></i></span>
                        @if (Snapshot.Filter.HasKeyword) { <span class="lm-lane matches"><i style="height:@Percent(b.Matches,_matchMax)"></i></span> }
                    </button>
                }</div>
            </div>
            <div class="lm-chart-axis">@foreach (var i in new[] {0, _buckets.Length/3, 2*_buckets.Length/3, _buckets.Length-1}.Distinct())
                { <span>L@(_buckets[i].First)<small>@Time.FormatTime(_buckets[i].Timestamp)</small></span> }</div>
            @{ var selected = _buckets[_selected]; }
            <div class="lm-caption" aria-live="polite"><span>@L["LogChart:Bucket",selected.First,selected.Last,selected.Errors,selected.Warning,selected.Normal]</span>
                <button @onclick="@(() => _table = !_table)" aria-expanded="@_table">@L[_table ? "Design:StripHideTable" : "Design:StripShowTable"]</button></div>
            @if (_table) { <div class="lm-bucket-table"><table><thead><tr>@foreach (var column in Columns) { <th>@L[column]</th> }</tr></thead><tbody>
                @foreach (var b in _buckets) { <tr><td><button class="mo-vl-link" @onclick="@(() => Jump.InvokeAsync(b.First))">L@(b.First)–L@(b.Last)</button></td><td>@b.Critical</td><td>@(b.Errors-b.Critical)</td><td>@b.Warning</td><td>@b.Unknown</td><td>@(b.Normal-b.Unknown)</td><td>@b.Matches</td></tr> }
            </tbody></table></div> }
        </div>
    }
</section>
@code {
    [Parameter, EditorRequired] public ScreenLogSnapshot Snapshot { get; set; } = default!;
    [Parameter] public IReadOnlyList<LogLineViewModel> Visible { get; set; } = [];
    [Parameter] public string? FilesUrl { get; set; }
    [Parameter] public bool Frozen { get; set; }
    [Parameter] public EventCallback<LogSeverity> OnSeverity { get; set; }
    [Parameter] public EventCallback<string> OnSpan { get; set; }
    [Parameter] public EventCallback<LogLineViewModel> OnInspect { get; set; }
    [Parameter] public EventCallback<long> Jump { get; set; }
    [Parameter] public EventCallback Earlier { get; set; }
    internal static readonly LogSeverity[] Levels = [LogSeverity.Critical,LogSeverity.Error,LogSeverity.Warning,LogSeverity.Information,LogSeverity.Debug,LogSeverity.Trace,LogSeverity.Unknown];
    private static readonly string[] Legend = ["Design:StripLegendCrit","Design:StripLegendErr","Design:StripLegendWarn","Design:StripLegendInfo","Design:StripLegendUnparsed"];
    private static readonly string[] Columns = ["Design:StripColLines","Design:StripColCrit","Design:StripColErr","Design:StripColWarn","Design:StripColUnparsed","Design:StripColNormal","LogChart:Matches"];
    internal static MoVisualRole Role(LogSeverity level) => level switch { LogSeverity.Critical or LogSeverity.Error => MoVisualRole.Error, LogSeverity.Warning => MoVisualRole.Warning, LogSeverity.Information => MoVisualRole.Info, LogSeverity.Debug => MoVisualRole.Primary, _ => MoVisualRole.Neutral };
    private sealed record Bucket(long First,long Last,int Critical,int Errors,int Warning,int Normal,int Unknown,int Matches,DateTimeOffset? Timestamp);
    private Bucket[] _buckets = [];
    private readonly List<(long First,long Last)> _extents = [];
    private readonly Dictionary<int,ElementReference> _elements = [];
    private Dictionary<LogSeverity,int> _counts = [];
    private LogLineViewModel? _lastError;
    private Bucket? _peakBucket;
    private int _selected, _size, _errorMax, _warnMax, _normalMax, _matchMax;
    private int? _start;
    private bool _table, _brushed;
    private bool _available => Snapshot.FileExists || Snapshot.TotalStoredLines > 0;
    private int Attention => _counts.GetValueOrDefault(LogSeverity.Error)+_counts.GetValueOrDefault(LogSeverity.Critical);
    private ScreenLogSnapshot? _last;
    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_last,Snapshot)) return;
        _last=Snapshot;
        var retained = Snapshot.RetainedLines;
        _counts = retained.CountBy(l => l.Severity).ToDictionary();
        _lastError = retained.LastOrDefault(l => l.Severity is LogSeverity.Critical or LogSeverity.Error);
        _size=Math.Max(1,(int)Math.Ceiling(retained.Count/40d));
        _buckets=retained.Chunk(_size).Select(lines => {
            var c=lines.CountBy(l => l.Severity).ToDictionary();
            var errors=c.GetValueOrDefault(LogSeverity.Error)+c.GetValueOrDefault(LogSeverity.Critical);
            var warnings=c.GetValueOrDefault(LogSeverity.Warning);
            return new Bucket(lines[0].AbsoluteLineNumber!.Value,lines[^1].AbsoluteLineNumber!.Value,c.GetValueOrDefault(LogSeverity.Critical),errors,warnings,lines.Length-errors-warnings,c.GetValueOrDefault(LogSeverity.Unknown),lines.Count(l => l.IsMatch),lines.FirstOrDefault(l => l.Timestamp.HasValue)?.Timestamp);
        }).ToArray();
        _extents.Clear();
        foreach (var line in retained) { if (line.AbsoluteLineNumber is not { } number) continue;
            if (_extents.Count>0 && number-_extents[^1].Last==1) _extents[^1]=(_extents[^1].First,number); else _extents.Add((number,number)); }
        _errorMax=_buckets.Select(b=>b.Errors).DefaultIfEmpty().Max(); _warnMax=_buckets.Select(b=>b.Warning).DefaultIfEmpty().Max(); _normalMax=_buckets.Select(b=>b.Normal).DefaultIfEmpty().Max();
        _matchMax=_buckets.Select(b=>b.Matches).DefaultIfEmpty().Max();
        _peakBucket=_buckets.MaxBy(b=>b.Errors); _selected=Math.Clamp(_selected,0,Math.Max(0,_buckets.Length-1));
    }
    private string RangeStyle(long from,long to) => $"left:{Percent(from-1,Snapshot.TotalFileLineCount)};width:{Percent(to-from+1,Snapshot.TotalFileLineCount)}";
    private static string Percent(long value,long max) => FormattableString.Invariant($"{(max > 0 ? Math.Clamp(value/(double)max,0,1)*100 : 0):0.###}%");
    private async Task EndBrush(int index)
    {
        _brushed = _start.HasValue && _start != index;
        if (_brushed && !Frozen) await OnSpan.InvokeAsync($"{_buckets[Math.Min(_start!.Value,index)].First}-{_buckets[Math.Max(_start.Value,index)].Last}");
        _start=null;
    }
    private Task Activate(MouseEventArgs e,int i) { if (_brushed && e.Detail>0) { _brushed=false; return Task.CompletedTask; } return Jump.InvokeAsync(_buckets[i].First); }
    private async Task Key(KeyboardEventArgs e,int i)
    {
        var target=e.Key switch { "ArrowLeft" => Math.Max(0,i-1), "ArrowRight" => Math.Min(_buckets.Length-1,i+1), "Home"=>0, "End"=>_buckets.Length-1,_=>i };
        if (e.ShiftKey && target!=i && !Frozen) { _start??=i; await OnSpan.InvokeAsync($"{_buckets[Math.Min(_start.Value,target)].First}-{_buckets[Math.Max(_start.Value,target)].Last}"); }
        else _start=null;
        if (target!=i) await _elements[target].FocusAsync();
    }
}
