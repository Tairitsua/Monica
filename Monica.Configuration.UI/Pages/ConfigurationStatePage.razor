@inject ConfigurationValueVisibility Visibility
@using Monica.Configuration.Utils
@attribute [Route(PAGE_URL)]
@implements IAsyncDisposable
@inject ConfigurationFacade Facade
@inject ConfigurationStateStore StateStore
@inject ConfigurationParameterPackageService PackageService
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<PageTitle>@L["Pages:ConfigurationState:Title"]</PageTitle>

<div class="configuration-state-page">
    <ConfigurationPageHeader Title="@L["Pages:ConfigurationState:Title"]" Subtitle="@L["State:Subtitle"]">
        <TitleAccessory>
            @if (!_loadingDefinitions)
            {
                @foreach (var panelIndex in new[] { SOURCE_VALIDATION_PANEL, OPTIONS_VALIDATION_PANEL })
                {
                    var isOptions = panelIndex == OPTIONS_VALIDATION_PANEL;
                    <span class="configuration-runtime-validation-anchor">
                        <ConfigurationStatusIconButton Icon="@(isOptions ? OptionsValidationStatusIcon : RuntimeValidationStatusIcon)"
                                                       Color="@(isOptions ? OptionsValidationStatusColor : RuntimeValidationStatusColor)"
                                                       Count="@(isOptions ? OptionsValidationIssueCount : RuntimeValidationIssueCount)"
                                                       ShowCount="@((isOptions ? OptionsValidationIssueCount : RuntimeValidationIssueCount) > 0)"
                                                       Tooltip="@(isOptions ? OptionsValidationTooltip : RuntimeValidationStatusTooltip)"
                                                       AriaLabel="@(isOptions ? L["Validation:OptionsTitle"].Value : L["State:RuntimeValidation:OpenDetails"].Value)"
                                                       OnClick="() => ToggleRuntimeValidationPopover(panelIndex)" />
                        @if (_validationPanelIndex == panelIndex)
                        {
                            <MudPopover Open="@_runtimeValidationPopoverOpen"
                                        AnchorOrigin="Origin.BottomCenter"
                                        TransformOrigin="Origin.TopCenter"
                                        OverflowBehavior="OverflowBehavior.FlipAlways"
                                        Class="configuration-runtime-validation-popover"
                                        Style="width: min(44rem, calc(100vw - 48px)); box-sizing: border-box;"
                                        Paper="false">
                                <div class="configuration-runtime-validation-popover-surface">
                                    <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                                        <MudStack Spacing="2">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MoIcon Icon="@ValidationPopoverStatusIcon"
                                                             Style="@ValidationPopoverStatusIconStyle" Size="1.5rem" />
                                                    <MudStack Spacing="0">
                                                        <MudText Typo="Typo.subtitle1">@ValidationPopoverTitle</MudText>
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@ValidationPopoverSummary</MudText>
                                                    </MudStack>
                                                </MudStack>
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudChip T="int"
                                                             Size="Size.Small"
                                                             Color="@ValidationPopoverStatusColor"
                                                             Variant="Variant.Outlined">
                                                        @ValidationPopoverIssueCount
                                                    </MudChip>
                                                    <MudTooltip Text="@L["Common:Actions:Close"]">
                                                        <MudIconButton Icon="@MoIcons.Close"
                                                                       Size="Size.Small"
                                                                       OnClick="CloseRuntimeValidationPopover"
                                                                       aria-label="@L["Common:Actions:Close"]" />
                                                    </MudTooltip>
                                                </MudStack>
                                            </MudStack>

                                            @if (_validationLoading)
                                            {
                                                <MudProgressLinear Indeterminate="true" />
                                            }
                                            else
                                            {
                                                <MudTabs PrevIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" @bind-ActivePanelIndex="_validationPanelIndex">
                                                    <MudTabPanel Text="@L["Validation:SourceTitle"].Value">
                                                        @if (_runtimeValidationReport is null)
                                                        {
                                                            <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning">@(_runtimeValidationError ?? L["State:RuntimeValidation:Unavailable"].Value)</MudAlert>
                                                        }
                                                        else if (_runtimeValidationReport.DefinitionReports.Count > 0)
                                                        {
                                                            <MudExpansionPanels MultiExpansion="true">
                                                                @foreach (var definition in _runtimeValidationReport.DefinitionReports)
                                                                {
                                                                    <MudExpansionPanel Icon="@MoIcons.ChevronDown" Text="@ValidationDefinitionName(definition.DefinitionKey)">
                                                                        <ConfigurationValidationReportView Title="@definition.DefinitionKey"
                                                                           Coverage="@definition.Coverage" Scope="@definition.Scope"
                                                                           ValidationRevision="@definition.ValidationRevision"
                                                                           IsValid="@definition.IsValid" IsSchemaValid="@definition.IsSchemaValid"
                                                                           Issues="@RuntimeValidationIssues.Where(issue => string.Equals(issue.DefinitionKey, definition.DefinitionKey, StringComparison.OrdinalIgnoreCase)).ToArray()"
                                                                           ShowRuntimeMetadata="true" ShowSourceChain="true"
                                                                           JumpRequested="JumpToRuntimeValidationIssueAsync"
                                                                           SourceChainRequested="OpenRuntimeIssueSourceChainAsync" />
                                                                    </MudExpansionPanel>
                                                                }
                                                            </MudExpansionPanels>
                                                        }
                                                        else
                                                        {
                                                            <ConfigurationValidationReportView Coverage="@_runtimeValidationReport.Coverage"
                                                               Scope="@_runtimeValidationReport.Scope" ValidationRevision="@_runtimeValidationReport.ValidationRevision"
                                                               IsValid="@_runtimeValidationReport.IsValid" IsSchemaValid="@_runtimeValidationReport.IsSchemaValid"
                                                               Issues="@RuntimeValidationIssues" ShowRuntimeMetadata="true" ShowSourceChain="true"
                                                               JumpRequested="JumpToRuntimeValidationIssueAsync" SourceChainRequested="OpenRuntimeIssueSourceChainAsync" />
                                                        }
                                                    </MudTabPanel>
                                                    <MudTabPanel Text="@L["Validation:OptionsTitle"].Value">
                                                        <MudStack Spacing="2" Class="pt-2">
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Validation:OptionsNotice"]</MudText>
                                                            @if (_optionsValidationError is not null)
                                                            {
                                                                <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_optionsValidationError</MudAlert>
                                                            }
                                                            else
                                                            {
                                                                @foreach (var definitionKey in UnobservedDefinitionKeys)
                                                                {
                                                                    <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Dense="true">@ValidationDefinitionName(definitionKey): @L["Validation:NoObserved"]</MudAlert>
                                                                }
                                                                @if (_optionsValidationReports.Count == 0 && !UnobservedDefinitionKeys.Any())
                                                                {
                                                                    <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Dense="true">@L["Validation:NoObserved"]</MudAlert>
                                                                }
                                                                @foreach (var attempt in _optionsValidationReports)
                                                                {
                                                                    <ConfigurationValidationReportView Title="@ValidationDefinitionName(attempt.DefinitionKey)"
                                                                       Coverage="@attempt.Coverage" Scope="@attempt.Scope"
                                                                       ValidationRevision="@attempt.ValidationRevision" IsValid="@attempt.IsValid"
                                                                       IsSchemaValid="@attempt.IsSchemaValid"
                                                                       Issues="@attempt.Issues.Select(issue => ConfigurationValidationPresentation.FromRuntime(issue, actualOptions: true)).ToArray()"
                                                                       JumpRequested="JumpToRuntimeValidationIssueAsync">
                                                                        <MudText Typo="Typo.caption">@L["Validation:ObservedAt", attempt.AttemptedAt.LocalDateTime]</MudText>
                                                                        <MudText Typo="Typo.caption">@L["Validation:Attempt", attempt.AttemptId]</MudText>
                                                                        <MudText Typo="Typo.caption">@(string.IsNullOrEmpty(attempt.OptionsName) ? L["Validation:DefaultName"].Value : attempt.OptionsName)</MudText>
                                                                    </ConfigurationValidationReportView>
                                                                }
                                                            }
                                                        </MudStack>
                                                    </MudTabPanel>
                                                </MudTabs>
                                            }
                                        </MudStack>
                                    </MudPaper>
                                </div>
                            </MudPopover>
                        }
                    </span>
                }
                <MudOverlay Visible="@_runtimeValidationPopoverOpen"
                            AutoClose="true"
                            OnClosed="CloseRuntimeValidationPopover"
                            LockScroll="false"
                            Modal="false" />
            }
            <ConfigurationReloadStatusButton @ref="_reloadStatusButton"
                                             Reloaded="OnRuntimeConfigurationReloadedAsync" />
        </TitleAccessory>
        <Actions>
            <div class="configuration-state-actions">
                <MudTooltip Text="@CatalogOperationTooltip("Common:Actions:Import")">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@MoIcons.FileUpload"
                               Disabled="@(!CanUseCatalogOperations)"
                               OnClick="OpenImportDialog">
                        @L["Common:Actions:Import"]
                    </MudButton>
                </MudTooltip>
                <MudTooltip Text="@CatalogOperationTooltip("Common:Actions:Export")">
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@MoIcons.Download"
                               Disabled="@(!CanUseCatalogOperations)"
                               OnClick="() => OpenExportDialog(null, null)">
                        @L["Common:Actions:Export"]
                    </MudButton>
                </MudTooltip>
                <MudTooltip Text="@L["Common:Actions:Refresh"]">
                    <MudIconButton Icon="@MoIcons.Refresh"
                                   Variant="Variant.Outlined"
                                   OnClick="LoadDefinitionsAsync"
                                   aria-label="@L["Common:Actions:Refresh"]" />
                </MudTooltip>
            </div>
        </Actions>
    </ConfigurationPageHeader>

            <ConfigurationWorkbenchNavigation ActiveRoute="@ConfigurationUiRoutes.STATE_ROUTE" />

            @if (_metadataStoreDiagnostic is not null)
            {
                <ConfigurationMetadataStoreDiagnosticAlert Diagnostic="@_metadataStoreDiagnostic" />
            }

            @if (_runtimeValidationReport is { IsValid: false })
            {
                <div class="configuration-runtime-validation-banner">
                    <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning"
                              Variant="Variant.Outlined"
                              Class="configuration-runtime-validation-banner-alert">
                        <div class="configuration-runtime-validation-banner-content">
                            <div class="configuration-runtime-validation-banner-message">
                                <MudText Typo="Typo.subtitle2">@L["State:RuntimeValidation:WarningTitle"]</MudText>
                                <MudText Typo="Typo.body2">
                                    @(_runtimeValidationReport.Coverage == ConfigurationValidationCoverage.Complete
                                        ? L["State:RuntimeValidation:WarningMessage", RuntimeValidationIssueCount, RuntimeValidationCountsByDefinition.Count].Value
                                        : RuntimeValidationSummary)
                                </MudText>
                            </div>
                            <div class="configuration-runtime-validation-banner-action">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Warning"
                                           Size="Size.Small"
                                           StartIcon="@MoIcons.Eye"
                                           OnClick="OpenRuntimeValidationPopover">
                                    @L["State:RuntimeValidation:ViewIssues"]
                                </MudButton>
                            </div>
                        </div>
                    </MudAlert>
                </div>
            }

            @if (_loadingDefinitions)
            {
                <MudPaper Outlined="true" Class="pa-6 configuration-loading">
                    <MudProgressCircular Indeterminate="true" />
                    <MudText>@L["Common:States:Loading"]</MudText>
                </MudPaper>
            }
            else
            {
                <div class="configuration-state-grid">
                    <aside class="configuration-state-catalog" aria-label="@L["Workbench:Catalog"]">
                        <ConfigurationDefinitionList Definitions="@_definitions"
                                                     SelectedDefinition="@_selectedSummary"
                                                     SelectedDefinitionChanged="SelectDefinitionAsync"
                                                     PurgeRequested="OpenDefinitionPurgeAsync"
                                                     LifecycleFilter="@_lifecycleFilter"
                                                     LifecycleFilterChanged="OnLifecycleFilterChangedAsync"
                                                     NodeSearchMatches="@NodeSearchMatches"
                                                     NodeSearchMatchSelected="SelectSearchMatchAsync"
                                                     SearchText="@_searchText"
                                                     SearchTextChanged="OnSearchChanged"
                                                     PendingCountsByDefinition="@PendingCountsByDefinition"
                                                     RuntimeValidationCountsByDefinition="@RuntimeValidationCountsByDefinition"
                                                     PendingCount="@_pendingCount"
                                                     ValidationIssueCount="@_validationIssueCount"
                                                     RuntimeValidationIssueCount="@RuntimeValidationIssueCount"
                                                     CanSaveGroup="@CanSavePendingGroup"
                                                     SaveGroup="OpenSaveGroupDialog"
                                                     UndoAll="UndoAll" />
                    </aside>

                    <section class="configuration-state-editor" aria-label="@L["Workbench:Editor"]">
                        @if (_selectedDefinition is null)
                        {
                            @if (_definitions.Count == 0)
                            {
                                <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["State:Definitions:Empty"]</MudAlert>
                            }
                            else if (!_definitions.Any(static definition => definition.CanManage))
                            {
                                <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning">@L["State:Definitions:NoAvailableDefinitions"]</MudAlert>
                            }
                            else if (!_definitions.Any(definition =>
                                         definition.CanManage && _lifecycleFilter.Includes(definition.LifecycleState)))
                            {
                                <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["State:Definitions:NoMatches"]</MudAlert>
                            }
                            else
                            {
                                <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["State:Definitions:SelectPrompt"]</MudAlert>
                            }
                        }
                        else
                        {
                            <section class="configuration-definition-shell">
                                <div class="configuration-definition-content">
                                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                        <MudStack Spacing="0">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <h2 class="configuration-definition-name">@_selectedDefinition.DisplayName</h2>
                                                @if (_selectedDefinition.Kind == ConfigurationKind.Startup)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@L["Startup:Kind"]</MudChip>
                                                }
                                            </MudStack>
                                            <code class="configuration-definition-key">@_selectedDefinition.DefinitionKey</code>
                                            @if (!string.IsNullOrWhiteSpace(_selectedDefinition.Description))
                                            {
                                                <p class="configuration-definition-description">@_selectedDefinition.Description</p>
                                            }
                                        </MudStack>
                                        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1" Class="configuration-definition-meta-actions">
                                            @if (!string.IsNullOrWhiteSpace(_selectedDefinition.Category))
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_selectedDefinition.Category</MudChip>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(_selectedDefinition.FromProject))
                                            {
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@_selectedDefinition.FromProject</MudChip>
                                            }
                                            @if (_selectedDefinition.Origin == ConfigurationDefinitionOrigin.PublishedMetadata)
                                            {
                                                <MudTooltip Text="@L["State:Definitions:PublishedMetadataTooltip"]">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                        @L["State:Definitions:PublishedMetadata"]
                                                    </MudChip>
                                                </MudTooltip>
                                            }
                                            @if (IsSelectedDefinitionRetired)
                                            {
                                                <MudTooltip Text="@L["State:Definitions:RetiredTooltip"]">
                                                    <MudChip T="string"
                                                             Size="Size.Small"
                                                             Color="Color.Warning"
                                                             Variant="Variant.Filled"
                                                             Icon="@MoIcons.Package">
                                                        @L["State:Definitions:Retired"]
                                                    </MudChip>
                                                </MudTooltip>
                                            }
                                            @if (_selectedDefinition.Kind != ConfigurationKind.Startup)
                                            {
                                                <ConfigurationSchemaMetadataChip SchemaVersion="@_selectedDefinition.SchemaVersion"
                                                                                 DefinitionRevision="@_selectedDefinition.DefinitionRevision"
                                                                                 SchemaHash="@_selectedDefinition.SchemaHash"
                                                                                 ValidationContract="@_selectedDefinition.ValidationContract"
                                                                                 OnClick="() => OpenSelectedDefinitionPublicationAsync(ConfigurationDefinitionPublicationTab.RevisionHistory)" />
                                                <MudTooltip Text="@L["State:Definitions:ReloadContributorsTooltip", ReloadBehaviorLabel(_selectedDefinition.ReloadBehavior)]">
                                                    <MudChip T="string"
                                                             Size="Size.Small"
                                                             Color="@ReloadBehaviorColor(_selectedDefinition.ReloadBehavior)"
                                                             Variant="Variant.Outlined"
                                                             OnClick="() => OpenSelectedDefinitionPublicationAsync(ConfigurationDefinitionPublicationTab.ReloadContributors)">
                                                        @ReloadBehaviorLabel(_selectedDefinition.ReloadBehavior)
                                                    </MudChip>
                                                </MudTooltip>
                                            }
                                            @if (CanMutateSelectedDefinition)
                                            {
                                                <MudTooltip Text="@L["Common:Actions:EditJson"]">
                                                    <MudIconButton Icon="@MoIcons.Braces"
                                                                   Size="Size.Small"
                                                                   Variant="Variant.Outlined"
                                                                   aria-label="@L["Common:Actions:EditJson"]"
                                                                   OnClick="OpenSelectedDefinitionJsonEditAsync" />
                                                </MudTooltip>
                                            }
                                            @if (_selectedDefinition.Kind != ConfigurationKind.Startup)
                                            {
                                                <MudTooltip Text="@L["History:Actions:ViewDefinitionHistory"]">
                                                    <MudIconButton Icon="@MoIcons.History"
                                                                   Size="Size.Small"
                                                                   Variant="Variant.Outlined"
                                                                   aria-label="@L["History:Actions:ViewDefinitionHistory"]"
                                                                       OnClick="OpenSelectedDefinitionHistoryAsync" />
                                                </MudTooltip>
                                            }
                                            @if (CanMutateSelectedDefinition)
                                            {
                                                <MudTooltip Text="@L["ImportExport:Export:DefinitionAction"]">
                                                    <MudIconButton Icon="@MoIcons.Download"
                                                                   Size="Size.Small"
                                                                   Variant="Variant.Outlined"
                                                                   aria-label="@L["ImportExport:Export:DefinitionAction"]"
                                                                   OnClick="() => OpenExportDialog(_selectedDefinition.DefinitionKey, _selectedDefinition.DisplayName)" />
                                                </MudTooltip>
                                            }
                                            @if (CanInspectSelectedDefinitionSources)
                                            {
                                                <MudTooltip Text="@L["Sources:Definition:Title"]">
                                                    <MudIconButton Icon="@MoIcons.Workflow"
                                                                   Size="Size.Small"
                                                                   Variant="Variant.Outlined"
                                                                   aria-label="@L["Sources:Definition:Title"]"
                                                                   OnClick="OpenDefinitionSourcesAsync" />
                                                </MudTooltip>
                                            }
                                            @if (IsSelectedDefinitionRetired)
                                            {
                                                <MudTooltip Text="@L["DefinitionPurge:Actions:Preview"]">
                                                    <MudIconButton Icon="@MoIcons.Delete"
                                                                   Size="Size.Small"
                                                                   Color="Color.Error"
                                                                   Variant="Variant.Outlined"
                                                                   aria-label="@L["DefinitionPurge:Actions:PreviewAria", _selectedDefinition.DisplayName]"
                                                                   OnClick="OpenSelectedDefinitionPurgeAsync" />
                                                </MudTooltip>
                                            }
                                        </MudStack>
                                    </MudStack>

                                    @if (_selectedDefinition.Kind == ConfigurationKind.Startup)
                                    {
                                        <ConfigurationStartupStatus Candidate="@_startupCandidate" />
                                    }

                                    @if (IsSelectedDefinitionRetired)
                                    {
                                        <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning" Variant="Variant.Outlined">
                                            @L["State:Definitions:RetiredReadOnly"]
                                        </MudAlert>
                                    }

                                    @if (_loadingDefinition)
                                    {
                                        <MudProgressLinear Indeterminate="true" />
                                    }
                                    else
                                    {
                                        <nav class="configuration-section-navigation" aria-label="@L["State:Sections:Title"]">
                                            <span class="configuration-section-label">@L["State:Sections:Title"]</span>
                                            <div class="configuration-section-list">
                                                @foreach (var sectionItem in SectionItems)
                                                {
                                                    var isSelectedSection = IsSelectedNode(sectionItem.Node);
                                                    <MudTooltip Text="@sectionItem.Description">
                                                        <MudButton Variant="Variant.Text"
                                                                   Color="@(isSelectedSection ? Color.Primary : Color.Default)"
                                                                   StartIcon="@sectionItem.Icon"
                                                                   Class="@(isSelectedSection ? "configuration-section-button is-selected" : "configuration-section-button")"
                                                                   aria-pressed="@isSelectedSection"
                                                                   OnClick="() => OnSelectedNodeChanged(sectionItem.Node)">
                                                            <span class="configuration-section-content">
                                                                <span class="configuration-section-title">
                                                                    <MudHighlighter Text="@sectionItem.Title" HighlightedTexts="@SearchTerms" />
                                                                    @if (sectionItem.ScalarCount > 0)
                                                                    {
                                                                        <span class="configuration-section-count" title="@L["Workbench:ScalarFields", sectionItem.ScalarCount]">@sectionItem.ScalarCount</span>
                                                                    }
                                                                </span>
                                                                <span class="configuration-section-path">@sectionItem.PathLabel</span>
                                                            </span>
                                                        </MudButton>
                                                    </MudTooltip>
                                                }
                                            </div>
                                        </nav>
                                        <div class="configuration-values-panel">
                                            @foreach (var node in VisibleNodes)
                                            {
                                                <ConfigurationValueRow Definition="@_selectedDefinition"
                                                                       Node="@node"
                                                                       EffectiveValue="@GetEffectiveValue(node)"
                                                                       ExternalEffectiveSource="@GetExternalEffectiveSource(node)"
                                                                       HighlightedPath="@_highlightedPath"
                                                                       ReadOnly="@(!CanMutateSelectedDefinition)"
                                                                       Changed="RefreshPendingCount"
                                                                       CommittedChanged="ReloadSelectedEffectiveValuesAndValidationAsync" />
                                            }
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    </section>
                </div>
            }
            @if (_pendingCount > 0 || _validationIssueCount > 0)
            {
                <section class="configuration-draft-dock" aria-label="@L["Workbench:Pending"]">
                    <div class="configuration-draft-summary">
                        <MoIcon Icon="@MoIcons.NotebookEdit" Style="color:var(--mud-palette-primary)" Size="1.5rem" />
                        <div><strong>@L["Workbench:PendingCount", _pendingCount]</strong><p>@L["Workbench:PendingHelp"]</p></div>
                        @if (_validationIssueCount > 0) { <span class="configuration-draft-errors">@L["Workbench:DraftIssues", _validationIssueCount]</span> }
                    </div>
                    <div class="configuration-draft-actions">
                        <MudButton StartIcon="@MoIcons.Undo" OnClick="UndoAll">@L["State:Actions:UndoAll"]</MudButton>
                        <MudTooltip Text="@(CanSavePendingGroup ? L["Workbench:Review"] : L["State:Footer:SaveBlockedMetadata"])">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.ClipboardCheck" Disabled="@(!CanSavePendingGroup)" OnClick="OpenSaveGroupDialog">@L["Workbench:Review"]</MudButton>
                        </MudTooltip>
                    </div>
                </section>
            }
</div>
