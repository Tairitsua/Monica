@using Monica.Configuration.UI.Localization
@inject IStringLocalizer<ConfigurationUIResource> L

<div class="configuration-definition-list-shell">
    <section class="configuration-definition-list">
        <div class="configuration-catalog-heading"><h2>@L["Workbench:Catalog"]</h2><span>@L["Workbench:DefinitionCount", Definitions.Count]</span></div>
        <div class="configuration-definition-list-content">
            <div class="configuration-definition-list-toolbar">
                <div class="configuration-definition-list-search">
                    <MudTextField T="string"
                                  Value="@SearchText"
                                  ValueChanged="OnSearchChanged"
                                  Placeholder="@L["State:SearchPlaceholder"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@MoIcons.Search" />
                </div>
                <div class="configuration-definition-list-lifecycle-filter">
                    <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="ConfigurationDefinitionLifecycleFilter"
                               Value="@LifecycleFilter"
                               ValueChanged="OnLifecycleFilterChanged"
                               ToStringFunc="LifecycleFilterText"
                               Label="@L["State:Definitions:LifecycleFilter:Label"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem T="ConfigurationDefinitionLifecycleFilter" Value="@ConfigurationDefinitionLifecycleFilter.Active">
                            @L["State:Definitions:LifecycleFilter:Active"]
                        </MudSelectItem>
                        <MudSelectItem T="ConfigurationDefinitionLifecycleFilter" Value="@ConfigurationDefinitionLifecycleFilter.Retired">
                            @L["State:Definitions:LifecycleFilter:Retired"]
                        </MudSelectItem>
                        <MudSelectItem T="ConfigurationDefinitionLifecycleFilter" Value="@ConfigurationDefinitionLifecycleFilter.All">
                            @L["State:Definitions:LifecycleFilter:All"]
                        </MudSelectItem>
                    </MudSelect>
                </div>
                <div class="configuration-definition-list-group-filter">
                    <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="ConfigurationDefinitionGroupMode"
                               Value="@_groupMode"
                               ValueChanged="OnGroupModeChanged"
                               ToStringFunc="GroupModeText"
                               Label="@L["State:Definitions:GroupModeLabel"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense">
                        <MudSelectItem T="ConfigurationDefinitionGroupMode" Value="@ConfigurationDefinitionGroupMode.FromProject">
                            @L["State:Definitions:GroupModeProject"]
                        </MudSelectItem>
                        <MudSelectItem T="ConfigurationDefinitionGroupMode" Value="@ConfigurationDefinitionGroupMode.Category">
                            @L["State:Definitions:GroupModeCategory"]
                        </MudSelectItem>
                    </MudSelect>
                </div>
            </div>

            <div class="configuration-definition-list-scroll">
                @if (Definitions.Count == 0)
                {
                    <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["State:Definitions:Empty"]</MudAlert>
                }
                else if (!FilteredDefinitions.Any())
                {
                    <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["State:Definitions:NoMatches"]</MudAlert>
                }
                else
                {
                    <MudList T="ConfigurationDefinitionSummary" Dense="true">
                        @foreach (var group in GroupedDefinitions)
                        {
                            <MudListSubheader>@group.Key</MudListSubheader>
                            @foreach (var definition in group.OrderBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase))
                            {
                                @if (!definition.CanManage)
                                {
                                    <ConfigurationDefinitionUnavailableItem Definition="@definition"
                                                                            SearchTerms="@SearchTerms"
                                                                            PurgeRequested="@PurgeRequested" />
                                }
                                else
                                {
                                    var matches = GetNodeMatches(definition);
                                    var pendingCount = GetPendingCount(definition);
                                    var runtimeIssueCount = GetRuntimeValidationCount(definition);
                                    <MudListItem T="ConfigurationDefinitionSummary"
                                                 Value="@definition"
                                                 Icon="@DefinitionIcon(definition)"
                                                 aria-current="@(IsSelected(definition) ? "true" : null)"
                                                 Class="@(IsSelected(definition) ? "selected-definition" : null)"
                                                 OnClick="() => SelectedDefinitionChanged.InvokeAsync(definition)">
                                        <MudStack Spacing="0">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="configuration-definition-title">
                                                <MudText Typo="Typo.body2">
                                                    <MudHighlighter Text="@definition.DisplayName" HighlightedTexts="@SearchTerms" />
                                                </MudText>
                                                @if (definition.Kind == ConfigurationKind.Startup)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@L["Startup:Kind"]</MudChip>
                                                }
                                                @if (definition.Origin == ConfigurationDefinitionOrigin.PublishedMetadata)
                                                {
                                                    <MudTooltip Text="@L["State:Definitions:PublishedMetadataTooltip"]">
                                                        <MudChip T="string"
                                                                 Size="Size.Small"
                                                                 Color="Color.Info"
                                                                 Variant="Variant.Outlined">
                                                            @L["State:Definitions:PublishedMetadata"]
                                                        </MudChip>
                                                    </MudTooltip>
                                                }
                                                @if (definition.LifecycleState == ConfigurationDefinitionLifecycleState.Retired)
                                                {
                                                    <MudTooltip Text="@L["State:Definitions:RetiredTooltip"]">
                                                        <MudChip T="string"
                                                                 Size="Size.Small"
                                                                 Color="Color.Warning"
                                                                 Variant="Variant.Filled"
                                                                 Icon="@MoIcons.Package">
                                                            @L["State:Definitions:Retired"]
                                                        </MudChip>
                                                    </MudTooltip>
                                                }
                                                @if (pendingCount > 0)
                                                {
                                                    <MudTooltip Text="@L["State:Footer:PendingCount"]">
                                                        <MudChip T="int"
                                                                 Size="Size.Small"
                                                                 Color="Color.Warning"
                                                                 Variant="Variant.Filled"
                                                                 Class="configuration-definition-pending-count">
                                                            @pendingCount
                                                        </MudChip>
                                                    </MudTooltip>
                                                }
                                                @if (runtimeIssueCount > 0)
                                                {
                                                    <MudTooltip Text="@L["State:RuntimeValidation:DefinitionIssueCount"]">
                                                        <MudChip T="int"
                                                                 Size="Size.Small"
                                                                 Color="Color.Warning"
                                                                 Variant="Variant.Filled"
                                                                 Class="configuration-definition-validation-count">
                                                            @runtimeIssueCount
                                                        </MudChip>
                                                    </MudTooltip>
                                                }
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                <MudHighlighter Text="@GetOptionsTypeName(definition)" HighlightedTexts="@SearchTerms" />
                                            </MudText>
                                        </MudStack>
                                    </MudListItem>
                                            @if (matches.Count > 0)
                                            {
                                                <div class="configuration-node-match-list">
                                                    @foreach (var match in matches.Take(MAX_VISIBLE_NODE_MATCHES))
                                                    {
                                                        <div @onclick:stopPropagation="true">
                                                            <MudButton Variant="Variant.Text"
                                                                       Size="Size.Small"
                                                                       StartIcon="@MoIcons.CornerDownRight"
                                                                       Class="configuration-node-match-button"
                                                                       OnClick="@(() => NodeSearchMatchSelected.InvokeAsync(match))">
                                                                <MudStack Spacing="0" AlignItems="AlignItems.Start" Class="configuration-node-match-text">
                                                                    <MudText Typo="Typo.caption">
                                                                        <MudHighlighter Text="@match.DisplayName" HighlightedTexts="@SearchTerms" />
                                                                    </MudText>
                                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@match.PathLabel</MudText>
                                                                </MudStack>
                                                            </MudButton>
                                                        </div>
                                                    }
                                                    @if (matches.Count > MAX_VISIBLE_NODE_MATCHES)
                                                    {
                                                        <MudChip T="int" Size="Size.Small" Variant="Variant.Outlined">
                                                            +@(matches.Count - MAX_VISIBLE_NODE_MATCHES)
                                                        </MudChip>
                                                    }
                                                </div>
                                            }

                                }
                            }
                        }
                    </MudList>
                }
            </div>

            <div class="configuration-definition-list-footer">
                <MoIcon Icon="@MoIcons.Search" Size="1.25rem" />
                <span>@L["Workbench:CatalogHelp"]</span>
            </div>
        </div>
    </section>
</div>

@code {
    private const int MAX_VISIBLE_NODE_MATCHES = 4;

    private ConfigurationDefinitionGroupMode _groupMode = ConfigurationDefinitionGroupMode.FromProject;
    [Parameter] public IReadOnlyList<ConfigurationDefinitionSummary> Definitions { get; set; } = [];
    [Parameter] public ConfigurationDefinitionSummary? SelectedDefinition { get; set; }
    [Parameter] public EventCallback<ConfigurationDefinitionSummary> SelectedDefinitionChanged { get; set; }
    [Parameter] public EventCallback<ConfigurationDefinitionSummary> PurgeRequested { get; set; }
    [Parameter] public ConfigurationDefinitionLifecycleFilter LifecycleFilter { get; set; } =
        ConfigurationDefinitionLifecycleFilter.Active;
    [Parameter] public EventCallback<ConfigurationDefinitionLifecycleFilter> LifecycleFilterChanged { get; set; }
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<ConfigurationNodeSearchMatch>> NodeSearchMatches { get; set; } =
        new Dictionary<string, IReadOnlyList<ConfigurationNodeSearchMatch>>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public EventCallback<ConfigurationNodeSearchMatch> NodeSearchMatchSelected { get; set; }
    [Parameter] public string SearchText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SearchTextChanged { get; set; }
    [Parameter] public IReadOnlyDictionary<string, int> PendingCountsByDefinition { get; set; } =
        new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public IReadOnlyDictionary<string, int> RuntimeValidationCountsByDefinition { get; set; } =
        new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
    [Parameter] public int PendingCount { get; set; }
    [Parameter] public int ValidationIssueCount { get; set; }
    [Parameter] public int RuntimeValidationIssueCount { get; set; }
    [Parameter] public bool CanSaveGroup { get; set; } = true;
    [Parameter] public EventCallback SaveGroup { get; set; }
    [Parameter] public EventCallback UndoAll { get; set; }

    private IEnumerable<ConfigurationDefinitionSummary> FilteredDefinitions =>
        Definitions
            .Where(MatchesLifecycleFilter)
            .Where(definition =>
                string.IsNullOrWhiteSpace(SearchText)
                || IsDefinitionMatch(definition)
                || GetNodeMatches(definition).Count > 0);

    private IEnumerable<IGrouping<string, ConfigurationDefinitionSummary>> GroupedDefinitions =>
        FilteredDefinitions
            .GroupBy(GetGroupName)
            .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<string> SearchTerms => string.IsNullOrWhiteSpace(SearchText)
        ? []
        : SearchText
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private string GroupModeText(ConfigurationDefinitionGroupMode groupMode) => groupMode switch
    {
        ConfigurationDefinitionGroupMode.FromProject => L["State:Definitions:GroupModeProject"].Value,
        ConfigurationDefinitionGroupMode.Category => L["State:Definitions:GroupModeCategory"].Value,
        _ => L["State:Definitions:GroupModeProject"].Value
    };

    private string LifecycleFilterText(ConfigurationDefinitionLifecycleFilter filter)
    {
        return filter switch
        {
            ConfigurationDefinitionLifecycleFilter.Active => L["State:Definitions:LifecycleFilter:Active"],
            ConfigurationDefinitionLifecycleFilter.Retired => L["State:Definitions:LifecycleFilter:Retired"],
            ConfigurationDefinitionLifecycleFilter.All => L["State:Definitions:LifecycleFilter:All"],
            _ => L["State:Definitions:LifecycleFilter:Active"]
        };
    }

    private bool MatchesLifecycleFilter(ConfigurationDefinitionSummary definition)
    {
        return LifecycleFilter.Includes(definition.LifecycleState);
    }

    private Task OnLifecycleFilterChanged(ConfigurationDefinitionLifecycleFilter filter)
    {
        return LifecycleFilterChanged.InvokeAsync(filter);
    }

    private static string DefinitionIcon(ConfigurationDefinitionSummary definition)
    {
        return definition.LifecycleState == ConfigurationDefinitionLifecycleState.Retired
            ? MoIcons.Package
            : MoIcons.Sliders;
    }

    private bool IsSelected(ConfigurationDefinitionSummary definition)
    {
        return string.Equals(definition.DefinitionKey, SelectedDefinition?.DefinitionKey, StringComparison.OrdinalIgnoreCase);
    }

    private Task OnSearchChanged(string value)
    {
        SearchText = value;
        return SearchTextChanged.InvokeAsync(value);
    }

    private void OnGroupModeChanged(ConfigurationDefinitionGroupMode groupMode)
    {
        _groupMode = groupMode;
    }

    private bool IsDefinitionMatch(ConfigurationDefinitionSummary definition)
    {
        return SearchTerms.Count == 0
               || ContainsAny(definition.DefinitionKey)
               || ContainsAny(definition.DisplayName)
               || ContainsAny(definition.Description)
               || ContainsAny(definition.ClrTypeName)
               || ContainsAny(definition.SectionPath)
               || ContainsAny(definition.SchemaHash)
               || ContainsAny(definition.FromProject)
               || ContainsAny(definition.Category)
               || ContainsAny(LifecycleStateText(definition.LifecycleState))
               || ContainsAny(ConfigurationDefinitionMetadataDiagnosticFormatter.AvailabilityLabel(definition.Availability, L))
               || (definition.MetadataDiagnostic is { } diagnostic
                   && ContainsAny(ConfigurationDefinitionMetadataDiagnosticFormatter.IssueLabel(diagnostic.Kind, L)))
               || (!definition.CanManage
                   && definition.MetadataDiagnostic is null
                   && ContainsAny(L["State:Definitions:MetadataStoreUnavailableForDefinition"].Value))
               || ContainsAny(definition.MetadataDiagnostic?.Message)
               || ContainsAny(definition.MetadataDiagnostic?.ErrorType);
    }

    private string LifecycleStateText(ConfigurationDefinitionLifecycleState lifecycleState)
    {
        return lifecycleState == ConfigurationDefinitionLifecycleState.Retired
            ? L["State:Definitions:Retired"]
            : L["State:Definitions:Active"];
    }

    private string GetGroupName(ConfigurationDefinitionSummary definition)
    {
        var groupName = _groupMode == ConfigurationDefinitionGroupMode.Category
            ? definition.Category
            : definition.FromProject;

        return string.IsNullOrWhiteSpace(groupName)
            ? L["State:Definitions:Ungrouped"].Value
            : groupName;
    }

    private bool ContainsAny(string? value)
    {
        return !string.IsNullOrWhiteSpace(value)
               && SearchTerms.Any(term => value.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private IReadOnlyList<ConfigurationNodeSearchMatch> GetNodeMatches(ConfigurationDefinitionSummary definition)
    {
        return NodeSearchMatches.TryGetValue(definition.DefinitionKey, out var matches) ? matches : [];
    }

    private int GetPendingCount(ConfigurationDefinitionSummary definition)
    {
        return PendingCountsByDefinition.TryGetValue(definition.DefinitionKey, out var count) ? count : 0;
    }

    private int GetRuntimeValidationCount(ConfigurationDefinitionSummary definition)
    {
        return RuntimeValidationCountsByDefinition.TryGetValue(definition.DefinitionKey, out var count) ? count : 0;
    }

    private static string GetOptionsTypeName(ConfigurationDefinitionSummary definition)
    {
        var typeName = definition.ClrTypeName.Split(',', 2)[0];
        var lastSeparator = Math.Max(typeName.LastIndexOf('.'), typeName.LastIndexOf('+'));
        return lastSeparator >= 0 ? typeName[(lastSeparator + 1)..] : typeName;
    }

    private enum ConfigurationDefinitionGroupMode
    {
        FromProject,
        Category
    }

}
