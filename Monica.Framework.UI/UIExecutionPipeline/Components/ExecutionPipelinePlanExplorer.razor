@using Monica.Core.Execution.Models

<div class="execution-pipeline-explorer" data-testid="execution-pipeline-plan-explorer">
    <div class="execution-pipeline-explorer__list">
        <div class="execution-pipeline-explorer__list-content">
            <ExecutionPipelinePlanList Plans="@Plans"
                                       SelectedPlan="@SelectedPlan"
                                       PlanSelected="@PlanSelected" />
        </div>
    </div>
    <section class="execution-pipeline-explorer__detail">
        <ExecutionPipelinePlanDetail Plan="@SelectedPlan" />
    </section>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ExecutionPipelinePlanSnapshot> Plans { get; set; } = [];

    [Parameter]
    public ExecutionPipelinePlanSnapshot? SelectedPlan { get; set; }

    [Parameter]
    public EventCallback<ExecutionPipelinePlanSnapshot> PlanSelected { get; set; }
}
