@using Monica.Repository.Persistence.Services.Support
@using static Monica.Repository.UI.UIRepository.Support.RepositoryPresentation
@inject IStringLocalizer<RepositoryUIResource> L
@inject MoTimeFormatter UiTime

@{
    var state = Workbench.State;
    var activity = state.Activity;
    var db = Context.Connection?.Database;
    var guide = activity?.ProviderGuide ?? RepositoryActivityProviderGuideCatalog.Resolve(Context.ProviderName);
    var postgres = guide.ProviderKind == RepositoryActivityProviderKind.PostgreSql;
    var peers = state.Contexts.Where(context => context.Registration.ContextId != Context.Registration.ContextId && SharesTarget(context, Context)).ToArray();
}
<RepositoryContextPicker Workbench="Workbench" Context="Context" Label="@L["Persistence:ActivityProvenance"]"
                         Note="@($"{L["Persistence:ActivityProvenanceNote"]} {(peers.Length == 0 ? "" : L["Persistence:Peers", string.Join(" / ", peers.Select(peer => peer.Registration.DbContextName))].Value)}")">
    <span class="rp-tag">@L[$"Persistence:Providers:{Provider(Context.ProviderName)}"]</span>
    @if (guide.SourceObject is not null) { <code class="rp-tag">@guide.SourceObject</code> }
    <MudButton Href="@Workbench.Url(("guide", "1"), ("inspectSession", null))" StartIcon="@MoIcons.FileText" Variant="Variant.Outlined" Size="Size.Small">@L["Persistence:GuideButton"]</MudButton>
</RepositoryContextPicker>

@if (state.RetainedActivityError is { } retainedError)
{
    <MoSemanticCallout Severity="MoVisualRole.Warning" Title="@L["Persistence:StaleTitle"]">
        @L["Persistence:ActivityStale", UiTime.Format(state.DetailsCapturedAt)]
        <code class="rp-read-error">@retainedError</code>
    </MoSemanticCallout>
}
@if (activity is null)
{
    <section class="mo-vl-surface">
        <MoContentState Loading="true">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
            <p>@L["Persistence:LoadingActivity"]</p>
        </MoContentState>
    </section>
}
else if (activity.Support != RepositoryActivitySupport.Supported)
{
    var failed = activity.Support == RepositoryActivitySupport.Failed;
    <section class="mo-vl-surface">
        <MoContentState>
            <span class="mo-vl-tile @(failed ? "mo-vl-role--error" : "mo-vl-role--warning")"><MoIcon Icon="@(failed ? MoIcons.Error : MoIcons.Info)" Size="18px" /></span>
            <h2>@L[failed ? "Workbench:Activity:ReadFailed" : "Persistence:ActivityUnsupported"]</h2>
            <p>@L[failed ? "Workbench:Activity:ReadUnavailableDescription" : "Activity:Guide:UnsupportedDescription"]</p>
            @if (failed && activity.Message is not null) { <code class="rp-read-error">@activity.Message</code> }
            <MudButton Href="@Workbench.Url(("guide", "1"), ("inspectSession", null))" StartIcon="@MoIcons.FileText" Variant="Variant.Outlined" Size="Size.Small">@L["Persistence:GuideButton"]</MudButton>
        </MoContentState>
    </section>
}
else
{
    var rows = activity.Rows;
    var summary = activity.Summary ?? RepositoryActivitySummary.Create(rows, db);
    var wait = rows.Where(row => row.Waiting == true).ToArray();
    var idleTx = rows.Where(row => SessionState(row) == "idleTx").ToArray();
    var longActive = rows.Where(IsLongActive).ToArray();
    var attention = rows.Count(row => row.Waiting == true || SessionState(row) == "idleTx" || IsLongActive(row));
    <section class="mo-vl-surface rp-act-sig">
        <RepositoryDecision Label="@L["Persistence:SessionAttention"]" Value="@attention.ToString()"
                            Population="@L["Persistence:SessionPopulation", rows.Count]"
                            Reasons="@(new (string, MoVisualRole, string)[] {
                                (WaitingLabel(postgres, true), MoVisualRole.Error, wait.Length.ToString()),
                                (L["Workbench:Activity:IdleInTransaction"], MoVisualRole.Warning, idleTx.Length.ToString()),
                                (L["Persistence:LongActive"], MoVisualRole.Warning, longActive.Length.ToString()),
                                (L["Persistence:OtherDatabases"], MoVisualRole.Third, (summary.TotalSessions - summary.DatabaseSessions).ToString())
                            })">
            @if (attention == 0)
            {
                <MoRichFinding Template="@L["Persistence:ActivityCalm"]" Values="@(
                    new RenderFragment[] { Mark(rows.Count, MoVisualRole.Info), Mark(summary.DatabaseSessions, MoVisualRole.Success),
                        Mark(db ?? L["Persistence:Unavailable"].Value, MoVisualRole.Neutral) })" />
            }
            else
            {
                @if (wait.FirstOrDefault() is { } waitRow)
                {
                    <MoRichFinding Template="@L[postgres ? "Persistence:LockFinding" : "Persistence:WaitFinding"]"
                        Values="@(new RenderFragment[] { SessionMark(waitRow, MoVisualRole.Error), Mark(wait.Length, MoVisualRole.Error) })" />@(" ")
                }
                @if (idleTx.FirstOrDefault() is { } txRow)
                {
                    <MoRichFinding Template="@L["Persistence:IdleFinding"]"
                        Values="@(new RenderFragment[] { SessionMark(txRow, MoVisualRole.Warning), Mark(idleTx.Length, MoVisualRole.Warning) })" />@(" ")
                }
                <MoRichFinding Template="@L["Persistence:ActivityScopeFinding"]" Values="@(new RenderFragment[] {
                    Mark(longActive.Length, MoVisualRole.Warning), Mark(summary.TotalSessions - summary.DatabaseSessions, MoVisualRole.Third), Mark(db ?? L["Persistence:Unavailable"].Value, MoVisualRole.Info)
                })" />
            }
        </RepositoryDecision>
        <RepositoryFacts Label="@L["Workbench:Activity:DatabaseScope"]" Items="@(new (string, string, string, MoVisualRole)[] {
            (L["Persistence:SelectedActive"], summary.ActiveSessions.ToString(), L["Persistence:ActiveFact", db ?? L["Persistence:Unavailable"].Value], MoVisualRole.Info),
            (L["Workbench:Activity:Idle"], summary.IdleSessions.ToString(), L["Persistence:IdleFact"], MoVisualRole.Neutral),
            (L["Workbench:Activity:IdleInTransaction"], summary.IdleInTransactionSessions.ToString(), L["Persistence:IdleTxFact"], MoVisualRole.Warning),
            (WaitingLabel(postgres, true), summary.WaitingSessions.ToString(), L[postgres ? "Persistence:PgWaitFact" : "Persistence:WaitFact"], MoVisualRole.Error)
        })" />
        <RepositoryActivityRuler Workbench="Workbench" Rows="rows" Database="@db" Postgres="postgres" />
    </section>
    <ActivityRowsTable Workbench="Workbench" Rows="rows" Database="@db" Postgres="postgres" />
}

@if (Workbench.Get("guide") == "1")
{
    <RepositoryActivityGuide Workbench="Workbench" Guide="guide" />
}
else if (Workbench.Get("inspectSession") is { } sessionId && activity is not null)
{
    <RepositorySessionEvidence @key="sessionId" Workbench="Workbench" SessionId="@sessionId" Context="Context"
        Row="activity.Rows.FirstOrDefault(row => row.BackendId == sessionId)" Postgres="postgres" CapturedAt="state.DetailsCapturedAt" />
}

@code {
    [Parameter, EditorRequired] public RepositoryWorkbench Workbench { get; set; } = null!;
    [Parameter, EditorRequired] public RepositoryDbContextSnapshot Context { get; set; } = null!;

    private string WaitingLabel(bool postgres, bool plural) => L[postgres
        ? plural ? "Workbench:Activity:LockWaitCount" : "Workbench:Activity:LockWait" : "Workbench:Activity:Waiting"];
    private static RenderFragment Mark(object value, MoVisualRole role) => @<MoValueMark Role="role">@value</MoValueMark>;
    private RenderFragment SessionMark(RepositoryActivityRow row, MoVisualRole role) => @<MoValueMark Role="role"
        Href="@(row.BackendId is { } id ? Workbench.Url(("inspectSession", id), ("guide", null)) : null)">#@row.BackendId</MoValueMark>;
}
