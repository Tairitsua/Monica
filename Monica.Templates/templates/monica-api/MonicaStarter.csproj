<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <MonicaVersion>1.0.0-rc.15</MonicaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Monica.Core" Version="$(MonicaVersion)" />
    <PackageReference Include="Monica.HealthCheck" Version="$(MonicaVersion)" />
    <PackageReference Include="Monica.OpenTelemetry" Version="$(MonicaVersion)" />
  </ItemGroup>

</Project>
