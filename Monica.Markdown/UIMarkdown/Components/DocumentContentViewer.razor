@using Microsoft.Extensions.Localization
@using Monica.Markdown.Localization
@using Monica.Markdown.Models
@using Monica.Markdown.UIMarkdown.Models
@using Monica.Markdown.UIMarkdown.Support
@using Monica.UI.Shared.Components.Markdown
@inject IStringLocalizer<MarkdownResource> L

<div class="content-container">
    @if (CurrentGroup is { IsValid: false } invalidGroup)
    {
        <div class="center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MoIcon Icon="@MoIcons.Warning"
                         Size="2.25rem"
                         Class="state-icon state-icon-warning" Style="color:var(--mud-palette-warning);" />
                <MudText Typo="Typo.h6" Color="Color.Warning">
                    @L["MarkdownViewer:States:GroupUnavailable"]
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="state-copy">
                    @L["MarkdownViewer:States:GroupUnavailableDescription"]
                </MudText>
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Warning">
                    <MudText Typo="Typo.body2" Class="state-path">
                        @invalidGroup.BasePath
                    </MudText>
                </MudAlert>
            </MudStack>
        </div>
    }
    else if (CurrentGroup is { MultilingualLayoutError: not null } layoutErrorGroup)
    {
        <div class="center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MoIcon Icon="@MoIcons.FolderCheck"
                         Size="2.25rem"
                         Class="state-icon state-icon-warning" Style="color:var(--mud-palette-warning);" />
                <MudText Typo="Typo.h6" Color="Color.Warning">
                    @L["MarkdownViewer:States:MultilingualLayoutInvalid"]
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="state-copy">
                    @L["MarkdownViewer:States:MultilingualLayoutInvalidDescription"]
                </MudText>

                @if (layoutErrorGroup.MultilingualLayoutErrorPaths.Count > 0)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Warning">
                        <MudText Typo="Typo.caption" Class="state-path-list-caption">
                            @L["MarkdownViewer:States:InvalidLanguageLayoutPaths"]
                        </MudText>
                        <MudText Typo="Typo.body2" Class="state-path state-path-list">
                            @BuildMultilingualLayoutPathPreview()
                        </MudText>
                    </MudAlert>
                }
            </MudStack>
        </div>
    }
    else if (IsLoading)
    {
        <div class="center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MudProgressCircular Color="Color.Primary"
                                     Size="Size.Large"
                                     Indeterminate="true" />
                <MudText Typo="Typo.body1" Color="Color.Primary">
                    @L["MarkdownViewer:States:LoadingDocument"]
                </MudText>
            </MudStack>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ContentError))
    {
        <div class="center-state" role="status">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">
                <MudText Typo="Typo.h6">@L["MarkdownViewer:States:ContentFailed"]</MudText>
                <div class="state-path">@ContentError</div>
            </MudAlert>
        </div>
    }
    else if (MissingTranslation is not null)
    {
        <div class="center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MoIcon Icon="@MoIcons.Languages"
                         Size="2.25rem"
                         Class="state-icon state-icon-warning" Style="color:var(--mud-palette-warning);" />
                <MudText Typo="Typo.h6" Color="Color.Warning">
                    @L["MarkdownViewer:States:DocumentLanguageMissing", GetMissingTranslationLanguageLabel()]
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="state-copy">
                    @L["MarkdownViewer:States:DocumentLanguageMissingDescription"]
                </MudText>
            </MudStack>
        </div>
    }
    else if (Document is null)
    {
        <div class="center-state">
            <MudStack AlignItems="AlignItems.Center" Spacing="4">
                <MoIcon Icon="@MoIcons.FileText"
                         Size="2.25rem"
                         Class="state-icon state-icon-muted" Style="color:var(--mud-palette-text-secondary);" />
                <MudText Typo="Typo.h6" Color="Color.Default" Class="state-copy state-copy-muted">
                    @L["MarkdownViewer:States:NoDocumentSelected"]
                </MudText>
            </MudStack>
        </div>
    }
    else
    {
                <div class="content-breadcrumb-bar">
                    @if (_breadcrumbs.Count > 0)
                    {
                        <MudBreadcrumbs Items="_breadcrumbs" Class="content-breadcrumbs">
                            <ItemTemplate Context="item">
                                @if (ShouldRenderBreadcrumbLink(item))
                                {
                                    <a href="@item.Href">
                                        @if (!string.IsNullOrWhiteSpace(item.Icon))
                                        {
                                            <MoIcon Icon="@item.Icon" Size="1.25rem" />
                                        }

                                        @item.Text
                                    </a>
                                }
                                else
                                {
                                    <span class="content-breadcrumb-label">
                                        @if (!string.IsNullOrWhiteSpace(item.Icon))
                                        {
                                            <MoIcon Icon="@item.Icon" Size="1.25rem" />
                                        }

                                        @item.Text
                                    </span>
                                }
                            </ItemTemplate>
                        </MudBreadcrumbs>
                    }
                </div>
        <div class="content-scroll" data-markdown-scroll-root="true">
            <div class="content-body" data-markdown-content-root="true"
                 data-markdown-group="@Document.GroupKey"
                 data-markdown-document="@Document.RelativePath"
                 data-markdown-culture="@Document.Culture">
                <header class="article-heading">


                <h1 class="doc-title" data-markdown-document-heading="true" tabindex="-1">@Document.Title</h1>

                <DocumentMetadataPanel Document="Document" />
                </header>

                <div class="markdown-body" data-markdown-body="true">
                    @if (string.IsNullOrWhiteSpace(_strippedContent))
                    {
                        <p class="empty-document">@L["MarkdownViewer:States:EmptyDocument"]</p>
                    }
                    else
                    {
                        <MoMarkdown @key="(DocumentIdentity, _strippedContent)"
                                    Value="@_strippedContent"
                                    ScopeKey="@Document.GroupKey"
                                    DocumentRelativePath="@Document.RelativePath"
                                    DocumentCulture="@Document.Culture"
                                    HasTableOfContents="false"
                                    HeadingsChanged="OnHeadingsChanged" />
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public MarkdownDocumentGroup? CurrentGroup { get; set; }

    [Parameter]
    public MarkdownDocument? Document { get; set; }

    [Parameter]
    public string? Content { get; set; }

    [Parameter]
    public string? CurrentAnchorId { get; set; }

    [Parameter]
    public string? CurrentCulture { get; set; }

    [Parameter]
    public MarkdownDocumentLanguage? CurrentLanguage { get; set; }

    [Parameter]
    public IReadOnlyList<MarkdownDocumentLanguage> Languages { get; set; } = [];

    [Parameter]
    public MarkdownMissingTranslationState? MissingTranslation { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Gets or sets the page-owned content load error. Defaults to null.
    /// A nonempty error replaces the article after loading completes; this component does not reload the source.
    /// </summary>
    [Parameter]
    public string? ContentError { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<MoMarkdownHeading>> HeadingsChanged { get; set; }

    private List<BreadcrumbItem> _breadcrumbs = [];
    private IReadOnlyList<MoMarkdownHeading> _headings = [];
    private string? _strippedContent;
    private (string? Group, string? Path, string? Culture) _lastDocumentIdentity;
    private (string? Group, string? Path, string? Culture) DocumentIdentity =>
        (Document?.GroupKey ?? CurrentGroup?.Key, Document?.RelativePath, Document?.Culture ?? CurrentCulture);
    private string? _lastStrippedContent;

    protected override async Task OnParametersSetAsync()
    {
        _strippedContent = RewriteHtmlDocumentLinks(StripFrontMatterAndLeadingTitle(Content));
        var headingsChanged = ResetHeadingsIfDocumentChanged();
        BuildBreadcrumbs();

        if (headingsChanged)
        {
            await HeadingsChanged.InvokeAsync(_headings);
        }
    }

    private void BuildBreadcrumbs()
    {
        _breadcrumbs = [];

        var currentGroup = CurrentGroup;
        if (!string.IsNullOrWhiteSpace(currentGroup?.Title))
        {
            var groupHref = string.IsNullOrWhiteSpace(currentGroup.Key)
                ? null
                : new MarkdownViewerLocation(currentGroup.Key, Culture: CurrentCulture).ToRelativeUri();

            _breadcrumbs.Add(CreateBreadcrumbItem(currentGroup.Title, groupHref, disabled: Document is null));
        }

        if (Document is null)
        {
            return;
        }

        var segments = Document.NavigationRelativePath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        for (var i = 0; i < segments.Length - 1; i++)
        {
            _breadcrumbs.Add(CreateBreadcrumbItem(segments[i]));
        }

        var headingTrail = ResolveHeadingTrail();
        _breadcrumbs.Add(CreateBreadcrumbItem(
            Document.Title,
            BuildDocumentHref(),
            disabled: headingTrail.Count == 0));

        foreach (var heading in headingTrail)
        {
            _breadcrumbs.Add(CreateBreadcrumbItem(
                heading.Title,
                BuildDocumentHref(heading.Id),
                disabled: string.Equals(heading.Id, CurrentAnchorId, StringComparison.Ordinal)));
        }
    }

    private static string? StripFrontMatterAndLeadingTitle(string? content)
    {
        return StripLeadingTitle(StripFrontMatter(content));
    }

    private static string? StripFrontMatter(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return content;
        }

        var span = content.AsSpan().TrimStart();
        if (!span.StartsWith("---"))
        {
            return content;
        }

        var firstLineEnd = span.IndexOfAny('\r', '\n');
        if (firstLineEnd < 0)
        {
            return content;
        }

        var afterFirstLine = firstLineEnd;
        while (afterFirstLine < span.Length && (span[afterFirstLine] is '\r' or '\n'))
        {
            afterFirstLine++;
        }

        var remaining = span[afterFirstLine..];
        var closingIndex = FindFrontMatterClosingDelimiter(remaining);
        if (closingIndex < 0)
        {
            return content;
        }

        var afterClosing = closingIndex;
        while (afterClosing < remaining.Length && remaining[afterClosing] is not '\r' and not '\n')
        {
            afterClosing++;
        }

        while (afterClosing < remaining.Length && (remaining[afterClosing] is '\r' or '\n'))
        {
            afterClosing++;
        }

        return remaining[afterClosing..].ToString();
    }

    private static int FindFrontMatterClosingDelimiter(ReadOnlySpan<char> content)
    {
        var position = 0;
        while (position < content.Length)
        {
            var lineStart = position;
            var lineLength = content[position..].IndexOfAny('\r', '\n');
            if (lineLength < 0)
            {
                lineLength = content.Length - position;
            }

            var line = content.Slice(position, lineLength).Trim();
            if (line is "---" or "...")
            {
                return lineStart;
            }

            position += lineLength;
            while (position < content.Length && (content[position] is '\r' or '\n'))
            {
                position++;
            }
        }

        return -1;
    }

    private static string? StripLeadingTitle(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return content;
        }

        var trimmed = content.TrimStart();
        if (!trimmed.StartsWith("# "))
        {
            return content;
        }

        var newlineIndex = trimmed.IndexOf('\n');
        return newlineIndex >= 0 ? trimmed[(newlineIndex + 1)..].TrimStart() : string.Empty;
    }

    private string? RewriteHtmlDocumentLinks(string? content)
    {
        return MarkdownHtmlDocumentLinkRewriter.Rewrite(
            content,
            Document?.GroupKey,
            Document?.RelativePath,
            Document?.Culture);
    }

    private async Task OnHeadingsChanged(IReadOnlyList<MoMarkdownHeading> headings)
    {
        if (_headings.SequenceEqual(headings))
        {
            return;
        }

        _headings = headings.ToArray();
        BuildBreadcrumbs();
        await HeadingsChanged.InvokeAsync(_headings);
    }

    private bool ResetHeadingsIfDocumentChanged()
    {
        var currentIdentity = DocumentIdentity;

        if (_lastDocumentIdentity == currentIdentity
            && string.Equals(_lastStrippedContent, _strippedContent, StringComparison.Ordinal))
        {
            return false;
        }

        _lastDocumentIdentity = currentIdentity;
        _lastStrippedContent = _strippedContent;
        _headings = [];
        return true;
    }

    private List<MoMarkdownHeading> ResolveHeadingTrail()
    {
        if (string.IsNullOrWhiteSpace(CurrentAnchorId) || _headings.Count == 0)
        {
            return [];
        }

        var trail = new List<MoMarkdownHeading>();
        foreach (var heading in _headings)
        {
            while (trail.Count > 0 && trail[^1].Level >= heading.Level)
            {
                trail.RemoveAt(trail.Count - 1);
            }

            trail.Add(heading);

            if (string.Equals(heading.Id, CurrentAnchorId, StringComparison.Ordinal))
            {
                return trail.ToList();
            }
        }

        return [];
    }

    private string? BuildDocumentHref(string? anchorId = null)
    {
        if (Document is null)
        {
            return null;
        }

        return new MarkdownViewerLocation(
            Document.GroupKey,
            Document.NavigationRelativePath,
            anchorId,
            CurrentCulture).ToRelativeUri();
    }

    private string GetCurrentLanguageLabel()
    {
        if (!string.IsNullOrWhiteSpace(CurrentLanguage?.DisplayName))
        {
            return CurrentLanguage.DisplayName;
        }

        return string.IsNullOrWhiteSpace(CurrentCulture)
            ? L["MarkdownViewer:Toolbar:SwitchLanguage"].Value
            : CurrentCulture;
    }

    private string GetMissingTranslationLanguageLabel()
    {
        if (MissingTranslation is null)
        {
            return GetCurrentLanguageLabel();
        }

        var matchedLanguage = Languages.FirstOrDefault(language =>
            string.Equals(language.Culture, MissingTranslation.TargetCulture, StringComparison.OrdinalIgnoreCase));

        return string.IsNullOrWhiteSpace(matchedLanguage?.DisplayName)
            ? MissingTranslation.TargetCulture
            : matchedLanguage.DisplayName;
    }

    private string BuildMultilingualLayoutPathPreview()
    {
        if (CurrentGroup is null || CurrentGroup.MultilingualLayoutErrorPaths.Count == 0)
        {
            return string.Empty;
        }

        return string.Join(Environment.NewLine, CurrentGroup.MultilingualLayoutErrorPaths);
    }

    private static BreadcrumbItem CreateBreadcrumbItem(
        string text,
        string? href = null,
        bool disabled = false,
        string? icon = null)
    {
        return new BreadcrumbItem(text, href, disabled || string.IsNullOrWhiteSpace(href), icon);
    }

    private static bool ShouldRenderBreadcrumbLink(BreadcrumbItem item) =>
        !item.Disabled && !string.IsNullOrWhiteSpace(item.Href);
}
