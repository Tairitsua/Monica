@using Monica.UI.Shared.Components.Navigation
@inject IStringLocalizer<ConfigurationUIResource> L

<MoWorkbenchNavigation Label="@L["Workbench:Navigation"]">
    <a href="@ConfigurationUiRoutes.STATE_ROUTE" aria-current="@(ActiveRoute == ConfigurationUiRoutes.STATE_ROUTE ? "page" : null)"><MoIcon Icon="@MoIcons.Sliders" Size="1.25rem" /><span>@L["Workbench:State"]</span></a>
    <a href="@ConfigurationUiRoutes.HISTORY_ROUTE" aria-current="@(ActiveRoute == ConfigurationUiRoutes.HISTORY_ROUTE ? "page" : null)"><MoIcon Icon="@MoIcons.History" Size="1.25rem" /><span>@L["Workbench:History"]</span></a>
    <a href="@ConfigurationUiRoutes.VERSIONS_ROUTE" aria-current="@(ActiveRoute == ConfigurationUiRoutes.VERSIONS_ROUTE ? "page" : null)"><MoIcon Icon="@MoIcons.Layers" Size="1.25rem" /><span>@L["Workbench:Versions"]</span></a>
    <a href="@ConfigurationUiRoutes.SOURCES_ROUTE" aria-current="@(ActiveRoute == ConfigurationUiRoutes.SOURCES_ROUTE ? "page" : null)"><MoIcon Icon="@MoIcons.Workflow" Size="1.25rem" /><span>@L["Workbench:Sources"]</span></a>
    <a href="@ConfigurationUiRoutes.STORAGE_ROUTE" aria-current="@(ActiveRoute == ConfigurationUiRoutes.STORAGE_ROUTE ? "page" : null)"><MoIcon Icon="@MoIcons.Database" Size="1.25rem" /><span>@L["Workbench:Storage"]</span></a>
    <a href="@ConfigurationUiRoutes.DEBUG_ROUTE" aria-current="@(ActiveRoute == ConfigurationUiRoutes.DEBUG_ROUTE ? "page" : null)"><MoIcon Icon="@MoIcons.Braces" Size="1.25rem" /><span>@L["Workbench:Debug"]</span></a>
</MoWorkbenchNavigation>

@code {
    /// <summary>Gets or sets the selected Configuration workspace route.</summary>
    [Parameter, EditorRequired] public string ActiveRoute { get; set; } = string.Empty;
}
