@using Monica.UI.Shared.Components.Json
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.DataChannel.Models
@using Monica.DataChannel.Middlewares
@using Monica.DataChannel.Pipeline
@using Monica.DataChannel.UIDataChannel.Support
@inject IStringLocalizer<DataChannelResource> L
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Logging.ILogger<MessageDebuggerDialog> Logger
@implements IAsyncDisposable

<MudDialog>
    <DialogContent>
        <div class="debugger-console">
            <header class="debugger-identity">
                <span>@L["Debugger:Eyebrow"]</span>
                <h2>@ChannelId</h2>
                <p>@L["Debugger:CaptureScope"]</p>
            </header>
            @if (_readError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">@L["Debugger:Messages:ReadFailed", _readError]</MudAlert>
            }
            <section class="debugger-controls" aria-label="@L["Debugger:Controls:AriaLabel"]">
                <div class="debugger-controls__query">
                    <MudTextField T="string" Value="_filterKeyword" ValueChanged="SetFilterKeyword" Label="@L["Debugger:Fields:FilterKeyword"]" Placeholder="@L["Debugger:Fields:FilterPlaceholder"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Disabled="_isListening" />
                </div>
                <div class="debugger-controls__capacity">
                    <MudNumericField T="int" Value="_maxQueueSize" ValueChanged="SetCapacity" Label="@L["Debugger:Fields:QueueLength"]" Min="1" Max="1000" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_isListening" />
                </div>
                <MudButton Color="@(_isListening ? Color.Error : Color.Primary)" Variant="@(_isListening ? Variant.Outlined : Variant.Filled)" StartIcon="@(_isListening ? MoIcons.Stop : MoIcons.Play)" OnClick="ToggleListening">@L[_isListening ? "Debugger:Actions:Stop" : "Debugger:Actions:Start"]</MudButton>
                <p>@L["Debugger:SettingsHelp"]</p>
                @if (_settingsDirty)
                {
                    <p class="debugger-draft-help">@L["Debugger:DraftHelp", string.IsNullOrEmpty(_observedKeyword) ? L["Debugger:NoKeyword"].Value : _observedKeyword, _observedCapacity]</p>
                }
            </section>
            <section class="debugger-stream" aria-labelledby="debugger-stream-title">
                <header class="debugger-stream__header">
                    <div>
                        <span class="debugger-state" data-active="@(_isListening ? "true" : "false")">@L[_isListening ? "Debugger:States:Listening" : "Debugger:States:Paused"]</span>
                        <h3 id="debugger-stream-title">@L["Debugger:CapturedMessages"]</h3>
                    </div>
                    <div class="debugger-stream__tools">
                        <span>@L["Debugger:MessageCount", _messages.Count]</span>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@MoIcons.ClearList" OnClick="ClearMessages" aria-disabled="@(_messages.Count == 0 || _isExecutingCommand ? "true" : "false")">@L["Debugger:Actions:Clear"]</MudButton>
                    </div>
                </header>
                @if (_messages.Count == 0)
                {
                    <div class="debugger-empty">
                        <MoIcon Icon="@MoIcons.Inbox" Size="2.25rem" />
                        <h4>@L["Debugger:States:NoMessages"]</h4>
                        <p>@L["Debugger:States:NoMessagesDescription"]</p>
                    </div>
                }
                else
                {
                    <div class="debugger-message-list">
                        @foreach (var message in _messages.OrderByDescending(item => item.Sequence))
                        {
                            <article class="debugger-message" data-selected="@(_selectedMessage?.Sequence == message.Sequence ? "true" : "false")" @key="message.Sequence">
                                <div class="debugger-message__summary">
                                    <span class="debugger-message__source" data-source="@message.Source">@SourceLabel(message.Source)</span>
                                    <code title="@message.MessageType">@message.MessageType</code>
                                    <time>@UiTime.Format(message.Timestamp)</time>
                                    <MudButton Size="Size.Small" Color="Color.Primary" OnClick="() => _selectedMessage = message" aria-label="@L["Debugger:InspectMessage", message.Sequence]">@L["Channel:Actions:Inspect"]</MudButton>
                                </div>
                                <p class="debugger-message__preview">@Preview(message.FormattedContent)</p>
                            </article>
                        }
                    </div>
                }
            </section>
            @if (_selectedMessage is { } selected)
            {
                <section class="debugger-inspector" aria-labelledby="debugger-inspector-title">
                    <header>
                        <div>
                            <span>@L["Debugger:SelectedEvidence", selected.Sequence]</span>
                            <h3 id="debugger-inspector-title">@selected.MessageType</h3>
                            <p>@SourceLabel(selected.Source) · @UiTime.Format(selected.Timestamp)</p>
                        </div>
                        <MudIconButton Icon="@MoIcons.Close" Size="Size.Small" OnClick="() => _selectedMessage = null" aria-label="@L["Debugger:CloseSelection"]" />
                    </header>
                    @if (!_messages.Any(message => message.Sequence == selected.Sequence))
                    {
                        <p class="debugger-detached-note">@L["Debugger:DetachedSelection"]</p>
                    }
                    <MudTabs Elevation="0" Rounded="false" MinimumTabWidth="var(--datachannel-tab-min-width, 160px)" PrevIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight">
                        <MudTabPanel Text="@L["Debugger:Tabs:FormattedContent"]">
                            <div class="debugger-inspector__tab">
                                <h4>@L["Debugger:Tabs:FormattedContent"]</h4>
                                <MoJson Value="@selected.FormattedContent" AllowPlainText="true" />
                            </div>
                        </MudTabPanel>
                        <MudTabPanel Text="@L["Debugger:Tabs:PayloadSnapshot"]">
                            <div class="debugger-inspector__tab">
                                <h4>@L["Debugger:Tabs:PayloadSnapshot"]</h4>
                                <MetadataDisplay Metadata="selected.Payload" />
                            </div>
                        </MudTabPanel>
                        <MudTabPanel Text="@L["Debugger:Tabs:Metadata"]">
                            <div class="debugger-inspector__tab">
                                <h4>@L["Debugger:Tabs:Metadata"]</h4>
                                @if (selected.Metadata.Count == 0)
                                {
                                    <p class="debugger-metadata-empty">@L["Debugger:NoMetadata"]</p>
                                } else {
                                <dl class="debugger-metadata">
                                    @foreach (var entry in selected.Metadata)
                                    {
                                        <div>
                                            <dt>@entry.Key</dt>
                                            <dd>
                                                <MetadataDisplay Metadata="entry.Value" />
                                            </dd>
                                        </div>
                                    }
                                </dl>
                            }
                        </div>
                    </MudTabPanel>
                </MudTabs>
            </section>
        }
        <p class="debugger-lifetime-help">@L["Debugger:CloseHelp"]</p>
    </div>
</DialogContent>
</MudDialog>

@code {
    /// <summary>Gets or sets the borrowed persistent host capture. Closing retires polling and never disposes or stops the middleware.</summary>
    [Parameter, EditorRequired]
    public MessageDebuggerMiddleware Middleware { get; set; } = null!;

    /// <summary>Gets or sets the exact identity of the channel that owns the capture middleware.</summary>
    [Parameter, EditorRequired]
    public string ChannelId { get; set; } = string.Empty;

    private readonly CancellationTokenSource _lifetime = new();
    private readonly object _retirementGate = new();
    private Task? _pollTask;
    private Task? _disposeTask;
    private IReadOnlyList<DebugMessageSnapshot> _messages = [];
    private DebugMessageSnapshot? _selectedMessage;
    private string _filterKeyword = string.Empty;
    private string _observedKeyword = string.Empty;
    private string? _readError;
    private int _maxQueueSize = 100;
    private int _observedCapacity = 100;
    private bool _settingsDirty;
    private bool _isListening;
    private bool _isExecutingCommand;
    private bool _retired;

    protected override void OnInitialized()
    {
        _filterKeyword = Middleware.FilterKeyword;
        _maxQueueSize = Middleware.MaxQueueSize;
        ReadCapture();
        _pollTask = PollAsync(_lifetime.Token);
    }
    private void ReadCapture()
    {
        var active = Middleware.IsActive;
        var keyword = Middleware.FilterKeyword;
        var capacity = Middleware.MaxQueueSize;
        var messages = Middleware.GetDebugMessageSnapshots();
        _isListening = active;
        _observedKeyword = keyword;
        _observedCapacity = capacity;
        if (active || !_settingsDirty)
        {
            _filterKeyword = keyword;
            _maxQueueSize = capacity;
            _settingsDirty = false;
        }
        _messages = messages;
        if (!active) { ReconcileDraft(); }
        _readError = null;
    }
    private void SetFilterKeyword(string keyword)
    {
        if (_retired) { return; }
        if (Middleware.IsActive) { ReadCapture(); return; }
        _filterKeyword = keyword;
        ReconcileDraft();
    }
    private void SetCapacity(int capacity)
    {
        if (_retired) { return; }
        if (Middleware.IsActive) { ReadCapture(); return; }
        _maxQueueSize = capacity;
        ReconcileDraft();
    }
    private void ReconcileDraft() => _settingsDirty =
        !string.Equals(_filterKeyword, _observedKeyword, StringComparison.Ordinal) || _maxQueueSize != _observedCapacity;
    private void ToggleListening()
    {
        if (_retired) { return; }
        var displayedActive = _isListening;
        ExecuteCommand(() =>
        {
            ReadCapture();
            if (displayedActive != _isListening) { return; }
            if (_isListening) { Middleware.IsActive = false; }
            else
            {
                Middleware.FilterKeyword = _filterKeyword;
                Middleware.MaxQueueSize = _maxQueueSize;
                Middleware.IsActive = true;
            }
        });
    }
    private void ClearMessages()
    {
        if (_retired || _isExecutingCommand || _messages.Count == 0) { return; }
        ExecuteCommand(() =>
        {
            ReadCapture();
            if (_messages.Count > 0) { Middleware.ClearDebugMessages(); }
        });
    }
    private void ExecuteCommand(Action command)
    {
        if (_retired || _isExecutingCommand) { return; }
        _isExecutingCommand = true;
        try { command(); ReadCapture(); }
        catch (Exception exception)
        {
            Microsoft.Extensions.Logging.LoggerExtensions.LogError(Logger, exception, "DataChannel debugger command failed for channel {ChannelId}.", ChannelId);
            if (!_retired) { Snackbar.Add(L["Workbench:OperationFailedDetail", exception.Message], Severity.Error); }
        }
        finally { _isExecutingCommand = false; }
    }
    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    if (_retired) { return; }
                    try { ReadCapture(); }
                    catch (Exception exception) { _readError = exception.Message; }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }
    private string SourceLabel(ChannelSide source) => L[source == ChannelSide.Inner ? "Debugger:Sources:Ingress" : "Debugger:Sources:Egress"];
    private string Preview(string content)
    {
        if (string.IsNullOrEmpty(content)) { return L["Debugger:Values:EmptyMessage"]; }
        var singleLine = string.Join(' ', content.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        return singleLine.Length > 160 ? singleLine[..160].TrimEnd() + "…" : singleLine;
    }
    public ValueTask DisposeAsync()
    {
        lock (_retirementGate)
        {
            _retired = true;
            return new ValueTask(_disposeTask ??= RetireAsync());
        }
    }
    private async Task RetireAsync()
    {
        _lifetime.Cancel();
        try { if (_pollTask is { } poll) { await poll; } }
        finally { _lifetime.Dispose(); }
    }
}
