@using Monica.Configuration.UI.Localization
@inject IStringLocalizer<ConfigurationUIResource> L

<MudTooltip Delay="300" Arrow="true" Placement="@Placement">
    <ChildContent>
        @if (OnClick.HasDelegate)
        {
            <MudChip T="string"
                     Size="@Size"
                     Color="@Color"
                     Variant="@Variant"
                     OnClick="HandleClick">
                @ChipLabel
            </MudChip>
        }
        else
        {
            <MudChip T="string"
                     Size="@Size"
                     Color="@Color"
                     Variant="@Variant">
                @ChipLabel
            </MudChip>
        }
    </ChildContent>
    <TooltipContent>
        <div class="configuration-schema-metadata-tooltip">
            <MudStack Spacing="1">
                <MudText Typo="Typo.caption" Class="configuration-schema-metadata-title">
                    @L["State:Definitions:SchemaMetadataTitle"]
                </MudText>
                <MudText Typo="Typo.caption">
                    @L["State:Definitions:SchemaVersionDetail", SchemaVersion]
                </MudText>
                <MudText Typo="Typo.caption">
                    @L["State:Definitions:DefinitionRevisionDetail", DefinitionRevision]
                </MudText>
                <MudText Typo="Typo.caption">@L["State:Definitions:SchemaHashDetail"]</MudText>
                <MudText Typo="Typo.caption" Class="configuration-schema-hash-short">
                    @ShortHash
                </MudText>
                <MudText Typo="Typo.caption" Class="configuration-schema-hash-value">
                    @DisplayHash
                </MudText>
                @if (ValidationContract is not null)
                {
                    <MudText Typo="Typo.caption">@L["Validation:Capability", CapabilityText]</MudText>
                    <MudText Typo="Typo.caption">
                        @(string.IsNullOrWhiteSpace(ValidationContract.Revision)
                            ? L["Validation:RevisionUnavailable"] : L["Validation:Revision", ValidationContract.Revision])
                    </MudText>
                }
            </MudStack>
        </div>
    </TooltipContent>
</MudTooltip>

@code {
    [Parameter] public int SchemaVersion { get; set; }
    [Parameter] public int DefinitionRevision { get; set; }
    [Parameter] public string? SchemaHash { get; set; }
    /// <summary>Gets the owner's executable contract when full definition metadata is available.</summary>
    [Parameter] public ConfigurationValidationContract? ValidationContract { get; set; }
    [Parameter] public bool CompactLabel { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Small;
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Placement Placement { get; set; } = Placement.Bottom;
    [Parameter] public EventCallback OnClick { get; set; }

    private string ChipLabel => CompactLabel
        ? L["State:Definitions:SchemaVersionCompactChip", SchemaVersion]
        : L["State:Definitions:SchemaVersionChip", SchemaVersion, DefinitionRevision];

    private string CapabilityText => ValidationContract?.Capability switch
    {
        ConfigurationValidationCapability.PortableOnly => L["Validation:CapabilityPortableOnly"].Value,
        ConfigurationValidationCapability.ObjectCode => L["Validation:CapabilityObjectCode"].Value,
        _ => L["Validation:CapabilityUnknown"].Value
    };

    private string DisplayHash =>
        string.IsNullOrWhiteSpace(SchemaHash)
            ? L["State:Definitions:SchemaHashMissing"].Value
            : SchemaHash;

    private string ShortHash
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SchemaHash))
            {
                return L["State:Definitions:SchemaHashMissing"].Value;
            }

            var hash = SchemaHash;
            if (hash.StartsWith("sha256:", StringComparison.OrdinalIgnoreCase) && hash.Length > 22)
            {
                return $"{hash[..14]}...{hash[^8..]}";
            }

            return hash.Length > 24 ? $"{hash[..12]}...{hash[^8..]}" : hash;
        }
    }

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }
}
