@attribute [Route(PAGE_URL)]
@implements IAsyncDisposable
@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.UI.Shared.Components
@using Monica.AI.UI.UIRAG.State
@inject IStringLocalizer<AIResource> L

<PageTitle>@L["RAG:Navigation:Manage"]</PageTitle>
<div class="rag-manage-page">
    <KnowledgeRagHeader Title="@L["KnowledgeWorkbench:Indexing"]" Description="@L["KnowledgeWorkbench:IndexingDescription"]" CurrentRoute="@PAGE_URL" />
    <div class="knowledge-workspace">
        @if (!PageState.IsInitialLoading && string.IsNullOrWhiteSpace(PageState.CatalogErrorMessage) && PageState.KnowledgeBases.Count == 0)
        {
            <section class="knowledge-empty"><MoContentState><MoIcon Icon="@MoIcons.ListVideo" Size="1.5rem" /><h2>@L["KnowledgeWorkbench:FirstIndexSources"]</h2><p>@L["KnowledgeWorkbench:FirstIndexSourcesHint"]</p><MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@KnowledgeBaseManagePage.PAGE_URL">@L["KnowledgeWorkbench:ManageSources"]</MudButton></MoContentState></section>
        }
        else
        {
        <div class="knowledge-workspace-grid">
            <KnowledgeBaseCatalog Items="PageState.KnowledgeBases" Selected="PageState.SelectedKnowledgeBase" IsLoading="PageState.IsInitialLoading" LoadingText="@PageState.LoadingPhaseText" ErrorMessage="@PageState.CatalogErrorMessage" IsDisabled="@(!PageState.CanChangeKnowledgeBaseSelection)" SelectionChanged="PageState.SelectKnowledgeBaseAsync" Retry="PageState.InitializeAsync" FocusRequested="FocusDossierAsync" />
            <section class="indexing-dossier" aria-busy="@((PageState.IsInitialLoading || PageState.IsSelectionLoading).ToString().ToLowerInvariant())">
                @if (PageState.IsInitialLoading || PageState.IsSelectionLoading)
                {
                    <div class="knowledge-loading"><MoContentState Loading="true"><p>@PageState.LoadingPhaseText</p><MudProgressLinear Value="PageState.LoadingProgressValue" Color="Color.Primary" /></MoContentState></div>
                }
                else if (PageState.SelectedKnowledgeBase is { } kb)
                {
                    <header class="indexing-identity"><span class="identity-label">@L["KnowledgeWorkbench:Collection"]</span><h2 @ref="_dossierHeading" tabindex="-1">@kb.Name</h2><code>@kb.Id</code>@if (!string.IsNullOrWhiteSpace(kb.Description)) { <p>@kb.Description</p> }<div class="identity-facts"><span>@L["KnowledgeWorkbench:DocumentCount", kb.DocumentCount]</span><span>@L["KnowledgeWorkbench:RecordedChunks", kb.ChunkCount]</span><a href="@KnowledgeBaseManagePage.PAGE_URL">@L["KnowledgeWorkbench:ManageSources"] <MoIcon Icon="@MoIcons.ArrowRight" Size="1.5rem" /></a></div></header>
                    <section class="indexing-setup">
                        <div class="embedding-setup">
                            <div class="setup-heading">
                                <div class="setup-heading-copy"><h3>@L["KnowledgeWorkbench:EmbeddingBinding"]</h3><span>@(RAGManagePageState.HasEmbeddingBinding(kb) ? L["KnowledgeWorkbench:ModelBound"] : L["RAG:RagSupport:DisabledStatus"])</span></div>
                                <div class="setup-actions"><MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@MoIcons.ClipboardCheck" OnClick="PageState.ShowEmbeddingDiagnosticsDialogAsync" Disabled="PageState.HasRagSupportActionInFlight">@L["RAG:EmbeddingDiagnostics:Open"]</MudButton>
                                    @if (!RAGManagePageState.HasEmbeddingBinding(kb)) { <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@MoIcons.Link" OnClick="PageState.EnableOrUpdateRagSupportAsync" Disabled="@(!PageState.CanEnableRagSupport)">@(PageState.IsRagSupportEnableActionInFlight ? L["RAG:RagSupport:Enabling"] : L["RAG:RagSupport:Enable"])</MudButton> }
                                    else { <MudMenu Icon="@MoIcons.MoreHorizontal" Size="Size.Small" AriaLabel="@L["KnowledgeWorkbench:BindingActions"]"><MudMenuItem Icon="@MoIcons.Unlink" IconColor="Color.Error" Disabled="@(!PageState.CanRemoveRagSupport)" OnClick="PageState.RemoveRagSupportAsync">@(PageState.IsRagSupportRemoveActionInFlight ? L["RAG:RagSupport:Removing"] : L["RAG:RagSupport:Remove"])</MudMenuItem></MudMenu> }
                                </div>
                            </div>
                            <EmbeddingModelSelector AvailableModels="PageState.AvailableModels" SelectedModelKey="@PageState.CurrentEmbeddingModelKey" SelectedModelKeyChanged="PageState.ChangeEmbeddingModelAsync" IsDisabled="@(PageState.HasActiveQueueWork || PageState.HasRagSupportActionInFlight)" />
                            @if (RAGManagePageState.HasEmbeddingBinding(kb)) { <p class="binding-hint">@L["KnowledgeWorkbench:ChangingModelHint"]</p> }
                        </div>
                        <div class="vector-evidence" role="status">
                            <h3>@L["KnowledgeWorkbench:VectorEvidence"]</h3>
                            @if (PageState.IsVectorValidationLoading) { <p>@L["KnowledgeWorkbench:Vectors:Checking"]</p><MudProgressLinear Color="Color.Primary" Indeterminate="true" /> }
                            else if (!string.IsNullOrWhiteSpace(PageState.VectorValidationErrorMessage)) { <p class="vector-error">@PageState.VectorValidationErrorMessage</p> }
                            else if (PageState.SelectedKnowledgeBaseVectorValidation is { } validation)
                            {
                                <p class="vector-finding @(validation.HasPersistedIndexMetadata && validation.WasValidated ? (validation.HasValidVectors ? "is-present" : "is-missing") : string.Empty)"><i></i>@(!validation.HasPersistedIndexMetadata ? L["KnowledgeWorkbench:Vectors:NoIndex"] : !validation.WasValidated ? L["KnowledgeWorkbench:Vectors:Unavailable"] : validation.HasValidVectors ? L["KnowledgeWorkbench:Vectors:Present"] : L["KnowledgeWorkbench:Vectors:Missing"])</p>
                                @if (validation.HasPersistedIndexMetadata) { <small>@L["KnowledgeWorkbench:Vectors:Scope", validation.IndexedDocumentCount, validation.IndexedChunkCount]</small> }
                                @if (PageState.ShouldShowMissingVectorWarning) { <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" OnClick="PageState.ReindexSelectedKnowledgeBaseAsync" Disabled="@(!PageState.CanReindexSelectedKnowledgeBase)">@L["KnowledgeWorkbench:QueueAllReindex"]</MudButton> }
                            }
                            else { <p>@L["KnowledgeWorkbench:Vectors:Unavailable"]</p> }
                            <p class="vector-scope-note">@L["KnowledgeWorkbench:Vectors:SampleNote"]</p>
                            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@MoIcons.Database" OnClick="PageState.ShowVectorStoreDiagnosticsDialogAsync" Disabled="PageState.HasRagSupportActionInFlight">@L["RAG:VectorDiagnostics:Open"]</MudButton>
                        </div>
                    </section>
                    <RAGManageDocumentQueueSection PageState="PageState" />
                }
                else { <div class="knowledge-empty"><MoContentState><MoIcon Icon="@MoIcons.ListVideo" Size="1.5rem" /><h2>@L["KnowledgeWorkbench:ChooseIndexCollection"]</h2><p>@L["KnowledgeWorkbench:ChooseIndexCollectionHint"]</p></MoContentState></div> }
            </section>
        </div>
        }
    </div>
</div>
@code {
    private ElementReference _dossierHeading;
    private readonly Monica.AI.UI.Shared.Support.KnowledgeDossierFocus _dossierFocus = new();
    private async Task FocusDossierAsync(Monica.AI.KnowledgeBase.Models.KnowledgeBase selected)
    {
        if (_retired || PageState.IsRetired || PageState.SelectedKnowledgeBase?.Id != selected.Id) return;
        var generation = PageState.SelectionGeneration;
        await InvokeAsync(() =>
        {
            if (_retired || PageState.IsRetired || PageState.SelectionGeneration != generation
                || PageState.SelectedKnowledgeBase?.Id != selected.Id) return;
            _dossierFocus.Request(selected.Id, generation);
            StateHasChanged();
        });
    }
    protected override Task OnAfterRenderAsync(bool firstRender) => _dossierFocus.AfterRenderAsync(
        (id, generation) => !_retired && !PageState.IsRetired && !PageState.IsSelectionLoading
            && PageState.SelectionGeneration == generation && PageState.SelectedKnowledgeBase?.Id == id,
        () => _dossierHeading.FocusAsync().AsTask());
}
