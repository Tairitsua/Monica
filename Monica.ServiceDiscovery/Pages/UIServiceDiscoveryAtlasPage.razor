@namespace Monica.ServiceDiscovery.Pages
@attribute [Route(PAGE_URL)]
@inject NavigationManager Nav

@code {
    public const string PAGE_URL = "/service-discovery-manage/service-map";

    protected override void OnInitialized()
    {
        var destination = Nav.GetUriWithQueryParameter("view", "atlas");
        var query = Nav.ToAbsoluteUri(destination).Query;
        Nav.NavigateTo("service-discovery-manage" + query, new NavigationOptions { ReplaceHistoryEntry = true });
    }
}
