    private List<ContextMenuItem<ProjectUnitSummary>> BuildContextMenuItems(ProjectUnitSummary unit)
    {
        var builder = ContextMenuBuilder<ProjectUnitSummary>.Create()
            .AddItem(L["ProjectUnitVisualization:ContextMenu:Details"], MoIcons.Info, ShowContextDetailsAsync)
            .AddItem(L["ProjectUnitVisualization:ContextMenu:FocusNode"], MoIcons.Focus, FocusOnNodeAsync)
            .AddItem(L["ProjectUnitVisualization:ContextMenu:FilterByType"], MoIcons.Filter, FilterByTypeAsync);

        if (!string.IsNullOrEmpty(_relatedToNodeId))
        {
            if (_relatedToNodeId == unit.Key)
            {
                builder.AddItem(L["ProjectUnitVisualization:ContextMenu:ClearRelatedFilter"], MoIcons.Close, ClearRelatedFilterAsync);
            }
            else
            {
                builder.AddItem(L["ProjectUnitVisualization:ContextMenu:ShowOtherRelatedNodes"], MoIcons.Workflow, ShowRelatedNodesAsync);
            }
        }
        else
        {
            builder.AddItem(L["ProjectUnitVisualization:ContextMenu:ShowRelatedNodes"], MoIcons.Workflow, ShowRelatedNodesAsync);
        }

        builder
            .AddItem(L["ProjectUnitVisualization:ContextMenu:ClearAllFilters"], MoIcons.ClearList, ClearAllFiltersAsync)
            .AddDivider()
            .AddItem(L["ProjectUnitVisualization:ContextMenu:CopyFullName"], MoIcons.Copy, CopyFullNameAsync);

        return builder.Build();
    }

