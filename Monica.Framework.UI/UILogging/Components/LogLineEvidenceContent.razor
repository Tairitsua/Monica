@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using System.Globalization
@using Monica.UI.Shared.Components.Visual
@using Monica.Framework.UI.UILogging.Models
@using Monica.Framework.UI.UILogging.Support
@inject IStringLocalizer<LoggingResource> L

@if (Evidence is { } evidence)
{
    var line = evidence.Line;
    var workbench = CopyFormattedRequested.HasDelegate;
    <div class="log-line-info-dialog @(workbench ? "is-workspace" : null)" data-source-generation="@evidence.Source?.Generation" data-absolute-line-number="@line.AbsoluteLineNumber">
        @if (!CopyFormattedRequested.HasDelegate) { <p class="log-inspector-note">@L["Workbench:Inspector:Frozen"]</p> }
        <section class="log-inspector-text">
            <div class="log-inspector-text-heading">
                <h3>@L["Workbench:Inspector:RawTitle"]</h3>
                @if (CopyFormattedRequested.HasDelegate)
                {
                    <div class="log-inspector-formats">
                        @foreach (var (format, label) in Formats)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => CopyFormattedRequested.InvokeAsync(format))">@L[label]</MudButton>
                        }
                    </div>
                }
                else if (CopyRawRequested.HasDelegate)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@MoIcons.Copy" OnClick="@(() => CopyRawRequested.InvokeAsync(line.Raw))">@L["Workbench:Inspector:CopyRaw"]</MudButton>
                }
            </div>
            <p class="log-inspector-note">@L["Workbench:Inspector:RawHelp"]</p>
            <pre class="log-inspector-raw" data-field="Raw" tabindex="0" aria-label="@L["Workbench:Inspector:RawTitle"]">@line.Raw</pre>
            @if (line.Raw.Length == 0) { <p class="log-inspector-note">@L["Workbench:Inspector:Empty"]</p> }
        </section>
        @if (line.Header.Length != 0)
        {
            <section class="log-inspector-text"><h3>@L["Workbench:Inspector:MessageTitle"]</h3><pre class="log-inspector-message" data-field="Message">@line.Message</pre></section>
        }
        <section>
            <h3>@L["Workbench:Inspector:ParsedTitle"]</h3>
            @if (line.Header.Length == 0) { <p class="log-inspector-note">@L["Workbench:Inspector:Unparsed"]</p> }
            else
            {
                <dl class="log-inspector-context">
                    <div>
                        <dt>@L[workbench ? "LogChart:ParsedTimestamp" : "Page:Components:LineInfo:Timestamp"]</dt>
                        <dd>
                            @if (line.Timestamp is { } timestamp)
                            {
                                <time data-field="Timestamp" datetime="@timestamp.ToString("O", CultureInfo.InvariantCulture)">@UiTime.Format(timestamp, workbench ? "yyyy-MM-dd HH:mm:ss.fff" : null)</time>
                            }
                            else { @L["Workbench:Inspector:Missing"] }
                        </dd>
                    </div>
                    @if (workbench)
                    {
                        <div><dt>@L["LogChart:RawTimestamp"]</dt><dd><code data-field="RawTimestamp">@line.RawTimestamp</code></dd></div>
                    }
                    <div>
                        <dt>@L[workbench ? "LogChart:ParsedSeverity" : "Page:Components:LineInfo:Severity"]</dt>
                        <dd data-field="Severity">
                            @if (workbench)
                            {
                                <span class="log-inspector-severity mo-vl-status mo-vl-status--pill @LogSeverityStrip.Role(line.Severity).ToCssClass()">
                                    <i class="mo-vl-status-dot @(line.Severity == LogSeverity.Critical ? "is-critical" : null)" aria-hidden="true"></i>
                                    @L["LogChart:SeverityWithToken", L[$"Workbench:Levels:{line.Severity}"], line.LevelText]
                                </span>
                            }
                            else { @(line.LevelText.Length == 0 ? L["Workbench:Viewer:Unknown"].Value : line.LevelText) }
                        </dd>
                    </div>
                    <div><dt>@L["Page:Components:LineInfo:Thread"]</dt><dd data-field="Thread">@(line.Thread.Length == 0 ? L["Workbench:Inspector:Missing"].Value : line.Thread)</dd></div>
                </dl>
            }
        </section>
        <section>
            <h3>@L["Workbench:Inspector:PositionTitle"]</h3>
            <dl class="log-inspector-context">
                <div><dt>@L["Page:Components:LineInfo:AbsoluteLine"]</dt><dd data-field="AbsoluteLineNumber">@Display(line.AbsoluteLineNumber)</dd></div>
                <div><dt>@L["Page:Components:LineInfo:BufferPosition"]</dt><dd data-field="BufferIndex">@Display(line.BufferIndex)</dd></div>
                <div><dt>@L["Page:Components:LineInfo:FilteredPosition"]</dt><dd data-field="FilteredIndex">@Display(line.FilteredIndex)</dd></div>
            </dl>
        </section>
        <section>
            <h3>@L["Workbench:Inspector:Source"]</h3>
            <dl class="log-inspector-context">
                <div><dt>@L["LogChart:RelativeFile"]</dt><dd><code data-field="RelativePath">@(evidence.Source?.RelativePath ?? L["Workbench:Inspector:Missing"].Value)</code></dd></div>
                <div><dt>@L["LogChart:FullPath"]</dt><dd><code data-field="FilePath">@(evidence.Source?.FilePath ?? L["Workbench:Inspector:Missing"].Value)</code></dd></div>
                <div><dt>@L["Workbench:Inspector:Generation"]</dt><dd><code data-field="Generation">@(evidence.Source?.Generation ?? L["Workbench:Inspector:Missing"].Value)</code></dd></div>
                <div><dt>@L["Workbench:Inspector:ViewRead"]</dt><dd><time data-field="ViewReadAt" datetime="@evidence.ViewReadAt?.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)">@(evidence.ViewReadAt is { } viewedAt ? UiTime.Format(viewedAt) : L["Workbench:Inspector:Missing"].Value)</time></dd></div>
                <div><dt>@L["Workbench:Inspector:InspectedAt"]</dt><dd><time data-field="InspectedAt" datetime="@evidence.InspectedAt.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)">@UiTime.Format(evidence.InspectedAt)</time></dd></div>
            </dl>
        </section>
    </div>
}

@code {
    [Parameter, EditorRequired] public LogLineEvidence? Evidence { get; set; }
    [Parameter] public EventCallback<string> CopyRawRequested { get; set; }
    /// <summary>Supplies the workspace's secondary copy formats. Defaults to an empty callback.</summary>
    [Parameter] public EventCallback<LogCopyFormat> CopyFormattedRequested { get; set; }
    private static readonly (LogCopyFormat, string)[] Formats =
        [(LogCopyFormat.MessageOnly, "Design:CopyMessage"), (LogCopyFormat.WithTimestamp, "Design:CopyTimestamp"), (LogCopyFormat.WithLineNumber, "Design:CopyLineNumber")];
    private string Display(long? value) => value?.ToString(CultureInfo.InvariantCulture) ?? L["Workbench:Inspector:Missing"].Value;
}
