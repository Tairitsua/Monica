@using Monica.UI.Shared.Components.Json
@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Executions.Support

@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation

<div class="execution-evidence">
    <div class="execution-evidence__grid execution-evidence__grid--operational">
        <section class="execution-evidence__panel" aria-labelledby="execution-timing-heading">
            <header class="execution-evidence__heading">
                <span><MoIcon Icon="@MoIcons.Clock" Size="1.25rem" /></span>
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" id="execution-timing-heading">
                    @L["ExecutionDetail:Timing"]
                </MudText>
            </header>
            <dl class="execution-evidence__facts">
                <div>
                    <dt>@L["ExecutionDetail:Created"]</dt>
                    <dd><time>@TimePresentation.FormatTimestamp(Execution.CreatedAtUtc)</time></dd>
                </div>
                <div>
                    <dt>@L["ExecutionDetail:Available"]</dt>
                    <dd><time>@TimePresentation.FormatTimestamp(Execution.AvailableAtUtc)</time></dd>
                </div>
                @if (Execution.RecurringOccurrenceUtc is { } recurringOccurrenceUtc)
                {
                    <div>
                        <dt>@L["ExecutionDetail:ScheduledOccurrence"]</dt>
                        <dd><time>@TimePresentation.FormatTimestamp(recurringOccurrenceUtc)</time></dd>
                    </div>
                }
                <div>
                    <dt>@L["ExecutionDetail:Started"]</dt>
                    <dd><time>@TimePresentation.FormatTimestamp(Execution.StartedAtUtc)</time></dd>
                </div>
                <div>
                    <dt>@L["ExecutionDetail:Completed"]</dt>
                    <dd><time>@TimePresentation.FormatTimestamp(Execution.CompletedAtUtc)</time></dd>
                </div>
                <div>
                    <dt>@L["ExecutionDetail:CancellationRequested"]</dt>
                    <dd><time>@TimePresentation.FormatTimestamp(Execution.CancellationRequestedAtUtc)</time></dd>
                </div>
                <div>
                    <dt>@L["ExecutionDetail:Observed"]</dt>
                    <dd><time>@TimePresentation.FormatTimestamp(ObservedAtUtc)</time></dd>
                </div>
            </dl>
        </section>

        <section class="execution-evidence__panel" aria-labelledby="execution-runtime-heading">
            <header class="execution-evidence__heading">
                <span><MoIcon Icon="@MoIcons.Cpu" Size="1.25rem" /></span>
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" id="execution-runtime-heading">
                    @L["ExecutionDetail:Runtime"]
                </MudText>
            </header>
            <dl class="execution-evidence__facts">
                <div>
                    <dt>@L["ExecutionDetail:Worker"]</dt>
                    <dd><code>@(Execution.RunningWorkerInstanceId ?? "—")</code></dd>
                </div>
                <div>
                    <dt>@L["Executions:Evidence:Claims"]</dt>
                    <dd>@Execution.ExecutionAttempt</dd>
                </div>
                <div>
                    <dt>@L["Executions:Evidence:ConsumedFailures"]</dt>
                    <dd>@Execution.RetryAttempt</dd>
                </div>
                <div>
                    <dt>@L["ExecutionDetail:LeaseLosses"]</dt>
                    <dd>@Execution.LeaseLossCount</dd>
                </div>
                <div>
                    <dt>@L["ExecutionDetail:LeaseExpires"]</dt>
                    <dd><time>@TimePresentation.FormatTimestamp(Execution.LeaseExpiresAtUtc)</time></dd>
                </div>
            </dl>
        </section>
    </div>

    <p class="execution-evidence__scope">@L["ExecutionDetail:EvidenceScope"]</p>

    <div class="execution-evidence__grid execution-evidence__grid--contract">
        <section class="execution-evidence__panel" aria-labelledby="execution-policy-heading">
            <header class="execution-evidence__heading">
                <span><MoIcon Icon="@MoIcons.ShieldCheck" Size="1.25rem" /></span>
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" id="execution-policy-heading">
                    @L["ExecutionDetail:PolicySnapshot"]
                </MudText>
            </header>
            <p class="execution-evidence__help">@L["ExecutionDetail:CapturedPolicyNotice"]</p>
            <dl class="execution-evidence__facts">
                <div>
                    <dt>@L["ExecutionDetail:MaxConcurrency"]</dt>
                    <dd>@Execution.Template.MaxConcurrency</dd>
                </div>
                <div>
                    <dt>@L["ExecutionDetail:RetryCount"]</dt>
                    <dd>@Execution.Template.RetryCount</dd>
                </div>
                <div>
                    <dt>@L["ExecutionDetail:Timeout"]</dt>
                    <dd><code>@TimePresentation.FormatDuration(Execution.Template.MaxExecutionTimeout)</code></dd>
                </div>
            </dl>
        </section>

        <section class="execution-evidence__panel" aria-labelledby="execution-identity-heading">
            <header class="execution-evidence__heading">
                <span><MoIcon Icon="@MoIcons.Fingerprint" Size="1.25rem" /></span>
                <MudText Typo="Typo.subtitle1" HtmlTag="h3" id="execution-identity-heading">
                    @L["ExecutionDetail:Identity"]
                </MudText>
            </header>
            <dl class="execution-evidence__facts">
                <div>
                    <dt>@L["ExecutionDetail:Scope"]</dt>
                    <dd><code>@Execution.Template.SchedulerScopeKey</code></dd>
                </div>
                <div>
                    <dt>@L["ExecutionDetail:JobType"]</dt>
                    <dd>@L[$"JobTypes:{Execution.Template.JobType}"]</dd>
                </div>
                <div>
                    <dt>@L["ExecutionDetail:ArgumentsType"]</dt>
                    <dd><code>@(Execution.Template.JobArgsKey ?? "—")</code></dd>
                </div>
                <div>
                    <dt>@L["ExecutionDetail:Owner"]</dt>
                    <dd><code>@Execution.Template.OwnerKey</code></dd>
                </div>
                <div>
                    <dt>@L["ExecutionDetail:Job"]</dt>
                    <dd><code>@Execution.Template.JobKey</code></dd>
                </div>
            </dl>
        </section>
    </div>

    <section class="execution-evidence__panel" aria-labelledby="execution-arguments-heading">
        <header class="execution-evidence__heading">
            <span><MoIcon Icon="@MoIcons.Braces" Size="1.25rem" /></span>
            <MudText Typo="Typo.subtitle1" HtmlTag="h3" id="execution-arguments-heading">
                @L["ExecutionDetail:Arguments"]
            </MudText>
        </header>
        @if (string.IsNullOrWhiteSpace(Execution.JobArgs))
        {
            <div class="execution-evidence__empty">@L["ExecutionDetail:NoArguments"]</div>
        }
        else
        {
            <MoJson Value="@Execution.JobArgs" AllowPlainText="true" />
        }
    </section>
</div>

@code {
    /// <summary>
    /// Gets or sets the durable execution evidence snapshot to render.
    /// </summary>
    [Parameter, EditorRequired]
    public JobExecutionInstance Execution { get; set; } = null!;

    /// <summary>
    /// Gets or sets the UTC observation time used to calculate an active execution's elapsed duration.
    /// </summary>
    [Parameter]
    public DateTimeOffset ObservedAtUtc { get; set; }
}
