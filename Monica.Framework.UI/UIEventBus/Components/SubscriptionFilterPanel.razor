@using Monica.Framework.UI.UIEventBus.Models
@using Monica.EventBus.Models
@using Monica.Framework.UI.UIEventBus.Support
@inject IStringLocalizer<EventBusResource> L

<div class="subscription-filters">
    <div class="subscription-filter-search">
        <MudTextField ClearIcon="@MoIcons.Close" T="string" Value="@Filter?.SearchText" ValueChanged="SearchChanged" Immediate="true"
            Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="@L["Registry:SearchPlaceholder"]"
            aria-label="@L["SubscriptionFilter:Search"]" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" />
        <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="string" Value="@(SelectedProviderId ?? Filter?.SelectedProvider?.UniqueId ?? All)" ValueChanged="ProviderChanged"
            Variant="Variant.Outlined" Margin="Margin.Dense" Label="@L["SubscriptionFilter:Provider"]">
            <MudSelectItem T="string" Value="@All">@L["SubscriptionFilter:Options:All"]</MudSelectItem>
            @if (SelectedProviderId != null && !Providers.Any(provider => provider.UniqueId == SelectedProviderId)) { <MudSelectItem T="string" Value="@SelectedProviderId">@L["Registry:MissingProviderSelection"]</MudSelectItem> }
            @foreach (var provider in Providers)
            {
                <MudSelectItem T="string" Value="@provider.UniqueId">@EventBusPresentation.KeyText(provider.ServiceKey, L) · @L.GetProviderKindText(provider.ProviderType) · @L.GetProviderModeText(provider.IsDistributed)</MudSelectItem>
            }
        </MudSelect>
    </div>
    <div class="subscription-filter-details">
        <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="string" Value="@(Filter?.TopicRuntimeState?.ToString() ?? All)" ValueChanged="RuntimeChanged"
            Variant="Variant.Outlined" Margin="Margin.Dense" Label="@L["Registry:ReportedRuntime"]">
            <MudSelectItem T="string" Value="@All">@L["SubscriptionFilter:Options:All"]</MudSelectItem>
            @foreach (var runtime in Enum.GetValues<TopicSubscriptionRuntimeState>())
            {
                <MudSelectItem T="string" Value="@runtime.ToString()">@L.GetTopicRuntimeStateText(runtime)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="string" Value="@(Filter?.Scope?.ToString() ?? All)" ValueChanged="ScopeChanged"
            Variant="Variant.Outlined" Margin="Margin.Dense" Label="@L["SubscriptionFilter:Scope"]">
            <MudSelectItem T="string" Value="@All">@L["SubscriptionFilter:Options:All"]</MudSelectItem>
            @foreach (var scope in Enum.GetValues<EventSubscriptionScope>())
            {
                <MudSelectItem T="string" Value="@scope.ToString()">@L.GetSubscriptionScopeText(scope)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="string" Value="@(Filter?.IsAutoDiscovered?.ToString() ?? All)" ValueChanged="DiscoveryChanged"
            Variant="Variant.Outlined" Margin="Margin.Dense" Label="@L["SubscriptionFilter:DiscoveryMode"]">
            <MudSelectItem T="string" Value="@All">@L["SubscriptionFilter:Options:All"]</MudSelectItem>
            <MudSelectItem T="string" Value="@bool.TrueString">@L.GetDiscoveryModeText(true)</MudSelectItem>
            <MudSelectItem T="string" Value="@bool.FalseString">@L.GetDiscoveryModeText(false)</MudSelectItem>
        </MudSelect>
        <div class="subscription-exact-key">
            <div class="subscription-exact-key-toggle">
                <MudCheckBox CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="bool" Value="@(Filter?.ServiceKey != null)" ValueChanged="ExactKeyChanged" Dense="true" Label="@L["Registry:ExactKey"]" />
            </div>
            @if (Filter?.ServiceKey != null)
            {
                <MudTextField T="string" Value="@Filter.ServiceKey" ValueChanged="KeyChanged" Immediate="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                    aria-label="@L["Registry:ExactKey"]" Placeholder="@L["Registry:EmptyKeyPlaceholder"]" />
            }
        </div>
    </div>
    <div class="subscription-filter-footer">
        <div class="subscription-state-filters" role="group" aria-label="@L["Registry:Registration"]">
            <span class="subscription-state-filter" data-tone="Primary" data-selected="@(Filter?.State == null ? "true" : "false")">
                <MudButton OnClick="() => StateChanged(null)" aria-pressed="@(Filter?.State == null ? "true" : "false")">@L["Registry:AllRegistrations"] <span class="state-count">@Subscriptions.Count</span></MudButton>
            </span>
            @foreach (var state in Enum.GetValues<EventSubscriptionState>())
            {
                var tone = state switch { EventSubscriptionState.Active => Color.Success, EventSubscriptionState.Pending => Color.Warning, EventSubscriptionState.Disposed => Color.Error, _ => Color.Default };
                <span class="subscription-state-filter" data-tone="@tone" data-selected="@(Filter?.State == state ? "true" : "false")">
                    <MudButton OnClick="() => StateChanged(state)" aria-pressed="@(Filter?.State == state ? "true" : "false")">@L.GetSubscriptionStateText(state) <span class="state-count">@Subscriptions.Count(row => row.State == state)</span></MudButton>
                </span>
            }
        </div>
        @if (Filter?.HasAnyFilter == true)
        {
            <MudButton Size="Size.Small" OnClick="ClearFilter" StartIcon="@MoIcons.FilterOff">@L["SubscriptionFilter:Clear"]</MudButton>
        }
    </div>
</div>

@code {
    private const string All = "__all__";
    [Parameter] public SubscriptionFilter? Filter { get; set; }
    [Parameter] public EventCallback OnFilterChanged { get; set; }
    [Parameter] public string? SelectedProviderId { get; set; }
    [Parameter] public EventCallback<string?> OnProviderSelectionChanged { get; set; }
    [Parameter] public List<EventBusProviderInfo> Providers { get; set; } = [];
    [Parameter] public IReadOnlyList<SubscriptionViewModel> Subscriptions { get; set; } = [];
    private Task SearchChanged(string? value) { if (Filter != null) Filter.SearchText = value; return Notify(); }
    private async Task ProviderChanged(string value) { if (Filter != null) Filter.SelectedProvider = Providers.FirstOrDefault(provider => provider.UniqueId == value); await OnProviderSelectionChanged.InvokeAsync(value == All ? null : value); await Notify(); }
    private Task RuntimeChanged(string value) { if (Filter != null) Filter.TopicRuntimeState = Enum.TryParse<TopicSubscriptionRuntimeState>(value, out var result) ? result : null; return Notify(); }
    private Task ScopeChanged(string value) { if (Filter != null) Filter.Scope = Enum.TryParse<EventSubscriptionScope>(value, out var result) ? result : null; return Notify(); }
    private Task DiscoveryChanged(string value) { if (Filter != null) Filter.IsAutoDiscovered = bool.TryParse(value, out var result) ? result : null; return Notify(); }
    private Task StateChanged(EventSubscriptionState? value) { if (Filter != null) Filter.State = value; return Notify(); }
    private Task ExactKeyChanged(bool value) { if (Filter != null) Filter.ServiceKey = value ? "" : null; return Notify(); }
    private Task KeyChanged(string? value) { if (Filter != null) Filter.ServiceKey = value ?? ""; return Notify(); }
    private async Task ClearFilter() { Filter?.Clear(); await OnProviderSelectionChanged.InvokeAsync(null); await Notify(); }
    private Task Notify() => OnFilterChanged.InvokeAsync();
}
