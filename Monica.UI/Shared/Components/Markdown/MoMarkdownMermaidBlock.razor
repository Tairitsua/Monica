@using Monica.UI.Shell.State
@using Monica.UI.Theming
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject ThemeState ThemeService
@inject IStringLocalizer<SharedResource> L

<div class="mo-markdown-mermaid-block" @ref="_blockRef">
    @if (_renderError is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Error">
            @_renderError
        </MudAlert>
    }
    @if (!_diagramReady && _renderError is null && !string.IsNullOrWhiteSpace(Definition))
    {
        <div class="mo-markdown-mermaid-loading" role="status" data-markdown-search-ignore="true">@L["Markdown:Mermaid:Rendering"]</div>
    }
    <div class="mo-markdown-mermaid-frame">
        <div @ref="_containerRef"
             class="mo-markdown-mermaid-surface @(!_diagramReady ? "is-pending" : null)"
             role="button" tabindex="@(_diagramReady ? "0" : "-1")"
             aria-disabled="@(_diagramReady ? "false" : "true")"
             aria-label="@L["Markdown:Mermaid:Open"]" aria-haspopup="dialog"></div>
        @if (_diagramReady)
        {
            <button type="button" class="mo-markdown-mermaid-expand" data-mo-mermaid-action="open" data-markdown-search-ignore="true"
                    title="@L["Markdown:Mermaid:Open"]" aria-label="@L["Markdown:Mermaid:Open"]">
                <MoIcon Icon="@MoIcons.Maximize" Size="16px" /><span>@L["Markdown:Mermaid:Expand"]</span>
            </button>
        }
    </div>

    <dialog @ref="_dialogRef" class="mo-mermaid-reader" aria-labelledby="@_titleId" aria-describedby="@_hintId" data-markdown-search-ignore="true">
        <header class="mo-mermaid-reader__header">
            <div class="mo-mermaid-reader__identity"><MoIcon Icon="@MoIcons.Maximize" Size="19px" /><span class="mo-mermaid-reader__title" id="@_titleId">@L["Markdown:Mermaid:Title"]</span></div>
            <div class="mo-mermaid-reader__tools" role="group" aria-label="@L["Markdown:Mermaid:Controls"]">
                <button type="button" data-mo-mermaid-action="out" title="@L["Markdown:Mermaid:ZoomOut"]" aria-label="@L["Markdown:Mermaid:ZoomOut"]"><MoIcon Icon="@MoIcons.ZoomOut" Size="18px" /></button>
                <output data-mo-mermaid-zoom aria-label="@L["Markdown:Mermaid:ZoomLevel"]" aria-live="polite">100%</output>
                <button type="button" data-mo-mermaid-action="in" title="@L["Markdown:Mermaid:ZoomIn"]" aria-label="@L["Markdown:Mermaid:ZoomIn"]"><MoIcon Icon="@MoIcons.ZoomIn" Size="18px" /></button>
                <span class="mo-mermaid-reader__separator" aria-hidden="true"></span>
                <button type="button" data-mo-mermaid-action="reset" title="@L["Markdown:Mermaid:Reset"]">100%</button>
                <button type="button" data-mo-mermaid-action="fit" class="mo-mermaid-reader__fit" title="@L["Markdown:Mermaid:FitHint"]"><MoIcon Icon="@MoIcons.Scan" Size="17px" /><span>@L["Markdown:Mermaid:Fit"]</span></button>
                <span class="mo-mermaid-reader__separator" aria-hidden="true"></span>
                <button type="button" data-mo-mermaid-action="close" class="mo-mermaid-reader__close" title="@L["Markdown:Mermaid:Close"]" aria-label="@L["Markdown:Mermaid:Close"]"><MoIcon Icon="@MoIcons.Close" Size="19px" /></button>
            </div>
        </header>
        <div class="mo-mermaid-reader__viewport" data-mo-mermaid-viewport tabindex="0" role="region" aria-label="@L["Markdown:Mermaid:Canvas"]" aria-describedby="@_hintId">
            <div class="mo-mermaid-reader__canvas" data-mo-mermaid-canvas></div>
        </div>
        <footer class="mo-mermaid-reader__footer" id="@_hintId"><MoIcon Icon="@MoIcons.Focus" Size="15px" /><span>@L["Markdown:Mermaid:Hint"]</span></footer>
    </dialog>
</div>

@code {
    /// <summary>The Mermaid source rendered with the current Monica palette. Successful diagrams include an immersive reader.</summary>
    [Parameter, EditorRequired]
    public string Definition { get; set; } = string.Empty;

    private readonly string _titleId = $"mo-mermaid-title-{Guid.NewGuid():N}";
    private readonly string _hintId = $"mo-mermaid-hint-{Guid.NewGuid():N}";
    private ElementReference _blockRef, _containerRef, _dialogRef;
    private Task<IJSObjectReference>? _moduleImport;
    private Task<IJSObjectReference>? _controllerTask;
    private Task _renderTask = Task.CompletedTask;
    private Task _themeChangeTask = Task.CompletedTask;
    private string? _lastDefinition, _renderError;
    private long _requestedVersion;
    private long _renderedVersion = -1;
    private bool _diagramReady, _disposed;

    protected override void OnInitialized() => ThemeService.OnThemeChanged += OnThemeChanged;

    protected override void OnParametersSet()
    {
        if (string.Equals(_lastDefinition, Definition, StringComparison.Ordinal)) return;
        _lastDefinition = Definition;
        RequestDiagram();
    }

    private void RequestDiagram()
    {
        _requestedVersion++;
        _diagramReady = false;
        _renderError = null;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _renderedVersion == _requestedVersion) return Task.CompletedTask;
        _renderTask = RenderPendingAsync(_renderTask);
        return _renderTask;
    }

    private async Task RenderPendingAsync(Task previous)
    {
        await previous;
        while (!_disposed && _renderedVersion != _requestedVersion)
        {
            var version = _requestedVersion;
            var definition = Definition;
            try
            {
                _moduleImport ??= JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Monica.UI/js/mo-markdown-mermaid.js").AsTask();
                IJSObjectReference module;
                try
                {
                    module = await _moduleImport;
                }
                catch
                {
                    // Observe failed imports without retaining a permanently failed retry path.
                    _moduleImport = null;
                    throw;
                }
                if (_disposed) return;
                _controllerTask ??= module.InvokeAsync<IJSObjectReference>("connectReader", _blockRef, _containerRef, _dialogRef).AsTask();
                IJSObjectReference controller;
                try
                {
                    controller = await _controllerTask;
                }
                catch
                {
                    _controllerTask = null;
                    throw;
                }
                if (_disposed) return;
                var rendered = await controller.InvokeAsync<bool>("render", definition, BuildThemePayload());
                if (_disposed) return;
                if (version == _requestedVersion) _diagramReady = rendered;
            }
            catch (Exception exception) when (exception is JSDisconnectedException or TaskCanceledException)
            {
                return;
            }
            catch (Exception exception) when (exception is JSException or InvalidOperationException)
            {
                if (!_disposed && version == _requestedVersion) _renderError = exception.Message;
            }
            if (_disposed) return;
            _renderedVersion = version;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnThemeChanged()
    {
        if (_disposed) return;
        _themeChangeTask = ApplyThemeChangeAsync(_themeChangeTask);
    }

    private async Task ApplyThemeChangeAsync(Task previous)
    {
        await previous;
        if (_disposed) return;
        await InvokeAsync(() =>
        {
            if (_disposed) return;
            RequestDiagram();
            StateHasChanged();
        });
    }

    private MermaidThemePayload BuildThemePayload()
    {
        var palette = ThemeService.IsDarkMode ? ThemeService.CurrentTheme.PaletteDark : ThemeService.CurrentTheme.PaletteLight;
        return new MermaidThemePayload(
            ThemeService.CurrentThemeKind, ThemeService.IsDarkMode,
            palette.Primary.ToString(), palette.Secondary.ToString(), palette.Surface.ToString(),
            palette.BackgroundGray.ToString(), palette.TextPrimary.ToString(), palette.TextSecondary.ToString(),
            palette.Info.ToString(), palette.Success.ToString(), palette.Warning.ToString(), palette.Error.ToString(),
            ThemeService.CurrentTheme.Typography.Default.FontFamily);
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        ThemeService.OnThemeChanged -= OnThemeChanged;
        try
        {
            // Stop producers immediately, including a controller acquired while disposal began.
            // Its pending render checks retirement before it inserts or refreshes any diagram.
            if (_controllerTask is not null)
            {
                var controller = await _controllerTask;
                try
                {
                    await controller.InvokeVoidAsync("dispose");
                }
                finally
                {
                    await controller.DisposeAsync();
                }
            }
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException) { }
        try
        {
            await _themeChangeTask;
            await _renderTask;
        }
        finally
        {
            // The renderer owns DOM removal. Only release the observed module resource here.
            await DisposeModuleAsync();
        }
    }

    private async ValueTask DisposeModuleAsync()
    {
        try
        {
            if (_moduleImport is not null) await (await _moduleImport).DisposeAsync();
        }
        catch (Exception exception) when (exception is JSDisconnectedException or JSException or TaskCanceledException) { }
    }

    private sealed record MermaidThemePayload(
        MonicaThemeKind ThemeKind, bool IsDarkMode, string Primary, string Secondary,
        string Surface, string Background, string TextPrimary, string TextSecondary,
        string Info, string Success, string Warning, string Error, string[]? FontFamily);
}
