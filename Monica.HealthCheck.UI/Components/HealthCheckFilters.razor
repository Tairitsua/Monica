@inject NavigationManager Nav
@inject IStringLocalizer<HealthCheckResource> L
<div class="hc-toolbar">
    <div class="hc-fields">
        <MudTextField T="string" Value="@Session.NameFilter" ValueChanged="@(v => Set("q",v))" Immediate="true" DebounceInterval="150" Placeholder="@L["Design:SearchPlaceholder"]" aria-label="@L["Design:SearchLabel"]" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" Margin="Margin.Dense" Variant="Variant.Outlined" />
        <MudSelect T="string" Value="@Session.TagFilter" ValueChanged="@(v => Set("tag",v))" Label="@L["Filters:TagLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
            @foreach (var tag in Session.AvailableTags) { <MudSelectItem Value="@tag">@tag</MudSelectItem> }
        </MudSelect>
        <MudSelect T="string" Value="@(Session.Sort ?? "severity")" ValueChanged="@(v => Set("sort",v))" Label="@L["Design:SortLabel"]" Margin="Margin.Dense" Variant="Variant.Outlined">
            <MudSelectItem Value="@("severity")">@L["Design:Sorts:Severity"]</MudSelectItem><MudSelectItem Value="@("duration")">@L["Design:Sorts:Duration"]</MudSelectItem><MudSelectItem Value="@("name")">@L["Design:Sorts:Name"]</MudSelectItem>
        </MudSelect>
    </div>
    <div class="hc-facets"><MoFilterChip Label="@L["Filters:AnyStatus"]" Selected="@(Session.StatusFilter is null)" Count="@Session.FacetEntries.Count()" Pill="true" SelectedChanged="@(() => Set("status",null))" />
        @foreach (var status in Enum.GetValues<HealthCheckState>().Reverse()) {
            <MoFilterChip Label="@L.GetStatusText(status)" Selected="@(Session.StatusFilter == status)" Count="@Session.FacetEntries.Count(e => e.Status == status)" Role="@(status == HealthCheckState.Healthy ? MoVisualRole.Success : status == HealthCheckState.Degraded ? MoVisualRole.Warning : MoVisualRole.Error)" ShowDot="true" Pill="true" SelectedChanged="@(() => Set("status",status.ToString()))" /> }
        @if (Session.Probe is not null) { <button class="mo-vl-id-chip" @onclick="@(() => Set("probe",null))">@L[Session.Probe switch { "ready" => "Design:ReadinessLabel", "live" => "Design:LivenessLabel", _ => "Design:AuxiliaryLabel" }] ×</button> }
    </div>
</div>
@code {
    [Parameter, EditorRequired] public HealthCheckPageSession Session { get; set; } = default!;
    private void Set(string name, string? value) => Nav.NavigateTo(Nav.GetUriWithQueryParameter(name,string.IsNullOrWhiteSpace(value) ? null : value),replace:true);
}
