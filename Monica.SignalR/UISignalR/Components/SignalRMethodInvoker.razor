@using Monica.UI.Shared.Components.States
@using System.Text.Json
@using Monica.SignalR.UISignalR.Models
@using Monica.SignalR.UISignalR.Support
@inject SignalRInvocationArgumentParser ArgumentParser
@inject IStringLocalizer<SignalRResource> L

<section class="signalr-method-invoker" aria-label="@L["UISignalR:MethodInvoker:Title"]" aria-busy="@(_isInvoking ? "true" : "false")">
    <header class="signalr-invoker-heading">
        <span>@L["UISignalR:MethodInvoker:Scope"]</span>
        <h2>@L["UISignalR:MethodInvoker:Title"]</h2>
        <p>@L["UISignalR:MethodInvoker:Help"]</p>
    </header>

    @if (HubMethods.Count == 0)
    {
        <div class="signalr-invoker-empty"><MoContentState Compact="true">@L["UISignalR:MethodInvoker:Empty"]</MoContentState></div>
    }
    else
    {
        <div class="signalr-invoker-method">
            <MudSelect T="string" Value="@SelectedMethodName" ValueChanged="ChangeSelectedMethodAsync"
                       Label="@L["UISignalR:MethodInvoker:MethodLabel"]" Variant="Variant.Outlined"
                       Margin="Margin.Dense" Disabled="_isInvoking" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                @foreach (var method in HubMethods)
                {
                    <MudSelectItem Value="@method.Name">@method.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </div>

        @if (SelectedMethod is { } selectedMethod)
        {
            <code class="signalr-invoker-signature">@FormatSignature(selectedMethod)</code>
            @if (selectedMethod.Args.Count > 0)
            {
                <div class="signalr-invoker-parameters">
                    <h3>@L["UISignalR:MethodInvoker:ParametersTitle"]</h3>
                    <p>@L["UISignalR:MethodInvoker:DefaultsHelp"]</p>
                    @foreach (var argument in selectedMethod.Args)
                    {
                        var value = GetParameterValue(argument.Name);
                        var valid = IsParameterValid(value, argument.TypeName);
                        <div class="signalr-invoker-field" @key="(selectedMethod.Name, argument.Name)">
                            <MudTextField T="string" Value="@value"
                                          ValueChanged="@((string newValue) => SetParameterValueAsync(argument.Name, newValue))"
                                          Label="@L["UISignalR:MethodInvoker:ParameterLabel", argument.Name, argument.TypeName]"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                          Disabled="_isInvoking" HelperText="@GetParameterHelperText(argument.TypeName)"
                                          Error="@(!valid)" ErrorText="@(valid ? string.Empty : GetParameterErrorText(argument.TypeName))" />
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="signalr-invoker-no-parameters">@L["UISignalR:MethodInvoker:NoParameters"]</p>
            }
        }

        @if (!IsConnected)
        {
            <p class="signalr-invoker-connect-help">@L["UISignalR:MethodInvoker:ConnectHelp"]</p>
        }
        <div class="signalr-invoker-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Play"
                       OnClick="InvokeMethodAsync" Disabled="@(_isInvoking || !IsConnected || SelectedMethod is null || !AreParametersValid())">
                @L[_isInvoking ? "UISignalR:MethodInvoker:Invoking" : "UISignalR:MethodInvoker:Invoke"]
            </MudButton>
            @if (SelectedMethod?.Args.Count > 0)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ClearParametersAsync" Disabled="_isInvoking">
                    @L["UISignalR:MethodInvoker:ClearParameters"]
                </MudButton>
            }
        </div>
    }
</section>

@code {
    /// <summary>Gets or sets the callable method catalog supplied by the session owner.</summary>
    [Parameter] public List<HubMethodInfo> HubMethods { get; set; } = [];
    /// <summary>Gets or sets whether the browser session can execute a hub invocation.</summary>
    [Parameter] public bool IsConnected { get; set; }
    /// <summary>Gets or sets the selected method name.</summary>
    [Parameter] public string SelectedMethodName { get; set; } = string.Empty;
    /// <summary>Reports a newly selected method to the owning state.</summary>
    [Parameter] public EventCallback<string> SelectedMethodNameChanged { get; set; }
    /// <summary>Gets or sets the shared raw argument draft; clearing or editing retains state-owner ownership.</summary>
    [Parameter] public Dictionary<string, string> MethodParameters { get; set; } = new(StringComparer.Ordinal);
    /// <summary>Requests execution with a snapshot of the method name and raw arguments; conversion uses the registered invocation parser.</summary>
    [Parameter] public EventCallback<(string methodName, List<MethodCallParameter> parameters)> OnInvokeMethod { get; set; }

    private bool _isInvoking;
    private HubMethodInfo? SelectedMethod => HubMethods.FirstOrDefault(method => method.Name == SelectedMethodName);
    private string GetParameterValue(string name) => MethodParameters.GetValueOrDefault(name, string.Empty);
    private static string FormatSignature(HubMethodInfo method) => $"{method.Name}({string.Join(", ", method.Args.Select(argument => $"{argument.TypeName} {argument.Name}"))})";

    private async Task ChangeSelectedMethodAsync(string value)
    {
        if (_isInvoking) return;
        SelectedMethodName = value ?? string.Empty;
        await SelectedMethodNameChanged.InvokeAsync(SelectedMethodName);
    }

    private Task SetParameterValueAsync(string name, string value)
    {
        if (!_isInvoking) MethodParameters[name] = value ?? string.Empty;
        return Task.CompletedTask;
    }

    private Task ClearParametersAsync()
    {
        if (!_isInvoking && SelectedMethod is { } method)
        {
            foreach (var argument in method.Args) MethodParameters[argument.Name] = string.Empty;
        }
        return Task.CompletedTask;
    }

    private bool IsParameterValid(string value, string type)
    {
        try
        {
            _ = ArgumentParser.ConvertValue(value, type);
            return true;
        }
        catch (Exception exception) when (exception is FormatException or OverflowException or JsonException or ArgumentException)
        {
            return false;
        }
    }

    private bool AreParametersValid() => SelectedMethod is { } method
        && method.Args.All(argument => IsParameterValid(GetParameterValue(argument.Name), argument.TypeName));

    private async Task InvokeMethodAsync()
    {
        if (_isInvoking || !IsConnected || SelectedMethod is not { } method || !AreParametersValid()) return;
        var parameters = method.Args.Select(argument => new MethodCallParameter
        {
            Name = argument.Name,
            Type = argument.TypeName,
            Value = GetParameterValue(argument.Name)
        }).ToList();
        _isInvoking = true;
        try { await OnInvokeMethod.InvokeAsync((method.Name, parameters)); }
        finally { _isInvoking = false; }
    }

    private static string NormalizeTypeName(string type) => type.Trim().Replace("System.", string.Empty, StringComparison.Ordinal).ToLowerInvariant();

    private string GetParameterHelperText(string type) => NormalizeTypeName(type) switch
    {
        "string" => L["UISignalR:MethodInvoker:HelperText:String"].Value,
        "int" or "int32" => L["UISignalR:MethodInvoker:HelperText:Int"].Value,
        "long" or "int64" => L["UISignalR:MethodInvoker:HelperText:Long"].Value,
        "double" => L["UISignalR:MethodInvoker:HelperText:Double"].Value,
        "float" or "single" => L["UISignalR:MethodInvoker:HelperText:Float"].Value,
        "bool" or "boolean" => L["UISignalR:MethodInvoker:HelperText:Bool"].Value,
        "datetime" => L["UISignalR:MethodInvoker:HelperText:DateTime"].Value,
        "guid" => L["UISignalR:MethodInvoker:HelperText:Guid"].Value,
        var normalized when normalized.Contains("[]", StringComparison.Ordinal) || normalized.Contains("array", StringComparison.Ordinal) => L["UISignalR:MethodInvoker:HelperText:Array"].Value,
        var normalized when normalized.Contains("list", StringComparison.Ordinal) => L["UISignalR:MethodInvoker:HelperText:List"].Value,
        _ => L["UISignalR:MethodInvoker:HelperText:Complex", type].Value
    };

    private string GetParameterErrorText(string type) => NormalizeTypeName(type) switch
    {
        "int" or "int32" => L["UISignalR:MethodInvoker:ErrorText:Int"].Value,
        "long" or "int64" => L["UISignalR:MethodInvoker:ErrorText:Long"].Value,
        "double" => L["UISignalR:MethodInvoker:ErrorText:Double"].Value,
        "float" or "single" => L["UISignalR:MethodInvoker:ErrorText:Float"].Value,
        "bool" or "boolean" => L["UISignalR:MethodInvoker:ErrorText:Bool"].Value,
        "datetime" => L["UISignalR:MethodInvoker:ErrorText:DateTime"].Value,
        "guid" => L["UISignalR:MethodInvoker:ErrorText:Guid"].Value,
        _ => L["UISignalR:MethodInvoker:ErrorText:Invalid"].Value
    };
}
