@* ============================================================================
   ANTI-PATTERN EXAMPLE: God Page

   This is a fictional example demonstrating what NOT to do.
   Every violation is annotated with ❌ and the correct approach.

   Violations demonstrated:
   1. God Page — everything in one file (~500+ lines @code block)
   2. 20+ private fields — state machine hiding in a page
   3. CancellationTokenSource and Interlocked in @code
   4. 6+ Can*() guard methods
   5. Page calls a *UIService wrapper instead of Facade directly
   6. Duplicated loading skeleton markup
   ============================================================================ *@

@page "/inventory/manage"
@using Monica.UI.Icons
@implements IDisposable
@inject InventoryUIService InventoryService   @* ❌ Should inject InventoryFacade directly *@
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Inventory Management</PageTitle>

<div class="inventory-page">
    @* ❌ Panel 1: Should be extracted to UIInventory/Components/WarehouseListPanel.razor *@
    <div class="warehouse-list-panel">
        <div class="panel-header">
            <MudText Typo="Typo.subtitle1">Warehouses</MudText>
            <MudButton Size="Size.Small" OnClick="@ShowCreateWarehouseDialog">Create</MudButton>
            <MudButton Size="Size.Small" Color="Color.Error"
                       Disabled="@(_selectedWarehouse is null)"
                       OnClick="@DeleteSelectedWarehouse">Delete</MudButton>
        </div>

        @* ❌ Loading skeleton duplicated — same markup appears in detail panel below *@
        @if (_isInitialLoading)
        {
            <div class="loading-state">
                <MudText Typo="Typo.body2">@_loadingPhaseText</MudText>
                <MudProgressLinear Value="@_loadingProgressValue" Color="Color.Primary" />
                <MudSkeleton Height="64px" Width="100%" />
                <MudSkeleton Height="64px" Width="100%" />
                <MudSkeleton Height="64px" Width="100%" />
            </div>
        }
        else
        {
            @foreach (var wh in _warehouses)
            {
                <div class="wh-card @(_selectedWarehouse?.Id == wh.Id ? "selected" : "")"
                     @onclick="@(() => OnWarehouseSelected(wh))">
                    <MudText Typo="Typo.body1">@wh.Name</MudText>
                    <MudText Typo="Typo.caption">@wh.ItemCount items</MudText>
                </div>
            }
        }
    </div>

    @* ❌ Panel 2: Should be extracted to UIInventory/Components/WarehouseDetailPanel.razor *@
    <div class="detail-panel">
        @if (_isInitialLoading)
        {
            @* ❌ Duplicated loading skeleton *@
            <div class="loading-state">
                <MudText Typo="Typo.body2">@_loadingPhaseText</MudText>
                <MudProgressLinear Value="@_loadingProgressValue" Color="Color.Primary" />
            </div>
        }
        else if (_selectedWarehouse != null)
        {
            @* ❌ Item queue table: Should be UIInventory/Components/ItemQueueSection.razor *@
            <MudTable T="InventoryItem" Items="@_itemQueue" Dense="true">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>
                        @switch (context.Status)
                        {
                            case ItemStatus.Pending:
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">Pending</MudChip>
                                break;
                            case ItemStatus.Processing:
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">Processing</MudChip>
                                break;
                            case ItemStatus.Done:
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">Done</MudChip>
                                break;
                            case ItemStatus.Error:
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">Error</MudChip>
                                break;
                        }
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@MoIcons.Play"
                                       Size="Size.Small"
                                       Disabled="@(!CanProcessItem(context))"
                                       OnClick="@(() => ProcessItem(context))" />
                        <MudIconButton Icon="@MoIcons.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => DeleteItem(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>

            @* ❌ Batch controls: Should be part of ItemQueueSection component *@
            <div class="batch-controls">
                <MudNumericField T="int" @bind-Value="@_parallelCount" Min="1" Max="10" />
                <MudButton OnClick="@StartBatchProcessing"
                           Disabled="@(!CanStartBatchProcessing())">Start</MudButton>
                <MudButton OnClick="@CancelBatchProcessing"
                           Disabled="@(!CanCancelBatchProcessing())">Cancel</MudButton>
            </div>
        }
        else
        {
            <MudText Typo="Typo.h6" Color="Color.Secondary">Select a warehouse</MudText>
        }
    </div>
</div>

@code {
    // ❌ VIOLATION: 20+ private fields — this is a state machine hiding in a page
    // All of these should be in UIInventory/State/InventoryManagePageState.cs

    // --- Selection state ---
    private List<Warehouse> _warehouses = [];
    private Warehouse? _selectedWarehouse;
    private List<InventoryItem> _itemQueue = [];
    private int _parallelCount = 5;

    // --- Loading state ---
    private bool _isInitialLoading = true;
    private bool _isSelectionLoading;
    private string _loadingPhaseText = string.Empty;
    private double _loadingProgressValue = 12;

    // ❌ VIOLATION: CancellationTokenSource in a page
    // Should be in UIInventory/State/InventoryPollingState.cs
    private CancellationTokenSource? _pollingCts;
    private Task? _pollingTask;

    // ❌ VIOLATION: Interlocked field in a page
    private int _refreshInFlight;
    private DateTimeOffset _lastRefreshAtUtc = DateTimeOffset.MinValue;

    // --- In-flight tracking ---
    private string? _batchInFlightWarehouseId;
    private string? _singleProcessInFlightWarehouseId;
    private string? _singleProcessInFlightItemId;

    // --- Feature state ---
    private bool _suppliersLoaded;
    private List<string> _suppliers = [];
    private string? _selectedSupplier;
    private bool _isSuppliersLoading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _loadingPhaseText = "Loading warehouses...";
        _loadingProgressValue = 35;
        await InvokeAsync(StateHasChanged);
        await LoadWarehousesAsync();
        _isInitialLoading = false;
        _loadingProgressValue = 100;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadWarehousesAsync()
    {
        // ❌ Calls UIService wrapper instead of Facade directly
        var result = await InventoryService.GetWarehousesAsync();
        if (result.IsFailure())
        {
            Snackbar.Add($"Error: {result.Message}", Severity.Error);
            return;
        }
        var whs = result.Data
            ?? throw new InvalidOperationException("A warehouse read must include a collection.");
        _warehouses = whs.ToList();
    }

    private async Task OnWarehouseSelected(Warehouse? wh)
    {
        _selectedWarehouse = wh;
        if (wh is null)
        {
            _itemQueue.Clear();
            StopPolling();
            return;
        }

        _isSelectionLoading = true;
        await InvokeAsync(StateHasChanged);
        await LoadItemQueueAsync();
        EnsurePolling();
        _isSelectionLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadItemQueueAsync()
    {
        if (_selectedWarehouse is null) return;
        var result = await InventoryService.GetItemQueueAsync(_selectedWarehouse.Id);
        if (result.IsFailure())
        {
            Snackbar.Add($"Error: {result.Message}", Severity.Error);
            _itemQueue.Clear();
        }
        else
        {
            var queue = result.Data
                ?? throw new InvalidOperationException("A queue read must include a collection.");
            _itemQueue = queue.ToList();
        }
    }

    private async Task StartBatchProcessing()
    {
        if (_selectedWarehouse is null) return;
        _batchInFlightWarehouseId = _selectedWarehouse.Id;
        EnsurePolling();
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await InventoryService.StartBatchProcessingAsync(
                _selectedWarehouse.Id, _parallelCount);
            if (result.IsFailure())
            {
                Snackbar.Add($"Error: {result.Message}", Severity.Error);
            }
            else
            {
                Snackbar.Add("Success", Severity.Success);
            }
        }
        finally
        {
            _batchInFlightWarehouseId = null;
            await LoadItemQueueAsync();
            EnsurePolling();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CancelBatchProcessing()
    {
        if (_selectedWarehouse is null) return;
        var result = await InventoryService.CancelBatchProcessingAsync(_selectedWarehouse.Id);
        if (result.IsFailure())
        {
            Snackbar.Add($"Error: {result.Message}", Severity.Error);
            return;
        }
        _batchInFlightWarehouseId = null;
        await LoadItemQueueAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ProcessItem(InventoryItem item)
    {
        if (_selectedWarehouse is null) return;
        _singleProcessInFlightWarehouseId = _selectedWarehouse.Id;
        _singleProcessInFlightItemId = item.Id;
        EnsurePolling();
        try
        {
            var result = await InventoryService.ProcessItemAsync(_selectedWarehouse.Id, item.Id);
            if (result.IsFailure())
            {
                Snackbar.Add($"Error: {result.Message}", Severity.Error);
            }
        }
        finally
        {
            _singleProcessInFlightWarehouseId = null;
            _singleProcessInFlightItemId = null;
            await LoadItemQueueAsync();
            EnsurePolling();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task DeleteItem(InventoryItem item)
    {
        if (_selectedWarehouse is null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm", $"Delete '{item.Name}'?",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        var result = await InventoryService.RemoveItemAsync(_selectedWarehouse.Id, item.Id);
        if (result.IsFailure())
        {
            Snackbar.Add($"Error: {result.Message}", Severity.Error);
        }
        else
        {
            Snackbar.Add("Deleted", Severity.Success);
            await LoadItemQueueAsync();
        }
    }

    private async Task ShowCreateWarehouseDialog()
    {
        var dialog = await DialogService.ShowAsync<CreateWarehouseDialog>("Create Warehouse",
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadWarehousesAsync();
        }
    }

    private async Task DeleteSelectedWarehouse()
    {
        if (_selectedWarehouse is null) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm", $"Delete warehouse '{_selectedWarehouse.Name}'?",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        var result = await InventoryService.DeleteWarehouseAsync(_selectedWarehouse.Id);
        if (result.IsFailure())
        {
            Snackbar.Add($"Error: {result.Message}", Severity.Error);
        }
        else
        {
            _selectedWarehouse = null;
            await LoadWarehousesAsync();
        }
    }

    // ❌ VIOLATION: 6+ Can*() guard methods — should be computed properties on a state class
    private bool HasActiveWork()
        => IsBatchRunning() || HasProcessingItems() || HasSingleProcessInFlight();

    private bool IsBatchRunning()
        => _selectedWarehouse is not null
           && string.Equals(_batchInFlightWarehouseId, _selectedWarehouse.Id);

    private bool HasProcessingItems()
        => _itemQueue.Any(i => i.Status == ItemStatus.Processing);

    private bool HasSingleProcessInFlight()
        => _selectedWarehouse is not null
           && !string.IsNullOrWhiteSpace(_singleProcessInFlightItemId)
           && string.Equals(_singleProcessInFlightWarehouseId, _selectedWarehouse.Id);

    private bool CanStartBatchProcessing()
        => _selectedWarehouse is not null
           && _itemQueue.Any(i => i.Status == ItemStatus.Pending)
           && !HasActiveWork();

    private bool CanCancelBatchProcessing()
        => _selectedWarehouse is not null && IsBatchRunning();

    private bool CanProcessItem(InventoryItem item)
        => _selectedWarehouse is not null
           && item.Status is ItemStatus.Pending or ItemStatus.Error
           && !HasActiveWork();

    // ❌ VIOLATION: Polling loop with Interlocked in a Razor page
    // Should be in UIInventory/State/InventoryPollingState.cs
    private void EnsurePolling()
    {
        if (!HasActiveWork()) { StopPolling(); return; }
        if (_pollingTask is { IsCompleted: false }) return;
        _pollingCts = new CancellationTokenSource();
        _pollingTask = RunPollingAsync(_pollingCts.Token);
    }

    private async Task RunPollingAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                // ❌ Interlocked in a page
                if (Interlocked.Exchange(ref _refreshInFlight, 1) == 0)
                {
                    try
                    {
                        _lastRefreshAtUtc = DateTimeOffset.UtcNow;
                        await LoadItemQueueAsync();
                        await InvokeAsync(StateHasChanged);
                    }
                    finally
                    {
                        Interlocked.Exchange(ref _refreshInFlight, 0);
                    }
                }

                if (!HasActiveWork()) break;
                await Task.Delay(700, ct);
            }
        }
        catch (OperationCanceledException) { }
    }

    private void StopPolling()
    {
        var cts = _pollingCts;
        if (cts is null) return;
        _pollingCts = null;
        _pollingTask = null;
        if (!cts.IsCancellationRequested) cts.Cancel();
        cts.Dispose();
    }

    public void Dispose()
    {
        StopPolling();
    }
}
