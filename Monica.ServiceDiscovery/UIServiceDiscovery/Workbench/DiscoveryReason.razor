<span class="@(Count == 0 ? "is-zero" : null)"><span class="sw role-@Role"></span><b>@ChildContent</b></span>

@code {
    [Parameter] public int Count { get; set; }
    [Parameter, EditorRequired] public string Role { get; set; } = "neutral";
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
