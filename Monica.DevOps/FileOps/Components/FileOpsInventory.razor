@using Microsoft.JSInterop
@using Monica.DevOps.FileOps.Support
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<FileOpsResource> L
@inject MoTimeFormatter UiTime

<section class="fo-inv" aria-label="@L["Design:InvTitle"]">
    <div class="fo-inv-head">
        <div class="fo-inv-title">
            <h2>@L["Design:InvTitle"]</h2>
            @if (Browse is not null) { <span class="fo-count mo-vl-mono">@_rows.Count / @Browse.Entries.Count</span> }
            <span class="fo-inv-sub">@L["Design:InvDirsFirstNote"]</span>
        </div>
        <div class="fo-inv-controls">
            <label class="fo-search">
                <MoIcon Icon="@MoIcons.Search" Size="15px" />
                <input type="search" @ref="_search" aria-label="@L["Design:InvSearchPlaceholder"]" placeholder="@L["Design:InvSearchPlaceholder"]"
                       value="@Query.Search" @oninput="SearchAsync" />
            </label>
            <div class="fo-sort" role="group" aria-label="@L["Design:InvSortLabel"]">
                <MudSelect T="FileOpsSortField" Class="fo-sort-select" Value="Query.Sort" ValueChanged="@((FileOpsSortField value) => SortAsync(value, false))"
                           aria-label="@L["Design:InvSortLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                           OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" SelectionOnEnter="true"
                           ToStringFunc="@((FileOpsSortField field) => L.Sort(field).Value)">
                    @foreach (var field in Enum.GetValues<FileOpsSortField>())
                    {
                        <MudSelectItem Value="field">@L.Sort(field)</MudSelectItem>
                    }
                </MudSelect>
                <button type="button" class="fo-outline" @onclick="@(() => SortAsync(Query.Sort, !Query.Descending))">
                    <MoIcon Icon="@SortIcon" Size="15px" />@L[Query.Descending ? "Design:InvDesc" : "Design:InvAsc"]
                </button>
            </div>
        </div>
    </div>

    @if (Browse is { Entries.Count: > 0 })
    {
        <div class="fo-filter-bar">
            <div class="fo-filter-chips" role="group" aria-label="@L["Design:SigCapTitle"]">
                @foreach (var cap in Enum.GetValues<FileOpsCapability>())
                {
                    <MoFilterChip Label="@L.Capability(cap)" Role="@FileOpsInventoryView.Role(cap)" Count="@View.OptionCount(cap)"
                                  Selected="@(Query.Capability == cap)" Class="mo-vl-chip--instrument" Pill="true"
                                  ShowDot="@(cap != FileOpsCapability.All)" SelectedChanged="@(_ => SetCapabilityAsync(cap))" />
                }
            </div>
            @if (Query.Capability != FileOpsCapability.All || Query.Search.Length != 0)
            {
                <button type="button" class="fo-ghost" @onclick="ClearFiltersAsync"><MoIcon Icon="@MoIcons.FilterOff" Size="15px" />@L["Design:InvClearFilters"]</button>
            }
        </div>
    }

    @if (_checked.Length > 0)
    {
        var canZip = _checked.All(e => e.IsDirectory || e.CanDownload);
        var canDelete = _checked.All(e => e.CanDelete);
        var label = L[Browse?.IsTruncated == true ? "Design:BatchSelectedShown" : "Design:BatchSelected", _checked.Length];
        <div class="fo-batch" role="region" aria-label="@label">
            <div class="fo-batch-main">
                <strong>@label</strong>
                <div class="fo-batch-actions">
                    <button type="button" class="fo-ghost" disabled="@Controller.IsBusy" @onclick="ClearSelection">@L["Design:BatchClear"]</button>
                    <button type="button" class="fo-outline" disabled="@(!canZip || Controller.IsBusy)" @onclick="DownloadSelection">
                        <MoIcon Icon="@MoIcons.Archive" Size="15px" />@L["Design:BatchZip"]
                    </button>
                    <button type="button" class="mo-vl-soft-action mo-vl-role--error" disabled="@(!canDelete || Controller.IsBusy)" @onclick="DeleteSelection">
                        <MoIcon Icon="@MoIcons.Delete" Size="15px" />@L["Design:BatchDelete"]
                    </button>
                </div>
            </div>
            <p class="fo-batch-note">@L["Design:BatchZipRule"] @if (!canZip || !canDelete) { @L["Design:BatchIneligible"] }</p>
        </div>
    }

    @if (Browse is null)
    {
        <MoContentState>
            <span class="mo-vl-tile mo-vl-role--error"><MoIcon Icon="@MoIcons.FolderOff" Size="18px" /></span>
            <h2>@L["Design:InvUnavailableTitle"]</h2>
            <p>@(Controller.LastRead?.Message ?? L["Design:InvUnavailableBody"].Value)</p>
            <button type="button" class="fo-outline" disabled="@Controller.IsBusy" @onclick="Refresh"><MoIcon Icon="@MoIcons.Refresh" Size="15px" />@L["Design:Refresh"]</button>
        </MoContentState>
    }
    else if (Browse.Entries.Count == 0)
    {
        <MoContentState>
            <span class="mo-vl-tile mo-vl-role--neutral"><MoIcon Icon="@MoIcons.FolderOpen" Size="18px" /></span>
            <h2>@L["Design:InvEmptyTitle"]</h2><p>@L["Design:InvEmptyBody"]</p>
            @if (Browse.CanCreateDirectory)
            {
                <button type="button" class="fo-outline" disabled="@Controller.IsBusy" @onclick="Create">
                    <MoIcon Icon="@MoIcons.FolderPlus" Size="15px" />@L["Design:ActNewFolder"]
                </button>
            }
        </MoContentState>
    }
    else if (_rows.Count == 0)
    {
        <MoContentState>
            <span class="mo-vl-tile mo-vl-role--neutral"><MoIcon Icon="@MoIcons.SearchOff" Size="18px" /></span>
            <h2>@L["Design:InvNoMatchTitle"]</h2><p>@L["Design:InvNoMatchBody"]</p>
            <button type="button" class="fo-outline" @onclick="ClearFiltersAsync"><MoIcon Icon="@MoIcons.FilterOff" Size="15px" />@L["Design:InvClearFilters"]</button>
        </MoContentState>
    }
    else
    {
        <div class="fo-table-wrap">
            <table class="fo-table">
                <thead>
                    <tr>
                        <th class="fo-col-check" scope="col">
                            <input type="checkbox" class="fo-check" disabled="@Controller.IsBusy" @ref="_selectAll"
                                   checked="@AllChecked" aria-checked="@(Mixed ? "mixed" : AllChecked ? "true" : "false")"
                                   aria-label="@L["Design:ColSelectAll"]" @onchange="SetVisibleSelection" />
                            <span class="fo-select-caption">@L["Design:ColSelectAll"]</span>
                        </th>
                        @foreach (var field in Enum.GetValues<FileOpsSortField>())
                        {
                            <th class="@ColumnClass(field)" scope="col" aria-sort="@(Query.Sort == field ? Query.Descending ? "descending" : "ascending" : null)">
                                <button type="button" class="fo-th-btn" @onclick="@(() => SortAsync(field, Query.Sort == field && !Query.Descending))">
                                    @L.Sort(field)
                                    @if (Query.Sort == field) { <MoIcon Icon="@SortIcon" Size="13px" /> }
                                </button>
                            </th>
                        }
                        <th class="fo-col-act" scope="col"><span class="mud-sr-only">@L["Design:ColActions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _rows)
                    {
                        var cap = FileOpsInventoryView.Classify(entry);
                        var inspected = IsInspected(entry);
                        var selected = Controller.IsSelected(entry);
                        <tr @key="entry.FullPath" class="fo-row @(inspected ? "is-inspected" : null) @(selected ? "is-checked" : null)">
                            <td class="fo-col-check">
                                <input type="checkbox" class="fo-check" checked="@selected" aria-label="@L["Design:ActCheck", entry.Name]"
                                       disabled="@Controller.IsBusy" @onchange="@((ChangeEventArgs args) => ToggleEntry(entry, args))" />
                            </td>
                            <td class="fo-col-name" data-label="@L["Design:ColName"]">
                                <div class="fo-entry">
                                    <span class="fo-entry-ico @FileOpsInventoryView.Role(cap).ToCssClass()">
                                        <MoIcon Icon="@(entry.IsDirectory ? MoIcons.Folder : cap == FileOpsCapability.Editable ? MoIcons.FileCode : MoIcons.FileText)" Size="16px" />
                                    </span>
                                    <button type="button" class="fo-entry-btn" title="@entry.FullPath" @onclick="@(() => Open.InvokeAsync(entry))">
                                        <span class="fo-entry-name">@entry.Name</span>
                                    </button>
                                    <span class="fo-entry-tags">
                                        @if (cap == FileOpsCapability.Editable) { <span class="mo-vl-badge mo-vl-role--success">@L["Design:BadgeEditable"]</span> }
                                        @if (cap == FileOpsCapability.Preview) { <span class="mo-vl-badge mo-vl-role--info">@L["Design:BadgePreview"]</span> }
                                        @if (entry.IsReadOnly) { <span class="mo-vl-badge mo-vl-role--warning">@L["Design:BadgeReadOnly"]</span> }
                                        @if (entry.IsHidden) { <span class="mo-vl-badge mo-vl-role--neutral">@L["Design:BadgeHidden"]</span> }
                                        @if (cap == FileOpsCapability.Blocked) { <span class="mo-vl-badge mo-vl-role--warning">@L["Design:BadgeOverDown"]</span> }
                                        else if (entry.TextPreview == FileOpsTextPreviewKind.Oversized) { <span class="mo-vl-badge mo-vl-role--warning">@L["Design:BadgeOverText"]</span> }
                                        @if (inspected && Controller.IsDirty) { <span class="mo-vl-badge mo-vl-role--warning">@L["Design:BadgeDirty"]</span> }
                                    </span>
                                </div>
                            </td>
                            <td class="fo-col-type mo-vl-mono" data-label="@L["Design:ColType"]">
                                @(entry.IsDirectory ? L["Design:TypeDir"].Value : entry.Extension.Length > 0 ? entry.Extension : L["Design:TypeFile"].Value)
                            </td>
                            <td class="is-num mo-vl-mono" data-label="@L["Design:ColSize"]" title="@entry.SizeBytes?.ToString("N0")">
                                @(entry.SizeBytes is { } bytes ? FileOpsLabels.Bytes(bytes) : "—")
                            </td>
                            <td class="fo-col-mod mo-vl-mono" data-label="@L["Design:ColModified"]">@UiTime.Format(entry.LastModifiedAt)</td>
                            <td class="fo-col-act" data-label="@L["Design:ColActions"]">
                                <div class="fo-row-acts">
                                    <button type="button" class="fo-ghost" @onclick="@(() => Open.InvokeAsync(entry))">
                                        @L[entry.IsDirectory ? "Design:ActOpen" : cap == FileOpsCapability.Editable ? "Design:ActEdit" : "Design:ActInspect"]
                                    </button>
                                    @if (!entry.IsDirectory && entry.CanDownload)
                                    {
                                        <button type="button" class="fo-icon" aria-label="@L["Design:RowDownload", entry.Name]" title="@L["Design:ActDownload"]"
                                                @onclick="@(() => Download.InvokeAsync(entry.FullPath))"><MoIcon Icon="@MoIcons.Download" Size="16px" /></button>
                                    }
                                    @if (entry.CanDelete)
                                    {
                                        <button type="button" class="fo-icon fo-delete" aria-label="@L["Design:RowDelete", entry.Name]" title="@L["Design:ActDelete"]"
                                                @onclick="@(() => Delete.InvokeAsync(entry))"><MoIcon Icon="@MoIcons.Delete" Size="16px" /></button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public FileOpsWorkspaceController Controller { get; set; } = null!;
    [Parameter] public FileOpsBrowseResult? Browse { get; set; }
    [Parameter, EditorRequired] public FileOpsInventoryView View { get; set; } = null!;
    [Parameter, EditorRequired] public FileOpsViewQuery Query { get; set; } = null!;
    [Parameter] public EventCallback<FileOpsViewQuery> Filter { get; set; }
    [Parameter] public EventCallback<FileOpsEntrySummary> Open { get; set; }
    [Parameter] public EventCallback<string> Download { get; set; }
    [Parameter] public EventCallback<FileOpsEntrySummary> Delete { get; set; }
    [Parameter] public EventCallback DownloadSelection { get; set; }
    [Parameter] public EventCallback DeleteSelection { get; set; }
    [Parameter] public EventCallback Refresh { get; set; }
    [Parameter] public EventCallback Create { get; set; }

    private IReadOnlyList<FileOpsEntrySummary> _rows = [];
    private FileOpsEntrySummary[] _checked = [];
    private ElementReference _selectAll, _search;
    private Task<IJSObjectReference>? _import;
    private bool _retired, _restoreFocus;
    private int CheckedVisible => _rows.Count(Controller.IsSelected);
    private bool AllChecked => _rows.Count > 0 && CheckedVisible == _rows.Count;
    private bool Mixed => !AllChecked && CheckedVisible != 0;
    private string SortIcon => Query.Descending ? MoIcons.ArrowDown : MoIcons.ArrowUp;

    protected override void OnParametersSet()
    {
        _rows = View.Filtered;
        UpdateSelection();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_retired) return;
        try
        {
            if (_rows.Count > 0)
            {
                _import ??= JS.InvokeAsync<IJSObjectReference>("import",
                    $"./{Assets[FileOpsTransferInteropSession.MODULE_ASSET]}").AsTask();
                var module = await _import;
                if (!_retired && _rows.Count > 0)
                    await module.InvokeVoidAsync("setIndeterminate", _selectAll, Mixed);
            }
            if (_retired || !_restoreFocus) return;
            _restoreFocus = false;
            await (_rows.Count > 0 ? _selectAll : _search).FocusAsync(preventScroll: true);
        }
        catch (JSDisconnectedException) { }
    }

    private static string? ColumnClass(FileOpsSortField field) => field switch
    {
        FileOpsSortField.Type => "fo-col-type",
        FileOpsSortField.Size => "is-num",
        FileOpsSortField.Modified => "fo-col-mod",
        _ => null
    };

    private bool IsInspected(FileOpsEntrySummary entry) => string.Equals(entry.FullPath, Query.File,
        OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal);
    private Task SortAsync(FileOpsSortField field, bool descending) => Filter.InvokeAsync(Query with { Sort = field, Descending = descending });
    private Task SearchAsync(ChangeEventArgs args) => Filter.InvokeAsync(Query with { Search = args.Value?.ToString() ?? "" });
    private Task ClearFiltersAsync() => Filter.InvokeAsync(Query with { Search = "", Capability = FileOpsCapability.All });
    private Task SetCapabilityAsync(FileOpsCapability cap) => Filter.InvokeAsync(Query with { Capability = cap });

    private void UpdateSelection() => _checked = Browse?.Entries.Where(Controller.IsSelected).ToArray() ?? [];

    private void ToggleEntry(FileOpsEntrySummary entry, ChangeEventArgs args)
    {
        Controller.ToggleEntrySelection(entry, args.Value is true);
        UpdateSelection();
    }

    private void SetVisibleSelection(ChangeEventArgs args)
    {
        Controller.SelectVisible(_rows, args.Value is true);
        UpdateSelection();
    }

    private void ClearSelection()
    {
        Controller.ClearSelection();
        _restoreFocus = true;
        UpdateSelection();
    }

    public async ValueTask DisposeAsync()
    {
        _retired = true;
        if (_import is null) return;
        try { await (await _import).DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
