@inject IStringLocalizer<JobSchedulerResource> L
<section class="catalog-filter" aria-label="@L["Catalog:Filters:AriaLabel"]">
    <div class="catalog-filter__states" role="group" aria-label="@L["Workspace:Standing"]">
        @foreach (var standing in new[] { "all", "attention", "healthy", "ondemand", "paused", "absent" })
        {
            <button type="button" class="catalog-filter__state" data-tone="@Tone(standing)" data-standing="@standing" data-zero="@((StandingCounts.GetValueOrDefault(standing) == 0).ToString().ToLowerInvariant())" aria-pressed="@(((Standing ?? "all") == standing).ToString().ToLowerInvariant())" @onclick="@(() => StandingSelected.InvokeAsync(standing == "all" ? null : standing))">
                @if (standing != "all") { <i aria-hidden="true"></i> }<span>@L[$"Workspace:Standings:{standing}"]</span><small>@StandingCounts.GetValueOrDefault(standing)</small>
            </button>
        }
    </div>
    <div class="catalog-filter__query">
        <div class="catalog-filter__search">
            <MudTextField T="string" Value="@SearchText" ValueChanged="SearchTextChanged" Placeholder="@L["Workspace:CatalogSearch"]" aria-label="@L["Workspace:CatalogSearch"]" DebounceInterval="300" OnDebounceIntervalElapsed="ApplySearchAsync" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" ClearIcon="@MoIcons.Close" />
        </div>
        <div class="catalog-filter__owner">
            <MudSelect T="string" Value="@OwnerId" ValueChanged="ChangeOwnerAsync" aria-label="@L["Catalog:Filters:Owner"]" Variant="Variant.Outlined" Margin="Margin.Dense" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                <MudSelectItem T="string" Value="@((string?)null)">@L["Catalog:Filters:AnyOwner"]</MudSelectItem>
                @foreach(var owner in OwnerFacets) { <MudSelectItem T="string" Value="@owner.Key">@owner.Key</MudSelectItem> }
            </MudSelect>
        </div>
        <div class="catalog-filter__types" role="group" aria-label="@L["Catalog:Filters:Type"]">
            <button type="button" aria-pressed="@((SelectedJobType is null).ToString().ToLowerInvariant())" @onclick="@(() => JobTypeSelected.InvokeAsync((JobType?)null))">@L["Catalog:Filters:AnyType"]</button>
            @foreach(var type in Enum.GetValues<JobType>()) { <button type="button" aria-pressed="@((SelectedJobType == type).ToString().ToLowerInvariant())" @onclick="@(() => JobTypeSelected.InvokeAsync(type))">@L[$"JobTypes:{type}"]</button> }
        </div>
        <div class="catalog-filter__sort"><span>@L["Workspace:SortLabel"]</span><MudSelect T="string" Value="@Sort" ValueChanged="SortSelected" aria-label="@L["Workspace:SortLabel"]" Variant="Variant.Outlined" Margin="Margin.Dense" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">@foreach(var sort in new[] { "attention", "name", "owner", "next" }) { <MudSelectItem T="string" Value="@sort">@L[$"Workspace:Sorts:{sort}"]</MudSelectItem> }</MudSelect></div>
    </div>
    @if (OwnerId is not null || Cadence is not null || Standing is not null || SelectedDisabledState is not null || !string.IsNullOrEmpty(SearchText) || SelectedJobType is not null)
    {
        <div class="catalog-filter__active">@if (Cadence is not null) { <span>@L[$"Workspace:Cadences:{Cadence}"]</span> }<MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@MoIcons.Close" OnClick="ResetRequested">@L["Catalog:Actions:Reset"]</MudButton></div>
    }
</section>
@code {
    [Parameter] public string? SearchText { get; set; }
    [Parameter] public EventCallback<string?> SearchTextChanged { get; set; }
    [Parameter] public string? OwnerId { get; set; }
    [Parameter] public EventCallback<string?> OwnerIdChanged { get; set; }

    /// <summary>Gets or sets the selected job type. A null value displays all types.</summary>
    [Parameter] public JobType? SelectedJobType { get; set; }

    /// <summary>Gets or sets whether a successful bounded facet capture exists. False suppresses unknown counts.</summary>
    [Parameter] public bool HasFacetEvidence { get; set; } = true;

    /// <summary>Gets or sets type counts from the bounded loaded presence snapshot, independent of result filters.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyDictionary<JobType, int> JobTypeCounts { get; set; } = new Dictionary<JobType, int>();

    /// <summary>Gets or sets exact owner identities and counts from the bounded loaded presence snapshot.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<KeyValuePair<string, int>> OwnerFacets { get; set; } = [];

    /// <summary>Gets or sets the selection callback. A null value requests all job types.</summary>
    [Parameter] public EventCallback<JobType?> JobTypeSelected { get; set; }
    [Parameter] public bool? SelectedDisabledState { get; set; }
    [Parameter] public EventCallback<bool?> DisabledStateSelected { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback SearchRequested { get; set; }
    [Parameter] public EventCallback ResetRequested { get; set; }

    /// <summary>Gets the selected operational standing; null selects every standing.</summary>
    [Parameter] public string? Standing { get; set; }
    /// <summary>Gets standing facets evaluated with their own filter excluded.</summary>
    [Parameter] public IReadOnlyDictionary<string, int> StandingCounts { get; set; } = new Dictionary<string, int>();
    /// <summary>Persists a standing selection.</summary>
    [Parameter] public EventCallback<string?> StandingSelected { get; set; }
    /// <summary>Gets the selected cadence from the composition map.</summary>
    [Parameter] public string? Cadence { get; set; }
    /// <summary>Gets the selected ordering.</summary>
    [Parameter] public string Sort { get; set; } = "attention";
    /// <summary>Persists the selected ordering.</summary>
    [Parameter] public EventCallback<string> SortSelected { get; set; }
    private async Task ChangeOwnerAsync(string? value) { await OwnerIdChanged.InvokeAsync(value); await SearchRequested.InvokeAsync(); }
    private async Task ApplySearchAsync(string value) { await SearchTextChanged.InvokeAsync(value); await SearchRequested.InvokeAsync(); }
    private static string Tone(string standing) => standing switch { "attention" => "error", "healthy" => "success", "ondemand" => "primary", _ => "neutral" };
    private IReadOnlyList<PolicyOption> PolicyOptions =>
    [
        new(null, L["Catalog:Filters:AnyPolicy"], "neutral"),
        new(false, L["Catalog:Enabled"], "success"),
        new(true, L["Catalog:Disabled"], "warning")
    ];

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !IsLoading) await SearchRequested.InvokeAsync();
    }

    private static string GetJobTypeIcon(JobType type) => type switch
    {
        JobType.Recurring => MoIcons.History,
        JobType.Triggered => MoIcons.Zap,
        _ => MoIcons.Briefcase
    };

    private sealed record PolicyOption(bool? Value, string Label, string Tone);
}
