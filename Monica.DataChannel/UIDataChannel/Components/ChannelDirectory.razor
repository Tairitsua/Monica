@using Monica.Core.TypeDiscovery.Abstractions
@using Monica.DataChannel.Models
@inject IStringLocalizer<DataChannelResource> L

@{
    var rows = View.DirectoryRows(Query).ToArray();
    var bySetup = rows.ToLookup(c => c.Setup?.Id, StringComparer.Ordinal);
    var setups = View.Setups.Where(s => bySetup.Contains(s.Id) || DataChannelView.ShowEmptySetup(s, Query)).ToArray();
    var facet = View.DirectoryRows(Query, ignoreState: true).ToArray();
    var hasFilters = Query.Setup is not null || Query.Group is not null || Query.State is not null || Query.Evidence is not null || !string.IsNullOrWhiteSpace(Query.Search);
    var missingExact = Query.Channel is not null && !View.ById.ContainsKey(Query.Channel);
}
<section class="mo-vl-surface dc-dir" aria-labelledby="dc-dir-title">
    <header class="mo-vl-surface-heading dc-dir-head">
        <span class="mo-vl-tile mo-vl-role--primary"><MoIcon Icon="@MoIcons.Route" Size="16px" /></span>
        <div class="surface-title">
            <h2 id="dc-dir-title">@L["Design:DirUnifiedTitle"]</h2>
            <p>@L["Design:DirUnifiedDesc"]</p>
        </div>
        <div class="dc-dir-head-end">
            <span class="count mono">@L["Design:DirShown", rows.Length, View.Total]</span>
            <div class="mo-vl-segment dc-view-seg" role="group" aria-label="@L["Design:ViewModeLabel"]">
                <button type="button" aria-pressed="@Pressed(!Query.Flat)" @onclick="() => Change(Query with { Flat = false })">
                    <MoIcon Icon="@MoIcons.Layers" Size="14px" />@L["Design:ViewBySetup"]
                </button>
                <button type="button" aria-pressed="@Pressed(Query.Flat)" @onclick="() => Change(Query with { Flat = true })">
                    <MoIcon Icon="@MoIcons.List" Size="14px" />@L["Design:ViewFlat"]
                </button>
            </div>
        </div>
    </header>

    @if (Query.Channel is { } exact)
    {
        <div class="dc-exact">
            <MoIcon Icon="@MoIcons.Crosshair" Size="15px" /><span>@L["Design:ExactChannel"]</span><code class="mono">@exact</code>
            <button type="button" class="btn btn-soft btn-sm mo-vl-role--primary" @onclick="ClearScope">@L["Design:ShowAllChannels"]</button>
        </div>
    }

    <div class="dc-toolbar">
        <div class="dc-search">
            <MoIcon Icon="@MoIcons.Search" Size="15px" />
            <input type="search" value="@Query.Search" placeholder="@L["Design:SearchPlaceholder"]" aria-label="@L["Design:SearchLabel"]"
                   @oninput="e => Change(Query with { Search = Filter(e.Value?.ToString()) })" />
            @if (!string.IsNullOrEmpty(Query.Search))
            {
                <button type="button" class="icon-btn" aria-label="@L["Design:ClearSearch"]" @onclick="() => Change(Query with { Search = null })">
                    <MoIcon Icon="@MoIcons.Close" Size="14px" />
                </button>
            }
        </div>
        <MudSelect T="string" Class="dc-select dc-select-setup" Value="@(Query.Setup ?? string.Empty)" ValueChanged="value => Change(Query with { Setup = Filter(value) })"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" aria-label="@L["Design:SetupFilterLabel"]">
            <MudSelectItem Value="@string.Empty">@L["Design:AllSetups"]</MudSelectItem>
            @foreach (var setup in View.Setups)
            {
                <MudSelectItem Value="@setup.Id">@(setup.Owner is { } owner ? DataChannelVisual.ShortOwner(owner) : L["Design:HostInfra"].Value)</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" Class="dc-select dc-select-group" Value="@(Query.Group ?? string.Empty)" ValueChanged="value => Change(Query with { Group = Filter(value) })"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" aria-label="@L["Design:GroupLabel"]">
            <MudSelectItem Value="@string.Empty">@L["Design:AllGroups"]</MudSelectItem>
            @if (View.Channels.Any(c => c.Group is null))
            {
                <MudSelectItem Value="@("ungrouped")">@L["Workbench:Ungrouped"]</MudSelectItem>
            }
            @foreach (var group in View.Channels.Select(c => c.Group).OfType<string>().Distinct().Order())
            {
                <MudSelectItem Value="@group">@group</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="string" Class="dc-select dc-select-evidence" Value="@(Query.Evidence ?? string.Empty)" ValueChanged="value => Change(Query with { Evidence = Filter(value) })"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" aria-label="@L["Design:EvidenceLabel"]">
            <MudSelectItem Value="@string.Empty">@L["Design:EvidenceAll"]</MudSelectItem>
            <MudSelectItem Value="@("retained")">@L["Design:EvidenceRetained"]</MudSelectItem>
            <MudSelectItem Value="@("historical")">@L["Design:EvidenceHistorical"]</MudSelectItem>
            <MudSelectItem Value="@("clean")">@L["Design:EvidenceClean"]</MudSelectItem>
        </MudSelect>
        <MudSelect T="string" Class="dc-select dc-select-order" Value="@(Query.Sort ?? string.Empty)" ValueChanged="value => Change(Query with { Sort = Filter(value) })"
                   Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" aria-label="@L["Design:SortLabel"]">
            <MudSelectItem Value="@string.Empty">@L["Design:Sorts:Attention"]</MudSelectItem>
            <MudSelectItem Value="@("retained")">@L["Design:Sorts:Retained"]</MudSelectItem>
            <MudSelectItem Value="@("lifetime")">@L["Design:Sorts:Lifetime"]</MudSelectItem>
            <MudSelectItem Value="@("name")">@L["Design:Sorts:Name"]</MudSelectItem>
        </MudSelect>
        @if (hasFilters)
        {
            <button type="button" class="btn btn-ghost btn-sm" @onclick="Reset">@L["Design:ResetFilters"]</button>
        }
    </div>

    <div class="dc-state-chips fchips" role="group" aria-label="@L["Design:Cols:Init"]">
        <MoFilterChip Pill="true" Label="@L["Design:AllStates"]" Count="@facet.Length" Role="MoVisualRole.Primary"
                      Selected="@(Query.State is null)" SelectedChanged="@(_ => SelectState(null))" />
        <MoFilterChip Pill="true" ShowDot="true" Class="dc-chip-mark" Label="@L["Design:NeedsAttentionChip"]"
                      Count="@facet.Count(c => c.NeedsAttention)" Role="MoVisualRole.Error"
                      Selected="@(Query.State == "Attention")" SelectedChanged="@(_ => SelectState("Attention"))" />
        @foreach (var state in INIT_STATES)
        {
            <MoFilterChip Pill="true" ShowDot="true" Class="dc-chip-mark" Label="@L[$"Channel:States:{state}"]"
                          Count="@facet.Count(c => c.Initialization == state)" Role="@DataChannelVisual.InitRole(state)"
                          Selected="@(Query.State == state)" SelectedChanged="@(_ => SelectState(state))" />
        }
    </div>

    @if (rows.Length == 0 && (Query.Flat || setups.Length == 0))
    {
        <MoContentState Compact="true" Class="dc-empty">
            <span class="mo-vl-tile mo-vl-role--neutral"><MoIcon Icon="@(missingExact ? MoIcons.SearchOff : MoIcons.FilterOff)" Size="18px" /></span>
            <h2>@L[missingExact ? "Design:MissingChannelTitle" : "Design:NoMatchesTitle"]</h2>
            <p>@L[missingExact ? "Design:MissingChannelBody" : "Design:NoMatchesBody"]</p>
            <button type="button" class="btn btn-outline btn-sm" @onclick="@(missingExact ? ClearScope : Reset)">
                @L[missingExact ? "Design:ShowAllChannels" : "Design:ResetFilters"]
            </button>
        </MoContentState>
    }
    else
    {
        <div class="table-wrap dc-table-wrap">
            <table class="table dc-table dc-dir-table" aria-labelledby="dc-dir-title">
                <thead>
                    <tr>
                        <th scope="col">@L["Design:Cols:Channel"]</th><th scope="col">@L["Design:Cols:Conduit"]</th>
                        <th scope="col">@L["Design:Cols:Init"]</th><th scope="col">@L["Design:Cols:Retained"]</th>
                        <th scope="col" class="is-num">@L["Design:Cols:Lifetime"]</th><th scope="col" class="is-end">@L["Design:Cols:Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Query.Flat)
                    {
                        @foreach (var channel in rows) { @Row(channel) }
                    }
                    else
                    {
                        @foreach (var setup in setups)
                        {
                            var unavailable = SetupBusy || View.Setups.Any(item => item.State is DataChannelSetupState.Starting or DataChannelSetupState.Stopping);
                            <tr class="dc-setup-band @(setup.State == DataChannelSetupState.Failed ? "is-failed" : null)" data-setup="@setup.Id" @key="setup.Id">
                                <td colspan="6">
                                    <div class="dc-setup-band-inner">
                                        <div class="dc-setup-band-id">
                                            <strong class="dc-setup-owner">@(setup.Owner is { } name ? DataChannelVisual.ShortOwner(name) : L["Design:HostInfra"].Value)</strong>
                                            <code class="dc-setup-cls mono" title="@setup.ImplementationType">@DataChannelVisual.BuilderName(setup.ImplementationType)</code>
                                            <span class="dc-state is-compact @DataChannelVisual.SetupRole(setup.State).ToCssClass()">
                                                <span class="status-dot" aria-hidden="true"></span>@L[$"Setup:States:{setup.State}"]
                                            </span>
                                            <span class="dc-setup-mode">@L[$"Setup:Modes:{setup.Mode}"]</span>
                                            <span class="dot-sep" aria-hidden="true"></span>
                                            <span class="dc-setup-count">@L["Design:SetupChannelCount", setup.ChannelIds.Count]</span>
                                        </div>
                                        <div class="dc-setup-actions">
                                            @if (setup.Mode != ActivationMode.Disabled)
                                            {
                                                @if (setup.State != DataChannelSetupState.Running)
                                                {
                                                    <button type="button" class="btn btn-soft btn-sm mo-vl-role--primary" disabled="@unavailable" @onclick="() => OnStart.InvokeAsync(setup.Id)">
                                                        <MoIcon Icon="@MoIcons.Play" Size="14px" />@L["Setup:Start"]
                                                    </button>
                                                }
                                                @if (setup.State is not (DataChannelSetupState.Held or DataChannelSetupState.Stopped))
                                                {
                                                    <button type="button" class="btn btn-outline btn-sm" disabled="@unavailable" @onclick="() => OnStop.InvokeAsync(setup.Id)">
                                                        <MoIcon Icon="@MoIcons.Stop" Size="14px" />@L["Setup:Stop"]
                                                    </button>
                                                }
                                                @if (setup.State != DataChannelSetupState.Held)
                                                {
                                                    <button type="button" class="btn btn-ghost btn-sm" disabled="@unavailable" @onclick="() => OnRestart.InvokeAsync(setup.Id)">
                                                        <MoIcon Icon="@MoIcons.Refresh" Size="14px" />@L["Setup:Restart"]
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </div>
                                    @if (setup.Error is { Length: > 0 } failure)
                                    {
                                        <div class="dc-setup-error mo-vl-role--error" role="alert"><MoIcon Icon="@MoIcons.Error" Size="15px" />
                                            <span class="mono">@failure</span>
                                        </div>
                                    }
                                </td>
                            </tr>
                            @if (bySetup.Contains(setup.Id))
                            {
                                @foreach (var channel in bySetup[setup.Id]) { @Row(channel) }
                            }
                            else
                            {
                                <tr class="dc-setup-slot-row">
                                    <td colspan="6">
                                        @if (setup.State == DataChannelSetupState.Held)
                                        {
                                            <div class="dc-corridor-slot is-held hatch">
                                                <span class="dc-pill mo-vl-role--warning"><MoIcon Icon="@MoIcons.Clock" Size="13px" />@L["Setup:States:Held"]</span>
                                                <span>@L["Design:BlueprintUndeclared"]</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="dc-corridor-slot @(setup.Mode == ActivationMode.Disabled ? "is-disabled" : "is-empty")">
                                                @if (setup.Mode == ActivationMode.Disabled) { <MoIcon Icon="@MoIcons.Ban" Size="15px" /> }
                                                <span>@L[setup.Mode == ActivationMode.Disabled ? "Design:BlueprintDisabledOwner" : "Design:BlueprintNoChannels"]</span>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        @if (bySetup.Contains(null))
                        {
                            <tr class="dc-setup-band"><td colspan="6"><strong>@L["Design:HostInfra"]</strong></td></tr>
                            @foreach (var channel in bySetup[null]) { @Row(channel) }
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private static readonly string[] INIT_STATES = ["Initialized", "Initializing", "Unavailable", "NotInitialized"];

    /// <summary>Gets or sets the captured channels and owning setups.</summary>
    [Parameter, EditorRequired] public DataChannelView View { get; set; } = null!;
    /// <summary>Gets or sets URL-held directory options.</summary>
    [Parameter, EditorRequired] public DataChannelQuery Query { get; set; } = new();
    /// <summary>Receives changes to directory filtering and view mode.</summary>
    [Parameter] public EventCallback<DataChannelQuery> OnQuery { get; set; }
    /// <summary>Starts the specified host setup.</summary>
    [Parameter] public EventCallback<string> OnStart { get; set; }
    /// <summary>Stops the specified host setup.</summary>
    [Parameter] public EventCallback<string> OnStop { get; set; }
    /// <summary>Restarts the specified host setup.</summary>
    [Parameter] public EventCallback<string> OnRestart { get; set; }
    /// <summary>Reinitializes the selected channel.</summary>
    [Parameter] public EventCallback<string> OnReinitialize { get; set; }
    /// <summary>Requests confirmation to clear the selected channel's history.</summary>
    [Parameter] public EventCallback<string> OnClear { get; set; }
    /// <summary>Reports whether channel commands are busy.</summary>
    [Parameter, EditorRequired] public Func<string, bool> IsBusy { get; set; } = null!;
    /// <summary>Disables setup commands while work is admitted.</summary>
    [Parameter] public bool SetupBusy { get; set; }

    private Task Change(DataChannelQuery query) => OnQuery.InvokeAsync(query);
    private Task SelectState(string? state) => Change(Query with { State = state == Query.State ? null : state });
    private Task ClearScope() => Change(Query with { Channel = null });
    private Task Reset() => Change(Query with { Setup = null, Group = null, State = null, Evidence = null, Search = null, Sort = null });
    private static string? Filter(string? value) => string.IsNullOrEmpty(value) ? null : value;
    private static string Pressed(bool value) => value ? "true" : "false";

    private RenderFragment Row(ChannelEvidence channel) => @<DataChannelDirectoryRow @key="channel.Id" Channel="channel" Query="Query"
        IsBusy="@IsBusy(channel.Id)" OnReinitialize="OnReinitialize" OnClear="OnClear" />;
}
