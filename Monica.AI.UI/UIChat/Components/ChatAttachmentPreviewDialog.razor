@using Microsoft.Extensions.Localization
@using Monica.AI.Chat.Facades
@using Monica.AI.UI.Localization
@using Monica.Core.Results
@implements IAsyncDisposable
@inject ChatAttachmentFacade AttachmentFacade
@inject IStringLocalizer<AIResource> L
<MudDialog ContentClass="pa-0" Style="max-height:calc(100dvh - 24px);margin:12px">
    <DialogContent>
        <div class="attachment-preview">
            @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
            else if (_error is not null) { <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_error</MudAlert> }
            else if (_imageSource is not null) { <img src="@_imageSource" alt="@Attachment.FileName" /> }
            else if (_text is not null) { <pre>@_text</pre> }
            <MudText Typo="Typo.caption">@Attachment.MediaType · @($"{Attachment.Size:N0}") @L["Workbench:Bytes"]</MudText>
            @if (Attachment.Kind == ChatAttachmentKind.Document) { <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Dense="true">@L["Workbench:DocumentDelivery"]</MudAlert> }
        </div>
    </DialogContent>
    <DialogActions><MudButton OnClick="@(() => Dialog.Close())">@L["Common:Actions:Close"]</MudButton></DialogActions>
</MudDialog>
@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter, EditorRequired] public required ChatAttachmentReference Attachment { get; set; }
    [Parameter, EditorRequired] public required string SessionId { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _read;
    private Task? _retirement;
    private bool _loading = true;
    private bool _disposed;
    private string? _error;
    private string? _imageSource;
    private string? _text;
    protected override Task OnInitializedAsync() => _read = ReadAsync();
    private async Task ReadAsync()
    {
        try
        {
            var result = await AttachmentFacade.ReadAsync(SessionId, Attachment.Id, _lifetime.Token);
            if (_disposed) return;
            var error = result.WithoutData();
            var data = result.Data;
            if (result.IsFailure() || data is null) _error = error.Message ?? L["Error:Generic"];
            else if (Attachment.Kind == ChatAttachmentKind.Image) _imageSource = $"data:{Attachment.MediaType};base64,{Convert.ToBase64String(data.Data)}";
            else _text = data.ExtractedText;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception) { if (!_disposed) _error = exception.Message; }
        finally { if (!_disposed) _loading = false; }
    }
    public ValueTask DisposeAsync() => new(_retirement ??= RetireAsync());
    private async Task RetireAsync()
    {
        _disposed = true;
        try
        {
            await Task.WhenAll(_lifetime.CancelAsync(), _read ?? Task.CompletedTask);
        }
        finally { _lifetime.Dispose(); }
    }
}
