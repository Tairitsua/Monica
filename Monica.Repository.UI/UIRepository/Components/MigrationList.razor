@using Monica.UI.Shared.Components.States
<div class="migration-list">
    <div class="migration-list__header">
        <div>
            <MudText Typo="Typo.subtitle2">@Title</MudText>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Subtitle</MudText>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(CountText))
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@CountText</MudChip>
        }
    </div>
    @if (Items.Count == 0)
    {
        <MoContentState Compact="true"><MudText Typo="Typo.body2" Color="Color.Secondary">@EmptyText</MudText></MoContentState>
    }
    else
    {
        <ul>
            @foreach (var item in Items)
            {
                <li>@item</li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public string? CountText { get; set; }

    [Parameter] public IReadOnlyList<string> Items { get; set; } = [];

    [Parameter] public string EmptyText { get; set; } = string.Empty;
}
