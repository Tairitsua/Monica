@attribute [Route(PAGE_URL)]
@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Shared.Components
@using Monica.AI.UI.Localization
@using Monica.AI.RAG.Facades
@using Monica.AI.RAG.Models
@using Monica.Core.Results;
@inject IStringLocalizer<AIResource> L
@inject ChunkerFacade ChunkerService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@L["KnowledgeWorkbench:Chunking:Title"]</PageTitle>
<div class="rag-chunkers-page">
    <KnowledgeRagHeader Title="@L["KnowledgeWorkbench:Chunking:Title"]" Description="@L["KnowledgeWorkbench:Chunking:Description"]" CurrentRoute="@PAGE_URL">
        <Actions><MudButton @ref="_refreshButton" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.Refresh" OnClick="LoadStateAsync" aria-disabled="@((_isLoading || _isTesting || MutationBusy) ? "true" : "false")">@L["ProviderManage:Refresh"]</MudButton></Actions>
    </KnowledgeRagHeader>
    @if (_isLoading) { <MoContentState Loading="true"><MudProgressCircular Indeterminate="true" Size="Size.Small" /> @L["KnowledgeWorkbench:Chunking:Loading"]</MoContentState> }
    else if (!string.IsNullOrWhiteSpace(_loadError)) { <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_loadError <MudButton OnClick="LoadStateAsync">@L["KnowledgeWorkbench:Retrieval:Retry"]</MudButton></MudAlert> }
    else
    {
        <div class="chunking-workspaces">
            <section class="routing-panel">
                <h2>@L["KnowledgeWorkbench:Chunking:RoutingTitle"]</h2>
                <p class="section-description">@L["KnowledgeWorkbench:Chunking:RoutingHint"]</p>
                <div class="route-list">
                    @foreach (var route in _routes)
                    {
                        <article class="route-editor" @key="route.Extension">
                            <div class="route-identity"><code class="extension-key">@route.Extension</code><div><span>@L["RAG:Chunker:Current"]</span><strong>@ChunkerName(route.CurrentChunkerId)</strong><code>@route.CurrentChunkerId</code></div></div>
                            <div class="route-controls">
                                <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="string" @ref="route.TargetControl" Value="@route.SelectedChunkerId" ValueChanged="@((string target) => OnRouteTargetChangedAsync(route, target))" Label="@L["RAG:Chunker:Target"]" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@MutationBusy">
                                    @foreach (var candidate in route.CandidateChunkerIds) { <MudSelectItem T="string" Value="@candidate">@ChunkerName(candidate) · @candidate</MudSelectItem> }
                                </MudSelect>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ApplyRouteChangeAsync(route))" Disabled="@(!route.IsApplying && (route.IsPreviewing || !Changed(route)))" aria-disabled="@(MutationBusy ? "true" : "false")">@(route.IsApplying ? L["KnowledgeWorkbench:Chunking:Applying"] : L["RAG:Chunker:Apply"])</MudButton>
                            </div>
                            @if (Changed(route))
                            {
                                <div class="route-impact" aria-live="polite">
                                    @if (route.IsPreviewing) { <div class="inline-loading"><MudProgressCircular Indeterminate="true" Size="Size.Small" /> @L["KnowledgeWorkbench:Chunking:CheckingImpact"]</div> }
                                    else if (!string.IsNullOrWhiteSpace(route.Error)) { <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Dense="true">@route.Error</MudAlert><MudButton Size="Size.Small" Disabled="@MutationBusy" OnClick="@(() => RetryPreviewAsync(route))">@L["KnowledgeWorkbench:Chunking:RetryPreview"]</MudButton> }
                                    else if (route.Preview is { } preview)
                                    {
                                        @if (preview.AffectedDocumentCount > 0)
                                        {
                                            <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning" Dense="true">@L["KnowledgeWorkbench:Chunking:ImpactCount", preview.AffectedDocumentCount]</MudAlert>
                                            <p>@L["KnowledgeWorkbench:Chunking:AffectedBases"]</p><div class="affected-bases">@foreach (var id in preview.AffectedKnowledgeBaseIds) { <code>@id</code> }</div>
                                        }
                                        else { <p class="zero-impact">@L["KnowledgeWorkbench:Chunking:ZeroImpact"]</p> }
                                    }
                                    else { <p>@L["KnowledgeWorkbench:Chunking:ImpactNotChecked"]</p><MudButton Size="Size.Small" Disabled="@MutationBusy" OnClick="@(() => RetryPreviewAsync(route))">@L["KnowledgeWorkbench:Chunking:RetryPreview"]</MudButton> }
                                </div>
                            }
                        </article>
                    }
                    @if (_routes.Count == 0) { <MoContentState Compact="true">@L["KnowledgeWorkbench:Chunking:NoRoutes"]</MoContentState> }
                </div>
            </section>
            <section class="test-panel">
                <h2>@L["RAG:Chunker:TestTitle"]</h2><p class="section-description">@L["KnowledgeWorkbench:Chunking:TestHint"]</p>
                <div class="test-form">
                    <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="string" @bind-Value="_testChunkerId" Label="@L["RAG:Chunker:TestChunker"]" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_chunkers.Count == 0)">
                        @foreach (var chunker in _chunkers) { <MudSelectItem T="string" Value="@chunker.ChunkerId">@chunker.DisplayName · @chunker.ChunkerId</MudSelectItem> }
                    </MudSelect>
                    <MudTextField T="string" @bind-Value="_testDocumentName" Immediate="true" Label="@L["RAG:Chunker:TestDocument"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudTextField T="string" @bind-Value="_testContent" Immediate="true" Label="@L["RAG:Chunker:TestContent"]" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="10" />
                    <div class="test-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Flask" Disabled="@(_isTesting || string.IsNullOrWhiteSpace(_testChunkerId))" OnClick="RunChunkerTestAsync">@(_isTesting ? L["KnowledgeWorkbench:Chunking:Testing"] : L["RAG:Chunker:RunTest"])</MudButton></div>
                </div>
                @if (_isTesting) { <MoContentState Loading="true" Compact="true"><MudProgressCircular Indeterminate="true" Size="Size.Small" /> @L["KnowledgeWorkbench:Chunking:Testing"]</MoContentState> }
                else if (!string.IsNullOrWhiteSpace(_testError)) { <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_testError</MudAlert> }
                else if (_testResult is { } test)
                {
                    <div class="test-result"><strong>@L["RAG:Chunker:TestChunkCount", test.Chunks.Count]</strong><p>@test.DocumentName · @ChunkerName(test.ChunkerId)</p><code>@test.ChunkerId</code>
                        @if (TestInputsChanged) { <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Dense="true">@L["KnowledgeWorkbench:Chunking:TestChanged"]</MudAlert> }
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="ShowTestChunkPreviewAsync">@L["KnowledgeWorkbench:Chunking:InspectBoundaries"]</MudButton>
                    </div>
                }
            </section>
        </div>
        <section class="registry-panel"><h2>@L["RAG:Chunker:Registered"]</h2>
            <div class="registry-table-owner">
                <MudTable T="ChunkerDescriptor" Items="@_chunkers" Dense="true" Hover="true" Elevation="0" Square="true" Breakpoint="Breakpoint.Xs" Class="registry-table">
                    <HeaderContent><MudTh>@L["RAG:Chunker:Name"]</MudTh><MudTh>@L["RAG:Chunker:Description"]</MudTh><MudTh>@L["RAG:Chunker:Extensions"]</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["RAG:Chunker:Name"]"><div class="registry-name"><strong>@context.DisplayName</strong><code>@context.ChunkerId</code></div></MudTd>
                        <MudTd DataLabel="@L["RAG:Chunker:Description"]">@context.Description</MudTd>
                        <MudTd DataLabel="@L["RAG:Chunker:Extensions"]"><div class="registry-extensions">@foreach (var extension in context.SupportedExtensions) { <code>@extension</code> }</div></MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MoContentState Compact="true">@L["KnowledgeWorkbench:Chunking:NoChunkers"]</MoContentState></NoRecordsContent>
                </MudTable>
            </div>
        </section>
    }
</div>
