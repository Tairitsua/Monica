@using Monica.UI.Shared.Components.States
@using Monica.Framework.UI.Localization
@using Monica.Framework.UI.UIObservableInstance.Models
@inject IStringLocalizer<ObservableInstanceResource> L

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MoIcon Icon="@MoIcons.Info" Size="1.5rem" />
            <MudText Typo="Typo.h6">@L["Detail:Title"]</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (Instance != null)
        {
            <ObservableInstanceDetailPanel Instance="Instance" />
        }
        else
        {
            <MoContentState Compact="true"><MoIcon Icon="@MoIcons.Info" Size="1.5rem" /><p>@L["Shared:States:NoInstanceSelected"]</p></MoContentState>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary">@L["Shared:Actions:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public ObservableInstanceViewModel? Instance { get; set; }

    private void Close()
    {
        MudDialog.Close();
    }
}
