@using Monica.JobScheduler.UI.Localization
@using Monica.UI.Shared.Components.Dialogs

<MudDialog Gutters="false" TitleClass="pa-0" ContentClass="pa-0" ActionsClass="pa-0"
           Style="position:fixed;inset-block:0;inset-inline-end:0;width:min(520px,100vw);max-width:100vw;height:100dvh;max-height:100dvh;margin:0;border-radius:0;">
    <TitleContent>
        <div class="execution-detail__dialog-title">
            <MoIcon Icon="@MoIcons.ClipboardCheck" Size="1.5rem" />
            <div class="execution-detail__identity">
                <p>@L["ExecutionDetail:Title"] · @(_state?.Execution is { } selected ? JobSchedulerUiPresentation.GetJobDisplayName(selected.Template) : "—")</p>
                <MoDialogHeading Text="@($"#{JobSchedulerUiPresentation.ShortIdentity(InstanceId)}")" />
                @if (_state?.Execution is { } headerExecution)
                {
                    <div class="execution-detail__flags"><span data-state="@headerExecution.State.ToString().ToLowerInvariant()">@L[$"ExecutionStates:{headerExecution.State}"]</span><small>@L[$"ExecutionOrigins:{headerExecution.Origin}"]</small></div>
                }
            </div>
            <MudTooltip Text="@L["Common:Refresh"]">
                <MudIconButton Icon="@MoIcons.Refresh" aria-disabled="@(_state is null || _state.IsLoading ? "true" : "false")"
                               OnClick="RefreshAsync" aria-label="@L["Common:Refresh"]" />
            </MudTooltip>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="execution-detail__viewport">
            @if (_state is not { } state || !state.AccessChecked || state.IsLoading && !state.HasLoadedSnapshot)
            {
                <div class="execution-detail__empty" role="status">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    <MudText Typo="Typo.body2">@L["Common:Loading"]</MudText>
                </div>
            }
            else if (!state.IsAuthorized)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">
                    @(state.Error ?? L["Access:DeniedDescription"].Value)
                </MudAlert>
            }
            else if (state.Error is not null && !state.HasLoadedSnapshot)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">@state.Error</MudAlert>
            }
            else if (state.IsNotFound)
            {
                <div class="execution-detail__empty" role="status">
                    <MoIcon Icon="@MoIcons.FileSearch" Size="2.25rem" />
                    <h3>@L["ExecutionDetail:NotFound"]</h3>
                    <code>@InstanceId</code>
                    @if (state.Error is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@MoIcons.Warning">@state.Error</MudAlert>
                    }
                </div>
            }
            else if (state.Execution is { } execution && state.ObservedAtUtc is { } observedAtUtc)
            {
                <div class="execution-detail">
                    @if (state.IsLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" aria-label="@L["Common:Loading"]" />
                    }
                    @if (state.Error is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Warning">@L["ExecutionDetail:RefreshFailed", state.Error]</MudAlert>
                    }
                    @if (execution.CancellationRequestedAtUtc.HasValue && !execution.IsTerminal)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Warning">
                            @L["ExecutionDetail:CancellationPending", TimePresentation.FormatExecutionTimestamp(execution.CancellationRequestedAtUtc)]
                        </MudAlert>
                    }
                    <div class="execution-detail__destinations">
                        <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Copy" OnClick="CopyInstanceIdAsync">@L["Workspace:CopyId"]</MudButton>
                        @if (!Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.StartsWith(JobExecutionsPage.PAGE_URL, StringComparison.OrdinalIgnoreCase))
                        {
                            <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.ArrowRight" OnClick="OpenExecutionLedger">@L["Workspace:OpenLedger"]</MudButton>
                        }
                        <MudButton Variant="Variant.Text" StartIcon="@MoIcons.ArrowUpRight" OnClick="OpenJobDetails">@L["ExecutionDetail:Actions:ViewCatalog"]</MudButton>
                    </div>
                    <ExecutionDetailHero Execution="@execution" ObservedAtUtc="@observedAtUtc" />
                    <ExecutionHistoryLedger Entries="@execution.History" />
                    <ExecutionEvidenceFacts Execution="@execution" ObservedAtUtc="@observedAtUtc" />
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">@L["Executions:SnapshotUnavailable"]</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="execution-detail__actions">
            <div class="execution-detail__secondary-actions">
                <MudButton Variant="Variant.Text" StartIcon="@MoIcons.Copy"
                           Disabled="@(_state?.Execution is null)" OnClick="CopyDiagnosticsAsync">
                    @L["ExecutionDetail:Actions:CopySnapshot"]
                </MudButton>
                <MudMenu Icon="@MoIcons.MoreHorizontal" AriaLabel="@L["ExecutionDetail:Actions:More"]">
                    <MudMenuItem Icon="@MoIcons.Refresh" Disabled="@(_state is null || _state.IsLoading)" OnClick="RefreshAsync">
                        @L["Common:Refresh"]
                    </MudMenuItem>
                    <MudMenuItem Icon="@MoIcons.Package" OnClick="OpenJobDetails">
                        @L["ExecutionDetail:Actions:ViewCatalog"]
                    </MudMenuItem>
                </MudMenu>
            </div>
            <div class="execution-detail__primary-actions">
                @if (_state?.Execution is { } execution && (!execution.IsTerminal || _retainCancellationOpener))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                               aria-disabled="@(_state.IsMutating || execution.IsTerminal ? "true" : "false")" OnClick="@(() => CancelAsync(execution))">
                        @L["Executions:Actions:Cancel"]
                    </MudButton>
                }
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">@L["Common:Close"]</MudButton>
            </div>
        </div>
    </DialogActions>
</MudDialog>
