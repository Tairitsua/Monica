@using Microsoft.Extensions.Options
@using Monica.Modules
@inject IOptions<ModuleHealthCheckOption> Options
@inject IStringLocalizer<HealthCheckResource> L
@inject NavigationManager Nav

@if (Session.Snapshot is { } snapshot)
{
    var ready = GateEntries("ready");
    var live = GateEntries("live");
    var other = GateEntries("other");
    var readyRole = Role(ready);
    var overlap = ready.Where(entry => HealthCheckPageSession.MatchesProbe(entry, "live")).ToArray();
    var slowest = snapshot.Entries.MaxBy(entry => entry.Duration);
    var wall = HealthCheckDisplay.Wall(snapshot);
    <section class="hc-sig mo-vl-surface @readyRole.ToCssClass() @(ready.Length == 0 ? "is-unconfigured" : null)" aria-label="@L["Design:ReadinessLabel"]">
        <div class="hc-decision">
            <div class="hc-decision-main">
                <div class="display-label">
                    <span>@L["Design:ReadinessLabel"]</span>
                    @if (PathFor("ready") is { } path) { <code class="hc-path-tag">@path · ready</code> }
                    <span class="hc-http-stamp @(ready.Length == 0 ? "is-unconfigured" : null)">@Http(ready, "ready")</span>
                </div>
                <div class="hc-verdict">
                    <i class="hc-verdict-mark @(ready.Length == 0 ? "is-hatch" : null)" aria-hidden="true"></i><span>@Verdict(ready, "ready")</span>
                </div>
                <p class="hc-pop-caption">@L["Gates:Population", ready.Count(IsHealthy), ready.Length, snapshot.Entries.Count]</p>
            </div>
            <p class="hc-finding">
                @if (ready.Length == 0)
                {
                    @L["Overview:CoverageMissingDescription"]
                }
                else if (PathFor("ready") is not null && ready.FirstOrDefault(IsUnhealthy) is { } blocker)
                {
                    <MoRichFinding Template="@L["Overview:BlockingFinding"].Value" Values="@([Check(blocker), Mark(Duration(blocker.Duration), MoVisualRole.Error),
                         Mark(HealthCheckDisplay.ShareText(blocker.Duration, wall, L), MoVisualRole.Info)])" />
                }
                else if (PathFor("live") is not null && live.FirstOrDefault(IsUnhealthy) is { } livenessBlocker)
                {
                    <MoRichFinding Template="@L["Overview:LivenessFinding"].Value" Values="@([Mark(PathFor("live")!, MoVisualRole.Info), Check(livenessBlocker),
                         Mark(Duration(livenessBlocker.Duration), MoVisualRole.Error), Mark(Verdict(ready, "ready"), readyRole)])" />
                }
                else if (ready.Any(entry => entry.Status == HealthCheckState.Degraded))
                {
                    @L["Overview:ReadyDegraded"]
                }
                else if (ready.All(IsHealthy) && live.All(IsHealthy) && slowest is not null)
                {
                    <MoRichFinding Template="@L["Overview:CalmFinding"].Value" Values="@([Mark(ready.Length, MoVisualRole.Success), Mark(live.Length, MoVisualRole.Success),
                         Mark(Duration(snapshot.Duration), MoVisualRole.Info), Check(slowest, MoVisualRole.Info), Mark(Duration(slowest.Duration), MoVisualRole.Info)])" />
                }
                else
                {
                    @L[ready.Any(IsUnhealthy) ? "Overview:NotReady" : "Overview:Ready"]
                }
                @if (ready.Where(IsDegraded).ToArray() is { Length: > 0 } degraded)
                {
                    @(" ")<MoRichFinding Template="@L["Overview:DegradesFinding"].Value" Values="@([Checks(degraded)])" />
                }
                @if (live.Length > 0 && live.All(IsHealthy) && !ready.All(IsHealthy))
                {
                    @(" ")<MoRichFinding Template="@L["Overview:LivenessPassFinding"].Value" Values="@([Mark(live.Length, MoVisualRole.Success)])" />
                }
                @if (other.Where(entry => !IsHealthy(entry)).ToArray() is { Length: > 0 } attention)
                {
                    @(" ")<MoRichFinding Template="@L["Overview:AuxFinding"].Value" Values="@([Checks(attention)])" />
                }
            </p>
        </div>
        <div class="hc-gates-wrap">
            <div class="hc-gates" role="group" aria-label="@L["Design:ReadinessLabel"]">
                @Gate("ready", "Design:ReadinessLabel", ready, MoVisualRole.Primary)
                @Gate("live", "Design:LivenessLabel", live, MoVisualRole.Info)
                @Gate("other", "Design:AuxiliaryLabel", other, MoVisualRole.Neutral)
                <div class="hc-gate hc-gate-wall">
                    <span class="hc-gate-top">
                        <span class="hc-gate-head"><i class="mo-vl-swatch mo-vl-swatch--instrument mo-vl-role--info" aria-hidden="true"></i><strong>@L["Design:EnvelopeLabel"]</strong></span>
                        <span class="hc-gate-badge mo-vl-role--info">@L["Design:AllParallelCaption", snapshot.Entries.Count]</span>
                    </span>
                    <span class="hc-wall-value">@Duration(snapshot.Duration)</span>
                    <span class="hc-wall-meta">
                        @if (slowest is not null)
                        {
                            var text = L["Design:SlowestCaption", slowest.Name, Duration(slowest.Duration)];
                            <span class="hc-wall-slowest" title="@text">@text</span>
                        }
                        <span class="hc-wall-pit">@L["Design:PointInTime"]</span>
                    </span>
                </div>
            </div>
            @if (overlap.Length != 0)
            {
                <p class="hc-overlap-note"><MoIcon Icon="@MoIcons.Info" Size="13px" /><span>@L["Gates:Overlap", string.Join(", ", overlap.Select(entry => entry.Name)), snapshot.Entries.Count]</span></p>
            }
        </div>

        <HealthCheckEnvelope Snapshot="@snapshot" EntryName="@EntryName" Stale="@(Session.RefreshError is not null)" />
    </section>
}

@code {
    [Parameter, EditorRequired] public HealthCheckPageSession Session { get; set; } = default!;
    [Parameter] public string? EntryName { get; set; }

    private HealthCheckEntrySnapshot[] GateEntries(string gate) => Session.Snapshot!.Entries
        .Where(entry => HealthCheckPageSession.MatchesProbe(entry, gate)).OrderByDescending(entry => entry.Status)
        .ThenByDescending(entry => entry.Duration).ToArray();
    private static bool IsHealthy(HealthCheckEntrySnapshot entry) => entry.Status == HealthCheckState.Healthy;
    private static bool IsUnhealthy(HealthCheckEntrySnapshot entry) => entry.Status == HealthCheckState.Unhealthy;
    private static bool IsDegraded(HealthCheckEntrySnapshot entry) => entry.Status == HealthCheckState.Degraded;
    private static MoVisualRole Role(HealthCheckEntrySnapshot[] entries) =>
        entries.Length == 0 ? MoVisualRole.Neutral : HealthCheckDisplay.Role(entries.Max(entry => entry.Status));

    private RenderFragment Gate(string key, string title, HealthCheckEntrySnapshot[] entries, MoVisualRole category)
    {
        var selected = Session.Probe == key;
        var role = Role(entries);
        var unconfigured = entries.Length == 0;
        var sub = key == "other" ? L["Design:AuxiliaryNote"].Value : PathFor(key) is { } path ? $"{path} · {key}" : L["Design:EndpointDisabled"].Value;
        return @<button type="button" class="hc-gate @category.ToCssClass() @(selected ? "is-selected" : null) @(unconfigured ? "is-unconfigured" : null)"
                        aria-pressed="@(selected ? "true" : "false")" @onclick="@(() => Filter(key))">
            <span class="hc-gate-top">
                <span class="hc-gate-head"><i class="mo-vl-swatch mo-vl-swatch--instrument @(unconfigured ? "is-hatch" : null) @category.ToCssClass()" aria-hidden="true"></i><strong>@L[title]</strong></span>
                <span class="hc-gate-badge @role.ToCssClass() @(unconfigured ? "is-unconfigured" : null)">@Http(entries, key)</span>
            </span>
            <span class="hc-gate-mid"><span class="hc-gate-verdict @role.ToCssClass()">@Verdict(entries, key)</span><code class="hc-gate-sub" title="@sub">@sub</code></span>
            <span class="hc-marks" aria-hidden="true">
                @if (unconfigured) { <i class="hc-mark-hatch"></i> }
                else
                {
                    @foreach (var entry in entries)
                    {
                        <i class="hc-mark @HealthCheckDisplay.Role(entry.Status).ToCssClass() @(IsDegraded(entry) ? "is-degraded" : IsUnhealthy(entry) ? "is-unhealthy" : null)"></i>
                    }
                }
            </span>
            <span class="hc-gate-tally">
                @foreach (var status in Enum.GetValues<HealthCheckState>().Reverse())
                {
                    var count = entries.Count(entry => entry.Status == status);
                    <span class="hc-gate-count @(count == 0 ? "is-zero" : null)">
                        <i class="mo-vl-swatch @(status == HealthCheckState.Degraded ? "mo-vl-swatch--diamond" : null) @(count == 0 ? "mo-vl-swatch--empty" : null) @HealthCheckDisplay.Role(status).ToCssClass()" aria-hidden="true"></i>
                        <b class="mo-vl-mono">@count</b><span>@L.GetStatusText(status)</span>
                    </span>
                }
            </span>
        </button>;
    }

    private string Verdict(HealthCheckEntrySnapshot[] entries, string key)
    {
        if (entries.Length == 0) return L["Design:UnconfiguredShort"];
        if (key == "other") return L["Gates:Summary", entries.Count(IsHealthy), entries.Length];
        return L[(key, entries.Max(entry => entry.Status)) switch
        {
            ("live", HealthCheckState.Healthy) => "Design:LivenessHeadlines:Healthy",
            ("live", HealthCheckState.Degraded) => "Design:LivenessHeadlines:Degraded",
            ("live", _) => "Design:LivenessHeadlines:Unhealthy",
            (_, HealthCheckState.Healthy) => "Design:Headlines:Healthy",
            (_, HealthCheckState.Degraded) => "Design:Headlines:Degraded",
            _ => "Design:Headlines:Unhealthy"
        }];
    }

    private string? PathFor(string key) => key switch
    {
        "ready" when Options.Value.EnableReadinessEndpoint => Options.Value.ReadinessPath,
        "live" when Options.Value.EnableLivenessEndpoint => Options.Value.LivenessPath,
        _ => null
    };

    private string Http(HealthCheckEntrySnapshot[] entries, string key) => key == "other" ? L["Design:ObservedOnly"].Value
        : entries.Length == 0 || PathFor(key) is null ? "HTTP —"
        : entries.Any(IsUnhealthy) ? "HTTP 503" : "HTTP 200";

    private string Duration(TimeSpan duration) => HealthCheckDisplay.Duration(duration, L);
    private static RenderFragment Mark(object value, MoVisualRole role) => @<MoValueMark Role="@role">@value</MoValueMark>;
    private RenderFragment Check(HealthCheckEntrySnapshot entry, MoVisualRole? role = null) =>
        @<MoValueMark Role="@(role ?? HealthCheckDisplay.Role(entry.Status))" Href="@Nav.GetUriWithQueryParameter("entry", entry.Name)"><code>@entry.Name</code></MoValueMark>;
    private RenderFragment Checks(HealthCheckEntrySnapshot[] entries) =>
        @<text>@for (var index = 0; index < entries.Length; index++)
        {
            if (index > 0) { @L["Common:ListSeparator"] }
            @Check(entries[index])
        }</text>;
    private void Filter(string id) => Nav.NavigateTo(Nav.GetUriWithQueryParameter("probe", Session.Probe == id ? null : id), replace: true);
}
