@inject ConfigurationValueVisibility Visibility
@using Monica.Configuration.UI.Localization
@using Monica.UI.UIDiffHighlight.Models
@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L
@implements IAsyncDisposable

<div class="configuration-history-diff-preview">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_error is not null)
    {
        <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_acceptedRowCount == 0)
    {
        <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["History:Dialog:NoPreview"]</MudAlert>
    }
    else
    {
        <p class="configuration-history-diff-direction">@(IsRollbackPreview ? L["History:Dialog:RollbackDirection"] : L["History:Dialog:DiffDirection"])</p>
        <div class="configuration-history-diff-paint-owner">
            <DiffViewer OriginText="@_originText" NewText="@_targetText" Options="@_diffOptions" ViewMode="@ViewMode" />
        </div>
    }
</div>

@code {
    private readonly ConfigurationOperationLifetime _operations = new();
    private readonly DiffHighlightOptions _diffOptions = new()
    {
        Mode = EDiffHighlightMode.Line,
        ContextLines = 4,
        MaxCharacterDiffLength = 5000
    };
    private readonly Dictionary<string, ConfigurationDefinition> _definitions = new(StringComparer.OrdinalIgnoreCase);
    private string _originText = "null";
    private string _targetText = "null";
    private string? _inputIdentity;
    private string? _error;
    private long _generation;
    private int _acceptedRowCount;
    private bool _loading;

    /// <summary>Gets immutable history rows used to construct a redacted comparison.</summary>
    [Parameter] public IReadOnlyList<ConfigurationValueHistory> Rows { get; set; } = [];
    /// <summary>Gets whether the comparison shows the current target against a rollback target.</summary>
    [Parameter] public bool IsRollbackPreview { get; set; }
    /// <summary>Gets the initial native diff view; the default is unified.</summary>
    [Parameter] public EDiffViewMode ViewMode { get; set; } = EDiffViewMode.Unified;
    /// <summary>Gets authoritative current target values bound to the supplied rollback preview identity.</summary>
    [Parameter] public IReadOnlyDictionary<string, ConfigurationStoredValue?> CurrentValuesByHistoryId { get; set; } =
        new Dictionary<string, ConfigurationStoredValue?>(StringComparer.OrdinalIgnoreCase);
    /// <summary>Gets an optional preview identity that invalidates comparison inputs, such as a rollback plan token.</summary>
    [Parameter] public string? PreviewIdentity { get; set; }
    /// <summary>Gets a loading callback; actual callbacks are drained and never started after retirement.</summary>
    [Parameter] public EventCallback<bool> LoadingChanged { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_operations.IsRetired) return;
        var rows = Rows.ToArray();
        var rollback = IsRollbackPreview;
        var identity = $"{rollback}:{PreviewIdentity}:{string.Join('\u001f', rows.Select(static row => row.HistoryId))}";
        if (string.Equals(_inputIdentity, identity, StringComparison.Ordinal)) return;
        var current = new Dictionary<string, ConfigurationStoredValue?>(CurrentValuesByHistoryId, StringComparer.OrdinalIgnoreCase);
        var definitions = new Dictionary<string, ConfigurationDefinition>(_definitions, StringComparer.OrdinalIgnoreCase);
        var loadingChanged = LoadingChanged;
        var generation = ++_generation;
        // Reserve the identity before a parent callback can re-enter parameter processing.
        _inputIdentity = identity;
        _loading = true;
        _error = null;
        try
        {
            await _operations.RunAsync(async token =>
            {
                try
                {
                    token.ThrowIfCancellationRequested();
                    await loadingChanged.InvokeAsync(true);
                    token.ThrowIfCancellationRequested();
                    foreach (var key in rows.Select(row => row.DefinitionKey).Distinct(StringComparer.OrdinalIgnoreCase))
                    {
                        if (definitions.ContainsKey(key)) continue;
                        var result = await Facade.GetDefinitionAsync(key);
                        token.ThrowIfCancellationRequested();
                        var detail = result.Data;
                        if (!result.IsFailure() && detail is not null) definitions[key] = detail.Definition;
                    }

                    // Schema age alone does not make a known ordinary path sensitive.
                    bool Sensitive(ConfigurationValueHistory row) => ConfigurationHistoryValuePrivacy.IsSensitive(row, definitions, Visibility.ShowSensitiveValues);
                    string Display(string key) => definitions.TryGetValue(key, out var definition) ? definition.DisplayName : key;
                    var origin = ConfigurationHistoryDiffSnapshotBuilder.BuildOriginSnapshot(rows, rollback, current, Sensitive, Display, TargetDisplay, L["State:Value:Sensitive"]);
                    var target = ConfigurationHistoryDiffSnapshotBuilder.BuildTargetSnapshot(rows, rollback, Sensitive, Display, TargetDisplay, L["State:Value:Sensitive"]);
                    token.ThrowIfCancellationRequested();
                    _operations.TryApply(() =>
                    {
                        if (generation != _generation) return;
                        foreach (var pair in definitions) _definitions[pair.Key] = pair.Value;
                        _originText = origin;
                        _targetText = target;
                        _acceptedRowCount = rows.Length;
                    });
                }
                catch (OperationCanceledException) when (token.IsCancellationRequested) { }
                catch (Exception exception) when (!_operations.IsRetired)
                {
                    _operations.TryApply(() =>
                    {
                        if (generation != _generation) return;
                        _inputIdentity = null;
                        _error = exception.Message;
                    });
                }
                finally
                {
                    if (!_operations.IsRetired && generation == _generation)
                    {
                        _operations.TryApply(() => _loading = false);
                        await loadingChanged.InvokeAsync(false);
                    }
                }
            });
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
    }

    private string TargetDisplay(ConfigurationValueHistory row)
    {
        if (row.TargetKind == ConfigurationMutationTargetKind.MonicaEffectiveStore) return L["History:Targets:Monica"];
        var name = row.SourceDisplayName ?? L["History:Targets:External"];
        return string.IsNullOrWhiteSpace(row.SourcePhysicalPath) ? name : $"{name} [{row.SourcePhysicalPath}]";
    }

    /// <summary>Retires comparison requests and joins actual definition loads and loading callbacks.</summary>
    public ValueTask DisposeAsync() => _operations.RetireAsync();
}