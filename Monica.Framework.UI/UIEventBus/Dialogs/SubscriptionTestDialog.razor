@using Monica.UI.Shared.Components.Json
@using Monica.UI.Shared.Components.States
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.Core.Results
@using Monica.Core.TypeDiscovery.Abstractions
@using Monica.EventBus.Models
@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.State
@using Monica.Framework.UI.UIEventBus.Support
@using Monica.UI.Shared.Components.Dialogs
@implements IAsyncDisposable
@inject EventBusTestService TestService
@inject IStringLocalizer<EventBusResource> L


@using Monica.EventBus.Abstractions

<MudDialog Style="width: min(760px, calc(100% - 32px)); max-width: none; margin: 16px; max-height: calc(100dvh - 32px);">
    <TitleContent>
        <div class="runtime-test-dialog-title">
            <span class="runtime-test-dialog-icon"><MoIcon Icon="@MoIcons.Flask" Size="18px" /></span>
            <div>
                <MoDialogHeading Text="@L["SubscriptionTestDialog:Title", _subscription?.EventTypeShortName ?? L["Shared:Labels:Unknown"].Value]" />
                @if (_subscription is not null) { <code>@_subscription.EventType</code> }
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="runtime-test">
            @if (_subscription is null || _subscriptionId is null)
            {
                <MoContentState Compact="true"><MoIcon Icon="@MoIcons.Info" Size="1.5rem" /><p>@L["SubscriptionTestDialog:States:NotSelected"]</p></MoContentState>
            }
            else
            {
                var listenerBlocked = !_listenerSnapshot.IsListening && _subscription.Activation != ActivationMode.Automatic;
                <div class="runtime-test-target">
                    <span class="mo-vl-status mo-vl-status--pill @EventBusVisuals.Role(_subscription.State).ToCssClass()">
                        <span class="mo-vl-status-dot"></span>@L.GetSubscriptionStateText(_subscription.State)
                    </span>
                    <EventBusTransportBadge Distributed="@(_subscription.Scope == EventSubscriptionScope.Distributed)" Kind="@ProviderKind" ServiceKey="@_subscription.ServiceKey" />
                    <code class="runtime-test-topic">@_subscription.TopicName</code>
                </div>
                <div class="runtime-test-warning"><MoIcon Icon="@MoIcons.Info" Size="16px" /><p>@L["RuntimeTest:Fanout"]</p></div>
                <div class="runtime-test-workspace">
                    <section class="runtime-test-column">
                        <header class="runtime-test-heading"><h3>@L["RuntimeTest:Compose"]</h3></header>
                        <div class="runtime-test-editor">
                            <MoJson Value="@_jsonPayload" ValueChanged="EditPayload" ReadOnly="false" Rows="9" Label="@L["RuntimeTest:Compose"]"
                                    ShowLineNumbers="false" ShowToolbar="false" ShowStatus="false"
                                    Disabled="@(Inactive || _commandBusy || _replayLocalMessage)" />
                            @if (!string.IsNullOrWhiteSpace(_validationMessage))
                            {
                                <p class="runtime-test-validation" data-error="@(_hasValidationError ? "true" : "false")" role="status">@_validationMessage</p>
                            }
                            <div class="runtime-test-editor-actions">
                                <div>
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" OnClick="ValidateJson" Disabled="@Inactive" aria-disabled="@BusyAttribute">@L["SubscriptionTestDialog:Actions:ValidateJson"]</MudButton>
                                    <MudButton Size="Size.Small" Color="Color.Default" OnClick="LoadSampleJson" Disabled="@(Inactive || _replayLocalMessage)" aria-disabled="@BusyAttribute">@L["SubscriptionTestDialog:Actions:ResetSample"]</MudButton>
                                </div>
                                <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Primary" StartIcon="@MoIcons.Send" OnClick="PublishAsync" Disabled="@(Inactive || _replayLocalMessage)"
                                           aria-disabled="@BusyAttribute" aria-busy="@(_publishing ? "true" : "false")">
                                    @(_publishing ? L["SubscriptionTestDialog:Actions:Publishing"] : L["SubscriptionTestDialog:Actions:PublishEvent"])
                                </MudButton>
                            </div>
                            <div class="runtime-test-local">
                                <p class="runtime-test-note">@L["RuntimeTest:LocalDeliveryHelp"]</p>
                                <MudCheckBox T="bool" Value="_replayLocalMessage" ValueChanged="SetReplayLocalMessage" Label="@L["RuntimeTest:ReplayMessage"]"
                                             Dense="true" Disabled="@(Inactive || _commandBusy || _localMessage is null)" />
                                @if (_localMessage is not null)
                                {
                                    <p class="runtime-test-note">@L["RuntimeTest:MessageIdentity", _localMessage.Metadata.MessageId ?? string.Empty]</p>
                                }
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" StartIcon="@MoIcons.Play" OnClick="DeliverLocallyAsync"
                                           Disabled="@(Inactive || _commandBusy || !_subscription.CanDeliverLocally)" aria-busy="@(_deliveringLocally ? "true" : "false")">
                                    @(_deliveringLocally ? L["RuntimeTest:DeliveringLocally"] : L["RuntimeTest:DeliverLocally"])
                                </MudButton>
                                @if (!_subscription.CanDeliverLocally)
                                {
                                    <p class="runtime-test-note">@L["Services:Test:LocalTargetUnavailable"]</p>
                                }
                            </div>
                        </div>
                    </section>
                    <section class="runtime-test-column">
                        <header class="runtime-test-heading">
                            <h3>@L["RuntimeTest:Receive"]</h3><span class="mo-vl-status mo-vl-status--pill mo-vl-role--@(_listenerSnapshot.IsListening ? "success" : "neutral")">
                                <span class="mo-vl-status-dot"></span>@(_listenerSnapshot.IsListening ? L["TestBench:Listening"] : L["TestBench:Stopped"])
                            </span>
                        </header>
                        <p class="runtime-test-note">@L["RuntimeTest:ReceiveHelp", TestService.RuntimeReceiptLimit]</p>
                        <div class="runtime-test-listener-actions">
                            <MudButton Class="@(_listenerSnapshot.IsListening ? "is-stopping" : "is-starting")" Variant="Variant.Text" Size="Size.Small" Color="@(_listenerSnapshot.IsListening ? Color.Warning : Color.Info)"
                                       StartIcon="@(_listenerSnapshot.IsListening ? MoIcons.StopCircle : MoIcons.Play)" OnClick="ToggleListeningAsync"
                                       Disabled="@(Inactive || _commandBusy || listenerBlocked)"
                                       aria-disabled="@BusyAttribute" aria-busy="@(_listenerBusy ? "true" : "false")">
                                @(_listenerSnapshot.IsListening ? L["SubscriptionTestDialog:Actions:StopListening"] : L["SubscriptionTestDialog:Actions:StartListening"])
                            </MudButton>
                            <MudButton Size="Size.Small" Color="Color.Default" OnClick="ClearMessages"
                                       Disabled="@(Inactive || _commandBusy || _listenerSnapshot.MessageCount == 0)">@L["SubscriptionTestDialog:Actions:Clear"]</MudButton>
                        </div>
                        @if (_listenerError is { } error)
                        {
                            <p class="runtime-test-validation" data-error="true" role="alert">@error</p>
                        }
                        else if (listenerBlocked)
                        {
                            <p class="runtime-test-note">@L["RuntimeTest:ListenerBlocked"]</p>
                        }
                        @if (_listenerSnapshot.MessageCount == 0)
                        {
                            <div class="runtime-test-empty"><MoIcon Icon="@MoIcons.Inbox" Size="20px" /><p>@L["SubscriptionTestDialog:States:NoMessages"]</p></div>
                        }
                        else
                        {
                            <ol class="runtime-test-receipts">
                                @foreach (var message in _listenerSnapshot.Messages.Reverse())
                                {
                                    <li @key="message">
                                        <header><span><MoIcon Icon="@MoIcons.ArrowDownLeft" Size="13px" />@L["TestBench:Received"]</span>
                                            <time datetime="@message.ReceivedAt.ToUniversalTime().ToString("O")">@UiTime.FormatTime(message.ReceivedAt)</time>
                                        </header>
                                        <MoJson Value="@message.PayloadJson" ShowLineNumbers="false" ShowToolbar="false" ShowStatus="false" WrapLines="true" FormatOnDisplay="false" />
                                    </li>
                                }
                            </ol>
                        }
                    </section>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions><MudButton Color="Color.Default" Variant="Variant.Outlined" OnClick="Close">@L["SubscriptionTestDialog:Actions:Close"]</MudButton></DialogActions>
</MudDialog>

@code {
    /// <summary>Gets or sets the registry row whose exact event, topic, scope and key are captured for this test.</summary>
    /// <remarks>
    /// Diagnostic payloads are sent immediately through the selected transport or local dispatcher, without
    /// Outbox staging. The scoped test service owns the listener after this dialog closes; the dialog owns
    /// cancellation and draining of its admitted commands and rendering timer.
    /// </remarks>
    [Parameter] public SubscriptionViewModel? Subscription { get; set; }
    /// <summary>Gets or sets the provider kind from the workbench's captured route.</summary>
    [Parameter] public EventBusProviderKind ProviderKind { get; set; } = EventBusProviderKind.Unknown;
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = null!;

    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly object _disposeSync = new();
    private CancellationToken _lifetimeToken;
    private PeriodicTimer? _refreshTimer;
    private Task? _refreshTask;
    private Task? _commandTask;
    private Task? _disposeTask;
    private SubscriptionViewModel? _subscription;
    private EventSubscriptionId? _subscriptionId;
    private RuntimeTestListenerSnapshot _listenerSnapshot = new();
    private string _jsonPayload = "{}";
    private string? _validationMessage;
    private string? _listenerError;
    private bool _hasValidationError;
    private bool _commandBusy;
    private bool _publishing;
    private bool _deliveringLocally;
    private bool _replayLocalMessage;
    private EventMessage? _localMessage;
    private bool _listenerBusy;
    private bool _closed;
    private bool _retired;
    private bool Inactive => _retired || _closed;
    private string BusyAttribute => _commandBusy ? "true" : "false";

    protected override void OnInitialized()
    {
        _lifetimeToken = _lifetimeCancellation.Token;
        _subscription = Subscription is null ? null : EventBusWorkbenchState.CloneSubscription(Subscription);
        if (_subscription is not null && Guid.TryParse(_subscription.SubscriptionId, out var id))
        {
            _subscriptionId = new EventSubscriptionId(id);
            LoadSampleJson();
            RefreshListenerSnapshot();
            _refreshTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
            _refreshTask = RefreshLoopAsync(_refreshTimer, _lifetimeToken);
        }
    }

    private void EditPayload(string value)
    {
        _jsonPayload = value;
        _validationMessage = null;
    }

    private void LoadSampleJson()
    {
        if (Inactive || _commandBusy || _replayLocalMessage || _subscriptionId is not { } id) return;
        var result = TestService.CreateRuntimeJsonSample(id);
        if (result.IsFailure())
        {
            _jsonPayload = "{}";
            _hasValidationError = true;
            _validationMessage = result.Message;
            return;
        }
        _jsonPayload = result.Data ?? "{}";
        _hasValidationError = false;
        _validationMessage = null;
    }

    private void ValidateJson()
    {
        if (Inactive || _commandBusy || _subscriptionId is not { } id) return;
        var result = TestService.ValidateRuntimePayload(id, _jsonPayload);
        if (result.IsFailure())
        {
            _hasValidationError = true;
            _validationMessage = result.Message ?? L["SubscriptionTestDialog:Messages:JsonValidationFailed"];
            return;
        }
        _hasValidationError = false;
        _validationMessage = L["SubscriptionTestDialog:Messages:JsonValidationSucceeded"];
    }

    private Task PublishAsync()
    {
        if (Inactive || _commandBusy || _subscriptionId is not { } id) return Task.CompletedTask;
        var payload = _jsonPayload;
        _publishing = true;
        return AdmitCommandAsync(async () =>
        {
            var result = await TestService.PublishRuntimePayloadAsync(id, payload, _lifetimeToken);
            if (Inactive) return;
            var error = result;
            if (result.IsFailure())
            {
                _hasValidationError = true;
                _validationMessage = error.Message ?? L["SubscriptionTestDialog:Messages:PublishFailed"];
                return;
            }
            _hasValidationError = false;
            _validationMessage = L[_subscription?.Scope == EventSubscriptionScope.Local
                ? "RuntimeTest:LocalDispatchCompleted"
                : "RuntimeTest:DistributedAccepted"];
        });
    }

    private Task ToggleListeningAsync() => _listenerSnapshot.IsListening ? StopListeningAsync() : StartListeningAsync();

    private void SetReplayLocalMessage(bool replay)
    {
        if (Inactive || _commandBusy) return;
        _replayLocalMessage = replay && _localMessage is not null;
        if (_replayLocalMessage) _jsonPayload = System.Text.Encoding.UTF8.GetString(_localMessage!.Body.Span);
    }

    private Task DeliverLocallyAsync()
    {
        if (Inactive || _commandBusy || _subscription?.CanDeliverLocally != true || _subscriptionId is not { } id)
            return Task.CompletedTask;
        if (!_replayLocalMessage)
        {
            var result = TestService.PrepareLocalTestMessage(id, _jsonPayload);
            if (result.IsFailure())
            {
                _hasValidationError = true;
                _validationMessage = result.Message;
                return Task.CompletedTask;
            }
            _localMessage = result.Data;
        }
        if (_localMessage is not { } message) return Task.CompletedTask;
        _deliveringLocally = true;
        return AdmitCommandAsync(async () =>
        {
            var result = await TestService.DeliverLocalTestMessageAsync(id, message, _lifetimeToken);
            if (Inactive) return;
            var error = result;
            if (result.IsFailure())
            {
                _hasValidationError = true;
                _validationMessage = error.Message;
            }
            else
            {
                _hasValidationError = false;
                _validationMessage = L["RuntimeTest:LocalDeliveryCompleted"];
            }
        });
    }

    private Task StartListeningAsync()
    {
        if (Inactive || _commandBusy || _listenerSnapshot.IsListening || _subscriptionId is not { } id) return Task.CompletedTask;
        _listenerBusy = true;
        return AdmitCommandAsync(async () =>
        {
            var result = await TestService.StartRuntimeListenerAsync(id);
            // The scoped service owns this listener, including a start completed after close.
            if (Inactive) return;
            var error = result.WithoutData();
            var snapshot = result.Data;
            if (result.IsFailure())
            {
                _listenerError = error.Message ?? L["SubscriptionTestDialog:Messages:StartListeningFailed"];
                return;
            }
            _listenerSnapshot = snapshot ?? new();
            _listenerError = null;
        });
    }

    private Task StopListeningAsync()
    {
        if (Inactive || _commandBusy || !_listenerSnapshot.IsListening || _subscriptionId is not { } id) return Task.CompletedTask;
        _listenerBusy = true;
        return AdmitCommandAsync(async () =>
        {
            var result = await TestService.StopRuntimeListenerAsync(id);
            if (Inactive) return;
            var error = result;
            if (result.IsFailure())
            {
                _listenerError = error.Message ?? L["SubscriptionTestDialog:Messages:StopListeningFailed"];
                return;
            }
            RefreshListenerSnapshot();
            _listenerError = null;
        });
    }

    private Task AdmitCommandAsync(Func<Task> command)
    {
        if (Inactive || _commandBusy) return Task.CompletedTask;
        _commandBusy = true;
        return _commandTask = ExecuteCommandAsync(command);
    }

    private async Task ExecuteCommandAsync(Func<Task> command)
    {
        try { await command(); }
        finally
        {
            _commandBusy = false;
            _publishing = false;
            _deliveringLocally = false;
            _listenerBusy = false;
            if (!Inactive) StateHasChanged();
        }
    }

    private void ClearMessages()
    {
        if (Inactive || _commandBusy || _listenerSnapshot.MessageCount == 0 || _subscriptionId is not { } id) return;
        TestService.ClearRuntimeListenerMessages(id);
        RefreshListenerSnapshot();
        _listenerError = null;
    }

    private void RefreshListenerSnapshot()
    {
        if (_subscriptionId is { } id) _listenerSnapshot = TestService.GetRuntimeListenerSnapshot(id);
    }

    private async Task RefreshLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(() =>
                {
                    if (Inactive || token.IsCancellationRequested) return;
                    RefreshListenerSnapshot();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Only the rendering timer belongs to the dialog; runtime listeners belong to the service.
        }
    }

    private void Close()
    {
        if (Inactive) return;
        _closed = true;
        MudDialog.Close();
    }

    public ValueTask DisposeAsync()
    {
        lock (_disposeSync) return new(_disposeTask ??= RetireAsync());
    }

    private async Task RetireAsync()
    {
        _retired = true;
        var failures = new List<Exception>();
        var timer = _refreshTimer;
        var refresh = _refreshTask;
        _refreshTimer = null;
        _refreshTask = null;
        try
        {
            try { _lifetimeCancellation.Cancel(); }
            catch (Exception error) { failures.Add(error); }
            try { timer?.Dispose(); }
            catch (Exception error) { failures.Add(error); }
            if (_commandTask is not null)
            {
                try { await _commandTask; }
                catch (OperationCanceledException) when (_lifetimeToken.IsCancellationRequested) { }
                catch (Exception error) { failures.Add(error); }
            }
            if (refresh is not null)
            {
                try { await refresh; }
                catch (Exception error) { failures.Add(error); }
            }
        }
        finally { _lifetimeCancellation.Dispose(); }
        if (failures.Count > 0) throw new AggregateException(failures);
    }
}
