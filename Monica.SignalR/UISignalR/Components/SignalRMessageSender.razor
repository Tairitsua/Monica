@inherits SignalRWorkspaceView

<SignalRKeyboardRegion Class="sr-quick" Selector="button">
    <div class="sr-sig-box"><span class="sr-sig-label">ReceiveTestMessage</span><code class="mono">ReceiveTestMessage(string user, string message)</code><p class="sr-muted">@T("Workspace:QsContract")</p></div>
    <div class="sr-field"><label for="sr-qs-user">@T("Workspace:QsUserLabel")</label><input id="sr-qs-user" class="sr-input" placeholder="@T("Workspace:QsUserPlaceholder")" @bind="S.UserName" @bind:event="oninput" /></div>
    <div class="sr-field"><label for="sr-qs-msg">@T("Workspace:QsMsgLabel")</label><textarea id="sr-qs-msg" class="sr-input sr-textarea" rows="3" placeholder="@T("Workspace:QsMsgPlaceholder")" @bind="S.Message" @bind:event="oninput" @onkeydown="OnKeyDown"></textarea></div>
    <p class="sr-muted">@T(S.ConnectionState.IsConnected ? "Workspace:QsDraftHelp" : "Workspace:QsConnectHelp")</p>
    <div class="sr-form-actions"><button class="sr-btn sr-btn-primary" disabled="@(!CanSend)" @onclick="Send"><MoIcon Icon="@MoIcons.Send" Size="15px" />@T("Workspace:QsSend")</button><button class="sr-btn sr-btn-outline" disabled="@(_sending || string.IsNullOrEmpty(S.Message))" @onclick="() => S.Message = string.Empty">@T("Workspace:QsClear")</button></div>
</SignalRKeyboardRegion>

@code {
    private bool _sending;
    private bool CanSend => S.ConnectionState.IsConnected && !_sending && !string.IsNullOrWhiteSpace(S.Message);
    private Task OnKeyDown(KeyboardEventArgs args) => args.Key == "Enter" && !args.ShiftKey ? Send() : Task.CompletedTask;
    private Task Send() => Context.Run(async () =>
    {
        if (!CanSend) return;
        _sending = true;
        try { await S.SendMessageAsync(); }
        finally { _sending = false; }
    });
}
