@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.EventBus.Models
@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.Support
@using Monica.Framework.UI.Pages
@using Monica.UI.Shared.Components.Navigation

@{ var capture = State.Snapshot; }
<PageTitle>@Title</PageTitle>
<div class="eventbus-workbench" aria-busy="@(State.IsRefreshing ? "true" : "false")">
    <header class="eventbus-workbench-heading">
        <div><span class="eventbus-workbench-kicker">@L["Workbench:Eyebrow"]</span><h1>@Title</h1><p>@Description</p></div>
        <div class="eventbus-workbench-controls">
            <div class="eventbus-capture"><span>@L["Workbench:Captured"]</span><time>@(capture?.CapturedAt is { } captured ? UiTime.Format(captured) : L["Workbench:NoCapture"].Value)</time></div>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.Refresh" OnClick="RefreshAsync" aria-disabled="@(State.IsRefreshing || _retired ? "true" : "false")">@L["Page:Header:Refresh"]</MudButton>
        </div>
    </header>
    <MoWorkbenchNavigation Class="eventbus-workbench-nav" Label="@L["Workbench:Navigation"]">
        @foreach (var section in Enum.GetValues<EventBusWorkbenchView>())
        {
            <a href="@Route(section)" aria-current="@(View == section ? "page" : null)" data-view="@(section)"><MoIcon Icon="@SectionIcon(section)" Size="1.25rem" /><span>@SectionTitle(section)</span>
                @if (capture is { } navigationCapture && section == EventBusWorkbenchView.Subscriptions) { <span class="eventbus-nav-count">@navigationCapture.Subscriptions.Count</span> }
            </a>
        }
    </MoWorkbenchNavigation>
    <div class="eventbus-workbench-sampling"><span>@L["Workbench:Scope"]</span><MudSwitch T="bool" Value="_autoRefresh" ValueChanged="AutoRefreshChanged" Color="Color.Primary" Size="Size.Small" Label="@L["Workbench:AutoRefresh"]" /></div>
    @if (State.RefreshError != null)
    {
        <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Variant="Variant.Outlined"><strong>@L["Workbench:ReadFailed"]</strong><p>@State.RefreshError</p><p>@L[capture == null ? "Workbench:UnavailableHelp" : "Workbench:PreviousCaptureHelp"]</p></MudAlert>
    }
    @if (capture is null)
    {
        @if (State.IsInitialLoading || !State.HasAttemptedCapture) { <div class="eventbus-initial" role="status"><MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" /><p>@L["Workbench:Loading"]</p></div> }
    }
    else if (View == EventBusWorkbenchView.Overview)
    {
        <EventBusOverview Snapshot="capture" OnTopicClick="topic => InspectTopicAsync(topic, capture.CapturedAt)" />
    }
    else if (View == EventBusWorkbenchView.Providers)
    {
        <EventBusProviderList Providers="capture.Providers.ToList()" AllSubscriptions="capture.Subscriptions.ToList()" IsLoading="State.IsRefreshing" OnRefresh="RefreshAsync" OnProviderClick="provider => InspectProviderAsync(provider, capture)" />
    }
    else if (View == EventBusWorkbenchView.Subscriptions)
    {
        <section class="eventbus-registry">
            <SubscriptionFilterPanel Filter="_filter" Providers="capture.Providers.ToList()" Subscriptions="capture.Subscriptions" OnFilterChanged="FilterChanged" SelectedProviderId="@_activeProviderId" OnProviderSelectionChanged="ProviderSelectionChanged" />
            @if (_queryMissingProvider) { <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning" Variant="Variant.Outlined">@L["Registry:ProviderMissing"]</MudAlert> }
            @if (EventType != null || Topic != null)
            {
                <div class="eventbus-route-selection"><span>@L["Registry:ExactRoute"]</span><div class="eventbus-route-constraints">
                    @if (EventType != null) { <code>@EventType</code> }
                    @if (Topic != null) { <code>@Topic</code> }
                </div><MudButton OnClick="ClearAllFilters" Size="Size.Small">@L["SubscriptionFilter:Clear"]</MudButton></div>
            }
            <div class="eventbus-registry-heading"><h2>@L["Registry:Title"]</h2><span>@L["Registry:Shown", FilteredSubscriptions.Count, capture.Subscriptions.Count]</span></div>
            <SubscriptionTable Subscriptions="FilteredSubscriptions" Loading="State.IsRefreshing" IsBusy="_busy" HasRegistrations="capture.Subscriptions.Count > 0"
                OnRowClick="row => InspectSubscriptionAsync(row, capture.CapturedAt)" OnTest="TestSubscriptionAsync" OnActivate="ActivateAsync" OnDeactivate="DeactivateAsync" OnUnsubscribe="RemoveAsync" ActiveTestListenerIds="TestService.GetActiveRuntimeListenerIds()" />
            <p class="eventbus-workbench-note">@L["Registry:RuntimeHelp"]</p>
        </section>
    }
    else if (View == EventBusWorkbenchView.Changes)
    {
        <EventBusChangesLedger Changes="State.ObservedChanges" ObservedChangeCount="State.ObservedChangeCount" DroppedChangeCount="State.DroppedChangeCount" OnInspect="InspectChangeAsync" />
    }
    else
    {
        <EventBusTestPanel />
        @if (TestService.GetActiveRuntimeListenerIds().Count > 0)
        {
            <section class="eventbus-retained-listeners"><h2>@L["Workbench:RetainedListeners"]</h2><p>@L["Workbench:RetainedListenersHelp"]</p>
                <div class="eventbus-listener-list">
                    @foreach (var id in TestService.GetActiveRuntimeListenerIds().Order(StringComparer.Ordinal))
                    {
                        var source = capture.Subscriptions.FirstOrDefault(row => row.SubscriptionId == id);
                        <article><div><strong>@(source?.EventTypeShortName ?? L["Workbench:RemovedListenerSource"].Value)</strong><code>@id</code></div><div>
                            @if (source != null) { <MudButton OnClick="() => TestSubscriptionAsync(source)" Size="Size.Small" Color="Color.Primary">@L["SubscriptionLifecycle:Actions:Test"]</MudButton> }
                            <MudButton OnClick="() => StopListenerAsync(id)" aria-disabled="@(_busy ? "true" : "false")" Size="Size.Small" Color="Color.Warning">@L["SubscriptionTestDialog:Actions:StopListening"]</MudButton>
                        </div></article>
                    }
                </div>
            </section>
        }
    }
</div>
