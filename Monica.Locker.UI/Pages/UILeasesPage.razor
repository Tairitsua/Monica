@attribute [Route(PAGE_URL)]
@inject IStringLocalizer<LockerResource> L
<PageTitle>@L["Navigation:Leases"]</PageTitle>
<LeaseWorkbench Authority="@(Authority == "all" ? null : Authority)" EvidenceState="@(EvidenceState == "all" ? null : EvidenceState)" Search="@Search" ResourceAuthority="@(TargetAuthority ?? ResourceAuthority)" Group="@Group" Holder="@(Holder == "all" ? null : Holder)" Sort="@Sort" Section="@Section" Provider="@Provider" ResourceName="@ResourceName" RefreshInterval="@RefreshInterval" />

@code {
    public const string PAGE_URL = "/leases";
    [SupplyParameterFromQuery(Name = "authority")] public string? Authority { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? EvidenceState { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = "source")] public string? ResourceAuthority { get; set; }
    [SupplyParameterFromQuery(Name = "resource")] public string? ResourceName { get; set; }
    [SupplyParameterFromQuery(Name = "group")] public string? Group { get; set; }
    [SupplyParameterFromQuery(Name = "holder")] public string? Holder { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "section")] public string? Section { get; set; }
    [SupplyParameterFromQuery(Name = "targetAuthority")] public string? TargetAuthority { get; set; }
    [SupplyParameterFromQuery(Name = "provider")] public string? Provider { get; set; }
    [SupplyParameterFromQuery(Name = "leaseRefresh")] public string? RefreshInterval { get; set; }
}
