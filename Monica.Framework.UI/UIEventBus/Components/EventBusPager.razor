@inject IStringLocalizer<EventBusResource> L

@if (Total > 0)
{
    <div class="eb-pager">
        <span class="eb-shown">@L["Precision:SubPageInfo", (Page - 1) * PageSize + 1, Math.Min(Page * PageSize, Total), Total]</span>
        <div class="eb-pager-btns">
            <button type="button" class="btn btn-sm btn-outline" aria-label="@L["Precision:PagePrevious"]" title="@L["Precision:PagePrevious"]" disabled="@(Page <= 1)" @onclick="() => Changed.InvokeAsync(Page - 1)"><MoIcon Icon="@MoIcons.ChevronLeft" Size="14px" /></button>
            <span class="eb-page-num mono">@Page / @PageCount</span>
            <button type="button" class="btn btn-sm btn-outline" aria-label="@L["Precision:PageNext"]" title="@L["Precision:PageNext"]" disabled="@(Page >= PageCount)" @onclick="() => Changed.InvokeAsync(Page + 1)"><MoIcon Icon="@MoIcons.ChevronRight" Size="14px" /></button>
        </div>
    </div>
}

@code {
    /// <summary>Gets or sets the positive current page index.</summary>
    [Parameter] public int Page { get; set; }
    /// <summary>Gets or sets the number of entries in a full page.</summary>
    [Parameter] public int PageSize { get; set; }
    /// <summary>Gets or sets the complete filtered result count.</summary>
    [Parameter] public int Total { get; set; }
    /// <summary>Gets or sets the event raised by the previous and next controls.</summary>
    [Parameter] public EventCallback<int> Changed { get; set; }

    private int PageCount => (Total + PageSize - 1) / PageSize;
}
