@inject ConfigurationValueVisibility Visibility
@using System.Text.Json.Nodes
@using System.Text
@using Monica.Configuration.Services.Support
@using Monica.Configuration.UI.Localization
@using Monica.UI.UIDiffHighlight.Models
@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_error</MudAlert>
}
else if (_groups.Count == 0)
{
    <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["PendingReview:Empty"]</MudAlert>
}
else
{
    <div class="configuration-definition-diff-preview">
        <MudExpansionPanels MultiExpansion="true" Elevation="0">
            @foreach (var group in _groups)
            {
                <MudExpansionPanel Icon="@MoIcons.ChevronDown" @key="group.DefinitionKey"
                                   Expanded="@group.IsExpanded"
                                   ExpandedChanged="expanded => OnGroupExpandedChanged(group, expanded)"
                                   KeepContentAlive="false">
                    <TitleContent>
                        <div class="configuration-definition-diff-header">
                            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1" Class="configuration-definition-diff-identity">
                                <MudText Typo="Typo.subtitle2">@group.DisplayName</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@group.DefinitionKey</MudChip>
                                @if (group.ChangeCount > 0)
                                {
                                    <MudChip T="int" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                        @L["PendingReview:ChangeCount", group.ChangeCount]
                                    </MudChip>
                                }
                                @if (group.ValidationIssues.Count > 0)
                                {
                                    <MudChip T="int" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                                        @L["PendingReview:IssueCount", group.ValidationIssues.Count]
                                    </MudChip>
                                }
                            </MudStack>
                            @if (UndoRequested.HasDelegate)
                            {
                                <div class="configuration-definition-diff-header-actions" @onclick:stopPropagation="true">
                                    <MudTooltip Text="@DefinitionRemovalText">
                                        <MudIconButton Icon="@RemovalIcon"
                                                       Size="Size.Small"
                                                       Color="@RemovalColor"
                                                       aria-label="@DefinitionRemovalText"
                                                       Disabled="ActionsDisabled"
                                                       OnClick="@(() => UndoDefinitionAsync(group.DefinitionKey))" />
                                    </MudTooltip>
                                </div>
                            }
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <MudStack Spacing="2">
                            @if (HasChangeActions && group.Changes.Count > 0)
                            {
                                <div class="configuration-definition-diff-change-actions">
                                    <MudStack Spacing="1">
                                        @foreach (var change in group.Changes)
                                        {
                                            <div class="configuration-definition-diff-change-action" @key="change.RequestId">
                                                <MudPaper Outlined="true" Class="pa-2">
                                                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                                                        <div class="configuration-definition-diff-change-summary">
                                                            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
                                                                <MudChip T="string" Size="Size.Small" Color="@PatchColor(change.MutationKind)" Variant="Variant.Outlined">
                                                                    @MutationKindText(change.MutationKind)
                                                                </MudChip>
                                                                <MudText Typo="Typo.caption"><code>@change.LogicalPath.ToCanonicalString()</code></MudText>
                                                            </MudStack>
                                                        </div>
                                                        <div class="configuration-definition-diff-change-action-buttons">
                                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                                @if (JumpChangeRequested.HasDelegate)
                                                                {
                                                                    <MudTooltip Text="@L["PendingReview:Actions:JumpToChange"]">
                                                                        <MudIconButton Icon="@MoIcons.Navigation"
                                                                                       Size="Size.Small"
                                                                                       Color="Color.Primary"
                                                                                       aria-label="@L["PendingReview:Actions:JumpToChange"]"
                                                                                       Disabled="ActionsDisabled"
                                                                                       OnClick="@(() => JumpChangeRequested.InvokeAsync(change))" />
                                                                    </MudTooltip>
                                                                }
                                                                @if (UndoRequested.HasDelegate)
                                                                {
                                                                    <MudTooltip Text="@ChangeRemovalText">
                                                                        <MudIconButton Icon="@RemovalIcon"
                                                                                       Size="Size.Small"
                                                                                       Color="@RemovalColor"
                                                                                       aria-label="@ChangeRemovalText"
                                                                                       Disabled="ActionsDisabled"
                                                                                       OnClick="@(() => UndoRequested.InvokeAsync(ConfigurationPendingReviewUndoRequest.ForChange(change)))" />
                                                                    </MudTooltip>
                                                                }
                                                            </MudStack>
                                                        </div>
                                                    </MudStack>
                                                </MudPaper>
                                            </div>
                                        }
                                    </MudStack>
                                </div>
                            }
                            <ConfigurationValidationIssueList Issues="@group.ValidationIssues"
                                                              ShowDefinition="false"
                                                              ShowJump="JumpRequested.HasDelegate"
                                                              JumpRequested="JumpRequested"
                                                              UndoRequested="UndoRequested"
                                                              UndoLabel="@IssueRemovalText"
                                                              UndoIcon="@RemovalIcon"
                                                              UndoColor="@RemovalColor"
                                                              ActionsDisabled="ActionsDisabled" />
                            @if (group.ChangeCount > 0)
                            {
                                @if (group.IsPreviewLoading)
                                {
                                    <MudProgressLinear Indeterminate="true" />
                                }
                                else if (!string.IsNullOrWhiteSpace(group.PreviewError))
                                {
                                    <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Dense="true">@group.PreviewError</MudAlert>
                                }
                                else if (group.HasPreview)
                                {
                                    <DiffViewer OriginText="@group.OriginJson"
                                                NewText="@group.TargetJson"
                                                Options="@DiffOptions"
                                                ViewMode="EDiffViewMode.Split" />
                                }
                            }
                            else
                            {
                                <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning" Dense="true">@L["PendingReview:Validation:NoSaveableChanges"]</MudAlert>
                            }
                        </MudStack>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </div>
}

@code {
    private readonly ConfigurationEffectiveValuePatchEngine _patchEngine = new();
    private readonly DiffHighlightOptions DiffOptions = new()
    {
        Mode = EDiffHighlightMode.Line,
        ContextLines = 4,
        MaxCharacterDiffLength = 8000
    };

    private IReadOnlyList<DefinitionDiffGroup> _groups = [];
    private string? _preparedInputSignature;
    private bool _loading;
    private string? _error;

    [Parameter] public IReadOnlyList<PendingChange> Changes { get; set; } = [];
    [Parameter] public IReadOnlyList<ConfigurationValidationIssue> ValidationIssues { get; set; } = [];
    [Parameter] public ConfigurationPendingReviewActionMode ActionMode { get; set; }
    [Parameter] public bool ActionsDisabled { get; set; }
    [Parameter] public EventCallback<ConfigurationValidationIssue> JumpRequested { get; set; }
    [Parameter] public EventCallback<PendingChange> JumpChangeRequested { get; set; }
    [Parameter] public EventCallback<ConfigurationPendingReviewUndoRequest> UndoRequested { get; set; }

    private bool HasChangeActions => JumpChangeRequested.HasDelegate || UndoRequested.HasDelegate;
    private bool IsExclusion => ActionMode == ConfigurationPendingReviewActionMode.Exclude;
    private string ChangeRemovalText => IsExclusion
        ? L["PendingReview:Actions:ExcludeChange"]
        : L["PendingReview:Actions:UndoChange"];
    private string IssueRemovalText => IsExclusion
        ? L["PendingReview:Actions:ExcludeIssue"]
        : L["PendingReview:Actions:UndoIssue"];
    private string DefinitionRemovalText => IsExclusion
        ? L["PendingReview:Actions:ExcludeDefinition"]
        : L["PendingReview:Actions:UndoDefinition"];
    private string RemovalIcon => IsExclusion
        ? MoIcons.MinusCircle
        : MoIcons.Undo;
    private Color RemovalColor => IsExclusion ? Color.Error : Color.Warning;

    private string MutationKindText(ConfigurationMutationKind kind)
    {
        return kind switch
        {
            ConfigurationMutationKind.Set => L["Mutation:Kinds:Set"],
            ConfigurationMutationKind.Remove => L["Mutation:Kinds:Remove"],
            _ => kind.ToString()
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        var inputSignature = BuildInputSignature();
        if (string.Equals(_preparedInputSignature, inputSignature, StringComparison.Ordinal))
        {
            return;
        }

        _preparedInputSignature = inputSignature;
        _loading = true;
        _error = null;

        try
        {
            _groups = BuildGroups();

            if (_groups.Count == 1)
            {
                var group = _groups[0];
                group.IsExpanded = true;
                await EnsureGroupPreviewAsync(group);
            }
        }
        catch (Exception ex)
        {
            _preparedInputSignature = null;
            _error = ex.Message;
            _groups = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyList<DefinitionDiffGroup> BuildGroups()
    {
        var groups = new List<DefinitionDiffGroup>();
        var definitionKeys = Changes.Select(change => change.DefinitionKey)
            .Concat(ValidationIssues.Select(issue => issue.DefinitionKey))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(DisplayNameForDefinition, StringComparer.OrdinalIgnoreCase)
            .ToArray();

        foreach (var definitionKey in definitionKeys)
        {
            var changes = Changes
                .Where(change => string.Equals(change.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))
                .ToArray();
            var issues = ValidationIssues
                .Where(issue => string.Equals(issue.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))
                .ToArray();

            groups.Add(new DefinitionDiffGroup(
                definitionKey,
                DisplayNameForDefinition(definitionKey),
                changes.Length,
                changes,
                issues));
        }

        return groups;
    }

    private string BuildInputSignature()
    {
        var builder = new StringBuilder();
        foreach (var change in Changes
                     .OrderBy(change => change.DefinitionKey, StringComparer.Ordinal)
                     .ThenBy(change => change.LogicalPath.ToCanonicalString(), StringComparer.Ordinal)
                     .ThenBy(change => change.TargetKind)
                     .ThenBy(change => change.MutationKind))
        {
            builder.Append("C|")
                .Append(change.DefinitionKey).Append('|')
                .Append(change.LogicalPath.ToCanonicalString()).Append('|')
                .Append(change.TargetKind).Append('|')
                .Append(change.MutationKind).Append('|')
                .Append(change.NewValue.Json).AppendLine();
        }

        foreach (var issue in ValidationIssues
                     .OrderBy(issue => issue.DefinitionKey, StringComparer.Ordinal)
                     .ThenBy(issue => issue.LogicalPath.ToCanonicalString(), StringComparer.Ordinal)
                     .ThenBy(issue => issue.ValidationError, StringComparer.Ordinal))
        {
            builder.Append("I|")
                .Append(issue.DefinitionKey).Append('|')
                .Append(issue.LogicalPath.ToCanonicalString()).Append('|')
                .Append(issue.ValidationError).AppendLine();
        }

        return builder.ToString();
    }

    private async Task OnGroupExpandedChanged(DefinitionDiffGroup group, bool expanded)
    {
        group.IsExpanded = expanded;

        if (expanded)
        {
            await EnsureGroupPreviewAsync(group);
        }
    }

    private Task UndoDefinitionAsync(string definitionKey)
    {
        return UndoRequested.InvokeAsync(ConfigurationPendingReviewUndoRequest.ForDefinition(definitionKey));
    }

    private async Task EnsureGroupPreviewAsync(DefinitionDiffGroup group)
    {
        if (group.ChangeCount == 0 || group.HasPreview || group.IsPreviewLoading)
        {
            return;
        }

        group.IsPreviewLoading = true;
        group.PreviewError = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var definition = await LoadDefinitionAsync(group.DefinitionKey);
            var originJson = await LoadOriginJsonAsync(group.DefinitionKey);
            var targetJson = ApplyChanges(definition, originJson, group.Changes);

            group.OriginJson = FormatForDisplay(originJson, definition);
            group.TargetJson = FormatForDisplay(targetJson, definition);
            group.HasPreview = true;
        }
        catch (Exception ex)
        {
            group.PreviewError = ex.Message;
        }
        finally
        {
            group.IsPreviewLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string DisplayNameForDefinition(string definitionKey)
    {
        return Changes.FirstOrDefault(change => string.Equals(change.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))?.DefinitionDisplayName
               ?? ValidationIssues.FirstOrDefault(issue => string.Equals(issue.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))?.DefinitionDisplayName
               ?? definitionKey;
    }

    private async Task<ConfigurationDefinition> LoadDefinitionAsync(string definitionKey)
    {
        var result = await Facade.GetDefinitionAsync(definitionKey);
        var error = result;
        var detail = result.Data;
        if (result.IsFailure() || detail is null)
        {
            throw new InvalidOperationException($"{L["Common:Errors:LoadFailed"]}: {error.Message}");
        }

        return detail.Definition;
    }

    private async Task<string> LoadOriginJsonAsync(string definitionKey)
    {
        var result = await Facade.GetEffectiveValueAsync(definitionKey, LogicalPath.Root, Visibility.ShowSensitiveValues);
        var error = result;
        var value = result.Data;
        if (result.IsFailure() || value is null)
        {
            throw new InvalidOperationException($"{L["Common:Errors:LoadFailed"]}: {error.Message}");
        }

        return string.IsNullOrWhiteSpace(value.DisplayValue) ? "{}" : value.DisplayValue!;
    }

    private string ApplyChanges(
        ConfigurationDefinition definition,
        string originJson,
        IEnumerable<PendingChange> changes)
    {
        var targetJson = NormalizeJson(originJson);
        foreach (var change in changes.OrderBy(change => change.LogicalPath.ToCanonicalString(), StringComparer.Ordinal))
        {
            targetJson = change.MutationKind switch
            {
                ConfigurationMutationKind.Remove when change.LogicalPath.Depth == 0 => "{}",
                ConfigurationMutationKind.Remove => _patchEngine.Remove(targetJson, definition, change.LogicalPath),
                _ when change.LogicalPath.Depth == 0 => change.NewValue.Json,
                _ => _patchEngine.Patch(targetJson, definition, change.LogicalPath, change.NewValue.Json)
            };
        }

        return targetJson;
    }

    private string FormatForDisplay(string json, ConfigurationDefinition definition)
    {
        return ConfigurationJsonDisplayFormatter.Format(json, definition.Root, L["State:Value:Sensitive"].Value, Visibility.ShowSensitiveValues);
    }

    private static Color PatchColor(ConfigurationMutationKind kind)
    {
        return kind switch
        {
            ConfigurationMutationKind.Remove => Color.Error,
            _ => Color.Info
        };
    }

    private static string NormalizeJson(string json)
    {
        return ParseJson(json)?.ToJsonString() ?? "{}";
    }

    private static JsonNode? ParseJson(string json)
    {
        return JsonNode.Parse(string.IsNullOrWhiteSpace(json) ? "{}" : json) ?? new JsonObject();
    }

    private sealed record DefinitionDiffGroup(
        string DefinitionKey,
        string DisplayName,
        int ChangeCount,
        IReadOnlyList<PendingChange> Changes,
        IReadOnlyList<ConfigurationValidationIssue> ValidationIssues)
    {
        public bool IsExpanded { get; set; }
        public bool IsPreviewLoading { get; set; }
        public bool HasPreview { get; set; }
        public string? PreviewError { get; set; }
        public string OriginJson { get; set; } = "{}";
        public string TargetJson { get; set; } = "{}";
    }
}
