@using Monica.JobScheduler.UI.UIJobScheduler.Executions.Support
@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation
<section class="analytics-duration" aria-labelledby="@_headingId">
    <header><div><h2 id="@_headingId">@L["Analytics:Duration:Title"]</h2><p>@L["Workspace:DurationDescription",Snapshot.Duration.Count]</p></div><MoIcon Icon="@MoIcons.Timer" Size="18px"/></header>
    <dl class="analytics-duration__percentiles">@foreach(var metric in Percentiles) { <div title="@metric.Description"><dt>@metric.Label</dt><dd>@FormatDuration(metric.Value)</dd></div> }</dl>
    <div class="analytics-duration__range" aria-label="@L["Analytics:Duration:PercentilesAriaLabel"]"><div class="analytics-duration__rail">@foreach(var metric in Percentiles.Where(item => item.Value is not null)) { <i style="@($"left:{Position(metric.Value)}%")" title="@($"{metric.Label}: {FormatDuration(metric.Value)}")"></i> }</div><span>@L["Analytics:Duration:Minimum"] @FormatDuration(Snapshot.Duration.Minimum)</span><span>@L["Analytics:Duration:Maximum"] @FormatDuration(Snapshot.Duration.Maximum)</span></div>
    <div class="analytics-duration__slow-heading"><h3>@L["Analytics:Slowest:Top"]</h3><p>@L["Analytics:Slowest:Description"]</p></div>
    <ol class="analytics-duration__slow-list">@foreach(var capture in Snapshot.SlowestExecutions)
    {
        <li @key="capture.InstanceId"><button type="button" class="analytics-duration__inspect" aria-label="@L["Analytics:Slowest:OpenDetails",1,capture.JobName,capture.InstanceId,L[$"ExecutionStates:{capture.State}"],TimePresentation.FormatTimestamp(capture.CompletedAtUtc),FormatDuration(capture.Duration)]" @onclick="@(() => InspectExecution.InvokeAsync(capture))"><span class="analytics-duration__status" data-state="@capture.State.ToString().ToLowerInvariant()"><MoIcon Icon="@ExecutionUiPresentation.GetStateIcon(capture.State)" Size="16px"/></span><span class="analytics-duration__identity"><b>@capture.JobName</b><small>@capture.OwnerKey</small></span><span class="analytics-duration__value"><b>@FormatDuration(capture.Duration)</b><small>@L[$"ExecutionStates:{capture.State}"]</small></span><MoIcon Icon="@MoIcons.ChevronRight" Size="14px"/></button></li>
    }</ol>
    @if(Snapshot.SlowestExecutions.Count==0) { <p class="analytics-duration__empty">@L["Analytics:Slowest:Empty"]</p> }
</section>
@code {
    private readonly string _headingId = $"analytics-duration-{Guid.NewGuid():N}";

    /// <summary>Gets the accepted duration population and per-job longest records.</summary>
    [Parameter, EditorRequired]
    public JobExecutionAnalyticsSnapshot Snapshot { get; set; } = null!;

    /// <summary>Gets the callback receiving the exact immutable displayed execution capture.</summary>
    /// <remarks>
    /// Native opener identity is keyed by the exact instance ID and remains enabled during parent-owned modal work.
    /// The parent must freshly authorize inspection and own admission, native reference/Result and retirement.
    /// </remarks>
    [Parameter, EditorRequired]
    public EventCallback<JobExecutionAnalyticsSlowExecution> InspectExecution { get; set; }

    private IReadOnlyList<DurationMetric> Percentiles =>
    [
        new(L["Analytics:Duration:P50"], L["Analytics:Duration:P50Description"], Snapshot.Duration.P50),
        new(L["Analytics:Duration:P90"], L["Analytics:Duration:P90Description"], Snapshot.Duration.P90),
        new(L["Analytics:Duration:P95"], L["Analytics:Duration:P95Description"], Snapshot.Duration.P95),
        new(L["Analytics:Duration:P99"], L["Analytics:Duration:P99Description"], Snapshot.Duration.P99)
    ];

    private string Position(TimeSpan? value) => (Snapshot.Duration.Maximum?.TotalMilliseconds > 0 ? Math.Clamp((value?.TotalMilliseconds ?? 0) / Snapshot.Duration.Maximum.Value.TotalMilliseconds * 100,0,100) : 0).ToString("0.##",System.Globalization.CultureInfo.InvariantCulture);
    private string FormatDuration(TimeSpan? value) => value is null ? L["Common:NotAvailable"] : TimePresentation.FormatDuration(value);
    private sealed record DurationMetric(string Label, string Description, TimeSpan? Value);
}
