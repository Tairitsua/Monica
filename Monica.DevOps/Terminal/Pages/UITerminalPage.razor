@using Monica.DevOps.Localization
@using Monica.DevOps.Terminal.Components
@using Monica.DevOps.Terminal.Facades
@using Monica.DevOps.Terminal.Models
@using Monica.DevOps.Terminal.State
@using Monica.UI.Shell.Support
@using Microsoft.JSInterop
@using Microsoft.Extensions.Logging
@attribute [Route(PAGE_URL)]
@implements IAsyncDisposable
@inject TerminalFacade TerminalFacade
@inject IBrowserStorage BrowserStorage
@inject IStringLocalizer<TerminalResource> L
@inject ILogger<UITerminalPage> Logger

<PageTitle>@L["Page:DocumentTitle"]</PageTitle>

<div class="terminal-page @(_flow ? "terminal-page--flow" : "")">
    <header class="terminal-header">
        <div class="terminal-header__heading"><h1>@L["Page:Title"]</h1><p>@L["Page:Subtitle"]</p></div>
        @if (_visit is { IsInitialized: true, ActiveSession: not null } headingVisit)
        {
            <div class="terminal-header__actions"><MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Add"
                Disabled="@(!headingVisit.CanChangeSession)" OnClick="headingVisit.CreateSessionAsync">@L["Actions:NewSession"]</MudButton></div>
        }
    </header>
    @if (_visit is { } visit)
    {
        @if (!visit.IsInitialized)
        {
            <div class="terminal-initialization"><MoContentState Loading="@visit.IsLoading">
                @if (visit.InitializationFailure is not null)
                {
                    <MudAlert Severity="Severity.Error" Icon="@MoIcons.Error">@(visit.OwnerStorageFailure is not null ? L["Messages:OwnerStorageFailed"] : L["Messages:InitializationFailed", visit.InitializationFailure])</MudAlert>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@visit.IsLoading" OnClick="visit.InitializeAsync">@L["Actions:Retry"]</MudButton>
                }
                else
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" /><p>@L["States:Loading"]</p>
                }
            </MoContentState></div>
        }
        else if (visit.ActiveSession is { } session)
        {
            <div class="terminal-workbench">
                <TerminalTargetBand @ref="_target" Session="session" Sessions="visit.Sessions" Environment="visit.Environment"
                                    Disabled="@(!visit.CanChangeSession)" Selected="SelectAsync"
                                    Clear="ClearAsync" CloseSession="CloseSessionAsync" />
                @if (visit.ReadFailure is not null)
                {
                    <div class="terminal-evidence-error"><MudAlert Severity="Severity.Error" Dense="true" Icon="@MoIcons.Error">@L["Messages:RefreshFailed", visit.ReadFailure]</MudAlert>
                        <MudButton Size="Size.Small" Disabled="@visit.IsOperationPending" OnClick="visit.RefreshAsync">@L["Actions:Retry"]</MudButton></div>
                }
                @if (visit.OperationFailure is not null || session.LastExecutionFailure is not null)
                {
                    <div class="terminal-evidence-error"><MudAlert Severity="Severity.Error" Dense="true" Icon="@MoIcons.Error">@L["Messages:OperationFailed", visit.OperationFailure ?? session.LastExecutionFailure!.Message]</MudAlert></div>
                }
                <div class="terminal-body @(_context is not null && !_modal ? "terminal-body--context" : "")">
                    <div class="terminal-main">
                        <div class="terminal-toolbar">
                            <div class="terminal-toolbar__state" role="status" aria-live="polite"><strong>@L["Labels:Transcript"]</strong>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(session.IsRunning ? Color.Info : Color.Default)" Class="@(session.IsRunning ? "terminal-toolbar__status--running" : null)" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                                    @(session.ActiveCommand?.CancellationRequested == true ? L["States:CancellationRequested"] : session.IsRunning ? L["States:Running"] : L["States:Ready"])
                                </MudChip>
                                @if (session.IsRunning) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" /> }
                            </div>
                            <div class="terminal-toolbar__actions">
                                @if (_unseen && _unseenSessionId == session.Id)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@MoIcons.ArrowDown" OnClick="RevealLatestAsync">@L["Actions:Latest"]</MudButton>
                                }
                                <MudButton @ref="_historyButton" Size="Size.Small" Variant="Variant.Text" StartIcon="@MoIcons.History" OnClick="@(() => OpenContext("history", _historyButton))" aria-pressed="@(_context == "history" ? "true" : "false")">@L["Labels:History"]</MudButton>
                                <MudButton @ref="_hostButton" Size="Size.Small" Variant="Variant.Text" StartIcon="@MoIcons.Info" OnClick="@(() => OpenContext("host", _hostButton))" aria-pressed="@(_context == "host" ? "true" : "false")">@L["Labels:SessionHost"]</MudButton>
                                @if (session.ActiveCommand is not null) { <MudButton @ref="_currentButton" Size="Size.Small" Variant="Variant.Text" OnClick="CurrentDetails">@L["Labels:CurrentCommand"]</MudButton> }
                            </div>
                        </div>
                        <TerminalTranscript @ref="_transcript" @key="session.Id" Session="session" CompactChanged="CompactChanged" FlowChanged="FlowChanged" UnseenChanged="UnseenChanged" />
                        @if (session.LastResult is { } result)
                        {
                            <TerminalResultStrip @ref="_resultStrip" Result="result" Details="@((MudButton opener) => ResultDetails(result, opener))" />
                        }
                        <TerminalCommandComposer @ref="_composer" Draft="@visit.Draft" DraftChanged="DraftChanged" Disabled="@(!visit.CanChangeSession)"
                                                 Running="session.IsRunning" CancellationRequested="@(session.ActiveCommand?.CancellationRequested == true)"
                                                 CanRun="visit.CanRun" CanCancel="visit.CanCancel" Run="visit.StartCommandAsync" Cancel="visit.CancelCommandAsync" />
                    </div>
                    @if (_context is not null && !_modal)
                    {
                        <aside class="terminal-inline-context"><TerminalContextPanel Session="session" Environment="visit.Environment" History="@(_context == "history")"
                            Result="_inspectedResult" CurrentCommand="_inspectedCommand" InspectedSessionName="@_inspectedSessionName" InspectedSessionId="@_inspectedSessionId" Disabled="@(!visit.CanChangeSession)" Close="CloseContext" Reuse="ReuseAsync" /></aside>
                    }
                </div>
            </div>
            <MudDrawer Open="@(_context is not null && _modal)" OpenChanged="DrawerChanged" Anchor="Anchor.End" Variant="DrawerVariant.Temporary"
                       Overlay="false" Fixed="true" Width="min(35rem, var(--terminal-owner-width))" Elevation="4" Class="terminal-native-drawer"
                       Style="@DrawerStyle"
                       role="dialog" aria-modal="true" aria-labelledby="terminal-context-title">
                @if (_context is not null && _modal)
                {
                    <div class="terminal-context-drawer" @onkeydown="ContextKeyDownAsync">
                        <MudFocusTrap DefaultFocus="DefaultFocus.FirstChild" Class="terminal-context-focus">
                            <TerminalContextPanel Session="session" Environment="visit.Environment" History="@(_context == "history")"
                                Result="_inspectedResult" CurrentCommand="_inspectedCommand" InspectedSessionName="@_inspectedSessionName" InspectedSessionId="@_inspectedSessionId" Disabled="@(!visit.CanChangeSession)" Close="CloseContext" Reuse="ReuseAsync" />
                        </MudFocusTrap>
                    </div>
                }
            </MudDrawer>
            @if (_context is not null && _modal)
            {
                <div class="terminal-backdrop-owner" @onwheel:preventDefault @ontouchmove:preventDefault>
                    <MudOverlay Visible="true" Absolute="true" DarkBackground="true" AutoClose="true" OnClosed="CloseContext" />
                </div>
            }
        }
        else
        {
            <div class="terminal-initialization"><MoContentState Loading="@visit.IsLoading"><p>@L["States:NoSession"]</p>
                @if (visit.ReadFailure is not null) { <MudAlert Severity="Severity.Error" Icon="@MoIcons.Error">@L["Messages:RefreshFailed", visit.ReadFailure]</MudAlert> }
                @if (visit.OperationFailure is not null) { <MudAlert Severity="Severity.Error" Icon="@MoIcons.Error">@L["Messages:OperationFailed", visit.OperationFailure]</MudAlert> }
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(!visit.CanChangeSession)" OnClick="visit.CreateSessionAsync">@L["Actions:NewSession"]</MudButton>
            </MoContentState></div>
        }
    }
</div>

@code {
    public const string PAGE_URL = "/ui/terminal";
    private TerminalVisitController? _visit;
    private TerminalCommandComposer? _composer;
    private TerminalTargetBand? _target;
    private TerminalTranscript? _transcript;
    private TerminalResultStrip? _resultStrip;
    private MudButton? _historyButton;
    private MudButton? _hostButton;
    private MudButton? _currentButton;
    private MudButton? _contextOpener;
    private ContextFocusIntent? _contextFocusIntent;
    private long _contextVersion;
    private bool _unseen;
    private string? _unseenSessionId;
    private string? _context;
    private bool _compact = true;
    private bool _flow;
    private bool _modal;
    private bool _disposed;
    private Task? _retirement;
    private bool _selectionIntent;
    private bool _selectionCompact;
    private TerminalCommandResultSnapshot? _inspectedResult;
    private TerminalActiveCommandSnapshot? _inspectedCommand;
    private string? _inspectedSessionName;
    private string? _inspectedSessionId;
    private Exception? _loggedNotification;
    private string DrawerStyle => "top: var(--terminal-owner-top); height: var(--terminal-owner-height); bottom: auto; transition: none; animation: none;" +
        (_context is not null && _modal ? "right: var(--terminal-owner-right);" : string.Empty);

    protected override void OnInitialized() => _visit = new(TerminalFacade, BrowserStorage, work => InvokeAsync(work), PublishVisitAsync);

    private Task PublishVisitAsync()
    {
        if (_disposed) return Task.CompletedTask;
        var sessionId = _visit?.SelectedSessionId;
        if (_unseenSessionId != sessionId)
        {
            _unseenSessionId = sessionId;
            _unseen = false;
            _contextFocusIntent = null;
            _contextVersion++;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _visit is null) return;
        if (_visit.NotificationError is { } error && !ReferenceEquals(error, _loggedNotification))
        {
            _loggedNotification = error;
            Logger.LogError(error, "Terminal visit publication failed");
        }
        if (firstRender) { await _visit.InitializeAsync(); return; }
        var intent = _visit.TakeFocusIntent();
        var contextIntent = _contextFocusIntent;
        _contextFocusIntent = null;
        if (intent is null)
        {
            if (contextIntent is null) return;
            await _visit.RunPresentationAsync(async () =>
            {
                if (_disposed || _context is not null || _contextVersion != contextIntent.Version ||
                    _visit.SelectedSessionId != contextIntent.SessionId || !IsContextOpenerCurrent(contextIntent.Opener)) return;
                try { await contextIntent.Opener.FocusAsync(); }
                catch (JSDisconnectedException) { }
            });
            return;
        }
        var selection = _selectionIntent;
        var compact = _selectionCompact;
        _selectionIntent = false;
        await _visit.RunPresentationAsync(async () =>
        {
            if (_disposed || !_visit.IsFocusIntentCurrent(intent)) return;
            try
            {
                if (selection) { if (compact && _target is not null) await _target.FocusTargetAsync(); }
                else if (_composer is not null) await _composer.FocusAsync();
            }
            catch (JSDisconnectedException) { }
        });
    }

    private void DraftChanged(string value) => _visit?.SetDraft(value);
    private async Task SelectAsync(string id)
    {
        if (_disposed || _visit is null || !_visit.CanChangeSession) return;
        _selectionIntent = true;
        _selectionCompact = _compact;
        DismissContext(false);
        await _visit.SelectSessionAsync(id);
    }
    private async Task ReuseAsync(string command)
    {
        if (_disposed || _visit is null || !_visit.CanChangeSession) return;
        _contextFocusIntent = null;
        _contextVersion++;
        if (_modal) DismissContext(false);
        await _visit.UseHistoryAsync(command);
    }
    private async Task ClearAsync() { if (_visit is null) return; await _visit.ClearOutputAsync(); if (_visit.OperationFailure is null) DismissContext(false); }
    private async Task CloseSessionAsync() { if (_visit is null) return; await _visit.CloseSessionAsync(); if (_visit.OperationFailure is null) DismissContext(false); }
    private void OpenContext(string context, MudButton? opener)
    {
        if (_disposed) return;
        _contextVersion++;
        _contextFocusIntent = null;
        _contextOpener = opener;
        _context = context;
        _modal = _modal || _compact;
        _inspectedResult = null;
        _inspectedCommand = null;
        _inspectedSessionName = null;
        _inspectedSessionId = null;
    }
    private void CaptureInspectedSession() { _inspectedSessionName = _visit?.ActiveSession?.Name; _inspectedSessionId = _visit?.ActiveSession?.Id; }
    private void ResultDetails(TerminalCommandResultSnapshot result, MudButton opener) { OpenContext("result", opener); _inspectedResult = result; CaptureInspectedSession(); }
    private void CurrentDetails() { if (_visit?.ActiveSession?.ActiveCommand is { } command) { OpenContext("current", _currentButton); _inspectedCommand = command; CaptureInspectedSession(); } }
    private void CloseContext() => DismissContext(true);
    private void DismissContext(bool restoreFocus)
    {
        if (_context is null)
        {
            if (!restoreFocus) { _contextFocusIntent = null; _contextVersion++; }
            return;
        }
        var opener = _contextOpener;
        var inline = !_modal;
        var sessionId = _visit?.SelectedSessionId;
        _contextVersion++;
        _contextFocusIntent = !_disposed && restoreFocus && inline && opener is not null && sessionId is not null
            ? new(_contextVersion, sessionId, opener) : null;
        _context = null;
        _modal = false;
        _contextOpener = null;
        _inspectedResult = null;
        _inspectedCommand = null;
        _inspectedSessionName = null;
        _inspectedSessionId = null;
    }
    private void UnseenChanged((string SessionId, bool Unseen) state)
    {
        if (_disposed || _visit?.SelectedSessionId != state.SessionId) return;
        _unseenSessionId = state.SessionId;
        _unseen = state.Unseen;
    }
    private bool IsContextOpenerCurrent(MudButton opener) => ReferenceEquals(opener, _historyButton) || ReferenceEquals(opener, _hostButton) ||
        (_visit?.ActiveSession?.ActiveCommand is not null && ReferenceEquals(opener, _currentButton)) ||
        (_visit?.ActiveSession?.LastResult is not null && _resultStrip?.IsDetailsOpener(opener) == true);
    private Task RevealLatestAsync()
    {
        if (_disposed || _transcript is not { } transcript || _visit?.SelectedSessionId != transcript.Session.Id)
            return Task.CompletedTask;
        return transcript.RevealLatestAsync();
    }
    private void CompactChanged(bool compact) { if (_disposed) return; _compact = compact; if (_context is not null && compact) _modal = true; }
    private void FlowChanged(bool flow) { if (!_disposed) _flow = flow; }
    private void DrawerChanged(bool open) { if (!open) CloseContext(); }
    private Task ContextKeyDownAsync(KeyboardEventArgs args) { if (args.Key == "Escape") CloseContext(); return Task.CompletedTask; }
    public ValueTask DisposeAsync()
    {
        if (_retirement is not null) return new(_retirement);
        var completion = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
        _retirement = completion.Task;
        _disposed = true;
        _contextFocusIntent = null;
        _contextOpener = null;
        _ = DrainAsync();
        return new(completion.Task);
        async Task DrainAsync()
        {
            try
            {
                var transcriptRetirement = _transcript?.DisposeAsync().AsTask() ?? Task.CompletedTask;
                var visitRetirement = _visit?.DisposeAsync().AsTask() ?? Task.CompletedTask;
                await Task.WhenAll(transcriptRetirement, visitRetirement);
                completion.TrySetResult();
            }
            catch (Exception exception) { completion.TrySetException(exception); }
        }
    }
    private sealed record ContextFocusIntent(long Version, string SessionId, MudButton Opener);
}
