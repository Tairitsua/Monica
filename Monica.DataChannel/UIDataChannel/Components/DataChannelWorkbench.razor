@using Microsoft.Extensions.Options
@using Monica.Modules
@using Monica.UI.Shared.Components.Navigation
@using Monica.UI.Shared.Services
@inject IOptions<ModuleShellUIOption> Shell
@inject MoTimeFormatter UiTime

@{
    var capture = State.Snapshot;
    var view = View;
    var loading = capture is null && (State.IsRefreshing || !State.HasAttemptedCapture);
    var posture = Posture(view, loading);
    var title = L[Exceptions ? "Pages:DataChannelExceptions:Title" : "Pages:DataChannelManage:Title"].Value;
    var sheetChannel = Query.Inspect is { } identity ? view?.ById.GetValueOrDefault(identity) : null;
}
<PageTitle>@title</PageTitle>
<div class="dc-page mo-page-shell mo-page-shell--full-width" aria-busy="@(State.IsRefreshing ? "true" : "false")">
    <MoPageMasthead Title="@title" Crumb="@L["Design:Eyebrow"]" Icon="@(Exceptions ? MoIcons.Warning : MoIcons.Route)">
        <Meta>
            <span class="dc-state @posture.Role.ToCssClass()" role="status"><span class="status-dot" aria-hidden="true"></span>@posture.Label</span>
            <span class="dc-outline-chip mono" title="@Environment.MachineName">@L["Design:HostChip"] · @Shell.Value.GetAppName()</span>
            <span class="dc-outline-chip" title="@UiTime.TimeZone.Id">@L["Design:TzChip"] · @UiTime.FormatZoneLabel(capture?.CapturedAt)</span>
        </Meta>
        <Actions>
            <div class="dc-stamp">
                <span>@L["Workbench:Captured"]</span>
                <time class="mono">@(capture is null ? L["Workbench:NoCapture"].Value : UiTime.FormatTime(capture.CapturedAt))</time>
            </div>
            <button type="button" class="btn btn-primary" disabled="@State.IsRefreshing" @onclick="RefreshAsync">
                <MoIcon Icon="@MoIcons.Refresh" Class="@(State.IsRefreshing ? "dc-spin" : null)" Size="15px" />@L["Common:Actions:Refresh"]
            </button>
        </Actions>
    </MoPageMasthead>

    <MoWorkbenchNavigation Label="@L["Design:NavLabel"]" Compact="true">
        <a href="@ScopeUrl(false)" aria-current="@(!Exceptions ? "page" : null)"><MoIcon Icon="@MoIcons.Route" /><span>@L["Workbench:Routes:Channels"]</span></a>
        <a href="@ScopeUrl(true)" aria-current="@(Exceptions ? "page" : null)">
            <MoIcon Icon="@MoIcons.Warning" /><span>@L["Design:Nav:Exceptions"]</span>
            @if (view?.TotalRetained > 0)
            {
                <span class="dc-wbn-badge mo-vl-role--error">@view.TotalRetained</span>
            }
        </a>
    </MoWorkbenchNavigation>

    @if (State.RefreshError is { } error && capture is not null)
    {
        <MoSemanticCallout Severity="MoVisualRole.Warning" Title="@L["Design:StaleTitle"]">
            @L["Design:StaleNote", UiTime.FormatTime(capture.CapturedAt)] <code class="mono dc-err-inline">@error</code>
        </MoSemanticCallout>
    }
    @if (view is null || view.IsEmpty)
    {
        <section class="mo-vl-surface dc-gate">
            <MoContentState Loading="@loading" role="@(loading ? "status" : State.RefreshError is not null ? "alert" : null)">
                <span class="mo-vl-tile @(loading ? "mo-vl-role--info" : State.RefreshError is null ? "mo-vl-role--neutral" : "mo-vl-role--error")">
                    <MoIcon Icon="@(loading ? MoIcons.Refresh : State.RefreshError is null ? MoIcons.Route : MoIcons.Error)"
                            Class="@(loading ? "dc-spin" : null)" Size="18px" />
                </span>
                <h2>@L[loading ? "Workbench:Loading" : State.RefreshError is null ? "Design:EmptyTitle" : "Design:LoadFailedTitle"]</h2>
                <p>@L[loading ? "Workbench:LoadingDescription" : State.RefreshError is null ? "Design:EmptyBody" : "Design:LoadFailedBody"]</p>
                @if (!loading)
                {
                    @if (State.RefreshError is { } failure)
                    {
                        <p class="mono dc-gate-err">@failure</p>
                    }
                    <button type="button" class="btn @(State.RefreshError is null ? "btn-outline" : "btn-primary")" @onclick="RefreshAsync">
                        <MoIcon Icon="@MoIcons.Refresh" Size="15px" />@L["Common:Actions:Refresh"]
                    </button>
                }
            </MoContentState>
        </section>
    }
    else
    {
        <DataChannelDecision View="view" Query="Query" Exceptions="Exceptions" OnQuery="ChangeFilter" />
        @if (Exceptions)
        {
            <ChannelExceptionDirectory View="view" Query="Query" OnQuery="ChangeFilter" OnClear="ClearHistoryAsync" IsBusy="IsChannelBusy" />
        }
        else
        {
            <ChannelDirectory View="view" Query="Query" OnQuery="ChangeFilter" OnReinitialize="ReinitializeAsync" OnClear="ClearHistoryAsync"
                              OnStart="StartSetupAsync" OnStop="StopSetupAsync" OnRestart="RestartSetupAsync"
                              IsBusy="IsChannelBusy" SetupBusy="SetupBusy" />
        }
        <p class="dc-scope-note"><MoIcon Icon="@MoIcons.Info" Size="16px" />
            <span>@L[Exceptions ? "Design:ExScopeNote" : "Design:ScopeNote"]</span>
        </p>
    }
</div>

@if (Query.Inspect is not null && (!Query.Debugger || sheetChannel is null))
{
    <DataChannelEvidenceSheet @key="Query.Inspect" Query="Query" Channel="sheetChannel" ExceptionsRoute="Exceptions"
                              IsLoading="loading" IsBusy="@(sheetChannel is not null && IsChannelBusy(sheetChannel.Id))"
                              OnQuery="ChangeFilter" OnClose="CloseSheet" OnReinitialize="ReinitializeAsync" OnClear="ClearHistoryAsync" />
}

@code {
    private (MoVisualRole Role, string Label) Posture(DataChannelView? view, bool loading)
    {
        if (loading || State.IsRefreshing) return (MoVisualRole.Info, L["Design:Posture:Loading"]);
        if (State.RefreshError is not null) return (MoVisualRole.Warning, L["Design:Posture:Stale"]);
        if (view is null || view.Total == 0) return (MoVisualRole.Neutral, L["Design:Posture:Empty"]);
        if (view.Attention > 0) return (MoVisualRole.Error, L["Design:Posture:Attention", view.Attention]);
        return (MoVisualRole.Success, L["Design:Posture:Calm"]);
    }
}
