@using Monica.JobScheduler.Models
@using Monica.JobScheduler.Models.Definitions
@using Monica.JobScheduler.Models.Operations
@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L

<header class="job-detail-header">
    <div class="job-detail-header__main">
        <section class="job-detail-header__identity">
            <p class="job-detail-header__eyebrow">@L[$"JobTypes:{Definition.Declaration.JobType}"] · @Definition.OwnerKey</p>
            <h2>@Definition.EffectiveConfiguration.JobName</h2>
            <div class="job-detail-header__key"><code>@Definition.Declaration.JobKey</code><SchedulerCopyButton Value="@Definition.Declaration.JobKey" /></div>
            <div class="job-detail-header__chips">
                <span class="job-detail-header__status" data-tone="primary">@L[$"JobTypes:{Definition.Declaration.JobType}"]</span>
                <span class="job-detail-header__status" data-tone="@(IsPolicyDisabled ? "warning" : "success")">
                    <MoIcon Icon="@(IsPolicyDisabled ? MoIcons.PauseCircle : MoIcons.Success)" Size="1.5rem" />
                    @(IsPolicyDisabled ? L["Catalog:Policy:Paused"] : L["Catalog:Policy:Enabled"])
                </span>
                @if (IsManualSuppressed)
                {
                    <MudTooltip Text="@L["Catalog:Lifecycle:ManualSuppressedDescription"]" Placement="Placement.Top" Arrow="true">
                        <span class="job-detail-header__status" data-tone="info">
                            <MoIcon Icon="@MoIcons.Bug" Size="1.5rem" />@L["Catalog:Lifecycle:ManualSuppressed"]
                        </span>
                    </MudTooltip>
                }
                @if (!Definition.IsPresent)
                {
                    <span class="job-detail-header__status" data-tone="warning">
                        <MoIcon Icon="@MoIcons.CloudOff" Size="1.5rem" />@L["JobDetail:Header:OwnerAbsent"]
                    </span>
                }
            </div>
        </section>
        <div class="job-detail-header__operations">
            <div class="job-detail-header__actions">
                @if (Definition.Declaration.JobType == JobType.Triggered)
                {
                    <span class="job-detail-header__primary-action">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Play"
                                   Disabled="@(!Definition.IsPresent || Definition.IsDisabled || IsMutating)" OnClick="OnTrigger">
                            @L["Catalog:Actions:Trigger"]
                        </MudButton>
                    </span>
                }
                @if (Definition.Declaration.JobType == JobType.Recurring)
                {
                    <MudTooltip Text="@(IsManualSuppressed ? L["Catalog:Actions:RunDuringManual"] : L["Catalog:Actions:Run"])" Placement="Placement.Top" Arrow="true">
                        <span class="job-detail-header__primary-action">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Play"
                                       Disabled="@(!Definition.IsPresent || IsMutating)" OnClick="OnRunNow">@L["Workspace:RunNow"]</MudButton>
                        </span>
                    </MudTooltip>
                    <MudTooltip Text="@ToggleDisabledTooltip" Placement="Placement.Top" Arrow="true">
                        <span class="job-detail-header__semantic-action" data-tone="@(IsOperatorPaused ? "success" : "warning")">
                            <MudButton Variant="Variant.Outlined" Color="Color.Default"
                                       StartIcon="@(IsOperatorPaused ? MoIcons.PlayCircle : MoIcons.PauseCircle)"
                                       Disabled="@IsMutating" OnClick="OnToggleDisabled">
                                @(IsOperatorPaused ? L["Workspace:ResumeSchedule"] : L["Workspace:PauseSchedule"])
                            </MudButton>
                        </span>
                    </MudTooltip>
                    <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.CalendarSync"
                               Disabled="@IsMutating" OnClick="OnInspectSchedule">@L["Workspace:EditCron"]</MudButton>
                }
                <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Sliders"
                           Disabled="@IsMutating" OnClick="OnEditPolicy">@L["Workspace:EditPolicy"]</MudButton>

            </div>
        </div>
    </div>

</header>

@code {
    /// <summary>
    /// Gets the operational snapshot rendered by this header.
    /// </summary>
    [Parameter, EditorRequired]
    public JobOperationalSummary Summary { get; set; } = null!;

    /// <summary>
    /// Gets whether the owning detail page is refreshing.
    /// </summary>
    [Parameter]
    public bool IsRefreshing { get; set; }

    /// <summary>
    /// Gets whether an operator mutation is being persisted.
    /// </summary>
    [Parameter]
    public bool IsMutating { get; set; }

    /// <summary>
    /// Gets the callback that refreshes the owning operational snapshot.
    /// </summary>
    [Parameter]
    public EventCallback OnRefresh { get; set; }

    /// <summary>
    /// Gets the callback that opens the complete recurring schedule and policy editor.
    /// </summary>
    [Parameter]
    public EventCallback OnInspectSchedule { get; set; }

    /// <summary>
    /// Gets the callback that opens the operator policy editor.
    /// </summary>
    [Parameter]
    public EventCallback OnEditPolicy { get; set; }

    /// <summary>
    /// Gets the callback that toggles recurring materialization.
    /// </summary>
    [Parameter]
    public EventCallback OnToggleDisabled { get; set; }

    /// <summary>
    /// Gets the callback that admits an immediate operator occurrence without advancing the recurring cursor.
    /// </summary>
    [Parameter]
    public EventCallback OnRunNow { get; set; }

    /// <summary>
    /// Gets the callback that opens triggered execution admission.
    /// </summary>
    [Parameter]
    public EventCallback OnTrigger { get; set; }

    private JobDefinition Definition => Summary.Definition;

    private bool IsPolicyDisabled => Definition.IsDisabled;

    private bool IsOperatorPaused => JobSchedulerUiPresentation.IsOperatorPaused(Summary);

    private bool IsManualSuppressed => JobSchedulerUiPresentation.IsManualSuppressed(Summary);

    private string ToggleDisabledTooltip => JobSchedulerUiPresentation.IsManualOnlySuppressed(Summary)
        ? L["Catalog:Actions:PauseUnavailableManual"]
        : IsOperatorPaused
            ? L["Catalog:Actions:Resume"]
            : L["Catalog:Actions:Pause"];

}
