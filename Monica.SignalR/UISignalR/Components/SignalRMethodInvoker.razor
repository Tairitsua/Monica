@inherits SignalRWorkspaceView
@inject SignalRInvocationArgumentParser Parser

<div class="sr-invoke" aria-busy="@Aria(_invoking)">
    <div class="sr-method-picker">
        <div class="sr-search-row"><div class="sr-search"><MoIcon Icon="@MoIcons.Search" Size="14px" /><input type="search" spellcheck="false" aria-label="@T("Workspace:InvSearchPlaceholder")" placeholder="@T("Workspace:InvSearchPlaceholder")" value="@Filter" @oninput='args => Context.Set("catalogQ", args.Value?.ToString())' /></div><span class="sr-muted mono">@T("Workspace:InvMethodCount", Filtered.Count, S.HubMethods.Count)</span></div>
        @if (Filtered.Count == 0) { <MoContentState Compact="true">@T("Workspace:InvNoMatch")</MoContentState> }
        else
        {
            <SignalRKeyboardRegion Class="sr-method-region" Selector=".sr-method-opt">
            <ul class="sr-method-list" role="listbox" aria-label="@T("Workspace:DeskTabs:Invoke")">
                @foreach (var method in Filtered)
                {
                    <li @key="method.Name"><button class="sr-method-opt @(Selected?.Name == method.Name ? "is-selected" : null)" type="button" role="option" aria-selected="@Aria(Selected?.Name == method.Name)" @onclick="() => Select(method.Name)">
                        <div class="sr-method-opt-copy"><strong>@method.Name</strong>@if (Description(method) is { Length: > 0 } description && description != method.Name) { <small>@description</small> }</div>
                        <div class="sr-method-opt-tags"><span class="sr-param-count mono">@T("Workspace:ParameterCount", method.Args.Count)</span>@if (HasServerSend(method)) { <span class="sr-micro mo-vl-role--third">@T("Workspace:InvObservedTag")</span> }@if (method.IsListening) { <span class="sr-micro mo-vl-role--info">@T("Workspace:InvListeningTag")</span> }</div>
                    </button></li>
                }
            </ul>
            </SignalRKeyboardRegion>
        }
    </div>
    @if (Selected is { } selected)
    {
        <div class="sr-invoke-form">
            <div class="sr-sig-box"><span class="sr-sig-label">@T("Workspace:InvSignatureLabel")</span><code class="mono sr-break">@Signature(selected)</code></div>
            @if (selected.Args.Count == 0) { <p class="sr-muted">@T("Workspace:InvNoParams")</p> }
            else
            {
                <div class="sr-params"><p class="sr-muted">@T("Workspace:InvDefaultsHelp")</p>
                    @foreach (var arg in selected.Args)
                    {
                        var valid = Valid(arg);
                        <div class="sr-field" @key="(selected.Name, arg.Name)"><label for="@($"sr-arg-{arg.Name}")"><span>@arg.Name</span><code class="mono sr-type-tag">@arg.TypeName</code></label>
                            <input id="@($"sr-arg-{arg.Name}")" class="sr-input mono @(!valid ? "is-invalid" : null)" aria-invalid="@Aria(!valid)" spellcheck="false" disabled="@_invoking" value="@Value(arg)" @oninput="args => S.MethodParameters[arg.Name] = args.Value?.ToString() ?? string.Empty" />
                            @if (valid) { <span class="sr-field-help">@T($"Workspace:InvHelpers:{Kind(arg.TypeName)}", arg.TypeName)</span> }
                            else { <span class="sr-field-err" role="alert">@T($"Workspace:InvErrors:{ErrorKind(arg)}")</span> }
                        </div>
                    }
                </div>
            }
            @if (!S.ConnectionState.IsConnected) { <p class="sr-connect-hint"><MoIcon Icon="@MoIcons.Info" Size="14px" />@T("Workspace:InvConnectHelp")</p> }
            <div class="sr-form-actions"><button class="sr-btn sr-btn-primary" disabled="@(_invoking || !S.ConnectionState.IsConnected || selected.Args.Any(arg => !Valid(arg)))" @onclick="Invoke"><MoIcon Icon="@MoIcons.Play" Size="15px" />@T("Workspace:InvInvoke")</button>@if (selected.Args.Count > 0) { <button class="sr-btn sr-btn-outline" disabled="@_invoking" @onclick="Clear">@T("Workspace:InvClearParams")</button> }</div>
        </div>
    }
    else { <MoContentState Compact="true">@T("Workspace:InvEmptyCatalog")</MoContentState> }
</div>

@code {
    private bool _invoking;
    private string Filter => Context.Get("catalogQ");
    private List<HubMethodInfo> Filtered => S.HubMethods.Where(method => string.IsNullOrWhiteSpace(Filter) || $"{method.Name} {Description(method)} {Signature(method)}".Contains(Filter.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    private HubMethodInfo? Selected => S.HubMethods.FirstOrDefault(method => method.Name == S.SelectedMethodName) ?? S.HubMethods.FirstOrDefault();
    private string Description(HubMethodInfo method) => Catalog?.Methods.FirstOrDefault(item => item.Name == method.Name)?.Description ?? string.Empty;
    private bool HasServerSend(HubMethodInfo method) => S.SendDiagnostics?.MethodMetrics.Any(metric => metric.HubName == Catalog?.HubName && metric.MethodName == method.Name) == true;
    private string Value(SignalRHubParameterInfo arg) => S.MethodParameters.GetValueOrDefault(arg.Name, string.Empty);
    private bool Valid(SignalRHubParameterInfo arg)
    {
        try { _ = Parser.ConvertValue(Value(arg), arg.TypeName); return true; }
        catch (Exception exception) when (exception is FormatException or OverflowException or JsonException or ArgumentException) { return false; }
    }
    private static string Kind(string type) => type.Replace("System.", string.Empty, StringComparison.Ordinal).ToLowerInvariant() switch
    {
        "string" => "String", "int" or "int32" => "Int", "long" or "int64" => "Long", "double" => "Double", "float" or "single" => "Float",
        "bool" or "boolean" => "Bool", "datetime" => "Datetime", "guid" => "Guid",
        var name when name.Contains("[]", StringComparison.Ordinal) || name.Contains("list", StringComparison.Ordinal) || name.Contains("array", StringComparison.Ordinal) => "Array", _ => "Complex"
    };
    private string ErrorKind(SignalRHubParameterInfo arg) => Kind(arg.TypeName) is "Array" or "Complex" ? "Json" : Kind(arg.TypeName);
    private void Select(string method) { S.SelectMethod(method); Context.Set("method", method); }
    private void Clear() { if (Selected is { } method) foreach (var arg in method.Args) S.MethodParameters[arg.Name] = string.Empty; }
    private Task Invoke() => Context.Run(async () =>
    {
        if (_invoking || Selected is not { } selected || selected.Args.Any(arg => !Valid(arg))) return;
        _invoking = true;
        try { S.SelectMethod(selected.Name); await S.InvokeSelectedMethodAsync(); }
        finally { _invoking = false; }
    });
}
