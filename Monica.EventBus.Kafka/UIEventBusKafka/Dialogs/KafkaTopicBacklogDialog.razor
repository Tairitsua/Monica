@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.UI.Shared.Components.Dialogs
@inject IStringLocalizer<EventBusKafkaResource> L

<MudDialog Gutters="false">
    <TitleContent><MoDialogHeading Text="@L["Topics:Dialog:BacklogTitle", Snapshot.TopicName]" /></TitleContent>
    <DialogContent>
        <div class="kafka-dialog-body">
            <MudStack Spacing="3">
                <KafkaDialogContext ClusterId="@(ClusterId ?? Snapshot.ClusterId)" TopicName="@Snapshot.TopicName" />
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@MoIcons.Info">
                    @L["Topics:BacklogDialog:Summary", Snapshot.TotalRetainedMessageCount, FormatCapturedAt()]
                </MudAlert>

                @if (Snapshot.Partitions.Count == 0)
                {
                    <KafkaWorkspaceState Icon="@MoIcons.Rows"
                                         Title="@L["Topics:Actions:Backlog"]"
                                         Description="@L["Topics:BacklogDialog:Empty"]"
                                         AccentColor="Color.Info" />
                }
                else
                {
                    <KafkaTableSurface AriaLabel="@L["Topics:Actions:Backlog"]"
                                       AccentColor="Color.Info"
                                       Size="KafkaTableSurfaceSize.Compact">
                        <MudTable T="KafkaTopicPartitionBacklog"
                                  Items="Snapshot.Partitions"
                                  Dense="true"
                                  Hover="true"
                                  Striped="true"
                                  Breakpoint="Breakpoint.Xs" Square="true" Elevation="0" RowsPerPage="25">
                            <HeaderContent>
                                <MudTh>@L["Topics:BacklogDialog:Columns:Partition"]</MudTh>
                                <MudTh>@L["Topics:BacklogDialog:Columns:EarliestOffset"]</MudTh>
                                <MudTh>@L["Topics:BacklogDialog:Columns:LatestOffset"]</MudTh>
                                <MudTh>@L["Topics:BacklogDialog:Columns:RetainedMessages"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["Topics:BacklogDialog:Columns:Partition"]">@context.Partition</MudTd>
                                <MudTd DataLabel="@L["Topics:BacklogDialog:Columns:EarliestOffset"]">@context.EarliestOffset</MudTd>
                                <MudTd DataLabel="@L["Topics:BacklogDialog:Columns:LatestOffset"]">@context.LatestOffset</MudTd>
                                <MudTd DataLabel="@L["Topics:BacklogDialog:Columns:RetainedMessages"]">@context.RetainedMessageCount</MudTd>
                            </RowTemplate>
                            <PagerContent><MudTablePager PageSizeOptions="@KafkaTablePageSizes.Standard" RowsPerPageString="@L["Common:Pagination:RowsPerPage"]" InfoFormat="@L["Common:Pagination:InfoFormat"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" /></PagerContent>
                        </MudTable>
                    </KafkaTableSurface>
                }
            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <KafkaPrimaryButton OnClick="Close">
            @L["Common:Actions:Close"]
        </KafkaPrimaryButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired] public KafkaTopicBacklogSnapshot Snapshot { get; set; } = new();

    /// <summary>Gets or sets the exact frozen cluster identity, when supplied by the opener.</summary>
    [Parameter] public string? ClusterId { get; set; }

    private string FormatCapturedAt()
    {
        return UiTime.Format(Snapshot.CapturedAt);
    }

    private void Close()
    {
        MudDialog?.Close();
    }
}
