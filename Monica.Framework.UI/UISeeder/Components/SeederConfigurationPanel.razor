@inject IStringLocalizer<SeederResource> L

@if (Session.Snapshot is { Configuration: { } configuration } && Session.Graph is { } graph)
{
    <section class="seeder-configuration" aria-labelledby="seeder-configuration-title">
        <header class="seeder-configuration-heading">
            <div>
                <h2 id="seeder-configuration-title">@L["Configuration:Title"]</h2>
                <p>@L["Configuration:Subtitle"]</p>
            </div>
            <span>@L["Configuration:Overrides", graph.OverrideCount, graph.Run.TotalCount]</span>
        </header>

        <div class="seeder-policy-groups">
            <section aria-labelledby="seeder-scheduling-policy-title">
                <h3 id="seeder-scheduling-policy-title"><MoIcon Icon="@MoIcons.Workflow" Size="14px" />@L["Configuration:Groups:Scheduling"]</h3>
                <dl>
                    <div><dt>@L["Configuration:ExecutionMode"]</dt><dd>@L.GetText(configuration.DefaultExecutionMode)</dd></div>
                    <div><dt>@L["Configuration:MaxConcurrency"]</dt><dd><code>@configuration.MaxConcurrency</code></dd></div>
                </dl>
            </section>
            <section aria-labelledby="seeder-readiness-policy-title">
                <h3 id="seeder-readiness-policy-title"><MoIcon Icon="@MoIcons.Success" Size="14px" />@L["Configuration:Groups:Readiness"]</h3>
                <dl><div><dt>@L["Configuration:Criticality"]</dt><dd>@L.GetText(configuration.DefaultCriticality)</dd></div></dl>
            </section>
            <section aria-labelledby="seeder-retry-policy-title">
                <h3 id="seeder-retry-policy-title"><MoIcon Icon="@MoIcons.Refresh" Size="14px" />@L["Configuration:Groups:Retries"]</h3>
                <dl>
                    <div><dt>@L["Configuration:MaxAttempts"]</dt><dd><code>@configuration.DefaultMaxAttempts</code></dd></div>
                    <div><dt>@L["Configuration:RetryBaseDelay"]</dt><dd><code>@L.FormatSeederDuration(configuration.RetryBaseDelay)</code></dd></div>
                    <div><dt>@L["Configuration:RetryMaxDelay"]</dt><dd><code>@L.FormatSeederDuration(configuration.RetryMaxDelay)</code></dd></div>
                </dl>
            </section>
            <section aria-labelledby="seeder-failure-policy-title">
                <h3 id="seeder-failure-policy-title"><MoIcon Icon="@MoIcons.Warning" Size="14px" />@L["Configuration:Groups:Failure"]</h3>
                <dl><div><dt>@L["Configuration:FailureBehavior"]</dt><dd>@L.GetText(configuration.DefaultFailureBehavior)</dd></div></dl>
            </section>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public SeederPageSession Session { get; set; } = default!;
}
