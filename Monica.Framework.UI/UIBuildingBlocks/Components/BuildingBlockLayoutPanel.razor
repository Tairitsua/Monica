@inject IStringLocalizer<BuildingBlocksResource> L

<section class="building-block-graph-layout-panel" aria-label="@L["BuildingBlockLayoutPanel:Sections:LayoutType"]">
    <div class="building-block-graph-layout-choice">
        <span>@L["BuildingBlockLayoutPanel:Sections:LayoutType"]</span>
        <div role="group" aria-label="@L["BuildingBlockLayoutPanel:Sections:LayoutType"]">
            @foreach (var layout in Enum.GetValues<LayoutType>())
            {
                <button type="button" aria-pressed="@(CurrentLayout == layout ? "true" : "false")" @onclick="() => SetLayout(layout)">@L[$"BuildingBlockLayoutPanel:Layouts:{layout}"]</button>
            }
        </div>
    </div>
    @if (CurrentLayout == LayoutType.Force)
    {
        <div class="building-block-graph-force-setting">
            <span>@L["BuildingBlockLayoutPanel:Fields:ForceDistance", ForceDistance]</span>
            <MudSlider T="int" Value="@ForceDistance" ValueChanged="@OnForceDistanceChanged" Min="50" Max="2000" Step="10" Color="Color.Primary" aria-label="@L["BuildingBlockLayoutPanel:Workspace:DistanceLabel"]" />
        </div>
        <div class="building-block-graph-force-setting">
            <span>@L["BuildingBlockLayoutPanel:Fields:ForceStrength", ForceStrength]</span>
            <MudSlider T="int" Value="@ForceStrength" ValueChanged="@OnForceStrengthChanged" Min="-1000" Max="-100" Step="50" Color="Color.Primary" aria-label="@L["BuildingBlockLayoutPanel:Workspace:StrengthLabel"]" />
        </div>
    }
</section>

@code {
    [Parameter] public LayoutType CurrentLayout { get; set; } = LayoutType.Force;
    [Parameter] public EventCallback<LayoutType> CurrentLayoutChanged { get; set; }
    [Parameter] public int ForceDistance { get; set; } = 550;
    [Parameter] public EventCallback<int> ForceDistanceChanged { get; set; }
    [Parameter] public int ForceStrength { get; set; } = -300;
    [Parameter] public EventCallback<int> ForceStrengthChanged { get; set; }

    public enum LayoutType { Force, Hierarchy, Circular, MultiCircular }

    private async Task SetLayout(LayoutType layoutType)
    {
        CurrentLayout = layoutType;
        await CurrentLayoutChanged.InvokeAsync(layoutType);
    }

    private async Task OnForceDistanceChanged(int value)
    {
        ForceDistance = value;
        await ForceDistanceChanged.InvokeAsync(value);
    }

    private async Task OnForceStrengthChanged(int value)
    {
        ForceStrength = value;
        await ForceStrengthChanged.InvokeAsync(value);
    }
}
