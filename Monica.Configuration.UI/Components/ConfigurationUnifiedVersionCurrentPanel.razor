@inject IStringLocalizer<ConfigurationUIResource> L

<section class="configuration-captured-version" aria-label="@L["Versions:Current:Title"]">
    <div class="configuration-captured-identity">
        <span class="configuration-captured-eyebrow"><MoIcon Icon="@MoIcons.Layers" Size="1.25rem" />@L["Versions:Current:Title"]</span>
        <strong class="configuration-captured-number">@ConfigurationUnifiedVersionDisplayFormatter.VersionLabel(Version)</strong>
        <p>@L["Versions:Workbench:LatestHelp"]</p>
    </div>
    <div class="configuration-captured-audit">
        <div><span>@L["Versions:Workbench:CapturedAt"]</span><time datetime="@Version.CreatedTime.ToString("O")">@TimeDisplay.Format(Version.CreatedTime)</time></div>
        <div><span>@L["History:Dialog:Operator"]</span><strong>@ConfigurationUnifiedVersionDisplayFormatter.OperatorText(Version, L["Common:States:Empty"])</strong>
            @if (!string.IsNullOrWhiteSpace(Version.ModifierName) && !string.IsNullOrWhiteSpace(Version.ModifierId) && Version.ModifierName != Version.ModifierId)
            {
                <ConfigurationAuditIdentity Label="@L["Versions:Workbench:OperatorId"]" Value="@Version.ModifierId" />
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Version.MutationGroupId))
        {
            <div class="configuration-captured-group"><ConfigurationAuditIdentity Label="@L["Versions:Workbench:CaptureGroup"]" Value="@Version.MutationGroupId" /></div>
        }
        @if (!string.IsNullOrWhiteSpace(Version.Reason)) { <p class="configuration-captured-reason">@Version.Reason</p> }
    </div>
    <div class="configuration-captured-scope" @key="Version.Version">
        <ConfigurationDefinitionScope DefinitionKeys="Version.DefinitionKeys" DefinitionCount="Version.DefinitionCount" />
        @if (Version.TriggerDefinitionKeys.Count > 0)
        {
            <span class="configuration-captured-trigger">@L["Versions:Workbench:TriggeredBy"]</span>
            <ConfigurationDefinitionScope DefinitionKeys="Version.TriggerDefinitionKeys" />
        }
    </div>
</section>

@code {
    /// <summary>Gets or sets the newest returned saved snapshot, not the current effective configuration.</summary>
    [Parameter, EditorRequired] public ConfigurationUnifiedVersionSummary Version { get; set; } = default!;
}
