@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.Core.Results
@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.State
@using Microsoft.Extensions.Logging
@implements IAsyncDisposable
@inject EventBusTestService TestService
@inject ISnackbar Snackbar
@inject IStringLocalizer<EventBusResource> L
@inject ILogger<EventBusTestPanel> Logger


@using Monica.EventBus.Abstractions
@using Monica.EventBus.Models
@using Monica.Framework.UI.Pages
@using Monica.Framework.UI.UIEventBus.Support
@using Monica.UI.Shared.Components.States
@{
    var rows = Workbench.RowListenerIds.Order(StringComparer.Ordinal).ToArray();
    var defaultProvider = Workbench.Model?.Provider(EventSubscriptionScope.Distributed, null);
    var accepted = _acceptedId is not null;
    var verified = accepted && _messages.Any(message => message.EventData.MessageId == _acceptedId);
    var sameTopic = string.Equals(_publishTopicName, _subscribeTopicName, StringComparison.Ordinal);
    var retention = EventBusTestService.StandaloneReceiptLimit;
}

<section class="eb-sig">
    <EventBusDecision Label="@L["Precision:TtLabel"]" Value="@(rows.Length + (_ownsSubscription ? 1 : 0))"
                      Population="@L["Precision:TtPopulation", ListenerStateText, rows.Length]" Role="@(_ownsSubscription || rows.Length > 0 ? "info" : "neutral")">
        <Finding>
            @if (_ownsSubscription)
            {
                @L["Precision:TtActiveFinding"] <code class="mono eb-break">@_subscribeTopicName</code>
                @L["Precision:TtActiveDetail", _messages.Count, rows.Length]
            }
            else
            {
                @L["Precision:TtStoppedFinding"]
                @if (rows.Length > 0) { @L["Precision:SubListenerFinding", rows.Length] @L["Precision:SubListenerDetail"] }
            }
        </Finding>
    </EventBusDecision>
    <div class="eb-loop-bar">
        <div class="eb-loop-head">
            <div class="eb-loop-id"><span class="tile mo-vl-role--third"><MoIcon Icon="@MoIcons.Cloud" Size="16px" /></span>
                <div><h2>@L["Precision:TtLoopTitle"]</h2><p>@L["Precision:TtLoopSub"]</p></div>
            </div>
            <div class="eb-loop-tags">
                @if (defaultProvider is not null) { <EventBusTransportBadge Distributed="true" Kind="@defaultProvider.ProviderType" /> }
                <code class="chip is-outline is-mono">@nameof(TestEventMessage)</code>
            </div>
        </div>
        <ol class="eb-loop-steps" aria-label="@L["Precision:TtLoopTitle"]">
            <li class="eb-loop-step @(_ownsSubscription ? "is-done" : null)">
                <span class="status mo-vl-role--@(_ownsSubscription ? "success" : "neutral")"><span class="status-dot"></span>@L["Precision:TtStepListen"]</span>
                <span class="eb-row-sub">@ListenerStateText</span>
            </li>
            <li class="eb-loop-arrow" aria-hidden="true"><MoIcon Icon="@MoIcons.ArrowRight" Size="14px" /></li>
            <li class="eb-loop-step @(accepted ? "is-done" : null)">
                <span class="status mo-vl-role--@(accepted ? "primary" : "neutral")"><span class="status-dot"></span>@L["Precision:TtStepPublish"]</span>
                <span class="eb-row-sub mono eb-break">@(_acceptedId ?? "—")</span>
            </li>
            <li class="eb-loop-arrow" aria-hidden="true"><MoIcon Icon="@MoIcons.ArrowRight" Size="14px" /></li>
            <li class="eb-loop-step @(verified ? "is-done" : null)">
                <span class="status mo-vl-role--@(verified ? "success" : "neutral")"><span class="status-dot"></span>@L["Precision:TtStepVerify"]</span>
                <span class="mono eb-row-sub">@_messages.Count / @retention</span>
            </li>
        </ol>
    </div>
</section>
<div class="eb-tt-grid">
    <section class="surface eb-tt-receive">
        <header class="surface-head">
            <span class="tile mo-vl-role--@(_ownsSubscription ? "success" : "info")"><MoIcon Icon="@MoIcons.Radio" Size="18px" /></span>
            <div><h2>@L["Precision:TtStepListen"]</h2><p>@L["Precision:TtRetainedReceipts", _messages.Count, retention]</p></div>
            <span class="status is-pill aside mo-vl-role--@(_ownsSubscription ? "success" : _listenerFailed ? "error" : "neutral")"><span class="status-dot"></span>@ListenerStateText</span>
        </header>
        <div class="surface-body eb-tt-body">
            <div class="eb-field">
                <label for="eb-listen-topic" class="eb-field-label">@L["Precision:TtListenTopic"]</label>
                <input id="eb-listen-topic" type="text" class="eb-input mono" spellcheck="false" disabled="@(_ownsSubscription || _commandBusy)" @bind="_subscribeTopicName" @bind:event="oninput" />
            </div>
            <div class="eb-tt-actions">
                <button type="button" class="btn btn-sm btn-soft mo-vl-role--@(_ownsSubscription ? "warning" : "info")"
                        disabled="@(_commandBusy || !_listenerReady)" @onclick="ToggleListeningAsync">
                    <MoIcon Icon="@(_ownsSubscription ? MoIcons.StopCircle : MoIcons.Play)" Size="14px" />@L[_ownsSubscription ? "Precision:TtStopListen" : "Precision:TtStartListen"]
                </button>
                <button type="button" class="btn btn-ghost btn-sm" disabled="@(_commandBusy || _messages.Count == 0)" @onclick="ClearMessages">@L["Precision:TtClearReceipts"]</button>
            </div>
            @if (_messages.Count == 0)
            {
                <div class="eb-tt-empty">
                    <MoIcon Icon="@MoIcons.Inbox" Size="20px" /><h3>@L["Precision:TtNoReceiptsTitle"]</h3><p>@L["Precision:TtNoReceiptsBody"]</p>
                </div>
            }
            else
            {
                <ol class="eb-receipt-list">
                    @foreach (var message in _messages)
                    {
                        var data = message.EventData;
                        var createdAt = data.CreatedAt.Kind == DateTimeKind.Unspecified
                            ? DateTime.SpecifyKind(data.CreatedAt, DateTimeKind.Utc)
                            : data.CreatedAt;
                        <li class="eb-receipt-item" @key="message">
                            <header><span class="eb-receipt-tag"><MoIcon Icon="@MoIcons.ArrowDownLeft" Size="13px" />@L["Precision:TtReceivedAt"]</span>
                                <time class="mono" datetime="@message.ReceivedAt.ToUniversalTime().ToString("O")">@UiTime.FormatTime(message.ReceivedAt)</time>
                            </header>
                            <p class="eb-receipt-msg">@data.Message</p>
                            <dl class="eb-receipt-meta">
                                <div><dt>@L["Precision:TtMessageId"]</dt><dd class="mono eb-break">@data.MessageId <MoCopyButton Value="@data.MessageId" Label="@L["Precision:CopyField", L["Precision:TtMessageId"]]" /></dd></div>
                                <div><dt>@L["Precision:TtCreatedAt"]</dt><dd><time class="mono" datetime="@createdAt.ToUniversalTime().ToString("O")">@UiTime.Format(createdAt)</time></dd></div>
                                <div class="is-wide"><dt>@L["Precision:TtPublishTopic"]</dt><dd class="mono eb-break">@message.TopicName</dd></div>
                            </dl>
                        </li>
                    }
                </ol>
            }
        </div>
        <footer class="eb-surface-foot"><MoIcon Icon="@MoIcons.Info" Size="14px" />@L["Precision:TtListenerLifetime"]</footer>
    </section>
    <section class="surface eb-tt-publish">
        <EventBusSurfaceHeading Icon="@MoIcons.Send" Title="@L["Precision:TtStepPublish"]" Description="@L["Precision:TtAcceptanceCaveat"]" />
        <form class="surface-body eb-tt-body" @onsubmit="PublishMessageAsync" @onsubmit:preventDefault>
            <div class="eb-field">
                <div class="eb-field-head">
                    <label for="eb-pub-topic" class="eb-field-label">@L["Precision:TtPublishTopic"]</label>
                    @if (!sameTopic)
                    {
                        <button type="button" class="eb-inline-link" @onclick="() => _publishTopicName = _subscribeTopicName">@L["Precision:TtMatchListener"]</button>
                    }
                </div>
                <input id="eb-pub-topic" type="text" class="eb-input mono" spellcheck="false" disabled="@_commandBusy" @bind="_publishTopicName" @bind:event="oninput" />
            </div>
            <div class="eb-field">
                <label class="eb-field-label" for="eb-pub-msg">@L["Precision:TtMessageContent"]</label>
                <textarea id="eb-pub-msg" class="eb-textarea" rows="6" placeholder="@L["Precision:TtMessagePh"]" disabled="@_commandBusy"
                          @bind="_publishMessage" @bind:event="oninput"></textarea>
            </div>
            <div class="eb-tt-actions">
                <button type="submit" class="btn btn-primary" disabled="@_commandBusy"><MoIcon Icon="@MoIcons.Send" Size="15px" />@L[_publishing ? "TestPanel:Publish:Sending" : "Precision:TtSend"]</button>
            </div>
            @if (accepted)
            {
                <div class="callout mo-vl-role--success" role="status"><span class="tile"><MoIcon Icon="@MoIcons.Check" Size="16px" /></span>
                    <p>@L["Precision:TtAcceptedBanner", _acceptedId!]</p>
                </div>
            }
        </form>
    </section>
</div>
<section class="surface eb-retained-surface">
    <EventBusSurfaceHeading Icon="@MoIcons.Flask" Role="info" Title="@L["Precision:TtRetainedTitle"]" Description="@L["Precision:TtRetainedSub"]" Count="@rows.Length.ToString()" />
    @if (rows.Length == 0)
    {
        <div class="eb-retained-empty">
            <p>@L["Precision:TtNoRetained"]</p><a class="btn btn-outline btn-sm" href="@UIEventBusSubscriptionsPage.PAGE_URL"><MoIcon Icon="@MoIcons.Route" Size="14px" />@L["Precision:ChGoToSubs"]</a>
        </div>
    }
    else
    {
        <ul class="eb-retained-list">
            @foreach (var id in rows)
            {
                var source = Workbench.Model!.Snapshot.Subscriptions.FirstOrDefault(item => item.SubscriptionId == id);
                var listener = TestService.GetRuntimeListenerSnapshot(new EventSubscriptionId(Guid.Parse(id)));
                <li class="eb-retained-row" @key="id">
                    <div class="eb-retained-id">
                        <span class="status is-pill mo-vl-role--success"><span class="status-dot is-live"></span>@L["Precision:TtListening"]</span>
                        <div class="eb-cell-stack"><b>@(source?.EventTypeShortName ?? L["Precision:TtRemovedSource"].Value)</b>
                            <span class="mono eb-row-sub eb-break">@listener.TopicName · @id[..Math.Min(id.Length, 12)]</span>
                        </div>
                    </div>
                    <span class="mono eb-row-sub">@L["Precision:TtRetainedReceipts", listener.MessageCount, TestService.RuntimeReceiptLimit]</span>
                    <div class="eb-retained-acts">
                        @if (source is not null)
                        {
                            <button class="btn btn-outline btn-sm" type="button" @onclick="() => Workbench.OpenTest(id)"><MoIcon Icon="@MoIcons.Flask" Size="14px" />@L["Precision:TtReopenTest"]</button>
                        }
                        <button class="btn btn-soft btn-sm mo-vl-role--warning" type="button" disabled="@Workbench.Busy" @onclick="() => Workbench.StopListenerAsync(id)"><MoIcon Icon="@MoIcons.StopCircle" Size="14px" />@L["Precision:TtStopListener"]</button>
                    </div>
                </li>
            }
        </ul>
    }
</section>

@code {
    /// <summary>Gets the workbench whose rail and diagnostics share the circuit's listener state.</summary>
    [CascadingParameter] public EventBusWorkbench Workbench { get; set; } = null!;

    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly object _disposeSync = new();
    private CancellationToken _lifetimeToken;
    private CancellationTokenSource? _refreshCancellation;
    private PeriodicTimer? _refreshTimer;
    private Task? _refreshTask;
    private Task? _acquireTask;
    private Task? _commandTask;
    private Task? _disposeTask;
    private List<ReceivedTestMessage> _messages = [];
    private EventBusStandaloneListenerLease? _listenerLease;
    private string _publishTopicName = string.Empty;
    private string _publishMessage = string.Empty;
    private string _subscribeTopicName = string.Empty;
    private bool _commandBusy;
    private bool _publishing;
    private bool _ownsSubscription;
    private bool _listenerReady;
    private bool _listenerFailed;
    private string? _acceptedId;
    private bool _retired;
    private TopicSubscriptionRuntimeState? ListenerTransport =>
        _ownsSubscription ? Workbench.Model?.Topic(EventBusCaptureView.TopicId(null, _subscribeTopicName))?.Status?.State : null;

    private string ListenerStateText => ListenerTransport is { } reported && reported != TopicSubscriptionRuntimeState.Healthy
        ? L.GetTopicRuntimeStateText(reported)
        : _listenerReady ? L[_ownsSubscription ? "TestBench:Listening" : "TestBench:Stopped"].Value
        : L[_listenerFailed ? "TestBench:ListenerUnavailable" : "TestBench:PreparingListener"].Value;

    protected override async Task OnInitializedAsync()
    {
        _lifetimeToken = _lifetimeCancellation.Token;
        _publishTopicName = typeof(TestEventMessage).FullName!;
        _subscribeTopicName = _publishTopicName;
        RefreshMessages();
        await (_acquireTask = AcquireListenerAsync());
    }

    private async Task AcquireListenerAsync()
    {
        try
        {
            _listenerLease = await TestService.AcquireStandaloneListenerLeaseAsync(_lifetimeToken);
            if (_retired) return;
            _listenerReady = true;
            AdoptListenerSnapshot();
            if (_ownsSubscription) StartRefreshLoop();
        }
        catch (OperationCanceledException) when (_lifetimeToken.IsCancellationRequested)
        {
            // Retirement cancels an ownership wait and still drains its actual acquisition task.
        }
        catch (Exception error)
        {
            Logger.LogError(error, "Acquiring the standalone EventBus test listener failed");
            if (!_retired) _listenerFailed = true;
        }
    }

    private void AdoptListenerSnapshot()
    {
        var snapshot = _listenerLease?.Snapshot;
        _ownsSubscription = snapshot is not null;
        if (snapshot is not null) _subscribeTopicName = snapshot.TopicName;
    }

    private Task PublishMessageAsync()
    {
        if (_retired || _commandBusy) return Task.CompletedTask;
        if (string.IsNullOrWhiteSpace(_publishMessage))
        {
            Snackbar.Add(L["TestPanel:Validation:MessageRequired"], Severity.Warning);
            return Task.CompletedTask;
        }
        var message = _publishMessage;
        var topic = _publishTopicName;
        _publishing = true;
        _acceptedId = null;
        return AdmitCommandAsync(async () =>
        {
            var result = await TestService.PublishStandaloneMessageAsync(message, topic, _lifetimeToken);
            if (_retired) return;
            var error = result;
            if (result.IsFailure())
            {
                Snackbar.Add(L["TestPanel:Snackbars:PublishFailed", error.Message ?? string.Empty], Severity.Error);
                return;
            }
            _acceptedId = result.Data?.MessageId;
            _publishMessage = string.Empty;
            Snackbar.Add(L["TestBench:Accepted"], Severity.Success);
        });
    }

    private Task ToggleListeningAsync() => _ownsSubscription ? StopListeningAsync() : StartListeningAsync();

    private Task StartListeningAsync()
    {
        if (_retired || _commandBusy || !_listenerReady || _ownsSubscription || _listenerLease is not { } lease) return Task.CompletedTask;
        if (string.IsNullOrWhiteSpace(_subscribeTopicName))
        {
            Snackbar.Add(L["TestPanel:Validation:TopicRequired"], Severity.Warning);
            return Task.CompletedTask;
        }
        var topic = _subscribeTopicName;
        return AdmitCommandAsync(async () =>
        {
            var result = await lease.SubscribeAsync(topic);
            if (_retired) return;
            AdoptListenerSnapshot();
            var error = result;
            if (result.IsFailure())
            {
                if (!_retired) Snackbar.Add(L["TestPanel:Snackbars:SubscribeFailed", error.Message ?? string.Empty], Severity.Error);
                return;
            }
            StartRefreshLoop();
            RefreshMessages();
            Snackbar.Add(L["TestPanel:Snackbars:SubscribeSucceeded"], Severity.Success);
        });
    }

    private Task StopListeningAsync()
    {
        if (_retired || _commandBusy || !_listenerReady || !_ownsSubscription || _listenerLease is not { } lease) return Task.CompletedTask;
        return AdmitCommandAsync(async () =>
        {
            var result = await lease.UnsubscribeAsync();
            if (_retired) return;
            AdoptListenerSnapshot();
            var error = result;
            if (result.IsFailure())
            {
                if (!_retired) Snackbar.Add(L["TestPanel:Snackbars:UnsubscribeFailed", error.Message ?? string.Empty], Severity.Warning);
                return;
            }
            await StopRefreshLoopAsync();
            if (_retired) return;
            RefreshMessages();
            Snackbar.Add(L["TestPanel:Snackbars:UnsubscribeSucceeded"], Severity.Info);
        });
    }

    private Task AdmitCommandAsync(Func<Task> command)
    {
        if (_retired || _commandBusy) return Task.CompletedTask;
        _commandBusy = true;
        return _commandTask = ExecuteCommandAsync(command);
    }

    private async Task ExecuteCommandAsync(Func<Task> command)
    {
        try { await command(); }
        finally
        {
            _commandBusy = false;
            _publishing = false;
            if (!_retired) { StateHasChanged(); Workbench.ListenerChanged(); }
        }
    }

    private void StartRefreshLoop()
    {
        if (_retired || _refreshTask is not null) return;
        _refreshCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeToken);
        _refreshTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        _refreshTask = RefreshLoopAsync(_refreshTimer, _refreshCancellation.Token);
    }

    private async Task RefreshLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(() =>
                {
                    if (_retired || token.IsCancellationRequested) return;
                    RefreshMessages();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // The component owns this loop and cancels it on stop or retirement.
        }
    }

    private async Task StopRefreshLoopAsync()
    {
        var cancellation = _refreshCancellation;
        var timer = _refreshTimer;
        var task = _refreshTask;
        _refreshCancellation = null;
        _refreshTimer = null;
        _refreshTask = null;
        var failures = new List<Exception>();
        try
        {
            try { cancellation?.Cancel(); }
            catch (Exception error) { failures.Add(error); }
            try { timer?.Dispose(); }
            catch (Exception error) { failures.Add(error); }
            if (task is not null)
            {
                try { await task; }
                catch (Exception error) { failures.Add(error); }
            }
        }
        finally { cancellation?.Dispose(); }
        if (failures.Count > 0) throw new AggregateException(failures);
    }

    private void RefreshMessages() => _messages = TestService.GetReceivedMessages();

    private void ClearMessages()
    {
        if (_retired || _commandBusy || !_listenerReady || _messages.Count == 0) return;
        TestService.ClearReceivedMessages();
        RefreshMessages();
        Snackbar.Add(L["TestPanel:Snackbars:ClearSucceeded"], Severity.Info);
    }

    public ValueTask DisposeAsync()
    {
        lock (_disposeSync) return new(_disposeTask ??= RetireAsync());
    }

    private async Task RetireAsync()
    {
        _retired = true;
        var failures = new List<Exception>();
        try
        {
            try { _lifetimeCancellation.Cancel(); }
            catch (Exception error) { failures.Add(error); }
            if (_acquireTask is not null)
            {
                try { await _acquireTask; }
                catch (Exception error) { failures.Add(error); }
            }
            // Drain the actual command even when a provider ignores cancellation.
            if (_commandTask is not null)
            {
                try { await _commandTask; }
                catch (OperationCanceledException) when (_lifetimeToken.IsCancellationRequested) { }
                catch (Exception error) { failures.Add(error); }
            }
            try { await StopRefreshLoopAsync(); }
            catch (Exception error) { failures.Add(error); }
            if (_listenerLease?.Snapshot is not null)
            {
                try
                {
                    var result = await _listenerLease.UnsubscribeAsync();
                    var error = result;
                    if (result.IsFailure())
                        Logger.LogWarning("Retiring the standalone EventBus test listener failed; its exact subscription remains available for a later owner to retry: {Error}", error.Message);
                    else _ownsSubscription = false;
                }
                catch (Exception error) { failures.Add(error); }
            }
        }
        finally
        {
            try
            {
                if (_listenerLease is { } lease) await lease.DisposeAsync();
            }
            catch (Exception error) { failures.Add(error); }
            finally { _lifetimeCancellation.Dispose(); }
        }
        if (failures.Count > 0) throw new AggregateException(failures);
    }
}
