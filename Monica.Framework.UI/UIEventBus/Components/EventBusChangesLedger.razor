@using Monica.EventBus.Abstractions
@using Monica.EventBus.Models
@using Monica.Framework.UI.Pages
@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.State
@using Monica.Framework.UI.UIEventBus.Support
@using Monica.UI.Shared.Components.States
@inject IStringLocalizer<EventBusResource> L
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime

@{
    var state = Workbench.CaptureState;
    var entries = state.ObservedChanges;
    var latest = entries.FirstOrDefault();
    var lost = state.DroppedChangeCount;
    var expired = Math.Max(0, state.ObservedChangeCount - entries.Count);
    var search = Workbench.Query["q"] ?? "";
    var type = Workbench.Query.Choice<EventSubscriptionChangeType>("type");
    var types = Enum.GetValues<EventSubscriptionChangeType>();
    var pool = entries.Where(change => MatchesSearch(change, search.Trim())).ToArray();
    var shown = pool.Where(change => type is null || change.ChangeType == type).ToArray();
    var page = Math.Min(Workbench.Query.Page, Math.Max(1, (shown.Length + PageSize - 1) / PageSize));
}
<section class="eb-sig">
    <EventBusDecision Label="@L["Precision:ChLabel"]" Value="@entries.Count" Role="@(lost > 0 ? "error" : "info")"
                      Population="@L["Precision:ChUnit", EventBusWorkbenchState.ObservedChangeLimit, state.ObservedChangeCount]">
        <Reasons>
            @foreach (var kind in types)
            {
                <EventBusReason Role="@EventBusVisuals.Role(kind)" Count="@entries.Count(change => change.ChangeType == kind)">@L.GetSubscriptionChangeTypeText(kind)</EventBusReason>
            }
        </Reasons>
        <Finding>
            @if (lost > 0) { <span class="vmark mo-vl-role--error">@L["Precision:ChFeedLossTitle", lost]</span> }
            @if (expired > 0) { <span class="vmark mo-vl-role--neutral">@L["Precision:ChTruncatedTitle", expired, EventBusWorkbenchState.ObservedChangeLimit]</span> }
            @if (latest is not null)
            {
                @L["Precision:ChLatest"]
                <a class="vmark is-link @EventBusVisuals.Role(latest.ChangeType).ToCssClass()" href="@Workbench.InspectionLink("changeId", latest.ObservationId)">@L.GetSubscriptionChangeTypeText(latest.ChangeType) · @latest.Subscription.EventTypeShortName</a>
                <time class="mono" datetime="@EventBusVisuals.TimeTag(latest.Timestamp)">(@UiTime.FormatTime(latest.Timestamp))</time>
            }
            else { @L["Precision:ChScopeNote"] }
        </Finding>
    </EventBusDecision>
    @if (lost > 0 || expired > 0)
    {
        <div class="eb-ch-notices">
            @if (lost > 0)
            {
                <div class="callout mo-vl-role--error" role="alert"><span class="tile"><MoIcon Icon="@MoIcons.Warning" Size="16px" /></span><div><b>@L["Precision:ChFeedLossTitle", lost]</b><p>@L["Precision:ChFeedLossBody"]</p></div></div>
            }
            @if (expired > 0)
            {
                <div class="callout mo-vl-role--neutral"><span class="tile"><MoIcon Icon="@MoIcons.History" Size="16px" /></span>
                    <div><b>@L["Precision:ChTruncatedTitle", expired, EventBusWorkbenchState.ObservedChangeLimit]</b><p>@L["Precision:ChTruncatedBody", EventBusWorkbenchState.ObservedChangeLimit]</p></div>
                </div>
            }
        </div>
    }
    @if (entries.Count > 0) { <EventBusChangeTape Entries="@entries" /> }
</section>

<section class="surface eb-ch-surface" aria-label="@L["Precision:ChLabel"]">
    <div class="eb-toolbar">
        <div class="fchips" role="group" aria-label="@L["Precision:ChColType"]">
            <MoFilterChip Label="@L["Precision:ChFilterAll"]" Pill="true" Class="mo-vl-chip--instrument"
                          Role="MoVisualRole.Primary" Count="@pool.Length" Selected="@(type is null)" SelectedChanged='() => Filter("type", null)' />
            @foreach (var kind in types)
            {
                <MoFilterChip Label="@L.GetSubscriptionChangeTypeText(kind)" Pill="true" Class="mo-vl-chip--instrument"
                              Role="@EventBusVisuals.Role(kind)" Count="@pool.Count(change => change.ChangeType == kind)" ShowDot="true" Selected="@(type == kind)"
                              SelectedChanged='() => Filter("type", type == kind ? null : kind.ToString())' />
            }
        </div>
        <div class="eb-toolbar-end"><label class="eb-search"><MoIcon Class="i" Icon="@MoIcons.Search" Size="15px" />
            <input type="search" value="@search" aria-label="@L["Precision:ChSearchPh"]" placeholder="@L["Precision:ChSearchPh"]" @oninput='args => Filter("q", args.Value?.ToString())' />
        </label></div>
    </div>
    @if (shown.Length == 0)
    {
        <MoContentState>
            <MoIcon Icon="@(entries.Count == 0 ? MoIcons.History : MoIcons.SearchOff)" Size="22px" />
            <h2>@L[entries.Count == 0 ? "Precision:ChEmptyTitle" : "Precision:ChNoMatch"]</h2>
            @if (entries.Count == 0)
            {
                <p>@L["Precision:ChEmptyBody"]</p><a class="btn btn-sm btn-outline" href="@UIEventBusSubscriptionsPage.PAGE_URL"><MoIcon Icon="@MoIcons.Route" Size="14px" />@L["Precision:ChGoToSubs"]</a>
            }
            else
            {
                <button class="btn btn-outline btn-sm" type="button" @onclick='() => Workbench.EditQuery(("type", null), ("q", null), ("page", null))'>@L["Precision:SubClearFilters"]</button>
            }
        </MoContentState>
    }
    else
    {
        <div class="eb-table-wrap">
            <table class="eb-table eb-ch-table" aria-label="@L["Precision:ChLabel"]">
                <thead><tr>
                    <th scope="col">@L["Precision:ChColType"]</th><th scope="col">@L["Precision:ChColEvent"]</th>
                    <th scope="col">@L["Precision:ChColTopic"]</th><th scope="col">@L["Precision:ChColRegistration"]</th>
                    <th scope="col">@L["Precision:ChColRuntime"]</th><th scope="col" class="eb-col-act">@L["Precision:ChColEvidence"]</th>
                </tr></thead>
                <tbody>
                    @foreach (var change in shown.Skip((page - 1) * PageSize).Take(PageSize))
                    {
                        var row = change.Subscription;
                        var kind = row.TopicStatus?.Provider ?? change.ReportedProvider ?? EventBusProviderKind.Unknown;
                        <tr @key="change.ObservationId">
                            <td data-label="@L["Precision:ChColType"]"><div class="eb-cell-stack">
                                <span class="status is-pill @EventBusVisuals.Role(change.ChangeType).ToCssClass()"><span class="status-dot"></span>@L.GetSubscriptionChangeTypeText(change.ChangeType)</span>
                                <time class="mono eb-row-sub" datetime="@EventBusVisuals.TimeTag(change.Timestamp)">@UiTime.Format(change.Timestamp)</time>
                            </div></td>
                            <td data-label="@L["Precision:ChColEvent"]"><div class="eb-cell-stack">
                                <a class="eb-link-btn eb-break" href="@Workbench.InspectionLink("changeId", change.ObservationId)">@row.EventTypeShortName</a><code class="eb-id-sub mono" title="@row.SubscriptionId">@row.SubscriptionId[..Math.Min(12, row.SubscriptionId.Length)]</code>
                            </div></td>
                            <td data-label="@L["Precision:ChColTopic"]"><div class="eb-cell-stack">
                                <code class="eb-topic-code mono eb-break">@row.TopicName</code>
                                <EventBusTransportBadge Distributed="@(row.Scope == EventSubscriptionScope.Distributed)" Kind="@kind" ServiceKey="@row.ServiceKey" />
                            </div></td>
                            <td data-label="@L["Precision:ChColRegistration"]"><span class="status is-pill @EventBusVisuals.Role(row.State).ToCssClass()"><span class="status-dot"></span>@L.GetSubscriptionStateText(row.State)</span></td>
                            <td data-label="@L["Precision:ChColRuntime"]"><EventBusRuntimeBadge Scope="@row.Scope" Status="@row.TopicStatus" /></td>
                            <td class="eb-col-act" data-label="@L["Precision:ChColEvidence"]">
                                <a class="btn btn-ghost btn-sm" href="@Workbench.InspectionLink("changeId", change.ObservationId)">@L["Precision:ChInspectFrozen"]<MoIcon Icon="@MoIcons.ChevronRight" Size="14px" /></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <MoCompactPager ShowSinglePage="true" Page="@(page)" PageSize="@PageSize" Total="@shown.Length" PageChanged='value => Workbench.EditQuery(("page", value == 1 ? null : value.ToString(System.Globalization.CultureInfo.InvariantCulture)))' />
    }
    <footer class="eb-surface-foot"><MoIcon Icon="@MoIcons.Info" Size="14px" />@L["Precision:ChFoot"]</footer>
</section>

@code {
    /// <summary>Gets the owning workbench's retained observation window and query.</summary>
    [CascadingParameter] public EventBusWorkbench Workbench { get; set; } = null!;

    private const int PageSize = 12;

    private bool MatchesSearch(SubscriptionChangeViewModel change, string search) => search.Length == 0 ||
        new[] { change.Subscription.EventType, change.Subscription.TopicName, change.Subscription.ServiceKey,
            change.Subscription.SubscriptionId, change.Subscription.HandlerType, change.Subscription.ActionMethodName,
            L.GetSubscriptionChangeTypeText(change.ChangeType) }.Any(value => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true);

    private void Filter(string key, string? value) => Workbench.EditQuery((key, string.IsNullOrEmpty(value) ? null : value), ("page", null));
}
