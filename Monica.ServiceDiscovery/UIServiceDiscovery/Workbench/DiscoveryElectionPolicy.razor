@inherits DiscoveryComponent
@using Monica.Modules

<dl class="kv is-single">
    @if (!Compact)
    {
        @PlacementRows
        <div><dt>@T("hostAuthority")</dt><dd class="mono">
            @(Settings.LeaderLeaseStore?.ServiceKey ?? nameof(ModuleServiceDiscovery))@(Settings.LeaderLeaseStore?.Scope is { Length: > 0 } scope ? $" / {scope}" : null)
        </dd></div>
    }
    <div><dt>@T("hostFields:hbPeriod")</dt><dd class="mono">
        @T("secUnit", Policy.HeartbeatPeriodSeconds)@(Compact ? $" (±{T("msUnit", Policy.HeartbeatJitterMilliseconds)})" : null)
    </dd></div>
    @if (!Compact)
    {
        <div><dt>@T("hostFields:hbJitter")</dt><dd class="mono">±@T("msUnit", Policy.HeartbeatJitterMilliseconds)</dd></div>
    }
    <div><dt>@T("hostFields:instTtl")</dt><dd class="mono">@Formula(Policy.RegistrationOfflineTTLMultiplier, Policy.RegistrationOfflineTTLAdditionalSeconds, Policy.RegistrationTTL)</dd></div>
    <div><dt>@T("hostFields:leaderTtl")</dt><dd class="mono">@Formula(Policy.LeaderOfflineTTLMultiplier, Policy.LeaderOfflineTTLAdditionalSeconds, Policy.LeaderTTL)</dd></div>
    @if (Compact)
    {
        @PlacementRows
    }
    else
    {
        <div><dt>@T("leaseStandbyInterval")</dt><dd class="mono">
            @T("secUnit", Num(Policy.LeaseStandbyInterval.TotalSeconds)) · @T("leaseOperationTimeout"): @T("secUnit", Num(Policy.LeaseOperationTimeout.TotalSeconds))
        </dd></div>
    }
</dl>

@code {
    [Parameter] public bool Compact { get; set; }
    [Parameter, EditorRequired] public ModuleServiceDiscoveryOption Settings { get; set; } = default!;
    [Parameter, EditorRequired] public ElectionConfig Policy { get; set; } = default!;
    private RenderFragment PlacementRows => @<text>
        <div><dt>@T("hostFields:hostRole")</dt><dd>@T("hostRoles:" + Settings.Role)</dd></div>
        <div><dt>@T("hostFields:storageMode")</dt><dd>
            @T("storageModes:" + Settings.StorageMode)
            @if (!Compact && Settings.ExternalStateStoreServiceKey is { Length: > 0 } store)
            {
                <code class="sv-dim">@store</code>
            }
        </dd></div>
    </text>;

    private string Formula(double multiplier, int extra, TimeSpan ttl) =>
        T("ttlFormula", Policy.HeartbeatPeriodSeconds, Num(multiplier), extra, Num(ttl.TotalSeconds));
}
