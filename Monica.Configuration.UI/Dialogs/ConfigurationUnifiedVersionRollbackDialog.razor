@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L
@implements IDisposable

<MudDialog>
    <DialogContent>
        <div class="configuration-unified-version-rollback-dialog-content">
            <MudStack Spacing="3">
                @if (_loading)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <MudAlert Severity="Severity.Error">@_error</MudAlert>
                    }

                    @if (_preview is not null)
                    {
                        <MudAlert Severity="@PreviewMessageSeverity" Variant="Variant.Outlined">
                            @PreviewMessage
                        </MudAlert>

                        <ConfigurationUnifiedVersionRollbackPreview Preview="_preview" />

                        <MudTextField T="string"
                                      @bind-Value="_reason"
                                      Label="@L["Group:Reason"]"
                                      Variant="Variant.Outlined"
                                      Lines="2"
                                      Disabled="_saving" />
                    }
                }
            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@(_saving || _reloading)">@L["Common:Actions:Cancel"]</MudButton>
        @if (HasRuntimeOutOfSync)
        {
            <MudButton Color="Color.Warning"
                       Variant="Variant.Outlined"
                       StartIcon="@Icons.Material.Filled.Sync"
                       OnClick="ReloadAndRefreshAsync"
                       Disabled="@(_loading || _saving || _reloading)">
                @L["Versions:Rollback:Actions:ReloadAndRefresh"]
            </MudButton>
        }
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="() => LoadPreviewAsync()"
                   Disabled="@(_loading || _saving || _reloading)">
            @L["Common:Actions:Refresh"]
        </MudButton>
        <MudButton Color="Color.Warning"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Restore"
                   OnClick="ApplyAsync"
                   Disabled="@(!CanApply)">
            @ApplyActionText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public long Version { get; set; }

    private ConfigurationUnifiedVersionApplyPreview? _preview;
    private string? _reason;
    private string? _error;
    private bool _loading = true;
    private bool _saving;
    private bool _reloading;
    private bool _disposed;
    private long _previewGeneration;
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _previewCancellation;

    private bool CanApply =>
        !_disposed && !_loading && !_saving && !_reloading && _preview?.CanApply == true;

    private bool HasRuntimeOutOfSync => _preview?.Targets.Any(static target =>
        target.Status == ConfigurationUnifiedVersionApplyTargetStatus.RuntimeOutOfSync) == true;

    private string ApplyActionText => L["Versions:Rollback:Actions:Apply"];

    private Severity PreviewMessageSeverity => _preview switch
    {
        { } preview when preview.Problems.Count > 0 || preview.ValidationReports.Any(report => !report.IsValid) => Severity.Error,
        { BlockedCount: > 0 } => Severity.Error,
        { HasChanges: false, SkippedCount: > 0 } => Severity.Warning,
        { HasChanges: false } => Severity.Info,
        { SkippedCount: > 0 } => Severity.Warning,
        { CompatibleSchemaDriftCount: > 0 } => Severity.Info,
        _ => Severity.Success
    };

    private string PreviewMessage => _preview switch
    {
        { } preview when preview.ValidationReports.Any(report => report.Coverage == ConfigurationValidationCoverage.Failed) => L["Validation:FailedNotice"],
        { } preview when preview.ValidationReports.Any(report => report.Coverage == ConfigurationValidationCoverage.SchemaOnly) => L["Validation:SchemaOnlySummary"],
        { } preview when preview.ValidationReports.Any(report => !report.IsValid) => L["Validation:Invalid"],
        { } preview when preview.Problems.Count > 0 => L["Validation:PreviewBlocked"],
        { BlockedCount: > 0 } => L["Versions:Rollback:Messages:Blocked"],
        { HasChanges: false, SkippedCount: > 0 } => L["Versions:Rollback:Messages:NoChangesSkipped", _preview.SkippedCount],
        { HasChanges: false } => L["Versions:Rollback:Messages:NoChanges"],
        { SkippedCount: > 0 } => L["Versions:Rollback:Messages:Skipped", _preview.SkippedCount],
        { CompatibleSchemaDriftCount: > 0 } => L["Versions:Rollback:Messages:CompatibleSchemaDrift"],
        _ => L["Versions:Rollback:Messages:Ready"]
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync(bool preserveError = false)
    {
        if (_disposed)
        {
            return;
        }

        var generation = ++_previewGeneration;
        _previewCancellation?.Cancel();
        _previewCancellation?.Dispose();
        var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _previewCancellation = cancellation;
        _loading = true;
        if (!preserveError)
        {
            _error = null;
        }
        _preview = null;
        try
        {
            var result = await Facade.PreviewUnifiedVersionRollbackAsync(Version, cancellation.Token);
            if (_disposed || generation != _previewGeneration)
            {
                return;
            }

            if (result.IsFailed(out var error, out var preview))
            {
                _error = preserveError && !string.IsNullOrWhiteSpace(_error)
                    ? $"{_error}{Environment.NewLine}{error.Message}" : error.Message;
                _preview = result.Data;
                return;
            }

            _preview = preview;
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (!_disposed && generation == _previewGeneration)
            {
                _loading = false;
            }
        }
    }

    private async Task ApplyAsync()
    {
        if (!CanApply || _preview is null)
        {
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var result = await Facade.RollbackUnifiedVersionAsync(new ConfigurationUnifiedVersionRollbackRequest
            {
                Version = Version,
                PreviewFingerprint = _preview.PreviewFingerprint,
                Reason = _reason
            });
            if (_disposed)
            {
                return;
            }

            if (result.IsFailed(out var error, out var rollback))
            {
                _error = error.Message;
                await LoadPreviewAsync(preserveError: true);
                return;
            }

            MudDialog.Close(DialogResult.Ok(rollback));
        }
        finally
        {
            if (!_disposed)
            {
                _saving = false;
            }
        }
    }

    private async Task ReloadAndRefreshAsync()
    {
        _reloading = true;
        _error = null;
        try
        {
            var result = await Facade.ReloadRuntimeConfigurationAsync();
            if (_disposed)
            {
                return;
            }
            if (result.IsFailed(out var error, out _))
            {
                _error = error.Message;
                return;
            }

            await LoadPreviewAsync();
        }
        finally
        {
            if (!_disposed)
            {
                _reloading = false;
            }
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    public void Dispose()
    {
        _disposed = true;
        ++_previewGeneration;
        _previewCancellation?.Cancel();
        _previewCancellation?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
