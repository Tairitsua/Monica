@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@attribute [Route(PAGE_URL)]
@using Monica.DevOps.Git.Components
@using Monica.DevOps.Git.Models
@using Monica.DevOps.Git.State
@using Monica.DevOps.Git.Support

<PageTitle>@L["Workspace:Repositories:Title"]</PageTitle>

<div class="git-page" @ref="_root" data-focus-visit="@_visit" data-focus-version="@_focusVersion" data-selected-key="@SelectedKey" data-catalog-open="@(_catalogOpen ? "true" : "false")">
    <div class="workspace-frame"><GitWorkspaceHeader Title="@L["Workspace:Repositories:Title"]" Description="@L["Workspace:Repositories:Description"]">
        <Actions>
            <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" Disabled="@Busy" OnClick="RefreshAsync">@L["GitDashboard:Actions:Refresh"]</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" Disabled="@(Busy || !_workspace.ManualSyncEnabled || _workspace.Repositories.Count == 0)" OnClick="@(() => ConfirmAsync(GitCommandKind.SyncAll))">@L["Workspace:Repositories:SyncAll"]</MudButton>
        </Actions>
    </GitWorkspaceHeader></div>
    @if (_workspace.RepositoryFailure is { } readFailure)
    {
        <div class="read-feedback" role="alert"><MudAlert Severity="Severity.Error" Dense="true" Icon="@MoIcons.Error"><strong>@L["Workspace:Repositories:ReadFailed"]</strong><p>@Safe(readFailure.Detail)</p></MudAlert><MudButton Variant="Variant.Text" OnClick="RefreshAsync" Disabled="@Busy">@L["GitDashboard:Actions:Refresh"]</MudButton></div>
    }
    @if (_workspace.IsLoading) { <MudProgressLinear Color="Color.Primary" Indeterminate="true" aria-label="@L["Workspace:Repositories:Loading"]" Class="page-loading" /> }
    @if (!_workspace.ManualSyncEnabled) { <MudAlert Severity="Severity.Info" Dense="true" Class="policy-feedback" Icon="@MoIcons.Info">@L["Workspace:Repositories:ManualDisabled"]</MudAlert> }
    <div class="git-workspace">
        <aside class="@($"git-catalog {(_catalogOpen ? "catalog-open" : "catalog-closed")}")" aria-label="@L["Workspace:Repositories:Catalog"]">
            <button type="button" class="catalog-toggle" aria-expanded="@(_catalogOpen ? "true" : "false")" aria-controls="git-catalog-body" @onclick="ToggleCatalog">
                <span><strong>@(_workspace.SelectedId is null ? L["Workspace:Repositories:Catalog"].Value : SelectedKey)</strong><small>@ResultCount</small></span>
                <span>@L["Workspace:Repositories:Choose"]<MoIcon Icon="@(_catalogOpen ? MoIcons.ChevronUp : MoIcons.ChevronDown)" Size="1.5rem" /></span>
            </button>
            <div class="catalog-body" id="git-catalog-body">
                <div class="catalog-heading"><h2>@L["Workspace:Repositories:Catalog"]</h2><span>@ResultCount</span></div>
                <MudTextField T="string" @ref="_search" Value="@_query" ValueChanged="SetQuery" Label="@L["Workspace:Repositories:Search"]" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" />
                <div class="state-filters" role="group" aria-label="@L["GitDashboard:Columns:State"]">
                    @foreach (var state in Enum.GetValues<GitRepositorySyncState>())
                    {
                        <MudButton Variant="Variant.Outlined" Color="@StateColor(state)" Size="Size.Small" Class="@($"state-filter {(_states.Contains(state) ? "selected" : "")}")" aria-pressed="@(_states.Contains(state) ? "true" : "false")" OnClick="@(() => ToggleState(state))">@StateText(state)<span class="filter-count">@_workspace.Repositories.Count(repository => repository.State == state)</span></MudButton>
                    }
                </div>
                <MudCheckBox T="bool" Value="@_dirtyOnly" ValueChanged="SetDirty" Color="Color.Warning" Label="@L["Workspace:Repositories:ChangesOnly"]" Dense="true" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" />
                @if (HasFilters) { <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearFiltersAsync">@L["Workspace:Repositories:ClearFilters"]</MudButton> }
                <div class="repository-list" tabindex="0" role="group" aria-label="@L["Workspace:Repositories:Catalog"]">
                    @foreach (var repository in VisibleRepositories)
                    {
                        <button type="button" class="@($"repository-row {(SameId(repository.Id, _workspace.SelectedId) ? "selected" : "")}")" aria-pressed="@(SameId(repository.Id, _workspace.SelectedId) ? "true" : "false")" data-entry-key="@Safe(repository.Id)" @onclick="@(() => SelectRepository(repository.Id))" @key="repository.Id">
                            <strong class="technical">@Safe(repository.Id)</strong>
                            <span class="row-context">@Display(repository.Provider)<span class="technical">@Display(repository.ResolvedBranch ?? repository.ConfiguredBranch)</span></span>
                            <span class="row-states"><MudChip T="string" Color="@StateColor(repository.State)" Variant="Variant.Outlined" Size="Size.Small" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@StateText(repository.State)</MudChip>
                                @if (repository.IsDirty) { <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@L["Workspace:Repositories:Changes"]</MudChip> }
                                @if (!string.IsNullOrWhiteSpace(repository.LastError) && repository.State != GitRepositorySyncState.Failed) { <MoIcon Icon="@MoIcons.Error" Size="1.25rem" Label="@L["GitDashboard:States:Failed"]" Style="color:var(--mud-palette-error);" /> }
                            </span>
                            @if (repository.State == GitRepositorySyncState.Syncing) { <span class="row-progress">@Safe(GitWorkspacePresentation.ProgressText(repository, L))</span> }
                        </button>
                    }
                    @if (!VisibleRepositories.Any()) { <MoContentState Compact="true">@CatalogEmptyText</MoContentState> }
                </div>
            </div>
        </aside>
        <div class="worksheet-owner">
            @if (_workspace.SelectedRepository is not { } selected)
            {
                @if (_workspace.RepositoriesObservedAt is not null && _workspace.Repositories.Count == 0)
                { <MudAlert Severity="Severity.Info" Icon="@MoIcons.Info">@L["Workspace:Repositories:EmptyInspection"]</MudAlert> }
                else if (_workspace.Repositories.Count > 0)
                { <MudAlert Severity="Severity.Info" Icon="@MoIcons.Info">@L["GitDashboard:Messages:NoSelection"]</MudAlert> }
            }
            else
            {
                @if (!VisibleRepositories.Any(repository => SameId(repository.Id, selected.Id))) { <MudAlert Severity="Severity.Info" Dense="true" Icon="@MoIcons.Info">@L["Workspace:Repositories:FilteredSelection"]</MudAlert> }
                <article class="git-worksheet" @key="selected.Id">
                    <header class="worksheet-header" data-entry-key="@Safe(selected.Id)">
                        <span class="identity-mark"><MoIcon Icon="@MoIcons.Workflow" Size="1.5rem" /></span>
                        <div class="worksheet-heading"><h2 tabindex="-1">@Safe(selected.Id)</h2><p>@Display(selected.Provider)</p><div class="row-states"><MudChip T="string" Color="@StateColor(selected.State)" Variant="Variant.Outlined" Size="Size.Small" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@StateText(selected.State)</MudChip>@if (selected.IsDirty) { <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@L["Workspace:Repositories:Changes"]</MudChip> }</div></div>
                        <MudButton Class="change-repository" Variant="Variant.Text" Size="Size.Small" OnClick="ToggleCatalog">@L["Workspace:Repositories:Change"]</MudButton>
                    </header>
                    @if (!string.IsNullOrWhiteSpace(selected.LastError)) { <MudAlert Severity="Severity.Error" Dense="true" Class="repository-error" Icon="@MoIcons.Error">@Safe(selected.LastError)</MudAlert> }
                    <section class="worksheet-section"><h3>@L["Workspace:Repositories:Remote"]</h3><dl class="evidence-grid">
                        <div class="full-width"><dt>@L["GitDashboard:Labels:RemoteUrl"]</dt><dd class="technical">@Safe(selected.RemoteUrl)</dd></div>
                        <div><dt>@L["Workspace:Repositories:ConfiguredBranch"]</dt><dd class="technical">@(string.IsNullOrWhiteSpace(selected.ConfiguredBranch) ? L["Workspace:Repositories:AutomaticBranch"].Value : Safe(selected.ConfiguredBranch))</dd></div>
                        <div><dt>@L["GitDashboard:Labels:Credential"]</dt><dd>
                            @if (string.IsNullOrWhiteSpace(selected.CredentialId)) { @Display(null) }
                            else { <a class="technical credential-reference" href="@CredentialHref(selected.CredentialId)">@Safe(selected.CredentialId)</a> }
                        </dd></div>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(selected.CredentialId))
                    {
                        @if (_workspace.MetadataFailure is { } metadataFailure) { <p class="metadata-feedback">@L["Workspace:Repositories:MetadataFailed"] @Safe(metadataFailure.Detail)</p> }
                        else if (_workspace.MetadataObservedAt is not null && !_workspace.Credentials.Any(credential => SameId(credential.Id, selected.CredentialId))) { <p class="metadata-feedback">@L["Workspace:Repositories:CredentialMissing"]</p> }
                    }
                    </section>
                    <section class="worksheet-section"><h3>@L["Workspace:Repositories:Worktree"]</h3><dl class="evidence-grid">
                        <div class="full-width"><dt>@L[string.Equals(selected.LocalPath, selected.ResolvedLocalPath, StringComparison.Ordinal) ? "Workspace:Repositories:ConfiguredResolvedPath" : "GitDashboard:Labels:ResolvedLocalPath"]</dt><dd class="technical">@Safe(selected.ResolvedLocalPath)</dd></div>
                        @if (!string.Equals(selected.LocalPath, selected.ResolvedLocalPath, StringComparison.Ordinal)) { <div class="full-width"><dt>@L["Workspace:Repositories:ConfiguredPath"]</dt><dd class="technical">@Safe(selected.LocalPath)</dd></div> }
                        <div><dt>@L["GitDashboard:Labels:ResolvedBranch"]</dt><dd class="technical">@Display(selected.ResolvedBranch)</dd></div>
                        <div><dt>@L["Workspace:Repositories:Available"]</dt><dd>@BoolText(selected.IsAvailable)</dd></div>
                        <div class="full-width"><dt>@L["GitDashboard:Labels:CurrentCommit"]</dt><dd class="technical">@Display(selected.CurrentCommit)</dd></div>
                        <div><dt>@L["Workspace:Repositories:Dirty"]</dt><dd>@(selected.IsAvailable ? BoolText(selected.IsDirty) : L["Workspace:Repositories:DirtyUnavailable"].Value)</dd></div>
                        <div><dt>@L["Workspace:Repositories:Size"]</dt><dd class="technical">@GitWorkspacePresentation.FormatBytes(selected.WorkingDirectorySizeBytes)</dd></div>
                        <div class="full-width"><dt>@L["Workspace:Repositories:LastSuccessfulSync"]</dt><dd class="technical">@DateText(selected.LastSyncAtUtc)</dd></div>
                    </dl><p class="evidence-note">@L["Workspace:Repositories:AvailabilityHint"] @L["Workspace:Repositories:SizeHint"]</p></section>
                    <section class="worksheet-section operation-section">
                        <div class="operation-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Refresh" Disabled="@(Busy || !_workspace.ManualSyncEnabled)" OnClick="@(() => ConfirmAsync(GitCommandKind.Sync))">@L["Workspace:Repositories:Sync"]</MudButton><MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@MoIcons.Delete" Disabled="@Busy" OnClick="@(() => ConfirmAsync(GitCommandKind.DeleteLocal))">@L["Workspace:Repositories:Delete"]</MudButton></div>
                        <p class="evidence-note">@L["Workspace:Repositories:LossHint"]</p>
                        @if (_workspace.Operation is { } operation) { <p class="operation-intent" role="status">@L[!operation.HasStarted ? "Workspace:Repositories:AwaitingConfirmation" : operation.Kind == GitCommandKind.DeleteLocal ? "Workspace:Repositories:RequestingDelete" : "Workspace:Repositories:RequestingSync"]</p> }
                        @if (selected.State == GitRepositorySyncState.Syncing)
                        { <div class="stage-evidence" role="status"><p>@Safe(GitWorkspacePresentation.ProgressText(selected, L))</p><MudProgressLinear Color="Color.Info" Indeterminate="@(!selected.ProgressPercent.HasValue)" Value="@(selected.ProgressPercent ?? 0)" /></div> }
                        @if (!string.IsNullOrWhiteSpace(selected.LastSyncMessage) && !string.Equals(selected.LastSyncMessage, selected.LastError, StringComparison.Ordinal)) { <p class="service-message"><span class="message-label">@L["Workspace:Repositories:ServiceMessage"]</span>@Safe(selected.LastSyncMessage)</p> }
                        @if (_workspace.Outcome is { } outcome)
                        {
                            <div class="command-outcome" role="status" aria-live="polite"><h3>@L["Workspace:Repositories:Outcome"]</h3>
                                @if (outcome.FacadeError is not null) { <MudAlert Severity="Severity.Error" Dense="true" Icon="@MoIcons.Error">@Safe(outcome.FacadeError)</MudAlert> }
                                @if (outcome.SyncResults.Count > 0) { <p>@L["Workspace:Repositories:OutcomeSummary", outcome.SyncResults.Count(result => result.Success), outcome.SyncResults.Count(result => !result.Success)]</p><ul>@foreach (var result in outcome.SyncResults) { <li><strong class="technical">@Safe(result.RepositoryId)</strong><MudChip T="string" Color="@(result.Success ? Color.Success : Color.Error)" Variant="Variant.Outlined" Size="Size.Small" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@L[result.Success ? "Workspace:Repositories:ResultSucceeded" : "Workspace:Repositories:ResultFailed"]</MudChip><span>@Safe(result.Message)</span></li> }</ul> }
                                @if (outcome.DeleteResult is { } deletion) { <MudAlert Severity="@(deletion.Success ? Severity.Success : Severity.Error)" Dense="true" Icon="@(deletion.Success ? MoIcons.Success : MoIcons.Error)"><strong class="technical">@Safe(deletion.RepositoryId)</strong><p class="technical">@Safe(deletion.ResolvedLocalPath)</p>@Safe(deletion.Message)</MudAlert> }
                            </div>
                        }
                    </section>
                </article>
            }
        </div>
    </div>
</div>
