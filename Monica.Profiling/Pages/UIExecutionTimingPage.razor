@using Monica.UI.Shared.Components.States
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@attribute [Route(PAGE_URL)]
@using Monica.Profiling.ExecutionTiming.Models
@using Monica.Profiling.UIExecutionTiming.Components
@inject ExecutionTimingPageStateFactory PageStateFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ExecutionTimingResource> L
@inject ILogger<UIExecutionTimingPage> Logger
@implements IAsyncDisposable

<PageTitle>@L["Pages:ExecutionTiming:Title"]</PageTitle>
<div class="execution-timing-page">
    <header class="timing-heading">
        <div>
            <span class="timing-eyebrow"><MoIcon Icon="@MoIcons.Timer" Size="1.25rem" /> @L["Page:Eyebrow"]</span>
            <h1>@L["Pages:ExecutionTiming:Title"]</h1><p>@L["Page:Subtitle"]</p>
        </div>
        <div class="timing-heading__controls">
            <div class="timing-heading__actions">
                <MudSwitch T="bool" Value="PageState.AutoRefresh" ValueChanged="SetAutoRefresh" Disabled="@(!PageState.CanAutoRefresh)"
                           Color="Color.Primary" Label="@L["Page:Actions:AutoRefresh"]" />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.Refresh"
                           OnClick="RefreshDataAsync" Disabled="@PageState.IsLoading">@L["Page:Actions:Refresh"]</MudButton>
            </div>
            <div class="timing-freshness">
                <span class="timing-polling"><span class="timing-polling__dot" aria-hidden="true"></span>@PollingLabel</span>
                @if (PageState.SnapshotCapturedAt is { } capturedAt)
                {
                    <span>@L["Page:Captured"] <time datetime="@ExecutionTimingDisplayFormatter.FormatMachineDateTime(capturedAt)">@UiTime.Format(capturedAt)</time></span>
                }
            </div>
        </div>
    </header>
    @if (PageState.LoadError is not null)
    {
        <div class="timing-error" role="status">
            <MoIcon Icon="@MoIcons.Info" Size="1.25rem" />
            <div><strong>@L["Page:Messages:RefreshFailed"]</strong><p>@(PageState.HasSnapshot ? L["Page:Messages:Retained"] : L["Page:Messages:NoSnapshot"])</p>
                @if (!string.IsNullOrEmpty(PageState.LoadError)) { <p>@PageState.LoadError</p> }
            </div>
        </div>
    }
    @if (PageState.IsLoading)
    {
        <div class="timing-loading" role="status" aria-label="@L["Page:Loading"]"><MudProgressLinear Indeterminate="true" Color="Color.Primary" /></div>
    }
    <section class="timing-scope" aria-label="@L["Summary:AriaLabel"]">
        <div class="timing-scope__facts">
            <div><span>@L["Summary:Running"]</span><strong>@SnapshotNumber(PageState.RunningOperations.Count)</strong></div>
            <div><span>@L["Summary:Operations"]</span><strong>@SnapshotNumber(PageState.Statistics.Count)</strong></div>
            <div><span>@L["Summary:Samples"]</span><strong>@SnapshotNumber(PageState.Statistics.Sum(item => (long)item.ExecutionCount))</strong></div>
            <p>@L["Summary:Scope"]</p>
        </div>
        <div class="timing-scope__mean">
            <span>@L["Summary:Average"]</span><strong>@FormatAverageDuration()</strong><small>@L["Summary:AverageBasis"]</small>
        </div>
    </section>
    @if (PageState.HasSnapshot && PageState.SnapshotCapturedAt is { } snapshotAt)
    {
        <TimingStatisticsPanel Statistics="@PageState.Statistics" CapturedAt="@snapshotAt" OnInspect="InspectCompletedAsync" />
        <TimingRunningPanel Operations="@PageState.RunningOperations" CapturedAt="@snapshotAt" OnInspect="InspectRunningAsync" />
    }
    else if (PageState.LoadError is null)
    {
        <div class="timing-awaiting"><MoContentState Loading="true">@L["Page:Loading"]</MoContentState></div>
    }
</div>

@code {
    public const string PAGE_URL = "/execution-timing";
    private ExecutionTimingPageState PageState { get; set; } = null!;
    private readonly HashSet<Task> _renderTasks = [];
    private readonly object _renderLock = new();
    private IDialogReference? _detailDialog;
    private Task _dialogOpen = Task.CompletedTask;
    private bool _openingDialog;
    private bool _disposed;

    private string PollingLabel => !PageState.CanAutoRefresh ? L["Page:Status:Manual"]
        : PageState.AutoRefresh ? L["Page:Status:Live", PageState.RefreshIntervalMs / 1000d] : L["Page:Status:Paused"];

    protected override async Task OnInitializedAsync()
    {
        PageState = PageStateFactory.Create();
        PageState.StateChanged += HandleStateChanged;
        await PageState.InitializeAsync();
    }
    private async Task RefreshDataAsync()
    {
        var result = await PageState.RefreshAsync();
        if (!_disposed && result.Status != ResStatus.Conflict && result.IsFailed(out _))
            Snackbar.Add(L["Page:Messages:RefreshFailed"], Severity.Error);
    }
    private Task SetAutoRefresh(bool value) => PageState.SetAutoRefreshAsync(value);
    private string SnapshotNumber(long value) => PageState.HasSnapshot ? value.ToString("N0") : L["Common:Unavailable"];
    private string FormatAverageDuration() => !PageState.HasSnapshot || PageState.Statistics.Count == 0
        ? L["Common:Unavailable"] : ExecutionTimingDisplayFormatter.FormatDuration(PageState.Statistics.Average(item => item.AverageDurationMs));

    private Task InspectCompletedAsync(TimingCompletedEvidence evidence) =>
        BeginInspectAsync(new DialogParameters<ExecutionTimingDetailDialog>
        {
            { dialog => dialog.Completed, evidence.Statistics }, { dialog => dialog.CapturedAt, evidence.CapturedAt }
        }, L["Details:CompletedTitle"]);
    private Task InspectRunningAsync(TimingRunningEvidence evidence) =>
        BeginInspectAsync(new DialogParameters<ExecutionTimingDetailDialog>
        {
            { dialog => dialog.Running, evidence.Operation }, { dialog => dialog.CapturedAt, evidence.CapturedAt }
        }, L["Details:RunningTitle"]);
    private Task BeginInspectAsync(DialogParameters<ExecutionTimingDetailDialog> parameters, string title)
    {
        if (_disposed || _openingDialog) return Task.CompletedTask;
        _openingDialog = true;
        return _dialogOpen = OpenDetailsAsync(parameters, title);
    }
    private async Task OpenDetailsAsync(DialogParameters<ExecutionTimingDetailDialog> parameters, string title)
    {
        try
        {
            var reference = await DialogService.ShowAsync<ExecutionTimingDetailDialog>(title, parameters,
                new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseOnEscapeKey = true, BackdropClick = true });
            if (_disposed) { reference.Close(DialogResult.Cancel()); return; }
            _detailDialog?.Close(DialogResult.Cancel());
            _detailDialog = reference;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Execution timing evidence inspector could not be opened.");
            if (!_disposed) Snackbar.Add(L["Details:OpenFailed"], Severity.Error);
        }
        finally { _openingDialog = false; }
    }
    private void HandleStateChanged()
    {
        if (_disposed) return;
        var render = ObserveRenderAsync(InvokeAsync(() => { if (!_disposed) StateHasChanged(); }));
        lock (_renderLock) _renderTasks.Add(render);
        _ = RemoveRenderAsync(render);
    }
    private async Task ObserveRenderAsync(Task render)
    {
        try { await render; }
        catch (Exception exception) { Logger.LogError(exception, "Execution timing page rendering failed."); }
    }
    private async Task RemoveRenderAsync(Task render)
    {
        await render;
        lock (_renderLock) _renderTasks.Remove(render);
    }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        PageState.StateChanged -= HandleStateChanged;
        try { await PageState.DisposeAsync(); }
        finally
        {
            try { await _dialogOpen; }
            finally
            {
                _detailDialog?.Close(DialogResult.Cancel());
                Task[] renders;
                lock (_renderLock) renders = _renderTasks.ToArray();
                await Task.WhenAll(renders);
            }
        }
    }
}
