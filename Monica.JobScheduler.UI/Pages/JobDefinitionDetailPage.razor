@using Monica.UI.Shared.Components.States
@attribute [Route(PAGE_URL)]
@attribute [Route("/job-scheduler/catalog/{OwnerKey}/{JobKey}")]

@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Components
@using Monica.JobScheduler.UI.UIJobScheduler.State

<PageTitle>@PageTitleText</PageTitle>
<SchedulerWorkspace Title="@L["Workspace:Pages:JobDetail:Title"]" Description="@L["Workspace:Pages:JobDetail:Description"]" ActivePanelIndex="1">
    <div class="job-detail-page">
        <nav class="job-detail-page__breadcrumb" aria-label="@L["JobDetail:BreadcrumbAriaLabel"]">
            <MudButton Variant="Variant.Text" StartIcon="@MoIcons.ArrowLeft" Href="@ReturnUrl">@L[Return is null ? "JobDetail:Actions:BackToCatalog" : "Workspace:BackToSource"]</MudButton>
        </nav>
        @if (PageState is { } state)
        {
            <SchedulerAccessBoundary AccessChecked="@state.AccessChecked" IsAuthorized="@state.IsAuthorized">
                <SchedulerSnapshotActions CapturedAtUtc="@state.ObservedAtUtc" IsLoading="@(state.IsLoading || state.IsMutating)" RefreshRequested="RefreshAsync" />
                @if (state.IsLoading && state.Summary is null)
                {
                    <MoContentState Loading="true">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText Typo="Typo.body2">@L["Common:Loading"]</MudText>
                    </MoContentState>
                }
                else if (state.Error is not null && state.Summary is null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">
                        @state.Error
                        <MudButton Variant="Variant.Text" OnClick="RefreshAsync">@L["Common:Retry"]</MudButton>
                    </MudAlert>
                }
                else if (state.IsNotFound)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@MoIcons.Warning">@L["JobDetail:NotFound", state.JobKey]</MudAlert>
                }
                else if (state.Summary is { } summary)
                {
                    <div class="job-detail-page__dossier">
                        @if (state.IsLoading)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                        }
                        @if (state.Error is not null)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Warning">@L["JobDetail:RefreshFailed", state.Error]</MudAlert>
                        }
                        <section class="job-detail-page__signature"><JobDefinitionDetailHeader Summary="@summary" RecentActivity="@state.RecentActivity" ObservedAtUtc="@(state.ObservedAtUtc ?? TimeProvider.GetUtcNow())" IsRefreshing="@(state.IsLoading || _commandAdmission is not null)" IsMutating="@(state.IsMutating || _commandAdmission is not null)"
                                                   OnRefresh="RefreshAsync" OnInspectSchedule="OpenScheduleInspectorAsync" OnEditPolicy="OpenPolicyAsync"
                                                   OnToggleDisabled="ToggleDisabledAsync" OnRunNow="RunRecurringNowAsync" OnTrigger="OpenTriggerAsync" />
                        <SchedulerJobFinding Summary="@summary" Recent="@state.RecentActivity" />
                        <SchedulerJobTrajectory Recent="@state.RecentActivity" ObservedAtUtc="@(state.ObservedAtUtc ?? TimeProvider.GetUtcNow())" LedgerUrl="@LedgerUrl(summary.Definition)" ExecutionSelected="OpenExecutionDetailsAsync" /></section>
                        <div class="job-detail-page__viewbar">
                            <div role="group" aria-label="@L["JobDetail:PageTitle"]" class="job-detail-page__views">
                                @foreach (var view in new[] { "evidence", "schedule", "policy" })
                                {
                                    <button type="button" aria-pressed="@((SelectedView == view).ToString().ToLowerInvariant())" @onclick="@(() => SelectView(view))">@L[$"Workspace:Views:{view}"]</button>
                                }
                            </div>
                            <a href="@($"/job-scheduler/statistics?owner={Uri.EscapeDataString(summary.Definition.OwnerKey)}&job={Uri.EscapeDataString(summary.Definition.Declaration.JobKey)}")">@L["Workspace:Navigation:Statistics"] <MoIcon Icon="@MoIcons.ArrowUpRight" Size="1rem" /></a>
                        </div>
                        @if (SelectedView == "schedule")
                        {
                            <section class="job-detail-page__schedule"><JobDefinitionSchedulePanel Summary="@summary" OnInspectSchedule="OpenScheduleInspectorAsync" />
                            @if(summary.Definition.Declaration.JobType == JobType.Recurring) { <SchedulerSchedulePreview Definition="@summary.Definition" ObservedAtUtc="@(state.ObservedAtUtc ?? TimeProvider.GetUtcNow())" /> }</section>
                        }
                        else if (SelectedView == "policy")
                        {
                            <JobDefinitionContractPanel Definition="@summary.Definition" OnEdit="OpenPolicyAsync" />
                        }
                        else
                        {
                        <SchedulerHistoryCoverage Sample="@state.RecentActivity" />
                        <div class="job-detail-page__evidence-grid">
                            <div class="job-detail-page__main-evidence">
                                @if(summary.LatestExecution is not { State: JobExecutionState.Running or JobExecutionState.Queued or JobExecutionState.Failed })
                                {
                                    <section class="job-detail-panel"><header><div><h2>@L["JobDetail:LatestExecution:Title"]</h2><p>@L["Workspace:LatestEvidenceDescription"]</p></div><MoIcon Icon="@MoIcons.Receipt" Size="18px"/></header>@if(summary.LatestExecution is {} latest) { <SchedulerJobEvidenceRow Execution="@latest" ObservedAtUtc="@(state.ObservedAtUtc ?? TimeProvider.GetUtcNow())" ExecutionSelected="OpenExecutionDetailsAsync" /> } else { <p class="job-detail-page__empty">@L["Catalog:History:NeverRun"]</p> }</section>
                                }
                                @if(state.RunningActivity.Items.Count > 0 || state.RunningActivity.Error is not null)
                                {
                                    <section class="job-detail-panel"><header><div><h2>@L["Workspace:RunningNow"] <small>@state.RunningActivity.TotalCount</small></h2><p>@L["Workspace:ActiveEvidenceDescription"]</p></div></header>@if(state.RunningActivity.Error is {} runningError) { <MudAlert Severity="Severity.Warning" Dense="true">@runningError</MudAlert> }@foreach(var record in state.RunningActivity.Items) { <SchedulerJobEvidenceRow Execution="@record" ObservedAtUtc="@(state.ObservedAtUtc ?? TimeProvider.GetUtcNow())" ExecutionSelected="OpenExecutionDetailsAsync" /> }</section>
                                }
                                <section class="job-detail-panel"><header><div><h2>@L["JobDetail:Activity:FailuresTitle"]</h2><p>@L["Workspace:FailureEvidenceDescription"]</p></div><a href="@LedgerUrl(summary.Definition,true)">@L["Workspace:OpenLedger"] <MoIcon Icon="@MoIcons.ArrowRight" Size="14px"/></a></header>@if(state.RecentFailureActivity.Error is {} failureError) { <MudAlert Severity="Severity.Warning" Dense="true">@failureError</MudAlert> }@foreach(var record in state.RecentFailureActivity.Items) { <SchedulerJobEvidenceRow Execution="@record" ObservedAtUtc="@(state.ObservedAtUtc ?? TimeProvider.GetUtcNow())" ExecutionSelected="OpenExecutionDetailsAsync" /> }@if(state.RecentFailureActivity.Items.Count == 0 && state.RecentFailureActivity.Error is null) { <p class="job-detail-page__empty">@L["JobDetail:Activity:FailuresEmpty"]</p> }@if(state.LatestFailureMessage is {} message) { <div class="job-detail-page__failure-message"><p>@L["Workspace:LatestFailureMessage"]</p><pre>@message</pre></div> }</section>
                            </div>
                            <aside class="job-detail-page__side-evidence">
                                <section class="job-detail-page__reading"><p>@L["Workspace:TypicalDuration"]</p><strong>@TimePresentation.FormatDuration(state.Analytics?.Duration.P50)</strong><small>@L["Workspace:DurationSample",state.Analytics?.Duration.Count ?? 0]</small><div><span>P95</span><b>@TimePresentation.FormatDuration(state.Analytics?.Duration.P95)</b></div>@if(state.AnalyticsError is {} analyticsError) { <MudAlert Severity="Severity.Warning" Dense="true">@analyticsError</MudAlert> }</section>
                                <section class="job-detail-page__reading"><p>@L["Workspace:RetainedHistory"]</p><b>@state.RecentActivity.TotalCount.ToString("N0") @L["Workspace:RecordsUnit"]</b><small>@L["Workspace:RetainedHistoryDescription"]</small><div><span>@L["Policy:Fields:MaxRecords"]</span><b>@(summary.Definition.EffectiveConfiguration.MaxRetainedHistoryRecords == 0 ? L["Policy:Values:NoLimit"] : summary.Definition.EffectiveConfiguration.MaxRetainedHistoryRecords.ToString())</b></div><div><span>@L["Policy:Fields:MaxDays"]</span><b>@(summary.Definition.EffectiveConfiguration.MaxRetentionDays is {} days ? L["Policy:Values:Days",days] : L["Policy:Values:NoLimit"])</b></div></section>
                                <section class="job-detail-page__reading"><p>@L["JobDetail:Contract:DefinitionObserved"]</p><b>@TimePresentation.FormatTimestamp(summary.Definition.LastObservedAtUtc)</b><small>@L["Workspace:DefinitionObservationNote"]</small><a href="@($"/job-scheduler/runtime?q={Uri.EscapeDataString(summary.Definition.OwnerKey)}")">@L["Workspace:Navigation:Runtime"] <MoIcon Icon="@MoIcons.ArrowRight" Size="14px"/></a></section>
                            </aside>
                        </div>
                        }
                        @if (state.ObservedAtUtc is { } observedAtUtc)
                        {
                            <footer class="job-detail-page__freshness">
                                <MoIcon Icon="@MoIcons.Clock" Size="1.25rem" />
                                <span>@L["JobDetail:ObservedAt", TimePresentation.FormatTimestamp(observedAtUtc)]</span>
                            </footer>
                        }
                    </div>
                }
            </SchedulerAccessBoundary>
        }
    </div>
</SchedulerWorkspace>

@code {
    private static string LedgerUrl(JobDefinition definition,bool failed=false) => SchedulerRouteBuilder.Ledger(new JobExecutionQuery { SchedulerScopeKey=string.Empty,OwnerKey=definition.OwnerKey,JobKey=definition.Declaration.JobKey,States=failed ? [JobExecutionState.Failed] : null });
}
