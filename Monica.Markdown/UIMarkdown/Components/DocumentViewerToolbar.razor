@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Microsoft.Extensions.Localization
@using Monica.Markdown.Localization
@using Monica.Markdown.Models
@inject IStringLocalizer<MarkdownResource> L

<header class="@(ShowLibrarySwitcher ? "reader-toolbar has-library-switcher" : "reader-toolbar")">
    @if (ShowLibrarySwitcher)
    {
        <DocumentLibrarySwitcher CurrentGroup="CurrentGroup" CurrentCulture="@CurrentCulture" OnOpen="OnOpenGroupSwitcher" />
    }
    <div class="reader-tool-actions">
        @if (ShowSidebarToggle)
        {
        <MudButton OnClick="OnToggleSidebar" StartIcon="@MoIcons.FolderOpen" Class="reader-documents-button"
            aria-label="@(IsSidebarVisible ? L["MarkdownViewer:Navbar:HideSidebar"] : L["MarkdownViewer:Navbar:ShowSidebar"])"
            aria-expanded="@IsSidebarVisible.ToString().ToLowerInvariant()" aria-pressed="@IsSidebarVisible.ToString().ToLowerInvariant()"><span class="reader-button-label">@L["MarkdownViewer:Toolbar:DocumentTree"]</span></MudButton>
        }
        <MudButton OnClick="OnOpenDocumentSearch" StartIcon="@MoIcons.Search" Variant="Variant.Outlined"
            Class="reader-search-button">@L["MarkdownViewer:Toolbar:SearchPlaceholder"]</MudButton>
        @if (ShowLanguageSwitcher)
        {
            <MudMenu Label="@LanguageLabel" StartIcon="@MoIcons.Globe" EndIcon="@MoIcons.ChevronDown"
                AriaLabel="@L["MarkdownViewer:Toolbar:SwitchLanguage"]" Variant="Variant.Text" Dense="true"
                AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="reader-language-menu">
                @foreach (var language in Languages)
                {
                    <MudMenuItem role="menuitem" OnClick="@(() => OnLanguageChanged.InvokeAsync(language.Culture))"
                        Icon="@(string.Equals(language.Culture, CurrentCulture, StringComparison.OrdinalIgnoreCase) ? MoIcons.Check : null)">@language.DisplayName</MudMenuItem>
                }
            </MudMenu>
        }
        <MudButton OnClick="OnToggleOutline" StartIcon="@MoIcons.ListTree" Disabled="@(!HasOutline)"
            aria-label="@(IsOutlineVisible ? L["MarkdownViewer:Toolbar:HideOutline"] : L["MarkdownViewer:Toolbar:ShowOutline"])"
            aria-pressed="@IsOutlineVisible.ToString().ToLowerInvariant()"
            aria-expanded="@IsOutlineVisible.ToString().ToLowerInvariant()"
            Class="@(IsOutlineVisible ? "reader-outline-button is-active" : "reader-outline-button")"><span class="reader-button-label">@(IsOutlineVisible ? L["MarkdownViewer:Toolbar:HideOutline"] : L["MarkdownViewer:Toolbar:ShowOutline"])</span></MudButton>
    </div>
    @if (Document is not null)
    {
        <span class="reader-last-edited" title="@UiTime.Format(Document.LastModifiedUtc)">
            <MoIcon Icon="@MoIcons.Clock" Size="1rem" />
            @L["MarkdownViewer:Metadata:Modified"] @UiTime.FormatDate(Document.LastModifiedUtc)
        </span>
    }
</header>

@code {
    /// <summary>Whether the library visibility control is needed. Defaults to true; a visible persistent sidebar may supply its own collapse control.</summary>
    [Parameter] public bool ShowSidebarToggle { get; set; } = true;

    /// <summary>Whether the toolbar includes a library chooser. Defaults to true; hide it when the sidebar owns that control.</summary>
    [Parameter] public bool ShowLibrarySwitcher { get; set; } = true;
    /// <summary>The accepted document whose actual last-modified date is displayed, or null when no document is selected.</summary>
    [Parameter] public MarkdownDocument? Document { get; set; }

    /// <summary>The selected library whose identity and registered count are displayed.</summary>
    [Parameter] public MarkdownDocumentGroup? CurrentGroup { get; set; }
    /// <summary>The selected document culture, independent of the shell language.</summary>
    [Parameter] public string? CurrentCulture { get; set; }
    /// <summary>The selected language descriptor used for the menu label.</summary>
    [Parameter] public MarkdownDocumentLanguage? CurrentLanguage { get; set; }
    /// <summary>The actual registered languages available in the selected library.</summary>
    [Parameter] public IReadOnlyList<MarkdownDocumentLanguage> Languages { get; set; } = [];
    /// <summary>Whether this library permits switching document languages.</summary>
    [Parameter] public bool ShowLanguageSwitcher { get; set; }
    /// <summary>Whether the persistent or temporary document index is open.</summary>
    [Parameter] public bool IsSidebarVisible { get; set; }
    /// <summary>Whether the persistent or temporary heading outline is open.</summary>
    [Parameter] public bool IsOutlineVisible { get; set; }
    /// <summary>Whether the accepted document has actual rendered headings.</summary>
    [Parameter] public bool HasOutline { get; set; }
    /// <summary>Requests document-index visibility through the owning page state.</summary>
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    /// <summary>Requests the page-owned native library chooser.</summary>
    [Parameter] public EventCallback OnOpenGroupSwitcher { get; set; }
    /// <summary>Requests the page-owned native search dialog.</summary>
    [Parameter] public EventCallback OnOpenDocumentSearch { get; set; }
    /// <summary>Requests a registered document culture through the owning location state.</summary>
    [Parameter] public EventCallback<string> OnLanguageChanged { get; set; }
    /// <summary>Requests heading-outline visibility through the owning page state.</summary>
    [Parameter] public EventCallback OnToggleOutline { get; set; }
    private string LanguageLabel => CurrentLanguage?.DisplayName ?? CurrentCulture ?? L["MarkdownViewer:Toolbar:SwitchLanguage"];
}
