@using Monica.UI.Shared.Components.States
@using Monica.UI.Shared.Components.Dialogs
@using Monica.Modules
@using Monica.StateStore.UI.Models
@using Monica.StateStore.UI.Services
@using Monica.StateStore.UI.Support
@using Monica.StateStore.Models
@inject StateStoreUIService StateStoreService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<StateStoreResource> L
@inject IJSRuntime JS
@implements IAsyncDisposable
@implements IDisposable

<div class="state-browser-workspace" @ref="_workspace" data-visit="@_visit" data-provider-generation="@_providerGeneration" data-result-generation="@_resultGeneration" data-selection-generation="@_selectionGeneration" data-selected-key="@selectedKey?.Key" data-picker-open="@(_pickerOpen ? "true" : "false")" data-detail-open="@(_showDetail && selectedKey is not null ? "true" : "false")" data-expanded="@(_expanded ? "true" : "false")" data-focus-version="@_focusVersion" aria-busy="@(isSearching ? "true" : "false")">
    <header class="workspace-identity">
        <div class="workspace-identity__copy">@HeaderContent</div>
        @if (CanCreateSelectedProviderKeys())
        {
            <MudButton Class="create-key" Color="Color.Primary" Variant="Variant.Filled" StartIcon="@MoIcons.Add" OnClick="OpenCreateKeyDialog">@L["KeyExplorer:Actions:Create"]</MudButton>
        }
    </header>
    @NavigationContent
    <section class="workspace-commands">
        <div class="provider-context">
            @if (selectedProvider is { } provider)
            {
                <StateStoreProviderSelector Provider="provider" Providers="Providers" OnSelected="SelectProviderIdentity" />
                <a class="provider-info" href="@StateStoreUi.Providers(provider.UniqueId)" aria-label="@L["ProviderCard:Actions:ViewDetails"]" title="@L["ProviderCard:Actions:ViewDetails"]"><MoIcon Icon="@MoIcons.Info" Size="1.1rem" /></a>
            }
        </div>
        <div class="query-context">
            <div class="mode-switch" role="group" aria-label="@L["KeyExplorer:Labels:SearchMode"]">
                <button type="button" disabled="@(selectedProvider?.SupportsKeyScanning != true)" aria-pressed="@(IsSearchMode(EStateStoreKeySearchMode.PatternScan) ? "true" : "false")" @onclick="() => SetSearchMode(EStateStoreKeySearchMode.PatternScan)">@L["KeyExplorer:Labels:PatternSearchMode"]</button>
                <button type="button" disabled="@(selectedProvider?.SupportsExactLookup != true)" aria-pressed="@(IsSearchMode(EStateStoreKeySearchMode.ExactKey) ? "true" : "false")" @onclick="() => SetSearchMode(EStateStoreKeySearchMode.ExactKey)">@L["KeyExplorer:Labels:ExactLookupMode"]</button>
            </div>
            <label class="query-input"><MoIcon Icon="@MoIcons.Search" Size="1.1rem" /><input value="@searchQuery" @oninput="args => ChangeQuery(args.Value?.ToString() ?? string.Empty)" @onkeydown="OnSearchKeyDown" aria-label="@GetSearchLabel()" placeholder="@GetSearchPlaceholder()" disabled="@(selectedProvider is null)" spellcheck="false" autocomplete="off" /></label>
            <MudButton Class="query-submit" Color="Color.Primary" Variant="Variant.Text" Disabled="@(!CanSearch())" OnClick="SearchKeysAsync">@GetSearchActionText()</MudButton>
        </div>
    </section>
    <div class="accepted-context" data-provider="@_acceptedProvider?.UniqueId" data-query="@browseResult?.Query" data-mode="@browseResult?.AppliedMode">
        @if (browseResult is not null)
        {
            <span>@L["KeyExplorer:Labels:CompletedQuery"] <code>@browseResult.Query</code> · @GetSearchModeText(browseResult.AppliedMode) · @L["KeyExplorer:Labels:ShownMatched", keys.Count, browseResult.TotalCount]</span>
            @if (searchQuery.Trim() != browseResult.Query || searchMode != browseResult.AppliedMode) { <span class="draft-hint">@L["Workbench:QueryChanged"]</span> }
            @if (browseResult.HasMore) { <span>@L["KeyExplorer:Messages:ShowingFirst", keys.Count]</span> }
        }
        else { <span>@(string.IsNullOrEmpty(GetWorkspaceSupportMessage()) ? GetSearchModeDescription() : GetWorkspaceSupportMessage())</span> }
    </div>
    @if (isSearching)
    {
        <section class="workspace-state"><MoContentState Loading="true"><MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" /><p>@GetSearchActionText()</p></MoContentState></section>
    }
    else if (!string.IsNullOrWhiteSpace(browseError))
    {
        <MudAlert Severity="Severity.Error" Icon="@MoIcons.Error">@browseError</MudAlert>
    }
    else if (!hasBrowsed || selectedProvider is null)
    {
        <section class="workspace-state"><MoContentState><MoIcon Icon="@MoIcons.Search" Size="2rem" /><h2>@L[selectedProvider is null ? "KeyExplorer:Workspace:NoProviderTitle" : "KeyExplorer:Workspace:ReadyTitle"]</h2><p>@L[selectedProvider is null ? "KeyExplorer:Workspace:NoProviderSubtitle" : "KeyExplorer:Workspace:ReadySubtitle"]</p></MoContentState></section>
    }
    else if (keys.Count == 0)
    {
        <section class="workspace-state"><MoContentState><MoIcon Icon="@MoIcons.Search" Size="2rem" /><h2>@L[browseResult?.IsMissing == true ? "KeyExplorer:Messages:MissingKeyTitle" : "KeyExplorer:Messages:NoKeysFound"]</h2><p>@(browseResult?.IsMissing == true ? L["KeyExplorer:Messages:MissingKeyDescription", browseResult.Query] : L["KeyExplorer:Messages:NoKeysFoundHint"])</p></MoContentState></section>
    }
    else
    {
        <div class="workspace-master-detail">
            <section class="inventory">
                <header class="inventory-heading" id="@(_visit + "-inventory")" tabindex="-1"><h2>@L["KeyExplorer:Labels:Keys"] <span>@keys.Count</span></h2><div class="view-toggle" role="group" aria-label="@L["Workbench:ResultViews"]"><button type="button" aria-label="@L["Workbench:ListView"]" title="@L["Workbench:ListView"]" aria-pressed="@(!_treeView ? "true" : "false")" @onclick="() => _treeView = false"><MoIcon Icon="@MoIcons.List" Size="1.1rem" /></button><button type="button" aria-label="@L["Workbench:TreeView"]" title="@L["Workbench:TreeView"]" aria-pressed="@(_treeView ? "true" : "false")" @onclick="() => _treeView = true"><MoIcon Icon="@MoIcons.Workflow" Size="1.1rem" /></button></div></header>
                @if (CanShowRowSelection() && selectedKeyNames.Count > 0) { <div class="bulk-actions"><span>@L["KeyExplorer:Labels:SelectedCount", selectedKeyNames.Count]</span><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Disabled="@_isMutating" OnClick="DeleteSelectedKeysAsync">@L["KeyExplorer:Actions:DeleteSelected", selectedKeyNames.Count]</MudButton></div> }
                <div class="list-column-heading">@if (CanShowRowSelection()) { <input type="checkbox" class="select-all" checked="@(selectedKeyNames.Count == keys.Count)" data-mixed="@(selectedKeyNames.Count > 0 && selectedKeyNames.Count < keys.Count ? "true" : "false")" @onchange="args => ToggleAllSelection(args.Value is true)" aria-label="@L["Workbench:SelectAll"]" /> }<span>@L["Workbench:KeyName"]</span><span>@L[_treeView ? "Workbench:Namespace" : "Workbench:InspectHint"]</span></div>
                <div class="inventory-body" id="@(_visit + "-list")"><div class="results-list">
                    @if (_treeView)
                    {
                        <p class="tree-note">@L["Workbench:TreeNote"]</p>
                        var groupIndex = 0;
                        @foreach (var group in keys.GroupBy(item => StateStoreUi.SplitKey(item.Key).Prefix))
                        {
                            <details class="key-group" open="@(groupIndex++ == 0)" @key="group.Key"><summary><MoIcon Icon="@MoIcons.ChevronRight" Size="1rem" /><MoIcon Icon="@MoIcons.Folder" Size="1.1rem" /><code>@(string.IsNullOrEmpty(group.Key) ? L["Workbench:Ungrouped"] : group.Key)</code><span>@group.Count()</span></summary>@foreach (var item in group) { @KeyRow(item) }</details>
                        }
                    }
                    else { @foreach (var item in keys) { @KeyRow(item) } }
                </div></div>
                <footer class="inventory-footer"><span>@L["KeyExplorer:Labels:ShownMatched", keys.Count, browseResult!.TotalCount]</span><span>@L["Workbench:ReadMarker"]</span></footer>
            </section>
            <div class="pane-resizer" role="separator" tabindex="0" aria-label="@L["Workbench:ResizeList"]" aria-orientation="vertical" aria-valuemin="30" aria-valuemax="65" aria-valuenow="43"></div>
            @if (selectedKey is { } key)
            {
                <section class="inspector">
                    <header class="inspector-heading" id="@(_visit + "-detail")">
                        <div class="inspector-topline"><button class="back-to-keys" type="button" @onclick="BackToKeysAsync"><MoIcon Icon="@MoIcons.ArrowLeft" Size="1rem" />@L["KeyExplorer:Actions:BackToKeys"]</button><span class="mobile-provider" title="@GetProviderCaption(selectedProvider!)">@L.GetProviderDisplayName(selectedProvider!)</span><span class="inspector-label">@L["KeyExplorer:Detail:SelectedKeyLabel"]</span>@if (key.RawValue is not null) { <span class="format-badge">@GetValueFormat()</span> }<MudIconButton Class="copy-key" Icon="@MoIcons.Copy" Size="Size.Small" OnClick="CopyKeyAsync" aria-label="@L["Workbench:CopyKey"]" /><MudIconButton Class="expand-detail" Icon="@MoIcons.Maximize" Size="Size.Small" OnClick="() => _expanded = !_expanded" aria-label="@L[_expanded ? "Workbench:CollapseDetail" : "Workbench:ExpandDetail"]" /></div>
                        <div class="key-identity"><span class="key-icon"><MoIcon Icon="@MoIcons.Key" Size="1.25rem" /></span><div><p>@StateStoreUi.SplitKey(key.Key).Prefix</p><h2 tabindex="-1">@StateStoreUi.SplitKey(key.Key).Name</h2></div></div>
                    </header>
                    <div class="inspector-scroll">
                        <dl class="key-facts"><div><dt>@L["Workbench:TtlSnapshot"]</dt><dd class="ttl">@GetTtlText(key)</dd></div><div><dt>@L["KeyExplorer:Detail:Labels:ETag"]</dt><dd><code>@(string.IsNullOrEmpty(key.ETag) ? L["KeyExplorer:Detail:NotSupplied"] : key.ETag)</code></dd></div><div><dt>@L["Workbench:TextSize"]</dt><dd>@(key.RawValue is null ? L["KeyExplorer:Detail:NotSupplied"] : L["Workbench:ByteSize", System.Text.Encoding.UTF8.GetByteCount(key.RawValue)])</dd></div></dl>
                        @if (loadingKeyName == key.Key) { <MoContentState Loading="true" Compact="true"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><p>@L["KeyExplorer:Statuses:Loading"]</p></MoContentState> }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(key.Error)) { <div class="value-error"><MudAlert Severity="Severity.Error" Icon="@MoIcons.Error">@(key.RawValue is null ? key.Error : L["KeyExplorer:Messages:ValueRefreshFailed", key.Error])</MudAlert><MudButton OnClick="ReloadSelectedKeyAsync">@L["KeyValuePreview:Actions:LoadValue"]</MudButton>@if (key.RawValue is not null) { <p>@L["KeyExplorer:Messages:PreviewRetainedTitle"]</p> }</div> }
                            @if (key.RawValue is not null) { <StateStoreValueViewer Value="@key.RawValue" Identity="@key.Key" OnCopy="CopyValueAsync" /> }
                            else if (selectedProvider?.SupportsValuePreview != true) { <MoContentState Compact="true"><p>@L["KeyExplorer:Messages:ValuePreviewUnavailable"]</p></MoContentState> }
                            else if (string.IsNullOrWhiteSpace(key.Error)) { <MoContentState Compact="true"><p>@L[key.IsValueLoaded ? "KeyValuePreview:Labels:Empty" : "KeyExplorer:Statuses:SelectToInspect"]</p></MoContentState> }
                        }
                    </div>
                    <footer class="inspector-actions"><span>@GetProviderCaption(selectedProvider!)</span><div>
                        @if (CanViewKeys()) { <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" OnClick="ReloadSelectedKeyAsync">@L["Workbench:RefreshValue"]</MudButton> }
                        @if (CanEditSelectedProviderKeys()) { <MudButton Class="edit-key" Variant="Variant.Text" Color="Color.Primary" StartIcon="@MoIcons.Edit" Disabled="@_isMutating" OnClick="() => EditKeyAsync(key)">@L["KeyExplorer:Actions:Edit"]</MudButton> }
                        @if (CanViewKeys() && selectedProvider?.SupportsValuePreview != true) { <MudButton OnClick="() => ViewKeyAsync(key)">@L["KeyExplorer:Actions:View"]</MudButton> }
                        @if (CanDeleteSelectedProviderKey()) { <MudIconButton Icon="@MoIcons.Delete" Color="Color.Error" Size="Size.Small" Disabled="@_isMutating" OnClick="() => DeleteKeyAsync(key)" aria-label="@L["KeyExplorer:Actions:Delete"]" /> }
                    </div></footer>
                </section>
            }
        </div>
        <p class="results-note">@L["Workbench:ResultScope"]</p>
    }
</div>

@code {
    private RenderFragment KeyRow(StateStoreKeyInfo item) => @<div class="@GetResultRowClass(item)" @key="item.Key">
        @if (CanShowRowSelection()) { <input type="checkbox" checked="@selectedKeyNames.Contains(item.Key)" @onchange="args => ToggleKeySelection(item, args.Value is true)" aria-label="@L["KeyExplorer:Labels:SelectKey", item.Key]" /> }
        <button class="result-select" type="button" aria-pressed="@(selectedKey?.Key == item.Key ? "true" : "false")" title="@item.Key" data-key="@item.Key" @onclick="() => SelectKeyManualAsync(item)"><span class="result-copy"><code class="result-prefix">@StateStoreUi.SplitKey(item.Key).Prefix</code><code class="result-key">@StateStoreUi.SplitKey(item.Key).Name</code></span>@if (item.IsValueLoaded) { <span class="read-mark" data-error="@(!string.IsNullOrEmpty(item.Error) ? "true" : null)" title="@GetResultStatusText(item)"></span> }<MoIcon Icon="@MoIcons.ChevronRight" Size=".9rem" /></button>
    </div>;
}

<MudDialog Visible="@(_confirmation is not null)" VisibleChanged="OnConfirmationVisibilityChanged" Options="@_confirmationOptions" ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent><MoDialogHeading Text="@(_confirmation?.Title ?? string.Empty)" /></TitleContent>
    <DialogContent><div class="confirmation-content"><p>@_confirmation?.Message</p><code class="confirmation-provider">@_confirmation?.Provider</code></div></DialogContent>
    <DialogActions><div class="confirmation-actions"><MudButton OnClick="() => CompleteConfirmation(false)">@L["KeyExplorer:Dialogs:DeleteKeyCancel"]</MudButton><MudButton Color="Color.Error" OnClick="() => CompleteConfirmation(true)">@_confirmation?.ConfirmLabel</MudButton></div></DialogActions>
</MudDialog>
