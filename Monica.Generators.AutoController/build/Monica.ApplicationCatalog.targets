<Project>
  <!-- Catalog generation is opt-in. Ordinary producer libraries only need the analyzer. -->
  <ItemGroup>
    <CompilerVisibleProperty Include="MonicaApplicationCatalog" />
  </ItemGroup>

  <UsingTask TaskName="MonicaExtractApplicationMetadata" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
             Condition="'$(MonicaApplicationCatalog)' == 'true'">
    <ParameterGroup>
      <Assemblies ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
      <MetadataFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/tools/net472/System.Reflection.Metadata.dll" />
      <Reference Include="$(MSBuildToolsPath)/Sdks/Microsoft.NET.Sdk/tools/net472/System.Collections.Immutable.dll" />
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Reflection.Metadata" />
      <Using Namespace="System.Reflection.PortableExecutable" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Using Namespace="Microsoft.Build.Utilities" />
      <Code Type="Method" Language="cs"><![CDATA[
        public override bool Execute()
        {
        var outputs = new List<ITaskItem>();
        var paths = Assemblies.Select(item => Path.GetFullPath(item.ItemSpec))
            .Distinct(StringComparer.Ordinal).OrderBy(path => path, StringComparer.Ordinal);
        Directory.CreateDirectory(OutputDirectory);
        foreach (var path in paths)
        {
            string export = null;
            bool owned = false;
            using (var stream = File.OpenRead(path))
            using (var pe = new PEReader(stream))
            {
                if (!pe.HasMetadata) continue;
                var reader = pe.GetMetadataReader();
                foreach (var handle in reader.GetAssemblyDefinition().GetCustomAttributes())
                {
                    var attribute = reader.GetCustomAttribute(handle);
                    if (attribute.Constructor.Kind != HandleKind.MemberReference) continue;
                    var constructor = reader.GetMemberReference((MemberReferenceHandle)attribute.Constructor);
                    if (constructor.Parent.Kind != HandleKind.TypeReference) continue;
                    var type = reader.GetTypeReference((TypeReferenceHandle)constructor.Parent);
                    var name = reader.GetString(type.Name);
                    var space = reader.GetString(type.Namespace);
                    if (space == "Monica.ApplicationModel.Annotations" &&
                        (name == "ApplicationDomainAttribute" || name == "ApplicationRoleAttribute")) owned = true;
                    if (space != "System.Reflection" || name != "AssemblyMetadataAttribute") continue;
                    var value = reader.GetBlobReader(attribute.Value);
                    if (value.ReadUInt16() != 1 || value.ReadSerializedString() != "Monica.ApplicationModel.Export.v1") continue;
                    if (export != null)
                    {
                        Log.LogError("Assembly '{0}' contains multiple Monica application metadata exports.", path);
                        break;
                    }
                    export = value.ReadSerializedString();
                }
            }
            if (export == null)
            {
                if (owned) Log.LogError("Annotated application assembly '{0}' has no metadata export. Reference the Monica.Generators.AutoController analyzer in every domain core and role producer, then rebuild it.", path);
                continue;
            }
            if (!owned)
            {
                Log.LogError("Assembly '{0}' exports ownership without an ApplicationDomain or ApplicationRole declaration.", path);
                continue;
            }
            var output = Path.Combine(OutputDirectory, Path.GetFileNameWithoutExtension(path) + ".monica-application.xml");
            if (!File.Exists(output) || File.ReadAllText(output) != export)
                File.WriteAllText(output, export, new UTF8Encoding(false));
            outputs.Add(new TaskItem(Path.GetFullPath(output)));
        }
        MetadataFiles = outputs.ToArray();
        return !Log.HasLoggedErrors;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="MonicaCollectApplicationCatalog" BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences"
          Condition="'$(MonicaApplicationCatalog)' == 'true'">
    <!-- These projects establish build ordering only; no implementation reference is added to the compiler or runtime closure. -->
    <ItemGroup>
      <_MonicaCatalogProducer Include="@(ProjectReference)"
                             Condition="'%(ProjectReference.ReferenceOutputAssembly)' == 'false' and '%(ProjectReference.OutputItemType)' != 'Analyzer'" />
    </ItemGroup>
    <MSBuild Projects="@(_MonicaCatalogProducer)" Targets="GetTargetPath" BuildInParallel="$(BuildInParallel)"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
             Condition="'@(_MonicaCatalogProducer)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_MonicaCatalogProducerAssembly" />
    </MSBuild>
    <!-- IDE compilations need the same exports as ordinary builds. GetTargetPath does not build
         producers; on a clean checkout, wait for their first build instead of opening absent DLLs. -->
    <ItemGroup Condition="'$(DesignTimeBuild)' == 'true'">
      <_MonicaCatalogProducerAssembly Remove="@(_MonicaCatalogProducerAssembly)"
                                     Condition="!Exists('%(_MonicaCatalogProducerAssembly.Identity)')" />
    </ItemGroup>
    <MonicaExtractApplicationMetadata Assemblies="@(_MonicaCatalogProducerAssembly)"
                                     OutputDirectory="$(IntermediateOutputPath)monica-application-catalog">
      <Output TaskParameter="MetadataFiles" ItemName="_MonicaCatalogMetadata" />
    </MonicaExtractApplicationMetadata>
    <ItemGroup>
      <AdditionalFiles Include="@(_MonicaCatalogMetadata)" />
      <FileWrites Include="@(_MonicaCatalogMetadata)" />
    </ItemGroup>
  </Target>
</Project>
