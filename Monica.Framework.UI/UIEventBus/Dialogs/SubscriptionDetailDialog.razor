@using Monica.UI.Shared.Components.States
@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.State
@using Monica.UI.Shared.Components.Dialogs
@inject IStringLocalizer<EventBusResource> L

<MudDialog>
    <TitleContent><MoDialogHeading Text="@L["SubscriptionDetail:Title"]" /></TitleContent>
    <DialogContent>
        @if (_subscription != null) { <SubscriptionDetailPanel Subscription="_subscription" CapturedAt="_capturedAt" /> }
        else { <MoContentState Compact="true"><MoIcon Icon="@MoIcons.Info" Size="1.5rem" /><p>@L["SubscriptionDetail:States:NotSelected"]</p></MoContentState> }
    </DialogContent>
    <DialogActions><MudButton OnClick="Close" Color="Color.Primary">@L["Shared:Common:Close"]</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public SubscriptionViewModel? Subscription { get; set; }
    [Parameter] public DateTimeOffset? CapturedAt { get; set; }
    private SubscriptionViewModel? _subscription;
    private SubscriptionViewModel? _source;
    private DateTimeOffset _capturedAt;
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_source, Subscription)) { _source = Subscription; _subscription = Subscription == null ? null : EventBusWorkbenchState.CloneSubscription(Subscription); _capturedAt = CapturedAt ?? DateTimeOffset.UtcNow; }
    }
    private void Close() => MudDialog.Close();
}
