@using static Monica.Repository.UI.UIRepository.Support.RepositoryPresentation

<div class="rp-page" @ref="_root" aria-busy="@(_busy ? "true" : "false")">
    <MoPageMasthead Icon="@ViewIcon" Title="@L[TitleKey]" Crumb="@L["Workbench:Eyebrow"]" Class="rp-mh">
        <Meta>
            <span class="mo-vl-status mo-vl-status--pill @((State.ErrorMessage is null ? MoVisualRole.Neutral : MoVisualRole.Warning).ToCssClass())"
                  title="@L["Persistence:ManualTip"]" tabindex="0">
                <i class="mo-vl-status-dot" aria-hidden="true"></i>@L["Workbench:ManualSnapshot"]
            </span>
            <span class="rp-tag mono">@Host.ApplicationName</span>
            <span class="rp-tag">@Host.EnvironmentName</span>
            <span class="rp-tag mono">@UiTime.FormatZoneLabel(State.ContextsCapturedAt)</span>
        </Meta>
        <Actions>
            <div class="rp-stamp">
                <span>@L["Workbench:CapturedAt"]</span>
                <b class="mono">@UiTime.FormatTime(State.ContextsCapturedAt)</b>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@MoIcons.Refresh" Disabled="_busy" OnClick="RefreshAsync">
                @L[_busy ? "Persistence:Refreshing" : "Common:Actions:Refresh"]
            </MudButton>
        </Actions>
    </MoPageMasthead>
    <MoWorkbenchNavigation Label="@L["Workbench:Navigation"]" Compact="true">
        <a href="@RepositoryRoute.Overview()" aria-current="@Current("Overview")"><MoIcon Icon="@MoIcons.Database" Size="15px" />@L["Workbench:Views:Overview:Label"]
            @if (State.Contexts.Count > 0)
            {
                <span class="rp-nav-badge @RailStandingRole.ToCssClass()">@Attention/@State.Contexts.Count</span>
            }
        </a>
        <a href="@RepositoryRoute.Activity(RouteContext)" aria-current="@Current("Activity")"><MoIcon Icon="@MoIcons.ChartTrend" Size="15px" />@L["Workbench:Views:Activity:Label"]
            @if (RouteContext is { } id && State.FindSampledActivity(id) is { } sample)
            {
                <span class="rp-nav-badge @((sample.WaitingSessions > 0 ? MoVisualRole.Error : sample.IdleInTransactionSessions > 0 ? MoVisualRole.Warning : MoVisualRole.Info).ToCssClass())">@sample.TotalSessions</span>
            }
        </a>
        <a href="@RepositoryRoute.Migrations(RouteContext)" aria-current="@Current("Migrations")"><MoIcon Icon="@MoIcons.Workflow" Size="15px" />@L["Workbench:Views:Migrations:Label"]
            @if (State.Contexts.Count > 0)
            {
                <span class="rp-nav-badge @((KnownPending > 0 || IncompleteCount > 0 ? MoVisualRole.Warning : MoVisualRole.Success).ToCssClass())">@PendingDisplay</span>
            }
        </a>
    </MoWorkbenchNavigation>

    @if (State.ContextsCapturedAt is { } previous && State.ErrorMessage is not null)
    {
        <MoSemanticCallout Severity="MoVisualRole.Warning" Title="@L["Persistence:StaleTitle"]">
            @L["Persistence:StaleBody", UiTime.Format(previous)]
            <code class="rp-read-error">@State.ErrorMessage</code>
        </MoSemanticCallout>
    }

    @if (State.ContextsCapturedAt is null)
    {
        <section class="mo-vl-surface">
            @if (_busy)
            {
                <MoContentState Loading="true">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                    <h2>@L["Dashboard:Messages:LoadingContexts"]</h2>
                    <p>@L["Dashboard:Messages:LoadingContextsDescription"]</p>
                </MoContentState>
            }
            else
            {
                <MoContentState>
                    <MoIcon Icon="@MoIcons.Error" Size="24px" />
                    <h2>@L["Persistence:LoadFailedTitle"]</h2>
                    <p>@L["Persistence:LoadFailedBody"]</p>
                    @if (State.ErrorMessage is not null)
                    {
                        <code class="rp-read-error">@State.ErrorMessage</code>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Refresh" OnClick="RefreshAsync">@L["Common:Actions:Refresh"]</MudButton>
                </MoContentState>
            }
        </section>
    }
    else if (State.Contexts.Count == 0)
    {
        <section class="mo-vl-surface">
            <MoContentState>
                <MoIcon Icon="@MoIcons.Database" Size="24px" />
                <h2>@L["Dashboard:Messages:NoContexts"]</h2>
                <p>@L["Dashboard:Messages:NoContextsDescription"]</p>
            </MoContentState>
        </section>
    }
    else if (View == "Overview")
    {
        <RepositoryContextOverview Workbench="this" />
    }
    else if (State.SelectedContext is not { } selected)
    {
        <section class="mo-vl-surface">
            <MoContentState>
                <MoIcon Icon="@MoIcons.SearchOff" Size="24px" />
                <h2>@L["Workbench:Messages:ContextMissing"]</h2>
                <p>@L["Workbench:Messages:ChooseAvailable"]</p>
                <code class="rp-read-error">@Get("context")</code>
                <div class="rp-actions">
                    @foreach (var context in State.Contexts.Take(5))
                    {
                        <MudButton Variant="Variant.Outlined" Href="@Url(("context", context.Registration.ContextId))" StartIcon="@MoIcons.Database">
                            @context.Registration.DbContextName
                        </MudButton>
                    }
                </div>
            </MoContentState>
        </section>
    }
    else if (View == "Activity")
    {
        <RepositoryActivityTable Workbench="this" Context="selected" @key="selected.Registration.ContextId" />
    }
    else
    {
        <RepositoryMigrationPanel Workbench="this" Context="selected" />
    }
</div>
