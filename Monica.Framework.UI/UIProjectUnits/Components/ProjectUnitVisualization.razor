@using Monica.UI.Shared.Components.States
@using Monica.ProjectUnits.Facades
@using Monica.Core.Results;
@using Monica.ProjectUnits.Models
@using static Monica.Framework.UI.UIProjectUnits.Components.ProjectUnitLayoutPanel
@using Monica.UI.Shared.Components.ContextMenu
@inject ProjectUnitsFacade ProjectUnitsFacade
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<ProjectUnitsResource> L
@implements IAsyncDisposable

<section class="unit-graph-workspace" aria-labelledby="@(_graphContainerId + "-title")" data-testid="project-unit-visualization">
    <header class="graph-heading">
        <div class="graph-heading__identity">
            <span class="graph-eyebrow">@L["ProjectUnitVisualization:Workspace:Eyebrow"]</span>
            <h1 id="@(_graphContainerId + "-title")">@L["ProjectUnitVisualization:Header:Title"]</h1>
            <p>@L["ProjectUnitVisualization:Header:Description"]</p>
        </div>
        <div class="graph-heading__actions">
            <button type="button" class="graph-action" disabled="@_loading" @onclick="LoadProjectUnitsAsync">
                <MoIcon Icon="@MoIcons.Refresh" Size="1.25rem" />@L["ProjectUnitVisualization:Actions:RefreshTooltip"]
            </button>
            <button type="button" class="graph-action" aria-expanded="@(_showFilterPanel ? "true" : "false")" @onclick="ToggleFilterPanel">
                <MoIcon Icon="@MoIcons.Filter" Size="1.25rem" />@L["ProjectUnitVisualization:Actions:FilterSettingsTooltip"]
            </button>
            <button type="button" class="graph-action" aria-expanded="@(_showLayoutPanel ? "true" : "false")" @onclick="ToggleLayoutPanel">
                <MoIcon Icon="@MoIcons.Dashboard" Size="1.25rem" />@L["ProjectUnitVisualization:Actions:LayoutSettingsTooltip"]
            </button>
        </div>
    </header>

    @if (_showLayoutPanel)
    {
        <ProjectUnitLayoutPanel CurrentLayout="_currentLayout" ForceDistance="_forceDistance" ForceStrength="_forceStrength"
                                CurrentLayoutChanged="OnLayoutChanged" ForceDistanceChanged="OnForceDistanceChanged" ForceStrengthChanged="OnForceStrengthChanged" />
    }
    @if (_showFilterPanel)
    {
        <ProjectUnitFilterPanel @ref="_filterPanel" Units="_allProjectUnits" @bind-FilterText="_filterText" @bind-SelectedUnitTypes="_selectedUnitTypes"
                               @bind-ShowOnlyWithDependencies="_showOnlyWithDependencies" @bind-ShowOnlyWithAlerts="_showOnlyWithAlerts" OnFiltersChanged="ApplyFilters" />
    }
    @if (!string.IsNullOrEmpty(_relatedToNodeId))
    {
        var relatedUnit = _allProjectUnits.FirstOrDefault(unit => unit.Key == _relatedToNodeId);
        <div class="graph-related-scope" role="status">
            <MoIcon Icon="@MoIcons.Workflow" Size="1.25rem" />
            <div><span>@L["ProjectUnitVisualization:Workspace:ConnectedScope"]</span><strong>@(relatedUnit?.Title ?? _relatedToNodeId)</strong><p>@L["ProjectUnitVisualization:Workspace:ConnectedScopeHint"]</p></div>
            <button type="button" class="graph-text-action" @onclick="ClearRelatedFilterClick">@L["ProjectUnitVisualization:ContextMenu:ClearRelatedFilter"]</button>
        </div>
    }

    <div class="graph-explorer">
        <section class="graph-canvas-panel" aria-label="@L["ProjectUnitVisualization:Workspace:CanvasLabel"]">
            <div class="graph-canvas-toolbar">
                <div class="graph-scope"><strong>@_filteredUnits.Count</strong><span>@L["ProjectUnitVisualization:Workspace:VisibleUnits", _allProjectUnits.Count]</span><span class="graph-scope__divider" aria-hidden="true"></span><strong>@_visibleRelationships.Count</strong><span>@L["ProjectUnitVisualization:Workspace:DirectedEdges"]</span></div>
                <div class="graph-camera-controls">
                    <button type="button" class="graph-camera-button" disabled="@(_loading || _filteredUnits.Count == 0)" @onclick="FitView" title="@L["ProjectUnitVisualization:Workspace:Fit"]" aria-label="@L["ProjectUnitVisualization:Workspace:Fit"]"><MoIcon Icon="@MoIcons.Scan" Size="1.25rem" /></button>
                    <button type="button" class="graph-camera-button" disabled="@_loading" @onclick="ZoomOut" title="@L["ProjectUnitVisualization:Workspace:ZoomOut"]" aria-label="@L["ProjectUnitVisualization:Workspace:ZoomOut"]"><MoIcon Icon="@MoIcons.Minus" Size="1.25rem" /></button>
                    <button type="button" class="graph-camera-button" disabled="@_loading" @onclick="ZoomIn" title="@L["ProjectUnitVisualization:Workspace:ZoomIn"]" aria-label="@L["ProjectUnitVisualization:Workspace:ZoomIn"]"><MoIcon Icon="@MoIcons.Add" Size="1.25rem" /></button>
                    <button type="button" class="graph-camera-button" disabled="@_loading" @onclick="ResetView" title="@L["ProjectUnitVisualization:Actions:ResetViewTooltip"]" aria-label="@L["ProjectUnitVisualization:Actions:ResetViewTooltip"]"><MoIcon Icon="@MoIcons.Restart" Size="1.25rem" /></button>
                </div>
            </div>
            <div class="graph-canvas-owner" aria-busy="@(_loading ? "true" : "false")">
                <div id="@_graphContainerId" class="project-unit-graph" @onclick="OnBackgroundClick" @oncontextmenu:preventDefault="true"></div>
                @if (_loading)
                {
                    <div class="graph-canvas-state" role="status"><MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" /><span>@L["ProjectUnitVisualization:Workspace:Loading"]</span></div>
                }
                else if (!string.IsNullOrEmpty(_loadError))
                {
                    <div class="graph-canvas-state graph-canvas-state--error" role="alert"><MoIcon Icon="@MoIcons.Error" Size="1.5rem" /><strong>@L["ProjectUnitVisualization:Workspace:LoadError"]</strong><p>@_loadError</p></div>
                }
                else if (_filteredUnits.Count == 0)
                {
                    <div class="graph-canvas-state"><MoIcon Icon="@MoIcons.Network" Size="1.5rem" /><strong>@L[_allProjectUnits.Count == 0 ? "ProjectUnitVisualization:Workspace:EmptyCatalog" : "ProjectUnitVisualization:Workspace:NoMatches"]</strong><p>@L[_allProjectUnits.Count == 0 ? "ProjectUnitVisualization:Workspace:EmptyCatalogHint" : "ProjectUnitVisualization:Workspace:NoMatchesHint"]</p>@if (_allProjectUnits.Count > 0){<button type="button" class="graph-action" @onclick="() => ClearAllFiltersAsync(null)">@L["ProjectUnitVisualization:ContextMenu:ClearAllFilters"]</button>}</div>
                }
            </div>
            <footer class="graph-canvas-footer"><div class="graph-legend"><span><i class="graph-legend__simple" aria-hidden="true"></i>@L["ProjectUnitVisualization:Legend:SimpleUnit"]</span><span><i class="graph-legend__complex" aria-hidden="true"></i>@L["ProjectUnitVisualization:Legend:ComplexUnit"]</span></div><p>@L["ProjectUnitVisualization:Workspace:CanvasHint"]</p></footer>
        </section>

        <aside class="graph-selected-evidence" aria-label="@L["ProjectUnitVisualization:Workspace:SelectedLabel"]">
            <div class="graph-evidence-heading"><span class="graph-eyebrow">@L["ProjectUnitVisualization:Workspace:SelectedLabel"]</span><MoIcon Icon="@MoIcons.Globe" Size="1.25rem" /></div>
            @if (GetEvidenceUnit() is { } evidenceUnit)
            {
                <span class="graph-unit-type">@L.GetProjectUnitTypeText(evidenceUnit.UnitType)</span>
                <h3>@evidenceUnit.Title</h3><code class="graph-unit-key">@evidenceUnit.Key</code>
                @if (!string.IsNullOrWhiteSpace(evidenceUnit.Description)){<p class="graph-unit-description">@evidenceUnit.Description</p>}
                @if (!_filteredUnits.Any(unit => unit.Key == evidenceUnit.Key)){<p class="graph-scope-note">@L["ProjectUnitVisualization:Workspace:OutsideScope"]</p>}
                <dl class="graph-unit-facts"><div><dt>@L["ProjectUnitVisualization:Workspace:Dependencies"]</dt><dd>@evidenceUnit.Dependencies.Count</dd></div><div><dt>@L["ProjectUnitVisualization:Workspace:Dependents"]</dt><dd>@evidenceUnit.DependedByCount</dd></div><div><dt>@L["ProjectUnitVisualization:Workspace:Methods"]</dt><dd>@evidenceUnit.MethodCount</dd></div></dl>
                <div class="graph-selected-actions">
                    <button type="button" class="graph-action graph-action--primary" @onclick="() => ShowContextDetailsAsync(evidenceUnit)"><MoIcon Icon="@MoIcons.Info" Size="1.25rem" />@L["ProjectUnitVisualization:ContextMenu:Details"]</button>
                    <button type="button" class="graph-action" disabled="@(!_filteredUnits.Any(unit => unit.Key == evidenceUnit.Key))" @onclick="() => FocusOnNodeAsync(evidenceUnit)"><MoIcon Icon="@MoIcons.Focus" Size="1.25rem" />@L["ProjectUnitVisualization:ContextMenu:FocusNode"]</button>
                    <button type="button" class="graph-text-action" @onclick="() => FilterByTypeAsync(evidenceUnit)">@L["ProjectUnitVisualization:ContextMenu:FilterByType"]</button>
                    <button type="button" class="graph-text-action" @onclick="() => ShowRelatedNodesAsync(evidenceUnit)">@L["ProjectUnitVisualization:ContextMenu:ShowRelatedNodes"]</button>
                    <button type="button" class="graph-text-action" @onclick="() => CopyFullNameAsync(evidenceUnit)"><MoIcon Icon="@MoIcons.Copy" Size="1.25rem" />@L["ProjectUnitVisualization:ContextMenu:CopyFullName"]</button>
                </div>
                <div class="graph-selected-relations">
                    <section><h4>@L["ProjectUnitVisualization:Workspace:Dependencies"] <span>@evidenceUnit.Dependencies.Count</span></h4><div class="graph-relation-list">@foreach(var reference in evidenceUnit.Dependencies){<button type="button" class="graph-relation" @onclick="() => SelectReference(reference.Key)"><span>@reference.Title</span><code>@reference.Key</code><MoIcon Icon="@MoIcons.ArrowUpRight" Size="1.25rem" /></button>}@if(evidenceUnit.Dependencies.Count == 0){<p>@L["ProjectUnitVisualization:Workspace:NoDependencies"]</p>}</div></section>
                    <section><h4>@L["ProjectUnitVisualization:Workspace:Dependents"] <span>@evidenceUnit.DependedByCount</span></h4><div class="graph-relation-list">@foreach(var dependent in GetIncomingUnits(evidenceUnit)){<button type="button" class="graph-relation" @onclick="() => SelectReference(dependent.Key)"><span>@dependent.Title</span><code>@dependent.Key</code><MoIcon Icon="@MoIcons.ArrowDown" Size="1.25rem" /></button>}@if(evidenceUnit.DependedByCount == 0){<p>@L["ProjectUnitVisualization:Workspace:NoDependents"]</p>}</div></section>
                </div>
            }
            else
            {
                <MoContentState><MoIcon Icon="@MoIcons.Navigation" Size="1.5rem" /><h3>@L["ProjectUnitVisualization:Workspace:SelectUnit"]</h3><p>@L["ProjectUnitVisualization:Workspace:SelectUnitHint"]</p><button type="button" class="graph-action" @onclick="ToggleNativeEvidence">@L["ProjectUnitVisualization:Workspace:NativeEvidence"]</button></MoContentState>
            }
        </aside>
    </div>

    <section class="graph-native-evidence" aria-labelledby="@(_graphContainerId + "-native-title")">
        <header><div><span class="graph-eyebrow">@L["ProjectUnitVisualization:Workspace:NativeEyebrow"]</span><h3 id="@(_graphContainerId + "-native-title")">@L["ProjectUnitVisualization:Workspace:NativeEvidence"]</h3><p>@L["ProjectUnitVisualization:Workspace:NativeHint"]</p></div><button type="button" class="graph-action" aria-expanded="@(_showNativeEvidence ? "true" : "false")" @onclick="ToggleNativeEvidence"><MoIcon Icon="@(_showNativeEvidence ? MoIcons.ChevronUp : MoIcons.ChevronDown)" Size="1.25rem" />@L[_showNativeEvidence ? "ProjectUnitVisualization:Workspace:HideEvidence" : "ProjectUnitVisualization:Workspace:ShowEvidence"]</button></header>
        @if (_showNativeEvidence)
        {
            <div class="graph-native-tabs" role="group" aria-label="@L["ProjectUnitVisualization:Workspace:NativeEvidence"]"><button type="button" aria-pressed="@(!_showRelationships ? "true" : "false")" @onclick="() => SetEvidenceView(false)">@L["ProjectUnitVisualization:Workspace:UnitsTab", _filteredUnits.Count]</button><button type="button" aria-pressed="@(_showRelationships ? "true" : "false")" @onclick="() => SetEvidenceView(true)">@L["ProjectUnitVisualization:Workspace:RelationshipsTab", _visibleRelationships.Count]</button><button type="button" class="graph-text-action" @onclick="() => ClearAllFiltersAsync(null)">@L["ProjectUnitVisualization:ContextMenu:ClearAllFilters"]</button></div>
            <div class="graph-evidence-table-owner">
                @if (!_showRelationships)
                {
                    <table class="graph-evidence-table">
                        <thead>
                            <tr>
                                <th scope="col">@L["ProjectUnitVisualization:Workspace:UnitColumn"]</th>
                                <th scope="col">@L["ProjectUnitVisualization:Workspace:Dependencies"]</th>
                                <th scope="col">@L["ProjectUnitVisualization:Workspace:Dependents"]</th>
                                <th scope="col">@L["ProjectUnitVisualization:Workspace:ActionsColumn"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var unit in _filteredUnits.Skip(_evidencePage * EVIDENCE_PAGE_SIZE).Take(EVIDENCE_PAGE_SIZE))
                            {
                                <tr @key="unit.Key" data-unit-id="@unit.Key" data-selected="@(_evidenceUnitKey == unit.Key ? "true" : "false")">
                                    <td>
                                        <button type="button" class="graph-ledger-unit" aria-pressed="@(_evidenceUnitKey == unit.Key ? "true" : "false")" @onclick="() => SelectEvidenceUnit(unit)">
                                            <strong>@unit.Title</strong>
                                            <span>@L.GetProjectUnitTypeText(unit.UnitType)</span>
                                            <code>@unit.Key</code>
                                        </button>
                                    </td>
                                    <td data-label="@L["ProjectUnitVisualization:Workspace:Dependencies"]">@unit.Dependencies.Count</td>
                                    <td data-label="@L["ProjectUnitVisualization:Workspace:Dependents"]">@unit.DependedByCount</td>
                                    <td>
                                        <div class="graph-ledger-actions">
                                            <button type="button" class="graph-text-action" @onclick="() => ShowContextDetailsAsync(unit)">@L["ProjectUnitVisualization:ContextMenu:Details"]</button>
                                            <button type="button" class="graph-text-action" @onclick="() => FocusOnNodeAsync(unit)">@L["ProjectUnitVisualization:ContextMenu:FocusNode"]</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <table class="graph-evidence-table graph-evidence-table--relationships">
                        <thead>
                            <tr>
                                <th scope="col">@L["ProjectUnitVisualization:Workspace:SourceColumn"]</th>
                                <th scope="col" class="graph-direction-cell">
                                    <MoIcon Icon="@MoIcons.ArrowRight" Size="1.25rem" />
                                    <span class="graph-sr-only">@L["ProjectUnitVisualization:Workspace:DependencyDirection"]</span>
                                </th>
                                <th scope="col">@L["ProjectUnitVisualization:Workspace:TargetColumn"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var edge in _visibleRelationships.Skip(_evidencePage * EVIDENCE_PAGE_SIZE).Take(EVIDENCE_PAGE_SIZE))
                            {
                                <tr @key="edge" data-source-id="@edge.Source.Key" data-target-id="@edge.Target.Key">
                                    <td>
                                        <button type="button" class="graph-ledger-unit" aria-pressed="@(_evidenceUnitKey == edge.Source.Key ? "true" : "false")" @onclick="() => SelectEvidenceUnit(edge.Source)">
                                            <strong>@edge.Source.Title</strong>
                                            <code>@edge.Source.Key</code>
                                        </button>
                                    </td>
                                    <td class="graph-direction-cell">
                                        <MoIcon Icon="@MoIcons.ArrowRight" Size="1.25rem" />
                                        <span class="graph-sr-only">@L["ProjectUnitVisualization:Workspace:DependencyDirection"]</span>
                                    </td>
                                    <td>
                                        <button type="button" class="graph-ledger-unit" aria-pressed="@(_evidenceUnitKey == edge.Target.Key ? "true" : "false")" @onclick="() => SelectEvidenceUnit(edge.Target)">
                                            <strong>@edge.Target.Title</strong>
                                            <code>@edge.Target.Key</code>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (EvidenceCount == 0){<MoContentState Compact="true"><p>@L["ProjectUnitVisualization:Workspace:NoEvidence"]</p></MoContentState>}
            </div>
            <footer class="graph-evidence-pager"><span>@L["ProjectUnitVisualization:Workspace:PageRange", EvidenceCount == 0 ? 0 : _evidencePage * EVIDENCE_PAGE_SIZE + 1, Math.Min((_evidencePage + 1) * EVIDENCE_PAGE_SIZE, EvidenceCount), EvidenceCount]</span><div><button type="button" class="graph-camera-button" aria-label="@L["ProjectUnitVisualization:Workspace:PreviousPage"]" disabled="@(_evidencePage == 0)" @onclick="() => ChangeEvidencePage(-1)"><MoIcon Icon="@MoIcons.ChevronLeft" Size="1.25rem" /></button><button type="button" class="graph-camera-button" aria-label="@L["ProjectUnitVisualization:Workspace:NextPage"]" disabled="@((_evidencePage + 1) * EVIDENCE_PAGE_SIZE >= EvidenceCount)" @onclick="() => ChangeEvidencePage(1)"><MoIcon Icon="@MoIcons.ChevronRight" Size="1.25rem" /></button></div></footer>
        }
    </section>
</section>

<ProjectUnitDetailDialog @bind-Visible="_detailDialogVisible" SelectedUnit="_selectedUnit" OnNodeFocus="HandleNodeFocusFromDialog" />
<MoContextMenu TItem="ProjectUnitSummary" Items="@_contextMenuItems" Visible="@_contextMenuOpen" InitialX="@_contextMenuX" InitialY="@_contextMenuY" ContextItem="@_contextMenuUnit" OpeningRevision="@_contextMenuOpeningRevision" OnItemClick="@OnContextMenuItemClick" OnClose="@CloseContextMenu" />

@code {
    private const string JS_MODULE_PATH = "./_content/Monica.Framework.UI/UIProjectUnits/projectUnitGraph.js";
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly SemaphoreSlim _interopGate = new(1, 1);
    private readonly object _disposeSync = new();
    private readonly string _graphContainerId = $"project-unit-graph-{Guid.NewGuid():N}";
    private long _contextMenuOpeningRevision;
    private IJSObjectReference? _graphController;
    private DotNetObjectReference<ProjectUnitVisualization>? _dotNetReference;
    private Task? _disposeTask;
    private List<ProjectUnitSummary> _allProjectUnits = [];
    private const int EVIDENCE_PAGE_SIZE = 10;
    private List<ProjectUnitSummary> _filteredUnits = [];
    private List<VisibleRelationship> _visibleRelationships = [];
    private ProjectUnitFilterPanel? _filterPanel;
    private string? _evidenceUnitKey;
    private string? _loadError;
    private bool _showNativeEvidence;
    private bool _showRelationships;
    private int _evidencePage;
    private long _loadRequestId;
    private long _projectionRevision;
    private int EvidenceCount => _showRelationships ? _visibleRelationships.Count : _filteredUnits.Count;
    private sealed record VisibleRelationship(ProjectUnitSummary Source, ProjectUnitSummary Target);
    private bool _loading;
    private bool _detailDialogVisible;
    private ProjectUnitSummary? _selectedUnit;
    private ProjectUnitSummary? _contextMenuUnit;
    private bool _showFilterPanel;
    private bool _showLayoutPanel;
    private string _filterText = string.Empty;
    private IReadOnlyCollection<EProjectUnitType> _selectedUnitTypes = new HashSet<EProjectUnitType>();
    private bool _unitTypeFilterInitialized;
    private bool _showOnlyWithDependencies;
    private bool _showOnlyWithAlerts;
    private string? _relatedToNodeId;
    private bool _contextMenuOpen;
    private double _contextMenuX;
    private double _contextMenuY;
    private LayoutType _currentLayout = LayoutType.Force;
    private int _forceDistance = 500;
    private int _forceStrength = -300;
    private List<ContextMenuItem<ProjectUnitSummary>> _contextMenuItems = [];
    private volatile bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await InitializeGraphAsync();
            if (!_disposed)
            {
                await LoadProjectUnitsAsync();
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
    }

    private async Task InitializeGraphAsync()
    {
        await _interopGate.WaitAsync(_lifetimeCancellation.Token);

        IJSObjectReference? module = null;
        IJSObjectReference? graphController = null;
        DotNetObjectReference<ProjectUnitVisualization>? dotNetReference = null;
        try
        {
            module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                JS_MODULE_PATH);

            if (_disposed)
            {
                return;
            }

            dotNetReference = DotNetObjectReference.Create(this);
            graphController = await module.InvokeAsync<IJSObjectReference>(
                "createGraph",
                _graphContainerId,
                false,
                dotNetReference);

            if (_disposed)
            {
                return;
            }

            _graphController = graphController;
            _dotNetReference = dotNetReference;
            graphController = null;
            dotNetReference = null;
        }
        finally
        {
            await DisposeGraphControllerAsync(graphController);
            dotNetReference?.Dispose();
            await ReleaseModuleReferenceAsync(module);

            _interopGate.Release();
        }
    }

    private async Task LoadProjectUnitsAsync()
    {
        if (_disposed)
        {
            return;
        }

        var requestId = ++_loadRequestId;
        _loading = true;
        _loadError = null;
        StateHasChanged();
        try
        {
            var result = await ProjectUnitsFacade.GetAllProjectUnitsAsync();
            if (_disposed || requestId != _loadRequestId)
            {
                return;
            }

            if (result.IsFailed(out var error, out var data))
            {
                _loadError = L["Shared:Messages:LoadFailed", error].Value;
                Snackbar.Add(_loadError, Severity.Error);
                return;
            }

            _allProjectUnits = data;
            var availableUnitTypes = GetAvailableUnitTypes();
            _selectedUnitTypes = !_unitTypeFilterInitialized
                ? availableUnitTypes
                : new HashSet<EProjectUnitType>(_selectedUnitTypes.Where(availableUnitTypes.Contains));
            _unitTypeFilterInitialized = true;
            if (_selectedUnit is not null)
            {
                var selectedKey = _selectedUnit.Key;
                _selectedUnit = _allProjectUnits.FirstOrDefault(unit => unit.Key == selectedKey);
                _detailDialogVisible &= _selectedUnit is not null;
            }

            if (!_allProjectUnits.Any(unit => unit.Key == _evidenceUnitKey))
            {
                _evidenceUnitKey = null;
            }

            _contextMenuOpen = false;
            await ApplyFilters();
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
        catch (Exception ex)
        {
            if (!_disposed && requestId == _loadRequestId)
            {
                _loadError = L["Shared:Messages:LoadException", ex.Message].Value;
                Snackbar.Add(_loadError, Severity.Error);
            }
        }
        finally
        {
            if (!_disposed && requestId == _loadRequestId)
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private async Task UpdateGraph()
    {
        var revision = ++_projectionRevision;
        if (_disposed)
        {
            return;
        }

        try
        {
            await _interopGate.WaitAsync(_lifetimeCancellation.Token);
            try
            {
                if (!_disposed && revision == _projectionRevision && _graphController is not null)
                {
                    // One admitted call publishes coherent data and its current layout configuration.
                    await _graphController.InvokeVoidAsync("updateGraph", _lifetimeCancellation.Token,
                        PrepareGraphData(), new
                        {
                            layout = GetLayoutName(_currentLayout),
                            forceDistance = _forceDistance,
                            forceStrength = _forceStrength,
                            selectedId = _evidenceUnitKey
                        });
                }
            }
            finally
            {
                _interopGate.Release();
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
    }

    private object PrepareGraphData()
    {
        var nodes = _filteredUnits.Select(unit => new
        {
            id = unit.Key,
            title = unit.Title,
            type = L.GetProjectUnitTypeText(unit.UnitType),
            typeValue = (int)unit.UnitType,
            dependencyCount = unit.Dependencies.Count,
            dependedByCount = unit.DependedByCount,
            hasAttributes = unit.HasExplicitMetadata,
            methodCount = unit.MethodCount,
            hasMethod = unit.MethodCount > 0,
            isComplex = ProjectUnitVisualizationConfig.IsComplexUnitType(unit.UnitType),
            colorRole = ProjectUnitVisualizationConfig.GetUnitTypeColorRole(unit.UnitType),
            icon = ProjectUnitVisualizationConfig.GetUnitTypeIcon(unit.UnitType),
            chips = L.BuildProjectUnitGraphChips(unit),
            metadata = L.BuildProjectUnitGraphMetadata(unit),
            alertLevel = ProjectUnitVisualizationConfig.GetHighestAlertLevel(unit),
            alertCount = unit.Alerts.Count,
            tooltip = L.BuildProjectUnitGraphTooltip(unit),
            summary = L.BuildProjectUnitGraphSummary(unit),
            noMetadataText = L["ProjectUnitVisualization:Graph:NoMetadata"].Value
        }).ToList();

        var links = _visibleRelationships.Select(edge => new
        {
            source = edge.Source.Key,
            target = edge.Target.Key
        }).ToList();

        return new { nodes, links };
    }

    private void ToggleFilterPanel()
    {
        _showFilterPanel = !_showFilterPanel;
        if (_showFilterPanel)
        {
            _showLayoutPanel = false;
        }
    }

    private void ToggleLayoutPanel()
    {
        _showLayoutPanel = !_showLayoutPanel;
        if (_showLayoutPanel)
        {
            _showFilterPanel = false;
        }
    }

    private static string GetLayoutName(LayoutType layoutType) => layoutType switch
    {
        LayoutType.Force => "force",
        LayoutType.Hierarchy => "hierarchy",
        LayoutType.Circular => "circular",
        LayoutType.MultiCircular => "multi_circular",
        _ => "force"
    };

    private async Task SetLayout(LayoutType layoutType)
    {
        _currentLayout = layoutType;
        await InvokeGraphAsync("setLayout", GetLayoutName(layoutType));
    }

    private async Task OnForceDistanceChanged(int value)
    {
        _forceDistance = value;
        await InvokeGraphAsync("setForceDistance", value);
    }

    private async Task OnForceStrengthChanged(int value)
    {
        _forceStrength = value;
        await InvokeGraphAsync("setForceStrength", value);
    }

    private async Task ApplyFilters()
    {
        if (_disposed)
        {
            return;
        }

        var related = string.IsNullOrEmpty(_relatedToNodeId) ? null : GetAllRelatedNodes(_relatedToNodeId);
        _filteredUnits = _allProjectUnits.Where(unit =>
        {
            if (related is not null)
            {
                return related.Contains(unit.Key);
            }

            var matchesText = string.IsNullOrWhiteSpace(_filterText)
                || unit.Title.Contains(_filterText, StringComparison.OrdinalIgnoreCase)
                || unit.Key.Contains(_filterText, StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrEmpty(unit.Owner) && unit.Owner.Contains(_filterText, StringComparison.OrdinalIgnoreCase))
                || unit.Tags.Any(tag => tag.Contains(_filterText, StringComparison.OrdinalIgnoreCase))
                || (!string.IsNullOrEmpty(unit.Description) && unit.Description.Contains(_filterText, StringComparison.OrdinalIgnoreCase));
            return matchesText && _selectedUnitTypes.Contains(unit.UnitType)
                && (!_showOnlyWithDependencies || unit.Dependencies.Count > 0 || unit.DependedByCount > 0)
                && (!_showOnlyWithAlerts || unit.Alerts.Count > 0);
        }).ToList();

        var visible = _filteredUnits.ToDictionary(unit => unit.Key, StringComparer.Ordinal);
        _visibleRelationships = _filteredUnits.SelectMany(source => source.Dependencies
            .Where(reference => visible.ContainsKey(reference.Key))
            .Select(reference => new VisibleRelationship(source, visible[reference.Key]))).ToList();
        _evidencePage = 0;
        _contextMenuOpen = false;
        await UpdateGraph();
    }

