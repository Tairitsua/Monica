@using Microsoft.Extensions.Localization
@using System.Globalization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.State
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<ModuleSystemResource> L

@if (Session.Snapshot is { } snapshot)
{
    <div class="discovery-layout">
        <header class="discovery-summary" aria-labelledby="discovery-title">
            <div class="discovery-summary__copy">
                <span class="discovery-eyebrow">@L["Discovery:Eyebrow"]</span>
                <h2 id="discovery-title">@L["Discovery:Title"]</h2>
                <p>@L["Discovery:Description"]</p>
            </div>
            <div class="discovery-type-total">
                <span>@snapshot.TypeDiscovery.Statistics.EnumeratedTypeCount.ToString("N0", CultureInfo.CurrentCulture)</span>
                <small>@L["Discovery:Counts:Types"]</small>
            </div>
            <div class="discovery-counts"><MoFactGrid Facts="@DiscoveryFacts" /></div>
            <p class="discovery-count-scope">@L["Discovery:Counts:ScopeHint"]</p>
        </header>

        <section class="discovery-stage-ledger" aria-labelledby="discovery-stages-title">
            <header class="discovery-stage-heading">
                <span class="discovery-stage-heading__icon" aria-hidden="true"><MoIcon Size="1.5rem" Icon="@MoIcons.Workflow" /></span>
                <h3 id="discovery-stages-title">@L["Discovery:Stages:Title"]</h3>
                <p>@L["Discovery:Stages:Description"]</p>
                <span class="discovery-stage-total">@L["Performance:Waterfall:Duration", ModuleDiagnosticsDisplay.Duration(TotalStageDurationMs)]</span>
            </header>
            @if (snapshot.TypeDiscovery.Stages.Length == 0)
            {
                <MoContentState Compact="true"><p>@L["Discovery:Stages:Empty"]</p></MoContentState>
            }
            else
            {
                <ol class="discovery-stages">
                    @for (var stageIndex = 0; stageIndex < snapshot.TypeDiscovery.Stages.Length; stageIndex++)
                    {
                        var stage = snapshot.TypeDiscovery.Stages[stageIndex];
                        <li class="discovery-stage @StageRole(stage.Stage).ToCssClass()" @key="stage.SpanId">
                            <span class="discovery-stage-number" aria-hidden="true">@((stageIndex + 1).ToString("D2"))</span>
                            <span class="discovery-stage-name">@ModuleDiagnosticsDisplay.Stage(stage.Stage, L)</span>
                            <MoTwoRoleMeter PrimaryValue="@stage.DurationMs"
                                            ScaleMaximum="@TotalStageDurationMs"
                                            PrimaryRole="@StageRole(stage.Stage)"
                                            AccessibleDescription="@L["Performance:Discovery:StageAria",
                                                ModuleDiagnosticsDisplay.Stage(stage.Stage, L),
                                                ModuleDiagnosticsDisplay.Duration(stage.DurationMs)]" />
                            <strong class="discovery-stage-duration" title="@ModuleDiagnosticsDisplay.ExactMilliseconds(stage.DurationMs)">@ModuleDiagnosticsDisplay.Duration(stage.DurationMs)</strong>
                            <details class="discovery-stage-evidence">
                                <summary>@L["Discovery:Stages:SpanId"]</summary>
                                <IdentifierValue Value="@stage.SpanId" />
                            </details>
                        </li>
                    }
                </ol>
            }
        </section>

        <ModuleWorkbenchAssemblyExplorer Session="@Session" />

        <div class="discovery-grid">
            <section class="discovery-query-ledger" aria-labelledby="query-title">
                <header class="discovery-evidence-heading">
                    <h3 id="query-title">@L["Discovery:Queries:Title"]</h3>
                    <p>@L["Discovery:Queries:Description"]</p>
                </header>
                <div class="query-table-wrapper" role="region" aria-labelledby="query-title" tabindex="0">
                    <MudTable T="TypeDiscoveryQuerySummary"
                              Items="@snapshot.TypeDiscovery.Queries"
                              Dense="true"
                              Hover="true"
                              Elevation="0"
                              Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh>@L["Discovery:Queries:QueryId"]</MudTh>
                            <MudTh>@L["Discovery:Queries:Consumers"]</MudTh>
                            <MudTh>@L["Discovery:Queries:Matches"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="query">
                            <MudTd DataLabel="@L["Discovery:Queries:QueryId"]">
                                <div class="query-identity"><IdentifierValue Value="@query.QueryId" /></div>
                            </MudTd>
                            <MudTd DataLabel="@L["Discovery:Queries:Consumers"]">
                                <span class="query-consumers">@(query.ConsumerModules.Length == 0 ? L["Common:None"].Value : ConsumerNames(query))</span>
                            </MudTd>
                            <MudTd DataLabel="@L["Discovery:Queries:Matches"]"><span class="query-match-count">@query.MatchCount</span></MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MoContentState Compact="true"><p>@L["Discovery:Queries:Empty"]</p></MoContentState>
                        </NoRecordsContent>
                    </MudTable>
                </div>
            </section>

            <section class="discovery-commit" aria-labelledby="commit-title">
                <header class="discovery-evidence-heading">
                    <h3 id="commit-title">@L["Discovery:Commit:Title"]</h3>
                    <p>@L["Discovery:Commit:Description"]</p>
                </header>
                <div class="discovery-commit-facts"><MoFactGrid Facts="@CommitFacts" /></div>
            </section>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ModuleSystemWorkbenchSession Session { get; set; } = default!;

    private IReadOnlyList<MoFact> DiscoveryFacts => Session.Snapshot is { } snapshot
        ?
        [
            new(L["Discovery:Counts:Assemblies"], snapshot.TypeDiscovery.Statistics.AssemblyCount.ToString(CultureInfo.InvariantCulture)),
            new(L["Discovery:Counts:Plans"], snapshot.TypeDiscovery.Statistics.PlanCount.ToString(CultureInfo.InvariantCulture)),
            new(L["Discovery:Counts:Queries"], snapshot.TypeDiscovery.Statistics.DistinctQueryCount.ToString(CultureInfo.InvariantCulture)),
            new(L["Discovery:Counts:Matches"], snapshot.TypeDiscovery.Statistics.MatchCount.ToString(CultureInfo.InvariantCulture)),
        ]
        : [];

    private IReadOnlyList<MoFact> CommitFacts => Session.Snapshot is { } snapshot
        ?
        [
            new(L["Discovery:Commit:Callbacks"], snapshot.TypeDiscovery.Statistics.CommitCallbackCount.ToString(CultureInfo.InvariantCulture)),
            new(L["Discovery:Commit:Added"], snapshot.TypeDiscovery.Statistics.ServiceRegistrations.AddedCount.ToString(CultureInfo.InvariantCulture)),
            new(L["Discovery:Commit:Replaced"], snapshot.TypeDiscovery.Statistics.ServiceRegistrations.ReplacedCount.ToString(CultureInfo.InvariantCulture)),
            new(L["Discovery:Commit:Skipped"], snapshot.TypeDiscovery.Statistics.ServiceRegistrations.SkippedCount.ToString(CultureInfo.InvariantCulture)),
            new(L["Discovery:Commit:Excluded"], snapshot.TypeDiscovery.Statistics.ExcludedTypeCount.ToString(CultureInfo.InvariantCulture)),
        ]
        : [];

    private double TotalStageDurationMs => Session.Snapshot?.TypeDiscovery.Stages.Sum(static stage => stage.DurationMs) ?? 0;

    private string ConsumerNames(TypeDiscoveryQuerySummary query) => string.Join(", ", query.ConsumerModules.Select(key =>
        Session.Snapshot?.Modules.FirstOrDefault(module => module.ModuleKey == key)?.TypeName ?? key.Value));

    private static MoVisualRole StageRole(ModuleSystemStage stage) => stage switch
    {
        ModuleSystemStage.TypeDiscoveryAssemblyResolution or ModuleSystemStage.TypeDiscoveryTypeEnumeration => MoVisualRole.Info,
        ModuleSystemStage.TypeDiscoveryQueryEvaluation => MoVisualRole.Secondary,
        _ => MoVisualRole.Primary
    };

}
