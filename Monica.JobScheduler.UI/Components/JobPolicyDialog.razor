@using Monica.UI.Shared.Components.Dialogs
@using Monica.JobScheduler.UI.Localization

<MudDialog Class="@(ScheduleOnly ? "scheduler-schedule-dialog" : "scheduler-policy-dialog")"
           Style="width:760px;max-width:calc(100vw - 32px)"
           Gutters="false" TitleClass="pa-0" ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent>
        <div class="policy-workbench__title @(ScheduleOnly ? "policy-workbench__title--cron" : null)">
            <div class="policy-workbench__title-icon" aria-hidden="true">
                <MoIcon Icon="@(ScheduleOnly ? MoIcons.CalendarDays : MoIcons.Sliders)" Size="18px" />
            </div>
            <div>
                <MoDialogHeading Text="@L[ScheduleOnly ? "Workspace:CronEditor:Title" : "Policy:Title"]" />
                <MudText Typo="Typo.body2">@(_state?.EffectiveDisplayName ?? Definition.Declaration.JobName)</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_state is not null)
        {
            <div class="policy-workbench @(ScheduleOnly ? "policy-workbench--cron" : null)">
                @if (_state.HasConflict)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Icon="@MoIcons.Merge">
                        @L["Policy:Conflict:DraftsPreserved",
                            _state.ConflictPreviousPolicyRevision ?? L["Common:NotAvailable"].Value,
                            _state.Definition.Policy.ConcurrencyStamp]
                    </MudAlert>
                    @if (_state.HasSameFieldConflict)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Warning">
                            @L["Policy:Conflict:SameField"]
                        </MudAlert>
                    }
                }

                @if (ScheduleOnly)
                {
                    @if (_state.Schedule is { } schedule)
                    {
                        <section class="policy-cron-section" aria-label="@L["Policy:Sections:Schedule"]">
                            <OperationalPolicyScheduleEditor Draft="@schedule" Compact="true"
                                                             CurrentExpression="@_state.Definition.EffectiveConfiguration.Schedule?.CronExpression"
                                                             IsPresent="@_state.Definition.IsPresent"
                                                             Disabled="@_isSaving"
                                                             IsPaused="@_state.EffectiveDisabled"
                                                             Changed="DraftChanged" />
                        </section>
                    }
                    @if (_state.HasScheduleTypeConflict)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@MoIcons.SyncOff">
                            <div class="policy-workbench__schedule-conflict">
                                <span>@L["Policy:Conflict:ScheduleTypeChanged"]</span>
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                                           OnClick="DiscardScheduleDraft" Disabled="@_isSaving">
                                    @L["Policy:Conflict:DiscardScheduleDraft"]
                                </MudButton>
                            </div>
                        </MudAlert>
                    }
                }
                else
                {
                    <p class="policy-workbench__help">@L["Policy:Provenance:Help"]</p>
                    <MudForm @ref="_policyForm" @bind-IsValid="_policyInputsValid">
                        <div class="policy-comparison">
                            <table class="policy-table" aria-label="@L["Policy:Title"]">
                                <thead>
                                    <tr>
                                        <th scope="col">@L["Policy:Provenance:Field"]</th>
                                        <th scope="col">@L["Policy:Provenance:Declared"]</th>
                                        <th scope="col">@L["Policy:Provenance:Override"]</th>
                                        <th scope="col">@L["Policy:Provenance:Effective"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="@(_state.DisabledOverride.HasValue ? "is-overridden" : null)">
                                        <th scope="row">@L["Policy:Fields:Enabled"]</th>
                                        <td class="policy-table__declared" data-label="@L["Policy:Provenance:Declared"]">@EnabledLabel(!_state.Definition.Declaration.IsDisabledByDefault)</td>
                                        <td class="policy-table__override" data-label="@L["Policy:Provenance:Override"]">
                                            <div class="policy-enabled" role="group" aria-label="@L["Policy:Fields:Enabled"]">
                                                <button type="button" aria-pressed="@(_state.DisabledOverride is null ? "true" : "false")" disabled="@_isSaving" @onclick="@(() => SetDisabledOverride(null))">@L["Policy:InheritDefault"]</button>
                                                <button type="button" aria-pressed="@(_state.DisabledOverride is false ? "true" : "false")" disabled="@_isSaving" @onclick="@(() => SetDisabledOverride(false))">@L["Policy:ForceEnabled"]</button>
                                                <button type="button" aria-pressed="@(_state.DisabledOverride is true ? "true" : "false")" disabled="@_isSaving" @onclick="@(() => SetDisabledOverride(true))">@L["Policy:ForceDisabled"]</button>
                                            </div>
                                        </td>
                                        <td class="policy-table__effective" data-label="@L["Policy:Provenance:Effective"]">@EnabledLabel(!_state.EffectiveDisabled)</td>
                                    </tr>
                                    <tr class="@(_state.MaxConcurrencyOverride.HasValue ? "is-overridden" : null)">
                                        <th scope="row">@L["Policy:Fields:MaxConcurrency"]</th>
                                        <td class="policy-table__declared" data-label="@L["Policy:Provenance:Declared"]">@_state.Definition.Declaration.MaxConcurrency</td>
                                        <td class="policy-table__override" data-label="@L["Policy:Provenance:Override"]">
                                            <div class="policy-field">
                                                <div class="policy-field__input">
                                                    <MudNumericField T="int?" Value="@_state.MaxConcurrencyOverride" ValueChanged="SetMaxConcurrency" Converter="@_concurrencyConverter"
                                                                     Min="1" HideSpinButtons="true" Immediate="true"
                                                                     Error="@(_state.MaxConcurrencyOverride is < 1)"
                                                                     ErrorText="@L["Policy:Validation:NumericMinimum", L["Policy:Fields:MaxConcurrency"], 1]"
                                                                     Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isSaving"
                                                                     Placeholder="@L["Policy:InheritPlaceholder"]" aria-label="@L["Policy:Fields:MaxConcurrency"]" />
                                                </div>
                                                @if (_state.MaxConcurrencyOverride.HasValue)
                                                {
                                                    <MudIconButton Icon="@MoIcons.Restore" Size="Size.Small" Disabled="@_isSaving"
                                                                   OnClick="@(() => SetMaxConcurrency(null))" aria-label="@L["Policy:Actions:ResetField"]" title="@L["Policy:Actions:ResetField"]" />
                                                }
                                            </div>
                                        </td>
                                        <td class="policy-table__effective" data-label="@L["Policy:Provenance:Effective"]">@_state.EffectiveMaxConcurrency</td>
                                    </tr>
                                    <tr class="@(_state.RetryCountOverride.HasValue ? "is-overridden" : null)">
                                        <th scope="row">@L["Policy:Fields:RetryCount"]</th>
                                        <td class="policy-table__declared" data-label="@L["Policy:Provenance:Declared"]">@_state.Definition.Declaration.RetryCount</td>
                                        <td class="policy-table__override" data-label="@L["Policy:Provenance:Override"]">
                                            <div class="policy-field">
                                                <div class="policy-field__input">
                                                    <MudNumericField T="int?" Value="@_state.RetryCountOverride" ValueChanged="SetRetryCount" Converter="@_retryConverter"
                                                                     Min="0" HideSpinButtons="true" Immediate="true"
                                                                     Error="@(_state.RetryCountOverride is < 0)"
                                                                     ErrorText="@L["Policy:Validation:NumericMinimum", L["Policy:Fields:RetryCount"], 0]"
                                                                     Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isSaving"
                                                                     Placeholder="@L["Policy:InheritPlaceholder"]" aria-label="@L["Policy:Fields:RetryCount"]" />
                                                </div>
                                                @if (_state.RetryCountOverride.HasValue)
                                                {
                                                    <MudIconButton Icon="@MoIcons.Restore" Size="Size.Small" Disabled="@_isSaving"
                                                                   OnClick="@(() => SetRetryCount(null))" aria-label="@L["Policy:Actions:ResetField"]" title="@L["Policy:Actions:ResetField"]" />
                                                }
                                            </div>
                                        </td>
                                        <td class="policy-table__effective" data-label="@L["Policy:Provenance:Effective"]">@_state.EffectiveRetryCount</td>
                                    </tr>
                                    <tr class="@(TimeoutOverrideMinutes.HasValue ? "is-overridden" : null)">
                                        <th scope="row">@L["Policy:Fields:ExecutionTimeout"]</th>
                                        <td class="policy-table__declared" data-label="@L["Policy:Provenance:Declared"]">@FormatDuration(_state.Definition.Declaration.MaxExecutionTimeout)</td>
                                        <td class="policy-table__override" data-label="@L["Policy:Provenance:Override"]">
                                            <div class="policy-field">
                                                <div class="policy-field__input">
                                                    <MudNumericField T="decimal?" Value="@TimeoutOverrideMinutes" ValueChanged="SetTimeoutOverrideMinutes" Converter="@_timeoutConverter"
                                                                     HideSpinButtons="true" Immediate="true"
                                                                     Error="@(!IsTimeoutInputValid)" ErrorText="@L["Policy:Validation:Timeout"]"
                                                                     Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isSaving"
                                                                     Placeholder="@L["Policy:InheritPlaceholder"]" aria-label="@L["Policy:Fields:ExecutionTimeout"]" />
                                                </div>
                                                <span class="policy-field__unit">@L["Policy:Fields:Minutes"]</span>
                                                @if (TimeoutOverrideMinutes.HasValue)
                                                {
                                                    <MudIconButton Icon="@MoIcons.Restore" Size="Size.Small" Disabled="@_isSaving"
                                                                   OnClick="@(() => SetTimeoutOverrideMinutes(null))" aria-label="@L["Policy:Actions:ResetField"]" title="@L["Policy:Actions:ResetField"]" />
                                                }
                                            </div>
                                        </td>
                                        <td class="policy-table__effective" data-label="@L["Policy:Provenance:Effective"]">@(IsTimeoutInputValid ? FormatDuration(_state.EffectiveTimeout) : "—")</td>
                                    </tr>
                                    <tr class="@(_state.MaxRetainedHistoryRecords.HasValue ? "is-overridden" : null)">
                                        <th scope="row">@L["Policy:Fields:MaxRecords"]</th>
                                        <td class="policy-table__declared" data-label="@L["Policy:Provenance:Declared"]">@JobPolicy.DEFAULT_MAX_RETAINED_HISTORY_RECORDS</td>
                                        <td class="policy-table__override" data-label="@L["Policy:Provenance:Override"]">
                                            <div class="policy-field">
                                                <div class="policy-field__input">
                                                    <MudNumericField T="int?" Value="@_state.MaxRetainedHistoryRecords" ValueChanged="SetMaxRecords" Converter="@_recordCountConverter"
                                                                     Min="0" HideSpinButtons="true" Immediate="true"
                                                                     Error="@(_state.MaxRetainedHistoryRecords is < 0)"
                                                                     ErrorText="@L["Policy:Validation:NumericMinimum", L["Policy:Fields:MaxRecords"], 0]"
                                                                     Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isSaving"
                                                                     Placeholder="@L["Policy:InheritPlaceholder"]" aria-label="@L["Policy:Fields:MaxRecords"]" />
                                                </div>
                                                @if (_state.MaxRetainedHistoryRecords.HasValue)
                                                {
                                                    <MudIconButton Icon="@MoIcons.Restore" Size="Size.Small" Disabled="@_isSaving"
                                                                   OnClick="@(() => SetMaxRecords(null))" aria-label="@L["Policy:Actions:ResetField"]" title="@L["Policy:Actions:ResetField"]" />
                                                }
                                            </div>
                                            @if (_state.MaxRetainedHistoryRecords is 0)
                                            {
                                                <p class="policy-field__hint">@L["Policy:Retention:ZeroUnlimited"]</p>
                                            }
                                        </td>
                                        <td class="policy-table__effective" data-label="@L["Policy:Provenance:Effective"]">@(_state.EffectiveMaxRetainedHistoryRecords == 0 ? L["Policy:Values:NoLimit"].Value : _state.EffectiveMaxRetainedHistoryRecords.ToString())</td>
                                    </tr>
                                    <tr class="@(_state.MaxRetentionDays.HasValue ? "is-overridden" : null)">
                                        <th scope="row">@L["Policy:Fields:MaxDays"]</th>
                                        <td class="policy-table__declared" data-label="@L["Policy:Provenance:Declared"]">@L["Policy:Values:NoLimit"]</td>
                                        <td class="policy-table__override" data-label="@L["Policy:Provenance:Override"]">
                                            <div class="policy-field">
                                                <div class="policy-field__input">
                                                    <MudNumericField T="int?" Value="@_state.MaxRetentionDays" ValueChanged="SetMaxRetentionDays" Converter="@_retentionDaysConverter"
                                                                     Min="1" HideSpinButtons="true" Immediate="true"
                                                                     Error="@(_state.MaxRetentionDays is < 1)"
                                                                     ErrorText="@L["Policy:Validation:NumericMinimum", L["Policy:Fields:MaxDays"], 1]"
                                                                     Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_isSaving"
                                                                     Placeholder="@L["Policy:InheritPlaceholder"]" aria-label="@L["Policy:Fields:MaxDays"]" />
                                                </div>
                                                @if (_state.MaxRetentionDays.HasValue)
                                                {
                                                    <MudIconButton Icon="@MoIcons.Restore" Size="Size.Small" Disabled="@_isSaving"
                                                                   OnClick="@(() => SetMaxRetentionDays(null))" aria-label="@L["Policy:Actions:ResetField"]" title="@L["Policy:Actions:ResetField"]" />
                                                }
                                            </div>
                                        </td>
                                        <td class="policy-table__effective" data-label="@L["Policy:Provenance:Effective"]">@(_state.EffectiveMaxRetentionDays is { } days ? L["Policy:Values:Days", days] : L["Policy:Values:NoLimit"])</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </MudForm>
                    <div class="policy-workbench__notice">
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Info">
                            @L["Policy:Execution:ProspectiveNotice"]
                        </MudAlert>
                    </div>
                    <p class="policy-workbench__scope">@L["Policy:ScopeNote"]</p>
                }

                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">@_error</MudAlert>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <div class="policy-workbench__actions @(ScheduleOnly ? "policy-workbench__actions--cron" : null)">
            <MudText Typo="Typo.caption" aria-live="polite">
                @(ScheduleOnly
                    ? _state?.HasChanges == true ? L["Policy:UnsavedChanges"] : L["Policy:NoChanges"]
                    : PolicyChangeCount > 0 ? L["Policy:ChangedCount", PolicyChangeCount] : L["Policy:NoChanges"])
            </MudText>
            <div>
                <MudButton Variant="Variant.Text" Disabled="@_isSaving" OnClick="Cancel">@L["Common:Cancel"]</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@MoIcons.Save"
                           Disabled="@(_isSaving || !CanSaveDraft || (!ScheduleOnly && (!IsTimeoutInputValid || !_policyInputsValid)))"
                           OnClick="SaveAsync">
                    @(_isSaving ? L["Common:Saving"] : L[ScheduleOnly ? "Workspace:SaveCron" : "Common:Save"])
                </MudButton>
            </div>
        </div>
    </DialogActions>
</MudDialog>
