<span class="status is-pill role-@Role @Class" title="@Title">
    <span aria-hidden="true" class="status-dot @(Diamond ? "is-diamond" : null) @(Live ? "is-live" : null)"></span>
    @ChildContent
</span>

@code {
    [Parameter] public string Role { get; set; } = "neutral";
    [Parameter] public bool Diamond { get; set; }
    [Parameter] public bool Live { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
