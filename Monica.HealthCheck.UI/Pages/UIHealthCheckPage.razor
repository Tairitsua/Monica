@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@attribute [Route(PAGE_URL)]
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject HealthCheckPageSessionFactory SessionFactory
@inject PageAccessEvaluator PageAccess
@inject IStringLocalizer<HealthCheckResource> L

<PageTitle>@L["Page:Title"]</PageTitle>

<div class="mo-workbench-container">
<div class="health-page mo-page-shell mo-page-shell--workbench">
    @if (!_accessChecked)
    {
        <div class="health-page-state" role="status">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1">@L["Access:Checking"]</MudText>
        </div>
    }
    else if (!_isAuthorized || _session?.IsAccessDenied == true)
    {
        <div class="health-page-state" role="alert">
            <MoIcon Icon="@MoIcons.Lock" Size="2.25rem" Style="color:var(--mud-palette-warning);" />
            <MudText Typo="Typo.h5">@L["Access:DeniedTitle"]</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">@L["Access:DeniedDescription"]</MudText>
        </div>
    }
    else if (_session is { } session)
    {
        <div class="health-workspace">
            <MoPageMasthead Icon="@MoIcons.HeartPulse" Title="@L["Design:Title"]" Crumb="@L["Design:Eyebrow"]" Meta="@Metadata(session)">

                <Actions>
                    @if (session.Snapshot is { } snapshot)
                    {
                        <div class="health-last-check"><span>@L[session.RefreshError is null ? "Page:LastChecked" : "Page:StaleChecked"]</span><time datetime="@snapshot.CheckedAt.ToString("O")" title="@UiTime.Format(snapshot.CheckedAt)">@UiTime.FormatTime(snapshot.CheckedAt)</time></div>
                        var pauseLabel = L[session.Paused ? "Design:ResumeAuto" : "Design:PauseAuto"];
                        <MudButton Class="hc-pause-button" Variant="Variant.Outlined" StartIcon="@(session.Paused ? MoIcons.Play : MoIcons.Pause)"
                                   aria-pressed="@(session.Paused ? "true" : "false")" aria-label="@pauseLabel" title="@pauseLabel"
                                   OnClick="@(() => session.SetPausedAsync(!session.Paused))"><span>@pauseLabel</span></MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Refresh" Disabled="@session.IsRefreshing" OnClick="@(() => RefreshAsync(session))">@L["Actions:Refresh"]</MudButton>
                </Actions>
            </MoPageMasthead>
            <HealthWorkbenchNav Attention="@RoleAttention(session)" />

            @if (session.RefreshError is { } refreshError)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Warning">
                    @L["State:RefreshFailed", refreshError]
                </MudAlert>
            }

            @switch (session.LoadState)
            {
                case HealthCheckPageLoadState.InitialLoading:
                    <div class="health-page-state" role="status">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">@L["State:Loading"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["State:LoadingDescription"]</MudText>
                    </div>
                    break;
                case HealthCheckPageLoadState.Failed:
                    <div class="health-page-state" role="alert">
                        <MoIcon Icon="@MoIcons.CloudOff" Size="2.25rem" Style="color:var(--mud-palette-error);" />
                        <MudText Typo="Typo.h6">@L["State:LoadFailed"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@session.LoadError</MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@MoIcons.Refresh"
                                   OnClick="@(() => RefreshAsync(session))">
                            @L["Actions:Retry"]
                        </MudButton>
                    </div>
                    break;
                case HealthCheckPageLoadState.Ready when session.Snapshot is not null:
                    <div class="health-page-content">
                        <HealthCheckOverview Session="@session" EntryName="@Entry" />
                        <HealthCheckEntryTable Session="@session" EntryName="@Entry" />
                    </div>
                    break;
            }

            <HealthCheckEntryDrawer Session="@session" EntryName="@Entry" />
        </div>
    }
</div>
</div>

@code {
    public const string PAGE_URL = "/health-checks";

    private static int RoleAttention(HealthCheckPageSession session)
    {
        var gate = session.Snapshot?.Entries.FirstOrDefault(entry => entry.Name == "monica.application.roles");
        return int.TryParse(gate?.Data.GetValueOrDefault("attentionCount"), out var count) ? count : 0;
    }

    [SupplyParameterFromQuery(Name = "q")] public string? Search { get; set; }
    [SupplyParameterFromQuery] public string? Status { get; set; }
    [SupplyParameterFromQuery] public string? Tag { get; set; }
    [SupplyParameterFromQuery] public string? Probe { get; set; }
    [SupplyParameterFromQuery] public string? Sort { get; set; }
    [SupplyParameterFromQuery] public string? Entry { get; set; }

    private RenderFragment Metadata(HealthCheckPageSession session) => @<text>
        @if (session.Snapshot is { } snapshot)
        {
            @if (session.RefreshError is not null || session.Paused)
            {
                var role = session.RefreshError is not null ? MoVisualRole.Warning : MoVisualRole.Neutral;
                <span class="mo-vl-status mo-vl-status--pill @role.ToCssClass()">
                    <i class="mo-vl-status-dot" aria-hidden="true"></i>@L[session.RefreshError is not null ? "Design:AutoRefreshStale" : "Design:AutoRefreshPaused"]
                </span>
            }
            else
            {
                <HealthCheckRefreshCountdown Session="@session" />
            }
            <button class="mo-vl-capsule mo-vl-capsule--outline mo-vl-role--neutral health-host" type="button"
                    title="@session.HostName" aria-label="@L["Design:CopyHost", session.HostName]" @onclick="@(() => CopyHostAsync(session.HostName))">
                <MoIcon Icon="@MoIcons.Server" Size="13px" /><span>@session.HostName</span><MoIcon Icon="@MoIcons.Copy" Size="13px" />
            </button>
            <span title="@UiTime.TimeZone.Id">@UiTime.FormatZoneLabel(snapshot.CheckedAt)</span>
        }
    </text>;
    protected override void OnParametersSet() => _session?.ApplyRoute(Search, Status, Tag, Probe, Sort);
    private Task CopyHostAsync(string value) => JS.InvokeVoidAsync("navigator.clipboard.writeText", value).AsTask();
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private HealthCheckPageSession? _session;
    private bool _accessChecked;
    private bool _isAuthorized;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        bool isAuthorized;
        try
        {
            isAuthorized = await PageAccess.IsAuthorizedAsync(PAGE_URL, _lifetimeCancellation.Token);
        }
        catch (OperationCanceledException) when (_lifetimeCancellation.IsCancellationRequested)
        {
            return;
        }

        if (_disposed)
        {
            return;
        }

        _isAuthorized = isAuthorized;
        _accessChecked = true;
        if (!isAuthorized)
        {
            return;
        }

        var session = SessionFactory.Create(
            cancellationToken => PageAccess.IsAuthorizedAsync(PAGE_URL, cancellationToken));
        _session = session;
        session.Changed += HandleSessionChangedAsync;
        await session.InitializeAsync();
    }

    private Task HandleSessionChangedAsync()
    {
        return InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private static Task RefreshAsync(HealthCheckPageSession session) => session.RefreshAsync();

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        await _lifetimeCancellation.CancelAsync();
        var session = _session;
        _session = null;
        if (session is null)
        {
            _lifetimeCancellation.Dispose();
            return;
        }

        session.Changed -= HandleSessionChangedAsync;
        await session.DisposeAsync();
        _lifetimeCancellation.Dispose();
    }
}
