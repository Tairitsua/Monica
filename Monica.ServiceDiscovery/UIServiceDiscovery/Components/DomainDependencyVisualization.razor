@using Monica.UI.Shared.Components.States
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.ServiceDiscovery.Facades
@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Support
@using Monica.Core.Results;
@using Monica.UI.Shared.Components.ContextMenu
@inject ServiceDiscoveryFacade ServiceDiscoveryFacade
@inject ServiceDiscoveryDomainColorResolver DomainColorResolver
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<ServiceDiscoveryResource> L
@implements IAsyncDisposable

<section class="domain-discovery-visual discovery-atlas" aria-busy="@(_loading ? "true" : "false")">
    @if (_hasSnapshot && !_topology.IsAvailable)
    {
        <MudAlert Severity="Severity.Info">@L["Atlas:Domains:Unavailable"]</MudAlert>
    }
    <header class="atlas-heading">
        <div class="atlas-heading__identity"><span class="atlas-kicker">@L["Atlas:Domains:Eyebrow"]</span><h2>@L["DomainGraph:Title"]</h2><p>@L["Atlas:Domains:Description"]</p></div>
        <div class="atlas-actions">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@MoIcons.Refresh" OnClick="LoadDomainDataAsync" Disabled="@_loading">@L["Shared:Actions:Refresh"]</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@MoIcons.Sliders" OnClick="ToggleLayoutPanel" aria-expanded="@(_showLayoutPanel ? "true" : "false")">@L["Atlas:Shared:Layout"]</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@MoIcons.Filter" OnClick="ToggleFilterPanel" aria-expanded="@(_showFilterPanel ? "true" : "false")">@L["Atlas:Shared:Filters"]</MudButton>
        </div>
    </header>
    @if (_captureError is not null)
    {
        <div class="atlas-notice atlas-notice--error" role="alert"><MoIcon Icon="@MoIcons.Error" Size="1.25rem" />
            <div><strong>@L[_hasSnapshot ? "Atlas:Shared:RetainedSnapshot" : "Atlas:Shared:CaptureFailed"]</strong><p>@_captureError</p></div></div>
    }
    @if (_showLayoutPanel)
    {
        <div class="atlas-shelf"><DomainLayoutPanel CurrentLayout="_currentLayout" ForceDistance="_forceDistance" ForceStrength="_forceStrength"
            CurrentLayoutChanged="OnLayoutChanged" ForceDistanceChanged="OnForceDistanceChanged" ForceStrengthChanged="OnForceStrengthChanged" /></div>
    }
    @if (_showFilterPanel)
    {
        <div class="atlas-shelf"><DomainFilterPanel @ref="_filterPanel" @bind-FilterText="_filterText" @bind-SelectedDomains="_selectedDomainsFilter"
            @bind-ShowOnlyWithServices="_showOnlyWithServices" @bind-ShowOnlyWithDependencies="_showOnlyWithDependencies"
            DomainSelectionIntentChanged="OnDomainSelectionIntentChanged" OnFiltersChanged="ApplyFilters" AllDomains="_domains" /></div>
    }
    <div class="atlas-workspace">
        <section class="atlas-map" aria-label="@L["Atlas:Domains:MapLabel"]">
            <header class="atlas-map__bar"><div><span class="atlas-scope">@L["Atlas:Domains:MapLabel"]</span><strong>@(_hasSnapshot ? L["Atlas:Domains:MapSummary", _filteredDomains.Count, _domains.Count, _filteredDependencies.Count, _dependencies.Count] : L["Shared:Values:NotAvailable"])</strong></div>
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@MoIcons.Focus" OnClick="ResetView" Disabled="@(!_graphAvailable)">@L["Atlas:Shared:FitView"]</MudButton></header>
            <div class="atlas-map__stage">
                <div id="@_graphContainerId" class="domain-discovery-visual__canvas" aria-hidden="true" @onclick="OnBackgroundClick" @oncontextmenu:preventDefault="true"></div>
                @if (_loading && !_hasSnapshot)
                {
                    <div class="atlas-map__state" role="status"><MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" /><strong>@L["Atlas:Shared:Loading"]</strong></div>
                }
                else if (_graphError is not null)
                {
                    <div class="atlas-map__state" role="status"><MoIcon Icon="@MoIcons.Workflow" Size="1.5rem" /><strong>@L["Atlas:Shared:GraphUnavailable"]</strong><p>@L["Atlas:Shared:NativeAlternative"]</p></div>
                }
                else if (!_hasSnapshot && _captureError is not null)
                {
                    <div class="atlas-map__state" role="status"><strong>@L["Atlas:Shared:CaptureFailed"]</strong><p>@L["Atlas:Shared:RetryHint"]</p></div>
                }
                else if (_hasSnapshot && _filteredDomains.Count == 0)
                {
                    <div class="atlas-map__state" role="status"><MoIcon Icon="@MoIcons.Network" Size="1.5rem" /><strong>@L[_domains.Count == 0 ? "Atlas:Domains:Empty" : "Atlas:Shared:FilterMiss"]</strong><p>@L[_domains.Count == 0 ? "Atlas:Domains:EmptyHint" : "Atlas:Shared:FilterMissHint"]</p>
                        @if (_domains.Count > 0) { <MudButton OnClick="@(() => ClearAllFiltersAsync(null))" Color="Color.Primary">@L["Shared:Actions:Clear"]</MudButton> }
                    </div>
                }
                @if (_loading && _hasSnapshot) { <div class="atlas-refreshing" role="status">@L["Atlas:Shared:Refreshing"]</div> }
            </div>
            <footer class="atlas-map__footer"><p>@L["Atlas:Domains:EdgeHint"]</p>
                @if (_unassignedServices.Count > 0) { <p class="atlas-map__scope-note">@L["Atlas:Domains:UnassignedScope", _unassignedServices.Count]</p> }
                <span>@L["Atlas:Shared:GestureHint"]</span></footer>
        </section>
        <section class="atlas-native" aria-label="@L["Atlas:Domains:Evidence"]">
            <header class="atlas-native__heading"><div><span class="atlas-kicker">@L["Atlas:Shared:NativeEvidence"]</span><h3>@L["Atlas:Domains:Evidence"]</h3></div><span class="atlas-native__count">@(_hasSnapshot ? NativeEvidenceCount.ToString() : L["Shared:Values:NotAvailable"].Value)</span></header>
            <div class="atlas-native__tabs" role="group" aria-label="@L["Atlas:Domains:Evidence"]">
                <button type="button" aria-pressed="@(_nativeView == NativeEvidenceView.Declarations ? "true" : "false")" @onclick="@(() => _nativeView = NativeEvidenceView.Declarations)">@L["Atlas:Domains:Ledger"]</button>
                <button type="button" aria-pressed="@(_nativeView == NativeEvidenceView.Domains ? "true" : "false")" @onclick="@(() => _nativeView = NativeEvidenceView.Domains)">@L["Atlas:Domains:Roster"]</button>
                <button type="button" aria-pressed="@(_nativeView == NativeEvidenceView.Unassigned ? "true" : "false")" @onclick="@(() => _nativeView = NativeEvidenceView.Unassigned)">@L["Atlas:Domains:Unassigned"] <span>@_unassignedServices.Count</span></button>
            </div>
            <p class="atlas-native__intro">@L[NativeEvidenceHintKey]</p>
            @if (_nativeView == NativeEvidenceView.Domains)
            {
                <ul class="atlas-roster">
                    @foreach (var domain in _filteredDomains.OrderBy(d => d.DisplayName ?? d.Id, StringComparer.CurrentCultureIgnoreCase))
                    {
                        <li @key="domain.Id" class="atlas-roster__row">
                            <button type="button" class="atlas-record" @onclick="@(() => ViewDomainDetailsAsync(domain.Id))">
                                <span class="atlas-record__name">@(domain.DisplayName ?? domain.Id)</span><code>@domain.Id</code>
                                <span class="atlas-record__meta">@L["Atlas:Domains:ServiceCount", _domainServicesMap.GetValueOrDefault(domain.Id)?.Count ?? 0]</span>
                                @if (_unlistedDomains.Contains(domain.Id)) { <span class="atlas-unlisted">@L["Atlas:Domains:Unlisted"]</span> }
                            </button>
                            <div class="atlas-record__actions">
                                <MudTooltip Text="@L["DomainGraph:ContextMenu:FocusDomain"]"><MudIconButton Icon="@MoIcons.Focus" Size="Size.Small" aria-label="@L["DomainGraph:ContextMenu:FocusDomain"]" Disabled="@(!_graphAvailable)" OnClick="@(() => FocusOnDomainAsync(domain.Id))" /></MudTooltip>
                                <MudMenu Icon="@MoIcons.MoreHorizontal" Size="Size.Small" AriaLabel="@L["Atlas:Shared:RecordActions", domain.Id]">
                                    <MudMenuItem OnClick="@(() => ViewDomainDetailsAsync(domain.Id))">@L["DomainGraph:ContextMenu:ViewDomainDetails"]</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => FilterByDomainAsync(domain.Id))">@L["DomainGraph:ContextMenu:FilterDomainServices"]</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => ShowDependenciesAsync(domain.Id))">@L["DomainGraph:ContextMenu:ShowDependencies"]</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => ClearAllFiltersAsync(domain.Id))">@L["DomainGraph:ContextMenu:ClearFilters"]</MudMenuItem>
                                    <MudMenuItem OnClick="@(() => CopyDomainNameAsync(domain.Id))">@L["DomainGraph:ContextMenu:CopyDomainName"]</MudMenuItem>
                                </MudMenu>
                            </div>
                        </li>
                    }
                </ul>
            }
            else if (_nativeView == NativeEvidenceView.Declarations)
            {
                <ol class="atlas-ledger">
                    @foreach (var dependency in _filteredDependencies.OrderBy(d => d.SourceDomain, StringComparer.Ordinal).ThenBy(d => d.TargetDomain, StringComparer.Ordinal))
                    {
                        <li class="atlas-ledger__row">
                            <div class="atlas-ledger__direction"><button type="button" @onclick="@(() => ViewDomainDetailsAsync(dependency.SourceDomain))">@dependency.SourceDomain</button><span aria-hidden="true">→</span><button type="button" @onclick="@(() => ViewDomainDetailsAsync(dependency.TargetDomain))">@dependency.TargetDomain</button></div>
                            <details>
                                <summary>@L["Atlas:Domains:Declarations", dependency.Evidence.Count]</summary>
                                <ul>@foreach (var evidence in dependency.Evidence)
                                {
                                    <li><span>@(evidence.SourceRoleId ?? evidence.SourceDomainId) → @evidence.TargetRoleId</span><code>@evidence.SourceType</code><span aria-hidden="true">→</span><code>@evidence.Operation</code></li>
                                }</ul>
                            </details>
                            @if (_unlistedDomains.Contains(dependency.SourceDomain) || _unlistedDomains.Contains(dependency.TargetDomain)) { <span class="atlas-unlisted">@L["Atlas:Domains:UnlistedEdge"]</span> }
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ShowDependenciesAsync(dependency.SourceDomain))">@L["Atlas:Domains:FocusRelationship"]</MudButton>
                        </li>
                    }
                </ol>
            }
            else
            {
                <ul class="atlas-unassigned-services">
                    @foreach (var service in _unassignedServices.OrderBy(s => s.AppName, StringComparer.CurrentCultureIgnoreCase))
                    {
                        var targets = GetDeclaredTargets(service);
                        <li @key="service.AppId" class="atlas-unassigned-service">
                            <strong>@service.AppName</strong><code>@service.AppId</code>
                            <span class="atlas-record__meta">@L["Atlas:Domains:NoOwner"] · @L["Atlas:Services:InstanceCount", service.TotalInstanceCount]</span>
                            @if (targets.Count == 0)
                            {
                                <p>@L["Atlas:Domains:NoUnassignedDeclarations"]</p>
                            }
                            else
                            {
                                <ul class="atlas-unassigned-declarations" aria-label="@L["Atlas:Domains:UnassignedDeclarations"]">
                                    @foreach (var target in targets)
                                    {
                                        <li><code>@service.AppId</code><span aria-hidden="true">→</span><button type="button" @onclick="@(() => ViewDomainDetailsAsync(target))">@target</button></li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            }
            @if (_hasSnapshot && NativeEvidenceCount == 0) { <MoContentState Compact="true"><p>@L[NativeEvidenceEmptyKey]</p></MoContentState> }
            <footer class="atlas-native__footer"><span>@L["Atlas:Shared:Captured"]</span><time>@(UiTime.FormatTime(_capturedAt) ?? L["Shared:Values:NotAvailable"].Value)</time></footer>
        </section>
    </div>
    <div class="atlas-legend"><span class="atlas-domain-key"><span class="atlas-domain-key__sample"></span>@L["Atlas:Domains:CatalogNode"]</span><span class="atlas-domain-key"><span class="atlas-domain-key__sample atlas-domain-key__sample--unlisted"></span>@L["Atlas:Domains:Unlisted"]</span><span class="atlas-legend__note">@L["Atlas:Domains:SnapshotHint"]</span></div>
</section>

@* Context menu *@
<MoContextMenu TItem="string" 
               Items="@_contextMenuItems" 
               Visible="@_contextMenuOpen"
               InitialX="@_contextMenuX" 
               InitialY="@_contextMenuY"
               ContextItem="@_contextMenuDomainName"
               OpeningRevision="@_contextMenuOpeningRevision"
               OnItemClick="@OnContextMenuItemClick"
               OnClose="@CloseContextMenu" />

@code {
    [Parameter] public EventCallback<string> OnDomainClick { get; set; }

    private const string JS_MODULE_PATH = "./_content/Monica.ServiceDiscovery/UIServiceDiscovery/domainDependencyGraph.js";
    private long _contextMenuOpeningRevision;
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly SemaphoreSlim _captureGate = new(1, 1);
    private readonly SemaphoreSlim _interopGate = new(1, 1);
    private readonly object _disposeSync = new();
    private readonly string _graphContainerId = $"domain-dependency-graph-{Guid.NewGuid():N}";
    private IJSObjectReference? _graphController;
    private DotNetObjectReference<DomainDependencyVisualization>? _dotNetReference;
    private DomainFilterPanel? _filterPanel;
    private Task? _disposeTask;
    private List<DomainInfo> _domains = [];
    private List<DomainInfo> _filteredDomains = [];
    private List<DomainDependency> _dependencies = [];
    private List<DomainDependency> _filteredDependencies = [];
    private Dictionary<string, List<RegisteredServiceStatus>> _domainServicesMap = new(StringComparer.Ordinal);
    private bool _loading = true;
    private bool _hasSnapshot;
    private ApplicationTopologySnapshot _topology = new(false, []);
    private bool _graphAvailable;
    private NativeEvidenceView _nativeView;
    private List<RegisteredServiceStatus> _unassignedServices = [];
    private bool _allDomainsSelected = true;
    private string? _captureError;
    private string? _graphError;
    private DateTimeOffset? _capturedAt;
    private readonly HashSet<string> _unlistedDomains = new(StringComparer.Ordinal);
    
    // Filter-related fields
    private bool _showFilterPanel = false;
    private bool _showLayoutPanel = false;
    private string _filterText = string.Empty;
    private IReadOnlyCollection<string> _selectedDomainsFilter = new HashSet<string>();
    private bool _showOnlyWithServices = false;
    private bool _showOnlyWithDependencies = false;
    
    // Layout-related fields
    private DomainLayoutType _currentLayout = DomainLayoutType.Force;
    private int _forceDistance = 200;
    private int _forceStrength = -800;
    
    // Context-menu-related fields
    private bool _contextMenuOpen = false;
    private double _contextMenuX = 0;
    private double _contextMenuY = 0;
    private string? _contextMenuDomainName;
    private List<ContextMenuItem<string>> _contextMenuItems = new();
    private volatile bool _disposed;

    protected override Task OnInitializedAsync() => LoadDomainDataAsync(initialLoad: true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await InitializeGraphAsync();
            if (!_disposed)
            {
                _graphAvailable = true;
                await UpdateGraph();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (JSDisconnectedException) when (_disposed) { }
        catch (JSException)
        {
            if (!_disposed)
            {
                _graphError = L["Atlas:Shared:GraphUnavailable"].Value;
                StateHasChanged();
            }
        }
    }

    private async Task InitializeGraphAsync()
    {
        await _interopGate.WaitAsync(_lifetimeCancellation.Token);

        IJSObjectReference? module = null;
        IJSObjectReference? graphController = null;
        DotNetObjectReference<DomainDependencyVisualization>? dotNetReference = null;
        try
        {
            module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                JS_MODULE_PATH);

            if (_disposed)
            {
                return;
            }

            var isDarkMode = await JSRuntime.InvokeAsync<bool>(
                "eval",
                _lifetimeCancellation.Token,
                "document.documentElement.classList.contains('dark')");

            dotNetReference = DotNetObjectReference.Create(this);
            graphController = await module.InvokeAsync<IJSObjectReference>(
                "createGraph",
                _graphContainerId,
                isDarkMode,
                dotNetReference,
                GetGraphTexts());

            if (_disposed)
            {
                return;
            }

            _graphController = graphController;
            _dotNetReference = dotNetReference;
            graphController = null;
            dotNetReference = null;
        }
        finally
        {
            await DisposeGraphControllerAsync(graphController);
            dotNetReference?.Dispose();
            await ReleaseModuleReferenceAsync(module);

            _interopGate.Release();
        }
    }

    private Task LoadDomainDataAsync() => LoadDomainDataAsync(initialLoad: false);

    private async Task LoadDomainDataAsync(bool initialLoad)
    {
        if (_disposed || (_loading && !initialLoad)) return;
        var ownsCapture = false;
        try
        {
            ownsCapture = await _captureGate.WaitAsync(0, _lifetimeCancellation.Token);
            if (!ownsCapture || _disposed) return;
            _loading = true;
            _captureError = null;
            if (!initialLoad) StateHasChanged();

            var domainResult = await ServiceDiscoveryFacade.CaptureDomainsAsync(_lifetimeCancellation.Token);
            if (_disposed) return;
            if (domainResult.IsFailed(out var domainError, out var domains))
            {
                _captureError = domainError.Message ?? L["Atlas:Shared:CaptureFailed"].Value;
                return;
            }
            var serviceResult = await ServiceDiscoveryFacade.CaptureServicesAsync(_lifetimeCancellation.Token);
            if (_disposed) return;
            if (serviceResult.IsFailed(out var serviceError, out var services))
            {
                _captureError = serviceError.Message ?? L["Atlas:Shared:CaptureFailed"].Value;
                return;
            }

            var topologyResult = await ServiceDiscoveryFacade.CaptureTopologyAsync(_lifetimeCancellation.Token);
            if (_disposed) return;
            if (topologyResult.IsFailed(out var topologyError, out var topology))
            {
                _captureError = topologyError.Message ?? L["Atlas:Shared:CaptureFailed"].Value;
                return;
            }
            _domains = (domains ?? []).GroupBy(d => d.Id, StringComparer.Ordinal).Select(g => g.First()).ToList();
            _unassignedServices = (services ?? []).Where(service => !service.GetDomainNames().Any()).ToList();
            BuildDomainServicesMap(services ?? []);
            _topology = topology!;
            BuildDomainDependencies();
            AddUnlistedEndpoints();
            DomainColorResolver.AssignColors(_domains);
            if (_allDomainsSelected)
            {
                _selectedDomainsFilter = _domains.Select(d => d.Id).ToList();
            }
            _hasSnapshot = true;
            _capturedAt = DateTimeOffset.UtcNow;
            await ApplyFilters();
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception ex)
        {
            if (!_disposed) _captureError = L["DomainGraph:Messages:LoadFailed", ex.Message].Value;
        }
        finally
        {
            if (ownsCapture)
            {
                _loading = false;
                _captureGate.Release();
                if (!_disposed) StateHasChanged();
            }
        }
    }

    private void BuildDomainDependencies()
    {
        _dependencies = _topology.Dependencies
            .Where(dependency => dependency.SourceDomainId != dependency.TargetDomainId)
            .GroupBy(dependency => (dependency.SourceDomainId, dependency.TargetDomainId))
            .Select(group => new DomainDependency
            {
                SourceDomain = group.Key.SourceDomainId,
                TargetDomain = group.Key.TargetDomainId,
                Evidence = group.ToList()
            }).ToList();
    }

    private void AddUnlistedEndpoints()
    {
        _unlistedDomains.Clear();
        var known = _domains.Select(d => d.Id).ToHashSet(StringComparer.Ordinal);
        var endpoints = _domainServicesMap.Keys.Concat(_dependencies.SelectMany(d => new[] { d.SourceDomain, d.TargetDomain }))
            .Concat(_unassignedServices.SelectMany(GetDeclaredTargets));
        foreach (var name in endpoints.Distinct(StringComparer.Ordinal))
        {
            if (known.Add(name))
            {
                _unlistedDomains.Add(name);
                _domains.Add(new DomainInfo { Id = name, DisplayName = name, Description = L["Atlas:Domains:UnlistedDescription"].Value });
            }
        }
        var canonical = _domains.ToDictionary(d => d.Id, d => d.Id, StringComparer.Ordinal);
        foreach (var dependency in _dependencies)
        {
            dependency.SourceDomain = canonical[dependency.SourceDomain];
            dependency.TargetDomain = canonical[dependency.TargetDomain];
        }
    }

    private void BuildDomainServicesMap(List<RegisteredServiceStatus> services)
    {
        _domainServicesMap.Clear();
        
        foreach (var service in services)
        foreach (var domainName in service.GetDomainNames())
        {
            if (!_domainServicesMap.ContainsKey(domainName))
            {
                _domainServicesMap[domainName] = new List<RegisteredServiceStatus>();
            }
            _domainServicesMap[domainName].Add(service);
        }
    }

    [JSInvokable]
    public async Task OnDomainClickFromJS(string domainName)
    {
        if (_disposed)
        {
            return;
        }

        await ViewDomainDetailsAsync(domainName);
    }
    
    [JSInvokable]
    public void OnDomainRightClick(string domainName, double x, double y)
    {
        if (_disposed)
        {
            return;
        }

        _contextMenuDomainName = domainName;
        _contextMenuX = x;
        _contextMenuY = y;
        _contextMenuItems = BuildContextMenuItems(domainName);
        ++_contextMenuOpeningRevision;
        _contextMenuOpen = true;
        StateHasChanged();
    }
    
    private void OnBackgroundClick()
    {
        if (_contextMenuOpen)
        {
            _contextMenuOpen = false;
            StateHasChanged();
        }
    }
    
    [JSInvokable]
    public void OnSvgBackgroundClick()
    {
        if (_disposed)
        {
            return;
        }

        if (_contextMenuOpen)
        {
            _contextMenuOpen = false;
            StateHasChanged();
        }
    }
    
    private void CloseContextMenu()
    {
        if (_disposed) return;
        _contextMenuOpen = false;
    }
    
    private List<ContextMenuItem<string>> BuildContextMenuItems(string domainName)
    {
        var domain = _domains.FirstOrDefault(d => d.Id == domainName);
        var hasServices = _domainServicesMap.ContainsKey(domainName) && _domainServicesMap[domainName].Any();
        var hasDependencies = _dependencies.Any(d => d.SourceDomain == domainName || d.TargetDomain == domainName);
        
        var builder = ContextMenuBuilder<string>.Create()
            .AddItem(L["DomainGraph:ContextMenu:ViewDomainDetails"].Value, MoIcons.Info, ViewDomainDetailsAsync)
            .AddItem(L["DomainGraph:ContextMenu:FocusDomain"].Value, MoIcons.Focus, FocusOnDomainAsync)
            .AddDivider()
            .AddItemIf(hasServices, L["DomainGraph:ContextMenu:FilterDomainServices"].Value, MoIcons.Filter, FilterByDomainAsync)
            .AddItemIf(hasDependencies, L["DomainGraph:ContextMenu:ShowDependencies"].Value, MoIcons.Workflow, ShowDependenciesAsync)
            .AddItem(L["DomainGraph:ContextMenu:ClearFilters"].Value, MoIcons.ClearList, ClearAllFiltersAsync)
            .AddDivider()
            .AddItem(L["DomainGraph:ContextMenu:CopyDomainName"].Value, MoIcons.Copy, CopyDomainNameAsync);
        
        return builder.Build();
    }
    
    private Task OnContextMenuItemClick(ContextMenuItem<string> item)
    {
        if (_disposed) return Task.CompletedTask;
        _contextMenuOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }
    
    private async Task ViewDomainDetailsAsync(string? domainName)
    {
        if (_disposed) return;
        var domain = _domains.FirstOrDefault(d => string.Equals(d.Id, domainName, StringComparison.Ordinal));
        if (domain is null) return;
        if (!_unlistedDomains.Contains(domain.Id) && OnDomainClick.HasDelegate)
        {
            await OnDomainClick.InvokeAsync(domain.Id);
            return;
        }
        await FocusOnDomainAsync(domain.Id);
        if (!_disposed) Snackbar.Add(L["Atlas:Domains:UnlistedSummary", domain.Id].Value, Severity.Info);
    }

    private async Task FocusOnDomainAsync(string? domainName)
    {
        if (!string.IsNullOrEmpty(domainName))
        {
            await InvokeGraphAsync("focusOnNode", domainName);
        }
    }
    
    private async Task FilterByDomainAsync(string? domainName)
    {
        if (!_disposed && !string.IsNullOrEmpty(domainName))
        {
            _allDomainsSelected = false;
            _selectedDomainsFilter = new HashSet<string> { domainName };
            _showFilterPanel = true;
            await ApplyFilters();
            if (!_disposed) Snackbar.Add(L["DomainGraph:Messages:FilteredDomain", domainName].Value, Severity.Info);
        }
    }
    
    private async Task ShowDependenciesAsync(string? domainName)
    {
        if (!_disposed && !string.IsNullOrEmpty(domainName))
        {
            var relatedDomains = new HashSet<string> { domainName };
            var domainDeps = _dependencies.Where(d => d.SourceDomain == domainName || d.TargetDomain == domainName);
            
            foreach (var dep in domainDeps)
            {
                relatedDomains.Add(dep.SourceDomain);
                relatedDomains.Add(dep.TargetDomain);
            }
            
            _selectedDomainsFilter = relatedDomains;
            _allDomainsSelected = false;
            _showOnlyWithDependencies = true;
            _showFilterPanel = true;
            await ApplyFilters();
            if (!_disposed) Snackbar.Add(L["DomainGraph:Messages:ShowingDependencies", domainName].Value, Severity.Info);
        }
    }
    
    private async Task ClearAllFiltersAsync(string? domainName)
    {
        if (_disposed) return;
        _filterText = string.Empty;
        _allDomainsSelected = true;
        _selectedDomainsFilter = new HashSet<string>(_domains.Select(d => d.Id));
        _showOnlyWithServices = false;
        _showOnlyWithDependencies = false;
        if (_showFilterPanel && _filterPanel is not null)
            await _filterPanel.SetSearchAsync(_filterText);
        else
            await ApplyFilters();
        if (!_disposed) Snackbar.Add(L["DomainGraph:Messages:ClearedFilters"].Value, Severity.Info);
    }
    
