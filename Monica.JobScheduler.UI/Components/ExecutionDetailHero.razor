@using Monica.JobScheduler.UI.UIJobScheduler.Executions.Support
@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation

<section class="execution-detail-hero" data-state="@Execution.State.ToString().ToLowerInvariant()" aria-label="@L["ExecutionDetail:Identity"]">
    @if (Execution.SkipReason is { } skipReason)
    { <div class="execution-detail-hero__skip"><span><MoIcon Icon="@MoIcons.SkipNext" Size="16px" /></span><div><b>@L["ExecutionDetail:SkipReason"]</b><p>@L[$"ExecutionSkipReasons:{skipReason}"]</p></div></div> }
    @if (SchedulerTimePresentation.GetExecutionDuration(Execution, ObservedAtUtc) is not null)
    {
        <p class="execution-detail-hero__label">@L[Execution.State == JobExecutionState.Running ? "Workspace:ElapsedDuration" : "ExecutionDetail:Duration"]</p>
        <strong class="execution-detail-hero__duration">@foreach (var part in Duration) { <span>@part.Value <small>@part.Unit</small></span> }</strong>
        <p class="execution-detail-hero__note">@(Execution.State == JobExecutionState.Running ? L["Workspace:RunningDurationNote", TimePresentation.FormatDuration(Execution.Template.MaxExecutionTimeout), TimePresentation.FormatExecutionClock(Execution.LeaseExpiresAtUtc)] : L["Workspace:RecordedDurationNote"])</p>
    }
</section>

@code {
    /// <summary>Gets the immutable durable execution captured by the current inspector owner.</summary>
    [Parameter, EditorRequired] public JobExecutionInstance Execution { get; set; } = null!;
    /// <summary>Gets the accepted observation instant used only for a running execution's elapsed duration.</summary>
    [Parameter] public DateTimeOffset ObservedAtUtc { get; set; }
    private IReadOnlyList<(string Value, string Unit)> Duration => TimePresentation.PreciseDurationParts(SchedulerTimePresentation.GetExecutionDuration(Execution, ObservedAtUtc));
}
