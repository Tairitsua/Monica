@implements IAsyncDisposable
@using Monica.UI.Shared.Components.Dialogs
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Components.Forms
@using Monica.Configuration.UI.Localization
@inject ConfigurationParameterPackageService PackageService
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog>
    <TitleContent><MoDialogHeading Text="@L["ImportExport:Import:Title"]" /></TitleContent>
    <DialogContent>
        <p class="configuration-import-intro">@L["Workbench:ImportHelp"]</p>
        <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Dense="true" Class="mb-3">@L["Validation:FragmentNotice"]</MudAlert>
        <div class="configuration-import-dialog-content">
            <MudStack Spacing="3">


            <MudFileUpload T="IBrowserFile"
                           Accept=".json,application/json"
                           FilesChanged="OnFileSelected"
                           MaximumFileCount="1">
                <CustomContent Context="upload">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="configuration-import-upload" Disabled="_loading" OnClick="upload.OpenFilePickerAsync" StartIcon="@MoIcons.FileUpload">
                        <span>@L["ImportExport:Import:Upload"]<small>.json · 10 MB</small></span>
                    </MudButton>
                </CustomContent>
            </MudFileUpload>

            @if (_loading)
            {
                <ConfigurationPackageProgressPanel Progress="@_progress" />
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_error</MudAlert>
            }

            @if (_report is not null && _review is not null)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="6" md="3">
                        <MudChip T="int" Color="Color.Primary" Variant="Variant.Outlined">@L["ImportExport:Report:Changes", _review.Changes.Count]</MudChip>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudChip T="int" Color="Color.Error" Variant="Variant.Outlined">@L["ImportExport:Report:Issues", _review.ValidationIssues.Count]</MudChip>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudChip T="int" Color="Color.Warning" Variant="Variant.Outlined">@L["ImportExport:Report:Diagnostics", _report.AllDiagnostics.Count]</MudChip>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudChip T="int" Variant="Variant.Outlined">@L["ImportExport:Report:Definitions", _review.Definitions.Count]</MudChip>
                    </MudItem>
                </MudGrid>

                @if (_report.Document is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @L["ImportExport:Import:PackageMeta", TimeDisplay.Format(_report.Document.ExportedAt), _report.Document.ExportedBy ?? L["Common:States:Empty"], _report.Document.SystemVersion ?? L["Common:States:Empty"]]
                    </MudText>
                }

                @if (_report.AllDiagnostics.Count > 0)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle2">@L["ImportExport:Diagnostics:Title"]</MudText>
                            @foreach (var diagnostic in _report.AllDiagnostics)
                            {
                                <MudAlert Icon="@((DiagnosticSeverity(diagnostic)) switch { Severity.Success => MoIcons.Success, Severity.Warning => MoIcons.Warning, Severity.Error => MoIcons.Error, _ => MoIcons.Info })" Severity="@DiagnosticSeverity(diagnostic)" Dense="true">
                                    @diagnostic.Message
                                </MudAlert>
                            }
                        </MudStack>
                    </MudPaper>
                }

                <ConfigurationPendingReviewTabs Review="_review"
                                                ActionMode="ConfigurationPendingReviewActionMode.Exclude"
                                                UndoRequested="UndoReview" />
            }
            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Common:Actions:Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@MoIcons.ListChecks"
                   Disabled="@(_disposed || _loading || _review?.HasItems is not true)"
                   OnClick="Apply">
            @L["Workbench:ImportStage"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const long MAX_IMPORT_BYTES = 10 * 1024 * 1024;

    private static readonly JsonSerializerOptions PackageJsonOptions = new(ConfigurationJsonDisplayFormatter.ReadableJsonOptions)
    {
        PropertyNameCaseInsensitive = true,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private ConfigurationImportReport? _report;
    private ConfigurationPendingReviewState? _review;
    private ConfigurationPackageProgress _progress = new()
    {
        Operation = ConfigurationPackageProgressOperation.Import,
        Stage = ConfigurationPackageProgressStage.ReadingPackage
    };
    private bool _loading;
    private bool _disposed;
    private readonly ConfigurationOperationLifetime _operations = new();
    private Task _pendingProgressRender = Task.CompletedTask;
    private string? _error;

    private async Task OnFileSelected(IBrowserFile? file)
    {
        if (_disposed || _loading || file is null) return;
        try { await _operations.RunAsync(token => AnalyzeFileAsync(file, token)); }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
    }

    private async Task AnalyzeFileAsync(IBrowserFile file, CancellationToken cancellationToken)
    {
        if (_disposed)
        {
            return;
        }

        _loading = true;
        _error = null;
        _report = null;
        _review = null;
        ReportProgress(new ConfigurationPackageProgress
        {
            Operation = ConfigurationPackageProgressOperation.Import,
            Stage = ConfigurationPackageProgressStage.ReadingPackage
        });
        try
        {
            await using var stream = file.OpenReadStream(MAX_IMPORT_BYTES, cancellationToken);
            var document = await JsonSerializer.DeserializeAsync<ConfigurationExportDocument>(stream, PackageJsonOptions, cancellationToken);
            if (_disposed) return;
            if (document is null)
            {
                _error = L["ImportExport:Import:InvalidPackage"];
                return;
            }

            var progress = new ImportProgress(ReportProgress);
            var report = await PackageService.AnalyzeImportAsync(document, file.Name, progress);
            if (_disposed) return;
            _report = report;
            _review = new ConfigurationPendingReviewState(_report.Changes, _report.ValidationIssues);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception ex) when (!_disposed)
        {
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed) _loading = false;
        }
    }

    private void ReportProgress(ConfigurationPackageProgress progress)
    {
        if (_disposed) return;
        _progress = progress;
        _pendingProgressRender = RenderProgressAsync(_pendingProgressRender);
    }

    private async Task RenderProgressAsync(Task previous)
    {
        await previous;
        await InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
    }

    private sealed class ImportProgress(Action<ConfigurationPackageProgress> report) : IProgress<ConfigurationPackageProgress>
    {
        public void Report(ConfigurationPackageProgress value) => report(value);
    }

    /// <summary>Drains the actual import producer and its admitted progress render before releasing this dialog.</summary>
    public ValueTask DisposeAsync()
    {
        _disposed = true;
        return _operations.RetireAsync(async () => await _pendingProgressRender);
    }

    private void Apply()
    {
        if (_disposed || _loading || _report is null || _review?.HasItems is not true)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(_review.Filter(_report)));
    }

    private void UndoReview(ConfigurationPendingReviewUndoRequest request)
    {
        _review?.Undo(request);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private static Severity DiagnosticSeverity(ConfigurationImportDiagnostic diagnostic)
    {
        return diagnostic.Severity switch
        {
            ConfigurationImportDiagnosticSeverity.Error => Severity.Error,
            ConfigurationImportDiagnosticSeverity.Warning => Severity.Warning,
            _ => Severity.Info
        };
    }
}
