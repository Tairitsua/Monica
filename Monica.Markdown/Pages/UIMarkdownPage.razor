@attribute [Route(PAGE_URL)]
@using Monica.Markdown.UIMarkdown.Components

<PageTitle>@L["Pages:MarkdownDocuments:Title"]</PageTitle>
<div class="@LayoutClass">
    <div @ref="_viewerRoot" class="@WorkspaceClass">
        @if (PageState.IsLoading)
        {
            <div class="doc-center-state" role="status">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <h1>@L["MarkdownViewer:States:LoadingDocuments"]</h1>
            </div>
        }
        else if (PageState.CatalogError is not null)
        {
            <div class="doc-center-state">
                <MoIcon Icon="@MoIcons.Error" Size="1.5rem" Style="color:var(--mud-palette-error);" />
                <h1>@L["MarkdownViewer:States:CatalogFailed"]</h1><p>@PageState.CatalogError</p>
                <MudButton OnClick="PageState.ReloadAsync" Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh">@L["MarkdownViewer:Actions:Refresh"]</MudButton>
            </div>
        }
        else if (PageState.Groups is null || PageState.Groups.Count == 0)
        {
            <div class="doc-center-state">
                <MoIcon Icon="@MoIcons.FolderOff" Size="1.5rem" />
                <h1>@L["MarkdownViewer:States:NoKnowledgeBasesRegistered"]</h1>
                <p>@L["MarkdownViewer:States:NoLibrariesDescription"]</p>
                <MudButton OnClick="PageState.ReloadAsync" Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh">@L["MarkdownViewer:Actions:Refresh"]</MudButton>
            </div>
        }
        else
        {
            @if (PageState.ShowSidebar && !PageState.IsSidebarTemporary)
            {
                <aside class="doc-sidebar-rail" aria-label="@L["MarkdownViewer:Toolbar:DocumentTree"]">@LibraryContent</aside>
            }
            <main class="doc-reader-card">
                <div class="doc-reader-toolbar">
                    <DocumentViewerToolbar ShowSidebarToggle="@(!PageState.ShowSidebar || PageState.IsSidebarTemporary)" ShowLibrarySwitcher="false" Document="PageState.SelectedDocument" CurrentGroup="PageState.CurrentGroup" CurrentCulture="@PageState.SelectedCulture"
                        CurrentLanguage="PageState.CurrentLanguage" Languages="PageState.CurrentLanguages"
                        ShowLanguageSwitcher="PageState.ShowLanguageSwitcher" IsSidebarVisible="PageState.ShowSidebar"
                        IsOutlineVisible="PageState.ShowTableOfContents" HasOutline="@(PageState.DocumentHeadings.Count > 0)" OnToggleSidebar="PageState.ToggleSidebar"
                        OnOpenGroupSwitcher="PageState.OpenGroupSwitcherAsync" OnOpenDocumentSearch="PageState.OpenDocumentSearchAsync"
                        OnLanguageChanged="PageState.OnLanguageSelectedAsync" OnToggleOutline="PageState.ToggleTableOfContents" />
                </div>
                <div class="doc-reader-stage" data-markdown-reading-stage="true">
                    <DocumentContentViewer CurrentGroup="PageState.CurrentGroup" Document="PageState.SelectedDocument"
                        Content="@PageState.DocumentContent" CurrentAnchorId="@PageState.CurrentAnchorId"
                        CurrentCulture="@PageState.SelectedCulture" CurrentLanguage="PageState.CurrentLanguage"
                        Languages="PageState.CurrentLanguages" MissingTranslation="PageState.MissingTranslation"
                        IsLoading="PageState.IsContentLoading" ContentError="@PageState.ContentError"
                        HeadingsChanged="PageState.OnDocumentHeadingsChangedAsync" />
                </div>
            </main>
            @if (PageState.ShowTableOfContents && !PageState.IsOutlineTemporary)
            {
                <aside class="doc-toc-rail" aria-label="@L["MarkdownViewer:Navbar:Outline"]">@OutlineContent</aside>
            }
            @if (PageState.IsSidebarTemporary && PageState.ShowSidebar)
            {
                <MudDrawer Open="PageState.ShowSidebar" OpenChanged="PageState.SetSidebarOpen" Variant="DrawerVariant.Temporary"
                    Width="min(360px, 92vw)" Elevation="1" Class="doc-temporary-pane" role="dialog" aria-modal="true"
                    aria-label="@L["MarkdownViewer:Toolbar:DocumentTree"]">
                    @if (PageState.ShowSidebar)
                    {
                        <div class="doc-pane-content" @onkeydown="HandlePaneKeyDown"><MudFocusTrap>@LibraryContent</MudFocusTrap></div>
                    }
                </MudDrawer>
            }
            @if (PageState.IsOutlineTemporary && PageState.ShowTableOfContents)
            {
                <MudDrawer Open="PageState.ShowTableOfContents" OpenChanged="PageState.SetOutlineOpen" Anchor="Anchor.Right"
                    Variant="DrawerVariant.Temporary" Width="min(336px, 92vw)" Elevation="1" Class="doc-temporary-pane"
                    role="dialog" aria-modal="true" aria-label="@L["MarkdownViewer:Navbar:Outline"]">
                    @if (PageState.ShowTableOfContents)
                    {
                        <div class="doc-pane-content" @onkeydown="HandlePaneKeyDown"><MudFocusTrap>@OutlineContent</MudFocusTrap></div>
                    }
                </MudDrawer>
            }
        }
    </div>
</div>

@code {
    private RenderFragment LibraryContent => @<DocumentSidebar CurrentGroup="PageState.CurrentGroup"
        CurrentTree="PageState.CurrentTree" CurrentCulture="@PageState.SelectedCulture" SelectedDocument="PageState.SelectedDocument"
        TreeError="@PageState.TreeError" SelectedDocumentChanged="PageState.OnDocumentSelectedAsync"
        OnOpenGroupSwitcher="PageState.OpenGroupSwitcherAsync" OnCollapseRequested="PageState.ToggleSidebar" />;
    private RenderFragment OutlineContent => @<DocumentTableOfContentsPanel Document="PageState.SelectedDocument"
        Headings="PageState.DocumentHeadings" CurrentAnchorId="@PageState.CurrentAnchorId"
        OnClose="PageState.ToggleTableOfContents" OnHeadingSelected="PageState.OnHeadingSelectedAsync" />;
}
