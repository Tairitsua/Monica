@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.UI.Shared.Components.Dialogs
@inject KafkaConsumerMetricsPollingStateFactory PollingStateFactory
@inject IStringLocalizer<EventBusKafkaResource> L
@using Microsoft.Extensions.Logging
@inject ILogger<KafkaConsumerGroupMetricsDialog> Logger
@implements IAsyncDisposable

<MudDialog Gutters="false">
    <TitleContent><MoDialogHeading Text="@(string.IsNullOrWhiteSpace(TopicName) ? L["ConsumerGroups:MetricsDialog:Title"] : L["ConsumerGroups:MetricsDialog:TopicTitle"])" /></TitleContent>
    <DialogContent>
        @{
            var metrics = KafkaConsumerGroupMetricsView.Create(PollingState.Snapshot, GroupId, TopicName);
        }
        <div class="consumer-metrics-dialog">
            <KafkaDialogContext ClusterId="@ClusterId" TopicName="@TopicName" />
            <section class="consumer-metrics-overview" aria-labelledby="consumer-metrics-group-heading">
                <div class="consumer-metrics-identity">
                    <span class="consumer-metrics-identity__icon" aria-hidden="true">
                        <MoIcon Icon="@MoIcons.Users" Size="1.5rem" />
                    </span>
                    <div class="consumer-metrics-identity__copy">
                        <MudText Typo="Typo.overline" Class="consumer-metrics-eyebrow">
                            @L["ConsumerGroups:Columns:GroupId"]
                        </MudText>
                        <MudText Typo="Typo.h6"
                                 id="consumer-metrics-group-heading"
                                 Class="consumer-metrics-group-id">
                            @GroupId
                        </MudText>
                        <div class="consumer-metrics-context">
                            @if (!string.IsNullOrWhiteSpace(TopicName))
                            {
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Variant="Variant.Outlined"
                                         Color="Color.Info"
                                         Icon="@MoIcons.Folder" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                                    @TopicName
                                </MudChip>
                            }
                            <span class="consumer-metrics-status" aria-live="polite">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@CaptureStatus</MudText>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="consumer-metrics-controls">
                    <div class="consumer-metrics-auto-refresh">
                        <MudSwitch T="bool"
                                   Value="@PollingState.IsAutomaticRefreshEnabled"
                                   ValueChanged="SetAutoRefreshAsync"
                                   Color="Color.Primary"
                                   Label="@L["Performance:Live:AutoRefresh"]" />
                    </div>
                    <div class="consumer-metrics-interval">
                        <span id="consumer-metrics-interval-label"
                              class="consumer-metrics-interval__label">
                            @L["Performance:Live:IntervalSeconds"]
                        </span>
                        <div class="consumer-metrics-interval__field">
                            <MudTooltip Text="@L["Performance:Live:IntervalHint", KafkaPerformancePollingState.MinimumRefreshIntervalSeconds, KafkaPerformancePollingState.MaximumRefreshIntervalSeconds]">
                                <MudNumericField T="int"
                                                 Value="@PollingState.RefreshIntervalSeconds"
                                                 ValueChanged="SetIntervalAsync"
                                                 Min="@KafkaPerformancePollingState.MinimumRefreshIntervalSeconds"
                                                 Max="@KafkaPerformancePollingState.MaximumRefreshIntervalSeconds"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Disabled="@(!PollingState.IsAutomaticRefreshEnabled)"
                                                 aria-labelledby="consumer-metrics-interval-label" />
                            </MudTooltip>
                        </div>
                    </div>
                    <MudButton Variant="Variant.Outlined"
                               StartIcon="@MoIcons.Refresh"
                               Disabled="@PollingState.IsSampling"
                               OnClick="CaptureAsync"
                               aria-label="@L["Common:Actions:Refresh"]">
                        @L["Common:Actions:Refresh"]
                    </MudButton>
                </div>
            </section>

            @if (PollingState.IsSampling && PollingState.Snapshot is not null)
            {
                <MudProgressLinear Class="consumer-metrics-activity" Color="Color.Primary" Indeterminate="true" />
            }

            @if (!string.IsNullOrWhiteSpace(PollingState.LastError))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Warning">
                    @PollingState.LastError
                </MudAlert>
            }

            @if (PollingState.Snapshot is null && PollingState.IsSampling)
            {
                <div class="consumer-metrics-state">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    <MudText Typo="Typo.body2">@L["ConsumerGroups:MetricsDialog:Loading"]</MudText>
                </div>
            }
            else if (PollingState.Snapshot is null)
            {
                <KafkaWorkspaceState Icon="@MoIcons.ChartTrend" Title="@L["ConsumerGroups:MetricsDialog:Title"]" Description="@L["ConsumerGroups:MetricsDialog:Unavailable"]" />
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(PollingState.Snapshot.Message)) { <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@MoIcons.Info">@PollingState.Snapshot.Message</MudAlert> }
                <section class="consumer-detail-section consumer-summary-section"
                         aria-labelledby="consumer-summary-heading">
                    <div class="consumer-section-title">
                        <span class="consumer-section-title__icon consumer-section-title__icon--summary" aria-hidden="true">
                            <MoIcon Icon="@MoIcons.ChartTrend" Size="1.25rem" />
                        </span>
                        <MudText Typo="Typo.subtitle1" id="consumer-summary-heading">
                            @L["ConsumerGroups:MetricsDialog:SummaryTitle"]
                        </MudText>
                    </div>

                    <div class="consumer-group-summary">
                        <KafkaMetricCard Icon="@MoIcons.Users"
                                         Label="@L["ConsumerGroups:Columns:Members"]"
                                         Value="@(HasGroupDescription ? metrics.MemberCount.ToString() : L["Common:Values:Unavailable"].Value)"
                                         AccentColor="Color.Secondary" />
                        <KafkaMetricCard Icon="@MoIcons.Workflow"
                                         Label="@L["ConsumerGroups:MetricsDialog:Columns:Assignments"]"
                                         Value="@(HasGroupDescription ? metrics.AssignmentCount.ToString() : L["Common:Values:Unavailable"].Value)"
                                         AccentColor="Color.Info" />
                        <KafkaMetricCard Icon="@MoIcons.Hourglass"
                                         Label="@L["Performance:Columns:Lag"]"
                                         Value="@KafkaMetricDisplayFormatter.FormatOptionalInt64(metrics.TotalLag, L["Performance:Values:LagUnknown"])"
                                         AccentColor="@metrics.LagAccentColor" />
                        <KafkaMetricCard Icon="@MoIcons.ArrowDownLeft"
                                         Label="@L["Performance:Columns:ConsumeRate"]"
                                         Value="@KafkaMetricDisplayFormatter.FormatRate(metrics.ConsumeRatePerSecond, L)"
                                         AccentColor="Color.Primary" />
                    </div>
                </section>

                <section class="consumer-detail-section consumer-members-section"
                         aria-labelledby="consumer-members-heading">
                    <div class="consumer-section-title">
                        <span class="consumer-section-title__icon consumer-section-title__icon--members" aria-hidden="true">
                            <MoIcon Icon="@MoIcons.Users" Size="1.25rem" />
                        </span>
                        <MudText Typo="Typo.subtitle1" id="consumer-members-heading">
                            @L["ConsumerGroups:MetricsDialog:MembersTitle", HasGroupDescription ? metrics.MemberCount.ToString() : L["Common:Values:Unavailable"].Value]
                        </MudText>
                    </div>

                    @if (!HasGroupDescription)
                    {
                        <KafkaWorkspaceState Icon="@MoIcons.Users" Title="@L["ConsumerGroups:Columns:Members"]" Description="@L["ConsumerGroups:MetricsDialog:Unavailable"]" />
                    }
                    else if (!metrics.HasMembers)
                    {
                        <KafkaWorkspaceState Icon="@MoIcons.UsersOff"
                                             Title="@L["ConsumerGroups:MetricsDialog:MembersTitle", HasGroupDescription ? metrics.MemberCount.ToString() : L["Common:Values:Unavailable"].Value]"
                                             Description="@L["ConsumerGroups:MetricsDialog:NoMembers"]"
                                             AccentColor="Color.Info" />
                    }
                    else
                    {
                        <KafkaTableSurface AriaLabel="@L["ConsumerGroups:MetricsDialog:MembersTitle", HasGroupDescription ? metrics.MemberCount.ToString() : L["Common:Values:Unavailable"].Value]"
                                           AccentColor="Color.Secondary"
                                           Size="KafkaTableSurfaceSize.Wide">
                            <MudTable T="KafkaConsumerMemberMetricsView"
                                      Items="@metrics.Members"
                                      Dense="true"
                                      Hover="true"
                                      Striped="true"
                                      Breakpoint="Breakpoint.Xs" Square="true" Elevation="0"
                                      @bind-RowsPerPage="_memberRowsPerPage">
                                <HeaderContent>
                                    <MudTh>@L["ConsumerGroups:MetricsDialog:Columns:ConsumerId"]</MudTh>
                                    <MudTh>@L["ConsumerGroups:MetricsDialog:Columns:Host"]</MudTh>
                                    <MudTh>@L["ConsumerGroups:MetricsDialog:Columns:ClientId"]</MudTh>
                                    <MudTh>@L["ConsumerGroups:MetricsDialog:Columns:Assignments"]</MudTh>
                                    <MudTh>@L["Performance:Columns:Lag"]</MudTh>
                                    <MudTh>@L["Performance:Columns:ConsumeRate"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="@L["ConsumerGroups:MetricsDialog:Columns:ConsumerId"]">
                                        <span class="consumer-identifier">@FormatIdentity(context.Member.ConsumerId)</span>
                                    </MudTd>
                                    <MudTd DataLabel="@L["ConsumerGroups:MetricsDialog:Columns:Host"]">
                                        <span class="consumer-identifier">@FormatIdentity(context.Member.Host)</span>
                                    </MudTd>
                                    <MudTd DataLabel="@L["ConsumerGroups:MetricsDialog:Columns:ClientId"]">
                                        <span class="consumer-identifier">@FormatIdentity(context.Member.ClientId)</span>
                                    </MudTd>
                                    <MudTd DataLabel="@L["ConsumerGroups:MetricsDialog:Columns:Assignments"]">
                                        @context.AssignmentCount
                                    </MudTd>
                                    <MudTd DataLabel="@L["Performance:Columns:Lag"]">
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Variant="Variant.Outlined"
                                                 Color="@context.LagAccentColor" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                                            @KafkaMetricDisplayFormatter.FormatOptionalInt64(
                                                context.TotalLag,
                                                L["Performance:Values:LagUnknown"])
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="@L["Performance:Columns:ConsumeRate"]">
                                        @KafkaMetricDisplayFormatter.FormatRate(context.ConsumeRatePerSecond, L)
                                    </MudTd>
                                </RowTemplate>
                                <PagerContent>
                                    <MudTablePager PageSizeOptions="@KafkaTablePageSizes.Standard" RowsPerPageString="@L["Common:Pagination:RowsPerPage"]" InfoFormat="@L["Common:Pagination:InfoFormat"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" />
                                </PagerContent>
                            </MudTable>
                        </KafkaTableSurface>
                    }
                </section>

                <section class="consumer-detail-section consumer-partitions-section"
                         aria-labelledby="consumer-partitions-heading">
                    <div class="consumer-section-title">
                        <span class="consumer-section-title__icon consumer-section-title__icon--partitions" aria-hidden="true">
                            <MoIcon Icon="@MoIcons.Rows" Size="1.25rem" />
                        </span>
                        <MudText Typo="Typo.subtitle1" id="consumer-partitions-heading">
                            @L["ConsumerGroups:MetricsDialog:PartitionsTitle"]
                        </MudText>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Class="consumer-partition-count" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                            @(HasGroupDescription ? metrics.PartitionCount.ToString() : L["Common:Values:Unavailable"].Value)
                        </MudChip>
                    </div>

                    @if (!HasGroupDescription)
                    {
                        <KafkaWorkspaceState Icon="@MoIcons.Rows" Title="@L["ConsumerGroups:MetricsDialog:PartitionsTitle"]" Description="@L["ConsumerGroups:MetricsDialog:Unavailable"]" />
                    }
                    else if (!metrics.HasPartitions)
                    {
                        <KafkaWorkspaceState Icon="@MoIcons.Rows"
                                             Title="@L["ConsumerGroups:MetricsDialog:PartitionsTitle"]"
                                             Description="@L["ConsumerGroups:MetricsDialog:NoPartitions"]"
                                             AccentColor="Color.Info" />
                    }
                    else
                    {
                        <KafkaTableSurface AriaLabel="@L["ConsumerGroups:MetricsDialog:PartitionsTitle"]"
                                           AccentColor="Color.Primary"
                                           Size="KafkaTableSurfaceSize.Wide">
                            <MudTable T="KafkaConsumerPartitionMetricsRow"
                                      Items="@metrics.PartitionRows"
                                      Dense="true"
                                      Hover="true"
                                      Striped="true"
                                      Breakpoint="Breakpoint.Xs" Square="true" Elevation="0"
                                      @bind-RowsPerPage="_partitionRowsPerPage">
                                <HeaderContent>
                                    <MudTh>@L["Performance:Columns:Topic"]</MudTh>
                                    <MudTh>@L["ConsumerGroups:MetricsDialog:Columns:ConsumerId"]</MudTh>
                                    <MudTh>@L["Performance:Columns:ConsumeRate"]</MudTh>
                                    <MudTh>@L["Performance:Columns:Lag"]</MudTh>
                                    <MudTh>@L["ConsumerGroups:MetricsDialog:Columns:CurrentOffset"]</MudTh>
                                    <MudTh>@L["ConsumerGroups:MetricsDialog:Columns:LogEndOffset"]</MudTh>
                                    <MudTh>@L["Performance:Columns:WriteRate"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="@L["Performance:Columns:Topic"]">
                                        <div class="consumer-partition-context">
                                            <span class="consumer-partition-topic">@context.TopicName</span>
                                            <MudText Typo="Typo.caption">
                                                @L["ConsumerGroups:MetricsDialog:Columns:Partition"] @context.Partition.Partition
                                            </MudText>
                                        </div>
                                    </MudTd>
                                    <MudTd DataLabel="@L["ConsumerGroups:MetricsDialog:Columns:ConsumerId"]">
                                        <div class="consumer-member-context">
                                            <span class="consumer-identifier">@FormatIdentity(context.Member.ConsumerId)</span>
                                            <MudText Typo="Typo.caption">
                                                @(L["ConsumerGroups:MetricsDialog:Columns:Host"]): @FormatIdentity(context.Member.Host)
                                            </MudText>
                                            <MudText Typo="Typo.caption">
                                                @(L["ConsumerGroups:MetricsDialog:Columns:ClientId"]): @FormatIdentity(context.Member.ClientId)
                                            </MudText>
                                        </div>
                                    </MudTd>
                                    <MudTd DataLabel="@L["Performance:Columns:ConsumeRate"]">
                                        @KafkaMetricDisplayFormatter.FormatRate(context.Partition.ConsumeRatePerSecond, L)
                                    </MudTd>
                                    <MudTd DataLabel="@L["Performance:Columns:Lag"]">
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Variant="Variant.Outlined"
                                                 Color="@context.LagColor" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                                            @KafkaMetricDisplayFormatter.FormatOptionalInt64(
                                                context.Partition.Lag,
                                                L["Performance:Values:LagUnknown"])
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="@L["ConsumerGroups:MetricsDialog:Columns:CurrentOffset"]">
                                        @KafkaMetricDisplayFormatter.FormatOptionalInt64(
                                            context.Partition.CurrentOffset,
                                            L["ConsumerGroups:MetricsDialog:Values:OffsetUnknown"])
                                    </MudTd>
                                    <MudTd DataLabel="@L["ConsumerGroups:MetricsDialog:Columns:LogEndOffset"]">
                                        @KafkaMetricDisplayFormatter.FormatOptionalInt64(
                                            context.Partition.LogEndOffset,
                                            L["ConsumerGroups:MetricsDialog:Values:OffsetUnknown"])
                                    </MudTd>
                                    <MudTd DataLabel="@L["Performance:Columns:WriteRate"]">
                                        @KafkaMetricDisplayFormatter.FormatRate(context.Partition.WriteRatePerSecond, L)
                                    </MudTd>
                                </RowTemplate>
                                <PagerContent>
                                    <MudTablePager PageSizeOptions="@KafkaTablePageSizes.Standard" RowsPerPageString="@L["Common:Pagination:RowsPerPage"]" InfoFormat="@L["Common:Pagination:InfoFormat"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" />
                                </PagerContent>
                            </MudTable>
                        </KafkaTableSurface>
                    }
                </section>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Close">
            @L["Common:Actions:Close"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private KafkaConsumerMetricsPollingState PollingState { get; set; } = null!;
    private readonly CancellationTokenSource _lifetime = new();
    private readonly object _operationGate = new();
    private readonly HashSet<Task> _operations = [];
    private Task? _disposeTask;
    private int _memberRowsPerPage = 10;
    private int _partitionRowsPerPage = 25;
    private volatile bool _isDisposed;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    /// <summary>Gets or sets the exact cluster identity frozen by the opener.</summary>
    [Parameter, EditorRequired] public string ClusterId { get; set; } = string.Empty;
    /// <summary>Gets or sets the exact consumer-group identity frozen by the opener.</summary>
    [Parameter, EditorRequired] public string GroupId { get; set; } = string.Empty;
    /// <summary>Gets or sets the optional exact topic scope frozen by the opener.</summary>
    [Parameter] public string? TopicName { get; set; }
    private bool HasGroupDescription => PollingState.Snapshot?.ConsumerGroups.Any(group =>
        string.Equals(group.GroupId, GroupId, StringComparison.Ordinal) && string.IsNullOrWhiteSpace(group.ErrorMessage)) == true;
    private string CaptureStatus => PollingState.IsSampling ? L["Performance:Live:Sampling"] :
        PollingState.Snapshot is { } snapshot ? L["Performance:Live:LastCapturedAt", UiTime.Format(snapshot.CapturedAt)] :
        !string.IsNullOrWhiteSpace(PollingState.LastError) ? L["Common:Values:Unavailable"] : L["Performance:Live:WaitingForFirstSample"];
    protected override void OnInitialized()
    {
        PollingState = PollingStateFactory.Create();
        PollingState.StateChanged += HandleStateChanged;
    }
    protected override Task OnInitializedAsync() => RunOwnedAsync(() => PollingState.ActivateAsync(ClusterId, GroupId, TopicName, _lifetime.Token));
    private Task CaptureAsync() => RunOwnedAsync(async () => { await PollingState.CaptureNowAsync(_lifetime.Token); });
    private Task SetAutoRefreshAsync(bool enabled) => RunOwnedAsync(() => PollingState.SetAutomaticRefreshAsync(enabled, _lifetime.Token));
    private Task SetIntervalAsync(int seconds) => RunOwnedAsync(() => PollingState.SetRefreshIntervalAsync(seconds));
    private string FormatIdentity(string value) => string.IsNullOrWhiteSpace(value) ? L["ConsumerGroups:MetricsDialog:Values:Unassigned"] : value;
    private Task RunOwnedAsync(Func<Task> action)
    {
        TaskCompletionSource completion;
        lock (_operationGate)
        {
            if (_isDisposed) return Task.CompletedTask;
            completion = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
            _operations.Add(completion.Task);
        }
        // The sampler invokes notifications under its own lock; external work starts outside this gate.
        _ = CompleteOwnedAsync(action, completion);
        return completion.Task;
    }
    private async Task CompleteOwnedAsync(Func<Task> action, TaskCompletionSource completion)
    {
        try { await action(); completion.TrySetResult(); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { completion.TrySetResult(); }
        catch (Exception exception) { completion.TrySetException(exception); }
        finally { lock (_operationGate) _operations.Remove(completion.Task); }
    }
    private void HandleStateChanged() => _ = RunOwnedAsync(RenderStateAsync);
    private async Task RenderStateAsync()
    {
        try { await InvokeAsync(() => { if (!_isDisposed) StateHasChanged(); }); }
        catch (Exception exception) { if (!_isDisposed) Logger.LogError(exception, "Kafka consumer metrics rendering failed."); }
    }
    private void Close() => MudDialog.Close();
    /// <summary>Retires and drains owned work once, observing every cleanup failure before reporting it.</summary>
    public ValueTask DisposeAsync()
    {
        TaskCompletionSource completion;
        lock (_operationGate)
        {
            if (_disposeTask is not null) return new ValueTask(_disposeTask);
            _isDisposed = true;
            completion = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
            _disposeTask = completion.Task;
        }
        _ = CompleteDisposalAsync(completion);
        return new ValueTask(completion.Task);
    }
    private async Task CompleteDisposalAsync(TaskCompletionSource completion)
    {
        try
        {
            PollingState.StateChanged -= HandleStateChanged;
            await DisposeCoreAsync();
            completion.TrySetResult();
        }
        catch (Exception exception) { completion.TrySetException(exception); }
    }
    private async Task DisposeCoreAsync()
    {
        List<Exception> failures = [];
        Task[] pending;
        lock (_operationGate) pending = _operations.ToArray();
        Observe(_lifetime.Cancel);
        try { await PollingState.DisposeAsync(); }
        catch (Exception exception) { Collect(exception); }
        foreach (var task in pending) await DrainAsync(task);
        Observe(_lifetime.Dispose);
        if (failures.Count > 0) throw new AggregateException(failures);

        void Observe(Action action)
        {
            try { action(); }
            catch (Exception exception) { Collect(exception); }
        }
        async Task DrainAsync(Task task)
        {
            try { await task; }
            catch (Exception exception) { Collect(task.Exception ?? exception); }
        }
        void Collect(Exception exception)
        {
            if (exception is AggregateException aggregate) failures.AddRange(aggregate.Flatten().InnerExceptions);
            else failures.Add(exception);
        }
    }
}
