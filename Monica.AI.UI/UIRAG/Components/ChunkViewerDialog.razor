@using System.Text
@using System.Web
@using Monica.UI.Shared.Components.Dialogs
@using Microsoft.Extensions.Localization
@using Monica.AI.KnowledgeBase.Models
@using Monica.AI.RAG.Models
@using Monica.AI.UI.Localization
@using Monica.AI.UI.UIRAG.Support
@implements IAsyncDisposable
@inject IStringLocalizer<AIResource> L
@inject IJSRuntime JSRuntime

<div class="chunk-viewer-dialog" @ref="_viewerRoot">
<MudDialog DefaultFocus="DefaultFocus.FirstChild" ContentClass="chunk-viewer-dialog-body pa-0" ActionsClass="pa-0" Style="max-height:calc(100dvh - 24px);margin:12px;overflow:hidden">
    <TitleContent><MoDialogHeading Text="@L["KnowledgeDialogs:ChunkTitle", DocumentName]" /></TitleContent>
    <DialogContent>
        <div class="chunk-viewer-root">
            <div class="chunk-viewer-context">
                <div class="chunk-viewer-provenance">
                    <span>@L["KnowledgeDialogs:ChunkCount", ChunkCount]</span>
                    @if (!string.IsNullOrWhiteSpace(StatusText)) { <span>@StatusText</span> }
                    @if (!string.IsNullOrWhiteSpace(DocumentPath)) { <code>@DocumentPath</code> }
                    <span>@L["KnowledgeBase:Documents:Preview:Source", GetSourceDisplay()]</span>
                    @if (!string.IsNullOrWhiteSpace(SourceGroupKey)) { <span>@L["KnowledgeDialogs:SourceGroup", SourceGroupKey]</span> }
                </div>
                @if (HasMatchedChunk)
                {
                    <div class="matched-label"><MoIcon Icon="@MoIcons.Crosshair" Size="1.25rem" /><span>@L["RAG:ChunkViewer:MatchedBadge"]</span></div>
                }
            </div>
            <div class="chunk-viewer-content">
                @if (string.IsNullOrWhiteSpace(OriginalText))
                {
                    <MoContentState Compact="true">@L["RAG:ChunkViewer:NoContent"]</MoContentState>
                }
                else if (UseMarkdownRendering)
                {
                    <div class="markdown-preview-content">
                        <RAGChunkMarkdown Value="@OriginalText" ScopeKey="@SourceGroupKey" DocumentRelativePath="@DocumentPath" Chunks="@Chunks" MatchedChunkIndex="@MatchedChunkIndex" />
                    </div>
                }
                else
                {
                    <div class="original-text">@((MarkupString)BuildHighlightedHtml())</div>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions><div class="chunk-viewer-actions"><MudButton OnClick="Close">@L["Common:Close"]</MudButton></div></DialogActions>
</MudDialog>
</div>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>The source document display name used by the native dialog heading.</summary>
    [Parameter]
    public string DocumentName { get; set; } = string.Empty;

    /// <summary>The exact document identity used to resolve relative Markdown assets.</summary>
    [Parameter]
    public string DocumentPath { get; set; } = string.Empty;

    /// <summary>The source text underlying the supplied end-exclusive highlight ranges.</summary>
    [Parameter]
    public string OriginalText { get; set; } = string.Empty;

    /// <summary>Chunk boundary evidence; ordered by source offset for display, with original indexes retained.</summary>
    [Parameter]
    public IReadOnlyList<ChunkHighlight> Chunks { get; set; } = Array.Empty<ChunkHighlight>();

    /// <summary>The exact originating chunk index to focus; offscreen matches scroll within the native dialog body.
    /// Null means no retrieval match.</summary>
    [Parameter]
    public int? MatchedChunkIndex { get; set; }

    /// <summary>Caller-supplied provenance or test status; the viewer does not infer indexing readiness.</summary>
    [Parameter]
    public string StatusText { get; set; } = string.Empty;

    /// <summary>Source provenance controlling Markdown rendering; Unknown uses encoded plain text.</summary>
    [Parameter]
    public string SourceKind { get; set; } = KnowledgeDocumentSourceKinds.Unknown;

    /// <summary>The originating Markdown group used for scoped asset resolution, when supplied.</summary>
    [Parameter]
    public string? SourceGroupKey { get; set; }

    private readonly List<ChunkHighlight> OrderedChunks = [];
    private ElementReference _viewerRoot;
    private ChunkViewerInteropSession? _interopSession;
    private readonly SemaphoreSlim _componentGate = new(1, 1);
    private readonly object _disposeGate = new();
    private volatile bool _retired;
    private Task? _disposeTask;
    private string _lastAppliedSignature = string.Empty;

    private int ChunkCount => OrderedChunks.Count;

    private bool HasMatchedChunk =>
        MatchedChunkIndex.HasValue && OrderedChunks.Any(chunk => chunk.Index == MatchedChunkIndex.Value);

    private bool UseMarkdownRendering =>
        string.Equals(SourceKind, KnowledgeDocumentSourceKinds.Markdown, StringComparison.OrdinalIgnoreCase);

    protected override void OnParametersSet()
    {
        if (_retired) return;
        OrderedChunks.Clear();
        OrderedChunks.AddRange(Chunks.OrderBy(chunk => chunk.Start).ThenBy(chunk => chunk.Index));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_retired || !HasMatchedChunk) return;
        await _componentGate.WaitAsync();
        try
        {
            if (_retired || !HasMatchedChunk) return;
            var signature = BuildScrollSignature();
            if (string.Equals(signature, _lastAppliedSignature, StringComparison.Ordinal)) return;
            _interopSession ??= new ChunkViewerInteropSession(JSRuntime);
            if (await _interopSession.ScrollToMatchedChunkAsync(_viewerRoot) && !_retired)
                _lastAppliedSignature = signature;
        }
        finally { _componentGate.Release(); }
    }

    private string GetSourceDisplay()
        => string.Equals(SourceKind, KnowledgeDocumentSourceKinds.Markdown, StringComparison.OrdinalIgnoreCase)
            ? L["KnowledgeBase:Documents:Source:Markdown"].Value
            : string.Equals(SourceKind, KnowledgeDocumentSourceKinds.Uploaded, StringComparison.OrdinalIgnoreCase)
                ? L["KnowledgeBase:Documents:Source:Uploaded"].Value
                : L["KnowledgeBase:Documents:Source:Unknown"].Value;

    private void Close() => MudDialog.Close();

    private string BuildScrollSignature()
    {
        return string.Join(
            "|",
            MatchedChunkIndex?.ToString() ?? string.Empty,
            OriginalText,
            string.Join(";", OrderedChunks.Select(chunk => $"{chunk.Index}:{chunk.Start}:{chunk.End}:{chunk.Section}")),
            SourceKind,
            SourceGroupKey ?? string.Empty,
            DocumentPath);
    }

    private string BuildHighlightedHtml()
    {
        if (string.IsNullOrEmpty(OriginalText))
        {
            return string.Empty;
        }

        if (OrderedChunks.Count == 0)
        {
            return HttpUtility.HtmlEncode(OriginalText);
        }

        var boundaries = new SortedSet<int> { 0, OriginalText.Length };
        foreach (var chunk in OrderedChunks)
        {
            boundaries.Add(Math.Clamp(chunk.Start, 0, OriginalText.Length));
            boundaries.Add(Math.Clamp(chunk.End, 0, OriginalText.Length));
        }

        var points = boundaries.ToArray();
        var html = new StringBuilder();

        for (var index = 0; index < points.Length - 1; index++)
        {
            var segmentStart = points[index];
            var segmentEnd = points[index + 1];
            if (segmentEnd <= segmentStart)
            {
                continue;
            }

            var segmentText = OriginalText[segmentStart..segmentEnd];
            var activeChunks = OrderedChunks
                .Where(chunk => chunk.Start < segmentEnd && chunk.End > segmentStart)
                .ToList();

            if (activeChunks.Count == 0)
            {
                html.Append(HttpUtility.HtmlEncode(segmentText));
                continue;
            }

            var metadata = BuildChunkMetadata(activeChunks);
            html.Append("<span");
            html.Append($" class=\"{BuildChunkClass(activeChunks, isBlock: false)}\"");
            html.Append(" data-rag-chunk=\"true\" tabindex=\"0\"");
            html.Append($" data-rag-chunk-ids=\"{HttpUtility.HtmlAttributeEncode(string.Join(",", activeChunks.Select(chunk => chunk.Index)))}\"");
            html.Append($" data-rag-chunk-label=\"{HttpUtility.HtmlAttributeEncode(metadata)}\"");
            html.Append($" title=\"{HttpUtility.HtmlAttributeEncode(metadata)}\"");

            if (ContainsMatchedChunk(activeChunks))
            {
                html.Append(" data-rag-chunk-target=\"true\"");
            }

            html.Append(">");
            html.Append(HttpUtility.HtmlEncode(segmentText));
            html.Append("</span>");
        }

        return html.ToString();
    }

    private bool ContainsMatchedChunk(IReadOnlyList<ChunkHighlight> chunks)
        => MatchedChunkIndex.HasValue && chunks.Any(chunk => chunk.Index == MatchedChunkIndex.Value);

    private string BuildChunkClass(IReadOnlyList<ChunkHighlight> chunks, bool isBlock)
    {
        var classes = new List<string>
        {
            "rag-chunk",
            isBlock ? "rag-chunk--block" : "rag-chunk--inline"
        };

        if (chunks.Count > 1)
        {
            classes.Add("rag-chunk--overlap");
        }

        if (ContainsMatchedChunk(chunks))
        {
            classes.Add("rag-chunk--matched");
        }

        return string.Join(" ", classes);
    }

    private string BuildChunkMetadata(IReadOnlyList<ChunkHighlight> chunks)
    {
        var chunkLabel = chunks.Count == 1
            ? L["RAG:ChunkViewer:ChunkNumber", chunks[0].Index].Value
            : L["RAG:ChunkViewer:ChunkNumbers", string.Join(", ", chunks.Select(chunk => chunk.Index))].Value;

        var sections = chunks
            .Select(chunk => chunk.Section)
            .Where(section => !string.IsNullOrWhiteSpace(section))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (sections.Count > 0)
        {
            chunkLabel = $"{chunkLabel} · {L["RAG:ChunkViewer:Section", string.Join(" / ", sections)]}";
        }

        if (ContainsMatchedChunk(chunks))
        {
            chunkLabel = $"{chunkLabel} · {L["RAG:ChunkViewer:MatchedBadge"]}";
        }

        return chunkLabel;
    }

    /// <summary>Retires rendering before draining matched-chunk interop and its late module imports.</summary>
    public ValueTask DisposeAsync()
    {
        lock (_disposeGate)
        {
            _retired = true;
            return new ValueTask(_disposeTask ??= DisposeCoreAsync());
        }
    }

    private async Task DisposeCoreAsync()
    {
        await _componentGate.WaitAsync();
        try
        {
            var session = _interopSession;
            _interopSession = null;
            if (session is not null) await session.DisposeAsync();
        }
        finally { _componentGate.Release(); }
    }
}
