{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReferenceUI": {
    "EnableDiagnostics": false
  },
  "Ordering": {
    "MaximumOrdersReturned": 100,
    "BacklogWarningThreshold": 10
  },
  "Application": {
    "AppId": "monica-ordering-reference",
    "DeploymentScope": "monica-reference-ordering",
    "Deployments": {
      "monica-ordering-reference": {
        "AppName": "Monica Ordering Reference",
        "Roles": ["ordering", "ordering.reporting"]
      }
    }
  },
  "AllowedHosts": "*"
}
