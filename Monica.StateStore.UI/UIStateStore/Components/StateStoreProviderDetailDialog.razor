@using Monica.UI.Shared.Components.States
@using Monica.StateStore.Abstractions
@using Monica.StateStore.UI.Models
@using Monica.UI.Shared.Components.Dialogs
@implements IDisposable
@inject IStringLocalizer<StateStoreResource> L

<MudDialog Visible="IsVisible" VisibleChanged="OnVisibleChanged" Options="DialogOptions"
           DefaultFocus="DefaultFocus.FirstChild" Gutters="false" TitleClass="pa-0" ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent>
        @if (Provider is not null)
        {
            <div class="provider-dialog__title">
                <MoDialogHeading Text="@L.GetProviderDisplayName(Provider)" />
                <p>@GetProviderSummary(Provider)</p>
            </div>
        }
    </TitleContent>
    <DialogContent>
        @if (Provider != null)
        {
            <div class="provider-dialog">
                <MudTabs Class="state-provider-tabs" Elevation="0"
                         ApplyEffectsToContainer="false"
                         MinimumTabWidth="0px"
                         ActivePanelIndex="@_activeTabIndex"
                         ActivePanelIndexChanged="OnActiveTabChanged" PrevIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight">
                    <MudTabPanel Text="@L["ProviderDetail:Tabs:Overview"]" Icon="@MoIcons.Info">
                        <div class="provider-dialog__tab-content">
                            <dl class="provider-dialog__overview">
                                <div class="provider-dialog__stat">
                                    <dt>@L["ProviderDetail:Labels:ProviderType"]</dt>
                                    <dd>@L.GetProviderTypeText(Provider.ProviderType)</dd>
                                </div>

                                <div class="provider-dialog__stat">
                                    <dt>@L["ProviderDetail:Labels:ServiceKey"]</dt>
                                    <dd class="provider-dialog__identifier">@GetServiceKeyText(Provider)</dd>
                                </div>

                                <div class="provider-dialog__stat">
                                    <dt>@L["ProviderDetail:Labels:StorageMode"]</dt>
                                    <dd>@GetStorageModeText(Provider)</dd>
                                </div>

                                <div class="provider-dialog__stat">
                                    <dt>@L["ProviderDetail:Labels:ImplementationType"]</dt>
                                    <dd class="provider-dialog__identifier">@Provider.ImplementationType</dd>
                                </div>
                            </dl>

                            <div class="provider-dialog__section">
                                <div class="provider-dialog__section-header">
                                    <MudText Typo="Typo.subtitle1">@L["ProviderDetail:Labels:SupportedCapabilities"]</MudText>
                                </div>

                                <div class="provider-dialog__chips">
                                    @foreach (var capability in GetCapabilityLabels(Provider))
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@capability</MudChip>
                                    }
                                </div>
                            </div>
                        </div>
                    </MudTabPanel>

                    <MudTabPanel Text="@L["ProviderDetail:Tabs:Options"]" Icon="@MoIcons.Settings">
                        <div class="provider-dialog__tab-content">
                            <h3>@L["ProviderDetail:Tabs:ConfigOptions"]</h3>
                            <p>@L["ProviderDetail:Messages:ConfigurationDescription"]</p>
                            @if (IsVisible && _activeTabIndex == 1)
                            {
                                <StateStoreProviderOptions Provider="Provider" />
                            }
                        </div>
                    </MudTabPanel>
                </MudTabs>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <div class="provider-dialog__actions">
            <MudButton Class="state-dialog-primary-text" Color="Color.Primary" OnClick="OnClose">@L["ProviderDetail:Actions:Close"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool IsVisible { get; set; }

    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter] public StateStoreProviderInfo? Provider { get; set; }

    private DialogOptions DialogOptions { get; } = new()
    {
        CloseButton = true,
        CloseOnEscapeKey = true,
        FullWidth = true,
        MaxWidth = MaxWidth.Large
    };

    private string? _providerIdentity;
    private int _activeTabIndex;

    protected override void OnParametersSet()
    {
        var providerIdentity = Provider?.UniqueId;
        if (!string.Equals(_providerIdentity, providerIdentity, StringComparison.Ordinal))
        {
            _providerIdentity = providerIdentity;
            ResetTab();
        }

        if (!IsVisible)
        {
            ResetTab();
        }
    }

    private Task OnClose() => SetVisibilityAsync(false);

    private Task OnVisibleChanged(bool isVisible) => SetVisibilityAsync(isVisible);

    private async Task SetVisibilityAsync(bool isVisible)
    {
        if (IsVisible == isVisible)
        {
            return;
        }

        IsVisible = isVisible;
        if (!isVisible)
        {
            ResetTab();
        }

        await IsVisibleChanged.InvokeAsync(isVisible);
    }

    private void OnActiveTabChanged(int tabIndex) => _activeTabIndex = tabIndex;

    private void ResetTab() => _activeTabIndex = 0;

    public void Dispose()
    {
        ResetTab();
    }

    private string GetServiceKeyText(StateStoreProviderInfo provider)
    {
        return string.IsNullOrWhiteSpace(provider.ServiceKey)
            ? L["ProviderDetail:Labels:DefaultNoKey"]
            : provider.ServiceKey;
    }

    private string GetStorageModeText(StateStoreProviderInfo provider)
    {
        return provider.IsDistributed
            ? L["ProviderDetail:Labels:Distributed"]
            : L["ProviderDetail:Labels:LocalMemory"];
    }

    private string GetProviderSummary(StateStoreProviderInfo provider)
    {
        return $"{L.GetProviderTypeText(provider.ProviderType)} · {GetStorageModeText(provider)}";
    }

    private List<string> GetCapabilityLabels(StateStoreProviderInfo provider)
    {
        var labels = new List<string>
        {
            provider.SupportsKeyScanning
                ? L["ProviderDetail:Capabilities:KeyScanning"]
                : L["ProviderDetail:Capabilities:NoScanning"]
        };

        if (provider.SupportsExactLookup)
        {
            labels.Add(L["KeyExplorer:Labels:ExactLookupMode"]);
        }

        if (provider.SupportsValuePreview)
        {
            labels.Add(L["KeyExplorer:Labels:ValuePreview"]);
        }

        if (provider.SupportsKeyTTL)
        {
            labels.Add(L["KeyExplorer:Detail:Labels:TTL"]);
        }

        if (provider.SupportsKeyCreation)
        {
            labels.Add(L["KeyExplorer:Actions:Create"]);
        }

        if (provider.SupportsKeyUpdate)
        {
            labels.Add(L["KeyExplorer:Actions:Edit"]);
        }

        if (provider.SupportsKeyDeletion)
        {
            labels.Add(L["KeyExplorer:Actions:Delete"]);
        }

        if (provider.Capabilities.HasFlag(EStateStoreCapabilities.QueryState))
        {
            labels.Add(L["ProviderDetail:Capabilities:QueryState"]);
        }

        if (provider.Capabilities.HasFlag(EStateStoreCapabilities.BulkOperations))
        {
            labels.Add(L["ProviderDetail:Capabilities:BulkOperations"]);
        }

        return labels;
    }
}
