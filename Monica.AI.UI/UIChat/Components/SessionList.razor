@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@inject IStringLocalizer<AIResource> L

<div class="session-list">
    <div class="session-header">
        <div class="session-heading">
            <span>@L["Session:Conversations"]</span>
            @if (ShowClose)
            {
                <MudIconButton Icon="@MoIcons.Close" Size="Size.Small" OnClick="OnClose" aria-label="@L["Session:CloseHistory"]" />
            }
        </div>
        <MudButton @ref="_newChatButton" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.NotebookEdit"
                   Class="new-chat-button" Disabled="@(IsLoading || Disabled)" OnClick="@OnNewSession">
            @L["Session:NewChat"]
        </MudButton>
    </div>
    <div class="session-list-content @(IsLoading || Sessions.Count == 0 ? "is-empty" : null)" aria-busy="@IsLoading.ToString().ToLowerInvariant()">
        @if (IsLoading)
        {
            <MoContentState Compact="true" Loading="true" Class="session-loading">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                <span>@L["Chat:History:Loading"]</span>
            </MoContentState>
        }
        else if (Sessions.Count == 0)
        {
            <MoContentState Compact="true" Class="empty-sessions">
                <MoIcon Icon="@MoIcons.Message" Size="1.5rem" />
                <span>@L["Session:NoConversations"]</span>
                <small>@L["Session:EmptyHint"]</small>
            </MoContentState>
        }
        else
        {
            @foreach (var group in Sessions.GroupBy(item => item.IsPinned).OrderByDescending(group => group.Key))
            {
                <section class="session-group" aria-label="@(group.Key ? L["Session:Pinned"] : L["Session:RecentSessions"])">
                    <div class="session-group-heading">
                        <span>@(group.Key ? L["Session:Pinned"] : L["Session:RecentSessions"])</span>
                        <span class="session-count">@group.Count()</span>
                    </div>
                    @foreach (var session in group)
                    {
                        <SessionListItem @key="session.SessionId" Session="@session" Selected="@(session.SessionId == CurrentSessionId)"
                                         Disabled="@Disabled" OnSelect="@(() => OnSelectSession.InvokeAsync(session.SessionId))"
                                         FocusRequest="@(session.SessionId == _focusSessionId ? _focusRequest : 0)" FocusPin="@_focusPin"
                                         OnPin="@(() => PinAsync(session.SessionId))"
                                         OnArchive="@(() => ArchiveAsync(session.SessionId))" />
                    }
                </section>
            }
        }
    </div>
    <div class="session-footer">
        <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@MoIcons.Archive"
                   Class="archive-manager-button" Disabled="@(IsLoading || Disabled)" OnClick="@OnOpenArchive">
            <span>@L["Session:Archive:Title"]</span>
            @if (ArchivedCount > 0) { <span class="archive-count">@ArchivedCount</span> }
        </MudButton>
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<ChatSessionSummary> Sessions { get; set; } = [];
    [Parameter] public string? CurrentSessionId { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public int ArchivedCount { get; set; }
    [Parameter] public EventCallback OnNewSession { get; set; }
    [Parameter] public EventCallback<string> OnSelectSession { get; set; }
    [Parameter] public EventCallback<string> OnPinSession { get; set; }
    [Parameter] public EventCallback<string> OnArchiveSession { get; set; }
    [Parameter] public EventCallback OnOpenArchive { get; set; }
    [Parameter] public bool ShowClose { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private MudButton? _newChatButton;
    private string? _focusSessionId;
    private int _focusRequest;
    private bool _focusPin;
    private bool _focusNewChat;

    private async Task PinAsync(string sessionId)
    {
        await OnPinSession.InvokeAsync(sessionId);
        _focusSessionId = sessionId;
        _focusPin = true;
        _focusRequest++;
    }

    private async Task ArchiveAsync(string sessionId)
    {
        await OnArchiveSession.InvokeAsync(sessionId);
        _focusSessionId = CurrentSessionId;
        _focusPin = false;
        _focusRequest++;
        _focusNewChat = _focusSessionId is null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNewChat && !Disabled && !IsLoading && _newChatButton is { } button)
        {
            _focusNewChat = false;
            await button.FocusAsync();
        }
    }
}
