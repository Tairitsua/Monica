@using Monica.UI.Shared.Components.Dialogs
@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L
@implements IAsyncDisposable

<MudDialog ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent><MoDialogHeading Text="@L["Versions:Rollback:Title", VersionLabel]" /></TitleContent>
    <DialogContent>
        <div class="unified-version-rollback-dialog">
            <header class="unified-version-rollback-context">
                <MoIcon Icon="@MoIcons.Restore" Size="1.5rem" />
                <div>
                    <h3>@VersionLabel</h3>
                    @if (_preview is not null)
                    {
                        <dl><div><dt>@L["Versions:Rollback:Fields:PreviewFingerprint"]</dt><dd><code>@_preview.PreviewFingerprint</code></dd></div></dl>
                    }
                </div>
            </header>
            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_error</MudAlert>
            }
            @if (_preview is not null)
            {
                <MudAlert Icon="@((PreviewMessageSeverity) switch { Severity.Success => MoIcons.Success, Severity.Warning => MoIcons.Warning, Severity.Error => MoIcons.Error, _ => MoIcons.Info })" Severity="@PreviewMessageSeverity" Variant="Variant.Outlined">@PreviewMessage</MudAlert>
                <ConfigurationUnifiedVersionRollbackPreview Preview="@_preview" LoadingChanged="OnPreviewLoadingChanged" />
                <div class="unified-version-rollback-reason">
                    <MudTextField T="string" @bind-Value="_reason" Label="@L["Group:Reason"]" Variant="Variant.Outlined" Lines="2" Disabled="@(_saving || _reloading)" />
                </div>
            }
            @if (_saving || _reloading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="unified-version-rollback-actions">
            <MudButton OnClick="Cancel" Disabled="@(_saving || _reloading)">@L["Common:Actions:Cancel"]</MudButton>
            @if (HasRuntimeOutOfSync)
            {
                <MudButton Color="Color.Default" Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh"
                           OnClick="ReloadAndRefreshAsync" Disabled="@(_loading || _saving || _reloading)">
                    @L["Versions:Rollback:Actions:ReloadAndRefresh"]
                </MudButton>
            }
            <MudButton StartIcon="@MoIcons.Refresh" OnClick="RefreshPreviewAsync" Disabled="@(_loading || _saving || _reloading)">@L["Common:Actions:Refresh"]</MudButton>
            <MudButton Color="Color.Default" Variant="Variant.Filled" Class="unified-version-rollback-apply" StartIcon="@MoIcons.Restore"
                       OnClick="ApplyAsync" Disabled="@(!CanApply)">@L["Versions:Rollback:Actions:Apply"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    /// <summary>Gets the exact unified version frozen when this native rollback dialog initializes.</summary>
    [Parameter] public long Version { get; set; }
    private readonly ConfigurationOperationLifetime _operations = new();
    private ConfigurationUnifiedVersionApplyPreview? _preview;
    private long _version;
    private string? _reason;
    private string? _error;
    private bool _loading = true;
    private bool _loadingPreviewDetails = true;
    private bool _saving;
    private bool _reloading;
    private string VersionLabel => ConfigurationUnifiedVersionJsonFormatter.VersionLabel(_version);
    private bool CanApply => !_operations.IsRetired && !_loading && !_loadingPreviewDetails && !_saving && !_reloading && _preview?.CanApply == true;
    private bool HasRuntimeOutOfSync => _preview?.Targets.Any(static target => target.Status == ConfigurationUnifiedVersionApplyTargetStatus.RuntimeOutOfSync) == true;

    private Severity PreviewMessageSeverity => _preview switch
    {
        { } preview when preview.Problems.Count > 0 || preview.ValidationReports.Any(report => !report.IsValid) => Severity.Error,
        { BlockedCount: > 0 } => Severity.Error,
        { HasChanges: false, SkippedCount: > 0 } => Severity.Warning,
        { HasChanges: false } => Severity.Info,
        { SkippedCount: > 0 } => Severity.Warning,
        { CompatibleSchemaDriftCount: > 0 } => Severity.Info,
        _ => Severity.Success
    };
    private string PreviewMessage => _preview switch
    {
        { } preview when preview.ValidationReports.Any(report => report.Coverage == ConfigurationValidationCoverage.Failed) => L["Validation:FailedNotice"],
        { } preview when preview.ValidationReports.Any(report => report.Coverage == ConfigurationValidationCoverage.SchemaOnly) => L["Validation:SchemaOnlySummary"],
        { } preview when preview.ValidationReports.Any(report => !report.IsValid) => L["Validation:Invalid"],
        { } preview when preview.Problems.Count > 0 => L["Validation:PreviewBlocked"],
        { BlockedCount: > 0 } => L["Versions:Rollback:Messages:Blocked"],
        { HasChanges: false, SkippedCount: > 0 } preview => L["Versions:Rollback:Messages:NoChangesSkipped", preview.SkippedCount],
        { HasChanges: false } => L["Versions:Rollback:Messages:NoChanges"],
        { SkippedCount: > 0 } preview => L["Versions:Rollback:Messages:Skipped", preview.SkippedCount],
        { CompatibleSchemaDriftCount: > 0 } => L["Versions:Rollback:Messages:CompatibleSchemaDrift"],
        _ => L["Versions:Rollback:Messages:Ready"]
    };

    protected override async Task OnInitializedAsync()
    {
        _version = Version;
        await RunOwnedAsync(token => LoadPreviewCoreAsync(token));
    }
    private Task RefreshPreviewAsync() => _loading || _saving || _reloading || _operations.IsRetired
        ? Task.CompletedTask : RunOwnedAsync(token => LoadPreviewCoreAsync(token));

    private async Task LoadPreviewCoreAsync(CancellationToken token, bool preserveError = false)
    {
        token.ThrowIfCancellationRequested();
        _loading = true;
        _loadingPreviewDetails = true;
        if (!preserveError) _error = null;
        _preview = null;
        try
        {
            var result = await Facade.PreviewUnifiedVersionRollbackAsync(_version, token);
            token.ThrowIfCancellationRequested();
            _operations.TryApply(() =>
            {
                var error = result;
                var preview = result.Data;
                if (result.IsFailure() || preview is null)
                {
                    var message = error.Message ?? L["Common:Errors:LoadFailed"].Value;
                    _error = preserveError && !string.IsNullOrWhiteSpace(_error) ? $"{_error}{Environment.NewLine}{message}" : message;
                    _preview = result.Data;
                }
                else _preview = preview;
            });
        }
        finally { _operations.TryApply(() => _loading = false); }
    }

    private async Task ApplyAsync()
    {
        if (!CanApply || _preview is null) return;
        var request = new ConfigurationUnifiedVersionRollbackRequest
        {
            Version = _version, PreviewFingerprint = _preview.PreviewFingerprint, Reason = _reason
        };
        var options = MudDialog.Options;
        _saving = true;
        _error = null;
        await RunOwnedAsync(async token =>
        {
            var closed = false;
            try
            {
                await MudDialog.SetOptionsAsync(options with { BackdropClick = false, CloseOnEscapeKey = false, CloseButton = false });
                token.ThrowIfCancellationRequested();
                // Apply is tokenless: retirement joins its actual outcome and cannot reverse persistence.
                var result = await Facade.RollbackUnifiedVersionAsync(request);
                if (_operations.IsRetired) return;
                var error = result;
                var rollback = result.Data;
                if (result.IsFailure() || rollback is null)
                {
                    _error = error.Message ?? L["Common:Errors:LoadFailed"].Value;
                    await LoadPreviewCoreAsync(token, preserveError: true);
                    return;
                }
                MudDialog.Close(DialogResult.Ok(rollback));
                closed = true;
            }
            finally
            {
                if (!_operations.IsRetired && !closed)
                {
                    try { await MudDialog.SetOptionsAsync(options); }
                    finally { _operations.TryApply(() => _saving = false); }
                }
            }
        });
    }

    private async Task ReloadAndRefreshAsync()
    {
        if (_operations.IsRetired || _loading || _saving || _reloading || !HasRuntimeOutOfSync) return;
        var options = MudDialog.Options;
        _reloading = true;
        _error = null;
        await RunOwnedAsync(async token =>
        {
            try
            {
                await MudDialog.SetOptionsAsync(options with { BackdropClick = false, CloseOnEscapeKey = false, CloseButton = false });
                token.ThrowIfCancellationRequested();
                var result = await Facade.ReloadRuntimeConfigurationAsync();
                if (_operations.IsRetired) return;
                var error = result;
                if (result.IsFailure()) { _error = error.Message; return; }
                await LoadPreviewCoreAsync(token);
            }
            finally
            {
                if (!_operations.IsRetired)
                {
                    try { await MudDialog.SetOptionsAsync(options); }
                    finally { _operations.TryApply(() => _reloading = false); }
                }
            }
        });
    }
    private async Task RunOwnedAsync(Func<CancellationToken, Task> action)
    {
        try { await _operations.RunAsync(action); }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
        catch (Exception exception) when (!_operations.IsRetired) { _error = exception.Message; }
    }
    private void OnPreviewLoadingChanged(bool loading) => _operations.TryApply(() => _loadingPreviewDetails = loading);
    private void Cancel() { if (!_operations.IsRetired && !_saving && !_reloading) MudDialog.Cancel(); }
    /// <summary>Rejects new work and joins actual preview reads, runtime reload and tokenless rollback apply.</summary>
    /// <remarks>Repeated disposal joins the same completion. Persistence is not cancelled or reversed, and no late native UI is adopted.</remarks>
    public ValueTask DisposeAsync() => _operations.RetireAsync();
}
