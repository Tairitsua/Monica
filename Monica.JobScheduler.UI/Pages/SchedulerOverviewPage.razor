@using Monica.UI.Shared.Components.States
@attribute [Route(PAGE_URL)]

@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Components
@using Monica.JobScheduler.UI.UIJobScheduler.State

@inject SchedulerOverviewPageStateFactory PageStateFactory
@inject IOptions<ModuleJobSchedulerUIOption> UiOptions
@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation
@inject NavigationManager Navigation

@implements IAsyncDisposable

<PageTitle>@L["Overview:PageTitle"]</PageTitle>

<SchedulerWorkspace Title="@L["Workspace:Pages:Overview:Title"]"
                    Description="@L["Workspace:Pages:Overview:Description"]"
                    ActivePanelIndex="0">
    @if (_state is not null)
    {
        <SchedulerAccessBoundary AccessChecked="@_state.AccessChecked" IsAuthorized="@_state.IsAuthorized">
            <div class="overview-page">
                @if (_state.IsLoading && _state.Overview is null)
                {
                    <MoContentState Loading="true">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        <MudText Typo="Typo.body2">@L["Common:Loading"]</MudText>
                    </MoContentState>
                }
                else if (_state.Error is not null && _state.Overview is null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">
                        @_state.Error
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="RefreshAsync">
                            @L["Common:Retry"]
                        </MudButton>
                    </MudAlert>
                }
                else if (_state.Overview is { } overview)
                {
                    <SchedulerSnapshotActions CapturedAtUtc="@(_state.LastRefreshedUtc ?? overview.CapturedAtUtc)" IsLoading="@_state.IsLoading" RefreshRequested="RefreshAsync" AutoRefreshEnabled="@(UiOptions.Value.AutoRefreshInterval > TimeSpan.Zero ? _state.AutoRefreshEnabled : (bool?)null)" AutoRefreshChanged="SetAutoRefresh" />

                    @if (_state.Error is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Warning">
                            @L["Overview:RefreshFailed", _state.Error]
                        </MudAlert>
                    }

                    <SchedulerPulse Definitions="@overview.Definitions" CapturedAtUtc="@overview.CapturedAtUtc" StateCounts="@overview.ExecutionStateCounts"
                                    WindowMinutes="@WindowMinutes" WindowChanged="SetWindow" Search="@Search" SearchChanged="SetSearch" />

                    <RecentExecutionsPanel Executions="@overview.RecentExecutions"
                                           IsRefreshing="@_state.IsLoading"
                                           OnRefresh="RefreshAsync" />

                    <aside class="overview-page__insight" aria-labelledby="overview-insight-title">
                        <span class="overview-page__insight-icon" aria-hidden="true">
                            <MoIcon Icon="@MoIcons.ChartTrend" Size="1.5rem" />
                        </span>
                        <div>
                            <MudText id="overview-insight-title" Typo="Typo.h6" HtmlTag="h2">
                                @L["Overview:Analytics:Title"]
                            </MudText>
                            <MudText Typo="Typo.body2">
                                @L["Overview:Analytics:Description"]
                            </MudText>
                        </div>
                        <MudButton Href="@SchedulerStatisticsPage.PAGE_URL"
                                   Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   EndIcon="@MoIcons.ArrowRight">
                            @L["Overview:Analytics:Action"]
                        </MudButton>
                    </aside>
                }
            </div>
        </SchedulerAccessBoundary>
    }
</SchedulerWorkspace>

@code {
    public const string PAGE_URL = "/job-scheduler";

    private SchedulerOverviewPageState? _state;
    private volatile bool _disposed;
    private readonly object _lifetimeGate = new();
    private TaskCompletionSource? _retirement;

    /// <summary>Gets the route-held diagnostic window (15m, 1h, 24h).</summary>
    [SupplyParameterFromQuery(Name = "window")] public string? Window { get; set; }
    /// <summary>Gets the route-held pulse name, key or owner filter.</summary>
    [SupplyParameterFromQuery(Name = "q")] public string? Search { get; set; }
    private int WindowMinutes => Window switch { "15m" => 15, "24h" => 1440, _ => 60 };
    private void SetWindow(int minutes) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("window", minutes == 15 ? "15m" : minutes == 1440 ? "24h" : "1h"));
    private void SetSearch(string value) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("q", string.IsNullOrEmpty(value) ? null : value), replace: true);
    private void SetAutoRefresh(bool enabled) { if (_state is { } state && !_disposed) state.SetAutoRefreshEnabled(enabled); }

    protected override async Task OnInitializedAsync()
    {
        _state = PageStateFactory.Create(UiOptions.Value.AutoRefreshInterval);
        _state.Changed += OnStateChangedAsync;
        await _state.InitializeAsync();
    }

    private Task OnStateChangedAsync() => _disposed ? Task.CompletedTask : InvokeAsync(() =>
    {
        if (!_disposed) StateHasChanged();
    });

    private Task RefreshAsync()
    {
        SchedulerOverviewPageState? state;
        lock (_lifetimeGate)
        {
            if (_disposed) return Task.CompletedTask;
            state = _state;
        }
        return state?.RefreshAsync() ?? Task.CompletedTask;
    }

    public ValueTask DisposeAsync()
    {
        TaskCompletionSource completion;
        SchedulerOverviewPageState? state;
        lock (_lifetimeGate)
        {
            if (_retirement is not null) return new ValueTask(_retirement.Task);
            _disposed = true;
            completion = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
            _retirement = completion;
            state = _state;
            _state = null;
        }
        _ = CompleteRetirementAsync(state, completion);
        return new ValueTask(completion.Task);
    }

    private async Task CompleteRetirementAsync(
        SchedulerOverviewPageState? state, TaskCompletionSource completion)
    {
        try
        {
            if (state is not null)
            {
                state.Changed -= OnStateChangedAsync;
                await state.DisposeAsync();
            }
            completion.TrySetResult();
        }
        catch (Exception exception) { completion.TrySetException(exception); }
    }
}
