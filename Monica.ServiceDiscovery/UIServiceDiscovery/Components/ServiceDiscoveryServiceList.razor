@using Microsoft.Extensions.Options
@using Monica.Modules
@using Monica.ServiceDiscovery.Abstractions
@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Support
@inject IOptions<ModuleServiceDiscoveryUIOption> Options
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IStringLocalizer<ServiceDiscoveryResource> L
@implements IDisposable

<div class="service-registry-frame">
    <div class="registry-order"><span>@L["Workbench:ObservedInstanceHelp"]</span><div><MudSelect T="string" Value="_sortField" ValueChanged="SetSortAsync" Label="@L["Workbench:SortBy"]" Variant="Variant.Outlined" Margin="Margin.Dense" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
        <MudSelectItem Value="@("AppName")">@L["ServiceList:Columns:ServiceName"]</MudSelectItem><MudSelectItem Value="@("AppId")">@L["ServiceList:Columns:AppId"]</MudSelectItem><MudSelectItem Value="@("ProjectName")">@L["ServiceList:Columns:ProjectName"]</MudSelectItem><MudSelectItem Value="@("DomainName")">@L["ServiceList:Columns:Domain"]</MudSelectItem><MudSelectItem Value="@("TotalInstanceCount")">@L["ServiceList:Columns:InstanceCount"]</MudSelectItem><MudSelectItem Value="@("OverallStatus")">@L["ServiceList:Columns:OverallStatus"]</MudSelectItem><MudSelectItem Value="@("AssemblyVersion")">@L["ServiceList:Columns:AssemblyVersion"]</MudSelectItem><MudSelectItem Value="@("BuildTime")">@L["ServiceList:Columns:BuildTime"]</MudSelectItem><MudSelectItem Value="@("LastHeartbeatTime")">@L["ServiceList:Columns:LastHeartbeat"]</MudSelectItem>
    </MudSelect><MudIconButton Icon="@(_descending ? MoIcons.ArrowDown : MoIcons.ArrowUp)" OnClick="ReverseSortAsync" aria-label="@L["Workbench:ReverseSort"]" /></div></div>
    <MudDataGrid @ref="_grid" T="RegisteredServiceStatus" Items="@Services" Square="true" Breakpoint="Breakpoint.None" Hover="true" Dense="false" Loading="@IsLoading" Elevation="0" Class="service-registry-grid" RowsPerPage="10" SortDefinitions="_sortDefinitions" SortIcon="@MoIcons.ArrowUp" DragIndicatorIcon="@MoIcons.GripVertical" FilterIconEmpty="@MoIcons.Filter" FilterIconFilled="@MoIcons.Filter" FilterIconClear="@MoIcons.FilterOff" ColumnOptionsIcon="@MoIcons.MoreVertical">
        <Columns>
            <TemplateColumn Title="@L["ServiceList:Columns:ServiceName"]" Sortable="false">
                <CellTemplate><div class="registry-service-identity"><button type="button" @onclick="() => InspectAsync(context.Item)">@context.Item.AppName</button><code>@context.Item.AppId</code><span>@Value(context.Item.ProjectName)</span></div></CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="@(s => string.Join(", ", s.GetDomainNames()))" Sortable="false" Title="@L["ServiceList:Columns:Domain"]" />
            <TemplateColumn Title="@L["ServiceList:Columns:InstanceCount"]" Sortable="false">
                <CellTemplate><div class="registry-members"><strong>@context.Item.TotalInstanceCount</strong><span>@(context.Item.TotalInstanceCount > 0 ? L["Workbench:Registered"] : L["Workbench:ExpectedOnly"])</span></div><div class="registry-instance-marks">@foreach (var instance in context.Item.Instances.Values.Take(3)) { <MudTooltip Text="@($"{instance.InstanceId} · {instance.Status.GetText(L)}{(instance.IsLeader ? " · " + L["Workbench:HeartbeatReportedLeader"].Value : string.Empty)}")"><span class="registry-instance-mark">@(instance.IsLeader ? "◇" : "·")</span></MudTooltip> } @if(context.Item.TotalInstanceCount > 3) { <span>+@(context.Item.TotalInstanceCount - 3)</span> }</div></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["ServiceList:Columns:OverallStatus"]" Sortable="false">
                <CellTemplate><span class="registry-membership-status" data-status-tone="@context.Item.OverallStatus.GetColor()">@context.Item.OverallStatus.GetText(L)</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["Workbench:ObservedBuild"]" Sortable="false">
                <CellTemplate>@{ var observed=context.Item.GetValidInstanceInfo(); }<div class="registry-observed"><code>@Value(observed?.AssemblyVersion)</code><time>@Time(observed?.BuildTime)</time></div></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@L["ServiceList:Columns:LastHeartbeat"]" Sortable="false">
                <CellTemplate><time class="registry-heartbeat">@Time(context.Item.GetValidInstanceInfo()?.LastHeartbeatTime)</time></CellTemplate>
            </TemplateColumn>
            @foreach (var key in DisplayKeys)
            {
                <TemplateColumn Title="@key" Sortable="false"><CellTemplate><div class="registry-metadata"><MetadataValueDisplay Value="@Value(context.Item.GetValidInstanceInfo()?.Metadata.GetValueOrDefault(key))" IsCompactMode="true" /></div></CellTemplate></TemplateColumn>
            }
            <TemplateColumn Title="@L["Workbench:Actions"]" Sortable="false">
                <CellTemplate><div class="registry-service-actions"><MudIconButton Icon="@MoIcons.Copy" Size="Size.Small" OnClick="() => CopyAsync(context.Item.AppId)" aria-label="@L["Workbench:CopyId", context.Item.AppId]" /><MudIconButton Icon="@MoIcons.ArrowUpRight" Size="Size.Small" OnClick="() => InspectAsync(context.Item)" aria-label="@L["Workbench:InspectService", context.Item.AppName]" /></div></CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent><MudDataGridPager T="RegisteredServiceStatus" PageSizeOptions="@(new[] { 10, 25, 50 })" /></PagerContent>
    </MudDataGrid>
</div>
<DiscoveryInspectorHost @ref="_inspector" />

@code {
    [Parameter] public List<RegisteredServiceStatus> Services { get; set; } = [];
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public DateTime? CapturedAt { get; set; }
    private DiscoveryInspectorHost? _inspector;
    private MudDataGrid<RegisteredServiceStatus>? _grid;
    private string _sortField = "AppName";
    private bool _descending;
    private bool _disposed;
    private readonly Dictionary<string, SortDefinition<RegisteredServiceStatus>> _sortDefinitions = new()
    {
        ["AppName"] = new("AppName", false, 0, service => service.AppName)
    };
    private async Task SetSortAsync(string field) { _sortField=field;await ApplySortAsync(); }
    private async Task ReverseSortAsync() { _descending=!_descending;await ApplySortAsync(); }
    private Task ApplySortAsync() => _grid?.SetSortAsync(_sortField,_descending ? SortDirection.Descending : SortDirection.Ascending,SortValue) ?? Task.CompletedTask;
    private object? SortValue(RegisteredServiceStatus service) => _sortField switch
    {
        "AppId" => service.AppId, "ProjectName" => service.ProjectName, "DomainName" => string.Join(", ", service.GetDomainNames()),
        "TotalInstanceCount" => service.TotalInstanceCount, "OverallStatus" => service.OverallStatus,
        "AssemblyVersion" => service.GetValidInstanceInfo()?.AssemblyVersion, "BuildTime" => service.GetValidInstanceInfo()?.BuildTime,
        "LastHeartbeatTime" => service.GetValidInstanceInfo()?.LastHeartbeatTime, _ => service.AppName
    };
    private IEnumerable<string> DisplayKeys => Options.Value.DisplayMetadataKeys
        .Concat(Options.Value.DisableListeningAddressDisplay ? [] : new[] { IServiceDiscoveryClientInfo.LISTENING_ADDRESS_METADATA_KEY })
        .Distinct(StringComparer.Ordinal).Where(key => Services.Any(service => service.GetValidInstanceInfo()?.Metadata.ContainsKey(key) == true));
    private Task InspectAsync(RegisteredServiceStatus service) => _inspector?.ShowAsync(service, CapturedAt) ?? Task.CompletedTask;
    private string Value(string? value) => string.IsNullOrEmpty(value) ? L["Shared:Values:NotAvailable"].Value : value;
    private string Time(DateTime? value) => value is null || value == default(DateTime) ? L["Shared:Values:NotAvailable"].Value : value.Value.ToLocalTime().ToString("MM-dd HH:mm:ss");
    private async Task CopyAsync(string value)
    {
        if (_disposed) return;
        try { await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value); if (!_disposed) Snackbar.Add(L["ServiceGraph:Messages:CopiedServiceId"].Value, Severity.Success); }
        catch (JSDisconnectedException) { }
        catch (JSException exception) { if (!_disposed) Snackbar.Add(L["Atlas:Shared:ClipboardFailed",exception.Message].Value,Severity.Warning); }
    }
    public void Dispose() => _disposed = true;
}
