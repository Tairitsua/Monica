@using Monica.UI.Shared.Components.States
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.Framework.UI.UILogging.Models
@inject IStringLocalizer<LoggingResource> L

<div class="log-file-table">
    <div class="table-header-section">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
            <MudText Typo="Typo.subtitle1">@L["Page:Components:Files:Title"]</MudText>
            <MudButton Variant="Variant.Text" StartIcon="@MoIcons.Refresh" OnClick="HandleRefresh" Disabled="@IsLoading">@L["Page:Components:Files:Refresh"]</MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @L["Page:Components:Files:Directory", DisplayDirectory ?? L["Page:Components:Files:NotConfigured"]]
        </MudText>
    </div>

    <div class="table-container">
        <MudTable Items="@Files" Dense="true" Hover="true" Loading="@IsLoading" Elevation="0">
            <HeaderContent>
                <MudTh>@L["Page:Components:Files:RelativePath"]</MudTh>
                <MudTh>@L["Page:Components:Files:Size"]</MudTh>
                <MudTh>@L["Page:Components:Files:LastModified"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.RelativePath</MudTd>
                <MudTd>@FormatSize(context.Size)</MudTd>
                <MudTd>@UiTime.Format(context.LastModified)</MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@MoIcons.Download"
                               OnClick="() => HandleDownload(context.RelativePath)">
                        @L["Page:Components:Files:Download"]
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MoContentState Compact="true"><MoIcon Icon="@MoIcons.FolderOpen" Size="1.5rem" /><p>@L["Page:Components:Files:Empty"]</p></MoContentState>
            </NoRecordsContent>
        </MudTable>
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<LogFileDescriptor> Files { get; set; } = Array.Empty<LogFileDescriptor>();

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public string? CurrentDirectory { get; set; }

    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    [Parameter]
    public EventCallback<string> DownloadRequested { get; set; }

    private Task HandleRefresh() => RefreshRequested.InvokeAsync(null);

    private Task HandleDownload(string fileName) => DownloadRequested.InvokeAsync(fileName);

    private string? DisplayDirectory => string.IsNullOrWhiteSpace(CurrentDirectory)
        ? null
        : CurrentDirectory;

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        var size = bytes / 1024d;
        var unitIndex = 0;
        string[] units = new[] { "KB", "MB", "GB", "TB" };

        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }

        return $"{size:0.##} {units[unitIndex]}";
    }
}
