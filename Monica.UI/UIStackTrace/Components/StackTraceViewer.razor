@using Monica.UI.Shared.Support
@using Microsoft.Extensions.Logging
@using Monica.UI.UIStackTrace.Support
@implements IAsyncDisposable
@inject StackTraceParser ParserService
@inject IJSRuntime JS
@inject ILogger<StackTraceViewer> Logger
@inject IStringLocalizer<SharedResource> L

<div class="stack-trace-viewer @(_wrapLines ? "" : "is-unwrapped")">
    <div class="trace-toolbar">
        <span class="trace-caption">@L["StackTrace:Caption"]</span>
        <div class="trace-actions">
            <button type="button" class="trace-button trace-wrap" aria-pressed="@(_wrapLines ? "true" : "false")"
                    aria-disabled="@(HasSource ? "false" : "true")" @onclick="ToggleWrap">@L["StackTrace:WrapLines"]</button>
            <button type="button" class="trace-button trace-copy" aria-label="@L["StackTrace:CopyLabel"]"
                    aria-disabled="@(CopyState.CanCopy ? "false" : "true")" aria-busy="@(CopyState.IsCopying ? "true" : "false")"
                    @onclick="CopyToClipboard">
                <MoIcon Size="1.5rem" Icon="@MoIcons.Copy" aria-hidden="true" />
                <span>@L["StackTrace:Copy"]</span>
            </button>
        </div>
    </div>
    <div class="trace-feedback" role="status" aria-live="polite" aria-atomic="true">@CopyFeedback</div>
    @if (!HasSource)
    {
        <p class="trace-note">@L["StackTrace:NotProvided"]</p>
    }
    else
    {
        @if (string.IsNullOrWhiteSpace(_source))
        {
            <p class="trace-note">@L["StackTrace:WhitespaceOnly"]</p>
        }
        <div class="trace-evidence">
            <pre class="trace-source" tabindex="0" aria-label="@L["StackTrace:SourceLabel"]"><code>@SourceContent</code></pre>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the complete diagnostic source. All text is encoded and retained in source order;
    /// copy uses this exact string. Null or empty input shows a neutral absence, while whitespace is
    /// retained and copyable. Replacing source resets wrapping and invalidates pending copy feedback.
    /// </summary>
    [Parameter]
    public string? Message { get; set; }

    private TextCopySession? _copy;
    private string? _source;
    private IReadOnlyList<StackTraceSourceSpan> _spans = [];
    private bool _wrapLines = true;
    private bool _retired;
    private bool HasSource => !string.IsNullOrEmpty(_source);
    private TextCopyState CopyState => _copy?.State ?? default;
    private string CopyFeedback => CopyState.Feedback switch
    {
        TextCopyFeedback.Copied => L["StackTrace:Copied"],
        TextCopyFeedback.Failed => L["StackTrace:CopyFailed"],
        _ => string.Empty
    };

    protected override void OnInitialized() => _copy = new(JS, Logger);

    protected override void OnParametersSet()
    {
        if (_retired || _copy?.SetSource(Message) != true) return;
        _source = Message;
        _wrapLines = true;
        _spans = StackTraceSourcePresentation.Create(_source, ParserService);
    }

    private RenderFragment SourceContent => builder =>
    {
        if (_source is not { } source) return;
        foreach (var span in _spans)
        {
            var text = source.Substring(span.Start, span.Length);
            if (span.Role == StackTraceSourceRole.Plain)
            {
                builder.AddContent(0, text);
            }
            else
            {
                builder.OpenElement(1, "span");
                builder.AddAttribute(2, "class", span.Role switch
                {
                    StackTraceSourceRole.ExceptionType => "trace-token-type",
                    StackTraceSourceRole.Method => "trace-token-method",
                    StackTraceSourceRole.Location => "trace-token-location",
                    _ => "trace-token-muted"
                });
                builder.AddContent(3, text);
                builder.CloseElement();
            }
        }
    };

    private void ToggleWrap()
    {
        if (!_retired && HasSource) _wrapLines = !_wrapLines;
    }

    private Task CopyToClipboard() => !_retired && CopyState.CanCopy && _copy is { } copy
        ? copy.CopyAsync() : Task.CompletedTask;

    /// <summary>Retires this viewer and drains its admitted clipboard write without disposing the borrowed runtime.</summary>
    public ValueTask DisposeAsync()
    {
        _retired = true;
        return _copy?.DisposeAsync() ?? ValueTask.CompletedTask;
    }
}
