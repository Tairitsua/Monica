@using Monica.JobScheduler.Models.Operations
@using Monica.JobScheduler.UI.Localization
@inject IStringLocalizer<JobSchedulerResource> L

<section class="runtime-identity" aria-labelledby="runtime-identity-heading">
    <header class="runtime-identity__heading">
        <MoIcon Icon="@MoIcons.BadgeId" aria-hidden="true" Size="1.5rem" />
        <div>
            <h2 id="runtime-identity-heading">@L["Runtime:Identity:Title"]</h2>
            <p>@L["Runtime:Identity:Description"]</p>
        </div>
    </header>
    @if (Overview.Configuration.RecurringJobDebugMode)
    {
        <div class="runtime-identity__debug" role="note">
            <MoIcon Icon="@MoIcons.Bug" aria-hidden="true" Size="1.5rem" />
            <div>
                <strong>@L["Runtime:Identity:DebugMode"]</strong>
                <p>@L["Runtime:Identity:DebugModeHelp"]</p>
            </div>
        </div>
    }
    <dl class="runtime-identity__facts">
        <div class="runtime-identity__wide">
            <dt>@L["Runtime:Identity:Scope"]</dt>
            <dd><code>@Overview.Configuration.SchedulerScopeKey</code></dd>
        </div>
        <div class="runtime-identity__wide">
            <dt>@L["Runtime:Identity:Owner"]</dt>
            <dd><code>@string.Join(", ", Overview.Configuration.OwnerKeys)</code></dd>
        </div>
        <div class="runtime-identity__wide">
            <dt>@L["Runtime:Identity:WorkerInstanceId"]</dt>
            <dd><code>@Overview.Configuration.WorkerInstanceId</code></dd>
        </div>
        <div>
            <dt>@L["Runtime:Identity:CronTimeZone"]</dt>
            <dd><code>@Overview.Configuration.CronTimeZoneId</code></dd>
        </div>
        <div>
            <dt>@L["Runtime:Store:Title"]</dt>
            <dd><code>@Overview.Store.Kind</code></dd>
        </div>
        <div class="runtime-identity__wide">
            <dt>@L["Runtime:Store:Provider"]</dt>
            <dd><code>@(Overview.Store.Provider ?? L["Runtime:Store:NoProvider"])</code></dd>
        </div>
    </dl>
</section>

@code {
    /// <summary>Gets or sets the captured serving-host identity, storage and effective Cron timezone.</summary>
    /// <remarks>Exact identifiers are preserved. The caller owns authorization and the captured snapshot lifetime.</remarks>
    [Parameter, EditorRequired]
    public JobSchedulerRuntimeOverview Overview { get; set; } = null!;
}
