@using Monica.EventBus.Abstractions
@using Monica.EventBus.Models
@using Monica.Framework.UI.Pages
@using Monica.Framework.UI.UIEventBus.Support
@using Monica.UI.Shared.Components.States
@inject IStringLocalizer<EventBusResource> L
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime

@{
    var model = Workbench.Model!;
    var subscriptions = model.Snapshot.Subscriptions;
    var providers = model.Snapshot.Providers;
    var failed = model.Topics.FirstOrDefault(topic => topic.Coverage == EventBusCoverage.Failed);
    var recovering = model.Topics.FirstOrDefault(topic => topic.Coverage == EventBusCoverage.Recovering && !topic.IsOrphan);
    var gap = model.Topics.FirstOrDefault(topic => topic.IsActiveGap);
    var orphan = model.Topics.FirstOrDefault(topic => topic.IsOrphan);
    var errorTopic = model.Topics.FirstOrDefault(topic => topic.Coverage == EventBusCoverage.HealthyErr);
    var held = subscriptions.Count(row => row.State == EventSubscriptionState.Held);
    var disabled = subscriptions.Count(row => row.State == EventSubscriptionState.Disabled);
    var automatic = subscriptions.Count(row => row.IsAutoDiscovered);
    var distProviders = providers.Count(provider => provider.IsDistributed);
    var dist = Workbench.Query["dist"] == "topics" ? model.TopicKinds : model.EventKinds;
    var peak = Math.Max(1, dist.FirstOrDefault()?.Count ?? 1);
    var filter = Workbench.Query["coverage"] ?? "all";
    var search = Workbench.Query["q"] ?? "";
    var rows = model.Topics.Where(topic => MatchesCoverage(topic, filter) && MatchesSearch(topic, search)).ToArray();
}
<section class="eb-sig">
    <EventBusDecision Label="@L["Precision:OvLabel"]" Value="@model.Attention"
                      Population="@L[model.Attention == 0 ? "Precision:OvCalmUnit" : "Precision:OvUnit", model.Topics.Count]"
                      Role="@(model.Failed > 0 ? "error" : model.Attention > 0 ? "warning" : "success")">
        <Reasons>
            <EventBusReason Role="MoVisualRole.Error" Count="@model.Failed">@L["Precision:OvReasonFailed"]</EventBusReason>
            <EventBusReason Role="MoVisualRole.Warning" Count="@model.Topics.Count(topic => topic.Coverage == EventBusCoverage.Recovering && !topic.IsOrphan)">@L["Precision:OvReasonRecovering"]</EventBusReason>
            <EventBusReason Hatched="true" Count="@model.ActiveGaps">@L["Precision:OvReasonUnreported"]</EventBusReason>
            <EventBusReason Role="MoVisualRole.Warning" Diamond="true" Count="@model.Orphans">@L["Precision:OvReasonOrphan"]</EventBusReason>
        </Reasons>
        <Finding>
            @if (model.Attention == 0)
            {
                @L["Precision:OvNoAttention", model.Reported, model.Topics.Count]
            }
            @if (failed is not null)
            {
                <span class="vmark mo-vl-role--error">@L[model.Failed == 1 ? "Precision:OvFailedOne" : "Precision:OvFailedFinding", model.Failed]</span>@(" ")
                <a href="@Workbench.InspectionLink("topicKey", failed.Id)" class="vmark is-link mo-vl-role--error">@failed.Topic</a>@(" ")
                <span>@L["Precision:OvFailedDetail", failed.Active, failed.Status?.ConsecutiveFailures ?? 0]</span>@(" ")
            }
            @if (recovering is not null)
            {
                <span class="vmark mo-vl-role--warning">@L["Precision:OvRecoveringFinding"]</span>@(" ")
                <a href="@Workbench.InspectionLink("topicKey", recovering.Id)" class="vmark is-link mo-vl-role--warning">@recovering.Topic</a>@(" ")
                <span>@L["Precision:OvRecoveringDetail", recovering.Status?.ConsecutiveFailures ?? 0]</span>@(" ")
            }
            @if (gap is not null)
            {
                <span class="vmark mo-vl-role--warning">@L[model.ActiveGaps == 1 ? "Precision:OvGapOne" : "Precision:OvGapFinding", model.ActiveGaps]</span>@(" ")
                <a href="@Workbench.InspectionLink("topicKey", gap.Id)" class="vmark is-link mo-vl-role--neutral">@gap.Topic</a>@(". ")
            }
            @if (orphan is not null)
            {
                <span class="vmark mo-vl-role--warning">@L[model.Orphans == 1 ? "Precision:OvOrphanOne" : "Precision:OvOrphanFinding", model.Orphans]</span>@(" ")
                <a href="@Workbench.InspectionLink("topicKey", orphan.Id)" class="vmark is-link mo-vl-role--warning">@orphan.Topic</a>@(". ")
            }
            @if (errorTopic is not null)
            {
                <span>@L["Precision:OvErrorFinding", model.RetainedErrors]</span>@(" ")
                <a href="@Workbench.InspectionLink("topicKey", errorTopic.Id)" class="vmark is-link mo-vl-role--warning">@errorTopic.Topic</a>@(" ")
                <span>@L["Precision:OvErrorDetail", errorTopic.Status?.MessageErrorCount ?? 0]</span>
            }
        </Finding>
    </EventBusDecision>
    <div class="eb-facts-band">
        <dl class="facts" aria-label="@L["Precision:OvLabel"]">
            <div class="fact"><dt><span class="sw mo-vl-role--primary"></span>@L["Precision:OvFactHandlers"]</dt><dd>@subscriptions.Count</dd><span class="fact-sub">@L["Precision:OvFactHandlersSub", automatic, subscriptions.Count - automatic]</span></div>
            <div class="fact"><dt><span class="sw mo-vl-role--success"></span>@L["Precision:OvFactActive"]</dt><dd>@model.Active <small>/ @subscriptions.Count</small></dd><span class="fact-sub">@L["Precision:OvFactActiveSub", held, disabled]</span></div>
            <div class="fact"><dt><span class="sw @(model.ActiveGaps > 0 ? "mo-vl-role--warning" : "mo-vl-role--third") @(model.Reported == 0 ? "is-hatch" : null)"></span>@L["Precision:OvFactCoverage"]</dt><dd>@model.Reported <small>/ @model.Topics.Count</small></dd><span class="fact-sub">@L["Precision:OvFactCoverageSub", model.Reported, model.Topics.Count]</span></div>
            <div class="fact"><dt><span class="sw mo-vl-role--info"></span>@L["Precision:OvFactProviders"]</dt><dd>@providers.Count</dd><span class="fact-sub">@L["Precision:OvFactProvidersSub", distProviders, providers.Count - distProviders]</span></div>
        </dl>
    </div>
    <EventBusCirculationMatrix />
</section>

<section class="surface eb-topic-surface">
    <EventBusSurfaceHeading Icon="@MoIcons.Radio" Role="@(failed is not null ? "error" : recovering is not null ? "warning" : "third")"
                            Title="@L["Precision:TopicLedgerTitle"]" Description="@L["Precision:TopicLedgerSub"]" Count="@($"{rows.Length} / {model.Topics.Count}")" />
    <div class="eb-toolbar">
        <div class="fchips" role="group" aria-label="@L["Precision:TopicLedgerTitle"]">
            @foreach (var (id, label, tone) in TopicFilters)
            {
                <MoFilterChip Label="@label" Role="@tone" Count="@model.Topics.Count(topic => MatchesCoverage(topic, id))"
                              Pill="true" Class="mo-vl-chip--instrument" Selected="@(filter == id)"
                              SelectedChanged='() => Workbench.EditQuery(("coverage", id == "all" ? null : id))' />
            }
        </div>
        <div class="eb-toolbar-end"><label class="eb-search"><MoIcon Class="i" Icon="@MoIcons.Search" Size="15px" />
            <input type="search" value="@search" placeholder="@L["Precision:TopicSearchPh"]" aria-label="@L["Precision:TopicSearchPh"]"
                   @oninput='args => Workbench.EditQuery(("q", EmptyToNull(args.Value?.ToString())))' />
        </label></div>
    </div>
    <div class="eb-tl" role="table" aria-label="@L["Precision:TopicLedgerTitle"]">
        <div class="eb-tl-head" role="row">
            <span role="columnheader">@L["Precision:ColTopic"]</span>
            <span role="columnheader">@L["Precision:ColProvider"]</span>
            <span role="columnheader">@L["Precision:ColRuntime"]</span>
            <span class="is-num" role="columnheader">@L["Precision:ColHandlers"]</span>
            <span class="is-num" role="columnheader">@L["Precision:ColProcessed"]</span>
            <span role="columnheader">@L["Precision:ColStateSince"]</span>
            <span class="eb-col-act" role="columnheader">@L["Precision:ColActions"]</span>
        </div>
        @if (rows.Length == 0)
        {
            <MoContentState Compact="true"><p>@L[model.Topics.Count == 0 ? "Precision:NoReportedTopics" : "Precision:NoTopicsMatch"]</p></MoContentState>
        }
        @foreach (var row in rows)
        {
            var status = row.Status;
            var href = Workbench.InspectionLink("topicKey", row.Id);
            var inspectLabel = L["Registry:Inspect", row.Topic];
            var rowTone = row.Coverage switch
            {
                EventBusCoverage.Failed => "is-fault",
                EventBusCoverage.Recovering => "is-warn",
                _ => ""
            };
            <article class="eb-tl-item @rowTone" role="row" @key="row.Id">
                <div class="eb-tl-main">
                    <div role="cell" class="eb-tl-cell eb-tl-topic" data-label="@L["Precision:ColTopic"]">
                        <a class="eb-link-btn mono eb-break" href="@href">@row.Topic</a>
                        @if (row.IsOrphan) { <span class="mo-vl-chip mo-vl-role--warning">@L["Precision:OrphanBadge"]</span> }
                        @if (status is { State: TopicSubscriptionRuntimeState.Healthy, ProcessedMessages: 0 })
                        {
                            <span class="eb-idle-tag">@L["Precision:IdleBadge"]</span>
                        }
                    </div>
                    <div role="cell" class="eb-tl-cell" data-label="@L["Precision:ColProvider"]">
                        <EventBusTransportBadge Distributed="true" ServiceKey="@row.ServiceKey" Kind="@(status?.Provider ?? row.Provider?.ProviderType ?? EventBusProviderKind.Unknown)" />
                    </div>
                    <div role="cell" class="eb-tl-cell" data-label="@L["Precision:ColRuntime"]"><EventBusRuntimeBadge Status="@status" /></div>
                    <div role="cell" class="eb-tl-cell is-num" data-label="@L["Precision:ColHandlers"]"><span class="mono"><b>@row.Active</b> <span class="eb-dim">/ @row.Handlers.Count</span></span></div>
                    <div role="cell" class="eb-tl-cell is-num" data-label="@L["Precision:ColProcessed"]">
                        @if (status is not null)
                        {
                            <div class="eb-cell-stack is-end">
                                <span class="mono">@status.ProcessedMessages.ToString("N0") @if (status.MessageErrorCount > 0) { <b class="eb-ink-warn">· @status.MessageErrorCount</b> }</span>
                                <span class="eb-row-sub">@(status.LastMessageReceivedAt is { } received ? L.FormatEventBusRelativeTime(received, UiTime) : L["Precision:InspNoTimestamp"].Value)</span>
                            </div>
                        }
                        else { <span class="eb-dim">—</span> }
                    </div>
                    <div role="cell" class="eb-tl-cell" data-label="@L["Precision:ColStateSince"]">
                        @if (status is not null) { <time class="mono eb-ts" datetime="@EventBusVisuals.TimeTag(status.StateChangedAt)">@UiTime.Format(status.StateChangedAt)</time> }
                        else { <span class="eb-dim">—</span> }
                    </div>
                    <div role="cell" class="eb-tl-cell eb-col-act" data-label="@L["Precision:ColActions"]">
                        <a class="icon-btn" href="@href" aria-label="@inspectLabel" title="@inspectLabel"><MoIcon Icon="@MoIcons.ChevronRight" Size="16px" /></a>
                    </div>
                </div>
                @if (status?.LastErrorMessage is { Length: > 0 } error)
                {
                    <div class="eb-tl-diag mo-vl-role--@(row.Coverage == EventBusCoverage.Failed ? "error" : "warning")" role="cell" aria-colspan="7"><MoIcon Class="i" Icon="@(row.Coverage == EventBusCoverage.Failed ? MoIcons.Error : MoIcons.Warning)" Size="14px" /><span>@error</span></div>
                }
                else if (status is null)
                {
                    <div class="eb-tl-diag mo-vl-role--neutral" role="cell" aria-colspan="7"><MoIcon Class="i" Icon="@MoIcons.RadioOff" Size="14px" /><span>@L["Precision:MxUnreportedNote"]</span></div>
                }
            </article>
        }
    </div>
    <footer class="eb-surface-foot"><MoIcon Icon="@MoIcons.Info" Size="14px" />@L["Precision:TopicLedgerFoot"]</footer>
</section>

<section class="surface eb-dist-surface">
    <EventBusSurfaceHeading Icon="@MoIcons.ChartColumn" Title="@L["Precision:DistTitle"]" Description="@L["Precision:DistSub"]" />
    <div class="eb-dist-controls">
        <div class="eb-seg" role="group" aria-label="@L["Precision:DistTitle"]">
            <button type="button" aria-pressed="@(ReferenceEquals(dist, model.EventKinds) ? "true" : "false")" @onclick='() => Workbench.EditQuery(("dist", null))'>
                <span>@L["Precision:DistTabEvents"]</span><span class="eb-seg-n mono">@model.EventKinds.Count</span>
            </button>
            <button type="button" aria-pressed="@(ReferenceEquals(dist, model.TopicKinds) ? "true" : "false")" @onclick='() => Workbench.EditQuery(("dist", "topics"))'>
                <span>@L["Precision:DistTabTopics"]</span><span class="eb-seg-n mono">@model.TopicKinds.Count</span>
            </button>
        </div>
    </div>
    <div class="eb-dist-grid">
        @for (var index = 0; index < Math.Min(10, dist.Count); index++)
        {
            var row = dist[index];
            <a class="eb-dist-row" href="@SubscriptionDistributionLink(ReferenceEquals(dist, model.EventKinds), row.Key)">
                <span class="eb-dist-rank mono">@((index + 1).ToString("D2"))</span>
                <div class="eb-dist-name"><b class="eb-break">@row.Title</b>@if (row.Title != row.Key) { <code class="eb-break">@row.Key</code> }</div>
                <div class="eb-dist-meter"><div class="meter" aria-hidden="true">
                    <span class="mo-vl-role--success" style="@Width(row.Active - row.Risk, peak)"></span>
                    @if (row.Risk > 0) { <span class="mo-vl-role--error" style="@Width(row.Risk, peak)"></span> }
                    @if (row.Count > row.Active) { <span class="mo-vl-role--neutral is-light" style="@Width(row.Count - row.Active, peak)"></span> }
                </div></div>
                <span class="eb-dist-total mono">@row.Count</span><MoIcon Class="i" Icon="@MoIcons.ChevronRight" Size="14px" />
            </a>
        }
    </div>
    <div class="eb-dist-foot">
        <div class="eb-mx-legend"><span><span class="sw mo-vl-role--success"></span>@L["Precision:DistActive"]</span><span><span class="sw mo-vl-role--error"></span>@L["Precision:DistRisk"]</span><span><span class="sw mo-vl-role--neutral"></span>@L["Precision:DistOther"]</span></div>
        <a class="btn btn-sm btn-outline" href="@UIEventBusSubscriptionsPage.PAGE_URL">@L["Precision:DistExplore", subscriptions.Count]<MoIcon Icon="@MoIcons.ArrowRight" Size="14px" /></a>
    </div>
</section>

@code {
    /// <summary>Gets the owning workbench and its current capture.</summary>
    [CascadingParameter] public EventBusWorkbench Workbench { get; set; } = null!;

    private (string Id, string Label, MoVisualRole Role)[] TopicFilters =>
    [
        ("all", L["Precision:TopicFilterAll"], MoVisualRole.Primary),
        ("problems", L["Precision:TopicFilterProblems"], MoVisualRole.Error),
        ("errors", L["Precision:TopicFilterErrors"], MoVisualRole.Warning),
        ("unreported", L["Precision:TopicFilterUnreported"], MoVisualRole.Neutral),
        ("orphans", L["Precision:TopicFilterOrphans"], MoVisualRole.Warning)
    ];

    private static bool MatchesCoverage(EventBusTopicRow row, string category) => category switch
    {
        "problems" => row.Coverage is EventBusCoverage.Failed or EventBusCoverage.Recovering,
        "errors" => row.Status is { MessageErrorCount: > 0 } or { RecentErrors.Count: > 0 },
        "unreported" => row.Status is null,
        "orphans" => row.IsOrphan,
        _ => true
    };

    private static bool MatchesSearch(EventBusTopicRow row, string input)
    {
        var search = input.Trim();
        return search.Length == 0 || new[] { row.Topic, row.ServiceKey, row.Status?.LastErrorMessage,
            (row.Status?.Provider ?? row.Provider?.ProviderType)?.ToString() }.Any(value => value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true);
    }

    private static string? EmptyToNull(string? value) => value is { Length: > 0 } ? value : null;
    private static string Width(int numerator, int total) => FormattableString.Invariant($"width:{100d * numerator / total:0.##}%");
    private static string SubscriptionDistributionLink(bool events, string key) =>
        EventBusRouteQuery.To(UIEventBusSubscriptionsPage.PAGE_URL, (events ? "event" : "topic", key));
}
