@using Monica.UI.Shared.Components.Json
@using Monica.Configuration.UI.Localization
@using Monica.UI.Shared.Components.Dialogs
@inject ConfigurationJsonDraftService DraftService
@inject ConfigurationStateStore StateStore
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent><MoDialogHeading Text="@L["ImportExport:JsonEditor:Title"]" /></TitleContent>
    <DialogContent>
        <div class="configuration-json-edit-dialog">
        <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Dense="true">@L["Validation:FragmentNotice"]</MudAlert>
        <MudStack Spacing="3">
            <MudPaper Square="true" Elevation="0" Class="configuration-json-identity">
                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">@Definition.DisplayName</MudText>
                        <code class="configuration-json-path">@PathTitle</code>
                        <code class="configuration-json-path">@Definition.DefinitionKey</code>
                    </MudStack>
                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
                        <ConfigurationSchemaMetadataChip SchemaVersion="@Definition.SchemaVersion"
                                                         DefinitionRevision="@Definition.DefinitionRevision"
                                                         SchemaHash="@Definition.SchemaHash"
                                                         ValidationContract="@Definition.ValidationContract" />
                        @if (_editorDocument.RedactedPaths.Count > 0)
                        {
                            <MudChip T="int" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                @L["ImportExport:RedactedCount", _editorDocument.RedactedPaths.Count]
                            </MudChip>
                        }
                    </MudStack>
                </MudStack>
            </MudPaper>

            @if (_blockedByPendingState)
            {
                <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning">@L["ImportExport:JsonEditor:PendingStateUnavailable"]</MudAlert>
            }
            else if (!_editorDocument.CanAnalyze)
            {
                <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning">@L["ImportExport:JsonEditor:BaselineUnavailable"]</MudAlert>
            }

            @if (CanAnalyze)
            {
                <MoJson @bind-Value="_json" @bind-Value:after="InvalidateDraft" ReadOnly="false" Rows="18" Label="@L["ImportExport:JsonEditor:Json"]" />
            }

            @if (_draft is { IsJsonValid: false })
            {
                <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_draft.ParseError</MudAlert>
            }
            else if (_draft is not null)
            {
                <div class="configuration-json-summary">
                    <span>@L["ImportExport:Report:Changes", _draft.Changes.Count]</span>
                    <span class="configuration-json-issues">@L["ImportExport:Report:Issues", _draft.ValidationIssues.Count]</span>
                    <span>@L["ImportExport:Report:Unchanged", _draft.UnchangedCount]</span>
                    <span>@L["ImportExport:Report:RedactedSkipped", _draft.RedactedSkipCount]</span>
                </div>

                @if (_draft.Diagnostics.Count > 0)
                {
                    <MudPaper Square="true" Elevation="0" Class="configuration-json-diagnostics">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle2">@L["ImportExport:Diagnostics:Title"]</MudText>
                            @foreach (var diagnostic in _draft.Diagnostics)
                            {
                                <MudAlert Icon="@((DiagnosticSeverity(diagnostic)) switch { Severity.Success => MoIcons.Success, Severity.Warning => MoIcons.Warning, Severity.Error => MoIcons.Error, _ => MoIcons.Info })" Severity="@DiagnosticSeverity(diagnostic)" Dense="true">
                                    @diagnostic.Message
                                </MudAlert>
                            }
                        </MudStack>
                    </MudPaper>
                }

                <ConfigurationValidationIssueList Issues="@_draft.ValidationIssues" ShowJump="false" />

                @if (_draft.Changes.Count > 0)
                {
                    <ConfigurationPendingDefinitionDiffPreview Changes="@_draft.Changes"
                                                               ValidationIssues="@_draft.ValidationIssues" />
                }
                else if (_draft.ValidationIssues.Count == 0)
                {
                    <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["ImportExport:JsonEditor:NoState"]</MudAlert>
                }
            }
        </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="configuration-json-actions">
        <MudButton OnClick="Cancel">@L["Common:Actions:Cancel"]</MudButton>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@MoIcons.ListChecks"
                   Disabled="@(!CanAnalyze)"
                   OnClick="Analyze">
            @L["Common:Actions:Analyze"]
        </MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@MoIcons.ListChecks"
                   Disabled="@(!CanApply)"
                   OnClick="Apply">
            @L["Common:Actions:Apply"]
        </MudButton>
            </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    /// <summary>Gets the authoritative schema owner of the JSON fragment.</summary>
    [Parameter, EditorRequired] public ConfigurationDefinition Definition { get; set; } = null!;
    /// <summary>Gets the exact scope analyzed and returned for staging.</summary>
    [Parameter, EditorRequired] public ConfigurationNodeDefinition Node { get; set; } = null!;
    /// <summary>Gets the captured effective baseline; redacted values are not reconstructed or overwritten.</summary>
    [Parameter, EditorRequired] public ConfigurationEffectiveValue EffectiveValue { get; set; } = null!;
    /// <summary>Gets captured scalar target metadata used for safe scope writes.</summary>
    [Parameter] public IReadOnlyDictionary<LogicalPath, ConfigurationEffectiveValue> ScalarEffectiveValues { get; set; } =
        new Dictionary<LogicalPath, ConfigurationEffectiveValue>();
    /// <summary>Gets staged changes whose hidden and structural state must remain preserved.</summary>
    [Parameter] public IReadOnlyList<PendingChange> PendingChanges { get; set; } = [];
    /// <summary>Gets whether safe detailed changes are compacted; the default is true.</summary>
    [Parameter] public bool CompactChanges { get; set; } = true;

    private ConfigurationJsonEditorDocument _editorDocument = new("{}", []);
    private ConfigurationJsonDraftResult? _draft;
    private string _json = "{}";
    private IReadOnlyList<LogicalPath> _redactedPaths = [];
    private bool _blockedByPendingState;

    private string PathTitle => Node.RelativePath.Depth == 0
        ? L["State:Tree:Root"]
        : Node.RelativePath.ToCanonicalString();

    private bool CanAnalyze => _editorDocument.CanAnalyze && !_blockedByPendingState;
    private bool CanApply => CanAnalyze && _draft is { IsJsonValid: true, HasState: true };

    protected override void OnInitialized()
    {
        _editorDocument = DraftService.BuildEditorDocument(Definition, Node, EffectiveValue, ScalarEffectiveValues, PendingChanges);
        _redactedPaths = _editorDocument.RedactedPaths.Select(LogicalPath.Parse).ToArray();
        _blockedByPendingState = _editorDocument.PendingStateUnavailable
            || !StateStore.CanReplaceJsonEditorScope(Definition.DefinitionKey, Node.RelativePath, _redactedPaths);
        _json = _editorDocument.Json;
    }

    private void Analyze()
    {
        if (!CanAnalyze)
            return;

        _draft = DraftService.Analyze(new ConfigurationJsonDraftRequest
        {
            Definition = Definition,
            ScopeNode = Node,
            EffectiveValue = EffectiveValue,
            ScalarEffectiveValues = ScalarEffectiveValues,
            Json = _json,
            RedactedPaths = _editorDocument.RedactedPaths.ToHashSet(StringComparer.Ordinal),
            CompactChanges = CompactChanges
        }, _editorDocument);
    }

    private void InvalidateDraft() => _draft = null;

    private void Apply()
    {
        if (!CanApply)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(new ConfigurationJsonEditResult(_draft!, _redactedPaths)));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private static Severity DiagnosticSeverity(ConfigurationImportDiagnostic diagnostic)
    {
        return diagnostic.Severity switch
        {
            ConfigurationImportDiagnosticSeverity.Error => Severity.Error,
            ConfigurationImportDiagnosticSeverity.Warning => Severity.Warning,
            _ => Severity.Info
        };
    }
}
