@attribute [Route(PAGE_URL)]
@using Monica.JobScheduler.UI.Localization

<PageTitle>@L["Executions:PageTitle"]</PageTitle>
<SchedulerWorkspace Title="@L["Workspace:Pages:Executions:Title"]"
                    Description="@L["Workspace:Pages:Executions:Description"]"
                    ActivePanelIndex="2">
    <ExecutionLedgerContent @key="(InitialStates, InitialInstanceId, InitialOwner, InitialJob, InitialFrom, InitialTo, InitialSearch, InitialRange)"
                            InitialStates="@InitialStates" InitialInstanceId="@InitialInstanceId" InitialOwner="@InitialOwner" InitialJob="@InitialJob" InitialFrom="@InitialFrom" InitialTo="@InitialTo" InitialSearch="@InitialSearch" InitialRange="@InitialRange" />
</SchedulerWorkspace>
