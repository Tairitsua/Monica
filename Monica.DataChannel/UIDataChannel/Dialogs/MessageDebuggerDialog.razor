@using Monica.UI.Shared.Components.Json
@using Monica.DataChannel.Models
@using Monica.DataChannel.Middlewares
@using Monica.DataChannel.Pipeline
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@inject IStringLocalizer<DataChannelResource> L
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Logging.ILogger<MessageDebuggerDialog> Logger
@implements IAsyncDisposable

<MudDialog Gutters="false" DefaultFocus="DefaultFocus.None" Style="width:min(760px, calc(100vw - 28px));max-height:calc(100dvh - 28px);">
    <TitleContent>
        <div class="debugger-heading">
            <span class="mo-vl-tile mo-vl-role--info"><MoIcon Icon="@MoIcons.Bug" Size="16px" /></span>
            <div><h2>@L["Workbench:DebuggerDialogTitle"] · @ChannelId</h2><p>@L["Debugger:Eyebrow"]</p></div>
            <MudIconButton @ref="_close" Icon="@MoIcons.Close" Size="Size.Small" OnClick="Dismiss" aria-label="@L["Design:Close"]" />
        </div>
    </TitleContent>
    <DialogContent>
        <div class="debugger-console">
            <div class="debugger-scope" role="note">
                <span class="mo-vl-tile mo-vl-role--info"><MoIcon Icon="@MoIcons.Info" Size="15px" /></span>
                <span>@L["Debugger:CaptureScope"]</span>
            </div>
            @if (_readError is not null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">@L["Debugger:Messages:ReadFailed", _readError]</MudAlert>
            }

            <section class="debugger-controls" aria-label="@L["Debugger:Controls:AriaLabel"]">
                <div class="debugger-field">
                    <span id="dc-debug-keyword-label">@L["Debugger:Fields:FilterKeyword"]</span>
                    <MudTextField T="string" Value="_filterKeyword" ValueChanged="SetFilterKeyword" Variant="Variant.Outlined"
                                  aria-labelledby="dc-debug-keyword-label" Placeholder="@L["Debugger:Fields:FilterPlaceholder"]"
                                  Margin="Margin.Dense" Immediate="true" Disabled="_isListening" />
                </div>
                <div class="debugger-field">
                    <span id="dc-debug-capacity-label">@L["Debugger:Fields:QueueLength"]</span>
                    <MudNumericField T="int" Value="_maxQueueSize" ValueChanged="SetCapacity" Min="1" Max="1000"
                                     aria-labelledby="dc-debug-capacity-label" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     HideSpinButtons="true" Disabled="_isListening" />
                </div>
                <div class="debugger-controls__actions">
                    <MudButton StartIcon="@(_isListening ? MoIcons.Stop : MoIcons.Play)"
                               Color="@(_isListening ? Color.Default : Color.Primary)"
                               Variant="@(_isListening ? Variant.Outlined : Variant.Filled)" OnClick="ToggleListening">
                        @L[_isListening ? "Debugger:Actions:Stop" : "Debugger:Actions:Start"]
                    </MudButton>
                    @if (_isListening)
                    {
                        <MudButton Class="debugger-simulate" StartIcon="@MoIcons.Zap" OnClick="SimulateMessage" Disabled="_isExecutingCommand"
                                   title="@L["Design:Debugger:SampleScope"]">@L["Design:Debugger:Simulate"]</MudButton>
                    }
                </div>
                <p>@L["Debugger:SettingsHelp"]</p>
                @if (_settingsDirty)
                {
                    <p class="debugger-draft-help">@L["Debugger:DraftHelp", string.IsNullOrEmpty(_observedKeyword) ? L["Debugger:NoKeyword"].Value : _observedKeyword, _observedCapacity]</p>
                }
            </section>

            <section class="debugger-stream" aria-labelledby="debugger-stream-title">
                <header class="debugger-stream__header">
                    <div>
                        <span class="mo-vl-status mo-vl-status--pill @(_isListening ? "mo-vl-status--live mo-vl-role--info" : "mo-vl-role--neutral")">
                            <span class="mo-vl-status-dot" aria-hidden="true"></span>@L[_isListening ? "Debugger:States:Listening" : "Debugger:States:Paused"]
                        </span>
                        <h3 id="debugger-stream-title">@L["Debugger:CapturedMessages"]</h3>
                        <span class="debugger-count">@L["Debugger:MessageCount", _messages.Count]</span>
                    </div>
                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@MoIcons.ClearList" OnClick="ClearMessages"
                               Disabled="@(_messages.Count == 0 || _isExecutingCommand)">@L["Debugger:Actions:Clear"]</MudButton>
                </header>
                @if (_messages.Count == 0)
                {
                    <MoContentState Compact="true">
                        <span class="mo-vl-tile mo-vl-role--neutral"><MoIcon Icon="@MoIcons.Inbox" Size="18px" /></span>
                        <h3>@L["Debugger:States:NoMessages"]</h3><p>@L["Debugger:States:NoMessagesDescription"]</p>
                    </MoContentState>
                }
                else
                {
                    <div class="debugger-message-list">
                        @foreach (var message in _messages.Reverse())
                        {
                            var isSelected = _selectedMessage?.Sequence == message.Sequence;
                            var role = IsSample(message) ? "mo-vl-role--third" : message.Source == ChannelSide.Inner ? "mo-vl-role--primary" : "mo-vl-role--info";
                            <button type="button" class="debugger-message" aria-pressed="@(isSelected ? "true" : "false")" @key="message.Sequence"
                                    aria-label="@L["Debugger:InspectMessage", message.Sequence]" @onclick="() => _selectedMessage = message">
                                <span class="debugger-message__summary">
                                    <span class="debugger-message__source @role">@SourceLabel(message)</span>
                                    <span class="debugger-ordinal">#@message.Sequence</span>
                                    <code>@message.MessageType</code>
                                    <time>@UiTime.Format(message.Timestamp)</time>
                                </span>
                                <span class="debugger-message__preview">@Preview(message.FormattedContent)</span>
                            </button>
                        }
                    </div>
                }
            </section>
            @if (_selectedMessage is { } selected)
            {
                <section class="debugger-inspector" aria-labelledby="debugger-inspector-title">
                    <header>
                        <p>@L["Debugger:SelectedEvidence", selected.Sequence] · @UiTime.Format(selected.Timestamp)</p>
                        <h3 id="debugger-inspector-title">@selected.MessageType</h3>
                    </header>
                    @if (!_messages.Any(message => message.Sequence == selected.Sequence))
                    {
                        <div class="debugger-detached-note" role="status">
                            <MoIcon Icon="@MoIcons.History" Size="16px" />@L["Debugger:DetachedSelection"]
                        </div>
                    }
                    <MudTabs Class="debugger-tabs" Elevation="0" Rounded="false" HideSlider="true" MinimumTabWidth="0"
                             PrevIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight">
                        <MudTabPanel Text="@L["Debugger:Tabs:FormattedContent"]">
                            <div class="debugger-payload">
                                <div class="debugger-copy">
                                    <span>@SourceLabel(selected)</span>
                                    <MoCopyButton Value="@selected.FormattedContent" Label="@L["Design:Debugger:CopyPayload"]" />
                                </div>
                                <MoJson Value="@selected.FormattedContent" ShowToolbar="false" ShowStatus="false" ShowLineNumbers="false"
                                        FormatOnDisplay="false" AllowPlainText="true" WrapLines="true" MaxHeight="300px" />
                            </div>
                        </MudTabPanel>
                        <MudTabPanel Text="@L["Debugger:Tabs:PayloadSnapshot"]">
                            <MetadataDisplay Metadata="selected.Payload" />
                        </MudTabPanel>
                        <MudTabPanel Text="@L["Debugger:Tabs:Metadata"]">
                            @if (selected.Metadata.Count == 0)
                            {
                                <p class="debugger-metadata-empty">@L["Debugger:NoMetadata"]</p>
                            }
                            else
                            {
                                <dl class="debugger-metadata">
                                    @foreach (var entry in selected.Metadata)
                                    {
                                        <div><dt>@entry.Key</dt><dd><MetadataDisplay Metadata="entry.Value" /></dd></div>
                                    }
                                </dl>
                            }
                        </MudTabPanel>
                    </MudTabs>
                </section>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="debugger-footer"><span>@L["Debugger:CloseHelp"]</span>
            <MudButton Variant="Variant.Outlined" OnClick="Dismiss">@L["Design:Close"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>Gets or sets the borrowed persistent host capture. Closing retires polling and never disposes or stops the middleware.</summary>
    [Parameter, EditorRequired]
    public MessageDebuggerMiddleware Middleware { get; set; } = null!;

    /// <summary>Gets or sets the exact identity of the channel that owns the capture middleware.</summary>
    [Parameter, EditorRequired]
    public string ChannelId { get; set; } = string.Empty;

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    private MudIconButton? _close;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _close is null) return;
        try { await _close.FocusAsync(); }
        catch (JSDisconnectedException) { }
    }

    private void Dismiss() => Dialog.Cancel();

    private readonly CancellationTokenSource _lifetime = new();
    private readonly object _retirementGate = new();
    private Task? _pollTask;
    private Task? _disposeTask;
    private IReadOnlyList<DebugMessageSnapshot> _messages = [];
    private DebugMessageSnapshot? _selectedMessage;
    private string _filterKeyword = string.Empty;
    private string _observedKeyword = string.Empty;
    private string? _readError;
    private int _maxQueueSize = 100;
    private int _observedCapacity = 100;
    private bool _settingsDirty;
    private bool _isListening;
    private bool _isExecutingCommand;
    private bool _retired;

    protected override void OnInitialized()
    {
        _filterKeyword = Middleware.FilterKeyword;
        _maxQueueSize = Middleware.MaxQueueSize;
        ReadCapture();
        _selectedMessage = _messages.LastOrDefault();
        _pollTask = PollAsync(_lifetime.Token);
    }
    private void ReadCapture()
    {
        var active = Middleware.IsActive;
        var keyword = Middleware.FilterKeyword;
        var capacity = Middleware.MaxQueueSize;
        var messages = Middleware.GetDebugMessageSnapshots();
        _isListening = active;
        _observedKeyword = keyword;
        _observedCapacity = capacity;
        if (active || !_settingsDirty)
        {
            _filterKeyword = keyword;
            _maxQueueSize = capacity;
            _settingsDirty = false;
        }
        _messages = messages;
        if (!active) { ReconcileDraft(); }
        _readError = null;
    }
    private void SetFilterKeyword(string keyword)
    {
        if (_retired) { return; }
        if (Middleware.IsActive) { ReadCapture(); return; }
        _filterKeyword = keyword;
        ReconcileDraft();
    }
    private void SetCapacity(int capacity)
    {
        if (_retired) { return; }
        if (Middleware.IsActive) { ReadCapture(); return; }
        _maxQueueSize = capacity;
        ReconcileDraft();
    }
    private void ReconcileDraft() => _settingsDirty =
        !string.Equals(_filterKeyword, _observedKeyword, StringComparison.Ordinal) || _maxQueueSize != _observedCapacity;
    private void ToggleListening()
    {
        if (_retired) { return; }
        var displayedActive = _isListening;
        ExecuteCommand(() =>
        {
            ReadCapture();
            if (displayedActive != _isListening) { return; }
            if (_isListening) { Middleware.IsActive = false; }
            else
            {
                Middleware.FilterKeyword = _filterKeyword;
                Middleware.MaxQueueSize = _maxQueueSize;
                Middleware.IsActive = true;
            }
        });
    }
    private void ClearMessages()
    {
        if (_retired || _isExecutingCommand || _messages.Count == 0) { return; }
        ExecuteCommand(() =>
        {
            ReadCapture();
            if (_messages.Count > 0) { Middleware.ClearDebugMessages(); }
        });
    }
    private void SimulateMessage() => ExecuteCommand(() =>
    {
        if (!Middleware.CaptureSample()) Snackbar.Add(L["Design:Debugger:SampleNotCaptured"], Severity.Info);
    });
    private void ExecuteCommand(Action command)
    {
        if (_retired || _isExecutingCommand) { return; }
        _isExecutingCommand = true;
        try { command(); ReadCapture(); }
        catch (Exception exception)
        {
            Microsoft.Extensions.Logging.LoggerExtensions.LogError(Logger, exception, "DataChannel debugger command failed for channel {ChannelId}.", ChannelId);
            if (!_retired) { Snackbar.Add(L["Workbench:OperationFailedDetail", exception.Message], Severity.Error); }
        }
        finally { _isExecutingCommand = false; }
    }
    private async Task PollAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    if (_retired) { return; }
                    try { ReadCapture(); }
                    catch (Exception exception) { _readError = exception.Message; }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }
    private static bool IsSample(DebugMessageSnapshot message) =>
        message.Metadata.TryGetValue(MessageDebuggerMiddleware.SampleMetadataKey, out var value) && value.Json == "true";

    private string SourceLabel(DebugMessageSnapshot message) => L[IsSample(message) ? "Design:Debugger:Sample" :
        message.Source == ChannelSide.Inner ? "Debugger:Sources:Ingress" : "Debugger:Sources:Egress"];
    private string Preview(string content)
    {
        if (string.IsNullOrEmpty(content)) { return L["Debugger:Values:EmptyMessage"]; }
        var singleLine = string.Join(' ', content.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        return singleLine.Length > 160 ? singleLine[..160].TrimEnd() + "…" : singleLine;
    }
    public ValueTask DisposeAsync()
    {
        lock (_retirementGate)
        {
            _retired = true;
            return new ValueTask(_disposeTask ??= RetireAsync());
        }
    }
    private async Task RetireAsync()
    {
        _lifetime.Cancel();
        try { if (_pollTask is { } poll) { await poll; } }
        finally { _lifetime.Dispose(); }
    }
}
