@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.DataChannel.UIDataChannel.Models
@using Monica.DataChannel.UIDataChannel.Support
@inject IStringLocalizer<DataChannelResource> L
@implements IDisposable

<section class="exception-directory" aria-labelledby="exception-directory-title">
    <header class="exception-directory__heading">
        <div>
            <span>@L["ExceptionDirectory:Eyebrow"]</span>
            <h2 id="exception-directory-title">@L["ExceptionDirectory:Title"]</h2>
            <p>@L["ExceptionDirectory:Description"]</p>
        </div>
        <span>@L["Directory:Shown", FilteredRows.Count, Summary.ChannelSummaries.Count]</span>
    </header>
    @if (!string.IsNullOrEmpty(ChannelId))
    {
        <div class="exception-directory__exact">
            <span>@L["Directory:ExactChannel"]</span>
            <code>@ChannelId</code>
            <a href="/datachannel-manage/exceptions">@L["Directory:ShowAllChannels"]</a>
        </div>
    }
    <div class="exception-directory__filters">
        <div class="exception-directory__query">
            <MudTextField T="string" @ref="_searchField" @bind-Value="_query" Immediate="true" Label="@L["ExceptionDirectory:Search"]" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" Clearable="true" ClearIcon="@MoIcons.Close" />
        </div>
        <div class="exception-directory__states" aria-label="@L["ExceptionDirectory:FiltersLabel"]">
            @foreach (var filter in Filters)
            {
                <MudButton data-filter="@filter" aria-pressed="@(_filter == filter ? "true" : "false")" OnClick="() => _filter = filter">@L[$"ExceptionDirectory:Filters:{filter}"]<span>@FilterCount(filter)</span>
                </MudButton>
            }
        </div>
        <MudButton Size="Size.Small" OnClick="ResetAsync">@L["Directory:Reset"]</MudButton>
    </div>
    <div class="exception-directory__table">
        <MudDataGrid T="ExceptionDirectoryRow" Items="FilteredRows" Square="true" Elevation="0" Filterable="true" SortMode="SortMode.Multiple" Hover="true" Dense="true" ReadOnly="true" Breakpoint="Breakpoint.Xs" RowsPerPage="10" SortIcon="@MoIcons.ArrowUp" DragIndicatorIcon="@MoIcons.GripVertical" FilterIconEmpty="@MoIcons.Filter" FilterIconFilled="@MoIcons.Filter" FilterIconClear="@MoIcons.FilterOff" ColumnOptionsIcon="@MoIcons.MoreVertical">
            <Columns>
                <PropertyColumn Property="item => item.ChannelId" Title="@L["Exceptions:Columns:ChannelId"]">
                    <CellTemplate>
                        <div class="exception-channel">
                            <code>@context.Item.ChannelId</code>
                            <span>@DataChannelPresentation.Group(context.Item.GroupId, L)</span>
                        </div>
                    </CellTemplate>
                </PropertyColumn>
                <PropertyColumn Property="item => item.PipelineId" Title="@L["Exceptions:Columns:PipelineId"]">
                    <CellTemplate>
                        <code class="exception-pipeline-id">@context.Item.PipelineId</code>
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn Title="@L["ExceptionDirectory:Evidence"]" Sortable="false">
                    <CellTemplate>
                        <span class="exception-retention" data-retained="@(context.Item.HasExceptions ? "true" : "false")">
                            <MoIcon Icon="@(context.Item.HasExceptions ? MoIcons.Error : MoIcons.MinusCircle)" Size="1.25rem" />@L[context.Item.HasExceptions ? "ExceptionDirectory:Retained" : "ExceptionDirectory:None"]</span>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="item => item.CurrentExceptionCount" Title="@L["Exceptions:Columns:CurrentCount"]" />
                <PropertyColumn Property="item => item.TotalExceptionCount" Title="@L["Exceptions:Columns:HistoricalCount"]" />
                <PropertyColumn Property="item => item.MaxPoolSize" Title="@L["Exceptions:Columns:PoolSize"]" />
                <PropertyColumn Property="item => item.LatestException" Title="@L["Exceptions:Columns:Latest"]">
                    <CellTemplate>
                        <time>@(context.Item.LatestException is { } latest ? UiTime.Format(latest) : L["Common:Values:None"].Value)</time>
                    </CellTemplate>
                </PropertyColumn>
                <TemplateColumn Title="@L["Common:Columns:Actions"]" Sortable="false" Filterable="false">
                    <CellTemplate>
                        <div class="exception-actions">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="() => OnInspect.InvokeAsync(context.Item.ChannelId)" aria-label="@L["Directory:InspectExceptionsFor", context.Item.ChannelId]">@L["Channel:Actions:Inspect"]</MudButton>
                            <MudTooltip Text="@L["Channel:Actions:ClearHistory"]">
                                <MudIconButton Icon="@MoIcons.ClearList" Color="Color.Default" Size="Size.Small" aria-disabled="@(IsBusy(context.Item.ChannelId) ? "true" : "false")" OnClick="() => ClearAsync(context.Item.ChannelId)" aria-label="@L["ExceptionDirectory:ClearFor", context.Item.ChannelId]" />
                            </MudTooltip>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="exception-directory__empty">
                    <MoIcon Icon="@MoIcons.History" Size="2.25rem" />
                    <h3>@L[MissingChannel ? "Directory:MissingChannel" : Summary.ChannelSummaries.Count == 0 ? "Directory:Empty" : "Directory:NoMatches"]</h3>
                    <p>@L[MissingChannel ? "Directory:MissingChannelHelp" : Summary.ChannelSummaries.Count == 0 ? "Directory:EmptyHelp" : "Directory:NoMatchesHelp"]</p>
                </div>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="ExceptionDirectoryRow" />
            </PagerContent>
        </MudDataGrid>
    </div>
    <p class="exception-directory__note">@L["ExceptionDirectory:CapacityHelp"]</p>
</section>

@code {
    /// <summary>Gets or sets a complete exception summary captured by the owning workflow.</summary>
    [Parameter, EditorRequired]
    public DataChannelExceptionSummaryInfo Summary { get; set; } = null!;

    /// <summary>Gets or sets an optional exact, ordinal channel identity supplied by the route.</summary>
    [Parameter]
    public string? ChannelId { get; set; }

    /// <summary>Gets or sets the owning workflow admission check for channel operations.</summary>
    [Parameter, EditorRequired]
    public Func<string, bool> IsBusy { get; set; } = _ => false;

    /// <summary>Gets or sets the callback that opens a native retained-exception inspector.</summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnInspect { get; set; }

    /// <summary>Gets or sets the callback that confirms the full retained-history deletion scope.</summary>
    [Parameter, EditorRequired]
    public EventCallback<string> OnClear { get; set; }

    private static readonly string[] Filters = ["All", "Retained", "None"];
    private readonly Dictionary<string, ExceptionDirectoryRow> _rowsById = new(StringComparer.Ordinal);
    private IReadOnlyList<ExceptionDirectoryRow> _rows = [];
    private string _query = string.Empty;
    private string _filter = "All";
    private MudTextField<string>? _searchField;
    private bool _retired;
    private bool MissingChannel => !string.IsNullOrEmpty(ChannelId) && !Summary.ChannelSummaries.Any(channel => string.Equals(channel.ChannelId, ChannelId, StringComparison.Ordinal));
    private List<ExceptionDirectoryRow> FilteredRows => _rows.Where(row => Matches(row.Capture)).ToList();
    private bool Matches(DataChannelExceptionSummaryItem channel) =>
        (string.IsNullOrEmpty(ChannelId) || string.Equals(channel.ChannelId, ChannelId, StringComparison.Ordinal)) &&
        (_filter == "All" || (_filter == "Retained" ? channel.HasExceptions : !channel.HasExceptions)) &&
        (string.IsNullOrWhiteSpace(_query) || new[] { channel.ChannelId, channel.GroupId, channel.PipelineId }.Any(value => value?.Contains(_query, StringComparison.OrdinalIgnoreCase) == true));
    private int FilterCount(string filter) => filter == "All" ? Summary.ChannelSummaries.Count : Summary.ChannelSummaries.Count(channel => filter == "Retained" ? channel.HasExceptions : !channel.HasExceptions);

    protected override void OnParametersSet()
    {
        var retainedIds = new HashSet<string>(StringComparer.Ordinal);
        var rows = new List<ExceptionDirectoryRow>(Summary.ChannelSummaries.Count);
        foreach (var capture in Summary.ChannelSummaries)
        {
            retainedIds.Add(capture.ChannelId);
            if (!_rowsById.TryGetValue(capture.ChannelId, out var row))
            {
                row = new ExceptionDirectoryRow(capture);
                _rowsById.Add(capture.ChannelId, row);
            }
            else
            {
                row.Capture = capture;
            }
            rows.Add(row);
        }
        foreach (var id in _rowsById.Keys.Where(id => !retainedIds.Contains(id)).ToArray())
        {
            _rowsById.Remove(id);
        }
        _rows = rows;
    }

    private Task ClearAsync(string channelId) => _retired || IsBusy(channelId)
        ? Task.CompletedTask
        : OnClear.InvokeAsync(channelId);

    /// <summary>Retains the native grid row key while delegated properties expose the newest capture to filtering, sorting, and actions.</summary>
    private sealed class ExceptionDirectoryRow(DataChannelExceptionSummaryItem capture)
    {
        /// <summary>Gets or sets the newest detached summary for this exact channel identity.</summary>
        public DataChannelExceptionSummaryItem Capture { get; set; } = capture;

        public string ChannelId => Capture.ChannelId;
        public string? GroupId => Capture.GroupId;
        public string PipelineId => Capture.PipelineId;
        public bool HasExceptions => Capture.HasExceptions;
        public long CurrentExceptionCount => Capture.CurrentExceptionCount;
        public long TotalExceptionCount => Capture.TotalExceptionCount;
        public int MaxPoolSize => Capture.MaxPoolSize;
        public DateTime? LatestException => Capture.LatestException;
    }
    private async Task ResetAsync()
    {
        if (_searchField is { } field) { await field.ClearAsync(); }
        if (_retired) { return; }
        _query = string.Empty; _filter = "All";
    }
    public void Dispose() => _retired = true;
}
