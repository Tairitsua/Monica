@using Monica.UI.Shared.Components.Json
@using System.Text.Json
@using Monica.DataChannel.Models
@inject IStringLocalizer<DataChannelResource> L

@if (!string.IsNullOrEmpty(Metadata?.CaptureError))
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Warning">
        <strong>@L["Metadata:CaptureFailed"]</strong>
        <p>@Metadata.CaptureError</p>
    </MudAlert>
}
else if (_items.Count > 0)
{
    <dl class="metadata-list">
        @foreach (var item in _items)
        {
            <div class="metadata-row">
                <dt>@item.Key</dt>
                <dd>
                    @if (item.Structured)
                    {
                        <div class="metadata-structured">
                            <MudExpansionPanels Elevation="0" Dense="true">
                                <MudExpansionPanel Text="@L["Metadata:ComplexValue"]" Icon="@MoIcons.Braces">
                                    <MoJson Value="@item.Value" AllowPlainText="true" ShowLineNumbers="false" />
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        </div>
                    }
                    else
                    {
                        <span class="metadata-value">@item.Value</span>
                    }
                </dd>
            </div>
        }
    </dl>
}
else
{
    <p class="metadata-empty">@L["Metadata:Empty"]</p>
}

@code {
    /// <summary>Gets or sets detached serialized evidence; rendering never reads the original live value.</summary>
    [Parameter]
    public DataChannelValueSnapshot? Metadata { get; set; }

    private IReadOnlyList<MetadataEntry> _items = [];
    protected override void OnParametersSet()
    {
        if (Metadata?.Json is not { } json) { _items = []; return; }
        try
        {
            using var document = JsonDocument.Parse(json);
            var value = document.RootElement;
            _items = value.ValueKind == JsonValueKind.Object
                ? value.EnumerateObject().Select(property => Entry(property.Name, property.Value)).ToList()
                : [Entry(L["Metadata:Value"], value)];
        }
        catch (JsonException) { _items = [new MetadataEntry(L["Metadata:RawData"], json, true)]; }
    }
    private static MetadataEntry Entry(string key, JsonElement value) => new(key,
        value.ValueKind == JsonValueKind.String ? value.GetString() ?? string.Empty : value.GetRawText(),
        value.ValueKind is JsonValueKind.Object or JsonValueKind.Array);
    private sealed record MetadataEntry(string Key, string Value, bool Structured);
}
