@using Monica.UI.Shared.Components.Json
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@attribute [Route(PAGE_URL)]
@using Monica.AI.Mcp.Models
@using Monica.AI.UI.Shared.Components
@rendermode InteractiveServer

<PageTitle>@PageTitleText</PageTitle>

<div class="capability-page" @ref="_pageElement" data-focus-visit="@_focusVisit" data-focus-version="@_focusVersion" data-selected-key="@(_state?.SelectedEntry?.Key ?? string.Empty)" data-catalog-open="@(_catalogOpen ? "true" : "false")">
    <AIAdministrationHeader Title="@PageTitleText" Description="@PageSubtitleText" IsProviderPage="false" IsMcpPage="@(CatalogKind == AgentCapabilityKind.Mcp)">
        <Actions>
            @if (CatalogKind == AgentCapabilityKind.Mcp)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Add" aria-disabled="@BusyAttribute" OnClick="ShowAddMcpProfileDialogAsync">@L["Capabilities:Mcp:Add"]</MudButton>
            }
            <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" aria-disabled="@BusyAttribute" OnClick="RefreshAsync">@L["Capabilities:Refresh"]</MudButton>
        </Actions>
    </AIAdministrationHeader>
    @if (_state?.Error is { } error)
    {
        <div class="page-feedback" role="alert">
            <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Dense="true">@error</MudAlert>
            @if (_state.Management is not null) { <MudText Typo="Typo.body2">@L["Capabilities:Administration:PreviousData"]</MudText> }
            <MudButton Variant="Variant.Text" aria-disabled="@BusyAttribute" OnClick="RefreshAsync">@L["Capabilities:Administration:Retry"]</MudButton>
        </div>
    }
    @if (Busy) { <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="page-progress" aria-label="@L["Capabilities:Administration:Loading"]" /> }
    @if (_state?.Management is not null)
    {
        @RenderCatalog()
    }
    else if (_state?.Error is null) { <MoContentState Loading="true">@L["Capabilities:Administration:Loading"]</MoContentState> }
</div>

@code {
    private RenderFragment RenderCatalog() => @<div class="catalog-panel">
        <section class="catalog-gate" aria-label="@L["Capabilities:Administration:CatalogGate"]">
            <div><h2>@(_state!.ActiveKind == AgentCapabilityKind.Skill ? L["Capabilities:Administration:SkillsGateTitle"] : L["Capabilities:Administration:McpGateTitle"])</h2>
                <p>@(_state.ActiveKind == AgentCapabilityKind.Skill ? L["Capabilities:Administration:SkillsScope"] : L["Capabilities:Administration:McpScope"])</p></div>
            <MudSwitch T="bool" Value="@_state.IsCatalogEnabled" ValueChanged="SetCatalogEnabledAsync" ReadOnly="@Busy" aria-disabled="@BusyAttribute" Color="Color.Primary" Label="@L["Capabilities:Administration:CatalogEnabled"]" />
        </section>
        @if (_state.ActiveKind == AgentCapabilityKind.Skill) { @RenderFileSources() }
        <div class="catalog-workspace">
            <aside class="@($"catalog-index {(_catalogOpen ? "catalog-open" : "catalog-closed")}")" aria-label="@L["Capabilities:Administration:Catalog"]">
                <button type="button" class="compact-catalog-toggle" aria-expanded="@(_catalogOpen ? "true" : "false")" aria-controls="capability-catalog-body" @onclick="ToggleCatalog">
                    <span><strong>@(_state.SelectedEntry?.Title ?? L["Capabilities:Administration:Catalog"])</strong><small>@ResultCount</small></span>
                    <span>@L["Capabilities:Administration:ChangeEntry"] <MoIcon Icon="@(_catalogOpen ? MoIcons.ChevronUp : MoIcons.ChevronDown)" Size="1.5rem" /></span>
                </button>
                <div class="catalog-body" id="capability-catalog-body">
                    <div class="catalog-heading"><h2>@L["Capabilities:Administration:Catalog"]</h2><span>@ResultCount</span></div>
                    <MudTextField T="string" Value="@_state.Query" ValueChanged="SetQuery" Label="@L["Capabilities:Search"]" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" Immediate="true" />
                    <div class="catalog-filters">
                        <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="string" Value="@EffectiveFilter" ValueChanged="SetEffectiveFilter" Label="@L["Capabilities:Administration:EffectiveFilter"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="string" Value='@("all")'>@L["Capabilities:Administration:AllEntries"]</MudSelectItem>
                            <MudSelectItem T="string" Value='@("available")'>@L["Capabilities:Administration:Available"]</MudSelectItem>
                            <MudSelectItem T="string" Value='@("unavailable")'>@L["Capabilities:Administration:Unavailable"]</MudSelectItem>
                        </MudSelect>
                        <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="string" Value="@SourceFilter" ValueChanged="SetSourceFilter" Label="@L["Capabilities:Administration:SourceFilter"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="string" Value='@("all")'>@L["Capabilities:Administration:AllSources"]</MudSelectItem>
                            @if (_state.ActiveKind == AgentCapabilityKind.Skill)
                            {
                                <MudSelectItem T="string" Value="@nameof(AgentCapabilitySourceKind.CodeDefined)">@L["Capabilities:Administration:CodeDefined"]</MudSelectItem>
                                <MudSelectItem T="string" Value="@nameof(AgentCapabilitySourceKind.ExternalFile)">@L["Capabilities:Skill:External"]</MudSelectItem>
                            }
                            else
                            {
                                @foreach (var source in Enum.GetValues<McpCatalogSourceKind>()) { <MudSelectItem T="string" Value="@source.ToString()">@GetMcpSourceKindText(source)</MudSelectItem> }
                            }
                        </MudSelect>
                    </div>
                    @if (HasFilters) { <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearFilters">@L["Capabilities:Administration:ClearFilters"]</MudButton> }
                    <div class="entry-list" role="group" aria-label="@L["Capabilities:Administration:Catalog"]" tabindex="0">
                        @foreach (var catalogEntry in _state.VisibleEntries)
                        {
                            <button type="button" class="@(catalogEntry.Key == _state.SelectedEntry?.Key ? "entry-button selected" : "entry-button")" aria-pressed="@(catalogEntry.Key == _state.SelectedEntry?.Key ? "true" : "false")" data-entry-key="@catalogEntry.Key" @onclick="@(() => SelectEntry(catalogEntry))" @key="catalogEntry.Key">
                                <span class="entry-identity"><MoIcon Icon="@GetEntryIcon(catalogEntry)" Size="1.25rem" /><strong>@catalogEntry.Title</strong></span>
                                @if (catalogEntry.Title != catalogEntry.Name) { <span class="technical entry-name">@catalogEntry.Name</span> }
                                <span class="entry-description">@catalogEntry.Description</span>
                                <span class="entry-meta"><MudChip T="string" Size="Size.Small" Color="@GetStatusColor(catalogEntry)" Variant="Variant.Outlined">@GetStatusText(catalogEntry)</MudChip><span>@catalogEntry.Tools.Count @L["Capabilities:Tools"]</span></span>
                                <span class="entry-source">@GetSourceText(catalogEntry)</span>
                            </button>
                        }
                        @if (_state.VisibleEntries.Count == 0) { <MoContentState Compact="true"><MudText Typo="Typo.body2">@L[_state.CurrentEntries.Count == 0 ? "Capabilities:Administration:CatalogEmpty" : "Capabilities:Administration:NoMatches"]</MudText></MoContentState> }
                    </div>
                </div>
            </aside>
            <div class="entry-dossier">
                @if (_state.SelectedEntry is { } entry)
                {
                    @if (!_state.VisibleEntries.Any(item => item.Key == entry.Key)) { <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Dense="true">@L["Capabilities:Administration:FilteredSelection"]</MudAlert> }
                    @RenderDetail(entry)
                }
                else { <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["Capabilities:SelectPrompt"]</MudAlert> }
            </div>
        </div>
    </div>;

    private RenderFragment RenderDetail(AgentCapabilityEntryInfo entry) => @<article class="detail-panel" @key="entry.Key">
        <header class="detail-header" data-entry-key="@entry.Key">
            <span class="identity-emblem"><MoIcon Icon="@GetEntryIcon(entry)" Size="1.5rem" /></span>
            <div class="detail-heading"><h2 tabindex="-1" id="@(_focusVisit + "-detail-title")">@entry.Title</h2><span class="technical">@entry.Name</span><p>@entry.Description</p></div>
            <MudSwitch T="bool" Value="@entry.IsEntryEnabled" ValueChanged="@((bool value) => SetEntryEnabledAsync(entry, value))" ReadOnly="@Busy" aria-disabled="@BusyAttribute" Color="Color.Primary" Label="@L["Capabilities:Administration:EntryEnabled"]" />
        </header>
        <section class="detail-section access-section">
            <h3>@L["Capabilities:Administration:AgentAccess"]</h3>
            <dl class="evidence-grid">
                <div><dt>@L["Capabilities:Administration:CatalogGate"]</dt><dd>@BooleanText(entry.IsCatalogEnabled)</dd></div>
                <div><dt>@L["Capabilities:Administration:EntrySetting"]</dt><dd>@BooleanText(entry.IsEntryEnabled)</dd></div>
                <div><dt>@L["Capabilities:Administration:ImplementationGate"]</dt><dd>@BooleanText(entry.IsBuiltInEnabled)</dd></div>
                <div><dt>@L["Capabilities:Administration:EffectiveAvailability"]</dt><dd><MudChip T="string" Size="Size.Small" Color="@GetStatusColor(entry)" Variant="Variant.Outlined">@GetStatusText(entry)</MudChip></dd></div>
            </dl>
            @if (!string.IsNullOrWhiteSpace(entry.DisabledReason)) { <MudAlert Icon="@(GetStatusColor(entry) == Color.Default ? MoIcons.Info : MoIcons.Warning)" Severity="@(GetStatusColor(entry) == Color.Default ? Severity.Info : Severity.Warning)" Dense="true">@FormatDisabledReason(entry.DisabledReason)</MudAlert> }
        </section>
        <section class="detail-section">
            <h3>@L["Capabilities:Administration:Registration"]</h3>
            <dl class="evidence-grid">
                <div><dt>@L["Capabilities:Administration:SourceFilter"]</dt><dd>@GetSourceText(entry)</dd></div>
                @if (!string.IsNullOrWhiteSpace(entry.ImplementationType)) { <div><dt>@L["Capabilities:Administration:ImplementationType"]</dt><dd class="technical">@entry.ImplementationType</dd></div> }
                <div><dt>@L["Capabilities:Administration:RequiredModules"]</dt><dd class="@(entry.RequiredModules.Count > 0 ? "technical" : null)">@(entry.RequiredModules.Count == 0 ? L["Capabilities:Administration:NoRequiredModules"].Value : string.Join(", ", entry.RequiredModules))</dd></div>
                @if (!string.IsNullOrWhiteSpace(entry.SourcePath)) { <div class="full-evidence"><dt>@L["Capabilities:Skill:SourcePath"]</dt><dd class="technical">@entry.SourcePath</dd></div> }
            </dl>
        </section>
        @if (entry.CanExposeAsMcpServer)
        {
            <section class="detail-section exposure-section">
                <h3>@L["Capabilities:Skill:McpServerTitle"]</h3><p>@L["Capabilities:Skill:McpServerDescription", entry.SkillMcpServerName ?? entry.Name]</p>
                <MudSwitch T="bool" Value="@entry.IsMcpServerExposureEnabled" ValueChanged="@((bool value) => SetSkillMcpServerEnabledAsync(entry, value))" ReadOnly="@Busy" aria-disabled="@BusyAttribute" Color="Color.Primary" Label="@L["Capabilities:Skill:McpServerToggle"]" />
                @if (entry.McpServerExposureRequiresRestart) { <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Dense="true">@L["Capabilities:Skill:McpServerRestartHint"]</MudAlert> }
            </section>
        }
        @if (entry.Kind == AgentCapabilityKind.Mcp)
        {
            <section class="detail-section connection-section">
                <h3>@L["Capabilities:Administration:Connection"]</h3>
                <dl class="evidence-grid">
                    <div><dt>@L["Capabilities:Administration:Transport"]</dt><dd>@(entry.McpExternalProfile?.TransportMode.ToString() ?? entry.McpTransportKind?.ToString())</dd></div>
                    <div><dt>@L["Capabilities:Administration:ProfileOwnership"]</dt><dd>@L[entry.IsUserManaged ? "Capabilities:Mcp:UserManaged" : "Capabilities:Administration:CodeManaged"]</dd></div>
                    @if (entry.McpExternalProfile is { } profile)
                    {
                        <div class="full-evidence"><dt>@L["Capabilities:Mcp:Endpoint"]</dt><dd class="technical">@profile.Endpoint</dd></div>
                        <div><dt>@L["Capabilities:Mcp:Dialog:Headers"]</dt><dd>@L["Capabilities:Mcp:Headers", profile.Headers.Count]</dd></div>
                        <div><dt>@L["Capabilities:Administration:AgentToolExposure"]</dt><dd>@BooleanText(profile.IsAgentToolEnabled)</dd></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.McpEndpointPath)) { <div class="full-evidence"><dt>@L["Capabilities:Administration:RegisteredPath"]</dt><dd class="technical">@entry.McpEndpointPath</dd></div> }
                    @if (!string.IsNullOrWhiteSpace(entry.McpDisplayUrl)) { <div class="full-evidence"><dt>@L["Capabilities:Administration:DisplayUrl"]</dt><dd class="technical">@entry.McpDisplayUrl</dd></div> }
                </dl>
                <div class="connection-actions">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@MoIcons.Pulse" aria-disabled="@BusyAttribute" OnClick="@(() => TestMcpAsync(entry))">@L["Capabilities:Mcp:Test"]</MudButton>
                    <MudTooltip Text="@L[CanCopyMcpConfig(entry) ? "Capabilities:Mcp:CopyConfigTooltip" : "Capabilities:Mcp:CopyConfigUnavailable"]">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@MoIcons.Copy" Disabled="@(!CanCopyMcpConfig(entry))" aria-disabled="@((Busy || _clipboardBusy || !CanCopyMcpConfig(entry)) ? "true" : "false")" OnClick="@(() => CopyMcpConfigAsync(entry))">@L[entry.McpExternalProfile?.Headers.Count > 0 ? "Capabilities:Administration:CopyIncludingHeaders" : "Capabilities:Mcp:CopyConfig"]</MudButton>
                    </MudTooltip>
                    @if (CanExportSkillPack(entry)) { <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@MoIcons.Download" aria-disabled="@BusyAttribute" OnClick="@(() => ShowSkillPackExportDialogAsync(entry))">@L["Capabilities:Mcp:ExportSkill:Action"]</MudButton> }
                    @if (entry.IsUserManaged)
                    {
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@MoIcons.Edit" aria-disabled="@BusyAttribute" OnClick="@(() => ShowEditMcpProfileDialogAsync(entry))">@L["Common:Edit"]</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@MoIcons.Delete" aria-disabled="@BusyAttribute" OnClick="@(() => DeleteMcpProfileAsync(entry))">@L["Common:Delete"]</MudButton>
                    }
                </div>
                <div class="probe-evidence" role="status" aria-live="polite">
                    <h4>@L["Capabilities:Administration:CheckTitle"]</h4>
                    @if (_state!.LastProbe is { } probe && probe.EntryKey == entry.Key)
                    {
                        @if (probe.Result is { } result)
                        {
                            <MudAlert Icon="@(result.Success ? MoIcons.Success : MoIcons.Error)" Severity="@(result.Success ? Severity.Success : Severity.Error)" Dense="true">@FormatConnectivityMessage(result)</MudAlert>
                            <dl class="probe-facts">
                                <div><dt>@L["Capabilities:Administration:TestedAt"]</dt><dd title="@UiTime.Format(result.TestedAt)">@UiTime.Format(result.TestedAt)</dd></div>
                                <div><dt>@L["Capabilities:Administration:Duration", result.Duration.TotalMilliseconds.ToString("0")]</dt><dd>@L["Capabilities:Administration:ToolCount", result.ToolCount]</dd></div>
                            </dl>
                            @if (result.ToolNames is { Count: > 0 } toolNames) { <p class="technical">@string.Join(", ", toolNames)</p> }
                        }
                        else { <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Dense="true">@probe.Error</MudAlert> }
                    }
                    else { <p>@L["Capabilities:Administration:NoCheck"]</p> }
                </div>
            </section>
        }
        @if (!string.IsNullOrWhiteSpace(entry.Content))
        {
            <MudExpansionPanels Elevation="0" Dense="true" Class="content-panels"><MudExpansionPanel Text="@L["Capabilities:Content"]" Icon="@MoIcons.FileText"><pre class="diagnostic-block">@entry.Content</pre></MudExpansionPanel></MudExpansionPanels>
        }
        <section class="detail-section tools-section">
            <h3>@L["Capabilities:Sections:Tools"] <span class="section-count">@entry.Tools.Count</span></h3>
            @if (!string.IsNullOrWhiteSpace(entry.DiscoveryError)) { <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Dense="true"><strong>@L["Capabilities:Administration:DiscoveryFailed"]</strong><div>@SanitizeDiagnostic(entry, entry.DiscoveryError)</div></MudAlert> }
            @if (entry.Tools.Count == 0)
            {
                @if (string.IsNullOrWhiteSpace(entry.DiscoveryError)) { <MudText Typo="Typo.body2">@L["Capabilities:NoTools"]</MudText> }
            }
            else
            {
                <div class="tool-table-owner">
                    <MudTable T="AgentCapabilityToolInfo" Items="@entry.Tools" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.Xs" Class="tool-table">
                        <HeaderContent><MudTh>@L["Capabilities:Tool:Name"]</MudTh><MudTh>@L["Capabilities:Tool:Parameters"]</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["Capabilities:Tool:Name"]"><strong class="technical tool-name">@context.Name</strong><p class="tool-description">@context.Description</p>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(context.IsEnabled ? Color.Success : Color.Default)">@L[context.IsEnabled ? "Capabilities:Administration:ToolAvailable" : "Capabilities:Administration:ToolUnavailable"]</MudChip>
                            </MudTd>
                            <MudTd DataLabel="@L["Capabilities:Tool:Parameters"]">
                                @if (context.Parameters.Count == 0) { <span>@L["Capabilities:Tool:NoParameters"]</span> }
                                else
                                {
                                    <dl class="parameter-list">
                                        @foreach (var parameter in context.Parameters)
                                        {
                                            <div><dt><span class="technical">@parameter.Name <span class="parameter-type">@parameter.Type</span></span><small>@L[parameter.IsRequired ? "Capabilities:Administration:ParameterRequired" : "Capabilities:Administration:ParameterOptional"]</small></dt>
                                                <dd>@parameter.Description @if (parameter.DefaultValue is not null) { <span class="technical parameter-default">@L["Capabilities:Administration:ParameterDefault"]: @parameter.DefaultValue</span> }</dd></div>
                                        }
                                    </dl>
                                }
                                @if (!string.IsNullOrWhiteSpace(context.ParametersSchemaJson))
                                {
                                    <div class="schema-disclosure">
                                        <MudExpansionPanels Elevation="0" Dense="true"><MudExpansionPanel Text="@L["Capabilities:Tool:Schema"]" Icon="@MoIcons.Braces"><MoJson Value="@context.ParametersSchemaJson" ShowLineNumbers="false" /></MudExpansionPanel></MudExpansionPanels>
                                    </div>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
        </section>
        @if (entry.Resources.Count > 0)
        {
            <section class="detail-section"><h3>@L["Capabilities:Sections:Resources"] <span class="section-count">@entry.Resources.Count</span></h3><dl class="resource-list">
                @foreach (var resource in entry.Resources) { <div><dt class="technical">@resource.Name</dt><dd>@resource.Description</dd></div> }
            </dl></section>
        }
    </article>;

    private RenderFragment RenderFileSources()
    {
        var management = _state.Management!;
        return @<details class="file-source-disclosure">
        <summary><span><strong>@L["Capabilities:Skill:Sources:Title"]</strong><small>@L["Capabilities:Skill:Sources:Summary", management.FileSkillSources.Sum(source => source.LoadedSkillCount), management.FileSkillSources.Count]</small></span>
            @if (management.FileSkillSources.Any(source => source.HasIssues)) { <span class="source-issue-label" role="status">@L["Capabilities:Skill:Sources:HasIssues"]</span> }
        </summary>
        <div class="file-source-body">
            @if (management.FileSkillSources.Count == 0) { <p>@L["Capabilities:Administration:NoSources"]</p> }
            @foreach (var source in management.FileSkillSources)
            {
                <section class="source-group">
                    <dl class="evidence-grid">
                        <div class="full-evidence"><dt>@L["Capabilities:Administration:ConfiguredRoots"]</dt><dd class="technical">@foreach (var root in source.ConfiguredPaths) { <div>@root</div> }</dd></div>
                        <div><dt>@L["Capabilities:Administration:RunnerType"]</dt><dd>@L[source.UsesSubprocessRunner ? "Capabilities:Skill:Sources:SubprocessRunner" : source.HasScriptRunner ? "Capabilities:Skill:Sources:CustomRunner" : "Capabilities:Skill:Sources:NoRunner"]</dd></div>
                        <div><dt>@L["Capabilities:Skill:Sources:Loaded", source.LoadedSkillCount]</dt><dd class="technical">@string.Join(", ", source.LoadedSkillNames)</dd></div>
                    </dl>
                    @if (!source.HasIssues) { <p>@L["Capabilities:Administration:NoReportedIssues"]</p> }
                    @if (source.Issues.Count > 0) { @RenderIssues(source.Issues) }
                    @foreach (var path in source.Paths)
                    {
                        <div class="source-path-group">
                            <div class="source-path-heading"><strong class="technical">@path.Path</strong><MudChip T="string" Size="Size.Small" Color="@(path.Exists ? Color.Default : Color.Warning)" Variant="Variant.Outlined">@L[path.Exists ? "Capabilities:Administration:PathExists" : "Capabilities:Administration:PathMissing"]</MudChip></div>
                            <p>@L["Capabilities:Skill:Sources:PathLoaded", path.LoadedSkillCount]</p>
                            @if (path.LoadedSkillNames.Count > 0) { <p class="technical">@string.Join(", ", path.LoadedSkillNames)</p> }
                            @if (path.Issues.Count > 0) { @RenderIssues(path.Issues) }
                        </div>
                    }
                </section>
            }
        </div>
    </details>;
    }

    private RenderFragment RenderIssues(IReadOnlyList<string> issues) => @<MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning" Dense="true"><ul class="issue-list">@foreach (var issue in issues) { <li>@issue</li> }</ul></MudAlert>;
}
