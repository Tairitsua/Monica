@attribute [Route(PAGE_URL)]
@implements IAsyncDisposable
@inject ConfigurationFacade Facade
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<PageTitle>@L["Pages:ConfigurationHistory:Title"]</PageTitle>

<div class="configuration-history-page">
    <ConfigurationPageHeader Title="@L["Pages:ConfigurationHistory:Title"]" Subtitle="@L["History:Subtitle"]">
        <Actions>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.Refresh"
                   Disabled="@_loading" OnClick="ReloadAsync">@L["Common:Actions:Refresh"]</MudButton>
        </Actions>
    </ConfigurationPageHeader>
    <ConfigurationWorkbenchNavigation ActiveRoute="@PAGE_URL" />
    @if (_metadataStoreDiagnostic is not null)
    {
        <ConfigurationMetadataStoreDiagnosticAlert Diagnostic="@_metadataStoreDiagnostic" />
    }
    <section class="configuration-history-workspace" aria-label="@L["History:Workbench:Records"]">
        <div class="configuration-history-introduction">
            <div class="configuration-history-introduction-copy">
                <span class="configuration-history-eyebrow">@L["History:Workbench:Evidence"]</span>
                <h2>@L["History:Workbench:Records"]</h2>
                <p>@L["History:Workbench:EvidenceHelp"]</p>
            </div>
            <div class="configuration-history-scope"><MoIcon Icon="@MoIcons.History" Size="1.25rem" /><span>@L["History:Workbench:Scope"]</span></div>
        </div>
        <div class="configuration-history-filters" role="search" aria-label="@L["History:Workbench:Filters"]">
            <div class="configuration-history-filter-grid">
                <div class="configuration-history-definition-filter">
                    <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" ClearIcon="@MoIcons.Close" T="string" @bind-Value="_definitionKey" Label="@L["State:Columns:Definition"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Disabled="@_loading">
                        @foreach (var definition in _definitions)
                        {
                            <MudSelectItem T="string" Value="@definition.DefinitionKey" Disabled="@(!definition.CanManage)">@DefinitionFilterLabel(definition)</MudSelectItem>
                        }
                    </MudSelect>
                </div>
                <div class="configuration-history-path-filter"><MudTextField T="string" @bind-Value="_pathText" Label="@L["Value:Path"]" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@_loading" aria-label="@L["Value:Path"]" /></div>
                <div><MudDatePicker AdornmentIcon="@MoIcons.Calendar" PreviousIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" @bind-Date="_fromDate" Label="@L["History:Filters:From"]" AdornmentAriaLabel="@L["History:Workbench:OpenFrom"]" Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" Disabled="@_loading" /></div>
                <div><MudDatePicker AdornmentIcon="@MoIcons.Calendar" PreviousIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" @bind-Date="_toDate" Label="@L["History:Filters:To"]" AdornmentAriaLabel="@L["History:Workbench:OpenTo"]" Variant="Variant.Outlined" Margin="Margin.Dense" Editable="true" Disabled="@_loading" /></div>
                <div class="configuration-history-search-action"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Search" Disabled="@_loading" OnClick="LoadAsync">@L["Common:Actions:Search"]</MudButton></div>
            </div>
            <div class="configuration-history-filter-bottom">
                <div class="configuration-history-target-filters" role="group" aria-label="@L["History:Filters:Target"]">
                    <MudButton Variant="Variant.Text" Class="@TargetButtonClass(TARGET_FILTER_ALL)" Disabled="@_loading" aria-pressed="@(_targetFilter == TARGET_FILTER_ALL ? "true" : "false")" OnClick="() => SelectTarget(TARGET_FILTER_ALL)">@L["History:Filters:TargetAll"]</MudButton>
                    <MudButton Variant="Variant.Text" Class="@TargetButtonClass(TARGET_FILTER_MONICA)" Disabled="@_loading" StartIcon="@MoIcons.Database" aria-pressed="@(_targetFilter == TARGET_FILTER_MONICA ? "true" : "false")" OnClick="() => SelectTarget(TARGET_FILTER_MONICA)">@L["History:Filters:TargetMonica"]</MudButton>
                    <MudButton Variant="Variant.Text" Class="@TargetButtonClass(TARGET_FILTER_EXTERNAL)" Disabled="@_loading" StartIcon="@MoIcons.FileText" aria-pressed="@(_targetFilter == TARGET_FILTER_EXTERNAL ? "true" : "false")" OnClick="() => SelectTarget(TARGET_FILTER_EXTERNAL)">@L["History:Filters:TargetExternal"]</MudButton>
                </div>
                <span>@L["History:Workbench:FilterHelp"]</span>
            </div>
        </div>
        <div class="configuration-history-tabs">
            <MudTabs PrevIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" @bind-ActivePanelIndex="_selectedTab" Elevation="0" Rounded="false" MinimumTabWidth="120px" KeepPanelsAlive="false">
                <MudTabPanel Text="@L["History:Tabs:Mutations"]" Icon="@MoIcons.ClipboardList">
                    <div class="configuration-history-results" aria-busy="@(_loading ? "true" : "false")">
                        <div class="configuration-history-result-heading"><div><h3>@L["History:Workbench:Changes"]</h3><p>@HistoryQuerySummary</p></div>@if (_hasLoadedHistory && !_loading) { <span>@L["History:Workbench:LoadedChanges", _history.Count, _displayHistory.Count]</span> }</div>
                        @if (_hasLoadedHistory && !string.IsNullOrWhiteSpace(_historyLoadError)) { <div class="configuration-history-query-error"><MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_historyLoadError</MudAlert></div> }
                        @if (_loading)
                        {
                            <MoContentState Loading="true"><MudProgressCircular Size="Size.Medium" Indeterminate="true" Color="Color.Primary" /><p>@L["Common:States:Loading"]</p></MoContentState>
                        }
                        else if (!string.IsNullOrWhiteSpace(_historyLoadError) && !_hasLoadedHistory)
                        {
                            <MoContentState><MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_historyLoadError</MudAlert></MoContentState>
                        }
                        else if (_displayHistory.Count == 0)
                        {
                            <MoContentState><MoIcon Icon="@MoIcons.History" Size="1.5rem" /><h3>@L["History:States:Empty"]</h3><p>@L["History:Workbench:EmptyHelp"]</p></MoContentState>
                        }
                        else
                        {
                            <div class="configuration-history-table">
                                <MudTable T="ConfigurationHistoryDisplayRow" Items="@_displayHistory" Hover="true" Elevation="0" Square="true" Breakpoint="Breakpoint.Sm">
                                    <ColGroup><col class="configuration-history-column-identity" /><col class="configuration-history-column-source" /><col class="configuration-history-column-audit" /><col class="configuration-history-column-actions" /></ColGroup>
                                    <HeaderContent><MudTh>@L["History:Workbench:Configuration"]</MudTh><MudTh>@L["History:Columns:Target"]</MudTh><MudTh>@L["History:Workbench:Audit"]</MudTh><MudTh>@L["History:Workbench:Actions"]</MudTh></HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="@L["History:Workbench:Configuration"]">
                                            <div class="configuration-history-identity">
                                                <MudTooltip Text="@string.Join(Environment.NewLine, DefinitionMetadataLines(context.Representative.DefinitionKey))"><MudButton Variant="Variant.Text" Color="Color.Primary" Class="configuration-history-definition-link" OnClick="() => NavigateToDefinition(context.Representative.DefinitionKey, context.DisplayPath)">@DefinitionDisplay(context.Representative.DefinitionKey)</MudButton></MudTooltip>
                                                <ConfigurationAuditIdentity Label="@L["Versions:Definitions:FullIdentity"]" Value="@context.Representative.DefinitionKey" ShowPreview="false" />
                                                <MudTooltip Text="@string.Join(Environment.NewLine, PathMetadataLines(context))"><code class="configuration-history-path">@DisplayPath(context.DisplayPath)</code></MudTooltip>
                                                <div class="configuration-history-row-meta"><span class="@MutationClass(context.Representative.MutationKind)">@L[$"Mutation:Kinds:{context.Representative.MutationKind}"]</span><span>@L["History:Dialog:Version", context.Version]</span>@if (context.IsCollapsed) { <span>@L["History:CollapsedCount", context.Rows.Count]</span> }</div>
                                            </div>
                                        </MudTd>
                                        <MudTd DataLabel="@L["History:Columns:Target"]">
                                            <div class="configuration-history-source">
                                                <MudTooltip Text="@HistoryTargetTooltip(context.Rows)"><span class="@HistoryTargetClass(context.Rows)"><MoIcon Icon="@HistoryTargetIcon(context.Rows)" Size="1.25rem" />@HistoryTargetLabel(context.Rows)</span></MudTooltip>
                                                @if (!string.IsNullOrWhiteSpace(context.Representative.SourceDisplayName)) { <span>@context.Representative.SourceDisplayName</span> }
                                                @if (!string.IsNullOrWhiteSpace(context.Representative.SourceConfigurationPath)) { <code>@context.Representative.SourceConfigurationPath</code> }
                                            </div>
                                        </MudTd>
                                        <MudTd DataLabel="@L["History:Workbench:Audit"]">
                                            <div class="configuration-history-audit">
                                                <time datetime="@context.ModifiedTime.ToString("O")">@TimeDisplay.Format(context.ModifiedTime)</time>
                                                <span>@AuditOperator(context.Representative.ModifierName, context.Representative.ModifierId)</span>
                                                @if (!string.IsNullOrWhiteSpace(context.Representative.MutationGroupId)) { <strong>@GroupLabel(context.Representative.MutationGroupId)</strong> }
                                                @if (!string.IsNullOrWhiteSpace(context.Representative.Reason)) { <p>@context.Representative.Reason</p> }
                                            </div>
                                        </MudTd>
                                        <MudTd DataLabel="@L["History:Workbench:Actions"]"><div class="configuration-history-row-actions"><MudTooltip Text="@L["History:Actions:ViewChange"]"><MudIconButton Icon="@MoIcons.ArrowLeftRight" Size="Size.Small" OnClick="() => ShowHistoryAsync(context)" aria-label="@L["History:Actions:ViewChange"]" /></MudTooltip><MudTooltip Text="@RollbackTooltip(CanRollbackHistory(context))"><MudIconButton Icon="@MoIcons.Restore" Size="Size.Small" Color="Color.Warning" Disabled="@(!CanRollbackHistory(context))" OnClick="() => RollbackHistoryAsync(context)" aria-label="@L["Rollback:Confirm"]" /></MudTooltip></div></MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </div>
                        }
                        @if (_hasLoadedHistory && !_loading) { <footer class="configuration-history-results-footer"><span>@L["History:Workbench:LoadedChanges", _history.Count, _displayHistory.Count]</span>@if (_historyHasMore) { <MudButton Variant="Variant.Outlined" Disabled="@_loadingMoreHistory" OnClick="LoadMoreHistoryAsync">@L["History:Actions:LoadMore"]</MudButton> }</footer> }
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="@L["History:Tabs:Groups"]" Icon="@MoIcons.FolderOpen">
                    <div class="configuration-history-results" aria-busy="@(_loading ? "true" : "false")">
                        <div class="configuration-history-result-heading"><div><h3>@L["History:Workbench:Groups"]</h3><p>@GroupQuerySummary</p></div>@if (_hasLoadedGroups && !_loading) { <span>@L["History:Workbench:LoadedGroups", _groups.Count]</span> }</div>
                        @if (_hasLoadedGroups && !string.IsNullOrWhiteSpace(_groupLoadError)) { <div class="configuration-history-query-error"><MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_groupLoadError</MudAlert></div> }
                        @if (_loading)
                        {
                            <MoContentState Loading="true"><MudProgressCircular Size="Size.Medium" Indeterminate="true" Color="Color.Primary" /><p>@L["Common:States:Loading"]</p></MoContentState>
                        }
                        else if (!string.IsNullOrWhiteSpace(_groupLoadError) && !_hasLoadedGroups)
                        {
                            <MoContentState><MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_groupLoadError</MudAlert></MoContentState>
                        }
                        else if (_groups.Count == 0)
                        {
                            <MoContentState><MoIcon Icon="@MoIcons.FolderOpen" Size="1.5rem" /><h3>@L["Group:Empty"]</h3><p>@L["History:Workbench:EmptyHelp"]</p></MoContentState>
                        }
                        else
                        {
                            <div class="configuration-history-table">
                                <MudTable T="ConfigurationMutationGroup" Items="@_groups" Hover="true" Elevation="0" Square="true" Breakpoint="Breakpoint.Sm">
                                    <ColGroup><col class="configuration-history-column-identity" /><col class="configuration-history-column-source" /><col class="configuration-history-column-audit" /><col class="configuration-history-column-actions" /></ColGroup>
                                    <HeaderContent><MudTh>@L["Group:Label"]</MudTh><MudTh>@L["Group:Definitions"]</MudTh><MudTh>@L["Group:Status"]</MudTh><MudTh>@L["History:Workbench:Actions"]</MudTh></HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="@L["Group:Label"]"><div class="configuration-history-audit"><strong>@context.Label</strong><ConfigurationAuditIdentity Label="@L["History:Dialog:MutationGroup"]" Value="@context.GroupId" />@if (!string.IsNullOrWhiteSpace(context.Reason)) { <p>@context.Reason</p> }<time datetime="@context.CreatedTime.ToString("O")">@TimeDisplay.Format(context.CreatedTime)</time><span>@AuditOperator(context.ModifierName, context.ModifierId)</span></div></MudTd>
                                        <MudTd DataLabel="@L["Group:Definitions"]"><ConfigurationDefinitionScope @key="context.GroupId" DefinitionKeys="context.DefinitionKeys" DisplayName="DefinitionDisplay" OnDefinitionSelected="NavigateToGroupDefinition" /></MudTd>
                                        <MudTd DataLabel="@L["Group:Status"]"><div class="configuration-history-source"><span class="@GroupStatusClass(context.Status)"><span class="configuration-history-status-dot"></span>@StatusText(context.Status)</span><span aria-label="@L["Group:MutationCount"]">@L["History:Workbench:MutationCount", context.MutationCount]</span>@if (context.RolledBackTime is not null) { <time datetime="@context.RolledBackTime.Value.ToString("O")">@TimeDisplay.Format(context.RolledBackTime.Value)</time> }</div></MudTd>
                                        <MudTd DataLabel="@L["History:Workbench:Actions"]"><div class="configuration-history-row-actions"><MudTooltip Text="@L["Group:ViewHistory"]"><MudIconButton Icon="@MoIcons.ClipboardList" Size="Size.Small" OnClick="() => ShowGroupHistoryAsync(context)" aria-label="@L["Group:ViewHistory"]" /></MudTooltip><MudTooltip Text="@RollbackTooltip(CanRollbackGroup(context))"><MudIconButton Icon="@MoIcons.Restore" Size="Size.Small" Color="Color.Warning" Disabled="@(!CanRollbackGroup(context))" OnClick="() => RollbackGroupAsync(context)" aria-label="@L["Rollback:Confirm"]" /></MudTooltip></div></MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </div>
                        }
                        @if (_hasLoadedGroups && !_loading) { <footer class="configuration-history-results-footer"><span>@L["History:Workbench:LoadedGroups", _groups.Count]</span>@if (_groupsHaveMore) { <MudButton Variant="Variant.Outlined" Disabled="@_loadingMoreGroups" OnClick="LoadMoreGroupsAsync">@L["History:Actions:LoadMore"]</MudButton> }</footer> }
                    </div>
                </MudTabPanel>
            </MudTabs>
        </div>
    </section>
</div>
