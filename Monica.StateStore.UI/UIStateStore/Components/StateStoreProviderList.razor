@using Monica.UI.Shared.Components.States
@using Monica.StateStore.UI.Models
@inject IStringLocalizer<StateStoreResource> L

<section class="provider-list-panel">
        <div class="provider-list-panel__header">
            <MudText Typo="Typo.h6">@L["ProviderList:Labels:RegisteredProviders"]</MudText>
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@MoIcons.Refresh"
                       OnClick="OnRefresh"
                       Disabled="IsLoading">
                @L["ProviderList:Actions:Refresh"]
            </MudButton>
        </div>

    @if (IsLoading)
    {
            <MoContentState Loading="true" Compact="true">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </MoContentState>
    }
    else if (!Providers.Any())
    {
            <MoContentState Compact="true"><MoIcon Icon="@MoIcons.Info" Size="1.5rem" /><p>@L["ProviderList:Messages:NoProvidersFound"]</p></MoContentState>
    }
    else
    {
        <div class="provider-list-panel__rows">
            @foreach (var provider in Providers)
            {
                <StateStoreProviderCard Provider="provider"
                                       OnViewDetailsClicked="HandleViewDetails" />
            }
        </div>
    }
</section>

<!-- Provider details dialog -->
<StateStoreProviderDetailDialog IsVisible="_showProviderDetail"
                               IsVisibleChanged="OnProviderDetailVisibilityChanged"
                               Provider="_selectedProvider" />

@code {
    [Parameter] public List<StateStoreProviderInfo> Providers { get; set; } = [];
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private bool _showProviderDetail;
    private StateStoreProviderInfo? _selectedProvider;

    private void HandleViewDetails(StateStoreProviderInfo provider)
    {
        _selectedProvider = provider;
        _showProviderDetail = true;
    }

    private Task OnProviderDetailVisibilityChanged(bool isVisible)
    {
        _showProviderDetail = isVisible;

        if (!isVisible)
        {
            _selectedProvider = null;
        }

        return Task.CompletedTask;
    }
}
