@inject NavigationManager Navigation
@using System.Globalization
@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L

<div class="analytics-dashboard">
    <div class="analytics-dashboard__completion">
        <SchedulerCompletionTrend Snapshot="@Snapshot" />
        <section class="analytics-dashboard__summary" aria-labelledby="@_summaryHeadingId">
            <header class="analytics-dashboard__heading">
                <span class="analytics-dashboard__heading-icon" aria-hidden="true"><MoIcon Icon="@MoIcons.ChartColumn" Size="1.25rem" /></span>
                <h2 id="@_summaryHeadingId">@L["Analytics:Summary:Title"]</h2>
            </header>
            <dl class="analytics-dashboard__summary-facts" aria-label="@L["Analytics:Metrics:AriaLabel"]">
                <div data-tone="success">
                    <dt>@L["Analytics:Metrics:Reliability"]</dt>
                    <dd>@FormatRatio(Snapshot.Reliability, DecidedCount)</dd>
                    <dd class="analytics-dashboard__summary-detail">@L["Analytics:Metrics:DecidedRuns", DecidedCount]</dd>
                </div>
                <div data-tone="info">
                    <dt>@L["Analytics:Metrics:ScheduleFulfillment"]</dt>
                    <dd>@FormatRatio(Snapshot.RecurringScheduleFulfillment, Snapshot.RecurringScheduleDispositionCount)</dd>
                    <dd class="analytics-dashboard__summary-detail">@L["Analytics:Metrics:ScheduledDispositions", Snapshot.RecurringScheduleDispositionCount]</dd>
                </div>
                <div data-tone="primary">
                    <dt>@L["Analytics:Metrics:Throughput"]</dt>
                    <dd>@Snapshot.ExecutedThroughputPerHour.ToString("N2", CultureInfo.CurrentCulture)</dd>
                    <dd class="analytics-dashboard__summary-detail">@L["Analytics:Metrics:PerHour"]</dd>
                    <dd class="analytics-dashboard__summary-detail">@L["Analytics:Metrics:ExecutionSample", Snapshot.ExecutedTerminalCount, WindowHours]</dd>
                </div>
            </dl>
        </section>
    </div>

    <SchedulerExecutionStateShare Snapshot="@Snapshot" />

    <SchedulerAnalyticsDurationEvidence Snapshot="@Snapshot" InspectExecution="@InspectExecution" />

    <div class="analytics-dashboard__rankings">
        @foreach (var group in RankingGroups)
        {
            <section class="analytics-dashboard__ranking" data-tone="@group.Tone" aria-labelledby="@group.HeadingId">
                <header class="analytics-dashboard__heading analytics-dashboard__heading--ranking">
                    <div>
                        <h2 id="@group.HeadingId">@group.Label</h2>
                        <p>@group.Description</p>
                        <p class="analytics-dashboard__denominator">@group.PopulationLabel</p>
                    </div>
                    <span class="analytics-dashboard__population">@L["Analytics:Rankings:TopTen"]</span>
                </header>
                @if (group.Items.Count == 0)
                {
                    <div class="analytics-dashboard__empty">
                        <MoIcon Icon="@MoIcons.ChartColumn" Size="1.5rem" />
                        <p>@group.EmptyLabel</p>
                    </div>
                }
                else
                {
                    <ol class="analytics-dashboard__ranking-list">
                        @for (var index = 0; index < group.Items.Count; index++)
                        {
                            var item = group.Items[index];
                            var value = group.GetValue(item);
                            <li @key="new JobId(item.OwnerKey, item.JobKey)">
                                <a href="@JobSchedulerUiUrls.JobDefinition(new JobId(item.OwnerKey, item.JobKey), Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery)"
                                   aria-label="@L["Analytics:Rankings:OpenJobWithMetric", index + 1, item.JobName, group.Label, value, FormatShare(value, group.TotalValue)]">
                                    <span class="analytics-dashboard__rank-number">@(index + 1)</span>
                                    <span class="analytics-dashboard__rank-copy">
                                        <strong>@item.JobName</strong>
                                        <span class="analytics-dashboard__identity"><span>@L["ExecutionDetail:Owner"]</span><code>@item.OwnerKey</code></span>
                                        <span class="analytics-dashboard__identity"><span>@L["ExecutionDetail:Job"]</span><code>@item.JobKey</code></span>
                                        @if (group.TotalValue > 0)
                                        {
                                            <progress aria-hidden="true" max="@group.TotalValue" value="@value">@value</progress>
                                        }
                                    </span>
                                    <span class="analytics-dashboard__rank-value">
                                        <b>@value.ToString("N0", CultureInfo.CurrentCulture)</b>
                                        <small>@FormatShare(value, group.TotalValue)</small>
                                    </span>
                                    <span class="analytics-dashboard__rank-arrow" aria-hidden="true"><MoIcon Icon="@MoIcons.ArrowRight" Size="1.25rem" /></span>
                                </a>
                            </li>
                        }
                    </ol>
                }
            </section>
        }
    </div>
</div>

@code {
    private readonly string _summaryHeadingId = $"analytics-summary-{Guid.NewGuid():N}";
    private readonly string _volumeHeadingId = $"analytics-volume-{Guid.NewGuid():N}";
    private readonly string _failuresHeadingId = $"analytics-failures-{Guid.NewGuid():N}";

    /// <summary>Gets the accepted bounded durable-store evidence rendered by this dashboard.</summary>
    /// <remarks>The parent owns authorization, query admission, freshness, errors and retirement.</remarks>
    [Parameter, EditorRequired]
    public JobExecutionAnalyticsSnapshot Snapshot { get; set; } = null!;

    /// <summary>Gets the callback for inspecting the exact immutable slow-record capture displayed by the dashboard.</summary>
    /// <remarks>
    /// The parent must freshly authorize inspection and owns duplicate admission, the actual native dialog reference
    /// and Result, refresh and retirement. Unlike the previous dashboard, this presentation does not open dialogs.
    /// Identities are opaque; preserve the supplied instance, owner and job keys exactly.
    /// </remarks>
    [Parameter, EditorRequired]
    public EventCallback<JobExecutionAnalyticsSlowExecution> InspectExecution { get; set; }

    private long FailedCount => Snapshot.Trend.Sum(static bucket => bucket.FailedCount);
    private long DecidedCount => Snapshot.Trend.Sum(static bucket => bucket.SucceededCount + bucket.FailedCount);
    private string WindowHours => (Snapshot.EndTimeUtc - Snapshot.StartTimeUtc).TotalHours.ToString("G6", CultureInfo.CurrentCulture);
    private static string FormatRatio(double value, long denominator) => denominator > 0 ? value.ToString("P1", CultureInfo.CurrentCulture) : "—";
    private static string FormatShare(long value, long total) => total > 0 ? (value / (double)total).ToString("P1", CultureInfo.CurrentCulture) : "—";

    private IReadOnlyList<AnalyticsRankingGroup> RankingGroups =>
    [
        new(_volumeHeadingId, L["Analytics:Rankings:Volume"], L["Analytics:Rankings:VolumeDescription"],
            L["Analytics:Rankings:VolumePopulation", Snapshot.CompletedTerminalCount], Snapshot.TopJobsByVolume,
            static item => item.CompletedTerminalCount, Snapshot.CompletedTerminalCount, L["Analytics:Rankings:VolumeEmpty"], "primary"),
        new(_failuresHeadingId, L["Analytics:Rankings:Failures"], L["Analytics:Rankings:FailuresDescription"],
            L["Analytics:Rankings:FailurePopulation", FailedCount], Snapshot.TopJobsByFailures,
            static item => item.FailedCount, FailedCount, L["Analytics:Rankings:FailuresEmpty"], "error")
    ];

    private sealed record AnalyticsRankingGroup(
        string HeadingId, string Label, string Description, string PopulationLabel,
        IReadOnlyList<JobExecutionAnalyticsJobRank> Items, Func<JobExecutionAnalyticsJobRank, long> GetValue,
        long TotalValue, string EmptyLabel, string Tone);
}
