@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.DataChannel.Models
@using Monica.DataChannel.UIDataChannel.Abstractions
@using Monica.DataChannel.UIDataChannel.Models
@using Monica.DataChannel.UIDataChannel.Support
@inject IStringLocalizer<DataChannelResource> L
@inject IEnumerable<IDataChannelMiddlewareRowAction> MiddlewareRowActions
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Logging.ILogger<ChannelPipelineDialog> Logger
@implements IAsyncDisposable

<MudDialog>
    <DialogContent>
        <div class="pipeline-inspector">
            <header class="pipeline-inspector__identity">
                <div>
                    <span>@L["PipelineInspector:Eyebrow"]</span>
                    <h2>@Channel.Id</h2>
                    <p>@DataChannelPresentation.Group(Channel.GroupId, L)</p>
                </div>
                <span class="pipeline-state" data-state="@DataChannelPresentation.Initialization(Channel)">
                    <MoIcon Icon="@DataChannelPresentation.InitializationIcon(Channel)" Size="1.25rem" />@L[$"Channel:States:{DataChannelPresentation.Initialization(Channel)}"]</span>
            </header>
            <div class="pipeline-inspector__capture">
                <span>@L["Workbench:Captured"] <time>@UiTime.Format(Channel.CapturedAt)</time>
                </span>
                <span>@L["PipelineInspector:FrozenHelp"]</span>
            </div>
            <div class="pipeline-inspector__actions">
                @if (OnReinitialize is not null)
                {
                    <MudButton Size="Size.Small" StartIcon="@MoIcons.Refresh" OnClick="() => RunAsync(() => OnReinitialize(Channel.Id, _token))" Disabled="_busy">@L["Channel:Actions:Reinitialize"]</MudButton>
                }
                @if (OnViewExceptions is not null)
                {
                    <MudButton Size="Size.Small" Color="Color.Primary" StartIcon="@MoIcons.Error" OnClick="() => RunAsync(() => OnViewExceptions(Channel.Id, _token))" aria-disabled="@(_busy ? "true" : "false")">@L["Channel:Actions:ViewExceptions"] (@Channel.ExceptionCount)</MudButton>
                }
            </div>
            <div class="pipeline-inspector__tabs">
                <MudTabs Elevation="0" Rounded="false" KeepPanelsAlive="true" MinimumTabWidth="var(--datachannel-tab-min-width, 160px)" PrevIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight">
                    <MudTabPanel Text="@L["PipelineInspector:Tabs:Pipeline"]">
                        <div class="pipeline-tab">
                            <h3>@L["PipelineInspector:MessagePath"]</h3>
                            <p class="pipeline-help">@L["PipelineInspector:DirectionHelp"]</p>
                            <div class="pipeline-directions">
                                <div>
                                    <span>@L["PipelineInspector:FromInner"]</span>
                                    <code>@Channel.InnerEndpoint.TypeName</code>
                                    <MoIcon Icon="@MoIcons.ArrowRight" Size="1.5rem" />
                                    <code>@Channel.OuterEndpoint.TypeName</code>
                                    <small>@L["PipelineInspector:ToOuter"]</small>
                                </div>
                                <div>
                                    <span>@L["PipelineInspector:FromOuter"]</span>
                                    <code>@Channel.OuterEndpoint.TypeName</code>
                                    <MoIcon Icon="@MoIcons.ArrowRight" Size="1.5rem" />
                                    <code>@Channel.InnerEndpoint.TypeName</code>
                                    <small>@L["PipelineInspector:ToInner"]</small>
                                </div>
                            </div>
                            <h3>@L["PipelineInspector:TransformChain"]</h3>
                            @if (TransformComponents.Count == 0)
                            {
                                <p class="pipeline-empty">@L["PipelineInspector:NoTransforms"]</p>
                            }
                            else
                            {
                                <ol class="pipeline-chain">
                                    @foreach (var component in TransformComponents)
                                    {
                                        <li @key="component.ComponentKey">
                                            <span>@(component.Ordinal + 1)</span>
                                            <div>
                                                <code>@component.TypeName</code>
                                                <small>@L[$"Pipeline:ComponentKinds:{DataChannelPresentation.KindKey(component.Type)}"]</small>
                                            </div>
                                        </li>
                                    }
                                </ol>
                            }
                            <h3>@L["PipelineInspector:EndpointConfiguration"]</h3>
                            <p class="pipeline-help">@L["PipelineInspector:EndpointConfigurationHelp"]</p>
                            @if (EndpointConfigurationComponents.Count == 0)
                            {
                                <p class="pipeline-empty">@L["PipelineInspector:NoEndpointConfiguration"]</p>
                            }
                            else
                            {
                                <ol class="pipeline-configuration">
                                    @foreach (var component in EndpointConfigurationComponents)
                                    {
                                        <li @key="component.ComponentKey">
                                            <span>@(component.Ordinal + 1)</span>
                                            <code>@component.TypeName</code>
                                        </li>
                                    }
                                </ol>
                            }
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="@L["PipelineInspector:Tabs:Endpoints"]">
                        <div class="pipeline-tab pipeline-endpoints">
                            @foreach (var endpoint in new[] { Channel.InnerEndpoint, Channel.OuterEndpoint })
                            {
                                <section class="pipeline-endpoint">
                                    <header>
                                        <span>@L[endpoint.Stage == PipelineComponentStage.InnerEndpoint ? "PipelineInspector:Inner" : "PipelineInspector:Outer"]</span>
                                        <h3>@endpoint.TypeName</h3>
                                        @if (endpoint.IsTransient)
                                        {
                                            <p>@L["PipelineInspector:Transient"]</p>
                                        }
                                    </header>
                                    <MetadataDisplay Metadata="endpoint.Metadata" />
                                </section>
                            }
                        </div>
                    </MudTabPanel>
                    <MudTabPanel Text="@L["PipelineInspector:Tabs:Middleware"]">
                        <div class="pipeline-tab">
                            <h3>@L["PipelineInspector:MiddlewareTitle"]</h3>
                            <p class="pipeline-help">@L["PipelineInspector:MiddlewareHelp"]</p>
                            @if (Channel.Middlewares.Count == 0)
                            {
                                <p class="pipeline-empty">@L["PipelineInspector:NoMiddleware"]</p>
                            }
                            else
                            {
                                <div class="pipeline-middleware-table">
                                    <MudTable T="PipelineComponentInfo" Items="Channel.Middlewares" Square="true" Elevation="0" Dense="true" Hover="true" Breakpoint="Breakpoint.Xs">
                                        <HeaderContent>
                                            <MudTh>@L["PipelineInspector:Component"]</MudTh>
                                            <MudTh>@L["PipelineInspector:Stage"]</MudTh>
                                            <MudTh>@L["PipelineInspector:Kind"]</MudTh>
                                            <MudTh>@L["Common:Columns:Actions"]</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="@L["PipelineInspector:Component"]">
                                                <code class="middleware-type">@context.TypeName</code>
                                                @if (context.IsTransient)
                                                {
                                                    <small class="middleware-lifetime">@L["PipelineInspector:Transient"]</small>
                                                }
                                            </MudTd>
                                            <MudTd DataLabel="@L["PipelineInspector:Stage"]">@L[context.Stage == PipelineComponentStage.Transform ? "PipelineInspector:TransformStage" : "PipelineInspector:ConfigurationStage"] @(context.Ordinal + 1)</MudTd>
                                            <MudTd DataLabel="@L["PipelineInspector:Kind"]">@L[$"Pipeline:ComponentKinds:{DataChannelPresentation.KindKey(context.Type)}"]</MudTd>
                                            <MudTd DataLabel="@L["Common:Columns:Actions"]">
                                                <div class="middleware-actions">
                                                    <MudButton Size="Size.Small" Color="Color.Primary" OnClick="() => _selectedComponent = context" aria-label="@L["PipelineInspector:InspectComponent", context.Name, context.Ordinal + 1]">@L["Channel:Actions:Inspect"]</MudButton>
                                                    @if (context.CanDebugMessages && OnOpenDebugger is not null)
                                                    {
                                                        <MudTooltip Text="@L["Debugger:Actions:Open"]">
                                                            <MudIconButton Icon="@MoIcons.Bug" Color="Color.Primary" Size="Size.Small" aria-disabled="@(_busy ? "true" : "false")" OnClick="() => RunAsync(() => OnOpenDebugger(context, _token))" aria-label="@L["Debugger:Actions:Open"]" />
                                                        </MudTooltip>
                                                    }
                                                    @foreach (var action in GetActions(context))
                                                    {
                                                        <MudTooltip Text="@action.Tooltip">
                                                            <MudIconButton Icon="@action.Icon" Color="@action.Color" Size="Size.Small" Disabled="_busy" OnClick="() => RunAsync(() => action.ExecuteAsync(Channel.Id, context))" aria-label="@action.Tooltip" />
                                                        </MudTooltip>
                                                    }
                                                </div>
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </div>
                                @if (_selectedComponent is { } selected)
                                {
                                    <section class="middleware-evidence">
                                        <header>
                                            <h3>@selected.TypeName</h3>
                                            <span>@L["Workbench:Captured"] @UiTime.Format(selected.CapturedAt)</span>
                                        </header>
                                        @if (selected.InfoDictionary is { Count: > 0 } information)
                                        {
                                            <dl class="middleware-information">
                                                @foreach (var entry in information)
                                                {
                                                    <div>
                                                        <dt>@entry.Key</dt>
                                                        <dd>
                                                            <MetadataDisplay Metadata="entry.Value" />
                                                        </dd>
                                                    </div>
                                                }
                                            </dl>
                                        }
                                        <h4>@L["PipelineInspector:Metadata"]</h4>
                                        <MetadataDisplay Metadata="selected.Metadata" />
                                    </section>
                                }
                            }
                        </div>
                    </MudTabPanel>
                </MudTabs>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    /// <summary>Gets or sets the detached channel evidence frozen when the inspector opened.</summary>
    [Parameter, EditorRequired]
    public DataChannelStatusInfo Channel { get; set; } = null!;

    /// <summary>Gets or sets exact keyed live debugger resolution. The owner must retire native child dialogs using the supplied inspector lifetime.</summary>
    [Parameter]
    public Func<PipelineComponentInfo, CancellationToken, Task>? OnOpenDebugger { get; set; }

    /// <summary>Gets or sets real endpoint initialization, canceled when the supplied inspector lifetime retires.</summary>
    [Parameter]
    public Func<string, CancellationToken, Task>? OnReinitialize { get; set; }

    /// <summary>Gets or sets a new exception capture. The owner must retire native child dialogs using the supplied inspector lifetime.</summary>
    [Parameter]
    public Func<string, CancellationToken, Task>? OnViewExceptions { get; set; }

    private PipelineComponentInfo? _selectedComponent;
    private readonly CancellationTokenSource _lifetime = new();
    private readonly CancellationToken _token;
    private readonly object _retirementGate = new();
    private Task? _pendingAction;
    private Task? _disposeTask;
    private bool _busy;
    private bool _retired;
    /// <summary>Creates an inspector-owned cancellation lifetime without taking ownership of any host component.</summary>
    public ChannelPipelineDialog() => _token = _lifetime.Token;
    private List<PipelineComponentInfo> TransformComponents => Channel.Middlewares.Where(component => component.Stage == PipelineComponentStage.Transform).OrderBy(component => component.Ordinal).ToList();
    private List<PipelineComponentInfo> EndpointConfigurationComponents => Channel.Middlewares.Where(component => component.Stage == PipelineComponentStage.EndpointConfiguration).OrderBy(component => component.Ordinal).ToList();
    protected override void OnInitialized() => _selectedComponent = Channel.Middlewares.FirstOrDefault();
    private IEnumerable<IDataChannelMiddlewareRowAction> GetActions(PipelineComponentInfo component) => MiddlewareRowActions.Where(action => action.IsVisible(Channel.Id, component)).OrderBy(action => action.Order);
    private Task RunAsync(Func<Task> action)
    {
        if (_retired || _busy) { return Task.CompletedTask; }
        _busy = true;
        return _pendingAction = RunCoreAsync(action);
    }
    private async Task RunCoreAsync(Func<Task> action)
    {
        try { await action(); }
        catch (OperationCanceledException) when (_token.IsCancellationRequested) { }
        catch (Exception exception)
        {
            Microsoft.Extensions.Logging.LoggerExtensions.LogError(Logger, exception, "DataChannel inspector action failed for channel {ChannelId}.", Channel.Id);
            if (!_retired) { Snackbar.Add(L["Workbench:OperationFailedDetail", exception.Message], Severity.Error); }
        }
        finally { if (!_retired) { _busy = false; } }
    }
    public ValueTask DisposeAsync()
    {
        lock (_retirementGate)
        {
            _retired = true;
            return new ValueTask(_disposeTask ??= RetireAsync());
        }
    }
    private async Task RetireAsync()
    {
        _lifetime.Cancel();
        try { if (_pendingAction is { } pending) { await pending; } }
        finally { _lifetime.Dispose(); }
    }
}
