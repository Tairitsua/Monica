@using Monica.UI.Shared.Components.States
@using Monica.Core.Results
@using Monica.Framework.UI.UIProjectUnits.Services
@using Monica.ProjectUnits.Models
@inject IProjectUnitsUiDataSource DataSource
@inject IStringLocalizer<ProjectUnitsResource> L
@implements IAsyncDisposable

<MudDialog Visible="@Visible" VisibleChanged="HandleVisibleChangedAsync" Options="_dialogOptions" OnBackdropClick="CloseAsync">
    <TitleContent>
        <ProjectUnitDialogHeading Text="@L["ProjectUnitDetailDialog:Title"]" />
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MoContentState Loading="true" data-testid="project-unit-detail-loading" role="status"><MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                <p>@L["ProjectUnitDetailDialog:States:Loading"]</p>
            </MoContentState>
        }
        else if (_loadError is not null)
        {
            <MoContentState data-testid="project-unit-detail-error" role="status">@_loadError</MoContentState>
        }
        else if (_detail is not null)
        {
            var summary = _detail.Summary;
            <article class="pu-dossier project-unit-detail" data-testid="project-unit-detail" data-unit-key="@summary.Key">
                <header class="pu-dossier__identity">
                    <div class="pu-dossier__identity-top">
                        <span class="pu-dossier__eyebrow">@L["ProjectUnitDetailDialog:Sections:Identity"]</span>
                        <span class="pu-dossier__type">@L.GetProjectUnitTypeText(summary.UnitType)</span>
                    </div>
                    <h3>@summary.Title</h3>
                    <code>@summary.Key</code>
                    <div class="pu-dossier__metadata" data-declared="@summary.HasExplicitMetadata.ToString().ToLowerInvariant()">
                        <MoIcon Icon="@(summary.HasExplicitMetadata ? MoIcons.Success : MoIcons.Info)" Size="1.25rem" />
                        @(summary.HasExplicitMetadata ? L["ProjectUnitDetailDialog:Badges:MetadataDeclared"] : L["ProjectUnitDetailDialog:Badges:MetadataMissing"])
                    </div>
                    @if (!string.IsNullOrWhiteSpace(summary.Description))
                    {
                        <p>@summary.Description</p>
                    }
                    else
                    {
                        <p class="pu-dossier__absence">@L["ProjectUnitDetailDialog:States:NoDescription"]</p>
                    }
                </header>
                <dl class="pu-dossier__facts">
                    <div><dt>@L["ProjectUnitDetailDialog:Fields:Owner"]</dt><dd>@(summary.Owner ?? L["Shared:Labels:NotDeclared"])</dd></div>
                    <div><dt>@L["ProjectUnitDetailDialog:Fields:Dependencies"]</dt><dd>@summary.Dependencies.Count</dd></div>
                    <div><dt>@L["ProjectUnitDetailDialog:Fields:DependedBy"]</dt><dd>@summary.DependedByCount</dd></div>
                    <div><dt>@L["ProjectUnitDetailDialog:Fields:Methods"]</dt><dd>@summary.MethodCount</dd></div>
                </dl>
                <section class="pu-dossier__section pu-dossier__section--requirements">
                    <header><span class="pu-dossier__section-icon"><MoIcon Icon="@MoIcons.ClipboardList" Size="1.25rem" /></span><div><h4>@L["ProjectUnitDetailDialog:Sections:Requirements"]</h4><p>@L["ProjectUnitDetailDialog:Sections:RequirementsHint"]</p></div><span class="pu-dossier__section-count">@_detail.Requirements.Count</span></header>
                    @if (_detail.Requirements.Count == 0)
                    {
                        <div class="pu-dossier__requirements-empty">
                            <MoContentState Compact="true">
                                <MoIcon Icon="@MoIcons.Link" Size="1.5rem" />
                                <p>@L["ProjectUnitDetailDialog:States:NoRequirements"]</p>
                            </MoContentState>
                        </div>
                    }
                    else
                    {
                        <ul class="pu-dossier__requirements">
                            @foreach (var requirement in _detail.Requirements)
                            {
                                <li data-resolved="@requirement.IsResolved.ToString().ToLowerInvariant()">
                                    <div>
                                        @if (requirement.IsResolved)
                                        {
                                            <a href="@requirement.Href" target="_blank" rel="noopener noreferrer">@requirement.Title <MoIcon Icon="@MoIcons.ExternalLink" Size="1.25rem" /></a>
                                        }
                                        else
                                        {
                                            <span>@requirement.Title</span>
                                        }
                                        <code>@requirement.Id</code>
                                    </div>
                                    <span class="pu-dossier__resolution">@(requirement.IsResolved ? L["ProjectUnitDetailDialog:Badges:Resolved"] : L["ProjectUnitDetailDialog:Badges:Unresolved"])</span>
                                </li>
                            }
                        </ul>
                    }
                </section>
                @if (summary.Tags.Count != 0)
                {
                    <section class="pu-dossier__tags"><h4>@L["ProjectUnitDetailDialog:Sections:Tags"]</h4><ul>@foreach (var tag in summary.Tags) { <li>@tag</li> }</ul></section>
                }
                <section class="pu-dossier__section pu-dossier__section--relationships">
                    <header><span class="pu-dossier__section-icon"><MoIcon Icon="@MoIcons.Network" Size="1.25rem" /></span><div><h4>@L["ProjectUnitDetailDialog:Sections:Relationships"]</h4><p>@L["ProjectUnitDetailDialog:Sections:RelationshipsHint"]</p></div></header>
                    <div class="pu-dossier__relationships">
                        <div><h5>@L["ProjectUnitDetailDialog:Fields:Dependencies"] <span>@summary.Dependencies.Count</span></h5>
                            @if (summary.Dependencies.Count == 0) { <p class="pu-dossier__absence">@L["Shared:Labels:None"]</p> }
                            else
                            {
                                <ul class="pu-dossier__references">
                                    @foreach (var reference in summary.Dependencies)
                                    {
                                        <li><button type="button" @onclick="@(() => InspectRelatedUnitAsync(reference.Key))"><span><strong>@reference.Title</strong><code>@reference.Key</code><small>@L.GetProjectUnitTypeText(reference.UnitType)</small></span><MoIcon Icon="@MoIcons.ArrowRight" Size="1.25rem" /></button></li>
                                    }
                                </ul>
                            }
                        </div>
                        <div><h5>@L["ProjectUnitDetailDialog:Fields:DependedBy"] <span>@_detail.Dependents.Count</span></h5>
                            @if (_detail.Dependents.Count == 0) { <p class="pu-dossier__absence">@L["Shared:Labels:None"]</p> }
                            else
                            {
                                <ul class="pu-dossier__references">
                                    @foreach (var reference in _detail.Dependents)
                                    {
                                        <li><button type="button" @onclick="@(() => InspectRelatedUnitAsync(reference.Key))"><span><strong>@reference.Title</strong><code>@reference.Key</code><small>@L.GetProjectUnitTypeText(reference.UnitType)</small></span><MoIcon Icon="@MoIcons.ArrowRight" Size="1.25rem" /></button></li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </section>
                @if (_detail.Configuration is not null)
                {
                    <section class="pu-dossier__section pu-dossier__configuration">
                        <header><MoIcon Icon="@MoIcons.Settings" Size="1.25rem" /><div><h4>@L["ProjectUnitDetailDialog:Sections:Configuration"]</h4><p>@L["ProjectUnitDetailDialog:Sections:ConfigurationHint"]</p></div></header>
                        <dl><div><dt>@L["ProjectUnitDetailDialog:Fields:DefinitionKey"]</dt><dd><code>@_detail.Configuration.DefinitionKey</code></dd></div><div><dt>@L["ProjectUnitDetailDialog:Fields:ConfigurationMode"]</dt><dd>@L.GetConfigurationModeText(_detail.Configuration.IsOffline)</dd></div></dl>
                        @if (_detail.Configuration.Usages.Count != 0)
                        {
                            <ul class="pu-dossier__references">
                                @foreach (var usage in _detail.Configuration.Usages)
                                {
                                        <li><button type="button" @onclick="@(() => InspectRelatedUnitAsync(usage.Unit.Key))"><span><strong>@usage.Unit.Title</strong><code>@usage.Unit.Key</code><small>@L.GetConfigurationUsageText(usage.UsageType)</small></span><MoIcon Icon="@MoIcons.ArrowRight" Size="1.25rem" /></button></li>
                                }
                            </ul>
                        }
                    </section>
                }
                @if (_detail.ConstructorParameters.Count != 0 || _detail.Methods.Count != 0)
                {
                    <section class="pu-dossier__section">
                        <header><span class="pu-dossier__section-icon"><MoIcon Icon="@MoIcons.Code" Size="1.25rem" /></span><div><h4>@L["ProjectUnitDetailDialog:Sections:TechnicalShape"]</h4><p>@L["ProjectUnitDetailDialog:Sections:TechnicalHint"]</p></div></header>
                        @if (_detail.ConstructorParameters.Count != 0)
                        {
                            <h5>@L["ProjectUnitDetailDialog:Fields:ConstructorParameters"]</h5>
                            <ul class="pu-dossier__parameters">@foreach (var parameter in _detail.ConstructorParameters) { <li><code>@parameter</code></li> }</ul>
                        }
                        @if (_detail.Methods.Count != 0)
                        {
                            <details class="pu-dossier__methods"><summary>@L["ProjectUnitDetailDialog:Sections:PublicMethods", _detail.Methods.Count]</summary>
                                <ul>
                                    @foreach (var method in _detail.Methods)
                                    {
                                        <li><code>@method.Signature</code><div class="pu-dossier__modifiers">
                                            @if (method.IsAsync) { <span>@L.GetMethodModifierText(ProjectUnitsMethodModifier.Async)</span> }
                                            @if (method.IsStatic) { <span>@L.GetMethodModifierText(ProjectUnitsMethodModifier.Static)</span> }
                                            @if (method.IsVirtual) { <span>@L.GetMethodModifierText(ProjectUnitsMethodModifier.Virtual)</span> }
                                            @if (method.IsAbstract) { <span>@L.GetMethodModifierText(ProjectUnitsMethodModifier.Abstract)</span> }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(method.Description)) { <p>@method.Description</p> }
                                        </li>
                                    }
                                </ul>
                            </details>
                        }
                    </section>
                }
                @if (summary.Alerts.Count != 0)
                {
                    <section class="pu-dossier__section"><header><MoIcon Icon="@MoIcons.Info" Size="1.25rem" /><h4>@L["ProjectUnitDetailDialog:Fields:Alerts"]</h4><span class="pu-dossier__section-count">@summary.Alerts.Count</span></header>
                        <ul class="pu-dossier__alerts">
                            @foreach (var alert in summary.Alerts)
                            {
                                <li data-severity="@GetAlertTone(alert.Level)"><strong>@L.GetAlertLevelText(alert.Level)</strong><p>@alert.Message</p>
                                    @if (!string.IsNullOrWhiteSpace(alert.Source)) { <code>@alert.Source</code> }
                                </li>
                            }
                        </ul>
                    </section>
                }
            </article>
        }
    </DialogContent>
    <DialogActions>
        <div class="pu-dossier__actions">
            @if (_detail is not null && OnNodeFocus.HasDelegate)
            {
                <MudButton Class="pu-dossier__focus" Variant="Variant.Text" StartIcon="@MoIcons.Focus" OnClick="FocusCurrentAsync">@L["ProjectUnitDetailDialog:Actions:FocusInGraph"]</MudButton>
            }
            <MudButton @ref="_closeButton" Class="pu-dossier__close" Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseAsync">@L["Shared:Actions:Close"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public ProjectUnitSummary? SelectedUnit { get; set; }
    [Parameter] public EventCallback<string> OnNodeFocus { get; set; }

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = true, CloseOnEscapeKey = true, CloseButton = true };
    private DetailRequest? _loadRequest;
    private MudButton? _closeButton;
    private ProjectUnitDetail? _detail;
    private string? _loadError;
    private string? _selectedSourceKey;
    private bool _loading;
    private bool _wasVisible;
    private bool _closing;
    private bool _disposed;
    private int _loadVersion;

    protected override async Task OnParametersSetAsync()
    {
        if (_disposed) return;
        if (!Visible)
        {
            _wasVisible = false;
            await CancelPendingLoadAsync();
            return;
        }
        var shouldLoad = SelectedUnit is not null && (!_wasVisible || !string.Equals(_selectedSourceKey, SelectedUnit.Key, StringComparison.Ordinal));
        _wasVisible = true;
        if (shouldLoad)
        {
            _selectedSourceKey = SelectedUnit!.Key;
            await LoadDetailAsync(SelectedUnit.Key);
        }
    }

    private async Task InspectRelatedUnitAsync(string key)
    {
        if (_disposed || !Visible || _closing) return;
        // The close action stays mounted inside MudDialog's native focus trap while
        // the clicked reference is replaced. Keep native Escape and focus return intact.
        if (_closeButton is not null) await _closeButton.FocusAsync();
        if (_disposed || !Visible || _closing) return;
        await LoadDetailAsync(key);
    }

    private async Task LoadDetailAsync(string key)
    {
        if (_disposed || !Visible || _closing) return;
        var request = new DetailRequest(++_loadVersion);
        var previous = _loadRequest;
        _loadRequest = request;
        _loading = true;
        _detail = null;
        _loadError = null;
        StateHasChanged();
        try
        {
            if (previous is not null) await previous.CancelAsync();
            if (!IsCurrent(request)) return;
            var result = await DataSource.GetDetailAsync(key, request.Token);
            if (!IsCurrent(request)) return;
            if (result.IsFailed(out var error, out var detail))
            {
                _loadError = L["ProjectUnitDetailDialog:States:LoadFailed", error];
                return;
            }
            _detail = detail;
        }
        catch (OperationCanceledException) when (request.Token.IsCancellationRequested) { }
        catch (Exception exception)
        {
            if (IsCurrent(request)) _loadError = L["ProjectUnitDetailDialog:States:LoadFailed", exception.Message];
        }
        finally
        {
            if (ReferenceEquals(_loadRequest, request))
            {
                _loadRequest = null;
                if (!_disposed)
                {
                    _loading = false;
                    StateHasChanged();
                }
            }
            await request.DisposeAsync();
        }
    }

    private bool IsCurrent(DetailRequest request) => !_disposed && Visible && !_closing && request.Version == _loadVersion
        && ReferenceEquals(_loadRequest, request) && !request.Token.IsCancellationRequested;

    private async Task FocusCurrentAsync()
    {
        if (_disposed || _detail is null || !OnNodeFocus.HasDelegate) return;
        var key = _detail.Summary.Key;
        await CloseAsync();
        if (!_disposed) await OnNodeFocus.InvokeAsync(key);
    }

    private Task HandleVisibleChangedAsync(bool visible) => visible || !Visible ? Task.CompletedTask : CloseAsync();

    private async Task CloseAsync()
    {
        if (_disposed || _closing) return;
        _closing = true;
        Visible = false;
        _wasVisible = false;
        try
        {
            await CancelPendingLoadAsync();
            if (!_disposed) await VisibleChanged.InvokeAsync(false);
        }
        finally { _closing = false; }
    }

    private async Task CancelPendingLoadAsync()
    {
        ++_loadVersion;
        var request = _loadRequest;
        _loadRequest = null;
        _loading = false;
        if (request is not null) await request.CancelAsync();
    }

    private static string GetAlertTone(EAlertLevel level) => level switch { EAlertLevel.Error => "error", EAlertLevel.Warning => "warning", _ => "info" };

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        await CancelPendingLoadAsync();
    }

    // A request owns its source until its producer finishes. Cancellation callers never
    // dispose a source that a newer interleaved load might replace.
    private sealed class DetailRequest : IAsyncDisposable
    {
        private readonly CancellationTokenSource _source = new();
        private readonly object _gate = new();
        private Task? _cancelTask;
        private bool _completed;
        public DetailRequest(int version)
        {
            Version = version;
            Token = _source.Token;
        }

        public int Version { get; }
        public CancellationToken Token { get; }

        public Task CancelAsync()
        {
            lock (_gate)
            {
                if (_completed) return Task.CompletedTask;
                return _cancelTask ??= _source.CancelAsync();
            }
        }

        public async ValueTask DisposeAsync()
        {
            Task? cancellation;
            lock (_gate) { _completed = true; cancellation = _cancelTask; }
            try
            {
                if (cancellation is not null) await cancellation;
            }
            finally { _source.Dispose(); }
        }
    }
}
