@using System.Globalization
@using Monica.JobScheduler.Models.Definitions
@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation

<section class="job-contract-panel" aria-labelledby="job-contract-heading">
    <header class="job-contract-panel__heading">
        <div>
            <MudText Typo="Typo.h6" HtmlTag="h2" id="job-contract-heading">@L["JobDetail:Contract:Title"]</MudText>
            <p>@L["JobDetail:Contract:Description"]</p>
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Sliders" OnClick="OnEdit">@L["Workspace:EditPolicy"]</MudButton>
    </header>
    <div class="job-contract-panel__comparison">
        <div class="job-contract-panel__columns" aria-hidden="true">
            <span>@L["JobDetail:Contract:PolicyTitle"]</span>
            <span>@L["Policy:Provenance:Declared"]</span>
            <span>@L["Policy:Provenance:Override"]</span>
            <span>@L["Policy:Provenance:Effective"]</span>
        </div>
        <dl>
            @foreach (var fact in PolicyFacts)
            {
                <div class="job-contract-panel__row">
                    <dt>
                        @fact.Label
                        @if (fact.Help is { } help)
                        {
                            <MudTooltip Text="@help" Placement="Placement.Top" Arrow="true">
                                <MudIconButton Icon="@MoIcons.Info" Size="Size.Small" aria-label="@help" />
                            </MudTooltip>
                        }
                    </dt>
                    <dd class="job-contract-panel__declared" data-label="@L["Policy:Provenance:Declared"]">@fact.Declared</dd>
                    <dd class="job-contract-panel__override" data-label="@L["Policy:Provenance:Override"]"><span class="@(fact.Override == L["Policy:InheritDefault"].Value ? "job-contract-panel__inherited" : "job-contract-panel__explicit")">@fact.Override</span></dd>
                    <dd class="job-contract-panel__effective" data-label="@L["Policy:Provenance:Effective"]">@fact.Effective</dd>
                </div>
            }
        </dl>
    </div>
    <section class="job-contract-panel__identity" aria-labelledby="job-identity-heading">
        <MudText Typo="Typo.subtitle1" HtmlTag="h3" id="job-identity-heading">@L["JobDetail:Contract:IdentityTitle"]</MudText>
        <dl>
            <div><dt>@L["JobDetail:Contract:SchedulerScope"]</dt><dd><code>@Definition.SchedulerScopeKey</code></dd></div>
            <div><dt>@L["JobDetail:Contract:Owner"]</dt><dd><code>@Definition.OwnerKey</code></dd></div>
            <div><dt>@L["JobDetail:Contract:JobKey"]</dt><dd><code>@Definition.Declaration.JobKey</code></dd></div>
            <div><dt>@L["JobDetail:Contract:ArgumentsKey"]</dt><dd><code>@Display(Definition.Declaration.JobArgsKey)</code></dd></div>
            <div><dt>@L["JobDetail:Contract:Presence"]</dt><dd>@(Definition.IsPresent ? L["JobDetail:Contract:Present"] : L["JobDetail:Contract:Absent"])</dd></div>
            <div><dt>@L["JobDetail:Contract:PolicyStamp"]</dt><dd><code>@Definition.Policy.ConcurrencyStamp</code></dd></div>
            <div><dt>@L["JobDetail:Contract:PolicyUpdated"]</dt><dd>@TimePresentation.FormatTimestamp(Definition.Policy.UpdatedAtUtc)</dd></div>
            <div><dt>@L["JobDetail:Contract:OwnerObserved"]</dt><dd>@TimePresentation.FormatTimestamp(Definition.LastObservedAtUtc)</dd></div>
        </dl>
    </section>
</section>

@code {
    /// <summary>
    /// Gets the exact active definition whose immutable defaults, explicit operator intent and resolved values are rendered.
    /// </summary>
    [Parameter, EditorRequired]
    public JobDefinition Definition { get; set; } = null!;

    /// <summary>
    /// Gets the callback that opens the policy editor for this definition.
    /// </summary>
    [Parameter]
    public EventCallback OnEdit { get; set; }

    private IReadOnlyList<PolicyFact> PolicyFacts
    {
        get
        {
            var declaration = Definition.Declaration;
            var policy = Definition.Policy.Overrides;
            var effective = Definition.EffectiveConfiguration;
            return
            [
                new(L["Policy:Fields:Enabled"], Enabled(!declaration.IsDisabledByDefault), DisabledOverride(policy.DisabledOverride), Enabled(!effective.IsDisabled)),
                new(L["Policy:Fields:DisplayName"], declaration.JobName, Override(policy.DisplayNameOverride), effective.JobName),
                new(L["Policy:Fields:Description"], Display(declaration.Description), policy.DescriptionOverride is null ? L["Policy:InheritDefault"] : policy.DescriptionOverride.Value is null ? L["Policy:Values:Cleared"] : policy.DescriptionOverride.Value, Display(effective.Description)),
                new(L["Policy:Fields:MaxConcurrency"], Number(declaration.MaxConcurrency), Override(policy.MaxConcurrencyOverride), Number(effective.MaxConcurrency), L["JobDetail:Contract:MaxConcurrencyHelp"]),
                new(L["Policy:Fields:RetryCount"], Number(declaration.RetryCount), Override(policy.RetryCountOverride), Number(effective.RetryCount), L["JobDetail:Contract:RetryCountHelp"]),
                new(L["Policy:Fields:ExecutionTimeout"], TimePresentation.FormatDuration(declaration.MaxExecutionTimeout), policy.MaxExecutionTimeoutOverride is { } timeout ? TimePresentation.FormatDuration(timeout) : L["Policy:InheritDefault"], TimePresentation.FormatDuration(effective.MaxExecutionTimeout), L["JobDetail:Contract:ExecutionTimeoutHelp"]),
                new(L["Policy:Fields:MaxRecords"], Number(JobPolicy.DEFAULT_MAX_RETAINED_HISTORY_RECORDS), policy.MaxRetainedHistoryRecords is { } count ? RetainedCount(count) : L["Policy:InheritDefault"], RetainedCount(effective.MaxRetainedHistoryRecords), L["Policy:MaxRecordsHelp"]),
                new(L["Policy:Fields:MaxDays"], L["Policy:Values:NoLimit"], policy.MaxRetentionDays is { } days ? L["Policy:Values:Days", days] : L["Policy:InheritDefault"], effective.MaxRetentionDays is { } age ? L["Policy:Values:Days", age] : L["Policy:Values:NoLimit"], L["Policy:MaxDaysHelp"])
            ];
        }
    }

    private string Enabled(bool enabled) => enabled ? L["Policy:Values:Enabled"] : L["Policy:Values:Disabled"];
    private string DisabledOverride(bool? value) => value switch { true => L["Policy:ForceDisabled"], false => L["Policy:ForceEnabled"], null => L["Policy:InheritDefault"] };
    private string Override(object? value) => value?.ToString() ?? L["Policy:InheritDefault"];
    private string RetainedCount(int value) => value == 0 ? L["Policy:Retention:ZeroUnlimited"] : Number(value);
    private static string Number(int value) => value.ToString(CultureInfo.CurrentCulture);
    private string Display(string? value) => string.IsNullOrWhiteSpace(value) ? L["Common:NotAvailable"] : value;
    private sealed record PolicyFact(string Label, string Declared, string Override, string Effective, string? Help = null);
}
