@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.EventBus.Kafka.UIEventBusKafka.State
@inject IStringLocalizer<EventBusKafkaResource> L

<div class="kafka-overview">
    <section class="overview-context">
        <div class="overview-provider">
            <MoIcon Icon="@MoIcons.Network" Size="2.25rem" />
            <span class="overview-label">@L["Dashboard:Cards:Provider"]</span>
            <h2>@(State.HasLoadedConfiguration ? State.Integration.ActiveProviderName : L["Common:Values:Unavailable"].Value)</h2>
            <span class="overview-mode">@ModeLabel</span>
        </div>
        <div class="overview-cluster">
            <div class="overview-cluster-heading"><span class="overview-label">@L["Dashboard:SelectedCluster:Label"]</span>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@ClusterStatusColor" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@ClusterStatusText</MudChip>
            </div>
            <h2>@(State.SelectedCluster?.Config.DisplayName ?? (string.IsNullOrWhiteSpace(State.RequestedClusterId) ? L["Dashboard:SelectedCluster:None"].Value : State.RequestedClusterId))</h2>
            @if (State.SelectedCluster is { } cluster)
            {
                <dl class="overview-identities">
                    <div><dt>@L["Common:Labels:ClusterId"]</dt><dd>@cluster.Config.ClusterId</dd></div>
                    <div><dt>@L["Clusters:Fields:BootstrapServers"]</dt><dd>@(string.IsNullOrWhiteSpace(cluster.Config.BootstrapServers) ? L["Clusters:Values:ExternalBootstrap"].Value : cluster.Config.BootstrapServers)</dd></div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(cluster.ErrorMessage)) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">@cluster.ErrorMessage</MudAlert> }
            }
            else if (!string.IsNullOrWhiteSpace(State.RequestedClusterId)) { <KafkaDialogContext ClusterId="@State.RequestedClusterId" /><p>@L["Common:Values:Unavailable"]</p> }
            else { <p>@L["Dashboard:SelectedCluster:NoneDescription"]</p> }
        </div>
    </section>

    <section class="overview-inventory" aria-label="@L["Dashboard:Sections:SummaryTitle"]">
        <div><span>@L["Dashboard:Cards:Brokers"]</span><strong>@CountText(State.CurrentBrokerCount, State.SelectedCluster?.IsReachable == true)</strong><small>@L["Dashboard:Cards:BrokersHint"]</small></div>
        <div><span>@L["Dashboard:Cards:Topics"]</span><strong>@CountText(State.CurrentTopicCount, State.HasLoadedTopics || State.SelectedCluster?.HasTopicInventory == true)</strong><small>@L["Dashboard:Cards:TopicsHint"]</small></div>
        <div><span>@L["Dashboard:Cards:ConsumerGroups"]</span><strong>@CountText(State.CurrentConsumerGroupCount, State.HasLoadedConsumerGroups || State.SelectedCluster?.HasConsumerGroupInventory == true)</strong><small>@L["Dashboard:Cards:ConsumerGroupsHint"]</small></div>
        <div><span>@L["Dashboard:Cards:RetainedMessages"]</span><strong>@KafkaMetricDisplayFormatter.FormatOptionalInt64(State.TotalRetainedMessageCount, L["Dashboard:Values:RetainedMessagesUnknown"])</strong><small>@L["Dashboard:Cards:RetainedMessagesHint"]</small></div>
    </section>

    <div class="overview-evidence-grid">
        <section class="overview-capabilities">
            <h3>@L["Dashboard:Sections:EvidenceTitle"]</h3>
            <dl>
                <div><dt>@L["Dashboard:Evidence:AdminAccess"]</dt><dd>@(State.CanAdminSelectedCluster ? L["Dashboard:Evidence:AdminAccessReady"] : L["Dashboard:Evidence:AdminAccessLimited"])</dd></div>
                <div><dt>@L["Dashboard:Evidence:LiveSampling"]</dt><dd>@SamplingStatus</dd></div>
                <div><dt>@L["Dashboard:Evidence:JmxConfiguration"]</dt><dd>@(string.IsNullOrWhiteSpace(State.SelectedCluster?.Config.JmxEndpoint) ? L["Dashboard:Evidence:JmxNotConfigured"] : L["Dashboard:Evidence:JmxConfigured"])</dd></div>
            </dl>
            <div class="overview-rates">
                <div><span>@L["Dashboard:Cards:WriteRate"]</span><strong>@KafkaMetricDisplayFormatter.FormatRate(State.LatestPerformance?.MessageWriteRatePerSecond, L)</strong><small>@L["Dashboard:Cards:WriteRateHint"]</small></div>
                <div><span>@L["Dashboard:Cards:ConsumeRate"]</span><strong>@KafkaMetricDisplayFormatter.FormatRate(State.LatestPerformance?.MessageConsumeRatePerSecond, L)</strong><small>@L["Dashboard:Cards:ConsumeRateHint"]</small></div>
            </div>
        </section>
        <section class="overview-actions">
            <h3>@L["Dashboard:NextActions:Title"]</h3><p>@L["Dashboard:NextActions:Description"]</p>
            <div class="overview-route-actions">
                <MudButton Href="@ClustersUrl" Variant="Variant.Outlined" StartIcon="@MoIcons.Database">@L["Dashboard:NextActions:Clusters"]</MudButton>
                <MudButton Href="@TopicsUrl" Variant="Variant.Outlined" StartIcon="@MoIcons.Folder">@L["Dashboard:NextActions:Topics"]</MudButton>
                <MudButton Href="@ConsumerGroupsUrl" Variant="Variant.Outlined" StartIcon="@MoIcons.Users">@L["Dashboard:NextActions:ConsumerGroups"]</MudButton>
                <KafkaPrimaryButton Href="@PerformanceUrl" StartIcon="@MoIcons.HeartPulse">@L["Dashboard:NextActions:Performance"]</KafkaPrimaryButton>
            </div>
        </section>
    </div>
    @if (State.Integration.Messages.Count > 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@MoIcons.Info">
            @foreach (var message in State.Integration.Messages) { <MudText Typo="Typo.body2">@message</MudText> }
        </MudAlert>
    }
</div>
@code {
    [Parameter, EditorRequired] public EventBusKafkaPageState State { get; set; } = default!;
    /// <summary>Gets or sets the optional owner-supplied disable state; null uses the page state's busy state.</summary>
    [Parameter] public bool? InteractionBusy { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    /// <summary>Gets or sets the native cluster workspace URL, including the exact selected cluster query.</summary>
    [Parameter] public string ClustersUrl { get; set; } = "/eventbus-kafka/workspaces/clusters";
    /// <summary>Gets or sets the native topic workspace URL, including the exact selected cluster query.</summary>
    [Parameter] public string TopicsUrl { get; set; } = "/eventbus-kafka/workspaces/topics";
    /// <summary>Gets or sets the native consumer-group workspace URL, including the exact selected cluster query.</summary>
    [Parameter] public string ConsumerGroupsUrl { get; set; } = "/eventbus-kafka/workspaces/consumer-groups";
    /// <summary>Gets or sets the native performance workspace URL, including the exact selected cluster query.</summary>
    [Parameter] public string PerformanceUrl { get; set; } = "/eventbus-kafka/workspaces/performance";
    private string CountText(int count, bool hasEvidence) => State.CanAdminSelectedCluster && (State.LatestPerformance is not null || hasEvidence) ? count.ToString() : L["Common:Values:Unavailable"];
    private string ModeLabel => !State.HasLoadedConfiguration ? L["Common:Values:Unavailable"] : State.Integration.Mode switch {
        KafkaIntegrationMode.DirectKafka => L["Dashboard:Modes:DirectKafka"], KafkaIntegrationMode.DaprKafka => L["Dashboard:Modes:DaprKafka"],
        KafkaIntegrationMode.DaprNonKafka => L["Dashboard:Modes:DaprNonKafka"], KafkaIntegrationMode.NotConfigured => L["Dashboard:Modes:NotConfigured"], _ => L["Dashboard:Modes:Unknown"] };
    private string ClusterStatusText => State.SelectedCluster switch {
        { IsReachable: true } => L["Clusters:Status:Reachable"],
        { Config.HasDirectKafkaAccess: false } => L["Clusters:Status:Limited"],
        { ErrorMessage: not null } => L["Clusters:Status:ConnectionFailed"],
        { Config.HasDirectKafkaAccess: true } => L["Clusters:Status:Unknown"],
        not null => L["Clusters:Status:Limited"], _ => string.IsNullOrWhiteSpace(State.RequestedClusterId) ? L["Dashboard:SelectedCluster:None"] : L["Common:Values:Unavailable"] };
    private Color ClusterStatusColor => State.SelectedCluster switch {
        { IsReachable: true } => Color.Success, { Config.HasDirectKafkaAccess: false } => Color.Warning, { ErrorMessage: not null } => Color.Error,
        { Config.HasDirectKafkaAccess: true } => Color.Default, not null => Color.Warning, _ => Color.Default };
    private string SamplingStatus => !State.CanAdminSelectedCluster ? L["Performance:Unavailable"] :
        State.IsPerformanceSampling ? L["Performance:Live:Sampling"] :
        State.LastPerformanceCapturedAt is { } capturedAt ? L["Performance:Live:LastCapturedAt", UiTime.Format(capturedAt)] :
        State.IsPerformanceAutoRefreshEnabled ? L["Performance:Live:WaitingForFirstSample"] : L["Performance:Live:Paused"];
}
