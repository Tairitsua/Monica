@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.DevOps.FileOps.Models
@using Monica.DevOps.FileOps.State
@using Monica.DevOps.Localization
@inject IStringLocalizer<FileOpsResource> L
<section class="inventory-owner" aria-label="@L["Inventory:Title"]">
    <div class="inventory-toolbar">
        <div class="inventory-heading">
            <h2>@L["Inventory:Title"]</h2>
            @if (Browse is { } browse) { <span class="inventory-count" aria-label="@L["Location:Shown", browse.Entries.Count]"><strong>@browse.Entries.Count</strong><span>@L["Inventory:Shown"]</span></span> }
        </div>
        <MudMenu Label="@FieldLabel(Controller.SortField)" AriaLabel="@SortLabel" Class="inventory-sort" EndIcon="@(Controller.SortDescending ? MoIcons.ArrowDown : MoIcons.ArrowUp)" Disabled="@Busy">
            @foreach (var field in Enum.GetValues<FileOpsSortField>())
            { <MudMenuItem OnClick="@(() => SortAsync(field))">@FieldLabel(field)</MudMenuItem> }
            <MudDivider />
            <MudMenuItem OnClick="DirectionAsync">@L[Controller.SortDescending ? "Inventory:Ascending" : "Inventory:Descending"]</MudMenuItem>
        </MudMenu>
    </div>
    @if (!TableMode && Entries.Count > 0)
    { <div class="compact-selection"><MudCheckBox T="bool?" Class="select-all" @key="nameof(SelectAllAsync)" Value="@AllSelected" ValueChanged="SelectAllAsync" data-select-all-state="@SelectAllState" Color="Color.Primary" Disabled="@Busy" Label="@L["Batch:SelectAll"]" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" /></div> }
    @if (Selected.Count > 0)
    {
        <div class="selection-band">
            <strong>@L[Controller.Browse?.IsTruncated == true ? "Batch:SelectedShown" : "Batch:SelectedCount", Selected.Count]</strong>
            <div class="toolbar-actions">
                <MudButton Variant="Variant.Text" Disabled="@Busy" OnClick="ClearAsync">@L["Actions:ClearSelection"]</MudButton>
                <MudTooltip Text="@L["Batch:ArchiveRule"]"><MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Archive" Disabled="@(Busy || !CanZip)" OnClick="@(() => DownloadSelection.InvokeAsync())">@L["Actions:DownloadSelected"]</MudButton></MudTooltip>
                <MudTooltip Text="@L["Batch:DeleteRule"]"><MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@MoIcons.ClearList" Disabled="@(Busy || !CanDelete)" OnClick="@(() => DeleteSelection.InvokeAsync())">@L["Actions:DeleteSelected"]</MudButton></MudTooltip>
            </div>
            <p class="batch-hint">@L["Batch:ArchiveRule"]</p>
            @if (!CanZip || !CanDelete) { <p class="batch-hint">@L["Batch:Unavailable"]</p> }
        </div>
    }
    @if (Controller.Browse?.IsTruncated == true)
    { <div class="cap-notice"><MoIcon Size="1.25rem" Icon="@MoIcons.Info" Style="color:var(--mud-palette-info);" /><span>@L["Workspace:TruncatedEntries", Controller.Browse.EntryLimit]</span><MudButton Variant="Variant.Text" Disabled="@Busy" OnClick="@(() => OpenPolicy.InvokeAsync())">@L["Inventory:AdjustLimit"]</MudButton></div> }
    @if (Controller.BrowseStale) { <p class="retained-note">@L["Inventory:Retained"]</p> }
    @if (Controller.Browse is null)
    {
        <div class="empty-state" tabindex="-1"><MoContentState Loading="@Busy">
            @if (Busy) { <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" /><h3>@L["Workspace:Loading"]</h3> }
            else { <MoIcon Icon="@MoIcons.FolderOff" Size="1.5rem" /><h3>@L["Inventory:NoAccepted"]</h3><p>@L["Inventory:RetryHint"]</p> }
        </MoContentState></div>
    }
    else if (Entries.Count == 0)
    { <div class="empty-state" tabindex="-1"><MoContentState><MoIcon Icon="@MoIcons.FolderOpen" Size="1.5rem" /><h3>@L["Workspace:EmptyDirectory"]</h3></MoContentState></div> }
    else
    {
        <div class="inventory-list" tabindex="0" aria-label="@L["Inventory:Entries"]">
            @if (TableMode)
            {
                <MudTable T="FileOpsEntrySummary" Items="@Entries" Elevation="0" Square="true" Hover="true" Breakpoint="Breakpoint.None" RowClassFunc="@RowClass">
                    <ColGroup><col class="check-column" /><col /><col class="type-column" /><col class="size-column" /><col class="modified-column" /><col class="actions-column" /></ColGroup>
                    <HeaderContent>
                        <MudTh Class="check-cell"><MudCheckBox T="bool?" Class="select-all" @key="nameof(SelectAllAsync)" Value="@AllSelected" ValueChanged="SelectAllAsync" data-select-all-state="@SelectAllState" Disabled="@Busy" Color="Color.Primary" aria-label="@L["Batch:SelectAll"]" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" /></MudTh>
                        @foreach (var field in Enum.GetValues<FileOpsSortField>())
                        { <MudTh aria-sort="@SortAria(field)"><MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@Busy" OnClick="@(() => SortAsync(field))" EndIcon="@(Controller.SortField == field ? Controller.SortDescending ? MoIcons.ArrowDown : MoIcons.ArrowUp : null)">@FieldLabel(field)</MudButton></MudTh> }
                        <MudTh Class="actions-cell"><span class="sr-only">@L["Columns:Actions"]</span></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="check-cell"><MudCheckBox T="bool" @key="context.FullPath" Value="@Controller.IsSelected(context)" ValueChanged="@((bool value) => CheckAsync(context, value))" Disabled="@Busy" Color="Color.Primary" aria-label="@L["Inventory:Check", context.Name]" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" /></MudTd>
                        <MudTd Class="name-cell"><div class="entry-identity"><MoIcon Icon="@(context.IsDirectory ? MoIcons.Folder : MoIcons.FileText)" Size="1.25rem" Style="@(context.IsDirectory ? "color:var(--mud-palette-primary);" : "color:var(--mud-palette-text-secondary);")" /><MudButton Class="entry-open" Variant="Variant.Text" aria-disabled="@(Busy ? "true" : "false")" data-entry-path="@context.FullPath" OnClick="@(() => Open.InvokeAsync(context))" title="@context.FullPath">@context.Name</MudButton>@Indicators(context)</div></MudTd>
                        <MudTd><span class="entry-type" title="@TypeText(context)">@TypeText(context)</span></MudTd>
                        <MudTd><span title="@(context.SizeBytes?.ToString() ?? L["Inventory:NotReported"].Value)">@context.SizeDisplay</span></MudTd>
                        <MudTd><time datetime="@context.LastModifiedAt.ToString("O")" title="@DateText(context.LastModifiedAt)">@DateText(context.LastModifiedAt)</time></MudTd>
                        <MudTd Class="actions-cell">@EntryMenu(context)</MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <ul class="compact-entries">
                    @foreach (var entry in Entries)
                    {
                        <li class="@RowClass(entry, 0)" @key="entry.FullPath">
                            <MudCheckBox T="bool" @key="entry.FullPath" Value="@Controller.IsSelected(entry)" ValueChanged="@((bool value) => CheckAsync(entry, value))" Color="Color.Primary" Disabled="@Busy" aria-label="@L["Inventory:Check", entry.Name]" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" />
                            <div class="compact-identity">
                                <div class="entry-identity"><MoIcon Icon="@(entry.IsDirectory ? MoIcons.Folder : MoIcons.FileText)" Size="1.25rem" Style="@(entry.IsDirectory ? "color:var(--mud-palette-primary);" : "color:var(--mud-palette-text-secondary);")" /><MudButton Class="entry-open" Variant="Variant.Text" aria-disabled="@(Busy ? "true" : "false")" data-entry-path="@entry.FullPath" OnClick="@(() => Open.InvokeAsync(entry))" title="@entry.FullPath">@entry.Name</MudButton>@Indicators(entry)</div>
                                <div class="entry-metadata"><span>@TypeText(entry)</span>@if (!entry.IsDirectory && entry.SizeBytes.HasValue) { <span>@entry.SizeDisplay</span> }<time datetime="@entry.LastModifiedAt.ToString("O")">@DateText(entry.LastModifiedAt)</time></div>
                            </div>
                            @EntryMenu(entry)
                        </li>
                    }
                </ul>
            }
        </div>
    }
</section>
@code {
    /// <summary>The borrowed controller; presentation has no independent selection or sort state.</summary>
    [Parameter, EditorRequired] public FileOpsWorkspaceController Controller { get; set; } = null!;
    /// <summary>True only when the actual rendered inventory owner is at least 800 CSS pixels wide.</summary>
    [Parameter] public bool TableMode { get; set; }
    /// <summary>Opens a captured displayed entry without checking it.</summary>
    [Parameter] public EventCallback<FileOpsEntrySummary> Open { get; set; }
    /// <summary>Downloads the captured file on disk.</summary>
    [Parameter] public EventCallback<string> Download { get; set; }
    /// <summary>Confirms deletion of a captured entry.</summary>
    [Parameter] public EventCallback<FileOpsEntrySummary> Delete { get; set; }
    /// <summary>Downloads the captured checked subset as a ZIP.</summary>
    [Parameter] public EventCallback DownloadSelection { get; set; }
    /// <summary>Confirms deletion of the checked subset.</summary>
    [Parameter] public EventCallback DeleteSelection { get; set; }
    /// <summary>Notifies the visit after a synchronous sort/check transition, without authorizing focus.</summary>
    [Parameter] public EventCallback Changed { get; set; }
    /// <summary>Opens this same Files visit's runtime policy dialog.</summary>
    [Parameter] public EventCallback OpenPolicy { get; set; }
    /// <summary>Authorizes guarded focus return after Clear removes its own contextual action band.</summary>
    [Parameter] public EventCallback Cleared { get; set; }
    private IReadOnlyList<FileOpsEntrySummary> _entries = [];
    private IReadOnlyList<FileOpsEntrySummary> Entries => _entries;
    private FileOpsBrowseResult? Browse => Controller.Browse;
    protected override void OnParametersSet()
    {
        // MudTable keys rows by item reference. Retain each path's presentation object so a
        // check-state rerender updates the existing native input instead of replacing focus.
        var previous = Entries.ToDictionary(entry => entry.FullPath, OperatingSystem.IsWindows() ? StringComparer.OrdinalIgnoreCase : StringComparer.Ordinal);
        _entries = Controller.SortedEntries.Select(current =>
        {
            if (!previous.TryGetValue(current.FullPath, out var retained)) return current;
            retained.FullPath = current.FullPath; retained.Name = current.Name; retained.Kind = current.Kind; retained.Extension = current.Extension;
            retained.SizeBytes = current.SizeBytes; retained.LastModifiedAt = current.LastModifiedAt;
            retained.IsHidden = current.IsHidden; retained.IsReadOnly = current.IsReadOnly;
            retained.CanDownload = current.CanDownload; retained.CanEditText = current.CanEditText;
            retained.CanDelete = current.CanDelete; retained.CanWriteInto = current.CanWriteInto;
            return retained;
        }).ToArray();
    }
    private List<FileOpsEntrySummary> Selected => Entries.Where(Controller.IsSelected).ToList();
    private bool Busy => Controller.IsBusy;
    private bool CanZip => Selected.Count > 0 && Selected.All(entry => entry.IsDirectory || entry.CanDownload);
    private bool CanDelete => Selected.Count > 0 && Selected.All(entry => entry.CanDelete);
    private bool? AllSelected => Selected.Count == 0 ? false : Selected.Count == Entries.Count ? true : null;
    private string SelectAllState => AllSelected switch { true => "true", false => "false", null => "mixed" };
    private string SortLabel => L["Inventory:Sort", FieldLabel(Controller.SortField), L[Controller.SortDescending ? "Inventory:Descending" : "Inventory:Ascending"]];
    private string FieldLabel(FileOpsSortField field) => L[field switch { FileOpsSortField.Name => "Columns:Name", FileOpsSortField.Type => "Columns:Type", FileOpsSortField.Size => "Columns:Size", _ => "Columns:Modified" }];
    private string SortAria(FileOpsSortField field) => Controller.SortField != field ? "none" : Controller.SortDescending ? "descending" : "ascending";
    private string TypeText(FileOpsEntrySummary entry) => entry.IsDirectory ? L["Labels:Directory"] : string.IsNullOrWhiteSpace(entry.Extension) ? L["Labels:File"] : entry.Extension;
    private string DateText(DateTimeOffset value) => UiTime.Format(value);
    private string RowClass(FileOpsEntrySummary entry, int index) => Same(entry.FullPath, Controller.InspectedEntry?.FullPath) ? "entry-row entry-selected" : "entry-row";
    private static bool Same(string? left, string? right) => string.Equals(left, right, OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal);
    private async Task CheckAsync(FileOpsEntrySummary entry, bool value) { if (Busy) return; Controller.ToggleEntrySelection(entry, value); await Changed.InvokeAsync(); }
    private async Task SelectAllAsync(bool? value) { if (Busy) return; Controller.SelectAll(value == true); await Changed.InvokeAsync(); }
    private async Task ClearAsync() { if (Busy) return; Controller.ClearSelection(); await Cleared.InvokeAsync(); }
    private async Task SortAsync(FileOpsSortField field) { if (Busy) return; Controller.SetSort(field, Controller.SortField == field && !Controller.SortDescending); await Changed.InvokeAsync(); }
    private async Task DirectionAsync() { if (Busy) return; Controller.SetSort(Controller.SortField, !Controller.SortDescending); await Changed.InvokeAsync(); }
    private RenderFragment Indicators(FileOpsEntrySummary entry) => @<span class="entry-indicators">@if (entry.IsReadOnly) { <MudTooltip Text="@L["Location:ReadOnly"]"><MoIcon Size="1.25rem" Icon="@MoIcons.Lock" /></MudTooltip> }@if (entry.IsHidden) { <MudTooltip Text="@L["Inventory:Hidden"]"><MoIcon Size="1.25rem" Icon="@MoIcons.EyeOff" /></MudTooltip> }</span>;
    private RenderFragment EntryMenu(FileOpsEntrySummary entry) => @<MudMenu Icon="@MoIcons.MoreVertical" AriaLabel="@L["Inventory:Actions", entry.Name]" Disabled="@Busy">
        @if (!entry.IsDirectory && entry.CanDownload) { <MudMenuItem Icon="@MoIcons.Download" OnClick="@(() => Download.InvokeAsync(entry.FullPath))">@L["Actions:Download"]</MudMenuItem> }
        @if (entry.CanDelete) { <MudMenuItem Icon="@MoIcons.Delete" OnClick="@(() => Delete.InvokeAsync(entry))">@L["Actions:Delete"]</MudMenuItem> }
        @if (!entry.CanDelete && (entry.IsDirectory || !entry.CanDownload)) { <MudMenuItem Disabled="true">@L["Inventory:NoActions"]</MudMenuItem> }
    </MudMenu>;
}
