@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using System.Windows.Input
@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.UI.UIChat.Support
@using Monica.UI.Shared.Components.Markdown
@using Monica.AI.UI.Shared.Support
@implements IAsyncDisposable
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IStringLocalizer<AIResource> L

<article class="message-wrapper @(IsUser ? "user-message" : "assistant-message")">
    @if (_isEditing)
    {
        <div class="edit-area">
            <MudTextField T="string" @bind-Value="_editContent" Variant="Variant.Outlined" Lines="3" Sizing="InputSizing.Auto" MaxLines="12" />
            <div class="edit-actions"><MudButton OnClick="HandleCancelEdit">@L["Common:Actions:Cancel"]</MudButton><MudButton Color="Color.Primary" OnClick="HandleSaveEdit">@L["Workbench:EditAndResend"]</MudButton></div>
        </div>
    }
    else
    {
        <div class="message-content">
            @if (!IsUser)
            {
                <ChatExecutionProcess Steps="@Steps" Running="@Running" FinalAnswerStepId="@FinalAnswerStepId" EnableMarkdown="@EnableMarkdown" OnInspect="@OnInspect" />
            }
            @if (IsUser)
            {
                <div class="user-text"><AgentCapabilityReferenceText Text="@DisplayContent" /></div>
            }
            else if (!string.IsNullOrEmpty(DisplayContent))
            {
                @if (EnableMarkdown) { <MoMarkdown Value="@DisplayContent" EnableMermaid="true" Props="@_assistantMarkdownProps" /> }
                else { <div class="plain-text">@DisplayContent</div> }
            }
            @if (Message.Parts.Any(part => part.Attachment is not null))
            {
                <ChatAttachments Attachments="@Message.Parts.Where(part => part.Attachment is not null).Select(part => part.Attachment!).ToArray()" SessionId="@SessionId" />
            }
            @if (Running && string.IsNullOrEmpty(DisplayContent) && Steps.Count == 0)
            {
                <span class="waiting-label"><MudProgressCircular Size="Size.Small" Indeterminate="true" />@L["Workbench:Waiting"]</span>
            }
            <footer class="message-footer">
                <time datetime="@Message.CreatedAt.ToString("O")">@UiTime.FormatTime(Message.CreatedAt)</time>
                @if (Status is ChatExecutionStatus.Cancelled or ChatExecutionStatus.Interrupted or ChatExecutionStatus.AwaitingApproval)
                {
                    <MudText Typo="Typo.caption" Color="@ChatExecutionPresentation.StatusColor(Status.Value)">@ChatExecutionPresentation.Status(Status.Value, L)</MudText>
                }
                @if (!IsUser && Steps.Count > 0) { <ChatExecutionMetrics Steps="@Steps" /> }
                <div class="message-actions">
                    <MudIconButton Icon="@MoIcons.Copy" Size="Size.Small" OnClick="HandleCopy" aria-disabled="@(_copying ? "true" : "false")" aria-label="@L["Chat:Actions:Copy"]" />
                    @if (IsUser) { <MudIconButton Icon="@MoIcons.Edit" Size="Size.Small" Disabled="@Disabled" OnClick="HandleStartEdit" aria-label="@L["Chat:Actions:Edit"]" /> }
                    else { <MudIconButton Icon="@MoIcons.Refresh" Size="Size.Small" Disabled="@Disabled" OnClick="HandleRetry" aria-label="@L["Chat:Actions:Retry"]" /> }
                </div>
            </footer>
        </div>
    }
</article>

@code {
    [Parameter] public required AIChatMessage Message { get; set; }
    [Parameter] public bool EnableMarkdown { get; set; } = true;
    [Parameter] public IReadOnlyList<ChatExecutionStep> Steps { get; set; } = [];
    [Parameter] public bool Running { get; set; }
    [Parameter] public ChatExecutionStatus? Status { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public EventCallback<ChatExecutionStep> OnInspect { get; set; }
    private ChatExecutionStep? FinalRequest => Steps.LastOrDefault(step => step.Request is { Output.Count: > 0 });
    private string? FinalAnswerStepId => FinalRequest?.Request?.Output.Any(part => part.Kind == ChatContentKind.ToolCall) == false ? FinalRequest.Id : null;
    private string DisplayContent => IsUser || Steps.Count == 0 ? Message.Content
        : FinalAnswerStepId is not null ? string.Concat(FinalRequest!.Request!.Output.Where(part => part.Kind == ChatContentKind.Text).Select(part => part.Text)) : string.Empty;
    [Parameter] public EventCallback<(AIChatMessage Message, string NewContent)> OnEdit { get; set; }
    [Parameter] public EventCallback<AIChatMessage> OnRetry { get; set; }

    private bool IsUser => Message.Role == AIChatRole.User;
    private bool _isEditing;
    private string _editContent = string.Empty;

    private readonly MudMarkdownProps _assistantMarkdownProps = new();
    private ICommand? _assistantMarkdownLinkCommand;
    private readonly AIAdministrationOperationLifetime _operations = new();
    private AIAdministrationDialogSession _dialogs = null!;
    private string? _originSessionId;
    private string? _originMessageId;
    private int _generation;
    private bool _copying;
    private bool _openingLink;
    private Task? _retirement;

    protected override void OnInitialized()
    {
        _dialogs = CreateDialogOwner();
        _assistantMarkdownLinkCommand = new AsyncCommand(HandleMarkdownLinkClickAsync, () => !_operations.IsRetired && !_openingLink);
        _assistantMarkdownProps.Link.Command = _assistantMarkdownLinkCommand;
    }

    private AIAdministrationDialogSession CreateDialogOwner() => new(DialogService, action => InvokeAsync(action));

    protected override Task OnParametersSetAsync()
    {
        if (_originSessionId == SessionId && _originMessageId == Message.Id) return Task.CompletedTask;
        var firstIdentity = _originMessageId is null;
        _originSessionId = SessionId;
        _originMessageId = Message.Id;
        _generation++;
        _isEditing = false;
        _editContent = string.Empty;
        if (firstIdentity || _operations.IsRetired) return Task.CompletedTask;
        var previous = _dialogs;
        _dialogs = CreateDialogOwner();
        return _operations.RunAsync(_ => previous.DisposeAsync().AsTask());
    }

    private bool CanPublish(int generation) => !_operations.IsRetired && generation == _generation;
    private Task PublishAsync(int generation, Action action) => CanPublish(generation)
        ? InvokeAsync(() => { if (CanPublish(generation)) action(); }) : Task.CompletedTask;

    private async Task HandleCopy()
    {
        if (_operations.IsRetired || _copying) return;
        _copying = true;
        var content = DisplayContent;
        var generation = _generation;
        try
        {
            await _operations.RunAsync(async token =>
            {
                try
                {
                    token.ThrowIfCancellationRequested();
                    // The browser clipboard producer has no cancellation contract. Drain its real result.
                    var success = await JSRuntime.InvokeAsync<bool>("MoClipboard.copyText", content);
                    await PublishAsync(generation, () => Snackbar.Add(success ? L["Chat:Clipboard:Copied"] : L["Chat:Clipboard:CopyFailed"],
                        success ? Severity.Success : Severity.Error));
                }
                catch (OperationCanceledException) when (token.IsCancellationRequested) { }
                catch (Exception) { await PublishAsync(generation, () => Snackbar.Add(L["Chat:Clipboard:CopyFailed"], Severity.Error)); }
                finally
                {
                    _copying = false;
                    await PublishAsync(_generation, StateHasChanged);
                }
            });
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
    }

    private void HandleStartEdit()
    {
        if (_operations.IsRetired || Disabled) return;
        _editContent = Message.Content;
        _isEditing = true;
    }

    private void HandleCancelEdit()
    {
        _isEditing = false;
        _editContent = string.Empty;
    }

    private async Task HandleSaveEdit()
    {
        if (_operations.IsRetired || Disabled) return;
        if (string.IsNullOrWhiteSpace(_editContent))
        {
            Snackbar.Add(L["Chat:Validation:MessageRequired"], Severity.Warning);
            return;
        }

        var generation = _generation;
        var message = Message;
        var content = _editContent;
        _isEditing = false;
        // The parent owns generation; its callback can remove this message while awaiting the stream.
        await OnEdit.InvokeAsync((message, content));
        if (CanPublish(generation)) _editContent = string.Empty;
    }

    private async Task HandleRetry()
    {
        if (_operations.IsRetired || Disabled) return;
        await OnRetry.InvokeAsync(Message);
    }

    private async Task HandleMarkdownLinkClickAsync(object? parameter)
    {
        if (_operations.IsRetired || _openingLink || parameter is not string targetUrl || string.IsNullOrWhiteSpace(targetUrl)) return;
        _openingLink = true;
        var generation = _generation;
        var dialogs = _dialogs;
        try
        {
            await _operations.RunAsync(async token =>
            {
                try
                {
                    token.ThrowIfCancellationRequested();
                    if (IsExternalUrl(targetUrl))
                    {
                        await JSRuntime.InvokeVoidAsync("open", targetUrl, "_blank");
                        return;
                    }
                    if (TryResolveMarkdownSourcePath(targetUrl, out var sourcePath))
                    {
                        await dialogs.ShowAsync<ChatSourcePreviewDialog>(L["Chat:SourcePreview:Title"],
                            new() { [nameof(ChatSourcePreviewDialog.SourcePath)] = sourcePath },
                            new() { CloseButton = true, CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Large });
                        return;
                    }
                    if (CanPublish(generation)) NavigationManager.NavigateTo(targetUrl);
                }
                catch (OperationCanceledException) when (token.IsCancellationRequested) { }
                catch (Exception exception)
                {
                    await PublishAsync(generation, () => Snackbar.Add($"{L["Chat:SourcePreview:OpenFailed"]}: {exception.Message}", Severity.Error));
                }
                finally { _openingLink = false; }
            });
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
    }

    private static bool TryResolveMarkdownSourcePath(string rawUrl, out string sourcePath)
    {
        sourcePath = string.Empty;
        if (string.IsNullOrWhiteSpace(rawUrl))
        {
            return false;
        }

        var trimmedUrl = rawUrl.Trim();
        if (trimmedUrl.StartsWith('#') || trimmedUrl.StartsWith("//", StringComparison.Ordinal))
        {
            return false;
        }

        // HTTP(S) has already been routed externally. Only local catalog paths reach preview.
        if (!trimmedUrl.StartsWith('/') && Uri.TryCreate(trimmedUrl, UriKind.Absolute, out _)) return false;

        var withoutFragment = trimmedUrl.Split(['#', '?'], 2)[0];
        if (!withoutFragment.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        sourcePath = NormalizeSourcePath(withoutFragment);
        return !string.IsNullOrWhiteSpace(sourcePath);
    }

    private static bool IsExternalUrl(string targetUrl)
        => Uri.TryCreate(targetUrl, UriKind.Absolute, out var absoluteUri)
           && (string.Equals(absoluteUri.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
               || string.Equals(absoluteUri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase));

    private static string NormalizeSourcePath(string value)
        => Uri.UnescapeDataString(value.Replace('\\', '/')).Trim().TrimStart('/');

    public ValueTask DisposeAsync() => new(_retirement ??= RetireAsync());
    private async Task RetireAsync() => await Task.WhenAll(_operations.RetireAsync().AsTask(), _dialogs.DisposeAsync().AsTask());

    private sealed class AsyncCommand(Func<object?, Task> executeAsync, Func<bool> canExecute) : ICommand
    {
        public event EventHandler? CanExecuteChanged
        {
            add { }
            remove { }
        }

        public bool CanExecute(object? parameter) => canExecute();

        public async void Execute(object? parameter)
        {
            if (!CanExecute(parameter)) return;
            try
            {
                await executeAsync(parameter);
            }
            catch
            {
            }
        }
    }
}
