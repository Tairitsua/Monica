@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation
@using Monica.UI.Shared.Components.Visual
<section class="rt-signature" aria-labelledby="rt-readiness">
    <div class="rt-decision" data-role="@(!Autonomous ? "neutral" : Ready ? "success" : "warning")">
        <div><p class="display-label">@L["Workspace:ServingHost"]</p><h2 id="rt-readiness" class="rt-statement">@L[!Autonomous ? "Runtime:Identity:ManualMode" : Ready ? "Workspace:LocallyReady" : "Runtime:Finding:Attention"]</h2><p class="rt-host-key">@Overview.Configuration.OwnerKey</p></div>
        <div class="rt-finding"><p class="lede"><SchedulerRichFinding Template="@L[Autonomous ? "Runtime:Finding:Automatic" : "Runtime:Finding:Manual"]" Values="@FindingValues" /></p>
            <p class="rt-finding-note"><MoIcon Icon="@MoIcons.Info" Size="14px" /><span>@L[Autonomous ? "Runtime:Plane:LocalOnly" : "Runtime:Finding:ManualNote"]</span></p></div>
    </div>
    <SchedulerRuntimeResponsibilities Overview="@Overview" />
    <div class="rt-path" aria-label="@L["Workspace:RuntimePath"]">
        <div class="rt-stage" data-role="@(!Autonomous ? "neutral" : Overview.LocalPlane.SchedulingReady ? "success" : "warning")"><div class="rt-stage-title"><span class="tile"><MoIcon Icon="@MoIcons.CalendarCheck" Size="18px"/></span><h3>@L["Runtime:Plane:Scheduling"]</h3></div><p>@L[Autonomous ? "Workspace:MaterializeDescription" : "Runtime:Coordination:ManualAdmission"]</p><span class="status" data-role="@(!Autonomous ? "neutral" : Overview.LocalPlane.SchedulingReady ? "success" : "warning")"><i></i>@L[!Autonomous ? "Runtime:Coordination:Manual" : Overview.LocalPlane.SchedulingReady ? "Runtime:Plane:Ready" : "Runtime:Plane:NotReady"]</span><div class="rt-stage-fact"><span>@L["Workspace:Poll"]</span><b>@SchedulerRuntimePresentation.FormatInterval(Overview.Configuration.SchedulingPollInterval,L)</b></div></div>
        <span class="rt-connector" aria-hidden="true"><MoIcon Icon="@MoIcons.ArrowRight" Size="19px"/></span>
        <div class="rt-stage" data-role="neutral"><div class="rt-stage-title"><span class="tile"><MoIcon Icon="@MoIcons.Database" Size="18px"/></span><h3>@L[Autonomous ? "Runtime:Store:Title" : "Runtime:Coordination:ManualStore"]</h3></div><p>@L[Autonomous ? "Workspace:DurableDescription" : "Runtime:Coordination:ManualQueue"]</p><span class="rt-store-name">@(Overview.Store.Provider ?? Overview.Store.Kind.ToString())</span><a class="rt-stage-link" href="/job-scheduler/executions?states=Queued&range=all">@L["Workspace:ViewQueue"] <MoIcon Icon="@MoIcons.ArrowRight" Size="13px"/></a></div>
        <span class="rt-connector" aria-hidden="true"><MoIcon Icon="@MoIcons.ArrowRight" Size="19px"/></span>
        <div class="rt-stage" data-role="@(Overview.LocalPlane.WorkerReady ? "info" : "warning")"><div class="rt-stage-title"><span class="tile"><MoIcon Icon="@MoIcons.Server" Size="18px"/></span><h3>@L["Runtime:Plane:Worker"]</h3></div><p>@L["Workspace:ClaimDescription"]</p><span class="status" data-role="@(Overview.LocalPlane.WorkerReady ? "success" : "warning")"><i></i>@L[Overview.LocalPlane.WorkerReady ? "Runtime:Plane:Ready" : "Runtime:Plane:NotReady"]</span><div class="rt-stage-fact"><span>@L["Workspace:Poll"]</span><b>@SchedulerRuntimePresentation.FormatInterval(Overview.Configuration.WorkerPollInterval,L)</b></div></div>
        <div class="rt-capacity"><span>@L["Runtime:Plane:InFlight"]</span><strong>@Overview.LocalPlane.InFlightExecutions<small> / @Overview.Configuration.MaxWorkerExecutionThreads</small></strong><div class="rt-slots" aria-label="@L["Workspace:Slots",Overview.LocalPlane.InFlightExecutions,Overview.Configuration.MaxWorkerExecutionThreads]">@for(var i=0;i<Math.Min(32,Overview.Configuration.MaxWorkerExecutionThreads);i++) { <span class="@(i<Overview.LocalPlane.InFlightExecutions ? "is-busy" : null)" data-role="info"></span> }@if(Overview.Configuration.MaxWorkerExecutionThreads>32) { <small>+@(Overview.Configuration.MaxWorkerExecutionThreads-32)</small> }</div></div>
    </div>
    <details class="rt-host-details"><summary><MoIcon Icon="@MoIcons.ChevronRight" Size="14px"/>@L["Runtime:Identity:Title"]<span>@Overview.Configuration.WorkerInstanceId</span></summary><div class="rt-identity"><dl>
        <div><dt>@L["Runtime:Coordination:FallbackOwner"]</dt><dd>@Overview.Configuration.OwnerKey</dd></div><div><dt>@L["Runtime:Coordination:OwnerKeys"]</dt><dd>@string.Join(", ",Overview.Configuration.OwnerKeys)</dd></div><div><dt>@L["Runtime:Identity:Scope"]</dt><dd>@Overview.Configuration.SchedulerScopeKey</dd></div><div><dt>@L["Runtime:Identity:WorkerInstanceId"]</dt><dd>@Overview.Configuration.WorkerInstanceId <SchedulerCopyButton Value="@Overview.Configuration.WorkerInstanceId"/></dd></div><div><dt>@L["Runtime:Store:Provider"]</dt><dd>@(Overview.Store.Provider ?? L["Runtime:Store:NoProvider"])</dd></div><div><dt>@L["Runtime:Identity:CronTimeZone"]</dt><dd>@Overview.Configuration.CronTimeZoneId</dd></div><div><dt>@L["Runtime:Plane:Scheduling"]</dt><dd>@(Overview.LocalPlane.SchedulingMessage ?? L["Runtime:Plane:NoMessage"])</dd></div><div><dt>@L["Runtime:Plane:Worker"]</dt><dd>@(Overview.LocalPlane.WorkerMessage ?? L["Runtime:Plane:NoMessage"])</dd></div>
    </dl><p>@L["Runtime:Coordination:NotOwnerProcess"]</p>@if(!Overview.Configuration.AutonomousWork) { <MudAlert Severity="Severity.Info" Dense="true">@L["Runtime:Identity:ManualModeHelp"]</MudAlert> }</div></details>
    @if(!Ready) { <div class="rt-diagnostic"><MudAlert Severity="Severity.Warning" Dense="true">@(Overview.LocalPlane.WorkerMessage ?? Overview.LocalPlane.SchedulingMessage ?? L["Runtime:Plane:NoMessage"])</MudAlert></div> }
</section>
@code {
    /// <summary>Gets accepted serving-host evidence; no readiness is inferred for other replicas.</summary>
    [Parameter,EditorRequired] public JobSchedulerRuntimeOverview Overview { get; set; } = null!;
    private bool Ready => Overview.LocalPlane.SchedulingReady && Overview.LocalPlane.WorkerReady;
    private bool Autonomous => Overview.Configuration.AutonomousWork;
    private int LocalJobs => Overview.Owners.Where(owner => Overview.Configuration.OwnerKeys.Contains(owner.OwnerKey,StringComparer.Ordinal)).Sum(owner => owner.PresentCount);
    private RenderFragment ReadyMark(bool ready) => @<MoValueMark Role="@(ready ? MoVisualRole.Success : MoVisualRole.Warning)">@L[ready ? "Runtime:Finding:Ready" : "Runtime:Finding:NotReady"]</MoValueMark>;
    private IReadOnlyList<RenderFragment> FindingValues =>
    [
        Autonomous ? ReadyMark(Overview.LocalPlane.SchedulingReady) : @<MoValueMark Role="MoVisualRole.Neutral">@L["Runtime:Coordination:ManualStore"]</MoValueMark>,
        ReadyMark(Overview.LocalPlane.WorkerReady),
        @<MoValueMark Role="MoVisualRole.Neutral">@LocalJobs</MoValueMark>
    ];
}
