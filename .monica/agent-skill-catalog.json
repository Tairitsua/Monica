        "rules": [
          {
            "id": "monica-guide-routing",
            "text": "Use $monica-guide for Monica toolbox help, setup, configuration, source lookup, updates, and diagnostics.",
            "labels": {
              "en-US": {
                "title": "Toolbox guidance",
                "description": "Use Guide for setup, skills and diagnostics."
              },
              "zh-CN": {
                "title": "工具箱指引",
                "description": "通过 Guide 处理安装、技能与诊断。"
              }
            }
          },
          {
            "id": "monica-troubleshooting-routing",
            "text": "For runtime failures, missing routes, inactive UI, or failed infrastructure operations, use $monica-troubleshooting and the selected owning infra reference. Guide doctor diagnoses toolbox and installation state.",
            "labels": {
              "en-US": {
                "title": "Runtime troubleshooting",
                "description": "Load the troubleshooting skill when a runtime capability fails."
              },
              "zh-CN": {
                "title": "运行问题排查",
                "description": "运行功能异常时，先加载排查技能。"
              }
            }
          },
          {
            "id": "resolve-pinned-source",
            "text": "Before guessing, cloning, or using a moving branch when Monica source is needed, run $monica-guide source resolve for that repository; a returned binding is a lookup path, not write permission.",
            "labels": {
              "en-US": {
                "title": "Source lookup guidance",
                "description": "Resolve verified Monica source and include bound locations as read-only references."
              },
              "zh-CN": {
                "title": "源码定位指引",
                "description": "解析 Monica 源码，并将绑定位置作为只读参考写入指令。"
              }
            },
            "context": "source-bindings"
          },
