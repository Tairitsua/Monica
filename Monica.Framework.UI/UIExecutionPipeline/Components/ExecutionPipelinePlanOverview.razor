@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.Core.Execution.Models
@inject IStringLocalizer<ExecutionPipelineResource> L

<section class="execution-pipeline-overview" data-testid="execution-pipeline-plan-overview">
    <header>
        <h3><ExecutionPipelineHelpLabel Text="@L["Page:Plans:OverviewTitle"]"
                                        HelpText="@L["Page:Help:Plans:OperationName"]" /></h3>
        <p>@L["Page:Plans:OverviewDescription"]</p>
    </header>

    <div class="execution-pipeline-overview__groups">
        <section class="execution-pipeline-overview__group execution-pipeline-overview__group--policy">
            <h4>@L["Page:Plans:EvidenceBoundary"]</h4>
            <dl>
                @Metadata(L["Page:Filters:ExecutionPoint"], L["Page:Help:Concepts:ExecutionPoint"], Plan.Descriptor.Point.Value)
                @Metadata(L["Page:Plans:Business"], L["Page:Help:Concepts:BusinessOperation"],
                    Plan.Descriptor.IsBusinessOperation ? L["Page:Common:Yes"] : L["Page:Common:No"], technical: false)
                @Metadata(L["Page:Plans:Transaction"], L["Page:Help:Concepts:TransactionMode"],
                    L[$"Page:TransactionModes:{Plan.Descriptor.TransactionMode}"], technical: false)
            </dl>
        </section>
        <section class="execution-pipeline-overview__group">
            <h4>@L["Page:Plans:EvidenceCallable"]</h4>
            <dl>
                @Metadata(L["Page:Plans:Component"], L["Page:Help:Plans:Component"], Plan.Descriptor.ComponentType.FullName)
                @Metadata(L["Page:Plans:Contract"], L["Page:Help:Plans:Contract"],
                    Plan.Descriptor.ContractType?.FullName ?? L["Page:States:NotAvailable"])
                @Metadata(L["Page:Plans:Method"], L["Page:Help:Plans:Method"],
                    Plan.Descriptor.EntryMethod?.DisplaySignature ?? L["Page:States:NotAvailable"])
                @Metadata(L["Page:Plans:Input"], L["Page:Help:Plans:Input"], Plan.Descriptor.InputType.FullName)
                @Metadata(L["Page:Plans:Result"], L["Page:Help:Plans:Result"], Plan.Descriptor.ResultType.FullName)
            </dl>
        </section>
        <section class="execution-pipeline-overview__group execution-pipeline-overview__group--timing">
            <div class="execution-pipeline-overview__group-heading">
                <h4>@L["Page:Plans:EvidenceMaterialization"]</h4>
                <span>@L["Page:Header:LocalTime"]</span>
            </div>
            <dl>
                @Timestamp(L["Page:Plans:StartedAt"], L["Page:Help:Plans:StartedAt"], Plan.StartedAt)
                @Timestamp(L["Page:Plans:CompletedAt"], L["Page:Help:Plans:CompletedAt"], Plan.CompletedAt)
            </dl>
        </section>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public ExecutionPipelinePlanSnapshot Plan { get; set; } = null!;

    private RenderFragment Metadata(string label, string helpText, string value, bool technical = true) =>
        @<div class="execution-pipeline-overview__item">
            <dt><ExecutionPipelineHelpLabel Text="@label" HelpText="@helpText" /></dt>
            <dd class="@(technical ? "execution-pipeline-overview__technical" : null)" title="@value">@value</dd>
        </div>;

    private RenderFragment Timestamp(string label, string helpText, DateTimeOffset? value) =>
        @<div class="execution-pipeline-overview__item">
            <dt><ExecutionPipelineHelpLabel Text="@label" HelpText="@helpText" /></dt>
            <dd class="execution-pipeline-overview__technical">
                @if (value is { } timestamp)
                {
                    <time datetime="@timestamp.ToString("O")">@FormatTime(timestamp)</time>
                }
                else
                {
                    @L["Page:States:NotAvailable"]
                }
            </dd>
        </div>;

    private string FormatTime(DateTimeOffset value) =>
        UiTime.Format(value);
}
