@using Monica.Core.Localization.Abstractions
@using Monica.UI.Shell.Models
@inject ILocalizationCatalog LocalizationCatalog

<div class="@(ShowPageIcons ? "mo-navigation-tree" : "mo-navigation-tree is-quiet")">
    @foreach (var item in Group.Items)
    {
        var isCurrent = item == ActiveItem;
        <MudNavLink Href="@item.Href" Match="NavLinkMatch.All" ActiveClass="mo-navigation-link-matched"
                    Ripple="false" Class="@(isCurrent ? "mo-navigation-item is-current" : "mo-navigation-item")"
                    aria-current="@(isCurrent ? "page" : null)">
            <span class="mo-navigation-tree__destination">
                @if (ShowPageIcons && !string.IsNullOrEmpty(item.Icon))
                {
                    <MoIcon Icon="@item.Icon" Size="18px" />
                }
                else
                {
                    <span class="mo-navigation-tree__dot" aria-hidden="true"></span>
                }
                <span class="mo-navigation-tree__label">@item.ResolveText(LocalizationCatalog)</span>
                @if (isCurrent)
                {
                    <span class="mo-navigation-tree__current" aria-hidden="true"></span>
                }
            </span>
        </MudNavLink>
    }
    @foreach (var child in Group.Children)
    {
        <MoNavigationGroup @key="child.Id" Group="@child" ActiveItem="@ActiveItem" ShowPageIcons="@ShowPageIcons" />
    }
</div>

@code {
    /// <summary>The authorized branch whose direct items and nested children are rendered.</summary>
    [Parameter, EditorRequired] public NavigationGroup Group { get; set; } = default!;
    /// <summary>The single longest matching destination in the complete navigation tree.</summary>
    [Parameter] public NavigationItem? ActiveItem { get; set; }

    /// <summary>Gets or sets whether leaf destinations show their registered icons. Defaults to true; false uses quiet dots.</summary>
    [Parameter] public bool ShowPageIcons { get; set; } = true;
}
