<Project>
  <PropertyGroup>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1591;CS9107</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <!-- Package Metadata -->
    <Version>1.0.0-rc.15</Version>
    <Authors>MonicaFramework</Authors>
    <Company>MonicaFramework</Company>
    <Product>Monica Framework</Product>
    <Copyright>Copyright © Tairitsua 2025-$([System.DateTime]::Now.Year)</Copyright>

    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Repository Information -->
    <RepositoryUrl>https://github.com/Tairitsua/Monica.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Tairitsua/Monica</PackageProjectUrl>

    <!-- Package Icon -->
    <PackageIcon>logo.png</PackageIcon>

    <!-- Package README -->
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>

    <!-- Package Tags -->
    <PackageTags>monica;dotnet;aspnetcore;blazor;mudblazor;ddd;ai-agent;jobscheduler;modular;recurringjob</PackageTags>

    <!-- Package Release Notes -->
    <PackageReleaseNotes>Monica 1.0 release candidate 15 delivers redesigned operational workbenches, reusable JSON viewing and editing, owner-local job scheduling, configuration revision and sensitive-value controls, cross-platform Monica Guide bundles, and shared ProjectUnit source-analysis snapshots.</PackageReleaseNotes>

    <!-- Symbol Packages -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- Source Link -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

  </PropertyGroup>

  <!-- Include Logo and README in All Packages -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)logo.png" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)PACKAGE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Source Link Package Reference -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.303" PrivateAssets="All" />
  </ItemGroup>
</Project>
