@using Microsoft.Extensions.Localization
@using System.Globalization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.Core.Modularity.Models
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.State
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<ModuleSystemResource> L

@if (Session.Snapshot is { } snapshot)
{
    var startupDuration = snapshot.Summary.ApplicationStartupDurationMs;
    var recordedDuration = startupDuration ?? snapshot.Summary.TotalCompositionDurationMs;
    var startupWorkMs = snapshot.Modules.Sum(static module => module.StartupWorkDurationMs);
    var longestWorkModule = snapshot.Modules
        .Where(static module => module.StartupWorkDurationMs > 0)
        .OrderByDescending(static module => module.StartupWorkDurationMs)
        .FirstOrDefault();
    <section class="overview-score" aria-label="@L["Aria:SummaryMetrics"]">
        <div class="score-feature">
            <div class="score-lede">
                <span class="score-symbol" aria-hidden="true"><MoIcon Size="1.5rem" Icon="@MoIcons.Route" /></span>
                <p class="mo-vl-eyebrow">@(startupDuration.HasValue ? L["Overview:Score:Eyebrow:Startup"] : L["Overview:Score:Eyebrow:Composition"])</p>
                <MoDisplayValue Value="@DisplayValue(recordedDuration)"
                                Unit="@DisplayUnit(recordedDuration)"
                                AccessibleLabel="@L["Overview:Score:Display:Aria", ModuleDiagnosticsDisplay.Duration(recordedDuration)]" />
                <p class="score-exact mo-vl-mono">@ModuleDiagnosticsDisplay.ExactMilliseconds(recordedDuration)</p>
                @if (Session.Comparison?.ApplicationStartupDurationDeltaMs is { } startupDelta && startupDuration.HasValue)
                {
                    <p class="score-delta">@FormatExactDelta(startupDelta)</p>
                }
                <p class="mo-vl-lede score-finding">
                    @L["Overview:Score:Lede:OfWhich"]
                    <MoValueMark Role="MoVisualRole.Primary">@L["Overview:Score:Mark:Composition", ModuleDiagnosticsDisplay.Duration(snapshot.Summary.TotalCompositionDurationMs)]</MoValueMark>
                    <span>@L["Overview:Score:Lede:Joiner"]</span>
                    <MoValueMark Role="MoVisualRole.Info">@L["Overview:Score:Mark:Work", ModuleDiagnosticsDisplay.Duration(startupWorkMs)]</MoValueMark>
                    @if (longestWorkModule is { } longest)
                    {
                        <span>@L["Overview:Score:Longest:Prefix"]</span>
                        <span class="score-contributor"><button type="button" class="mo-vl-link" @onclick="() => ModuleSelected.InvokeAsync(longest)">@longest.TypeName</button><span>@L["Overview:Score:Longest:Suffix"]</span></span>
                    }
                </p>
                @if (!startupDuration.HasValue)
                {
                    <p class="score-note">@L["Atlas:Overview:StartupNotTracked"]</p>
                }
            </div>
            <div class="score-trace">
                <header class="score-trace-heading">
                    <div>
                        <p class="mo-vl-eyebrow">@L["Overview:Trace:Eyebrow"]</p>
                        <h2>@L["Overview:Trace:Title"]</h2>
                    </div>
                    <span class="trace-count mo-vl-mono">@L["Overview:Trace:Count", snapshot.TraceSpans.Length]</span>
                </header>
                <ModuleWorkbenchStartupTimeline Session="@Session" />
            </div>
        </div>
        <div class="score-facts"><MoFactGrid Facts="@Facts(snapshot)" /></div>
    </section>

    <ModuleWorkbenchResourceActivations Session="@Session" />

    <div class="overview-evidence">
        <section class="mo-vl-panel ledger-panel" aria-labelledby="ledger-title">
            <header class="mo-vl-panel-head ledger-heading">
                <div>
                    <h2 id="ledger-title" class="mo-vl-panel-title">@L["Overview:Ledger:Title"]</h2>
                    <p class="mo-vl-panel-sub">@L["Overview:Ledger:Sub", snapshot.Summary.ModuleCount]</p>
                </div>
                <div class="mo-vl-legend">
                    <span><i class="mo-vl-swatch mo-vl-role--primary"></i>@L["Overview:Ledger:Legend:Callback"]</span>
                    <span><i class="mo-vl-swatch mo-vl-role--info"></i>@L["Overview:Ledger:Legend:Work"]</span>
                </div>
            </header>
            <div class="ledger-tools">
                <MudTextField T="string"
                              Value="@_search"
                              ValueChanged="@OnSearchChanged"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@MoIcons.Search"
                              Label="@L["Overview:Ledger:SearchPlaceholder"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Clearable="true"
                              Class="ledger-search" ClearIcon="@MoIcons.Close" />
                <div class="mo-vl-chips" role="group" aria-label="@L["Overview:Ledger:FilterAria"]">
                    <MoFilterChip Label="@L["Common:All"]" Selected="@(_filter == LedgerFilter.All)" SelectedChanged="@(() => SetFilter(LedgerFilter.All))" />
                    <MoFilterChip Label="@L["Overview:Ledger:Filter:HasStartupWork"]" Selected="@(_filter == LedgerFilter.HasStartupWork)" SelectedChanged="@(() => SetFilter(LedgerFilter.HasStartupWork))" />
                    <MoFilterChip Label="@L["Overview:Ledger:Filter:Web"]" Selected="@(_filter == LedgerFilter.Web)" SelectedChanged="@(() => SetFilter(LedgerFilter.Web))" />
                    <MoFilterChip Label="@L["Overview:Ledger:Filter:Ui"]" Selected="@(_filter == LedgerFilter.Ui)" SelectedChanged="@(() => SetFilter(LedgerFilter.Ui))" />
                    <MoFilterChip Label="@L["Overview:Ledger:Filter:Disabled"]" Selected="@(_filter == LedgerFilter.Disabled)" SelectedChanged="@(() => SetFilter(LedgerFilter.Disabled))" Role="MoVisualRole.Warning" />
                </div>
            </div>
            <MoRankedLedger Rows="@LedgerRows"
                            AriaLabel="@L["Overview:Ledger:Aria"]"
                            HeaderLabels="@_ledgerHeader"
                            TopN="10"
                            EmptyText="@L["Overview:Ledger:Empty", _search]"
                            FooterNote="@LedgerFooterNote(snapshot)"
                            ShowMoreLabel="@L["Overview:Ledger:ShowMore"]"
                            ShowLessLabel="@L["Overview:Ledger:ShowLess"]"
                            OnRowSelected="@SelectLedgerRowAsync" />
        </section>

        <aside class="overview-side">
            <section class="mo-vl-panel findings-panel" aria-labelledby="findings-title">
                <header class="mo-vl-panel-head">
                    <div>
                        <h2 id="findings-title" class="mo-vl-panel-title">@L["Overview:Findings:Title"]</h2>
                        <p class="mo-vl-panel-sub">@L["Overview:Findings:Sub", snapshot.Findings.Length, snapshot.Summary.ErrorCount]</p>
                    </div>
                </header>
                <div class="findings-list">
                    @if (snapshot.Findings.IsEmpty)
                    {
                        <p class="compact-empty-state"><MoIcon Icon="@MoIcons.ListChecks" Size="1.25rem" /><span>@L["Overview:Findings:Empty"]</span></p>
                    }
                    else
                    {
                        foreach (var finding in snapshot.Findings.Take(MaxVisibleFindings))
                        {
                            <MoSemanticCallout Severity="@FindingRole(finding.Severity)"
                                                Title="@ModuleDiagnosticsDisplay.FindingTitle(finding, L)">
                                <p class="finding-evidence">@ModuleDiagnosticsDisplay.FindingEvidence(finding, L)</p>
                                @if (finding.RelatedModules.Length > 0)
                                {
                                    var relatedModule = finding.RelatedModules[0];
                                    <button type="button" class="mo-vl-link finding-module" @onclick="() => SelectFindingModuleAsync(relatedModule)">@FindingModuleName(relatedModule)</button>
                                }
                                <details class="finding-diagnostics">
                                    <summary>@L["Overview:Findings:DiagnosticCode"]</summary>
                                    <code class="mo-vl-mono">@finding.Code</code>
                                </details>
                            </MoSemanticCallout>
                        }
                        @if (snapshot.Findings.Length > MaxVisibleFindings)
                        {
                            <MudExpansionPanels Class="finding-overflow">
                                <MudExpansionPanel Text="@L["Overview:Findings:Remaining", snapshot.Findings.Length - MaxVisibleFindings]" Icon="@MoIcons.ChevronDown">
                                    <div class="finding-overflow-list">
                                        @foreach (var finding in snapshot.Findings.Skip(MaxVisibleFindings))
                                        {
                                            <MoSemanticCallout Severity="@FindingRole(finding.Severity)"
                                                                Title="@ModuleDiagnosticsDisplay.FindingTitle(finding, L)">
                                                <p class="finding-evidence">@ModuleDiagnosticsDisplay.FindingEvidence(finding, L)</p>
                                                @if (finding.RelatedModules.Length > 0)
                                                {
                                                    var relatedModule = finding.RelatedModules[0];
                                                    <button type="button" class="mo-vl-link finding-module" @onclick="() => SelectFindingModuleAsync(relatedModule)">@FindingModuleName(relatedModule)</button>
                                                }
                                                <details class="finding-diagnostics">
                                                    <summary>@L["Overview:Findings:DiagnosticCode"]</summary>
                                                    <code class="mo-vl-mono">@finding.Code</code>
                                                </details>
                                            </MoSemanticCallout>
                                        }
                                    </div>
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }
                    }
                </div>
            </section>

            <ModuleWorkbenchCriticalPathRibbon Session="@Session" ModuleSelected="@ModuleSelected" />

            <section class="mo-vl-panel depth-panel" aria-labelledby="depth-title">
                <header class="mo-vl-panel-head">
                    <div>
                        <h2 id="depth-title" class="mo-vl-panel-title">@L["Overview:Depth:Title"]</h2>
                        <p class="mo-vl-panel-sub">@L["Overview:Depth:Sub", snapshot.Summary.ActiveModuleCount]</p>
                    </div>
                </header>
                <div class="depth-body">
                    @if (DepthRows.Count == 0)
                    {
                        <p class="compact-empty-state"><MoIcon Icon="@MoIcons.Workflow" Size="1.25rem" /><span>@L["Overview:Depth:Empty"]</span></p>
                    }
                    else
                    {
                        <MoDotDistribution Rows="@DepthRows" />
                    }
                </div>
            </section>
        </aside>
    </div>
}

@code {
    private const int MaxVisibleFindings = 4;

    [Parameter, EditorRequired] public ModuleSystemWorkbenchSession Session { get; set; } = default!;
    [Parameter] public EventCallback<ModuleDiagnosticsModule> ModuleSelected { get; set; }

    private enum LedgerFilter
    {
        All,
        HasStartupWork,
        Web,
        Ui,
        Disabled,
    }

    private string _search = string.Empty;
    private LedgerFilter _filter = LedgerFilter.All;
    private MoLedgerHeaderLabels? _ledgerHeader;

    private static double ModuleCost(ModuleDiagnosticsModule module) =>
        module.SerialCallbackDurationMs + module.StartupWorkDurationMs;

    private IReadOnlyList<MoFact> Facts(ModuleDiagnosticsSnapshot snapshot) =>
    [
        new(L["Overview:Kpis:ActiveModules"], snapshot.Summary.ActiveModuleCount.ToString(CultureInfo.InvariantCulture), L["Overview:Kpis:Declared", snapshot.Summary.ModuleCount]),
        new(L["Atlas:Overview:DirectDependencies"], snapshot.Topology.Edges.Length.ToString(CultureInfo.InvariantCulture)),
        new(L["Overview:Kpis:ServiceRegistration"], ModuleDiagnosticsDisplay.Duration(snapshot.Summary.ServiceRegistrationDurationMs)),
        new(L["Overview:Kpis:TypeDiscovery"], ModuleDiagnosticsDisplay.Duration(snapshot.Summary.TypeDiscoveryDurationMs)),
    ];

    private IReadOnlyList<MoDotRow> DepthRows
    {
        get
        {
            if (Session.Snapshot is not { } snapshot)
            {
                return [];
            }

            var active = snapshot.Modules.Where(static module => module.IsActive).ToArray();
            if (active.Length == 0)
            {
                return [];
            }

            var maxDepth = active.Max(static module => module.DependencyDepth);
            return active
                .GroupBy(static module => module.DependencyDepth)
                .OrderBy(static group => group.Key)
                .Select(group => new MoDotRow(
                    $"L{group.Key.ToString(CultureInfo.InvariantCulture)}",
                    group.Count(),
                    maxDepth == 0 ? 1.0 : 0.28 + group.Key / (double)maxDepth * 0.72))
                .ToArray();
        }
    }

    private IReadOnlyList<MoLedgerRow> LedgerRows
    {
        get
        {
            if (Session.Snapshot is not { } snapshot)
            {
                return [];
            }

            _ledgerHeader ??= new MoLedgerHeaderLabels(
                L["Overview:Ledger:Column:Rank"],
                L["Overview:Ledger:Column:Name"],
                L["Overview:Ledger:Column:Recorded"],
                L["Overview:Ledger:Column:Total"]);

            var query = snapshot.Modules.Where(MatchesFilter);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var needle = _search.Trim();
                query = query.Where(module => module.TypeName.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || module.AssemblyName.Contains(needle, StringComparison.OrdinalIgnoreCase));
            }

            var ranked = query.OrderByDescending(ModuleCost).ToArray();
            var scale = ranked.Length > 0 ? ModuleCost(ranked[0]) : 0;
            var rows = new List<MoLedgerRow>(ranked.Length);
            foreach (var module in ranked)
            {
                var callback = module.SerialCallbackDurationMs;
                var work = module.StartupWorkDurationMs;
                string? workCaption = null;
                if (work > 0)
                {
                    workCaption = L["Overview:Ledger:Cap:Work", ModuleDiagnosticsDisplay.Duration(work)];
                }

                var row = new MoLedgerRow(
                    module.TypeName,
                    module.AssemblyName,
                    ModuleBadges(module),
                    callback,
                    work,
                    scale,
                    L["Overview:Ledger:Cap:Callback", callback > 0 ? ModuleDiagnosticsDisplay.Duration(callback) : "—"],
                    workCaption,
                    callback + work > 0 ? ModuleDiagnosticsDisplay.Duration(callback + work) : "—",
                    TotalWarn: module.ErrorCount > 0,
                    Disabled: !module.IsActive,
                    Key: module.ModuleKey.Id);
                rows.Add(row);
            }

            return rows;
        }
    }

    private string? LedgerFooterNote(ModuleDiagnosticsSnapshot snapshot)
    {
        var filteredCount = LedgerRows.Count;
        return filteredCount < snapshot.Summary.ModuleCount
            ? L["Overview:Ledger:Filtered", filteredCount, snapshot.Summary.ModuleCount]
            : L["Overview:Ledger:FullRegistry"];
    }

    private IReadOnlyList<MoLedgerBadge> ModuleBadges(ModuleDiagnosticsModule module)
    {
        var badges = new List<MoLedgerBadge>(4);
        if (!module.IsActive)
        {
            badges.Add(new MoLedgerBadge(L["Overview:Ledger:Badge:Disabled"], MoVisualRole.Warning));
        }

        if (module.IsWebModule || module.RequiresWebHost)
        {
            badges.Add(new MoLedgerBadge("Web"));
        }

        if (module.IsUiModule)
        {
            badges.Add(new MoLedgerBadge("UI"));
        }

        if (module.ErrorCount > 0)
        {
            badges.Add(new MoLedgerBadge(module.ErrorCount.ToString(CultureInfo.InvariantCulture), MoVisualRole.Error));
        }

        return badges;
    }

    private bool MatchesFilter(ModuleDiagnosticsModule module) => _filter switch
    {
        LedgerFilter.HasStartupWork => module.StartupWorkDurationMs > 0,
        LedgerFilter.Web => module.IsWebModule || module.RequiresWebHost,
        LedgerFilter.Ui => module.IsUiModule,
        LedgerFilter.Disabled => !module.IsActive,
        _ => true,
    };

    private Task OnSearchChanged(string value)
    {
        _search = value;
        return InvokeAsync(StateHasChanged);
    }

    private Task SetFilter(LedgerFilter filter)
    {
        _filter = filter;
        return InvokeAsync(StateHasChanged);
    }

    private Task SelectLedgerRowAsync(MoLedgerRow row) => Session.Snapshot?.Modules
        .FirstOrDefault(module => string.Equals(module.ModuleKey.Id, row.Key, StringComparison.Ordinal)) is { } module
            ? ModuleSelected.InvokeAsync(module)
            : Task.CompletedTask;

    private Task SelectFindingModuleAsync(ModuleKey moduleKey) => Session.Snapshot?.Modules
        .FirstOrDefault(module => module.ModuleKey == moduleKey) is { } module
            ? ModuleSelected.InvokeAsync(module)
            : Task.CompletedTask;

    private string FindingModuleName(ModuleKey moduleKey) => Session.Snapshot?.Modules
        .FirstOrDefault(module => module.ModuleKey == moduleKey)?.TypeName ?? moduleKey.Value;

    private static MoVisualRole FindingRole(ModuleDiagnosticFindingSeverity severity) => severity switch
    {
        ModuleDiagnosticFindingSeverity.Error => MoVisualRole.Error,
        ModuleDiagnosticFindingSeverity.Warning => MoVisualRole.Warning,
        _ => MoVisualRole.Info,
    };

    private static string DisplayValue(double milliseconds) => milliseconds switch
    {
        >= 1_000 => (milliseconds / 1_000).ToString("F2", CultureInfo.InvariantCulture),
        _ => milliseconds.ToString("F1", CultureInfo.InvariantCulture),
    };

    private static string DisplayUnit(double milliseconds) => milliseconds >= 1_000 ? "s" : "ms";

    private string FormatExactDelta(double delta) => delta switch
    {
        > 0 => L["Comparison:Slower", ModuleDiagnosticsDisplay.ExactMilliseconds(delta)],
        < 0 => L["Comparison:Faster", ModuleDiagnosticsDisplay.ExactMilliseconds(Math.Abs(delta))],
        _ => L["Comparison:Unchanged"]
    };
}
