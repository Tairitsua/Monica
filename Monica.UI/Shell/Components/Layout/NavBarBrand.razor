@using Microsoft.Extensions.Options
@using Monica.Modules
@using Monica.UI.Shared.Components.Branding
@using Microsoft.Extensions.Hosting
@inject IOptions<ModuleShellUIOption> Options
@inject IHostEnvironment HostEnvironment

<a class="navbar-brand @(Contextual ? "navbar-brand--contextual" : null)" href="/system-info" aria-label="@Options.Value.GetAppName()">
    @if (ShowIcon)
    {
        <div class="brand-logo"><MonicaIcon /></div>
    }
    @if (!IconOnly)
    {
        <div class="brand-text">
            <div class="brand-name" title="@Options.Value.GetAppName()">@Options.Value.GetAppName()</div>
            <div class="brand-version-container">
                @if (Contextual)
                {
                    <span class="brand-environment">@HostEnvironment.EnvironmentName</span>
                }
                <span class="brand-version" title="@Options.Value.GetAppVersion()">@Options.Value.GetAppVersion()</span>
            </div>
        </div>
    }
</a>

@code {
    /// <summary>Shows only the themed Monica mark in the category rail.</summary>
    [Parameter] public bool IconOnly { get; set; }
    /// <summary>Includes the mark beside host identity. Defaults to true.</summary>
    [Parameter] public bool ShowIcon { get; set; } = true;
    /// <summary>Uses two compact identity lines with the host environment and version in contextual navigation. Defaults to false.</summary>
    [Parameter] public bool Contextual { get; set; }
}
