@inject IStringLocalizer<LockerResource> L

<div class="lease-workspace mo-page-shell mo-page-shell--full-width">
    <MoPageMasthead Icon="@MoIcons.Key" Title="@L["Design:Title"]" Crumb="@L["Design:Eyebrow"]" Meta="@Meta" Actions="@Actions" />
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? Meta { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
