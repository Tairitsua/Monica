<button type="button" class="fchip mo-vl-role--@Role @(Count == 0 ? "is-zero" : null)" aria-pressed="@(Selected ? "true" : "false")" @onclick="Select">
    @if (Marked) { <span class="sw @(Hatched ? "is-hatch" : null)" aria-hidden="true"></span> }
    <span>@ChildContent</span><span class="n">@Count</span>
</button>

@code {
    /// <summary>Gets or sets how many entries match the option within the other filters.</summary>
    [Parameter] public int Count { get; set; }
    /// <summary>Gets or sets whether the option participates in the current filter.</summary>
    [Parameter] public bool Selected { get; set; }
    /// <summary>Gets or sets the option's semantic color role.</summary>
    [Parameter] public string Role { get; set; } = "primary";
    /// <summary>Gets or sets whether the option shows a semantic marker.</summary>
    [Parameter] public bool Marked { get; set; }
    /// <summary>Gets or sets whether the marker represents an absent transport report.</summary>
    [Parameter] public bool Hatched { get; set; }
    /// <summary>Gets or sets the event raised when a filter option is pressed.</summary>
    [Parameter] public EventCallback Select { get; set; }
    /// <summary>Gets or sets the localized filter name.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
