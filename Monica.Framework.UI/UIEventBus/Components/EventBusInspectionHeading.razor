@using Monica.EventBus.Abstractions
@using Monica.EventBus.Models
@using Monica.Framework.UI.UIEventBus.Support
@inject IStringLocalizer<EventBusResource> L

@{
    var topic = Workbench.SelectedTopic;
    var provider = Workbench.SelectedProvider;
    var change = Workbench.InspectionChange;
    var row = Workbench.SelectedSubscription;
    var icon = change is not null ? MoIcons.History : topic is not null ? MoIcons.Radio : provider is not null
        ? EventBusVisuals.ProviderIcon(provider.IsDistributed) : row is not null ? MoIcons.Route : MoIcons.Info;
    var tone = change is not null ? EventBusVisuals.Role(change.ChangeType) : topic is not null ? EventBusVisuals.Role(topic.Coverage)
        : provider is not null ? provider.UnhealthyTopicCount > 0 ? MoVisualRole.Error : provider.IsDistributed ? MoVisualRole.Secondary : MoVisualRole.Info
        : row is not null ? EventBusVisuals.Role(row.State) : MoVisualRole.Neutral;
    var kicker = change is not null ? L.GetSubscriptionChangeTypeText(change.ChangeType) + " · " + change.ObservationId
        : topic is not null ? L["Precision:ColTopic"].Value : provider is not null ? provider.ImplementationType
        : row is not null ? L.GetDiscoveryModeText(row.IsAutoDiscovered) : null;
    var title = topic?.Topic ?? row?.EventTypeShortName ?? (provider is null ? L["Precision:InspNotFoundTitle"].Value
        : L.GetProviderKindText(provider.ProviderType) + " · " + EventBusPresentation.KeyText(provider.ServiceKey, L));
}
<div class="eb-inspection-heading">
    @if (Workbench.HasInspectionAncestor)
    {
        <button class="icon-btn eb-sheet-back" type="button" title="@L["Precision:InspBack"]" aria-label="@L["Precision:InspBack"]" @onclick="Workbench.BackInspection">
            <MoIcon Icon="@MoIcons.ChevronLeft" Size="18px" />
        </button>
    }
    <span class="tile @tone.ToCssClass()"><MoIcon Icon="@icon" Size="18px" /></span>
    <div class="eb-sheet-id">
        @if (kicker is not null) { <span class="eb-sheet-kicker">@kicker</span> }
        <h2 class="eb-break" tabindex="-1" @ref="_heading">@title</h2>
        <div class="eb-sheet-flags">
            @if (change is not null)
            {
                <span class="status is-pill @EventBusVisuals.Role(change.ChangeType).ToCssClass()"><span class="status-dot"></span>@L.GetSubscriptionChangeTypeText(change.ChangeType)</span>
            }
            @if (topic is not null)
            {
                <EventBusTransportBadge Distributed="true" Kind="@(topic.Status?.Provider ?? topic.Provider?.ProviderType ?? EventBusProviderKind.Unknown)" ServiceKey="@topic.ServiceKey" />
                <EventBusRuntimeBadge Status="@topic.Status" />
                @if (topic.IsOrphan) { <span class="chip mo-vl-role--warning">@L["Precision:OrphanBadge"]</span> }
            }
            @if (row is not null)
            {
                var kind = row.TopicStatus?.Provider ?? change?.ReportedProvider ?? Workbench.InspectionModel?.Provider(row.Scope, row.ServiceKey)?.ProviderType ?? EventBusProviderKind.Unknown;
                <span class="status is-pill @EventBusVisuals.Role(row.State).ToCssClass()"><span class="status-dot"></span>@L.GetSubscriptionStateText(row.State)</span>
                <EventBusRuntimeBadge Scope="@row.Scope" Status="@row.TopicStatus" Compact="true" />
                <EventBusTransportBadge Distributed="@(row.Scope == EventSubscriptionScope.Distributed)" Kind="@kind" ServiceKey="@row.ServiceKey" />
            }
            @if (provider is not null)
            {
                <EventBusTransportBadge Distributed="@provider.IsDistributed" Kind="@provider.ProviderType" ServiceKey="@provider.ServiceKey" />
                @if (provider.UnhealthyTopicCount > 0)
                {
                    <span class="status is-pill mo-vl-role--error"><span class="status-dot"></span>@provider.UnhealthyTopicCount @L["Precision:OvReasonFailed"] / @L["Precision:OvReasonRecovering"]</span>
                }
            }
        </div>
    </div>
</div>

@code {
    /// <summary>Gets the owning workbench and its frozen selection.</summary>
    [CascadingParameter] public EventBusWorkbench Workbench { get; set; } = null!;

    private ElementReference _heading;
    private (string Key, string Id)? _focused;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var current = Workbench.Inspection;
        if (current is null || current == _focused) return;
        _focused = current;
        try { await _heading.FocusAsync(preventScroll: true); }
        catch (JSDisconnectedException) { }
    }
}
