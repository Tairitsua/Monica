@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.DataChannel.Pages
@using Monica.DataChannel.UIDataChannel.Support
@using Monica.UI.Shared.Components.Navigation

@{ var capture = State.Snapshot; }
<PageTitle>@L[Exceptions ? "Pages:DataChannelExceptions:Title" : "Pages:DataChannelManage:Title"]</PageTitle>
<div class="datachannel-workbench mo-page-shell mo-page-shell--full-width" aria-busy="@(State.IsRefreshing ? "true" : "false")">
    <header class="datachannel-identity">
        <div class="datachannel-identity__copy">
            <span class="datachannel-identity__kicker">@L["Workbench:Eyebrow"]</span>
            <h1>@L[Exceptions ? "ExceptionWorkbench:Title" : "Workbench:Title"]</h1>
            <p>@L[Exceptions ? "ExceptionWorkbench:Description" : "Workbench:Description"]</p>
        </div>
        <div class="datachannel-identity__tools">
            <div class="datachannel-capture">
                <span>@L["Workbench:Captured"]</span>
                <time>@(capture is null ? L["Workbench:NoCapture"].Value : UiTime.Format(capture.CapturedAt))</time>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Refresh" OnClick="RefreshAsync" Disabled="State.IsRefreshing">@L["Common:Actions:Refresh"]</MudButton>
        </div>
    </header>
    <MoWorkbenchNavigation Label="@L["Workbench:Navigation"]">
        <a href="@(UIDataChannelPage.PAGE_URL + ScopeQuery)" aria-current="@(!Exceptions ? "page" : null)">
            <MoIcon Icon="@MoIcons.Workflow" Size="1.25rem" />
            <span>@L["Workbench:Routes:Channels"]</span>
        </a>
        <a href="@(UIDataChannelExceptionsPage.PAGE_URL + ScopeQuery)" aria-current="@(Exceptions ? "page" : null)">
            <MoIcon Icon="@MoIcons.Error" Size="1.25rem" />
            <span>@L["Workbench:Routes:Exceptions"]</span>
        </a>
    </MoWorkbenchNavigation>
    @if (!string.IsNullOrEmpty(State.RefreshError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">
            <strong>@L["Workbench:ReadFailed"]</strong>
            <p>@State.RefreshError</p>
            <p>@L[capture is null ? "Workbench:UnavailableHelp" : "Workbench:PreviousCaptureHelp"]</p>
        </MudAlert>
    }
    @if (capture is null)
    {
        @if (State.IsRefreshing || !State.HasAttemptedCapture)
        {
            <div class="datachannel-loading" role="status">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <h2>@L["Workbench:Loading"]</h2>
                <p>@L["Workbench:LoadingDescription"]</p>
            </div>
        }
    }
    else if (Exceptions)
    {
        <section class="datachannel-evidence-strip" aria-label="@L["ExceptionWorkbench:SummaryLabel"]">
            <div>
                <span>@L["ExceptionWorkbench:Retained"]</span>
                <strong data-attention="@(capture.ExceptionSummary.TotalCurrentExceptions > 0 ? "true" : "false")">@capture.ExceptionSummary.TotalCurrentExceptions</strong>
            </div>
            <div>
                <span>@L["ExceptionWorkbench:AffectedChannels"]</span>
                <strong>@capture.ExceptionSummary.ChannelsWithExceptions <small>/ @capture.ExceptionSummary.TotalChannels</small>
                </strong>
            </div>
            <div>
                <span>@L["ExceptionWorkbench:Lifetime"]</span>
                <strong>@capture.ExceptionSummary.TotalHistoricalExceptions</strong>
            </div>
            <div class="datachannel-evidence-strip__explanation">
                <MoIcon Icon="@MoIcons.History" Size="1.5rem" />
                <p>@L["ExceptionWorkbench:RetentionHelp"]</p>
            </div>
        </section>
        <ChannelExceptionDirectory Summary="capture.ExceptionSummary" ChannelId="@ChannelId" IsBusy="IsChannelBusy" OnInspect="InspectExceptionsAsync" OnClear="ClearHistoryAsync" />
    }
    else
    {
        <section class="datachannel-evidence-strip datachannel-evidence-strip--initialization" aria-label="@L["Workbench:SummaryLabel"]">
            <div>
                <span>@L["Workbench:Registered"]</span>
                <strong>@capture.Channels.Count</strong>
            </div>
            <div data-state="Initialized">
                <span>@L["Channel:States:Initialized"]</span>
                <strong>@capture.Channels.Count(channel => DataChannelPresentation.Initialization(channel) == "Initialized")</strong>
            </div>
            <div data-state="Initializing">
                <span>@L["Channel:States:Initializing"]</span>
                <strong>@capture.Channels.Count(channel => DataChannelPresentation.Initialization(channel) == "Initializing")</strong>
            </div>
            <div data-state="Unavailable">
                <span>@L["Channel:States:Unavailable"]</span>
                <strong>@capture.Channels.Count(channel => DataChannelPresentation.Initialization(channel) == "Unavailable")</strong>
            </div>
            <div>
                <span>@L["Channel:States:NotInitialized"]</span>
                <strong>@capture.Channels.Count(channel => DataChannelPresentation.Initialization(channel) == "NotInitialized")</strong>
            </div>
            <div>
                <span>@L["Workbench:RetainedExceptions"]</span>
                <strong data-attention="@(capture.ExceptionSummary.TotalCurrentExceptions > 0 ? "true" : "false")">@capture.ExceptionSummary.TotalCurrentExceptions</strong>
            </div>
        </section>
        <ChannelDirectory Channels="capture.Channels" ChannelId="@ChannelId" IsBusy="IsChannelBusy" OnInspect="InspectPipelineAsync" OnReinitialize="ReinitializeAsync" OnViewExceptions="InspectExceptionsAsync" OnClear="ClearHistoryAsync" />
        <p class="datachannel-scope-note">
            <MoIcon Icon="@MoIcons.Info" Size="1.25rem" />@L["Workbench:ScopeHelp"]</p>
    }
</div>

@code {
    private string ScopeQuery => string.IsNullOrEmpty(ChannelId) ? string.Empty : "?channel=" + Uri.EscapeDataString(ChannelId);
}
