@using Monica.ServiceDiscovery.Facades
@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Support
@using Monica.Core.Results;
@using Monica.UI.Shared.Components.ContextMenu
@inject ServiceDiscoveryFacade ServiceDiscoveryFacade
@inject ServiceDiscoveryDomainColorResolver DomainColorResolver
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<ServiceDiscoveryResource> L
@implements IAsyncDisposable

<section class="service-discovery-visual discovery-atlas" aria-busy="@(_loading ? "true" : "false")">
    <header class="atlas-heading">
        <div class="atlas-heading__identity">
            <span class="atlas-kicker">@L["Atlas:Services:Eyebrow"]</span>
            <h2>@L["ServiceGraph:Title"]</h2>
            <p>@L["Atlas:Services:Description"]</p>
        </div>
        <div class="atlas-actions">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@MoIcons.Refresh"
                       OnClick="LoadServiceDataAsync" Disabled="@_loading">@L["Shared:Actions:Refresh"]</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@MoIcons.Sliders"
                       OnClick="ToggleLayoutPanel" aria-expanded="@(_showLayoutPanel ? "true" : "false")">@L["Atlas:Shared:Layout"]</MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@MoIcons.Filter"
                       OnClick="ToggleFilterPanel" aria-expanded="@(_showFilterPanel ? "true" : "false")">@L["Atlas:Shared:Filters"]</MudButton>
        </div>
    </header>
    @if (_captureError is not null)
    {
        <div class="atlas-notice atlas-notice--error" role="alert">
            <MoIcon Icon="@MoIcons.Error" Size="1.25rem" />
            <div><strong>@L[_hasSnapshot ? "Atlas:Shared:RetainedSnapshot" : "Atlas:Shared:CaptureFailed"]</strong><p>@_captureError</p></div>
        </div>
    }
    @if (_showLayoutPanel)
    {
        <div class="atlas-shelf"><ServiceLayoutPanel CurrentLayout="_currentLayout" ForceDistance="_forceDistance" ForceStrength="_forceStrength"
            CurrentLayoutChanged="OnLayoutChanged" ForceDistanceChanged="OnForceDistanceChanged" ForceStrengthChanged="OnForceStrengthChanged" /></div>
    }
    @if (_showFilterPanel)
    {
        <div class="atlas-shelf"><ServiceFilterPanel @ref="_filterPanel" @bind-FilterText="_filterText" @bind-SelectedStatuses="_selectedStatuses"
            @bind-SelectedDomains="_selectedDomains" @bind-ShowOnlyWithInstances="_showOnlyWithInstances"
            DomainSelectionIntentChanged="OnDomainSelectionIntentChanged" OnFiltersChanged="ApplyFilters" AllServices="_allServices" /></div>
    }
    <div class="atlas-workspace">
        <section class="atlas-map" aria-label="@L["Atlas:Services:MapLabel"]">
            <header class="atlas-map__bar">
                <div><span class="atlas-scope">@L["Atlas:Services:MapLabel"]</span><strong>@(_hasSnapshot ? L["ServiceGraph:Summary:ShowingServices", _filteredServices.Count, _allServices.Count] : L["Shared:Values:NotAvailable"])</strong></div>
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@MoIcons.Focus"
                           OnClick="ResetView" Disabled="@(!_graphAvailable)">@L["Atlas:Shared:FitView"]</MudButton>
            </header>
            <div class="atlas-map__stage">
                <div id="@_graphContainerId" class="service-discovery-visual__canvas" aria-hidden="true" @onclick="OnBackgroundClick" @oncontextmenu:preventDefault="true"></div>
                @if (_loading && !_hasSnapshot)
                {
                    <div class="atlas-map__state" role="status"><MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" /><strong>@L["Atlas:Shared:Loading"]</strong></div>
                }
                else if (_graphError is not null)
                {
                    <div class="atlas-map__state" role="status"><MoIcon Icon="@MoIcons.Workflow" Size="1.5rem" /><strong>@L["Atlas:Shared:GraphUnavailable"]</strong><p>@L["Atlas:Shared:NativeAlternative"]</p></div>
                }
                else if (!_hasSnapshot && _captureError is not null)
                {
                    <div class="atlas-map__state" role="status"><strong>@L["Atlas:Shared:CaptureFailed"]</strong><p>@L["Atlas:Shared:RetryHint"]</p></div>
                }
                else if (_filteredServices.Count == 0 && _hasSnapshot)
                {
                    <div class="atlas-map__state" role="status"><MoIcon Icon="@MoIcons.Cloud" Size="1.5rem" /><strong>@L[_allServices.Count == 0 ? "Atlas:Services:Empty" : "Atlas:Shared:FilterMiss"]</strong>
                        <p>@L[_allServices.Count == 0 ? "Atlas:Services:EmptyHint" : "Atlas:Shared:FilterMissHint"]</p>
                        @if (_allServices.Count > 0) { <MudButton OnClick="@(() => ClearAllFiltersAsync(null))" Color="Color.Primary">@L["Shared:Actions:Clear"]</MudButton> }
                    </div>
                }
                @if (_loading && _hasSnapshot) { <div class="atlas-refreshing" role="status">@L["Atlas:Shared:Refreshing"]</div> }
            </div>
            <footer class="atlas-map__footer"><p>@L["Atlas:Services:NoEdges"]</p><span>@L["Atlas:Shared:GestureHint"]</span></footer>
        </section>
        <section class="atlas-native" aria-label="@L["Atlas:Services:Roster"]">
            <header class="atlas-native__heading"><div><span class="atlas-kicker">@L["Atlas:Shared:NativeEvidence"]</span><h3>@L["Atlas:Services:Roster"]</h3></div><span class="atlas-native__count">@(_hasSnapshot ? _filteredServices.Count.ToString() : L["Shared:Values:NotAvailable"].Value)</span></header>
            <p class="atlas-native__intro">@L["Atlas:Services:RosterHint"]</p>
            <ul class="atlas-roster">
                @foreach (var service in _filteredServices.OrderBy(s => s.AppName, StringComparer.CurrentCultureIgnoreCase))
                {
                    <li @key="service.AppId" class="atlas-roster__row">
                        <button type="button" class="atlas-record" @onclick="@(() => ViewServiceDetailsAsync(service))">
                            <span class="atlas-record__name">@service.AppName</span><code>@service.AppId</code>
                            <span class="atlas-record__meta">@GetServiceDomainName(service)<span>·</span>@L["Atlas:Services:InstanceCount", service.TotalInstanceCount]</span>
                            <span class="atlas-status atlas-status--@service.OverallStatus.ToString().ToLowerInvariant()">@service.OverallStatus.GetText(L)</span>
                        </button>
                        <div class="atlas-record__actions">
                            <MudTooltip Text="@L["ServiceGraph:ContextMenu:FocusService"]"><MudIconButton Icon="@MoIcons.Focus" Size="Size.Small"
                                aria-label="@L["ServiceGraph:ContextMenu:FocusService"]" Disabled="@(!_graphAvailable)" OnClick="@(() => FocusOnServiceAsync(service))" /></MudTooltip>
                            <MudMenu Icon="@MoIcons.MoreHorizontal" Size="Size.Small" AriaLabel="@L["Atlas:Shared:RecordActions", service.AppName]">
                                <MudMenuItem OnClick="@(() => ViewServiceDetailsAsync(service))">@L["ServiceGraph:ContextMenu:ViewServiceDetails"]</MudMenuItem>
                                <MudMenuItem OnClick="@(() => FilterByStatusAsync(service))">@L["ServiceGraph:ContextMenu:FilterSameStatus"]</MudMenuItem>
                                <MudMenuItem OnClick="@(() => FilterByDomainAsync(service))">@L["ServiceGraph:ContextMenu:FilterSameDomain"]</MudMenuItem>
                                @if (!string.IsNullOrWhiteSpace(service.ProjectName)) { <MudMenuItem OnClick="@(() => FilterByProjectAsync(service))">@L["ServiceGraph:ContextMenu:FilterSameProject"]</MudMenuItem> }
                                <MudMenuItem OnClick="@(() => ClearAllFiltersAsync(service))">@L["ServiceGraph:ContextMenu:ClearFilters"]</MudMenuItem>
                                <MudMenuItem OnClick="@(() => CopyServiceIdAsync(service))">@L["ServiceGraph:ContextMenu:CopyServiceId"]</MudMenuItem>
                                <MudMenuItem OnClick="@(() => CopyServiceNameAsync(service))">@L["ServiceGraph:ContextMenu:CopyServiceName"]</MudMenuItem>
                            </MudMenu>
                        </div>
                    </li>
                }
            </ul>
            @if (_hasSnapshot && _filteredServices.Count == 0) { <p class="atlas-native__empty">@L[_allServices.Count == 0 ? "Atlas:Services:Empty" : "Atlas:Shared:FilterMiss"]</p> }
            <footer class="atlas-native__footer"><span>@L["Atlas:Shared:Captured"]</span><time>@(_capturedAt?.ToLocalTime().ToString("HH:mm:ss") ?? L["Shared:Values:NotAvailable"].Value)</time></footer>
        </section>
    </div>
    <div class="atlas-legend" aria-label="@L["Atlas:Shared:StatusLegend"]">
        @foreach (var status in Enum.GetValues<ServiceStatus>()) { <span class="atlas-status atlas-status--@status.ToString().ToLowerInvariant()">@status.GetText(L)</span> }
        <span class="atlas-legend__note">@L["Atlas:Services:MembershipHint"]</span>
    </div>
</section>

@* Context menu *@
<MoContextMenu TItem="RegisteredServiceStatus" 
               Items="@_contextMenuItems" 
               Visible="@_contextMenuOpen"
               InitialX="@_contextMenuX" 
               InitialY="@_contextMenuY"
               ContextItem="@_contextMenuService"
               OpeningRevision="@_contextMenuOpeningRevision"
               OnItemClick="@OnContextMenuItemClick"
               OnClose="@CloseContextMenu" />

@code {
    [Parameter] public EventCallback<RegisteredServiceStatus> OnServiceClick { get; set; }

    private const string JS_MODULE_PATH = "./_content/Monica.ServiceDiscovery/UIServiceDiscovery/serviceGraph.js";
    private long _contextMenuOpeningRevision;
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly SemaphoreSlim _captureGate = new(1, 1);
    private readonly SemaphoreSlim _interopGate = new(1, 1);
    private readonly object _disposeSync = new();
    private readonly string _graphContainerId = $"service-graph-{Guid.NewGuid():N}";
    private IJSObjectReference? _graphController;
    private DotNetObjectReference<ServiceVisualization>? _dotNetReference;
    private ServiceFilterPanel? _filterPanel;
    private Task? _disposeTask;
    private List<RegisteredServiceStatus> _allServices = new();
    private List<RegisteredServiceStatus> _filteredServices = new();
    private bool _loading = true;
    private bool _hasSnapshot;
    private bool _graphAvailable;
    private string? _captureError;
    private string? _graphError;
    private DateTimeOffset? _capturedAt;
    private bool _allDomainsSelected = true;
    private bool _showOfflineServices = true;
    
    // Filter-related fields
    private bool _showFilterPanel = false;
    private bool _showLayoutPanel = false;
    private string _filterText = string.Empty;
    private IReadOnlyCollection<ServiceStatus> _selectedStatuses = Enum.GetValues<ServiceStatus>();
    private IReadOnlyCollection<string> _selectedDomains = new HashSet<string>();
    private bool _showOnlyWithInstances = false;
    
    // Layout-related fields
    private ServiceLayoutType _currentLayout = ServiceLayoutType.Grid;
    private int _forceDistance = 150;
    private int _forceStrength = -500;
    
    // Context-menu-related fields
    private bool _contextMenuOpen = false;
    private double _contextMenuX = 0;
    private double _contextMenuY = 0;
    private RegisteredServiceStatus? _contextMenuService;
    private List<ContextMenuItem<RegisteredServiceStatus>> _contextMenuItems = new();
    private volatile bool _disposed;

    protected override Task OnInitializedAsync() => LoadServiceDataAsync(initialLoad: true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await InitializeGraphAsync();
            if (!_disposed)
            {
                _graphAvailable = true;
                await UpdateGraph();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (JSDisconnectedException) when (_disposed) { }
        catch (JSException)
        {
            if (!_disposed)
            {
                _graphError = L["Atlas:Shared:GraphUnavailable"].Value;
                StateHasChanged();
            }
        }
    }

    private async Task InitializeGraphAsync()
    {
        await _interopGate.WaitAsync(_lifetimeCancellation.Token);

        IJSObjectReference? module = null;
        IJSObjectReference? graphController = null;
        DotNetObjectReference<ServiceVisualization>? dotNetReference = null;
        try
        {
            module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                JS_MODULE_PATH);

            if (_disposed)
            {
                return;
            }

            var isDarkMode = await JSRuntime.InvokeAsync<bool>(
                "eval",
                _lifetimeCancellation.Token,
                "document.documentElement.classList.contains('dark')");

            dotNetReference = DotNetObjectReference.Create(this);
            graphController = await module.InvokeAsync<IJSObjectReference>(
                "createGraph",
                _graphContainerId,
                isDarkMode,
                dotNetReference,
                GetGraphTexts());

            if (_disposed)
            {
                return;
            }

            _graphController = graphController;
            _dotNetReference = dotNetReference;
            graphController = null;
            dotNetReference = null;
        }
        finally
        {
            await DisposeGraphControllerAsync(graphController);
            dotNetReference?.Dispose();
            await ReleaseModuleReferenceAsync(module);

            _interopGate.Release();
        }
    }

    private Task LoadServiceDataAsync() => LoadServiceDataAsync(initialLoad: false);

    private async Task LoadServiceDataAsync(bool initialLoad)
    {
        if (_disposed || (_loading && !initialLoad)) return;
        var ownsCapture = false;
        try
        {
            ownsCapture = await _captureGate.WaitAsync(0, _lifetimeCancellation.Token);
            if (!ownsCapture || _disposed) return;
            _loading = true;
            _captureError = null;
            if (!initialLoad) StateHasChanged();

            var result = await ServiceDiscoveryFacade.CaptureServicesAsync(_lifetimeCancellation.Token);
            if (_disposed) return;
            if (result.IsFailed(out var error, out var services))
            {
                _captureError = error.Message ?? L["Atlas:Shared:CaptureFailed"].Value;
                return;
            }

            _allServices = services ?? [];
            var currentDomains = _allServices.SelectMany(GetServiceDomainNames).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            if (_allDomainsSelected)
            {
                _selectedDomains = currentDomains;
            }

            DomainColorResolver.AssignColors(currentDomains.Select(name => new DomainInfo { Name = name }));
            _hasSnapshot = true;
            _capturedAt = DateTimeOffset.UtcNow;
            await ApplyFilters();
        }
        catch (OperationCanceledException) when (_disposed) { }
        catch (Exception ex)
        {
            if (!_disposed) _captureError = L["ServiceGraph:Messages:LoadException", ex.Message].Value;
        }
        finally
        {
            if (ownsCapture)
            {
                _loading = false;
                _captureGate.Release();
                if (!_disposed) StateHasChanged();
            }
        }
    }

    private void ToggleFilterPanel()
    {
        _showFilterPanel = !_showFilterPanel;
        if (!_showFilterPanel) _filterPanel = null;
        if (_showFilterPanel) _showLayoutPanel = false;
    }
    
    private void ToggleLayoutPanel()
    {
        _showLayoutPanel = !_showLayoutPanel;
        if (_showLayoutPanel)
        {
            _showFilterPanel = false;
            _filterPanel = null;
        }
    }

    private async Task ApplyFilters()
    {
        if (_disposed) return;
        _filteredServices = _allServices.Where(service =>
        {
            // Status filter
            if (!_selectedStatuses.Contains(service.OverallStatus))
                return false;
                
            // Domain filter
            var serviceDomain = GetServiceDomainName(service);
            if (!GetServiceDomainNames(service).Any(domain => _selectedDomains.Contains(domain, StringComparer.OrdinalIgnoreCase)))
                return false;
                
            // Text filter
            if (!string.IsNullOrWhiteSpace(_filterText))
            {
                var matchesText = service.AppName.Contains(_filterText, StringComparison.OrdinalIgnoreCase) ||
                                  service.AppId.Contains(_filterText, StringComparison.OrdinalIgnoreCase) ||
                                  (!string.IsNullOrEmpty(service.ProjectName) && service.ProjectName.Contains(_filterText, StringComparison.OrdinalIgnoreCase)) ||
                                  serviceDomain.Contains(_filterText, StringComparison.OrdinalIgnoreCase);
                
                if (!matchesText)
                    return false;
            }
            
            // Instance filter
            if (_showOnlyWithInstances && service.TotalInstanceCount == 0)
                return false;
            
            // Keep compatibility with the legacy offline-service filter
            if (!_showOfflineServices && service.OverallStatus == ServiceStatus.Offline)
                return false;
            
            return true;
        }).ToList();
        
        await UpdateGraph();
    }

    private async Task UpdateGraph()
    {
        await InvokeGraphAsync("updateGraph", PrepareGraphData(), GetLayoutName(_currentLayout), _forceDistance, _forceStrength);
    }
    
    private async Task SetLayout(ServiceLayoutType layoutType)
    {
        _currentLayout = layoutType;
        await InvokeGraphAsync("setLayout", GetLayoutName(layoutType));
    }

    private static string GetLayoutName(ServiceLayoutType layoutType) => layoutType switch
        {
            ServiceLayoutType.Force => "force",
            ServiceLayoutType.Hierarchy => "hierarchy",
            ServiceLayoutType.Circular => "circular",
            ServiceLayoutType.Grid => "grid",
            _ => "force"
        };

    private void OnDomainSelectionIntentChanged(bool selectAll) => _allDomainsSelected = selectAll;
    
    private Task OnLayoutChanged(ServiceLayoutType layoutType) => SetLayout(layoutType);
    
    private async Task OnForceDistanceChanged(int value)
    {
        _forceDistance = value;
        await InvokeGraphAsync("setForceDistance", value);
    }
    
    private async Task OnForceStrengthChanged(int value)
    {
        _forceStrength = value;
        await InvokeGraphAsync("setForceStrength", value);
    }

    private object PrepareGraphData()
    {
        var nodes = _filteredServices.Select(service => new
        {
            id = service.AppId,
            name = service.AppName,
            domain = GetServiceDomainName(service),
            project = service.ProjectName,
            status = service.OverallStatus.ToString(),
            runningInstances = service.RunningInstanceCount,
            totalInstances = service.TotalInstanceCount,
            colorRole = DomainColorResolver.GetDomainColorRole(GetServiceDomainName(service)),
            version = service.GetValidInstanceInfo()?.AssemblyVersion
        }).ToList();

        // Do not build inter-service dependencies yet, because the current model does not contain this information.
        var links = new List<object>();

        return new { nodes, links };
    }

    [JSInvokable]
    public async Task OnNodeClick(string nodeId)
    {
        if (_disposed)
        {
            return;
        }

        var service = _allServices.FirstOrDefault(s => string.Equals(s.AppId, nodeId, StringComparison.OrdinalIgnoreCase));
        if (service != null && OnServiceClick.HasDelegate)
        {
            await OnServiceClick.InvokeAsync(service);
        }
    }
    
    [JSInvokable]
    public void OnNodeRightClick(string nodeId, double x, double y)
    {
        if (_disposed)
        {
            return;
        }

        _contextMenuService = _allServices.FirstOrDefault(s => string.Equals(s.AppId, nodeId, StringComparison.OrdinalIgnoreCase));
        if (_contextMenuService != null)
        {
            _contextMenuX = x;
            _contextMenuY = y;
            _contextMenuItems = BuildContextMenuItems(_contextMenuService);
            ++_contextMenuOpeningRevision;
            _contextMenuOpen = true;
            StateHasChanged();
        }
    }
    
    private void OnBackgroundClick()
    {
        if (_contextMenuOpen)
        {
            _contextMenuOpen = false;
            StateHasChanged();
        }
    }
    
    [JSInvokable]
    public void OnSvgBackgroundClick()
    {
        if (_disposed)
        {
            return;
        }

        if (_contextMenuOpen)
        {
            _contextMenuOpen = false;
            StateHasChanged();
        }
    }
    
    private void CloseContextMenu()
    {
        if (_disposed) return;
        _contextMenuOpen = false;
    }
    
    private List<ContextMenuItem<RegisteredServiceStatus>> BuildContextMenuItems(RegisteredServiceStatus service)
    {
        var builder = ContextMenuBuilder<RegisteredServiceStatus>.Create()
            .AddItem(L["ServiceGraph:ContextMenu:ViewServiceDetails"].Value, MoIcons.Info, ViewServiceDetailsAsync)
            .AddItem(L["ServiceGraph:ContextMenu:FocusService"].Value, MoIcons.Focus, FocusOnServiceAsync)
            .AddDivider()
            .AddItem(L["ServiceGraph:ContextMenu:FilterSameStatus"].Value, MoIcons.Filter, FilterByStatusAsync)
            .AddItem(L["ServiceGraph:ContextMenu:FilterSameDomain"].Value, MoIcons.Building, FilterByDomainAsync)
            .AddItemIf(!string.IsNullOrEmpty(service.ProjectName), L["ServiceGraph:ContextMenu:FilterSameProject"].Value, MoIcons.Folder, FilterByProjectAsync)
            .AddItem(L["ServiceGraph:ContextMenu:ClearFilters"].Value, MoIcons.ClearList, ClearAllFiltersAsync)
            .AddDivider()
            .AddItem(L["ServiceGraph:ContextMenu:CopyServiceId"].Value, MoIcons.Copy, CopyServiceIdAsync)
            .AddItem(L["ServiceGraph:ContextMenu:CopyServiceName"].Value, MoIcons.Copy, CopyServiceNameAsync);
        
        return builder.Build();
    }
    
    private Task OnContextMenuItemClick(ContextMenuItem<RegisteredServiceStatus> item)
    {
        if (_disposed) return Task.CompletedTask;
        _contextMenuOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }
    
    private async Task ViewServiceDetailsAsync(RegisteredServiceStatus? service)
    {
        if (!_disposed && service != null && OnServiceClick.HasDelegate)
        {
            await OnServiceClick.InvokeAsync(service);
        }
    }
    
    private async Task FocusOnServiceAsync(RegisteredServiceStatus? service)
    {
        if (service != null)
        {
            await InvokeGraphAsync("focusOnNode", service.AppId);
        }
    }
    
    private async Task FilterByStatusAsync(RegisteredServiceStatus? service)
    {
        if (!_disposed && service != null)
        {
            _selectedStatuses = new HashSet<ServiceStatus> { service.OverallStatus };
            _showFilterPanel = true;
            await ApplyFilters();
            if (!_disposed) Snackbar.Add(L["ServiceGraph:Messages:FilteredStatus", service.OverallStatus.GetText(L)].Value, Severity.Info);
        }
    }
    
    private async Task FilterByDomainAsync(RegisteredServiceStatus? service)
    {
        if (!_disposed && service != null)
        {
            var domainName = GetServiceDomainName(service);
            _allDomainsSelected = false;
            _selectedDomains = GetServiceDomainNames(service).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _showFilterPanel = true;
            await ApplyFilters();
            if (!_disposed) Snackbar.Add(L["ServiceGraph:Messages:FilteredDomain", domainName].Value, Severity.Info);
        }
    }
    
    private async Task FilterByProjectAsync(RegisteredServiceStatus? service)
    {
        if (!_disposed && service != null && !string.IsNullOrEmpty(service.ProjectName))
        {
            _filterText = service.ProjectName;
            _showFilterPanel = true;
            await SynchronizeSearchAndApplyFiltersAsync();
            if (!_disposed) Snackbar.Add(L["ServiceGraph:Messages:FilteredProject", service.ProjectName].Value, Severity.Info);
        }
    }
    
    private async Task ClearAllFiltersAsync(RegisteredServiceStatus? service)
    {
        if (_disposed) return;
        _filterText = string.Empty;
        _allDomainsSelected = true;
        _selectedStatuses = new HashSet<ServiceStatus>(Enum.GetValues<ServiceStatus>());
        var allDomains = _allServices.SelectMany(GetServiceDomainNames).Distinct().ToList();
        _selectedDomains = new HashSet<string>(allDomains);
        _showOnlyWithInstances = false;
        await SynchronizeSearchAndApplyFiltersAsync();
        if (!_disposed) Snackbar.Add(L["ServiceGraph:Messages:ClearedFilters"].Value, Severity.Info);
    }

    private async Task SynchronizeSearchAndApplyFiltersAsync()
    {
        if (_disposed) return;
        if (_showFilterPanel && _filterPanel is not null)
            await _filterPanel.SetSearchAsync(_filterText);
        else
            await ApplyFilters();
    }
    
    private async Task CopyServiceIdAsync(RegisteredServiceStatus? service)
    {
        if (service != null)
        {
            if (await CopyToClipboardAsync(service.AppId))
                Snackbar.Add(L["ServiceGraph:Messages:CopiedServiceId"].Value, Severity.Success);
        }
    }
    
    private async Task CopyServiceNameAsync(RegisteredServiceStatus? service)
    {
        if (service != null)
        {
            if (await CopyToClipboardAsync(service.AppName))
                Snackbar.Add(L["ServiceGraph:Messages:CopiedServiceName"].Value, Severity.Success);
        }
    }

    private string GetServiceDomainName(RegisteredServiceStatus service)
        => string.Join(", ", GetServiceDomainNames(service));

    private IEnumerable<string> GetServiceDomainNames(RegisteredServiceStatus service)
        => service.GetDomainNames().DefaultIfEmpty(L["Shared:Values:Unknown"].Value);

    private object GetGraphTexts() => new
    {
        labels = new
        {
            appId = L["ServiceGraph:Graph:Labels:AppId"].Value,
            domain = L["ServiceGraph:Graph:Labels:Domain"].Value,
            project = L["ServiceGraph:Graph:Labels:Project"].Value,
            status = L["ServiceGraph:Graph:Labels:Status"].Value,
            instances = L["ServiceGraph:Graph:Labels:Instances"].Value,
            version = L["ServiceGraph:Graph:Labels:Version"].Value,
            notAvailable = L["Shared:Values:NotAvailable"].Value,
            unknown = L["Shared:Values:Unknown"].Value
        },
        statuses = new
        {
            running = L["Shared:ServiceStatuses:Running"].Value,
            updating = L["Shared:ServiceStatuses:Updating"].Value,
            offline = L["Shared:ServiceStatuses:Offline"].Value,
            error = L["Shared:ServiceStatuses:Error"].Value,
            unhealthy = L["Shared:ServiceStatuses:Unhealthy"].Value,
            unknown = L["Shared:ServiceStatuses:Unknown"].Value
        }
    };

    private async Task ResetView()
    {
        await InvokeGraphAsync("resetView");
    }

    public ValueTask DisposeAsync()
    {
        lock (_disposeSync)
        {
            return new ValueTask(_disposeTask ??= DisposeCoreAsync());
        }
    }

    private async Task DisposeCoreAsync()
    {
        _disposed = true;
        await _lifetimeCancellation.CancelAsync();

        // Providers can finish work that does not accept cancellation. Wait for the actual read and its
        // continuation to settle before releasing resources owned by this retired component.
        await _captureGate.WaitAsync();
        _captureGate.Release();

        await _interopGate.WaitAsync();
        try
        {
            var graphController = Interlocked.Exchange(ref _graphController, null);
            var dotNetReference = Interlocked.Exchange(ref _dotNetReference, null);

            await DisposeGraphControllerAsync(graphController);
            dotNetReference?.Dispose();
        }
        finally
        {
            _interopGate.Release();
        }

        // A caller may have observed the pre-disposal state immediately before teardown began and still be
        // approaching the gate. Keep these lightweight primitives alive so cancellation settles that admission
        // race without turning an expected lifetime transition into ObjectDisposedException.
    }

    private async Task InvokeGraphAsync(string identifier, params object?[] arguments)
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await _interopGate.WaitAsync(_lifetimeCancellation.Token);
            try
            {
                if (!_disposed && _graphController is not null)
                {
                    await _graphController.InvokeVoidAsync(identifier, _lifetimeCancellation.Token, arguments);
                }
            }
            finally
            {
                _interopGate.Release();
            }
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
        catch (JSException)
        {
            if (!_disposed)
            {
                _graphAvailable = false;
                _graphError = L["Atlas:Shared:GraphUnavailable"].Value;
                StateHasChanged();
            }
        }
    }

    private async Task<bool> CopyToClipboardAsync(string value)
    {
        if (_disposed)
        {
            return false;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync(
                "navigator.clipboard.writeText",
                _lifetimeCancellation.Token,
                value);
            return !_disposed;
        }
        catch (OperationCanceledException) when (_disposed)
        {
        }
        catch (JSDisconnectedException) when (_disposed)
        {
        }
        catch (JSException)
        {
            if (!_disposed) Snackbar.Add(L["Atlas:Shared:ClipboardFailed"].Value, Severity.Error);
        }
        return false;
    }

    private static async ValueTask DisposeGraphControllerAsync(IJSObjectReference? graphController)
    {
        if (graphController is null)
        {
            return;
        }

        try
        {
            await graphController.InvokeVoidAsync("dispose");
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }

        try
        {
            await graphController.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    private static async ValueTask ReleaseModuleReferenceAsync(IJSObjectReference? module)
    {
        if (module is null)
        {
            return;
        }

        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }
}
