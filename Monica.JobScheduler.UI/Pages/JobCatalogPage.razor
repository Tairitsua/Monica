@attribute [Route(PAGE_URL)]
@using Monica.JobScheduler.UI.Localization
@inject IStringLocalizer<JobSchedulerResource> L

<PageTitle>@L["Catalog:PageTitle"]</PageTitle>
<SchedulerWorkspace Title="@L["Workspace:Pages:Catalog:Title"]"
                    Description="@L["Workspace:Pages:Catalog:Description"]"
                    ActivePanelIndex="1">
    <JobCatalogContent Present="@Present" Owner="@Owner" InitialType="@Type" InitialDisabled="@Disabled" InitialSearch="@Search" InitialStanding="@Standing" InitialCadence="@Cadence" InitialSort="@Sort" InitialInstanceId="@InstanceId" />
</SchedulerWorkspace>

@code {
    /// <summary>Gets the route-held operational standing, cadence and inventory ordering.</summary>
    [SupplyParameterFromQuery(Name = "standing")] public string? Standing { get; set; }
    /// <summary>Gets the schedule cadence filter selected in the composition map.</summary>
    [SupplyParameterFromQuery(Name = "cadence")] public string? Cadence { get; set; }
    /// <summary>Gets attention, name, owner or next-occurrence ordering.</summary>
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    public const string PAGE_URL = "/job-scheduler/catalog";

    /// <summary>
    /// Gets or sets the presence deep-link filter. Present definitions are the default;
    /// false initially selects absent definitions of every job type.
    /// Changing either query identity retires the previous catalog and its native dialogs.
    /// </summary>
    [SupplyParameterFromQuery(Name = "present")]
    public bool? Present { get; set; }

    /// <summary>
    /// Gets or sets the exact, opaque owner deep-link filter. Nonblank values are never trimmed.
    /// </summary>
    [SupplyParameterFromQuery(Name = "owner")]
    public string? Owner { get; set; }

    /// <summary>Gets the route-held recurring or triggered type selection.</summary>
    [SupplyParameterFromQuery(Name = "type")] public string? Type { get; set; }
    /// <summary>Gets the route-held effective disabled-policy filter.</summary>
    [SupplyParameterFromQuery(Name = "paused")] public bool? Disabled { get; set; }
    /// <summary>Gets the route-held definition name or key search.</summary>
    [SupplyParameterFromQuery(Name = "q")] public string? Search { get; set; }
    /// <summary>Gets the route-owned execution drawer selection without replacing the catalog's filters or batch selection.</summary>
    [SupplyParameterFromQuery(Name = "instanceId")] public string? InstanceId { get; set; }
}
