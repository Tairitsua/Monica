@inject IStringLocalizer<RepositoryUIResource> L
@using static Monica.Repository.UI.UIRepository.Support.RepositoryPresentation

<div class="rp-ctx-strip mo-vl-surface">
    <div class="rp-ctx-strip-id">
        <span id="@_labelId" class="rp-ctx-label">@Label</span>
        <div class="rp-ctx-select-row">
            <RepositorySelect Value="@Context.Registration.ContextId" ValueChanged="Workbench.Select"
                              Label="@Label" LabelId="@_labelId" Options="@Workbench.State.Contexts.ToDictionary(item => item.Registration.ContextId, Option)" />
            <span class="rp-ctx-meta mono">
                <span>@(Context.Connection?.DataSource ?? L["Persistence:Unavailable"].Value)</span>
                <i aria-hidden="true"></i>
                <span>@(Context.Connection?.Database ?? L["Persistence:Unavailable"].Value)</span>
            </span>
        </div>
        @if (Note is not null) { <p class="rp-ctx-note">@Note</p> }
    </div>
    @if (ChildContent is not null) { <div class="rp-ctx-strip-end">@ChildContent</div> }
</div>

@code {
    [Parameter, EditorRequired] public RepositoryWorkbench Workbench { get; set; } = null!;
    [Parameter, EditorRequired] public RepositoryDbContextSnapshot Context { get; set; } = null!;
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Note { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly string _labelId = $"rp-context-source-{Guid.NewGuid():N}";

    private string Option(RepositoryDbContextSnapshot context)
    {
        var standing = Standing(context);
        var name = $"{context.Registration.DbContextName} · {context.Connection?.Database ?? L["Persistence:Unavailable"].Value} ({context.Registration.AssemblyName})";
        return standing == "healthy" ? name : $"{name} [{L[$"Persistence:Standing:{standing}"]}]";
    }
}
