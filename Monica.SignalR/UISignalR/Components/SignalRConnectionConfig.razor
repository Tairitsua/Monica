@using Monica.UI.Shared.Components.States
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using System.Globalization
@using Monica.SignalR.Models
@inject IStringLocalizer<SignalRResource> L

<section class="signalr-connection-config" aria-labelledby="@_headingId" aria-busy="@(IsLoading ? "true" : "false")">
    <MudPaper Square="true" Elevation="0" Class="connection-config-surface">
        <header class="connection-config-heading">
            <span class="connection-config-icon" aria-hidden="true"><MoIcon Icon="@MoIcons.Cable" Size="1.5rem" /></span>
            <div>
                <h2 id="@_headingId">@L["UISignalR:ConnectionConfig:Title"]</h2>
                <p>@L["UISignalR:ConnectionConfig:Intro"]</p>
            </div>
        </header>

        <div class="connection-config-body">
            @if (LoadFailed)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Icon="@MoIcons.Warning">@L[DataLoaded ? "UISignalR:ConnectionConfig:LoadFailedRetained" : "UISignalR:ConnectionConfig:LoadFailed"]</MudAlert>
            }
            @if (IsLoading)
            {
                @if (!DataLoaded)
            {
                <MoContentState Loading="true" Compact="true"><MudProgressCircular Size="Size.Small" Indeterminate="true" /><span>@L["UISignalR:ConnectionConfig:Loading"]</span></MoContentState>
            }
            else
            {
                <div class="connection-config-loading" role="status"><MudProgressCircular Size="Size.Small" Indeterminate="true" /><span>@L["UISignalR:ConnectionConfig:Loading"]</span></div>
            }
            }
            else if (!DataLoaded && !LoadFailed)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Icon="@MoIcons.Info">@L["UISignalR:ConnectionConfig:NotLoaded"]</MudAlert>
            }
            else if (DataLoaded && AvailableHubs.Count == 0 && !LoadFailed)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Icon="@MoIcons.Info">@L["UISignalR:ConnectionConfig:NoHubs"]</MudAlert>
            }

            <div class="connection-config-fields">
                <MudSelect T="string" Value="@SelectedHubRoute" ValueChanged="ChangeSelectedRouteAsync"
                           Label="@L[IsConnected ? "UISignalR:ConnectionConfig:DraftHubLabel" : "UISignalR:ConnectionConfig:HubUrlLabel"]"
                           HelperText="@L[IsConnected ? "UISignalR:ConnectionConfig:DraftHubHelper" : "UISignalR:ConnectionConfig:HubUrlHelper"]"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(IsConnecting || IsLoading || !DataLoaded || AvailableHubs.Count == 0)" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                    @foreach (var hub in AvailableHubs)
                    {
                        <MudSelectItem Value="@hub.Route">@hub.HubName (@hub.Route)</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" Value="@AccessToken" ValueChanged="ChangeAccessTokenAsync" Immediate="true"
                              Label="@L["UISignalR:ConnectionConfig:AccessTokenLabel"]"
                              HelperText="@L["UISignalR:ConnectionConfig:AccessTokenHelper"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="connection-token-field" Disabled="IsConnecting" />
            </div>

            <div class="connection-config-primary-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConnectAsync" Disabled="@ConnectionActionsDisabled" Class="connection-config-action">
                    @if (IsConnecting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span>@L["UISignalR:ConnectionConfig:Connecting"]</span>
                    }
                    else
                    {
                        <MoIcon Icon="@MoIcons.Cable" Size="1.25rem" />
                        <span>@L[IsConnected ? "UISignalR:ConnectionConfig:Reconnect" : "UISignalR:ConnectionConfig:Connect"]</span>
                    }
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@MoIcons.Unplug"
                           OnClick="DisconnectAsync" Disabled="@(!IsConnected || IsConnecting)" Class="connection-config-action">
                    @L["UISignalR:ConnectionConfig:Disconnect"]
                </MudButton>
            </div>

            <div class="connection-config-test-user">
                @if (CanGenerateTestToken)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.Flask"
                               OnClick="TestUserConnectAsync" Disabled="@ConnectionActionsDisabled" Class="connection-config-action">
                        @L["UISignalR:ConnectionConfig:TestUserConnect"]
                    </MudButton>
                    <p>@L["UISignalR:ConnectionConfig:TestUserConnectHelper"]</p>
                }
                else
                {
                    <p>@L["UISignalR:ConnectionConfig:TestUserUnavailable"]</p>
                }
            </div>
        </div>

        <footer class="connection-config-footer">
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@MoIcons.Refresh"
                       OnClick="RefreshHubsAsync" Disabled="@(IsLoading || IsConnecting)">@L["UISignalR:ConnectionConfig:RefreshHubInfo"]</MudButton>
            @if (CapturedAtUtc is { } capturedAt)
            {
                <span>@L["UISignalR:ConnectionConfig:CapturedAt", FormatUtc(capturedAt)]</span>
            }
        </footer>
    </MudPaper>
</section>

@code {
    /// <summary>Gets or sets the visible, copyable access token used for the next browser connection.</summary>
    [Parameter] public string AccessToken { get; set; } = string.Empty;

    /// <summary>Gets or sets the awaited callback for access-token edits.</summary>
    [Parameter] public EventCallback<string> AccessTokenChanged { get; set; }

    /// <summary>Gets or sets the draft hub route used by the next connect or reconnect action.</summary>
    [Parameter] public string SelectedHubRoute { get; set; } = string.Empty;

    /// <summary>Gets or sets the awaited callback for draft route edits.</summary>
    [Parameter] public EventCallback<string> SelectedHubRouteChanged { get; set; }

    /// <summary>Gets or sets mapped hub metadata from the host's current captured catalog.</summary>
    [Parameter] public List<SignalRHubInfo> AvailableHubs { get; set; } = [];

    /// <summary>Gets or sets whether a browser connection attempt is in progress.</summary>
    [Parameter] public bool IsConnecting { get; set; }

    /// <summary>Gets or sets whether the browser currently reports an established connection.</summary>
    [Parameter] public bool IsConnected { get; set; }

    /// <summary>Gets or sets whether the host currently permits native test-user token generation.</summary>
    [Parameter] public bool CanGenerateTestToken { get; set; }

    /// <summary>Gets or sets whether a hub catalog has been captured. Defaults to true for existing consumers.</summary>
    [Parameter] public bool DataLoaded { get; set; } = true;

    /// <summary>Gets or sets whether the owning state is loading hub metadata.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Gets or sets whether the latest hub metadata read failed.</summary>
    [Parameter] public bool LoadFailed { get; set; }

    /// <summary>Gets or sets the UTC time of the latest successful hub metadata capture.</summary>
    [Parameter] public DateTime? CapturedAtUtc { get; set; }

    /// <summary>Gets or sets the awaited callback for connecting with the current draft.</summary>
    [Parameter] public EventCallback OnConnect { get; set; }

    /// <summary>Gets or sets the callback that generates a test-user token and connects with it.</summary>
    [Parameter] public EventCallback OnTestUserConnect { get; set; }

    /// <summary>Gets or sets the awaited callback for disconnecting the browser.</summary>
    [Parameter] public EventCallback OnDisconnect { get; set; }

    /// <summary>Gets or sets the awaited callback for refreshing mapped hub metadata.</summary>
    [Parameter] public EventCallback OnRefreshHubs { get; set; }

    private readonly string _headingId = $"signalr-connection-config-{Guid.NewGuid():N}";
    private bool ConnectionActionsDisabled => IsConnecting || IsLoading || !DataLoaded || AvailableHubs.Count == 0 || string.IsNullOrWhiteSpace(SelectedHubRoute);

    private Task ConnectAsync() => OnConnect.InvokeAsync();
    private Task TestUserConnectAsync() => OnTestUserConnect.InvokeAsync();
    private Task DisconnectAsync() => OnDisconnect.InvokeAsync();
    private Task RefreshHubsAsync() => OnRefreshHubs.InvokeAsync();

    private async Task ChangeAccessTokenAsync(string value)
    {
        AccessToken = value;
        await AccessTokenChanged.InvokeAsync(value);
    }

    private async Task ChangeSelectedRouteAsync(string value)
    {
        SelectedHubRoute = value;
        await SelectedHubRouteChanged.InvokeAsync(value);
    }

    private string FormatUtc(DateTime value) => UiTime.Format(value);
}
