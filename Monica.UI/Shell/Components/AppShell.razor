@using System.Globalization
@using System.Reflection
@using Microsoft.Extensions.Options
@using Monica.Modules
@inject IOptions<ModuleUIOption> Options

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />  
    @* <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" /> *@
    <link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet" />
    @* <link href="_content/MudBlazor/MudBlazor.min.css?v=@(Metadata.Version)" rel="stylesheet" /> *@

    @if(Options.Value.EnableMarkdown)
    {
        <link href=@Assets["_content/MudBlazor.Markdown/MudBlazor.Markdown.min.css"] rel="stylesheet" />
    }
    
    <!-- Monica theme CSS -->    <link href=@Assets["_content/Monica.UI/css/mo-theme-main.css"] rel="stylesheet" />
    
	<!-- Big Pitfall: CSS isolation that supports consumer applications is eventually packaged into a bundle (can be obtained through YourProject.staticwebassets.runtime.json in the compilation directory), so it must be obtained according to the entry assembly name -->    <link href="@(Assembly.GetEntryAssembly()?.GetName().Name).styles.css" rel="stylesheet" />
  
    <link rel="icon" type="image/ico" href="@Assets["_content/Monica.UI/favicon.ico"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <!-- D3.js for data visualization -->
    <script src=@Assets["_content/Monica.UI/lib/d3.min.js"]></script>
</head>

<body>
    <AppRouter @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src=@Assets["_content/MudBlazor/MudBlazor.min.js"]></script>
    <script src=@Assets["_content/Monica.UI/js/mo-clipboard.js"]></script>
    @* <script src="_content/MudBlazor/MudBlazor.min.js?v=@Metadata.Version"></script> *@
    @if(Options.Value.EnableMarkdown)
    {
        <script src=@Assets["_content/MudBlazor.Markdown/MudBlazor.Markdown.min.js"]></script>
    }
</body>

</html>
