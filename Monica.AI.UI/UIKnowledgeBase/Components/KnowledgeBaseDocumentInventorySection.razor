@using Microsoft.Extensions.Localization
@using Monica.AI.KnowledgeBase.Models
@using Monica.AI.UI.Localization
@using Monica.AI.UI.UIKnowledgeBase.State
@inject IStringLocalizer<AIResource> L

<section class="inventory-surface">
    <header class="inventory-heading">
        <h3>@L["KnowledgeBase:Documents:Title"]</h3>
        <div class="inventory-search"><MudTextField T="string" @bind-Value="_search" Immediate="true" Placeholder="@L["KnowledgeWorkbench:SearchDocuments"]" aria-label="@L["KnowledgeWorkbench:SearchDocuments"]" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" /></div>
        <div class="inventory-actions"><MudMenu Icon="@MoIcons.MoreHorizontal" AriaLabel="@L["KnowledgeWorkbench:DocumentActions"]"><MudMenuItem Icon="@MoIcons.ClearList" IconColor="Color.Error" OnClick="PageState.ClearKnowledgeBaseDocumentsAsync" Disabled="@(!PageState.CanClearKnowledgeBaseDocuments)">@L["RAG:DocumentQueue:Actions:ClearDocuments"]</MudMenuItem></MudMenu></div>
    </header>
    <div class="inventory-filters">
        <div class="status-filter-row"><div class="status-filters" role="group" aria-label="@L["RAG:DocumentQueue:Column:Status"]"><button type="button" aria-pressed="@((_status is null).ToString().ToLowerInvariant())" @onclick="() => _status = null">@L["KnowledgeWorkbench:AllDocuments"] <span>@PageState.DocumentInventory.Count</span></button>@foreach (var status in Enum.GetValues<DocumentStatus>()) { <button type="button" class="status-@status.ToString().ToLowerInvariant()" aria-pressed="@((_status == status).ToString().ToLowerInvariant())" @onclick="() => _status = status"><i></i>@PageState.GetDocumentStatusDisplay(status) <span>@PageState.DocumentInventory.Count(item => item.Status == status)</span></button> }</div><span class="inventory-count">@L["KnowledgeWorkbench:VisibleDocuments", VisibleItems.Count, PageState.DocumentInventory.Count]</span></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(PageState.InventoryErrorMessage))
    {
        <div class="inventory-message" role="alert"><MoContentState Compact="true"><p>@PageState.InventoryErrorMessage</p><MudButton OnClick="PageState.ReloadSelectedInventoryAsync">@L["KnowledgeWorkbench:Retry"]</MudButton></MoContentState></div>
    }
    else
    {
        <div class="inventory-table-frame">
            <MudTable T="DocumentQueueItem" Items="VisibleItems" Dense="false" Hover="true" Square="true" Elevation="0" RowsPerPage="10" Breakpoint="Breakpoint.Sm" Class="document-inventory-table">
                <HeaderContent><MudTh>@L["RAG:DocumentQueue:Column:Name"]</MudTh><MudTh>@L["KnowledgeBase:Documents:Column:Source"]</MudTh><MudTh>@L["RAG:DocumentQueue:Column:Status"]</MudTh><MudTh>@L["RAG:DocumentQueue:Column:Chunks"]</MudTh><MudTh>@L["RAG:DocumentQueue:Column:Actions"]</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["RAG:DocumentQueue:Column:Name"]"><div class="document-name-cell"><strong>@context.Name</strong>@if (context.Name != context.Id) { <code>@context.Id</code> }</div></MudTd>
                    <MudTd DataLabel="@L["KnowledgeBase:Documents:Column:Source"]"><span class="source-kind">@PageState.GetSourceKindDisplay(context)</span></MudTd>
                    <MudTd DataLabel="@L["RAG:DocumentQueue:Column:Status"]"><span class="document-status status-@context.Status.ToString().ToLowerInvariant()"><i></i>@PageState.GetDocumentStatusDisplay(context.Status)</span></MudTd>
                    <MudTd DataLabel="@L["RAG:DocumentQueue:Column:Chunks"]"><span class="chunk-count">@context.ChunkCount</span></MudTd>
                    <MudTd DataLabel="@L["RAG:DocumentQueue:Column:Actions"]"><div class="row-actions"><MudIconButton Icon="@MoIcons.Eye" Size="Size.Small" OnClick="() => PageState.ShowDocumentPreviewAsync(context)" aria-label="@L["KnowledgeBase:Documents:Actions:Preview"]" /><MudIconButton Icon="@MoIcons.Delete" Size="Size.Small" Color="Color.Error" Disabled="@(context.Status == DocumentStatus.Indexing)" OnClick="() => PageState.DeleteDocumentAsync(context)" aria-label="@L["RAG:DocumentQueue:Actions:Delete"]" />@if (context.Status == DocumentStatus.Error && !string.IsNullOrWhiteSpace(context.ErrorMessage)) { <MudIconButton Icon="@MoIcons.Error" Size="Size.Small" Color="Color.Error" OnClick="() => PageState.ShowIndexingErrorAsync(context)" aria-label="@L["Common:Error"]" /> }</div></MudTd>
                </RowTemplate>
                <NoRecordsContent><div class="inventory-message"><MoContentState Compact="true"><p>@(PageState.DocumentInventory.Count == 0 ? L["KnowledgeWorkbench:NoDocuments"] : L["KnowledgeWorkbench:NoDocumentsMatch"])</p>@if (PageState.DocumentInventory.Count > 0) { <MudButton OnClick="ClearFilters">@L["KnowledgeWorkbench:ClearFilters"]</MudButton> }</MoContentState></div></NoRecordsContent>
                <PagerContent><MudTablePager FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" PageSizeOptions="@(new[] { 10, 25, 50 })" /></PagerContent>
            </MudTable>
        </div>
    }
</section>
@code {
    /// <summary>Gets or sets the page-owned inventory state; the component does not dispose it.</summary>
    [Parameter, EditorRequired] public required KnowledgeBaseManagePageState PageState { get; set; }
    private string _search = string.Empty;
    private DocumentStatus? _status;
    private IReadOnlyList<DocumentQueueItem> VisibleItems => PageState.DocumentInventory.Where(item => (_status is null || item.Status == _status) && (string.IsNullOrWhiteSpace(_search) || item.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) || item.Id.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();
    private void ClearFilters() { _search = string.Empty; _status = null; }
}
