{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReferenceUI": {
    "EnableDiagnostics": false
  },
  "Ordering": {
    "MaximumOrdersReturned": 100,
    "BacklogWarningThreshold": 10
  },
  "Application": {
    "AppId": "monica-ordering-reference"
  },
  "AllowedHosts": "*",
  "Deployment": {
    "Scope": "monica-reference-ordering",
    "Applications": {
      "monica-ordering-reference": {
        "AppName": "Monica Ordering Reference",
        "Roles": [
          "ordering",
          "ordering.reporting"
        ]
      }
    }
  }
}
