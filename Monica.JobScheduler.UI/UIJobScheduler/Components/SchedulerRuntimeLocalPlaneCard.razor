@using Monica.JobScheduler.Models.Operations
@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Support
@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation

<section class="runtime-plane" aria-labelledby="runtime-plane-heading">
    <header class="runtime-plane__heading">
        <MoIcon Icon="@MoIcons.HeartPulse" aria-hidden="true" Size="1.5rem" />
        <div>
            <h2 id="runtime-plane-heading">@L["Runtime:Plane:Title"]</h2>
            <p>@L["Runtime:Plane:Description"]</p>
        </div>
    </header>

    <div class="runtime-plane__decision" data-ready="@(Overview.LocalPlane.SchedulingReady && Overview.LocalPlane.WorkerReady)">
        <strong>@L[Overview.LocalPlane.SchedulingReady && Overview.LocalPlane.WorkerReady ? "Runtime:Plane:Ready" : "Runtime:Plane:NotReady"]</strong>
        <p>@L["Workspace:RuntimeFinding"]</p>
    </div>
    <div class="runtime-plane__channels">
        <section class="runtime-plane__channel" aria-labelledby="runtime-scheduling-heading">
            <header>
                <h3 id="runtime-scheduling-heading">@L["Runtime:Plane:Scheduling"]</h3>
                <span class="runtime-plane__state" data-ready="@Overview.LocalPlane.SchedulingReady.ToString().ToLowerInvariant()">
                    <MoIcon Icon="@(Overview.LocalPlane.SchedulingReady ? MoIcons.Success : MoIcons.Hourglass)" aria-hidden="true" Size="1.5rem" />
                    @if (Overview.LocalPlane.SchedulingReady)
                    {
                        <span>@L["Runtime:Plane:Ready"]</span>
                    }
                    else
                    {
                        <span>@L["Runtime:Plane:NotReady"]</span>
                    }
                </span>
            </header>
            <p class="runtime-plane__message">@(Overview.LocalPlane.SchedulingMessage ?? L["Runtime:Plane:NoMessage"])</p>
        </section>
        <section class="runtime-plane__channel" aria-labelledby="runtime-worker-heading">
            <header>
                <h3 id="runtime-worker-heading">@L["Runtime:Plane:Worker"]</h3>
                <span class="runtime-plane__state" data-ready="@Overview.LocalPlane.WorkerReady.ToString().ToLowerInvariant()">
                    <MoIcon Icon="@(Overview.LocalPlane.WorkerReady ? MoIcons.Success : MoIcons.Hourglass)" aria-hidden="true" Size="1.5rem" />
                    @if (Overview.LocalPlane.WorkerReady)
                    {
                        <span>@L["Runtime:Plane:Ready"]</span>
                    }
                    else
                    {
                        <span>@L["Runtime:Plane:NotReady"]</span>
                    }
                </span>
            </header>
            <p class="runtime-plane__message">@(Overview.LocalPlane.WorkerMessage ?? L["Runtime:Plane:NoMessage"])</p>
        </section>
    </div>

    <dl class="runtime-plane__capacity">
        <div>
            <dt>@L["Runtime:Plane:InFlight"]</dt>
            <dd>@Overview.LocalPlane.InFlightExecutions <span>/ @Overview.Configuration.MaxWorkerExecutionThreads</span></dd>
        </div>
    </dl>
    <dl class="runtime-plane__work">
        <div><dt>@L["Runtime:Plane:LastOwnerWork"]</dt><dd>@TimePresentation.FormatTimestamp(Overview.LocalPlane.LastOwnerSchedulingWorkAtUtc)</dd></div>
        <div><dt>@L["Runtime:Plane:LastRecoveryWork"]</dt><dd>@TimePresentation.FormatTimestamp(Overview.LocalPlane.LastLeaseRecoveryWorkAtUtc)</dd></div>
        <div><dt>@L["Runtime:Plane:LastCleanupWork"]</dt><dd>@TimePresentation.FormatTimestamp(Overview.LocalPlane.LastHistoryCleanupWorkAtUtc)</dd></div>
    </dl>
    <p>@L["Runtime:Plane:WorkTimeHelp"]</p>
    <footer class="runtime-plane__scope-note">
        <MoIcon Icon="@MoIcons.Info" aria-hidden="true" Size="1.5rem" />
        <p>@L["Runtime:Plane:LocalOnly"]</p>
    </footer>
</section>

@code {
    /// <summary>
    /// Gets or sets the captured serving-host cycle evidence and configured worker limit.
    /// </summary>
    /// <remarks>The caller owns authorization, refresh and retirement. This view never samples other replicas.</remarks>
    [Parameter, EditorRequired]
    public JobSchedulerRuntimeOverview Overview { get; set; } = null!;
}
