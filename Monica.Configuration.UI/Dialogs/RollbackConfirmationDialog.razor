@using Monica.Configuration.UI.Localization
@using Monica.UI.Shared.Components.Dialogs
@using Monica.UI.UIDiffHighlight.Models
@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L
@implements IAsyncDisposable

<MudDialog ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent><MoDialogHeading Text="@DialogTitle" /></TitleContent>
    <DialogContent>
        <div class="configuration-rollback-dialog">
            <section class="configuration-rollback-context">
                <MoIcon Icon="@MoIcons.Restore" Size="1.5rem" />
                <div>
                    <p>@RollbackWarning</p>
                    @if (_group is not null)
                    {
                        <strong>@_group.Label</strong>
                        <dl><div><dt>@L["History:Dialog:MutationGroup"]</dt><dd><code>@_group.GroupId</code></dd></div></dl>
                    }
                </div>
            </section>
            <div class="configuration-rollback-reason">
                <MudTextField T="string" @bind-Value="_reason" Label="@L["Group:Reason"]"
                              Variant="Variant.Outlined" Lines="2" Disabled="@_saving" />
            </div>
            @if (_loadingGroupRows || _loadingRollbackPreview)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_rollbackPreview is not null)
            {
                <section class="configuration-rollback-preview">
                    <header>
                        <h3>@L["Rollback:PreviewTitle"]</h3>
                        <div class="configuration-rollback-target-counts">
                            <span data-tone="primary"><MoIcon Icon="@MoIcons.Database" Size="1.25rem" />@L["History:Dialog:MonicaTargetCount", PreviewRows.Count(row => row.TargetKind == ConfigurationMutationTargetKind.MonicaEffectiveStore)]</span>
                            <span data-tone="warning"><MoIcon Icon="@MoIcons.FileText" Size="1.25rem" />@L["History:Dialog:ExternalTargetCount", PreviewRows.Count(row => row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)]</span>
                        </div>
                    </header>
                    <div class="configuration-rollback-identities">
                        @foreach (var row in PreviewRows)
                        {
                            <dl @key="row.HistoryId">
                                <div><dt>@L["History:Dialog:Definition"]</dt><dd><code>@row.DefinitionKey</code></dd></div>
                                <div><dt>@L["History:Dialog:LogicalPath"]</dt><dd><code>@row.LogicalPath.ToCanonicalString()</code></dd></div>
                                <div class="configuration-rollback-identity-wide"><dt>@L["History:Dialog:HistoryRecord"]</dt><dd><code>@row.HistoryId</code></dd></div>
                                @if (row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)
                                {
                                    <div class="configuration-rollback-identity-wide"><dt>@L["History:Dialog:SourcePhysicalPath"]</dt><dd><code>@ValueOrEmpty(row.SourcePhysicalPath)</code></dd></div>
                                    <div class="configuration-rollback-identity-wide"><dt>@L["History:Dialog:SourceConfigurationPath"]</dt><dd><code>@ValueOrEmpty(row.SourceConfigurationPath ?? row.ConfigurationPath)</code></dd></div>
                                }
                            </dl>
                        }
                    </div>
                    <ConfigurationHistoryDiffPreview Rows="@PreviewRows" IsRollbackPreview="true" ViewMode="EDiffViewMode.Split"
                                                     CurrentValuesByHistoryId="@_rollbackPreview.CurrentValuesByHistoryId"
                                                     PreviewIdentity="@_rollbackPreview.PlanToken" LoadingChanged="OnPreviewLoadingChanged" />
                </section>
                <section class="configuration-rollback-validation">
                    @foreach (var problem in _rollbackPreview.Problems)
                    {
                        <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Dense="true">@problem.Message</MudAlert>
                    }
                    @foreach (var report in _rollbackPreview.ValidationReports)
                    {
                        <ConfigurationValidationReportView Title="@report.DefinitionDisplayName"
                            Coverage="@report.Coverage" Scope="@report.Scope" ValidationRevision="@report.ValidationRevision"
                            Target="@report.Target" HasEffectiveChange="@report.HasEffectiveChange"
                            IsValid="@report.IsValid" IsSchemaValid="@report.IsSchemaValid"
                            Issues="@report.Issues.Select(ConfigurationValidationPresentation.FromCandidate).ToArray()" />
                    }
                </section>
            }
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_error</MudAlert>
            }
            @if (_saving)
            {
                <MudProgressLinear Indeterminate="true" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="configuration-rollback-actions">
            <MudButton OnClick="Cancel" Disabled="@_saving">@L["Common:Actions:Cancel"]</MudButton>
            <MudButton OnClick="RefreshPreviewAsync" Disabled="@(_saving || _loadingGroupRows || _loadingRollbackPreview)">@L["Validation:PreviewRefresh"]</MudButton>
            <MudButton Color="Color.Default" Variant="Variant.Filled" StartIcon="@MoIcons.Restore"
                       Class="configuration-rollback-confirm" OnClick="RollbackAsync" Disabled="@(!CanRollback)" aria-label="@L["Rollback:Confirm"]">
                @L["Rollback:Confirm"]
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    /// <summary>Gets an optional exact history row to roll back.</summary>
    [Parameter] public ConfigurationValueHistory? HistoryRow { get; set; }
    /// <summary>Gets an optional persisted group to roll back in its authoritative reverse order.</summary>
    [Parameter] public ConfigurationMutationGroup? Group { get; set; }
    /// <summary>Gets captured selected history rows, or rows already loaded for the supplied group.</summary>
    [Parameter] public IReadOnlyList<ConfigurationValueHistory> GroupRows { get; set; } = [];

    private readonly ConfigurationOperationLifetime _operations = new();
    private ConfigurationValueHistory? _historyRow;
    private ConfigurationMutationGroup? _group;
    private IReadOnlyList<ConfigurationValueHistory> _groupRows = [];
    private IReadOnlyList<ConfigurationValueHistory> _loadedGroupRows = [];
    private string? _reason;
    private string? _error;
    private bool _saving;
    private bool _loadingGroupRows;
    private bool _loadingRollbackPreview;
    private bool _loadingDiffPreview = true;
    private long _previewGeneration;
    private ConfigurationHistoryRollbackPreview? _rollbackPreview;

    private bool IsGroupRollback => _group is not null;
    private bool IsBatchRollback => _group is null && _historyRow is null && PreviewRows.Count > 1;
    private string DialogTitle => IsGroupRollback ? L["Rollback:GroupTitle"] : IsBatchRollback ? L["Rollback:SelectionTitle"] : L["Rollback:SingleTitle"];
    private string RollbackWarning => IsGroupRollback ? L["Rollback:GroupWarning"] : IsBatchRollback ? L["Rollback:SelectionWarning"] : L["Rollback:SingleWarning"];
    private IReadOnlyList<ConfigurationValueHistory> PreviewRows => _historyRow is not null ? [_historyRow] : _groupRows.Count > 0 ? _groupRows : _loadedGroupRows;
    private bool CanRollback => !_operations.IsRetired && !_saving && !_loadingGroupRows && !_loadingRollbackPreview
        && !_loadingDiffPreview && _rollbackPreview?.CanApply == true && PreviewRows.Count > 0;
    private string ValueOrEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? L["Common:States:Empty"] : value;

    protected override async Task OnInitializedAsync()
    {
        _historyRow = HistoryRow;
        _group = Group is null ? null : Group with { DefinitionKeys = Group.DefinitionKeys.ToArray() };
        _groupRows = GroupRows.ToArray();
        try
        {
            await _operations.RunAsync(async token =>
            {
                if (_group is not null && _groupRows.Count == 0)
                {
                    _loadingGroupRows = true;
                    try
                    {
                        var result = await Facade.GetGroupHistoryAsync(_group.GroupId);
                        token.ThrowIfCancellationRequested();
                        _operations.TryApply(() =>
                        {
                            var error = result;
                            var rows = result.Data;
                            if (result.IsFailure() || rows is null) _error = error.Message ?? L["Common:Errors:LoadFailed"].Value;
                            else _loadedGroupRows = rows.ToArray();
                        });
                    }
                    finally { _operations.TryApply(() => _loadingGroupRows = false); }
                }
                token.ThrowIfCancellationRequested();
                if (string.IsNullOrWhiteSpace(_error)) await LoadRollbackPreviewCoreAsync(token);
            });
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
        catch (Exception exception) when (!_operations.IsRetired) { _error = exception.Message; }
    }

    private async Task RefreshPreviewAsync()
    {
        if (_operations.IsRetired || _saving || _loadingGroupRows || _loadingRollbackPreview) return;
        try { await _operations.RunAsync(token => LoadRollbackPreviewCoreAsync(token)); }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
        catch (Exception exception) when (!_operations.IsRetired) { _error = exception.Message; }
    }

    private async Task LoadRollbackPreviewCoreAsync(CancellationToken token, bool preserveError = false)
    {
        token.ThrowIfCancellationRequested();
        var generation = ++_previewGeneration;
        var ids = PreviewRows.Select(row => row.HistoryId).ToArray();
        _rollbackPreview = null;
        _loadingDiffPreview = true;
        if (!preserveError) _error = null;
        if (ids.Length == 0) { _error = L["Common:States:NotFound"]; return; }
        _loadingRollbackPreview = true;
        try
        {
            var result = await Facade.PreviewHistoryRollbackAsync(ids, token);
            token.ThrowIfCancellationRequested();
            _operations.TryApply(() =>
            {
                if (generation != _previewGeneration) return;
                var error = result;
                var preview = result.Data;
                if (result.IsFailure() || preview is null)
                {
                    var message = error.Message ?? L["Common:Errors:LoadFailed"].Value;
                    _error = preserveError && !string.IsNullOrWhiteSpace(_error) ? $"{_error}{Environment.NewLine}{message}" : message;
                    _rollbackPreview = result.Data;
                }
                else _rollbackPreview = preview;
            });
        }
        finally
        {
            _operations.TryApply(() => { if (generation == _previewGeneration) _loadingRollbackPreview = false; });
        }
    }

    private async Task RollbackAsync()
    {
        if (!CanRollback || _rollbackPreview is null) return;
        // Freeze the authoritative plan and exact targets before native option or facade awaits.
        var preview = _rollbackPreview;
        var group = _group;
        var history = _historyRow;
        var ids = PreviewRows.Select(row => row.HistoryId).ToArray();
        var reason = _reason;
        var options = MudDialog.Options;
        _saving = true;
        _error = null;
        try
        {
            await _operations.RunAsync(async token =>
            {
                var closed = false;
                try
                {
                    await MudDialog.SetOptionsAsync(options with { BackdropClick = false, CloseOnEscapeKey = false, CloseButton = false });
                    token.ThrowIfCancellationRequested();
                    // Persistence is tokenless. Retirement joins its actual durable result and cannot undo it.
                    if (group is not null)
                    {
                        var result = await Facade.RollbackGroupAsync(group.GroupId, preview.PlanToken, reason);
                        if (_operations.IsRetired) return;
                        var error = result;
                        var mutations = result.Data;
                        if (result.IsFailure() || mutations is null) { await DisplayRejectionAsync(error.Message ?? L["Common:Errors:LoadFailed"].Value, token); return; }
                        MudDialog.Close(DialogResult.Ok(ConfigurationHistoryRollbackDialogResult.Applied(mutations)));
                    }
                    else if (history is not null)
                    {
                        var result = await Facade.RollbackHistoryAsync(history.HistoryId, preview.PlanToken, reason);
                        if (_operations.IsRetired) return;
                        var error = result;
                        var mutation = result.Data;
                        if (result.IsFailure() || mutation is null) { await DisplayRejectionAsync(error.Message ?? L["Common:Errors:LoadFailed"].Value, token); return; }
                        MudDialog.Close(DialogResult.Ok(ConfigurationHistoryRollbackDialogResult.Applied(mutation)));
                    }
                    else
                    {
                        var result = await Facade.RollbackHistoriesAsync(ids, preview.PlanToken, reason);
                        if (_operations.IsRetired) return;
                        var error = result;
                        var mutations = result.Data;
                        if (result.IsFailure() || mutations is null) { await DisplayRejectionAsync(error.Message ?? L["Common:Errors:LoadFailed"].Value, token); return; }
                        MudDialog.Close(DialogResult.Ok(ConfigurationHistoryRollbackDialogResult.Applied(mutations)));
                    }
                    closed = true;
                }
                finally
                {
                    if (!_operations.IsRetired && !closed)
                    {
                        _operations.TryApply(() => _saving = false);
                        await MudDialog.SetOptionsAsync(options);
                    }
                }
            });
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
        catch (Exception exception) when (!_operations.IsRetired) { _error = exception.Message; }
    }

    private async Task DisplayRejectionAsync(string? message, CancellationToken token)
    {
        token.ThrowIfCancellationRequested();
        _error = message;
        await LoadRollbackPreviewCoreAsync(token, preserveError: true);
    }
    private void OnPreviewLoadingChanged(bool loading) => _operations.TryApply(() => _loadingDiffPreview = loading);
    private void Cancel() { if (!_saving && !_operations.IsRetired) MudDialog.Cancel(); }

    /// <summary>Retires preview admission and joins actual history reads, validation and tokenless persistence.</summary>
    /// <remarks>No native UI is adopted after retirement; persistence is not cancelled or reversed.</remarks>
    public ValueTask DisposeAsync() => _operations.RetireAsync();
}
