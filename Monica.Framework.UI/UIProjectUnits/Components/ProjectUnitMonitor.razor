@using Monica.UI.Shared.Components.States
@using Monica.ProjectUnits.Facades
@using Monica.Core.Results
@using Monica.ProjectUnits.Models
@inject ProjectUnitsFacade ProjectUnitsFacade
@inject IStringLocalizer<ProjectUnitsResource> L
@implements IDisposable

<section class="pu-catalog">
    <header class="pu-catalog__header">
        <div>
            <span class="pu-catalog__eyebrow">@L["ProjectUnitMonitor:Header:Eyebrow"]</span>
            <h1>@L["ProjectUnitMonitor:Header:Title"]</h1>
            <p>@L["ProjectUnitMonitor:Header:Description"]</p>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadProjectUnitsAsync"
                   StartIcon="@MoIcons.Refresh" Disabled="@_loading">
            @L["Shared:Actions:Refresh"]
        </MudButton>
    </header>
    <div class="pu-catalog__surface">
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        @if (_loadError is not null)
        {
            <div class="pu-catalog__error" role="status">
                <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Variant="Variant.Text">@_loadError</MudAlert>
                @if (_loaded)
                {
                    <p>@L["ProjectUnitMonitor:States:Retained"]</p>
                }
            </div>
        }
        @if (_loaded && _projectUnits.Count != 0)
        {
            <div class="pu-catalog__workspace">
                <aside class="pu-catalog__filters" aria-label="@L["ProjectUnitFilterPanel:Sections:TypeFilter"]">
                    <ProjectUnitFilterPanel @ref="_filterPanel" Units="_projectUnits"
                                            @bind-FilterText="_filterText"
                                            @bind-SelectedUnitTypes="_selectedUnitTypes"
                                            @bind-ShowOnlyWithDependencies="_showOnlyWithDependencies"
                                            @bind-ShowOnlyWithAlerts="_showOnlyWithAlerts"
                                            OnFiltersChanged="ApplyFilters" />
                </aside>
                <div class="pu-catalog__results">
                    <div class="pu-catalog__result-heading">
                        <span class="pu-catalog__count">@L["ProjectUnitMonitor:Summary:VisibleCount", _filteredProjectUnits.Count, _projectUnits.Count]</span>
                        <div class="pu-catalog__result-actions">
                            @if (_filteredProjectUnits.Count == 0)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="true"
                                           StartIcon="@MoIcons.SortAlphabetical"
                                           aria-label="@L["ProjectUnitMonitor:Sorting:KeyNone"]" aria-pressed="false">
                                    @L["ProjectUnitMonitor:Sorting:KeyNone"]
                                </MudButton>
                            }
                            @if (HasActiveFilters)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ResetFiltersAsync">@L["ProjectUnitMonitor:Actions:Reset"]</MudButton>
                            }
                        </div>
                    </div>
                    @if (_filteredProjectUnits.Count != 0)
                    {
                        <div class="pu-catalog__grid">
                            <MudDataGrid DragIndicatorIcon="@MoIcons.GripVertical" SortIcon="@MoIcons.ArrowUp" FilterIconEmpty="@MoIcons.Filter" FilterIconFilled="@MoIcons.Filter" FilterIconClear="@MoIcons.FilterOff" ColumnOptionsIcon="@MoIcons.MoreVertical" T="ProjectUnitSummary" @ref="_grid" Items="@_filteredProjectUnits"
                                         SortMode="SortMode.Multiple" ShowColumnOptions="false" Breakpoint="Breakpoint.None"
                                         Dense="true" Hover="true" ReadOnly="true" RowsPerPage="@DefaultPageSize">
                                <ToolBarContent>
                                    <div class="pu-catalog__sort-controls">
                                        <p class="pu-catalog__sort-hint">@L["ProjectUnitMonitor:Summary:SortHint"] <span>@L["ProjectUnitMonitor:Summary:SortBy"]</span></p>
                                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="CycleKeySortAsync" Disabled="@_loading"
                                                   StartIcon="@MoIcons.SortAlphabetical" aria-label="@KeySortLabel"
                                                   aria-pressed="@(_grid?.SortDefinitions.ContainsKey(nameof(ProjectUnitSummary.Key)) == true ? "true" : "false")">
                                            @KeySortLabel
                                        </MudButton>
                                    </div>
                                </ToolBarContent>
                                <Columns>
                                    <PropertyColumn T="ProjectUnitSummary" TProperty="string" Property="x => x.Title"
                                                    Title="@L["ProjectUnitMonitor:Columns:Name"]" Sortable="true"
                                                    HeaderClass="pu-catalog__name-column" CellClass="pu-catalog__name-column">
                                        <CellTemplate>
                                            <div class="pu-catalog__unit-name" data-unit-key="@context.Item.Key">
                                                <strong>@context.Item.Title</strong>
                                                <code><ProjectUnitIdentityText Value="@context.Item.Key" /></code>
                                                @if (!string.IsNullOrWhiteSpace(context.Item.Description))
                                                {
                                                    <span>@context.Item.Description</span>
                                                }
                                            </div>
                                        </CellTemplate>
                                    </PropertyColumn>
                                    <PropertyColumn T="ProjectUnitSummary" TProperty="string" Property="x => x.Key"
                                                    Title="@L["ProjectUnitMonitor:Columns:FullName"]" Sortable="true" Hidden="true"
                                                    HeaderClass="pu-catalog__key-column" CellClass="pu-catalog__key-column">
                                        <CellTemplate><code>@context.Item.Key</code></CellTemplate>
                                    </PropertyColumn>
                                    <TemplateColumn Title="@L["ProjectUnitMonitor:Columns:Type"]" Sortable="false"
                                                    HeaderClass="pu-catalog__type-column" CellClass="pu-catalog__type-column">
                                        <CellTemplate>
                                            <span class="pu-catalog__type">@L.GetProjectUnitTypeText(context.Item.UnitType)</span>
                                        </CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["ProjectUnitMonitor:Columns:Dependencies"]" Sortable="false"
                                                    HeaderClass="pu-catalog__count-column" CellClass="pu-catalog__count-column">
                                        <CellTemplate><span class="pu-catalog__number">@context.Item.Dependencies.Count</span></CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["ProjectUnitMonitor:Columns:DependedBy"]" Sortable="false"
                                                    HeaderClass="pu-catalog__count-column" CellClass="pu-catalog__count-column">
                                        <CellTemplate><span class="pu-catalog__number">@context.Item.DependedByCount</span></CellTemplate>
                                    </TemplateColumn>
                                    <TemplateColumn Title="@L["ProjectUnitMonitor:Columns:Actions"]" Sortable="false"
                                                    HeaderClass="pu-catalog__actions-column" CellClass="pu-catalog__actions-column">
                                        <CellTemplate>
                                            <MudIconButton Size="Size.Small" Icon="@MoIcons.ArrowRight"
                                                           Color="Color.Primary" aria-label="@L["ProjectUnitMonitor:Actions:Inspect", context.Item.Title]"
                                                           OnClick="@(() => ViewDetails(context.Item))" />
                                        </CellTemplate>
                                    </TemplateColumn>
                                </Columns>
                                <PagerContent><MudDataGridPager T="ProjectUnitSummary" PageSizeOptions="@PageSizeOptions" /></PagerContent>
                            </MudDataGrid>
                        </div>
                    }
                    else
                    {
                        <MoContentState role="status">
                            <MoIcon Icon="@MoIcons.SearchOff" Size="1.5rem" />
                            <p>@L["ProjectUnitMonitor:States:NoMatches"]</p>
                            <MudButton Variant="Variant.Text" OnClick="ResetFiltersAsync">@L["ProjectUnitMonitor:Actions:Reset"]</MudButton>
                        </MoContentState>
                    }
                </div>
            </div>
        }
        else if (_loaded)
        {
            <MoContentState role="status"><MoIcon Icon="@MoIcons.Package" Size="1.5rem" /><p>@L["ProjectUnitMonitor:States:Empty"]</p></MoContentState>
        }
    </div>
</section>

<ProjectUnitDetailDialog @bind-Visible="_detailDialogVisible" SelectedUnit="_selectedUnit" />

@code {
    private const int DefaultPageSize = 50;
    private static readonly int[] PageSizeOptions = [25, 50, 100, 200];
    private List<ProjectUnitSummary> _projectUnits = [];
    private List<ProjectUnitSummary> _filteredProjectUnits = [];
    private string _filterText = string.Empty;
    private IReadOnlyCollection<EProjectUnitType> _selectedUnitTypes = new HashSet<EProjectUnitType>();
    private bool _showOnlyWithDependencies;
    private bool _showOnlyWithAlerts;
    private bool _loading;
    private bool _loaded;
    private bool _disposed;
    private int _loadVersion;
    private string? _loadError;
    private bool _detailDialogVisible;
    private ProjectUnitSummary? _selectedUnit;
    private ProjectUnitFilterPanel? _filterPanel;
    private MudDataGrid<ProjectUnitSummary>? _grid;

    private bool HasActiveFilters => !string.IsNullOrEmpty(_filterText) || _showOnlyWithDependencies || _showOnlyWithAlerts
                                    || !_selectedUnitTypes.ToHashSet().SetEquals(AvailableUnitTypes());

    private string KeySortLabel => _grid?.SortDefinitions.TryGetValue(nameof(ProjectUnitSummary.Key), out var sort) == true
        ? L[sort.Descending ? "ProjectUnitMonitor:Sorting:KeyDescending" : "ProjectUnitMonitor:Sorting:KeyAscending"]
        : L["ProjectUnitMonitor:Sorting:KeyNone"];

    private async Task CycleKeySortAsync()
    {
        if (_disposed || _grid is null) return;
        if (!_grid.SortDefinitions.TryGetValue(nameof(ProjectUnitSummary.Key), out var sort))
            await _grid.ExtendSortAsync(nameof(ProjectUnitSummary.Key), SortDirection.Ascending, static unit => unit.Key);
        else if (!sort.Descending)
            await _grid.ExtendSortAsync(nameof(ProjectUnitSummary.Key), SortDirection.Descending, static unit => unit.Key);
        else
            await _grid.RemoveSortAsync(nameof(ProjectUnitSummary.Key));
    }

    protected override Task OnInitializedAsync() => LoadProjectUnitsAsync();

    private async Task LoadProjectUnitsAsync()
    {
        if (_disposed || _loading) return;
        var version = ++_loadVersion;
        _loading = true;
        _loadError = null;
        try
        {
            var result = await ProjectUnitsFacade.GetAllProjectUnitsAsync();
            if (_disposed || version != _loadVersion) return;
            if (result.IsFailed(out var error, out var data))
            {
                _loadError = L["Shared:Messages:LoadFailed", error];
                return;
            }
            var selectedAll = !_loaded || _selectedUnitTypes.ToHashSet().SetEquals(AvailableUnitTypes());
            _projectUnits = data ?? [];
            var available = AvailableUnitTypes();
            _selectedUnitTypes = selectedAll ? available : _selectedUnitTypes.Where(available.Contains).ToHashSet();
            _loaded = true;
            ReapplyFilters(resetPage: false);
        }
        catch (Exception exception)
        {
            if (!_disposed && version == _loadVersion) _loadError = L["Shared:Messages:LoadException", exception.Message];
        }
        finally
        {
            if (!_disposed && version == _loadVersion) _loading = false;
        }
    }

    private HashSet<EProjectUnitType> AvailableUnitTypes() => _projectUnits.Select(static unit => unit.UnitType)
        .Where(static type => type != EProjectUnitType.None).ToHashSet();

    private async Task ResetFiltersAsync()
    {
        if (_disposed) return;
        if (_filterPanel is not null) await _filterPanel.ClearQueryAsync();
        if (_disposed) return;
        _filterText = string.Empty;
        _selectedUnitTypes = AvailableUnitTypes();
        _showOnlyWithDependencies = false;
        _showOnlyWithAlerts = false;
        ApplyFilters();
    }

    private void ViewDetails(ProjectUnitSummary unit)
    {
        if (_disposed) return;
        _selectedUnit = unit;
        _detailDialogVisible = true;
    }

    private void ApplyFilters()
    {
        ReapplyFilters(resetPage: true);
    }

    private void ReapplyFilters(bool resetPage)
    {
        if (_disposed) return;
        _filteredProjectUnits = _projectUnits.Where(MatchesFilters).ToList();
        if (resetPage) _grid?.NavigateTo(Page.First);
        if (_filteredProjectUnits.Count == 0) _grid = null;
    }

    private bool MatchesFilters(ProjectUnitSummary unit)
    {
        var matchesText = string.IsNullOrWhiteSpace(_filterText)
                          || unit.Title.Contains(_filterText, StringComparison.OrdinalIgnoreCase)
                          || unit.Key.Contains(_filterText, StringComparison.OrdinalIgnoreCase)
                          || (!string.IsNullOrWhiteSpace(unit.Owner) && unit.Owner.Contains(_filterText, StringComparison.OrdinalIgnoreCase))
                          || unit.Tags.Any(tag => tag.Contains(_filterText, StringComparison.OrdinalIgnoreCase))
                          || (!string.IsNullOrWhiteSpace(unit.Description) && unit.Description.Contains(_filterText, StringComparison.OrdinalIgnoreCase));
        var matchesType = _selectedUnitTypes.Contains(unit.UnitType);
        var matchesDependencies = !_showOnlyWithDependencies || unit.Dependencies.Count != 0 || unit.DependedByCount != 0;
        var matchesAlerts = !_showOnlyWithAlerts || unit.Alerts.Count != 0;
        return matchesText && matchesType && matchesDependencies && matchesAlerts;
    }

    public void Dispose()
    {
        _disposed = true;
        ++_loadVersion;
        _grid = null;
        _filterPanel = null;
    }
}
