@inject ConfigurationValueVisibility Visibility
@using System.Globalization
@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L
@implements IAsyncDisposable

<div class="unified-version-rollback-preview">
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_error is not null)
    {
        <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_preview is not null)
    {
        <div class="unified-version-rollback-summary">
            <span data-tone="primary">@L["Versions:Rollback:Summary:Changes", _preview.ChangeCount]</span>
            <span data-tone="info">@L["Versions:Rollback:Summary:Writes", _preview.MutationCount]</span>
            <span>@L["Versions:Rollback:Summary:Unchanged", _preview.UnchangedCount]</span>
            @if (_preview.FindingCount > 0) { <span data-tone="error">@L["Versions:Rollback:Summary:Findings", _preview.FindingCount]</span> }
            @if (_preview.CompatibleSchemaDriftCount > 0) { <span data-tone="info">@L["Versions:Rollback:Summary:CompatibleSchemaDrift", _preview.CompatibleSchemaDriftCount]</span> }
            @if (_preview.BlockedCount > 0) { <span data-tone="error">@L["Versions:Rollback:Summary:Blocked", _preview.BlockedCount]</span> }
            @if (_preview.SkippedCount > 0) { <span data-tone="warning">@L["Versions:Rollback:Summary:Skipped", _preview.SkippedCount]</span> }
        </div>
        @foreach (var problem in _preview.Problems)
        {
            <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Dense="true"><code>@problem.DefinitionKey</code> @problem.Message</MudAlert>
        }
        @foreach (var row in _rows)
        {
            <div class="unified-version-rollback-target-owner" @key="row.Target.DefinitionKey">
                <MudExpansionPanels MultiExpansion="true" Elevation="0" Square="true" Outlined="false" Gutters="false">
                    <MudExpansionPanel Icon="@MoIcons.ChevronDown" Expanded="@IsExpanded(row.Target.DefinitionKey)" ExpandedChanged="@(expanded => OnExpansionChanged(row.Target.DefinitionKey, expanded))" KeepContentAlive="false">
                        <TitleContent>
                            <div class="unified-version-rollback-target-title">
                                <div><h3>@row.Target.DisplayName</h3><code>@row.Target.DefinitionKey</code></div>
                                <span class="unified-version-rollback-badge" data-tone="@StatusTone(row.Target.Status)">@StatusText(row.Target.Status)</span>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <div class="unified-version-rollback-target-content">
                                @if (row.Target.Status == ConfigurationUnifiedVersionApplyTargetStatus.MissingDefinition)
                                {
                                    <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning" Dense="true">@L["Versions:Rollback:Messages:MissingDefinitionSkipped"]</MudAlert>
                                }
                                else if (row.Target.Status == ConfigurationUnifiedVersionApplyTargetStatus.IncompatibleValue)
                                {
                                    <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning" Dense="true">@L["Versions:Rollback:Messages:IncompatibleValueSkipped"]</MudAlert>
                                }
                                <dl class="unified-version-rollback-facts">
                                    <div><dt>@L["Versions:Rollback:Fields:CapturedSchemaHash"]</dt><dd><code>@ValueOrEmpty(row.Target.CapturedSchemaHash)</code></dd></div>
                                    <div><dt>@L["Versions:Rollback:Fields:CurrentSchemaHash"]</dt><dd><code>@ValueOrEmpty(row.Target.CurrentSchemaHash)</code></dd></div>
                                    <div><dt>@L["Versions:Rollback:Fields:CurrentSchemaVersion"]</dt><dd><code>@ValueOrEmpty(row.Target.CurrentSchemaVersion?.ToString(CultureInfo.InvariantCulture))</code></dd></div>
                                </dl>
                                @if (row.Target.Mutations.Count > 0)
                                {
                                    <section class="unified-version-rollback-source">
                                        <h4>@(row.Target.IsBlocked ? L["Versions:Rollback:Fields:BlockingFindings"] : L["Versions:Rollback:Fields:PlannedWrites"])</h4>
                                        @foreach (var mutation in row.Target.Mutations)
                                        {
                                            <div class="unified-version-rollback-write">
                                                <div class="unified-version-rollback-write-heading">
                                                    <span class="unified-version-rollback-badge" data-tone="@(mutation.Status != ConfigurationUnifiedVersionApplyMutationStatus.Ready ? "error" : mutation.MutationKind == ConfigurationMutationKind.Remove ? "warning" : "info")">@MutationKindText(mutation.MutationKind)</span>
                                                    <code>@DisplayPath(row, mutation.LogicalPath)</code>
                                                </div>
                                                <dl class="unified-version-rollback-facts">
                                                    <div><dt>@L["Sources:Columns:Source"]</dt><dd>@MutationSourceText(mutation)</dd></div>
                                                    <div><dt>@L["Versions:Rollback:Fields:SourceKey"]</dt><dd><code>@ValueOrEmpty(mutation.SourceKey)</code></dd></div>
                                                    @if (mutation.ExpectedValueVersion is not null)
                                                    {
                                                        <div><dt>@L["Versions:Rollback:Fields:ExpectedValueVersion"]</dt><dd><code>@mutation.ExpectedValueVersion</code></dd></div>
                                                    }
                                                    @if (mutation.ExpectedSourceRevision is not null)
                                                    {
                                                        <div><dt>@L["Versions:Rollback:Fields:ExpectedSourceRevision"]</dt><dd><code>@mutation.ExpectedSourceRevision</code></dd></div>
                                                    }
                                                    @if (mutation.ExpectedSourceChainRevision is not null)
                                                    {
                                                        <div class="unified-version-rollback-fact-wide"><dt>@L["Versions:Rollback:Fields:ExpectedSourceChainRevision"]</dt><dd><code>@mutation.ExpectedSourceChainRevision</code></dd></div>
                                                    }
                                                </dl>
                                                @if (!ShouldHidePath(row, mutation.LogicalPath) && !string.IsNullOrWhiteSpace(mutation.ConfigurationPath))
                                                {
                                                    <p class="unified-version-rollback-support">@L["Versions:Rollback:Fields:ConfigurationPath", mutation.ConfigurationPath]</p>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(mutation.BlockingSourceDisplayName))
                                                {
                                                    <p class="unified-version-rollback-blocking">@BlockingSourceText(mutation)</p>
                                                }
                                            </div>
                                        }
                                    </section>
                                }
                                @foreach (var report in _preview.ValidationReports.Where(report => string.Equals(report.DefinitionKey, row.Target.DefinitionKey, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <ConfigurationValidationReportView Title="@report.DefinitionDisplayName" Coverage="@report.Coverage" Scope="@report.Scope"
                                        ValidationRevision="@report.ValidationRevision" Target="@report.Target" HasEffectiveChange="@report.HasEffectiveChange"
                                        IsValid="@report.IsValid" IsSchemaValid="@report.IsSchemaValid" Issues="@report.Issues.Select(ConfigurationValidationPresentation.FromCandidate).ToArray()" />
                                }
                                @if (row.Target.ValidationIssues.Count > 0)
                                {
                                    <MudAlert Icon="@(row.Target.IsSkipped ? MoIcons.Warning : MoIcons.Error)" Severity="@(row.Target.IsSkipped ? Severity.Warning : Severity.Error)" Dense="true">
                                        <h4>@L["Versions:Rollback:Validation:IssueCount", row.Target.ValidationIssues.Count]</h4>
                                        <ul class="unified-version-rollback-validation-issues">
                                            @foreach (var issue in row.Target.ValidationIssues)
                                            {
                                                <li><code>@(Visibility.ShouldMask(issue.DetailsHidden) ? L["Versions:Rollback:Fields:HiddenPath"] : DisplayPath(row, issue.LogicalPath))</code><span>@(Visibility.ShouldMask(issue.DetailsHidden) || ShouldHidePath(row, issue.LogicalPath) ? L["Versions:Rollback:Validation:DetailHidden"] : L["Versions:Rollback:Validation:Incompatible"])</span></li>
                                            }
                                        </ul>
                                    </MudAlert>
                                }
                                @if (row.Target.Status == ConfigurationUnifiedVersionApplyTargetStatus.RuntimeOutOfSync)
                                {
                                    <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Dense="true">@L["Versions:Rollback:Messages:RuntimeOutOfSync"]</MudAlert>
                                }
                                @if (row.HasSchemaDrift && !row.Target.IsSkipped && !Visibility.ShowSensitiveValues)
                                {
                                    <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning" Dense="true">@L["State:Value:SchemaDriftNotice"]</MudAlert>
                                }
                                @if (row.HasHiddenChanges)
                                {
                                    <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Dense="true">@L["State:Value:HiddenChangedNotice"]</MudAlert>
                                }
                                <p class="unified-version-rollback-direction">@L["Versions:Rollback:Fields:DiffDirection"]</p>
                                <div class="unified-version-rollback-diff"><DiffViewer OriginText="@row.CurrentText" NewText="@row.TargetText" Options="@_diffOptions" ViewMode="EDiffViewMode.Split" /></div>
                            </div>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </div>
        }
    }
</div>

@code {
    private readonly ConfigurationOperationLifetime _operations = new();
    private readonly DiffHighlightOptions _diffOptions = new() { Mode = EDiffHighlightMode.Line, ContextLines = 4, MaxCharacterDiffLength = 20000 };
    private readonly Dictionary<string, ConfigurationDefinition> _definitions = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, bool> _expandedTargets = new(StringComparer.OrdinalIgnoreCase);
    private ConfigurationUnifiedVersionApplyPreview? _preview;
    private IReadOnlyList<RollbackPreviewRow> _rows = [];
    private string? _previewIdentity;
    private string? _error;
    private bool _loading;
    private long _generation;
    /// <summary>Gets the immutable authoritative rollback plan used for metadata, validation and redacted differences.</summary>
    [Parameter, EditorRequired] public ConfigurationUnifiedVersionApplyPreview Preview { get; set; } = null!;
    /// <summary>Gets a loading callback whose admitted asynchronous completion is joined during retirement.</summary>
    [Parameter] public EventCallback<bool> LoadingChanged { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_operations.IsRetired) return;
        var preview = Preview with
        {
            Targets = Preview.Targets.Select(target => target with { Mutations = target.Mutations.ToArray(), ValidationIssues = target.ValidationIssues.ToArray() }).ToArray(),
            ValidationReports = Preview.ValidationReports.ToArray(), Problems = Preview.Problems.ToArray()
        };
        var identity = $"{preview.Version}:{preview.PreviewFingerprint}";
        if (string.Equals(_previewIdentity, identity, StringComparison.Ordinal)) return;
        var generation = ++_generation;
        var loadingChanged = LoadingChanged;
        _previewIdentity = identity;
        _loading = true;
        _error = null;
        try
        {
            await _operations.RunAsync(async token =>
            {
                try
                {
                    await loadingChanged.InvokeAsync(true);
                    token.ThrowIfCancellationRequested();
                    var definitions = new Dictionary<string, ConfigurationDefinition>(StringComparer.OrdinalIgnoreCase);
                    var targets = preview.Targets.Where(static target => target.HasChanges || target.IsSkipped).ToArray();
                    foreach (var key in targets.Select(static target => target.DefinitionKey).Distinct(StringComparer.OrdinalIgnoreCase))
                    {
                        var result = await Facade.GetDefinitionAsync(key);
                        token.ThrowIfCancellationRequested();
                        var detail = result.Data;
                        if (!result.IsFailure() && detail is not null) definitions[key] = detail.Definition;
                    }
                    var rows = targets.Select(target => CreateRow(target, definitions)).ToArray();
                    token.ThrowIfCancellationRequested();
                    _operations.TryApply(() =>
                    {
                        if (generation != _generation) return;
                        _definitions.Clear();
                        foreach (var pair in definitions) _definitions[pair.Key] = pair.Value;
                        _preview = preview;
                        _rows = rows;
                        foreach (var key in _expandedTargets.Keys.Where(key => !rows.Any(row => string.Equals(row.Target.DefinitionKey, key, StringComparison.OrdinalIgnoreCase))).ToArray()) _expandedTargets.Remove(key);
                        foreach (var row in rows) _expandedTargets.TryAdd(row.Target.DefinitionKey, rows.Length == 1);
                    });
                }
                catch (OperationCanceledException) when (token.IsCancellationRequested) { }
                catch (Exception exception) when (!_operations.IsRetired)
                {
                    _operations.TryApply(() => { if (generation == _generation) _error = exception.Message; });
                }
                finally
                {
                    if (!_operations.IsRetired && generation == _generation)
                    {
                        _operations.TryApply(() => _loading = false);
                        await loadingChanged.InvokeAsync(false);
                    }
                }
            });
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
    }
    private bool IsExpanded(string key) => _expandedTargets.GetValueOrDefault(key);
    private void OnExpansionChanged(string key, bool expanded) => _operations.TryApply(() => _expandedTargets[key] = expanded);
    private RollbackPreviewRow CreateRow(ConfigurationUnifiedVersionApplyTarget target, IReadOnlyDictionary<string, ConfigurationDefinition> definitions)
    {
        definitions.TryGetValue(target.DefinitionKey, out var definition);
        var drift = ConfigurationUnifiedVersionValuePrivacy.HasSchemaDrift(target, definition);
        var display = ConfigurationUnifiedVersionJsonFormatter.FormatComparisonForDisplay(target.CurrentJson, target.TargetJson, definition,
            L["State:Value:Sensitive"], L["State:Value:Hidden"], L["State:Value:HiddenBeforeChange"], L["State:Value:HiddenAfterChange"], Visibility.ShowSensitiveValues);
        return new(target, display.OriginText, display.TargetText, display.HasHiddenChanges, drift);
    }
    private bool ShouldHidePath(RollbackPreviewRow row, string path) => ConfigurationUnifiedVersionValuePrivacy.ShouldHidePath(
        _definitions.GetValueOrDefault(row.Target.DefinitionKey), path, Visibility.ShowSensitiveValues);
    private string DisplayPath(RollbackPreviewRow row, string path) => ShouldHidePath(row, path) ? L["Versions:Rollback:Fields:HiddenPath"]
        : string.IsNullOrWhiteSpace(path) ? L["Versions:Rollback:Fields:DefinitionRoot"] : path;
    private string ValueOrEmpty(string? value) => string.IsNullOrWhiteSpace(value) ? L["Common:States:Empty"] : value;
    private string MutationSourceText(ConfigurationUnifiedVersionApplyMutation mutation) => string.IsNullOrWhiteSpace(mutation.SourceDisplayName) ? L["Versions:Rollback:Fields:NoWritableTarget"] : mutation.SourceDisplayName;
    private string MutationKindText(ConfigurationMutationKind kind) => kind == ConfigurationMutationKind.Remove ? L["Versions:Rollback:MutationKinds:Remove"] : L["Versions:Rollback:MutationKinds:Set"];
    private string BlockingSourceText(ConfigurationUnifiedVersionApplyMutation mutation) => mutation.Status switch
    {
        ConfigurationUnifiedVersionApplyMutationStatus.LowerPriorityFallback => L["Versions:Rollback:Fields:LowerPriorityFallback", mutation.BlockingSourceDisplayName ?? string.Empty],
        ConfigurationUnifiedVersionApplyMutationStatus.CompositeSourceConflict => L["Versions:Rollback:Fields:CompositeSourceConflict", mutation.BlockingSourceDisplayName ?? string.Empty],
        _ => L["Versions:Rollback:Fields:BlockingSource", mutation.BlockingSourceDisplayName ?? string.Empty]
    };
    private string StatusText(ConfigurationUnifiedVersionApplyTargetStatus status) => status switch
    {
        ConfigurationUnifiedVersionApplyTargetStatus.Unchanged => L["Versions:Rollback:Statuses:Unchanged"],
        ConfigurationUnifiedVersionApplyTargetStatus.Ready => L["Versions:Rollback:Statuses:Ready"],
        ConfigurationUnifiedVersionApplyTargetStatus.CompatibleSchemaDrift => L["Versions:Rollback:Statuses:CompatibleSchemaDrift"],
        ConfigurationUnifiedVersionApplyTargetStatus.IncompatibleValue => L["Versions:Rollback:Statuses:IncompatibleValue"],
        ConfigurationUnifiedVersionApplyTargetStatus.MissingDefinition => L["Versions:Rollback:Statuses:MissingDefinition"],
        ConfigurationUnifiedVersionApplyTargetStatus.RuntimeOutOfSync => L["Versions:Rollback:Statuses:RuntimeOutOfSync"],
        ConfigurationUnifiedVersionApplyTargetStatus.ReadOnlyOverride => L["Versions:Rollback:Statuses:ReadOnlyOverride"],
        ConfigurationUnifiedVersionApplyTargetStatus.CompositeSourceConflict => L["Versions:Rollback:Statuses:CompositeSourceConflict"],
        ConfigurationUnifiedVersionApplyTargetStatus.LowerPriorityFallback => L["Versions:Rollback:Statuses:LowerPriorityFallback"],
        ConfigurationUnifiedVersionApplyTargetStatus.ValidationRejected => L["Validation:PreviewBlocked"],
        _ => L["Versions:Rollback:Statuses:UnsupportedSource"]
    };
    private static string StatusTone(ConfigurationUnifiedVersionApplyTargetStatus status) => status switch
    {
        ConfigurationUnifiedVersionApplyTargetStatus.Unchanged => "secondary",
        ConfigurationUnifiedVersionApplyTargetStatus.Ready => "success",
        ConfigurationUnifiedVersionApplyTargetStatus.CompatibleSchemaDrift => "info",
        ConfigurationUnifiedVersionApplyTargetStatus.MissingDefinition or ConfigurationUnifiedVersionApplyTargetStatus.IncompatibleValue => "warning",
        _ => "error"
    };
    private sealed record RollbackPreviewRow(ConfigurationUnifiedVersionApplyTarget Target, string CurrentText, string TargetText, bool HasHiddenChanges, bool HasSchemaDrift);
    /// <summary>Retires definition reads and loading callbacks and shares their actual drained completion.</summary>
    public ValueTask DisposeAsync() => _operations.RetireAsync();
}