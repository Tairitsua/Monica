@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.State
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<ModuleSystemResource> L

<section class="assembly-explorer" aria-labelledby="assembly-explorer-title">
    <header class="assembly-explorer-header">
        <div class="assembly-explorer-header__copy">
            <span class="assembly-eyebrow">@L["Discovery:Inventory:Eyebrow"]</span>
            <h3 id="assembly-explorer-title">@L["Discovery:Inventory:Title"]</h3>
            <p>@L["Discovery:Inventory:Description"]</p>
        </div>
        @if (Session.AssemblyInventoryState == ModuleSystemLazyLoadState.Failed)
        {
            <div class="assembly-retry">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@MoIcons.Refresh"
                           OnClick="@Session.EnsureAssemblyInventoryLoadedAsync">
                    @L["Actions:Retry"]
                </MudButton>
            </div>
        }
    </header>

    @switch (Session.AssemblyInventoryState)
    {
        case ModuleSystemLazyLoadState.NotRequested:
        case ModuleSystemLazyLoadState.Loading:
            <MoContentState Loading="true" Compact="true">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                <span>@L["Discovery:Inventory:Loading"]</span>
            </MoContentState>
            break;
        case ModuleSystemLazyLoadState.Failed:
            <div class="assembly-load-failure" role="alert">
                <MoIcon Icon="@MoIcons.Error" Size="1.25rem" />
                <span>@L["Discovery:Inventory:Failed"]</span>
            </div>
            break;
        case ModuleSystemLazyLoadState.Ready when Session.AssemblyInventory is { } inventory:
            var entryAssembly = inventory.Assemblies.FirstOrDefault(static assembly => assembly.IsEntryAssembly);
            <div class="assembly-inventory-context">
                <dl class="assembly-entry">
                    <dt>@L["Discovery:Inventory:Summary:EntryAssembly"]</dt>
                    <dd>
                        <strong>@(entryAssembly?.Name ?? L["Common:NotAvailable"])</strong>
                        <span>@(entryAssembly?.Version ?? L["Common:NotAvailable"])</span>
                    </dd>
                </dl>
                <dl class="assembly-summary" aria-label="@L["Aria:SummaryMetrics"]">
                    <div><dt>@L["Discovery:Inventory:Summary:ScanScope"]</dt><dd>@Session.AssemblyScanScopeCount</dd></div>
                    <div><dt>@L["Discovery:Inventory:Summary:Considered"]</dt><dd>@inventory.Assemblies.Length</dd></div>
                    <div class="@(Session.AssemblyAttentionCount > 0 ? "assembly-summary__attention" : null)"><dt>@L["Discovery:Inventory:Summary:Attention"]</dt><dd>@Session.AssemblyAttentionCount</dd></div>
                </dl>
            </div>

            <details class="assembly-configuration">
                <summary>
                    <span class="assembly-configuration__label"><MoIcon Icon="@MoIcons.Sliders" Size="1.25rem" />@L["Discovery:Inventory:Configuration:Title"]</span>
                    <span class="assembly-captured-at">@L["Discovery:Inventory:Configuration:CapturedAt", UiTime.Format(inventory.CapturedAtUtc)]</span>
                    <span class="assembly-configuration__expand" aria-hidden="true"><MoIcon Icon="@MoIcons.ChevronDown" Size="1.25rem" /></span>
                </summary>
                <dl class="assembly-configuration-facts">
                    <div>
                        <dt>@L["Discovery:Inventory:Configuration:DefaultAssemblies"]</dt>
                        <dd>@(inventory.UsesDefaultProjectAssemblies ? L["Common:Yes"] : L["Common:No"])</dd>
                    </div>
                    <div>
                        <dt>@L["Discovery:Inventory:Configuration:Includes"]</dt>
                        <dd class="assembly-patterns">
                            @if (inventory.IncludePatterns.Length == 0)
                            {
                                <span>@L["Common:None"]</span>
                            }
                            else
                            {
                                @foreach (var pattern in inventory.IncludePatterns)
                                {
                                    <code>@pattern</code>
                                }
                            }
                        </dd>
                    </div>
                    <div>
                        <dt>@L["Discovery:Inventory:Configuration:Excludes"]</dt>
                        <dd class="assembly-patterns">
                            @if (inventory.ExcludePatterns.Length == 0)
                            {
                                <span>@L["Common:None"]</span>
                            }
                            else
                            {
                                @foreach (var pattern in inventory.ExcludePatterns)
                                {
                                    <code>@pattern</code>
                                }
                            }
                        </dd>
                    </div>
                </dl>
            </details>

            <section class="assembly-outcomes" aria-labelledby="assembly-outcomes-title">
                <h4 id="assembly-outcomes-title">@L["Discovery:Inventory:PanelTitle"]</h4>
                <dl class="assembly-outcome-list">
                    @OutcomeFact(TypeDiscoveryAssemblyOutcome.ResolutionFailed, inventory.ResolutionFailedCount)
                    @OutcomeFact(TypeDiscoveryAssemblyOutcome.PartialTypeLoad, inventory.PartialTypeLoadCount)
                    @OutcomeFact(TypeDiscoveryAssemblyOutcome.Scanned, inventory.ScannedCount)
                    @OutcomeFact(TypeDiscoveryAssemblyOutcome.ResolvedNotScanned, inventory.NotScannedCount)
                    @OutcomeFact(TypeDiscoveryAssemblyOutcome.Excluded, inventory.ExcludedCount)
                </dl>
            </section>

            <section class="assembly-records" aria-labelledby="assembly-records-title">
                <div class="assembly-records-heading">
                    <div class="assembly-records-heading__copy">
                        <h4 id="assembly-records-title">@L["Discovery:Inventory:Records:Title"]</h4>
                        <span class="assembly-result-count" aria-live="polite">@L["Discovery:Inventory:Records:ResultCount", Session.FilteredAssemblies.Count, inventory.Assemblies.Length]</span>
                    </div>
                    <div class="assembly-search-field">
                        <MudTextField T="string"
                                      Label="@L["Discovery:Inventory:Search"]"
                                      Value="@Session.AssemblySearch"
                                      ValueChanged="@Session.SetAssemblySearch"
                                      Immediate="true"
                                      Clearable="true"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@MoIcons.Search" ClearIcon="@MoIcons.Close" />
                    </div>
                </div>

                <div class="assembly-filter-context">
                    <div class="assembly-facets" role="group" aria-label="@L["Discovery:Inventory:Facets:Label"]">
                        @FacetButton(AssemblyInventoryFacet.Attention, L["Discovery:Inventory:Facets:Attention", Session.AssemblyAttentionCount])
                        @FacetButton(AssemblyInventoryFacet.ScanScope, L["Discovery:Inventory:Facets:ScanScope", Session.AssemblyScanScopeCount])
                        @FacetButton(AssemblyInventoryFacet.Excluded, L["Discovery:Inventory:Facets:Excluded", inventory.ExcludedCount])
                        @FacetButton(AssemblyInventoryFacet.All, L["Discovery:Inventory:Facets:All", inventory.Assemblies.Length])
                    </div>
                    <p>@L["Discovery:Inventory:Facets:Hint"]</p>
                </div>

                <div class="assembly-table-wrapper" role="region" aria-labelledby="assembly-records-title" tabindex="0">
                    <MudTable T="TypeDiscoveryAssemblyRecord"
                              Items="@Session.PagedAssemblies"
                              Dense="true"
                              Hover="true"
                              Breakpoint="Breakpoint.None"
                              Elevation="0">
                        <HeaderContent>
                            <MudTh>@L["Discovery:Inventory:Columns:Outcome"]</MudTh>
                            <MudTh>@L["Discovery:Inventory:Columns:Assembly"]</MudTh>
                            <MudTh>@L["Discovery:Inventory:Columns:Path"]</MudTh>
                            <MudTh>@L["Discovery:Inventory:Columns:Failure"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="assembly">
                            <MudTd DataLabel="@L["Discovery:Inventory:Columns:Outcome"]">
                                <span class="assembly-outcome assembly-outcome--@assembly.Outcome.ToString().ToLowerInvariant()">@L[$"Enums:AssemblyOutcome:{assembly.Outcome}"]</span>
                            </MudTd>
                            <MudTd DataLabel="@L["Discovery:Inventory:Columns:Assembly"]">
                                <div class="assembly-name-cell">
                                    @if (assembly.IsEntryAssembly)
                                    {
                                        <MudTooltip Text="@L["Discovery:Inventory:Markers:EntryAssembly"]">
                                            <span class="assembly-marker" tabindex="0" aria-label="@L["Discovery:Inventory:Markers:EntryAssembly"]">
                                                <MoIcon Icon="@MoIcons.CircleDot" Size="1.25rem" />
                                            </span>
                                        </MudTooltip>
                                    }
                                    <strong>@assembly.Name</strong>
                                </div>
                                <dl class="assembly-version"><dt>@L["Discovery:Inventory:Columns:Version"]</dt><dd>@(assembly.Version ?? L["Common:NotAvailable"])</dd></dl>
                            </MudTd>
                            <MudTd DataLabel="@L["Discovery:Inventory:Columns:Path"]">
                                @if (string.IsNullOrWhiteSpace(assembly.Location))
                                {
                                    <span class="assembly-unavailable">@L["Common:NotAvailable"]</span>
                                }
                                else
                                {
                                    <code class="assembly-path">@assembly.Location</code>
                                }
                            </MudTd>
                            <MudTd DataLabel="@L["Discovery:Inventory:Columns:Failure"]">
                                @if (string.IsNullOrWhiteSpace(assembly.Failure))
                                {
                                    <span class="assembly-unavailable">@L["Common:None"]</span>
                                }
                                else
                                {
                                    <div class="assembly-failure" role="region" aria-label="@L["Discovery:Inventory:Columns:Failure"]" tabindex="0">@assembly.Failure</div>
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MoContentState Compact="true"><p>@L["Discovery:Inventory:Records:Empty"]</p></MoContentState>
                        </NoRecordsContent>
                    </MudTable>
                </div>

                <footer class="assembly-pagination">
                    <MudPagination Count="@Session.AssemblyPageCount"
                                   Selected="@Session.AssemblyPage"
                                   SelectedChanged="@SetAssemblyPage"
                                   ShowFirstButton="true"
                                   ShowLastButton="true" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" />
                    <div class="assembly-page-size">
                        <MudSelect T="int"
                                   Label="@L["Common:RowsPerPage"]"
                                   Value="@Session.AssemblyPageSize"
                                   ValueChanged="@SetAssemblyPageSize"
                                   Dense="true"
                                   Margin="Margin.Dense"
                                   Variant="Variant.Outlined" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                            <MudSelectItem T="int" Value="10">10</MudSelectItem>
                            <MudSelectItem T="int" Value="25">25</MudSelectItem>
                            <MudSelectItem T="int" Value="50">50</MudSelectItem>
                        </MudSelect>
                    </div>
                </footer>
            </section>
            break;
    }
</section>

@code {
    [Parameter, EditorRequired] public ModuleSystemWorkbenchSession Session { get; set; } = default!;

    protected override Task OnInitializedAsync() => Session.EnsureAssemblyInventoryLoadedAsync();

    private RenderFragment OutcomeFact(TypeDiscoveryAssemblyOutcome outcome, int count) => @<div class="assembly-outcome-fact">
        <dt><span class="assembly-outcome assembly-outcome--@outcome.ToString().ToLowerInvariant()">@L[$"Enums:AssemblyOutcome:{outcome}"]</span></dt>
        <dd>@count</dd>
    </div>;

    private RenderFragment FacetButton(AssemblyInventoryFacet facet, string label) => @<MudButton
        Class="@(Session.AssemblyFacet == facet ? "assembly-facet assembly-facet--selected" : "assembly-facet")"
        Variant="Variant.Text"
        Color="Color.Default"
        Size="Size.Small"
        aria-pressed="@(Session.AssemblyFacet == facet ? "true" : "false")"
        OnClick="@(() => Session.SetAssemblyFacet(facet))">
        @label
    </MudButton>;

    private void SetAssemblyPage(int page) => Session.SetAssemblyPaging(page, Session.AssemblyPageSize);
    private void SetAssemblyPageSize(int pageSize) => Session.SetAssemblyPaging(1, pageSize);
}
