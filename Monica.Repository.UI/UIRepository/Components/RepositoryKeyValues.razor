@inject IStringLocalizer<RepositoryUIResource> L

<dl class="rp-key-values">
    @foreach (var (label, value, copy) in Items)
    {
        <div>
            <dt>@label</dt>
            <dd class="rp-key-value">
                <code>@(string.IsNullOrWhiteSpace(value) ? L["Persistence:Unavailable"].Value : value)</code>
                @if (copy && !string.IsNullOrWhiteSpace(value))
                {
                    <MoCopyButton Value="@value" Label="@L["Persistence:CopyField", label]" />
                }
            </dd>
        </div>
    }
</dl>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<(string Label, string? Value, bool Copy)> Items { get; set; } = [];
}
