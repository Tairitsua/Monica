@inject IStringLocalizer<LockerResource> L
@inject MoTimeFormatter Time
@inject NavigationManager Nav
@using Microsoft.JSInterop
@inject IJSRuntime JS
@using Monica.UI.Shared.Components.Dialogs
@implements IAsyncDisposable

<MoSideSheet Open="true" OpenChanged="OnSheetVisibilityChanged" CloseLabel="@L["Common:Close"]" Width="520px" Compact="true">
    <TitleContent>
        <div class="ls-evidence-title">
            <p>@L["Evidence:Title"]</p>
            <h2>@(Evidence?.Snapshot.Leases.Count > 0 ? LeasePresentation.Title(ResourceName, L) :
                L[Busy ? "Common:Loading" : Failed || Evidence is null ? "Evidence:Unavailable" : "Evidence:Missing"].Value)</h2>
        </div>
    </TitleContent>
    <ChildContent>
        <div class="ls-evidence-body">
            @if (Failed && Evidence?.Snapshot.Leases.Count > 0)
            {
                <MoSemanticCallout Severity="MoVisualRole.Warning" Title="@L["Evidence:RefreshFailed"]">@L["Evidence:ExactFailed"]</MoSemanticCallout>
            }
            @if (_revokeError) { <MudAlert Severity="Severity.Error" Dense="true">@L["Admin:Failed"]</MudAlert> }
            @if (Evidence is { } evidence && evidence.Snapshot.Leases.FirstOrDefault() is { } record)
            {
                var observed = evidence.Snapshot.ObservedAtUtc;
                var row = new LeaseRow(evidence.Authority, record, observed);
                var (value, unit) = LeasePresentation.Duration(row.RemainingSeconds, L);
                var elapsed = Math.Max(0, (observed - record.ConfirmedAtUtc).TotalSeconds);
                var elapsedPct = row.Expired ? 100 : Math.Clamp(elapsed / Math.Max(.001, row.GrantSeconds) * 100, 0, 100);
                var role = row.Expired ? MoVisualRole.Warning : MoVisualRole.Success;
                var authorityRole = LeasePresentation.Role(evidence.Authority.Kind);
                <section class="ls-grant-card @role.ToCssClass()">
                    <div class="ls-grant-top">
                        <span class="mo-vl-status mo-vl-status--pill @role.ToCssClass()"><i class="mo-vl-status-dot" aria-hidden="true"></i>@L[row.Expired ? "Design:StatusExpired" : "Design:StatusActive"]</span>
                        <span class="mo-vl-capsule @authorityRole.ToCssClass()"><MoIcon Icon="@LeasePresentation.Icon(evidence.Authority.Kind)" Size="13px" />@L[$"Providers:{evidence.Authority.Kind}"]</span>
                    </div>
                    <div class="ls-grant-metric">
                        <b>@(row.Expired ? "−" : "+")@value<small>@unit</small></b>
                        <span>@L[row.Expired ? "Design:ExpiredEvidence" : "Design:ActiveEvidence"]</span>
                    </div>
                    <div class="ls-anatomy">
                        <div class="ls-anatomy-track" aria-hidden="true">
                            @if (row.Expired) { <span class="ls-anatomy-expired"></span> }
                            else
                            {
                                <span class="ls-anatomy-elapsed" style="width:@Percent(elapsedPct)"></span>
                                <span class="ls-anatomy-pin" style="left:@Percent(elapsedPct)"></span>
                                <span class="ls-anatomy-remain" style="width:@Percent(100 - elapsedPct)"></span>
                            }
                        </div>
                        <div class="ls-anatomy-meta">
                            <span>@L["Timestamps:Confirmed"]: −@Span(elapsed)</span>
                            <span>@(row.Expired ? $"{L["Design:ExpiredEvidence"]} {Span(row.RemainingSeconds)}" : L["Design:FullGrant", Span(row.GrantSeconds)].Value)</span>
                        </div>
                    </div>
                    <div class="ls-grant-footer">
                        <div class="ls-grant-holder">
                            <MoIcon Icon="@MoIcons.Server" Size="14px" /><code>@record.HolderId</code>
                            @CopyControl(record.HolderId, L["Design:Holder"])
                        </div>
                        <div class="ls-grant-badges">
                            <span class="mo-vl-capsule mo-vl-capsule--outline mo-vl-role--neutral">@L["Design:HeldFor", Span(row.Tenure.TotalSeconds)]</span>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Href="@HolderUrl(record.HolderId)">@L["Design:FilterThisHolder"]</MudButton>
                        </div>
                    </div>
                </section>

                @ExactRefresh

                <section class="ls-sheet-section">
                    <h3>@L["Evidence:Timeline"]</h3>
                    <ol class="ls-spine">
                        @{ DateTimeOffset? previous = null; }
                        @foreach (var (label, time, pointRole) in new[] {
                            ("Acquired", record.AcquiredAtUtc, MoVisualRole.Neutral),
                            ("Confirmed", record.ConfirmedAtUtc, MoVisualRole.Info),
                            ("Observed", observed, MoVisualRole.Primary),
                            ("Expires", record.ExpiresAtUtc, role)
                        }.OrderBy(point => point.Item2))
                        {
                            <li class="@pointRole.ToCssClass()">
                                <i class="ls-spine-node" aria-hidden="true"></i>
                                <div class="ls-spine-row">
                                    <span class="ls-spine-label">@L[$"Timestamps:{label}"]</span>
                                    <div class="ls-spine-right">
                                        @if (previous is { } prior && time > prior)
                                        {
                                            <span class="ls-spine-delta">+@Delta(time - prior)</span>
                                        }
                                        <time datetime="@time.ToString("O")">@Time.Format(time)</time>
                                    </div>
                                </div>
                            </li>
                            previous = time;
                        }
                    </ol>
                    <p class="ls-sheet-note">@L["Evidence:TimelineNote"]</p>
                </section>

                <section class="ls-sheet-section">
                    <h3>@L["Evidence:Identity"]</h3>
                    <dl class="ls-sheet-identity">
                        <div><dt>@L["Inventory:Authority"]</dt><dd>@evidence.Authority.DisplayName <code>(@evidence.Authority.Id)</code></dd></div>
                        @Identity("Evidence:ServiceKey", evidence.Authority.StoreKey)
                        @Identity("Evidence:Scope", record.Resource.Scope)
                        @Identity("Evidence:Name", record.Resource.Name)
                    </dl>
                </section>

                <MoSemanticCallout Severity="@authorityRole" Title="@L["Evidence:Meaning"]" Icon="@MoIcons.ShieldCheck">@L[$"Meaning:{evidence.Authority.Kind}"]</MoSemanticCallout>

                <section class="ls-sheet-section ls-admin-box">
                    <h3>@L["Admin:Title"]</h3>
                    <p>@L[evidence.CanRevoke ? "Admin:Warning" : "Admin:Unavailable"]</p>
                    @if (evidence.CanRevoke)
                    {
                        <MudButton Class="ls-revoke-trigger" Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@MoIcons.Key" Disabled="@Busy" OnClick="OpenConfirmation">@L["Admin:Revoke"]</MudButton>
                    }
                </section>
            }
            else
            {
                <div class="ls-sheet-empty">
                    <span class="mo-vl-tile @(Failed ? "mo-vl-role--warning" : "mo-vl-role--neutral")"><MoIcon Icon="@(Failed ? MoIcons.Warning : MoIcons.ScanSearch)" Size="20px" /></span>
                    <h3>@L[Busy ? "Common:Loading" : Failed || Evidence is null ? "Evidence:Unavailable" : "Evidence:Missing"]</h3>
                    <p>@L[Failed || Evidence is null ? "Evidence:Retry" : "Evidence:MissingDescription"]</p>
                    @ExactRefresh
                    <dl class="ls-sheet-identity ls-sheet-empty-meta">
                        <div><dt>@L["Inventory:Authority"]</dt><dd><code>@SourceId</code></dd></div>
                        @Identity("Evidence:Name", ResourceName)
                    </dl>
                </div>
            }
        </div>
    </ChildContent>
</MoSideSheet>
<MudDialog @ref="_confirmation" @bind-Visible="_confirmOpen" Options="_dialogOptions" DefaultFocus="DefaultFocus.LastChild">
    <TitleContent><MoDialogHeading Text="@L["Admin:ConfirmTitle"]" /></TitleContent>
    <DialogContent><p>@L["Admin:ConfirmDescription"]</p><p class="mo-vl-mono">@_target?.Authority.Id / @_target?.Authority.Scope / @_target?.Snapshot.Leases.FirstOrDefault()?.Resource.Name</p><MudAlert Severity="Severity.Warning" Dense="true">@L["Admin:Warning"]</MudAlert><MudCheckBox T="bool" @bind-Value="_acknowledged" Label="@L["Admin:Acknowledge"]" /></DialogContent>
    <DialogActions><MudButton Color="Color.Warning" Variant="Variant.Filled" Disabled="@(!_acknowledged || Busy)" OnClick="ConfirmAsync">@L["Admin:Revoke"]</MudButton><MudButton Disabled="@Busy" OnClick="@(() => _confirmOpen = false)">@L["Common:Cancel"]</MudButton></DialogActions>
</MudDialog>

@code {
    [Parameter] public LeaseResourceEvidence? Evidence { get; set; }
    [Parameter] public bool Failed { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string ResourceName { get; set; } = string.Empty;
    [Parameter] public string SourceId { get; set; } = string.Empty;
    [Parameter] public EventCallback Close { get; set; }
    [Parameter] public EventCallback Refresh { get; set; }
    [Parameter] public Func<LeaseResourceEvidence, Task<bool>>? Revoke { get; set; }
    private bool _confirmOpen, _acknowledged, _revokeError, _submitting, _retired;
    private MudDialog? _confirmation;
    private Task<IDialogReference>? _confirmationOpening;
    private Task? _retirement;
    private LeaseResourceEvidence? _target;
    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
    private string Span(double seconds) => LeasePresentation.Span(seconds, L);
    private string Delta(TimeSpan difference) => difference.TotalHours >= 1
        ? $"{(long)difference.TotalHours} {L["Common:Hours"]} {difference.Minutes} {L["Common:Minutes"]}"
        : difference.TotalMinutes >= 1 && difference.Seconds != 0
            ? $"{(long)difference.TotalMinutes} {L["Common:Minutes"]} {difference.Seconds} {L["Common:Seconds"]}"
            : Span(difference.TotalSeconds);
    private static string Percent(double value) => FormattableString.Invariant($"{value:0.##}%");
    private string HolderUrl(string holder) => Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
    {
        ["group"] = "holder", ["holder"] = holder, ["targetAuthority"] = null, ["source"] = null, ["resource"] = null
    });
    private RenderFragment ExactRefresh => @<div class="ls-exact-bar">
        <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" Disabled="@Busy" OnClick="@(() => Refresh.InvokeAsync())">@L["Evidence:RefreshExact"]</MudButton>
        <p>@L["Evidence:ExactHint"]</p>
    </div>;
    private RenderFragment Identity(string label, string value) => @<div><dt>@L[label]</dt><dd><code>@value</code>@CopyControl(value, L[label])</dd></div>;
    private RenderFragment CopyControl(string value, string label) => @<MudIconButton Icon="@MoIcons.Copy" Size="Size.Small" aria-label="@L["Design:CopyValue", label]"
        OnClick="@(() => JS.InvokeVoidAsync("navigator.clipboard.writeText", value).AsTask())" />;
    private Task OnSheetVisibilityChanged(bool visible) => !visible && !_retired ? Close.InvokeAsync() : Task.CompletedTask;
    private Task OpenConfirmation()
    {
        if (_retired || _confirmOpen || _confirmationOpening is { IsCompleted: false }) return Task.CompletedTask;
        _target = Evidence;
        _acknowledged = false;
        return _confirmationOpening = _confirmation!.ShowAsync();
    }
    private async Task ConfirmAsync()
    {
        if (!_acknowledged || Busy || _submitting || _retired || _target is null || Revoke is null) return;
        _submitting = true;
        try
        {
            _revokeError = !await Revoke(_target);
            _confirmOpen = false;
        }
        finally { _submitting = false; }
    }

    public ValueTask DisposeAsync() => new(_retirement ??= RetireAsync());

    private async Task RetireAsync()
    {
        _retired = true;
        // Drain native opening so route retirement also closes a late-created provider portal.
        if (_confirmationOpening is not null) (await _confirmationOpening).Close();
    }
}
