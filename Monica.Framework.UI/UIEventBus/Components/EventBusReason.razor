<span class="eb-reason @(Count == 0 ? "is-zero" : null)">
    <span class="sw @Role.ToCssClass() @(Hatched ? "is-hatch" : Diamond ? "is-diamond" : null)" aria-hidden="true"></span><b>@Count</b> @ChildContent
</span>

@code {
    /// <summary>Gets or sets the current reason population.</summary>
    [Parameter] public int Count { get; set; }
    /// <summary>Gets or sets the semantic color role.</summary>
    [Parameter] public MoVisualRole Role { get; set; } = MoVisualRole.Neutral;
    /// <summary>Gets or sets whether absence of a report is encoded with hatching.</summary>
    [Parameter] public bool Hatched { get; set; }
    /// <summary>Gets or sets whether this reason uses a diamond marker.</summary>
    [Parameter] public bool Diamond { get; set; }
    /// <summary>Gets or sets the localized reason label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
