@using Microsoft.Extensions.DependencyInjection
@using Monica.DependencyInjection.Models
@using Monica.Framework.UI.UIDependencyInjection.Components
@inject IStringLocalizer<DependencyInjectionResource> L

<MudDialog>
    <TitleContent>
        <div class="di-inspector-title">
            <MoIcon Icon="@MoIcons.Workflow" Size="1.25rem" />
            <h2>@L["Page:Dialog:Title"]</h2>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="di-inspector">
            <header class="di-inspector-identity">
                <span class="di-inspector-eyebrow">@L["Page:Dialog:Fields:ServiceType"]</span>
                <h3>@Descriptor.ServiceTypeDisplayName</h3>
                <code>@Descriptor.ServiceType</code>
                <div class="di-inspector-identity-meta">
                    <span title="@L["Page:Dialog:Fields:Lifetime"]">@L[$"Page:Shared:Lifetimes:{Descriptor.Lifetime}"]</span>
                    <span title="@L["Page:Dialog:Fields:ImplementationKind"]">@L[$"Page:Grid:Kinds:{Descriptor.ImplementationKind}"]</span>
                    <span>@L["Page:Dialog:Fields:Index"] @Descriptor.Index</span>
                    @if (Descriptor.IsAutoRegistered)
                    {
                        <span class="di-inspector-auto-label">@L["Page:Filters:SourceOptions:AutoRegistered"]</span>
                    }
                </div>
            </header>

            <div class="di-inspector-definitions">
                <section class="di-inspector-section">
                    <h4>@L["Page:Dialog:Sections:Descriptor"]</h4>
                    <dl class="di-definition-list">
                        <div>
                            <dt>@L["Page:Dialog:Fields:ServiceAssembly"]</dt>
                            <dd>@GetTextOrFallback(Descriptor.ServiceAssemblyName)</dd>
                        </div>
                        <div>
                            <dt>@L["Page:Dialog:Fields:ServiceKey"]</dt>
                            <dd><code>@GetTextOrFallback(Descriptor.ServiceKey)</code></dd>
                        </div>
                        <div>
                            <dt>@L["Page:Dialog:Fields:IsKeyed"]</dt>
                            <dd>@GetYesNo(Descriptor.IsKeyedService)</dd>
                        </div>
                        <div>
                            <dt>@L["Page:Dialog:Fields:IsOpenGeneric"]</dt>
                            <dd>@GetYesNo(Descriptor.IsOpenGeneric)</dd>
                        </div>
                    </dl>
                </section>
                <section class="di-inspector-section">
                    <h4>@L["Page:Dialog:Sections:Implementation"]</h4>
                    <dl class="di-definition-list">
                        <div>
                            <dt>@L["Page:Dialog:Fields:ImplementationType"]</dt>
                            <dd><code>@GetTextOrFallback(Descriptor.ImplementationType)</code></dd>
                        </div>
                        <div>
                            <dt>@L["Page:Dialog:Fields:ImplementationAssembly"]</dt>
                            <dd>@GetTextOrFallback(Descriptor.ImplementationAssemblyName)</dd>
                        </div>
                        <div>
                            <dt>@L["Page:Dialog:Fields:FactoryDisplay"]</dt>
                            <dd><code>@GetTextOrFallback(Descriptor.FactoryDisplay)</code></dd>
                        </div>
                    </dl>
                </section>
            </div>

            <section class="di-provenance">
                <header class="di-provenance-header">
                    <h4>@L["Page:Dialog:Sections:AutoRegistration"]</h4>
                    @if (Descriptor.AutoRegistration is { } registration)
                    {
                        <span>@L[$"Page:Shared:Outcomes:{registration.Outcome}"]</span>
                    }
                </header>
                @if (Descriptor.AutoRegistration is { } autoRegistration)
                {
                    <dl class="di-provenance-source">
                        <div>
                            <dt>@L["Page:Dialog:Fields:SourceImplementationType"]</dt>
                            <dd><code>@autoRegistration.SourceImplementationType</code></dd>
                        </div>
                        <div>
                            <dt>@L["Page:Dialog:Fields:SourceImplementationAssembly"]</dt>
                            <dd>@GetTextOrFallback(autoRegistration.SourceImplementationAssemblyName)</dd>
                        </div>
                    </dl>
                    <dl class="di-provenance-policy">
                        <div>
                            <dt>@L["Page:Dialog:Fields:Lifetime"]</dt>
                            <dd>@L[$"Page:Shared:Lifetimes:{autoRegistration.Lifetime}"]</dd>
                        </div>
                        <div>
                            <dt>@L["Page:Dialog:Fields:LifetimeSource"]</dt>
                            <dd>@L[$"Page:Shared:LifetimeSources:{autoRegistration.LifetimeSource}"]</dd>
                        </div>
                        <div>
                            <dt>@L["Page:Dialog:Fields:RegistrationMode"]</dt>
                            <dd>@L[$"Page:Shared:RegistrationModes:{autoRegistration.RegistrationMode}"]</dd>
                        </div>
                        <div>
                            <dt>@L["Page:Dialog:Fields:Outcome"]</dt>
                            <dd>@L[$"Page:Shared:Outcomes:{autoRegistration.Outcome}"]</dd>
                        </div>
                    </dl>

                    <div class="di-inspector-exposures">
                        <div class="di-inspector-subheading">
                            <h4>@L["Page:Dialog:Fields:ExposedServices"]</h4>
                            <span>@autoRegistration.ExposedServices.Count</span>
                        </div>
                        @if (autoRegistration.ExposedServices.Count == 0)
                        {
                            <p class="di-inspector-empty">@L["Page:Issues:NoExposures"]</p>
                        }
                        else
                        {
                            <ul class="di-exposed-service-list">
                                @foreach (var exposedService in autoRegistration.ExposedServices)
                                {
                                    <li>
                                        <code>@exposedService.ServiceType</code>
                                        @if (exposedService.IsKeyedService)
                                        {
                                            <span class="di-exposed-service-key">
                                                @L["Page:Dialog:Fields:ServiceKey"]: @GetTextOrFallback(exposedService.ServiceKey)
                                            </span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    @if (autoRegistration.Issues.Count > 0)
                    {
                        <div class="di-inspector-issues">
                            <div class="di-inspector-subheading">
                                <h4>@L["Page:Dialog:Fields:Issues"]</h4>
                                <span>@autoRegistration.Issues.Count</span>
                            </div>
                            <DependencyInjectionAutoRegistrationIssueList Items="autoRegistration.Issues" />
                        </div>
                    }
                }
                else
                {
                    <p class="di-inspector-empty">@L["Page:Dialog:States:NoAutoRegistration"]</p>
                }
            </section>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="di-inspector-actions">
            <MudButton OnClick="Close" Variant="Variant.Outlined" Color="Color.Primary">@L["Page:Dialog:Close"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public DependencyInjectionDescriptorInfo Descriptor { get; set; } = null!;

    private string GetTextOrFallback(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? L["Page:States:NotAvailable"]
            : value;
    }

    private string GetYesNo(bool value)
    {
        return value
            ? L["Page:Shared:Common:Yes"]
            : L["Page:Shared:Common:No"];
    }

    private void Close()
    {
        MudDialog.Close();
    }
}
