@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Abstractions
@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation

<section class="runtime-workers" aria-labelledby="runtime-workers-heading">
    <header class="runtime-workers__heading">
        <MoIcon Icon="@MoIcons.MonitorDevices" aria-hidden="true" Size="1.5rem" />
        <div>
            <h2 id="runtime-workers-heading">@L["Runtime:Workers:Title"]</h2>
            <p>@L["Runtime:Workers:Description"]</p>
            @if (HasWorkerInsight && HasLoadedWorkerInsight && WorkerInsightObservedAtUtc is { } acceptedAt)
            {
                <div class="runtime-workers__accepted">
                    <time datetime="@acceptedAt.ToString("O")">@L["Runtime:Workers:ObservationAccepted", TimePresentation.FormatTimestamp(acceptedAt)]</time>
                </div>
            }
        </div>
    </header>

    @if (!HasWorkerInsight)
    {
        <div class="runtime-workers__hint" role="note">
            <MoIcon Icon="@MoIcons.Puzzle" aria-hidden="true" Size="1.5rem" />
            <div>
                <p>@L["Runtime:Workers:Hint"]</p>
                <code>AddJobSchedulerServiceDiscoveryInsight()</code>
            </div>
        </div>
    }
    else
    {
        @if (IsWorkerInsightFailed)
        {
            <div class="runtime-workers__failure" data-retained="@HasLoadedWorkerInsight.ToString().ToLowerInvariant()">
                <MudAlert Severity="@(HasLoadedWorkerInsight ? Severity.Warning : Severity.Error)" Variant="Variant.Outlined" Dense="true" Icon="@(HasLoadedWorkerInsight ? MoIcons.Warning : MoIcons.Error)">
                    <p>@L["Runtime:Workers:LoadFailed", FailureMessage]</p>
                    @if (HasLoadedWorkerInsight)
                    {
                        <p>@L["Runtime:Workers:Retained"]</p>
                    }
                </MudAlert>
            </div>
        }
        @if (!HasLoadedWorkerInsight)
        {
            @if (!IsWorkerInsightFailed)
            {
                <div class="runtime-workers__empty" role="status">
                    <MoIcon Icon="@MoIcons.Hourglass" aria-hidden="true" Size="1.5rem" />
                    <p>@L["Runtime:Workers:Pending"]</p>
                </div>
            }
        }
        else
        {
            <div class="runtime-workers__table">
                <MudTable T="JobSchedulerWorkerInstanceView" Items="@Workers" Dense="true" Hover="true" Square="true" Elevation="0" Breakpoint="Breakpoint.None">
                    <ColGroup>
                        <col class="runtime-workers__identity-column" />
                        <col class="runtime-workers__observation-column" />
                        <col class="runtime-workers__addresses-column" />
                    </ColGroup>
                    <HeaderContent>
                        <MudTh>@L["Runtime:Workers:Instance"]</MudTh>
                        <MudTh>@L["Runtime:Workers:Status"]</MudTh>
                        <MudTh>@L["Runtime:Workers:Addresses"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@L["Runtime:Workers:Instance"]">
                            <div class="runtime-workers__identity">
                                <strong>@context.AppName</strong>
                                <dl>
                                    <div>
                                        <dt>@L["Runtime:Workers:AppId"]</dt>
                                        <dd><code>@context.AppId</code></dd>
                                    </div>
                                    <div>
                                        <dt>@L["Runtime:Workers:Owner"]</dt>
                                        <dd><code>@context.ProjectName</code></dd>
                                    </div>
                                    <div>
                                        <dt>@L["Runtime:Workers:InstanceId"]</dt>
                                        <dd><code>@context.InstanceId</code></dd>
                                    </div>
                                    <div>
                                        <dt>@L["Runtime:Workers:Leader"]</dt>
                                        <dd>
                                            @if (context.IsLeader)
                                            {
                                                <span class="runtime-workers__leader">
                                                    <MoIcon Icon="@MoIcons.Star" aria-hidden="true" Size="1.5rem" />
                                                    @L["Runtime:Workers:IsLeader"]
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="runtime-workers__not-leader">@L["Runtime:Workers:NotLeader"]</span>
                                            }
                                        </dd>
                                    </div>
                                </dl>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="@L["Runtime:Workers:Status"]">
                            <div class="runtime-workers__observation">
                                <span class="runtime-workers__status" data-status="@context.Status.ToString().ToLowerInvariant()">
                                    <MoIcon Icon="@StatusIcon(context.Status)" aria-hidden="true" Size="1.5rem" />
                                    @StatusText(context.Status)
                                </span>
                                <dl>
                                    <div>
                                        <dt>@L["Runtime:Workers:Heartbeat"]</dt>
                                        <dd>
                                            <time datetime="@context.LastHeartbeatUtc.ToString("O")">@TimePresentation.FormatTimestamp(context.LastHeartbeatUtc)</time>
                                        </dd>
                                    </div>
                                    <div>
                                        <dt>@L["Runtime:Workers:Registered"]</dt>
                                        <dd>
                                            <time datetime="@context.RegisteredAtUtc.ToString("O")">@TimePresentation.FormatTimestamp(context.RegisteredAtUtc)</time>
                                        </dd>
                                    </div>
                                </dl>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="@L["Runtime:Workers:Addresses"]">
                            <div class="runtime-workers__addresses">
                                @if (context.ListeningAddresses.Count == 0)
                                {
                                    <p>@L["Runtime:Workers:NoAddresses"]</p>
                                }
                                else
                                {
                                    @foreach (var address in context.ListeningAddresses)
                                    {
                                        <code>@address</code>
                                    }
                                }
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="runtime-workers__empty">
                            <MoIcon Icon="@MoIcons.MonitorDevices" aria-hidden="true" Size="1.5rem" />
                            <p>@L["Runtime:Workers:Empty"]</p>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        }
    }
</section>

@code {
    /// <summary>Gets or sets the exact instance list from the last accepted optional-provider observation.</summary>
    /// <remarks>This may span every registered service; it does not establish scheduler roles or scope membership.</remarks>
    [Parameter, EditorRequired]
    public IReadOnlyList<JobSchedulerWorkerInstanceView> Workers { get; set; } = [];

    /// <summary>Gets or sets whether an optional insight provider is registered for the serving host.</summary>
    [Parameter]
    public bool HasWorkerInsight { get; set; }

    /// <summary>Gets or sets whether the provider has successfully supplied an accepted list, including an empty list.</summary>
    [Parameter]
    public bool HasLoadedWorkerInsight { get; set; }

    /// <summary>Gets or sets whether the latest provider attempt failed, independently of any retained successful list.</summary>
    [Parameter]
    public bool IsWorkerInsightFailed { get; set; }

    /// <summary>Gets or sets the latest provider failure diagnostic; a missing diagnostic remains unavailable evidence.</summary>
    [Parameter]
    public string? WorkerInsightError { get; set; }

    /// <summary>Gets or sets when the displayed optional-provider list was successfully accepted by its owner.</summary>
    /// <remarks>
    /// The caller owns authorization, independent refresh and retirement. This acceptance is not the producer's
    /// heartbeat-classification instant. The former <c>CapturedAtUtc</c> parameter is removed: consumers must stop
    /// supplying the unrelated core runtime capture and pass this list's own nullable acceptance observation.
    /// Heartbeat and registration timestamps are displayed absolutely; no new age or status is invented here.
    /// </remarks>
    [Parameter]
    public DateTimeOffset? WorkerInsightObservedAtUtc { get; set; }

    private string FailureMessage => WorkerInsightError is { Length: > 0 } error && !string.IsNullOrWhiteSpace(error)
        ? error
        : L["Runtime:Workers:Unavailable"];

    private string StatusText(JobSchedulerWorkerInstanceStatus status) => status switch
    {
        JobSchedulerWorkerInstanceStatus.Online => L["Runtime:Workers:Status:Online"],
        JobSchedulerWorkerInstanceStatus.Unhealthy => L["Runtime:Workers:Status:Unhealthy"],
        JobSchedulerWorkerInstanceStatus.Offline => L["Runtime:Workers:Status:Offline"],
        _ => L["Runtime:Workers:Unavailable"]
    };

    private static string StatusIcon(JobSchedulerWorkerInstanceStatus status) => status switch
    {
        JobSchedulerWorkerInstanceStatus.Online => MoIcons.Success,
        JobSchedulerWorkerInstanceStatus.Unhealthy => MoIcons.Clock,
        JobSchedulerWorkerInstanceStatus.Offline => MoIcons.CloudOff,
        _ => MoIcons.Help
    };
}
