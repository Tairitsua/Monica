@inject IStringLocalizer<DataChannelResource> L

<MudDialog DefaultFocus="DefaultFocus.None" Gutters="false">
    <TitleContent>
        <div class="history-confirmation__intro">
            <span class="mo-vl-tile mo-vl-role--warning"><MoIcon Icon="@MoIcons.ClearList" Size="16px" /></span>
            <div>
                <h2>@L["Workbench:ClearHistoryTitle"]</h2>
                <p>@L["ClearHistory:Description"]</p>
            </div>
            <MudIconButton Icon="@MoIcons.Close" Size="Size.Small" OnClick="Cancel" aria-label="@L["Design:Close"]" />
        </div>
    </TitleContent>
    <DialogContent>
        <div class="history-confirmation">
            <div class="history-confirmation__identity">
                <span>@L["Exceptions:Columns:ChannelId"]</span>
                <code>@ChannelId</code>
            </div>
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@MoIcons.Warning">@L["ClearHistory:Scope"]</MudAlert>
            <p class="history-confirmation__help">@L["ClearHistory:LifetimeHelp"]</p>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="history-confirmation-actions">
            <MudButton @ref="_cancel" Variant="Variant.Outlined" OnClick="Cancel">@L["Common:Actions:Cancel"]</MudButton>
            <MudButton Color="Color.Error" Variant="Variant.Filled" StartIcon="@MoIcons.ClearList" OnClick="Confirm">@L["ClearHistory:Confirm"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    /// <summary>Gets or sets the exact channel identity being confirmed; this dialog does not mutate host history.</summary>
    [Parameter, EditorRequired]
    public string ChannelId { get; set; } = string.Empty;

    private MudButton? _cancel;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _cancel is null) return;
        try { await _cancel.FocusAsync(); }
        catch (JSDisconnectedException) { }
    }

    private void Cancel() => Dialog.Cancel();
    private void Confirm() => Dialog.Close(DialogResult.Ok(true));
}
