@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using System.Globalization
@using System.Text.Json
@using Monica.Repository.Persistence.Services.Support
@using Monica.UI.Shared.Components.Dialogs
@inject IStringLocalizer<RepositoryUIResource> L
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <MoDialogHeading Text="@L["Workbench:Activity:Inspector:Title"].Value" />
    </TitleContent>
    <DialogContent>
        <div class="activity-detail">
            <div class="activity-detail__identity">
                <div class="activity-detail__identity-copy">
                    <MudText Typo="Typo.overline">@L["Workbench:Activity:Inspector:CapturedSession"]</MudText>
                    <MudText Typo="Typo.h6">@L["Workbench:Activity:Inspector:SessionHeading", Value(_row.BackendId)]</MudText>
                    <MudText Typo="Typo.body2">@L["Workbench:Activity:Inspector:SnapshotDescription"]</MudText>
                </div>
                <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@Value(_row.State)</MudChip>
            </div>

            <section class="activity-detail__section">
                <MudText Typo="Typo.subtitle2">@L["Workbench:Activity:Inspector:ProvenanceTitle"]</MudText>
                <dl class="activity-detail__provenance">
                    <div><dt>@L["Workbench:Activity:Inspector:ContextName"]</dt><dd>@Value(ContextName)</dd></div>
                    <div><dt>@L["Workbench:Activity:Inspector:ContextType"]</dt><dd>@Value(ContextFullName)</dd></div>
                    <div><dt>@L["Workbench:Activity:Inspector:ContextDatabase"]</dt><dd>@Value(ContextDatabase)</dd></div>
                    <div><dt>@L["Workbench:Activity:Inspector:Provider"]</dt><dd>@Value(ProviderName)</dd></div>
                    <div><dt>@L["Workbench:Activity:Inspector:CapturedAt"]</dt><dd>@FormatCapture(CapturedAt)</dd></div>
                </dl>
                <MudText Typo="Typo.body2" Class="activity-detail__note">@L["Workbench:Activity:Inspector:ScopeDescription"]</MudText>
            </section>

            <section class="activity-detail__section">
                <div class="activity-detail__section-heading">
                    <div class="activity-detail__section-copy">
                        <MudText Typo="Typo.subtitle2">@L["Workbench:Activity:Inspector:QueryTitle"]</MudText>
                        <MudText Typo="Typo.body2" Class="activity-detail__note">@L["Workbench:Activity:Inspector:QueryDescription"]</MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@MoIcons.Copy"
                               Disabled="@(_retired || string.IsNullOrWhiteSpace(_row.Query))"
                               aria-disabled="@(_copying || _retired || string.IsNullOrWhiteSpace(_row.Query) ? "true" : "false")"
                               OnClick="CopyQueryAsync">@L["Workbench:Activity:Inspector:CopyQuery"]</MudButton>
                </div>
                @if (string.IsNullOrWhiteSpace(_row.Query))
                {
                    <div class="activity-detail__query-empty">
                        <MudText Typo="Typo.body2">@L["Workbench:Activity:Inspector:NoQuery"]</MudText>
                    </div>
                }
                else
                {
                    <div class="activity-detail__query"><pre>@_row.Query</pre></div>
                }
            </section>

            <section class="activity-detail__section">
                <MudText Typo="Typo.subtitle2">@L["Workbench:Activity:Inspector:EvidenceTitle"]</MudText>
                <MudText Typo="Typo.body2" Class="activity-detail__note">@L["Workbench:Activity:Inspector:RuntimeDescription"]</MudText>
                @if (IsPostgreSql)
                {
                    <MudText Typo="Typo.body2" Class="activity-detail__note">@L["Workbench:Activity:PostgreSqlWaitNote"]</MudText>
                }
                <div class="activity-detail__table-boundary">
                    <MudTable T="EvidenceField" Items="@SessionFields" Dense="true" Hover="true"
                              Square="true" Elevation="0" Breakpoint="Breakpoint.Xs"
                              TableAttributes="@(new Dictionary<string, object?> { ["aria-label"] = L["Workbench:Activity:Inspector:EvidenceTitle"].Value })">
                        <HeaderContent>
                            <MudTh>@L["Workbench:Activity:Inspector:Field"]</MudTh>
                            <MudTh>@L["Workbench:Activity:Inspector:Value"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["Workbench:Activity:Inspector:Field"].Value">@context.Label</MudTd>
                            <MudTd DataLabel="@L["Workbench:Activity:Inspector:Value"].Value">
                                <span class="activity-detail__field-value">@context.Value</span>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
                <MudText Typo="Typo.body2" Class="activity-detail__note">@L["Workbench:Activity:Inspector:TimestampDescription"]</MudText>
            </section>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="activity-detail__actions">
            <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Copy"
                       Disabled="_retired" aria-disabled="@(_copying || _retired ? "true" : "false")"
                       OnClick="CopyEvidenceAsync">
                @L["Workbench:Activity:Inspector:CopyEvidence"]
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">@L["Common:Actions:Close"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly object _lifecycleSync = new();
    private RepositoryActivityRow _row = new();
    private Task _clipboardTask = Task.CompletedTask;
    private Task? _disposeTask;
    private bool _copying;
    private bool _retired;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Gets or sets the detached normalized session row captured by the opening activity view.</summary>
    [Parameter, EditorRequired] public RepositoryActivityRow Row { get; set; } = new();

    /// <summary>Gets or sets the selected Repository context's display name, which is query provenance rather than session ownership.</summary>
    [Parameter, EditorRequired] public string ContextName { get; set; } = string.Empty;

    /// <summary>Gets or sets the selected context's readable full type name.</summary>
    [Parameter] public string? ContextFullName { get; set; }

    /// <summary>Gets or sets the selected context's database, which can differ from the inspected session's database.</summary>
    [Parameter] public string? ContextDatabase { get; set; }

    /// <summary>Gets or sets the actual EF provider name that supplied the activity result.</summary>
    [Parameter] public string? ProviderName { get; set; }

    /// <summary>Gets or sets the captured guide's provider kind; null resolves it from the actual provider name.</summary>
    [Parameter] public RepositoryActivityProviderKind? ProviderKind { get; set; }

    /// <summary>Gets or sets the activity result's observation time; null means that capture metadata was unavailable.</summary>
    [Parameter, EditorRequired] public DateTimeOffset? CapturedAt { get; set; }

    protected override void OnParametersSet()
    {
        if (!_retired) _row = Row with { };
    }

    private IReadOnlyList<EvidenceField> SessionFields =>
    [
        new(L["Workbench:Activity:Inspector:Fields:BackendId"], Value(_row.BackendId)),
        new(L["Workbench:Activity:Inspector:Fields:DatabaseName"], Value(_row.DatabaseName)),
        new(L["Workbench:Activity:Inspector:Fields:State"], Value(_row.State)),
        new(L["Workbench:Activity:Inspector:Fields:UserName"], Value(_row.UserName)),
        new(L["Workbench:Activity:Inspector:Fields:ApplicationName"], Value(_row.ApplicationName)),
        new(L["Workbench:Activity:Inspector:Fields:ClientAddress"], Value(_row.ClientAddress)),
        new(L["Workbench:Activity:Inspector:Fields:ClientHostname"], Value(_row.ClientHostname)),
        new(L["Workbench:Activity:Inspector:Fields:ClientPort"], _row.ClientPort?.ToString(CultureInfo.InvariantCulture) ?? Unavailable),
        new(IsPostgreSql ? L["Workbench:Activity:LockWait"] : L["Workbench:Activity:Inspector:Fields:Waiting"], WaitingText(_row.Waiting)),
        new(L["Workbench:Activity:Inspector:Fields:Runtime"], _row.Runtime?.ToString("c", CultureInfo.InvariantCulture) ?? Unavailable),
        new(L["Workbench:Activity:Inspector:Fields:BackendStart"], FormatTimestamp(_row.BackendStart)),
        new(L["Workbench:Activity:Inspector:Fields:TransactionStart"], FormatTimestamp(_row.TransactionStart)),
        new(L["Workbench:Activity:Inspector:Fields:QueryStart"], FormatTimestamp(_row.QueryStart)),
        new(L["Workbench:Activity:Inspector:Fields:StateChange"], FormatTimestamp(_row.StateChange)),
        new(L["Workbench:Activity:Inspector:Fields:Detail"], Value(_row.Detail))
    ];

    private string Unavailable => L["Common:Values:Unavailable"];
    private string Value(string? value) => string.IsNullOrWhiteSpace(value) ? Unavailable : value;
    private string FormatTimestamp(DateTime? timestamp) => timestamp is { } value ? UiTime.Format(value) : Unavailable;
    private string FormatCapture(DateTimeOffset? timestamp) => timestamp is { } value ? UiTime.Format(value) : Unavailable;
    private bool IsPostgreSql => (ProviderKind ?? RepositoryActivityProviderGuideCatalog.Resolve(ProviderName).ProviderKind)
        == RepositoryActivityProviderKind.PostgreSql;
    private string WaitingText(bool? waiting) => waiting switch
    {
        true => IsPostgreSql ? L["Workbench:Activity:LockWait"] : L["Workbench:Activity:Inspector:Waiting"],
        false => IsPostgreSql ? L["Workbench:Activity:NoLockWait"] : L["Workbench:Activity:Inspector:NotWaiting"],
        null => IsPostgreSql ? L["Workbench:Activity:LockWaitUnknown"] : L["Workbench:Activity:Inspector:UnknownWaiting"]
    };

    private Task CopyQueryAsync() => CopyAsync(_row.Query ?? string.Empty, L["Workbench:Activity:Inspector:QueryCopied"].Value);

    private Task CopyEvidenceAsync()
    {
        if (_retired) return Task.CompletedTask;
        var evidence = JsonSerializer.Serialize(new
        {
            Scope = L["Workbench:Activity:Inspector:ScopeDescription"].Value,
            ContextName,
            ContextFullName,
            ContextDatabase,
            ProviderName,
            CapturedAt,
            Session = _row
        }, new JsonSerializerOptions { WriteIndented = true });
        return CopyAsync(evidence, L["Workbench:Activity:Inspector:EvidenceCopied"].Value);
    }

    private Task CopyAsync(string text, string successMessage)
    {
        lock (_lifecycleSync)
        {
            if (_retired || _copying || string.IsNullOrWhiteSpace(text)) return Task.CompletedTask;
            _copying = true;
            return _clipboardTask = CopyCoreAsync(text, successMessage, _lifetimeCancellation.Token);
        }
    }

    private async Task CopyCoreAsync(string text, string successMessage, CancellationToken cancellationToken)
    {
        try
        {
            var copied = await JsRuntime.InvokeAsync<bool>("MoClipboard.copyText", cancellationToken, text);
            if (_retired || cancellationToken.IsCancellationRequested) return;
            Snackbar.Add(copied ? successMessage : L["Workbench:Activity:Inspector:CopyFailed"],
                copied ? Severity.Success : Severity.Warning);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (JSException)
        {
            if (!_retired && !cancellationToken.IsCancellationRequested)
                Snackbar.Add(L["Workbench:Activity:Inspector:CopyFailed"], Severity.Warning);
        }
        finally
        {
            if (!_retired) _copying = false;
        }
    }

    private void Close()
    {
        lock (_lifecycleSync)
        {
            if (_retired) return;
            _retired = true;
        }
        MudDialog.Close();
    }

    /// <summary>Retires callbacks, cancels and drains admitted clipboard work, and releases its lifetime exactly once.</summary>
    public ValueTask DisposeAsync()
    {
        lock (_lifecycleSync)
        {
            _retired = true;
            return new ValueTask(_disposeTask ??= DisposeCoreAsync(_clipboardTask));
        }
    }

    private async Task DisposeCoreAsync(Task clipboardTask)
    {
        try
        {
            await _lifetimeCancellation.CancelAsync();
            await clipboardTask;
        }
        finally { _lifetimeCancellation.Dispose(); }
    }

    private sealed record EvidenceField(string Label, string Value);
}
