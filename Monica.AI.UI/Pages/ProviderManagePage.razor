@attribute [Route(PAGE_URL)]
@rendermode InteractiveServer
@using Microsoft.Extensions.Localization
@using Monica.AI.Configuration.Facades
@using Monica.AI.Configuration.Models
@using Monica.AI.Chat.Models
@using Monica.AI.UI.Localization
@using Monica.Core.Results
@implements IDisposable
@inject AIConfigurationFacade Configuration
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<AIResource> L

<PageTitle>@L["ProviderManage:Title"]</PageTitle>
<div class="provider-settings-page">
    <header class="settings-header">
        <div><MudText Typo="Typo.h5">@L["Settings:Title"]</MudText><MudText Typo="Typo.body2" Class="settings-description">@L["Settings:SharedSettings"]</MudText></div>
        <div class="header-actions"><MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="@_busy">@L["ProviderManage:Refresh"]</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => EditProviderAsync(null))" Disabled="@_busy">@L["Settings:AddProvider"]</MudButton></div>
    </header>
    @if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert> }
    @if (_busy) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
    <div class="settings-workspace">
        <nav class="provider-list" aria-label="@L["Provider:Label"]">
            @foreach (var provider in _snapshot.Providers)
            {
                <button type="button" class="provider-row @(provider.Configuration.ProviderId == _selectedId ? "selected" : null)" @onclick="@(() => Select(provider.Configuration.ProviderId))">
                    <span class="provider-row-title">@(provider.Configuration.DisplayName ?? provider.Configuration.ProviderId)</span>
                    <span class="provider-row-meta">@provider.Configuration.ProviderType · @L["Settings:ModelCount", provider.Configuration.Models.Count]</span>
                    <span class="provider-row-source">@Source(provider)</span>
                    @if (!provider.Configuration.Enabled) { <span class="disabled-label">@L["Settings:Disabled"]</span> }
                </button>
            }
            @if (_snapshot.Providers.Count == 0) { <div class="settings-empty">@L["Settings:NoProviders"]</div> }
        </nav>
        <main class="provider-detail">
            @if (Selected is { } selected)
            {
                var provider = selected.Configuration;
                <div class="provider-detail-heading">
                    <div><MudText Typo="Typo.h6">@(provider.DisplayName ?? provider.ProviderId)</MudText><span class="endpoint">@(provider.BaseUrl ?? L["Settings:OfficialEndpoint"])</span></div>
                    <div class="provider-actions">
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Outlined.Edit" OnClick="@(() => EditProviderAsync(selected))" Disabled="@_busy">@L["Settings:EditProvider"]</MudButton>
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Outlined.NetworkCheck" OnClick="@(() => TestProviderAsync(provider.ProviderId))" Disabled="@_busy">@L["Settings:TestConnection"]</MudButton>
                        <MudMenu Icon="@Icons.Material.Outlined.MoreHoriz" Dense="true" AriaLabel="@L["Settings:ProviderActions"]" Disabled="@_busy">
                            <MudMenuItem OnClick="@(() => SaveAsync(provider with { Enabled = !provider.Enabled }))">@(provider.Enabled ? L["Settings:Disable"] : L["Settings:Enable"])</MudMenuItem>
                            @if (selected.IsCodeDefined && selected.HasOverride) { <MudMenuItem OnClick="@(() => ResetAsync(provider.ProviderId))">@L["Settings:ResetOverride"]</MudMenuItem> }
                            @if (!selected.IsCodeDefined) { <MudMenuItem OnClick="@(() => RemoveAsync(provider.ProviderId))">@L["Settings:DeleteProvider"]</MudMenuItem> }
                        </MudMenu>
                    </div>
                </div>
                <div class="provider-facts"><span>@Source(selected)</span><span>@(selected.HasApiKey ? L["Settings:CredentialConfigured"] : L["Settings:CredentialMissing"])</span><span>@L["Settings:AppliesNextRequest"]</span></div>
                @if (selected.ValidationErrors is { Count: > 0 })
                {
                    <div class="validation-errors" role="alert">
                        <span>@L["Settings:ValidationErrors"]</span>
                        @foreach (var error in selected.ValidationErrors) { <div>@error</div> }
                    </div>
                }
                <div class="models-heading"><MudText Typo="Typo.subtitle1">@L["Settings:Models"]</MudText><div class="provider-actions"><MudButton Size="Size.Small" OnClick="DiscoverAsync" Disabled="@(_busy || !provider.Enabled)" StartIcon="@Icons.Material.Outlined.Search">@L["Settings:Discover"]</MudButton><MudButton Size="Size.Small" OnClick="@(() => EditModelAsync(null))" Disabled="@_busy" StartIcon="@Icons.Material.Filled.Add">@L["Settings:AddModel"]</MudButton></div></div>
                <div class="model-table-scroll">
                    <MudTable T="AIModelConfiguration" Items="@provider.Models" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None">
                        <HeaderContent><MudTh>@L["Model:Label"]</MudTh><MudTh>@L["Workbench:ContextCapacity"]</MudTh><MudTh>@L["Settings:Capabilities"]</MudTh><MudTh>@L["Settings:Actions"]</MudTh></HeaderContent>
                        <RowTemplate Context="model">
                            <MudTd><div class="model-identity"><strong>@(model.DisplayName ?? model.ModelName)</strong><span>@model.ModelName</span>@if(provider.DefaultModel == model.ModelName){<span class="default-model">@L["Provider:Default"]</span>}</div></MudTd>
                            <MudTd>@(model.ContextWindow is { } capacity ? $"{capacity:N0}" : model.Kind == AIModelKind.Chat ? L["Settings:DefaultContext", ChatContextCapacity.DefaultTokens] : L["Settings:Unknown"])</MudTd>
                            <MudTd><span class="capability-summary">@Capabilities(model)</span></MudTd>
                            <MudTd><div class="model-actions"><MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => EditModelAsync(model))" aria-label="@L["Settings:EditModel"]" Disabled="@_busy" /><MudMenu Icon="@Icons.Material.Outlined.MoreHoriz" Dense="true" AriaLabel="@L["Settings:ModelActions"]" Disabled="@_busy"><MudMenuItem OnClick="@(() => SaveAsync(provider with { DefaultModel = model.ModelName }))" Disabled="@(model.Kind != AIModelKind.Chat)">@L["Settings:SetDefault"]</MudMenuItem><MudMenuItem OnClick="@(() => TestModelAsync(provider.ProviderId, model.ModelName))" Disabled="@(model.Kind != AIModelKind.Chat)">@L["Settings:TestModel"]</MudMenuItem><MudMenuItem OnClick="@(() => DeleteModelAsync(model))">@L["Settings:DeleteModel"]</MudMenuItem></MudMenu></div></MudTd>
                        </RowTemplate>
                        <NoRecordsContent><MudText Typo="Typo.body2">@L["Settings:NoModels"]</MudText></NoRecordsContent>
                    </MudTable>
                </div>
                @if (_discovered.Count > 0)
                {
                    <section class="discovery-results"><MudText Typo="Typo.subtitle2">@L["Settings:DiscoveryResults"]</MudText><MudText Typo="Typo.caption">@L["Settings:DiscoveryHelp"]</MudText>
                        <MudTextField T="string" @bind-Value="_discoveryQuery" Immediate="true" Placeholder="@L["Settings:SearchModels"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Margin="Margin.Dense" />
                        <div class="discovery-list">
                            <Virtualize Items="@FilteredDiscovery" Context="model" ItemSize="42">
                                <div class="discovery-row"><span>@model.ModelName</span><MudButton Size="Size.Small" Disabled="@(_busy || provider.Models.Any(item => item.ModelName == model.ModelName))" OnClick="@(() => ImportModelAsync(model))">@L["Settings:AddModel"]</MudButton></div>
                            </Virtualize>
                        </div>
                    </section>
                }
            }
            else
            {
                <div class="settings-empty"><MudIcon Icon="@Icons.Material.Outlined.Tune" /><p>@L["Settings:SelectProvider"]</p></div>
            }
        </main>
    </div>
</div>

@code {
    public const string PAGE_URL = "/ai-providers";
    private readonly CancellationTokenSource _lifetime = new();
    private AIConfigurationSnapshot _snapshot = new();
    private string? _selectedId, _error;
    private bool _busy, _disposed;
    private IReadOnlyList<AIModelConfiguration> _discovered = [];
    private string _discoveryQuery = string.Empty;
    private AIProviderSettings? Selected => _snapshot.Providers.FirstOrDefault(item => item.Configuration.ProviderId == _selectedId);
    private ICollection<AIModelConfiguration> FilteredDiscovery => _discovered.Where(item => item.ModelName.Contains(_discoveryQuery, StringComparison.OrdinalIgnoreCase)).ToArray();
    protected override Task OnInitializedAsync() => LoadAsync();
    private void Select(string id) { _selectedId = id; _discovered = []; _discoveryQuery = string.Empty; }
    private async Task LoadAsync() => await ExecuteAsync(async () => Apply(await Configuration.GetAsync(_lifetime.Token)));
    private void Apply(Res<AIConfigurationSnapshot> result)
    {
        if (_disposed) return;
        if (result.IsFailed(out var error, out var snapshot)) { _error = error.Message; return; }
        _snapshot = snapshot;
        if (_snapshot.Providers.All(item => item.Configuration.ProviderId != _selectedId)) _selectedId = _snapshot.Providers.FirstOrDefault()?.Configuration.ProviderId;
    }
    private async Task ExecuteAsync(Func<Task> action)
    {
        if (_busy || _disposed) return;
        _busy = true; _error = null;
        try { await action(); }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception exception) { if (!_disposed) _error = exception.Message; }
        finally { if (!_disposed) _busy = false; }
    }
    private async Task EditProviderAsync(AIProviderSettings? provider)
    {
        _error = null;
        await DialogService.ShowAsync<ProviderConfigurationDialog>(provider is null ? L["Settings:AddProvider"] : L["Settings:EditProvider"],
            new DialogParameters
            {
                [nameof(ProviderConfigurationDialog.Provider)] = provider,
                [nameof(ProviderConfigurationDialog.OnSave)] = (Func<ProviderConfigurationEdit, CancellationToken, Task<string?>>)SaveDialogAsync,
                [nameof(ProviderConfigurationDialog.OnDiscover)] = (Func<ProviderConfigurationEdit, CancellationToken, Task<Res<IReadOnlyList<AIModelConfiguration>>>>)((draft, ct) =>
                    Configuration.DiscoverDraftModelsAsync(draft.Configuration, draft.ApiKey, provider?.HasApiKey == true && !draft.ClearApiKey, ct))
            }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true });
    }
    private async Task<string?> SaveDialogAsync(ProviderConfigurationEdit edit, CancellationToken cancellationToken = default)
    {
        if (_disposed) return L["Error:Generic"];
        using var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token, cancellationToken);
        var result = await Configuration.UpsertProviderAsync(edit.Configuration, edit.ApiKey, edit.ClearApiKey, _snapshot.Revision, cancellation.Token);
        if (_disposed) return L["Error:Generic"];
        if (result.IsFailed(out var error)) return error.Message ?? L["Error:Generic"];
        Apply(result);
        _selectedId = edit.Configuration.ProviderId;
        await InvokeAsync(StateHasChanged);
        return null;
    }
    private Task SaveAsync(AIProviderConfiguration provider) => ExecuteAsync(async () => Apply(await Configuration.UpsertProviderAsync(provider, null, false, _snapshot.Revision, _lifetime.Token)));
    private Task ResetAsync(string id) => ExecuteAsync(async () => Apply(await Configuration.ResetProviderAsync(id, _snapshot.Revision, _lifetime.Token)));
    private async Task RemoveAsync(string id)
    {
        var yes = await DialogService.ShowMessageBoxAsync(L["Settings:DeleteProvider"], L["Settings:DeleteProviderConfirm"], yesText: L["Common:Delete"], noText: L["Common:Actions:Cancel"]);
        if (!_disposed && yes == true) await ExecuteAsync(async () => Apply(await Configuration.RemoveProviderAsync(id, _snapshot.Revision, _lifetime.Token)));
    }
    private async Task EditModelAsync(AIModelConfiguration? model)
    {
        var provider = Selected?.Configuration;
        if (provider is null) return;
        _error = null;
        await DialogService.ShowAsync<ModelConfigurationDialog>(model is null ? L["Settings:AddModel"] : L["Settings:EditModel"],
            new DialogParameters
            {
                [nameof(ModelConfigurationDialog.Model)] = model,
                [nameof(ModelConfigurationDialog.ProviderType)] = provider.ProviderType,
                [nameof(ModelConfigurationDialog.OnSave)] = (Func<AIModelConfiguration, Task<string?>>)(saved => SaveDialogAsync(new ProviderConfigurationEdit(provider with
                {
                    Models = provider.Models.Where(item => item.ModelName != model?.ModelName && item.ModelName != saved.ModelName).Append(saved).ToArray(),
                    DefaultModel = provider.DefaultModel == model?.ModelName ? saved.ModelName : provider.DefaultModel
                }, null, false)))
            }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true });
    }
    private Task DeleteModelAsync(AIModelConfiguration model)
    {
        var provider = Selected!.Configuration;
        return SaveAsync(provider with { Models = provider.Models.Where(item => item.ModelName != model.ModelName).ToArray(), DefaultModel = provider.DefaultModel == model.ModelName ? null : provider.DefaultModel });
    }
    private Task ImportModelAsync(AIModelConfiguration model) => SaveAsync(Selected!.Configuration with { Models = Selected.Configuration.Models.Append(model).ToArray() });
    private Task DiscoverAsync() => ExecuteAsync(async () =>
    {
        var result = await Configuration.DiscoverModelsAsync(_selectedId!, _lifetime.Token);
        if (_disposed) return;
        if (result.IsFailed(out var error, out var models)) _error = error.Message; else _discovered = models;
    });
    private Task TestProviderAsync(string id) => ExecuteAsync(async () => ShowTest(await Configuration.TestProviderAsync(id, _lifetime.Token)));
    private Task TestModelAsync(string providerId, string model) => ExecuteAsync(async () => ShowTest(await Configuration.TestModelAsync(providerId, model, _lifetime.Token)));
    private void ShowTest(Res result)
    {
        if (_disposed) return;
        if (result.IsFailed(out var error)) _error = error.Message;
        else Snackbar.Add(L["Settings:TestSucceeded"], Severity.Success);
    }
    private string Source(AIProviderSettings provider) => provider.IsCodeDefined ? provider.HasOverride ? L["Settings:CodeOverride"] : L["Settings:CodeDefaults"] : L["Settings:Persisted"];
    private string Capabilities(AIModelConfiguration model)
    {
        if (model.Kind == AIModelKind.Embedding) return L["Settings:Embedding"];
        var names = new List<string>();
        if (model.SupportsImage == true) names.Add(L["Settings:ImageInput"]);
        if (model.SupportsDocuments == true) names.Add(L["Settings:NativeDocuments"]);
        if (model.SupportsTools == true) names.Add(L["Settings:FunctionTools"]);
        if (model.SupportsReasoning == true) names.Add(L["Workbench:Reasoning"]);
        return names.Count > 0 ? string.Join(" · ", names)
            : L[model.SupportsImage == false && model.SupportsDocuments == false && model.SupportsTools == false && model.SupportsReasoning == false
                ? "Settings:TextOnly" : "Settings:Unknown"];
    }
    public void Dispose() { _disposed = true; _lifetime.Cancel(); _lifetime.Dispose(); }
}
