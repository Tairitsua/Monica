@attribute [Route(PAGE_URL)]
@using Microsoft.Extensions.Localization
@using Monica.AI.Configuration.Facades
@using Monica.AI.Configuration.Models
@using Monica.AI.Chat.Models
@using Monica.AI.Models
@using Monica.AI.UI.Localization
@using Monica.AI.UI.Shared.Components
@inject AIConfigurationFacade Configuration
@inject IDialogService DialogService
@inject IStringLocalizer<AIResource> L
@implements IAsyncDisposable

<PageTitle>@L["Settings:Title"]</PageTitle>
<div class="provider-administration">
    <AIAdministrationHeader Title="@L["Administration:Providers"]" Description="@L["Administration:ProviderScope"]" IsProviderPage="true">
        <Actions>
            <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" aria-disabled="@(State.IsBusy ? "true" : "false")" OnClick="RefreshAsync">@L["Common:Actions:Refresh"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Add" aria-disabled="@(State.IsBusy ? "true" : "false")" OnClick="@(() => EditProviderAsync(null))">@L["Settings:AddProvider"]</MudButton>
        </Actions>
    </AIAdministrationHeader>
    @if (State.Error is not null) { <div class="provider-error"><MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@State.Error @if (State.HasLoaded) { <span>@L["Administration:RetainedSnapshot"]</span> }</MudAlert></div> }
    @if (State.IsBusy) { <div class="provider-progress"><MudProgressLinear Indeterminate="true" Color="Color.Primary" /></div> }
    @if (!State.HasLoaded) { <div class="provider-empty"><MoContentState Loading="@State.IsBusy"><MoIcon Icon="@MoIcons.Network" Size="1.5rem" /><h2>@L[State.IsBusy ? "Administration:Loading" : "Administration:Unavailable"]</h2></MoContentState></div> }
    else if (State.Snapshot.Providers.Count == 0) { <section class="provider-empty"><MoContentState><MoIcon Icon="@MoIcons.Network" Size="1.5rem" /><h2>@L["Administration:NoProviders"]</h2><p>@L["Settings:EmptyProviders"]</p><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => EditProviderAsync(null))">@L["Settings:AddProvider"]</MudButton></MoContentState></section> }
    else
    {
        <div class="provider-workspace">
            <aside class="provider-index mo-self-painted @(_catalogExpanded ? "catalog-open" : "catalog-closed")">
                <div class="provider-index-heading"><h2>@L["Administration:ProviderCatalog"]</h2><span class="provider-count">@State.Snapshot.Providers.Count</span></div>
                <button type="button" class="provider-compact-toggle" aria-expanded="@_catalogExpanded.ToString().ToLowerInvariant()" aria-controls="ai-provider-catalog" @onclick="ToggleCatalog">
                    <span><strong>@(State.SelectedProvider is { } current ? DisplayName(current.Configuration) : L["Administration:ProviderCatalog"])</strong><small>@L["Administration:ProviderCount", State.VisibleProviders.Count, State.Snapshot.Providers.Count]</small></span>
                    <span>@L["Administration:ChangeProvider"] <MoIcon Icon="@(_catalogExpanded ? MoIcons.ChevronUp : MoIcons.ChevronDown)" Size="1.5rem" /></span>
                </button>
                    <div id="ai-provider-catalog" class="provider-index-body">
                        <MudTextField ClearIcon="@MoIcons.Close" T="string" Value="@State.ProviderQuery" ValueChanged="State.SetProviderQuery" Label="@L["Administration:SearchProviders"]" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Clearable="true" />
                        <nav class="provider-index-list" aria-label="@L["Settings:Provider"]">
                            @foreach (var item in State.VisibleProviders)
                            {
                                var configuration = item.Configuration;
                                <button class="provider-index-row @(Same(configuration.ProviderId, State.SelectedProviderId) ? "selected" : null)" aria-pressed="@Same(configuration.ProviderId, State.SelectedProviderId).ToString().ToLowerInvariant()" @onclick="@(() => SelectProvider(configuration.ProviderId))">
                                    <span class="provider-index-name">@DisplayName(configuration)</span><span class="provider-index-meta">@configuration.ProviderType · @L["Administration:ModelCount", configuration.Models.Count]</span><span class="provider-index-source">@Source(item)</span><span class="provider-config-state @(item.ValidationErrors.Count > 0 ? "invalid" : configuration.Enabled ? "on" : "off")"><span class="status-dot"></span>@L[item.ValidationErrors.Count > 0 ? "Administration:InvalidConfiguration" : configuration.Enabled ? "Administration:ConfigOn" : "Administration:ConfigOff"]</span>
                                </button>
                            }
                        </nav>
                        @if (State.VisibleProviders.Count == 0) { <div class="provider-no-match"><MoContentState Compact="true"><p>@L["Administration:NoProviderMatches"]</p><MudButton OnClick="State.ClearFilters">@L["Administration:ClearFilters"]</MudButton></MoContentState></div> }
                        <p class="provider-filter-count">@L["Administration:ProviderCount", State.VisibleProviders.Count, State.Snapshot.Providers.Count]</p>
                    </div>
            </aside>
            <div class="provider-detail">
                @if (State.SelectedProvider is { } selected)
                {
                    var provider = selected.Configuration;
                    @if (!State.VisibleProviders.Any(item => Same(item.Configuration.ProviderId, provider.ProviderId))) { <p class="selection-context">@L["Administration:SelectionOutsideFilter"]</p> }
                    <section class="provider-connection-sheet mo-self-painted" aria-label="@L["Administration:Connection"]">
                        <div class="provider-identity"><span class="provider-kicker">@L["Settings:Provider"]</span><h2 tabindex="-1" @ref="_detailHeading">@DisplayName(provider)</h2><code>@provider.ProviderId</code><div class="provider-identity-facts"><span>@provider.ProviderType</span>@if (provider.IsDefault) { <span class="provider-default"><MoIcon Icon="@MoIcons.Star" Size="1.5rem" />@L["Settings:DefaultProvider"]</span> }</div></div>
                        <div class="provider-connection-facts"><span class="provider-kicker">@L["Administration:Connection"]</span><p class="provider-endpoint">@(string.IsNullOrWhiteSpace(provider.BaseUrl) ? L["Administration:OfficialEndpoint"].Value : provider.BaseUrl)</p>
                            <dl class="connection-definition"><div><dt>@L["Administration:Origin"]</dt><dd>@Source(selected)</dd></div><div><dt>@L["Administration:Credentials"]</dt><dd>@L[selected.HasApiKey ? "Settings:CredentialConfigured" : "Settings:CredentialMissing"]</dd></div><div><dt>@L["Administration:Configuration"]</dt><dd class="@(provider.Enabled ? "configuration-on" : null)">@L[provider.Enabled ? "Administration:ConfigOn" : "Administration:ConfigOff"]</dd></div></dl>
                            <div class="provider-actions"><MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Edit" aria-disabled="@(State.IsBusy ? "true" : "false")" OnClick="@(() => EditProviderAsync(selected))">@L["Settings:EditProvider"]</MudButton><MudTooltip Text="@L["Administration:ConnectionTestHelp"]"><MudButton Variant="Variant.Text" StartIcon="@MoIcons.Pulse" aria-disabled="@(State.IsBusy ? "true" : "false")" OnClick="TestProviderAsync">@L["Settings:TestConnection"]</MudButton></MudTooltip><MudMenu Icon="@MoIcons.MoreHorizontal" AriaLabel="@L["Administration:ProviderActions"]" aria-disabled="@(State.IsBusy ? "true" : "false")"><MudMenuItem OnClick="ToggleProviderAsync">@L[provider.Enabled ? "Settings:Disable" : "Settings:Enable"]</MudMenuItem>@if (selected.IsCodeDefined && selected.HasOverride) { <MudMenuItem OnClick="ResetProviderAsync">@L["Settings:ResetOverride"]</MudMenuItem> }@if (!selected.IsCodeDefined) { <MudMenuItem OnClick="RemoveProviderAsync">@L["Settings:DeleteProvider"]</MudMenuItem> }</MudMenu></div>
                        </div>
                    </section>
                    <p class="provider-scope-note">@L["Administration:NextRequests"] <span>@L["Administration:Revision", State.Snapshot.Revision]</span></p>
                    @if (selected.ValidationErrors.Count > 0) { <div class="provider-validation"><MudAlert Icon="@MoIcons.Error" Severity="Severity.Error"><strong>@L["Administration:InvalidConfiguration"]</strong><ul>@foreach (var diagnostic in selected.ValidationErrors) { <li>@diagnostic</li> }</ul></MudAlert></div> }
                    @if (State.LastProbe is { } probe) { <div class="provider-probe"><MudAlert Icon="@(probe.Success ? MoIcons.Success : MoIcons.Error)" Severity="@(probe.Success ? Severity.Success : Severity.Error)" Dense="true"><strong>@L[probe.IsInference ? "Administration:ModelTest" : "Administration:ListingTest"]</strong> @if (probe.ModelName is not null) { <code>@probe.ModelName</code> } <span>@(probe.Error ?? L["Settings:TestSucceeded"].Value)</span></MudAlert></div> }
                    <section class="provider-models" aria-label="@L["Settings:Models"]">
                        <div class="provider-section-heading"><div><h3 tabindex="-1" @ref="_modelsHeading">@L["Settings:Models"]</h3><p>@L["Administration:ModelInventoryScope"]</p></div><div class="provider-actions"><MudButton StartIcon="@MoIcons.Search" Disabled="@(!provider.Enabled)" aria-disabled="@(State.IsBusy || !provider.Enabled ? "true" : "false")" OnClick="DiscoverAsync">@L["Settings:Discover"]</MudButton><MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Add" aria-disabled="@(State.IsBusy ? "true" : "false")" OnClick="@(() => EditModelAsync(null))">@L["Settings:AddModel"]</MudButton></div></div>
                        <div class="provider-model-filter"><MudTextField ClearIcon="@MoIcons.Close" T="string" Value="@State.ModelQuery" ValueChanged="State.SetModelQuery" Label="@L["Administration:SearchModels"]" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" Clearable="true" Immediate="true" /><div class="model-kind-filters" role="group" aria-label="@L["Settings:ModelKind"]">@foreach (var kind in new AIModelKind?[] { null, AIModelKind.Chat, AIModelKind.Embedding }) { <button class="kind-filter @(State.ModelKindFilter == kind ? "selected" : null)" aria-pressed="@((State.ModelKindFilter == kind).ToString().ToLowerInvariant())" @onclick="@(() => State.SetModelKindFilter(kind))">@L[kind is null ? "Administration:AllModels" : kind == AIModelKind.Chat ? "Settings:Chat" : "Settings:Embedding"]</button> }</div></div>
                        <p class="model-count">@L["Administration:VisibleModels", State.VisibleModels.Count, provider.Models.Count]</p>
                        <div class="provider-model-inventory mo-self-painted">
                            @foreach (var model in State.VisibleModels)
                            {
                                <article class="provider-model-row"><div class="model-purpose"><MoIcon Icon="@(model.Kind == AIModelKind.Chat ? MoIcons.Bot : MoIcons.Brackets)" Size="1.5rem" /></div><div class="model-identity"><div class="model-title"><h4>@(model.DisplayName ?? model.ModelName)</h4>@if (Same(provider.DefaultModel, model.ModelName)) { <span class="model-default">@L["Settings:DefaultModel"]</span> }</div><code>@model.ModelName</code>@if (!string.IsNullOrWhiteSpace(model.Description)) { <p>@model.Description</p> }<ModelCapabilityBadges Model="@model" /></div><dl class="model-capacity"><div><dt>@L["Settings:ContextWindow"]</dt><dd title="@(model.ContextWindow?.ToString(System.Globalization.CultureInfo.InvariantCulture))">@(model.ContextWindow is { } context ? TokenQuantity.Format(context) : model.Kind == AIModelKind.Chat ? TokenQuantity.Format(ChatContextCapacity.DefaultTokens) : L["Common:Unknown"].Value)@if (model.ContextWindow is null && model.Kind == AIModelKind.Chat) { <small>@L["Administration:PlanningFallback"]</small> }</dd></div>@if (model.Kind == AIModelKind.Chat) { <div><dt>@L["Settings:MaxOutputTokens"]</dt><dd title="@(model.MaxOutputTokens?.ToString(System.Globalization.CultureInfo.InvariantCulture))">@(model.MaxOutputTokens is { } output ? TokenQuantity.Format(output) : L["Common:Unknown"].Value)</dd></div> }else { <div><dt>@L["Settings:EmbeddingDimensions"]</dt><dd>@(model.EmbeddingDimensions?.ToString() ?? L["Common:Unknown"].Value)</dd></div> }</dl><div class="model-actions"><MudIconButton Icon="@MoIcons.Edit" aria-label="@L["Administration:EditModelNamed", model.ModelName]" aria-disabled="@(State.IsBusy ? "true" : "false")" OnClick="@(() => EditModelAsync(model))" /><MudMenu Icon="@MoIcons.MoreHorizontal" AriaLabel="@L["Administration:ModelActionsNamed", model.ModelName]" aria-disabled="@(State.IsBusy ? "true" : "false")">@if (model.Kind == AIModelKind.Chat) { <MudMenuItem OnClick="@(() => SetDefaultModelAsync(model))">@L["Settings:SetDefault"]</MudMenuItem><MudMenuItem OnClick="@(() => TestModelAsync(model))">@L["Administration:TestModelUsage"]</MudMenuItem> }<MudMenuItem OnClick="@(() => DeleteModelAsync(model))">@L["Common:Delete"]</MudMenuItem></MudMenu></div></article>
                            }
                            @if (State.VisibleModels.Count == 0) { <div class="provider-no-match"><MoContentState Compact="true"><h4>@L[provider.Models.Count == 0 ? "Settings:NoModels" : "Settings:NoModelMatches"]</h4></MoContentState></div> }
                        </div>
                        @if (provider.DefaultModel is null && provider.Models.Any(model => model.Kind == AIModelKind.Chat)) { <p class="provider-scope-note">@L["Administration:ImplicitDefault"]</p> }
                    </section>
                    @if (State.HasDiscovered || State.DiscoveryError is not null)
                    {
                        <section class="provider-discovery mo-self-painted"><div class="provider-section-heading"><div><h3>@L["Administration:DiscoveredModels"]</h3><p>@L["Administration:DiscoveryScope"]</p></div></div>@if (State.DiscoveryError is not null) { <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@State.DiscoveryError</MudAlert> }@if (State.HasDiscovered) { <MudTextField ClearIcon="@MoIcons.Close" T="string" Value="@State.DiscoveryQuery" ValueChanged="State.SetDiscoveryQuery" Label="@L["Administration:SearchCandidates"]" Immediate="true" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" /><div class="discovery-list">@foreach (var model in State.VisibleDiscoveredModels) { var configured = provider.Models.Any(item => Same(item.ModelName, model.ModelName)); <div class="discovery-row"><code>@model.ModelName</code><MudButton Variant="Variant.Text" aria-disabled="@(State.IsBusy || configured ? "true" : "false")" OnClick="@(() => ImportModelAsync(model))">@L[configured ? "Administration:Configured" : "Common:Add"]</MudButton></div> }@if (State.VisibleDiscoveredModels.Count == 0) { <MoContentState Compact="true">@L[State.DiscoveredModels.Count == 0 ? "Administration:NoDiscoveryResults" : "Settings:NoModelMatches"]</MoContentState> }</div> }</section>
                    }
                }
            </div>
        </div>
    }
</div>
