@if (Href is not null)
{
    <a class="rp-outline-action" href="@Href">@Content</a>
}
else
{
    <button type="button" class="rp-outline-action" aria-disabled="@(Busy ? "true" : null)" @onclick="OnClick">@Content</button>
}

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Href { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public bool Busy { get; set; }

    private RenderFragment Content => @<text><MoIcon Icon="@Icon" Size="15px" /><span>@Label</span></text>;
}
