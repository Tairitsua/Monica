@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@attribute [Route(PAGE_URL)]
@using Monica.Framework.UI.UILogging.Models
@using Monica.Framework.UI.UILogging.Support
@using Monica.Framework.UI.UILogging.State
@inject LoggingWorkspaceSession Workspace
@inject LogFileQueryService FileQuery
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<LoggingResource> L
@implements IAsyncDisposable

<PageTitle>@L["Workbench:FilesTitle"]</PageTitle>

<div class="logging-files-workbench">
    <header class="files-heading">
        <div><span class="files-eyebrow">@L["Workbench:Eyebrow"]</span><h1>@L["Workbench:FilesTitle"]</h1><p>@L["Workbench:FilesIntro"]</p></div>
        <nav aria-label="@L["Workbench:Navigation"]"><a href="@ReaderUrl">@L["Workbench:Reader"]</a><a href="@CatalogUrl" aria-current="page">@L["Workbench:Files"]</a></nav>
    </header>
    <section class="files-directory" aria-labelledby="files-directory-title">
        <div><span>@L["Workbench:Directory"]</span><h2 id="files-directory-title">@Path.GetFileName(FileQuery.LogDirectory.TrimEnd(Path.DirectorySeparatorChar))</h2><code>@FileQuery.LogDirectory</code></div>
        <div class="directory-scope"><strong>@_files.Count.ToString("N0")</strong><span>@L["Workbench:Artifacts"]</span><p>@L["Workbench:RecursiveScope"]</p></div>
    </section>
    @if (_error is not null)
    {
        <div class="files-error" role="alert"><strong>@L["Workbench:FilesFailed"]</strong><p>@_error</p></div>
    }
    <section class="files-registry" aria-label="@L["Workbench:FilesTitle"]">
        <div class="files-controls">
            <label class="files-search"><MoIcon Icon="@MoIcons.Search" Size="1.25rem" /><input type="search" placeholder="@L["Workbench:FilesSearch"]" aria-label="@L["Workbench:FilesSearch"]" value="@_keyword" @oninput="SearchChanged" /></label>
            <label class="files-sort"><span>@L["Workbench:Order"]</span><select value="@_order" @onchange="OrderChanged"><option value="modified">@L["Workbench:NewestModified"]</option><option value="name">@L["Workbench:FileName"]</option><option value="size">@L["Workbench:Largest"]</option></select></label>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.Refresh" Disabled="@_busy" OnClick="RefreshAsync">@L["Workbench:RefreshFiles"]</MudButton>
        </div>
        <div class="files-results-summary"><span>@L["Workbench:FileResults", MatchingFiles.Count, _files.Count]</span><span>@L["Workbench:FileReadAt", UiTime.FormatTime(_readAt) ?? "—"]</span></div>
        <div class="files-table-frame">
            <table class="files-table"><thead><tr><th scope="col">@L["Workbench:Artifact"]</th><th scope="col">@L["Workbench:Size"]</th><th scope="col">@L["Workbench:Modified"]</th><th scope="col">@L["Workbench:Actions"]</th></tr></thead><tbody>
            @if (_busy && _files.Count == 0)
            {
                <tr><td colspan="4" class="files-empty"><div role="status"><MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />@L["Workbench:LoadingFiles"]</div></td></tr>
            }
            else if (MatchingFiles.Count == 0)
            {
                <tr><td colspan="4" class="files-empty"><div role="status"><MoIcon Icon="@MoIcons.FolderOpen" Size="1.5rem" /><strong>@L[_error is not null ? "Workbench:DirectoryUnavailable" : _files.Count == 0 ? "Workbench:NoArtifacts" : "Workbench:NoFileMatches"]</strong><p>@L[_error is not null ? "Workbench:DirectoryRetry" : _files.Count == 0 ? "Workbench:NoArtifactsHelp" : "Workbench:NoFileMatchesHelp"]</p></div></td></tr>
            }
            else
            {
                @foreach (var file in PageFiles)
                {
                    <tr @key="file.RelativePath" data-relative-path="@file.RelativePath" class="@(string.Equals(File, file.RelativePath, StringComparison.Ordinal) ? "is-current" : "")">
                        <td class="artifact-name"><MoIcon Icon="@MoIcons.FileText" Size="1.25rem" /><div><a href="@OpenUrl(file.RelativePath)">@file.FileName</a><code>@file.RelativePath</code>@if (string.Equals(File, file.RelativePath, StringComparison.Ordinal)) { <span class="current-source">@L["Workbench:LastSource"]</span> }</div></td>
                        <td class="artifact-size" data-bytes="@file.Size"><span class="mobile-label">@L["Workbench:Size"]</span><span>@FormatSize(file.Size)</span><small>@L["Workbench:ExactBytes", file.Size.ToString("N0")]</small></td>
                        <td class="artifact-modified"><span class="mobile-label">@L["Workbench:Modified"]</span><time datetime="@file.LastModified.ToString("O")">@UiTime.Format(file.LastModified)</time></td>
                        <td class="artifact-actions"><a href="@OpenUrl(file.RelativePath)" aria-label="@L["Workbench:OpenFile", file.FileName]">@L["Workbench:Open"]<MoIcon Icon="@MoIcons.ArrowUpRight" Size="1.25rem" /></a><button type="button" disabled="@_busy" @onclick="() => DownloadAsync(file.RelativePath)" aria-label="@L["Workbench:DownloadFile", file.FileName]"><MoIcon Icon="@MoIcons.Download" Size="1.25rem" /><span>@L["Workbench:Download"]</span></button></td>
                    </tr>
                }
            }
            </tbody></table>
            <footer class="files-pager"><span>@L["Workbench:FilePage", _page + 1, PageCount]</span><div><button type="button" @onclick="PreviousPage" disabled="@(_page == 0)" aria-label="@L["Workbench:PreviousPage"]"><MoIcon Icon="@MoIcons.ChevronLeft" Size="1.5rem" /></button><button type="button" @onclick="NextPage" disabled="@(_page + 1 >= PageCount)" aria-label="@L["Workbench:NextPage"]"><MoIcon Icon="@MoIcons.ChevronRight" Size="1.5rem" /></button></div></footer>
        </div>
        <p class="files-download-scope">@L["Workbench:DownloadScope"]</p>
    </section>
</div>
