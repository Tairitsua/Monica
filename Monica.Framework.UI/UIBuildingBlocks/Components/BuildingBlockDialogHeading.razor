@using Monica.UI.Shared.Components.Dialogs
@implements IAsyncDisposable

<MoDialogHeading Text="@Text" Class="bb-dialog-heading" @ref="_heading" />

@code {
    /// <summary>Gets or sets the encoded visible heading that names the enclosing native dialog.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    private MoDialogHeading? _heading;

    /// <summary>Drains the heading's owned interop; renderer disposal of the child is idempotent.</summary>
    public ValueTask DisposeAsync() => _heading?.DisposeAsync() ?? ValueTask.CompletedTask;
}
