@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@using Monica.UI.Shared.Components.Dialogs
@inject IStringLocalizer<SystemInfoResource> L

<MudDialog>
    <TitleContent>
        <div class="system-info-restart-heading">
            <span><MoIcon Icon="@MoIcons.Power" Size="18px" /></span>
            <MoDialogHeading Text="@L["Page:Dialogs:Restart:Title"]" />
        </div>
    </TitleContent>
    <DialogContent>
        <div class="system-info-restart-dialog">
            <p>@L["Page:Dialogs:Restart:Summary"]</p>
            <div class="system-info-restart-dialog__delay">
                <MoIcon Icon="@MoIcons.Clock" Size="1.25rem" />
                @L["Page:Dialogs:Restart:DelayNotice", DelaySeconds]
            </div>
            <div class="system-info-restart-dialog__fact">
                <MoIcon Icon="@MoIcons.Info" Size="1.25rem" />
                <div><p>@L["Page:Dialogs:Restart:SupervisorNote"]</p><p>@L["Page:Dialogs:Restart:Fact"]</p></div>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">@L["Page:Dialogs:Restart:Cancel"]</MudButton>
        <MudButton OnClick="Confirm"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@MoIcons.Power">
            @L["Page:Dialogs:Restart:Confirm"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public double DelaySeconds { get; set; }

    private void Cancel() => MudDialog?.Cancel();
    private void Confirm() => MudDialog?.Close(DialogResult.Ok(true));
}
