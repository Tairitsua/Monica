@using Microsoft.Extensions.Localization
@using System.Globalization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.State
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<ModuleSystemResource> L

<section class="modules-layout" aria-labelledby="module-catalog-title">
    <header class="module-catalog-heading">
        <div class="module-catalog-total" aria-label="@L["Overview:Kpis:Declared", Session.Snapshot?.Modules.Length ?? 0]">
            <span>@(Session.Snapshot?.Modules.Length ?? 0)</span>
            <small>@L["Modules:Columns:Module"]</small>
        </div>
        <div class="module-catalog-heading__copy">
            <span class="module-catalog-eyebrow">@L["Modules:Eyebrow"]</span>
            <h2 id="module-catalog-title">@L["Modules:Title"]</h2>
        </div>
    </header>

    <div class="module-catalog-context">
        <MoFactGrid Facts="@SummaryFacts" />
        <p class="module-summary-hint">@L["Modules:Summary:ScopeHint"]</p>
    </div>

    <div class="module-filter-panel">
        <div class="module-filters">
            <div class="module-filter-field module-filter-field--search">
                <MudTextField T="string"
                              Label="@L["Modules:Filters:Search"]"
                              Placeholder="@L["Modules:Filters:SearchPlaceholder"]"
                              Value="@Session.ModuleSearch"
                              ValueChanged="@SetSearch"
                              Immediate="true"
                              Clearable="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@MoIcons.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" ClearIcon="@MoIcons.Close" />
            </div>
            <div class="module-filter-field">
                <MudSelect T="ModuleCatalogStateFilter"
                           Label="@L["Modules:Filters:State"]"
                           Value="@Session.ModuleStateFilter"
                           ValueChanged="@SetStateFilter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                    @foreach (var state in Enum.GetValues<ModuleCatalogStateFilter>())
                    {
                        <MudSelectItem T="ModuleCatalogStateFilter" Value="@state">@L[$"Enums:CatalogState:{state}"]</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="module-filter-field">
                <MudSelect T="ModuleCatalogCapabilityFilter"
                           Label="@L["Modules:Filters:Capability"]"
                           Value="@Session.ModuleCapabilityFilter"
                           ValueChanged="@SetCapabilityFilter"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                    @foreach (var capability in Enum.GetValues<ModuleCatalogCapabilityFilter>())
                    {
                        <MudSelectItem T="ModuleCatalogCapabilityFilter" Value="@capability">@L[$"Enums:CatalogCapability:{capability}"]</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="module-filter-field">
                <MudSelect T="string"
                           Label="@L["Modules:Filters:Assembly"]"
                           Value="@Session.ModuleAssemblyFilter"
                           ValueChanged="@SetAssemblyFilter"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" ClearIcon="@MoIcons.Close">
                    @foreach (var assembly in Session.ModuleAssemblies)
                    {
                        <MudSelectItem T="string" Value="@assembly">@assembly</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </div>
        <div class="module-filter-options">
            <div class="module-filter-field module-filter-field--cost">
                <MudNumericField T="double"
                                 Label="@L["Modules:Filters:MinimumCost"]"
                                 Value="@Session.MinimumModuleCostMs"
                                 ValueChanged="@SetMinimumCost"
                                 Min="0"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />
            </div>
            <div class="module-filter-dependencies">
                <MudSwitch T="bool"
                           Label="@L["Modules:Filters:HasDependencies"]"
                           Value="@Session.OnlyModulesWithDependencies"
                           ValueChanged="@SetDependencyFilter"
                           Color="Color.Primary" />
            </div>
            @if (HasActiveFilters)
            {
                <div class="module-filter-actions">
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@MoIcons.FilterOff"
                               OnClick="ResetFilters">
                        @L["Actions:Reset"]
                    </MudButton>
                </div>
            }
        </div>
        <div class="module-cost-context">
            <span class="module-catalog-result" aria-live="polite">@L["Modules:ResultCount", Session.FilteredModules.Count, Session.Snapshot?.Modules.Length ?? 0]</span>
            <div class="mo-vl-legend" aria-label="@L["Modules:Cost:Legend"]">
                <span><i class="mo-vl-swatch mo-vl-role--primary"></i>@L["Modules:Cost:Callbacks"]</span>
                <span><i class="mo-vl-swatch mo-vl-role--info"></i>@L["Modules:Cost:StartupWork"]</span>
            </div>
            <p>@L["Modules:Cost:ScaleHint"]</p>
        </div>
    </div>

    <div class="module-table-wrapper" role="region" aria-label="@L["Aria:ModuleCatalog"]" tabindex="0">
        <MudTable T="ModuleDiagnosticsModule"
                  Items="@Session.PagedModules"
                  Dense="true"
                  Hover="true"
                  Elevation="0"
                  Breakpoint="Breakpoint.None"
                  RowClassFunc="@ModuleRowClass">
            <HeaderContent>
                <MudTh>@L["Modules:Columns:Module"]</MudTh>
                <MudTh>@L["Modules:Columns:Dependencies"]</MudTh>
                <MudTh>@L["Modules:Columns:Cost"]</MudTh>
                <MudTh>@L["Modules:Columns:Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate Context="module">
                <MudTd DataLabel="@L["Modules:Columns:Module"]">
                    <div class="module-name-cell" @key="module.ModuleKey">
                        <span class="module-glyph @(module.IsUiModule ? "module-glyph--ui" : module.IsWebModule ? "module-glyph--web" : null)" aria-hidden="true"><MoIcon Icon="@ModuleIcon(module)" Size="1.25rem" /></span>
                        <div class="module-name-cell__identity">
                            <button type="button" class="module-type-name" title="@module.FullTypeName" aria-label="@L["Aria:InspectModule", module.TypeName]" @onclick="@(() => ModuleSelected.InvokeAsync(module))">@module.TypeName</button>
                            <div class="module-full-identity"><IdentifierValue Value="@module.FullTypeName" /></div>
                            <div class="module-source-cell">
                                <code title="@L["Modules:Columns:Assembly"]">@module.AssemblyName</code>
                                <span>@L["Modules:Columns:Depth"] <b>@module.DependencyDepth</b></span>
                                <span>@L["ModuleDrawer:Fields:Order"] <b>@(module.RegistrationOrder?.ToString() ?? L["Common:NotAvailable"].Value)</b></span>
                            </div>
                            <div class="module-identity-facts">
                                <span class="module-state @(module.IsActive ? "module-state--active" : "module-state--disabled")"
                                      title="@L["Modules:Columns:State"]">
                                    @(module.IsActive ? L["Enums:ModuleState:Active"] : L["Enums:ModuleState:Disabled"])
                                </span>
                                <span class="module-capabilities">
                                    @if (module.IsUiModule)
                                    {
                                        <span class="module-capability--ui">@L["Enums:CatalogCapability:Ui"]</span>
                                    }
                                    @if (module.IsWebModule)
                                    {
                                        <span class="module-capability--web">@L["Enums:CatalogCapability:Web"]</span>
                                    }
                                    @if (module.RequiresWebHost)
                                    {
                                        <span>@L["Enums:CatalogCapability:WebHostRequired"]</span>
                                    }
                                </span>
                            </div>
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="@L["Modules:Columns:Dependencies"]">
                    <dl class="module-relationships" aria-label="@L["Modules:DependencyCounts", module.DirectDependencyCount, module.DirectDependentCount]">
                        <div><dt>@L["Dependencies:Legend:Requires"]</dt><dd>@module.DirectDependencyCount</dd></div>
                        <div><dt>@L["Dependencies:Legend:RequiredBy"]</dt><dd>@module.DirectDependentCount</dd></div>
                    </dl>
                </MudTd>
                <MudTd DataLabel="@L["Modules:Columns:Cost"]">
                    <div class="module-record-cost">
                        <strong class="module-record-total">@ModuleDiagnosticsDisplay.Duration(ModuleCost(module))</strong>
                        @{
                            string? workCaption = null;
                            if (module.StartupWorkDurationMs > 0)
                            {
                                workCaption = L["Overview:Ledger:Cap:Work", ModuleDiagnosticsDisplay.Duration(module.StartupWorkDurationMs)];
                            }
                        }
                        <MoTwoRoleMeter PrimaryValue="@module.SerialCallbackDurationMs"
                                        SecondaryValue="@module.StartupWorkDurationMs"
                                        ScaleMaximum="@MaximumModuleCost"
                                        PrimaryCaption="@L["Overview:Ledger:Cap:Callback", ModuleDiagnosticsDisplay.Duration(module.SerialCallbackDurationMs)]"
                                        SecondaryCaption="@workCaption"
                                        AccessibleDescription="@L["Modules:Cost:MeterAria",
                                            module.TypeName,
                                            ModuleDiagnosticsDisplay.Duration(module.SerialCallbackDurationMs),
                                            ModuleDiagnosticsDisplay.Duration(module.StartupWorkDurationMs)]" />
                    </div>
                </MudTd>
                <MudTd DataLabel="@L["Modules:Columns:Actions"]">
                    <div class="module-record-action">
                        <MudIconButton Icon="@MoIcons.ChevronRight"
                                       Color="Color.Default"
                                       OnClick="@(() => ModuleSelected.InvokeAsync(module))"
                                       aria-label="@L["Aria:InspectModule", module.TypeName]" />
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MoContentState Compact="true"><p>@L["Modules:Empty"]</p></MoContentState>
            </NoRecordsContent>
        </MudTable>
    </div>

    <footer class="module-pagination">
        <MudPagination Count="@Session.ModulePageCount"
                       Selected="@Session.ModulePage"
                       SelectedChanged="@SetPage"
                       ShowFirstButton="true"
                       ShowLastButton="true" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" />
        <div class="module-page-size">
            <MudSelect T="int"
                       Label="@L["Common:RowsPerPage"]"
                       Value="@Session.ModulePageSize"
                       ValueChanged="@SetPageSize"
                       Dense="true"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                <MudSelectItem T="int" Value="25">25</MudSelectItem>
                <MudSelectItem T="int" Value="50">50</MudSelectItem>
                <MudSelectItem T="int" Value="100">100</MudSelectItem>
            </MudSelect>
        </div>
    </footer>
</section>

@code {
    [Parameter, EditorRequired] public ModuleSystemWorkbenchSession Session { get; set; } = default!;
    [Parameter] public EventCallback<ModuleDiagnosticsModule> ModuleSelected { get; set; }

    private IReadOnlyList<MoFact> SummaryFacts =>
    [
        new(L["Modules:Summary:Active"], ActiveModuleCount.ToString(CultureInfo.InvariantCulture)),
        new(L["Modules:Summary:Ui"], UiModuleCount.ToString(CultureInfo.InvariantCulture)),
        new(L["Modules:Summary:Web"], WebModuleCount.ToString(CultureInfo.InvariantCulture)),
        new(L["Modules:Summary:MaximumDepth"], MaximumDependencyDepth.ToString(CultureInfo.InvariantCulture)),
    ];

    private void SetSearch(string? value) => SetFilters(search: value ?? string.Empty);
    private void SetStateFilter(ModuleCatalogStateFilter value) => SetFilters(state: value);
    private void SetCapabilityFilter(ModuleCatalogCapabilityFilter value) => SetFilters(capability: value);
    private void SetAssemblyFilter(string? value) => Session.SetModuleFilters(
        Session.ModuleSearch,
        Session.ModuleStateFilter,
        Session.ModuleCapabilityFilter,
        value,
        Session.OnlyModulesWithDependencies,
        Session.MinimumModuleCostMs);
    private void SetDependencyFilter(bool value) => SetFilters(onlyWithDependencies: value);
    private void SetMinimumCost(double value) => SetFilters(minimumCost: value);

    private void SetFilters(
        string? search = null,
        ModuleCatalogStateFilter? state = null,
        ModuleCatalogCapabilityFilter? capability = null,
        bool? onlyWithDependencies = null,
        double? minimumCost = null)
    {
        Session.SetModuleFilters(
            search ?? Session.ModuleSearch,
            state ?? Session.ModuleStateFilter,
            capability ?? Session.ModuleCapabilityFilter,
            Session.ModuleAssemblyFilter,
            onlyWithDependencies ?? Session.OnlyModulesWithDependencies,
            minimumCost ?? Session.MinimumModuleCostMs);
    }

    private void SetPage(int page) => Session.SetModulePaging(page, Session.ModulePageSize);
    private void SetPageSize(int pageSize) => Session.SetModulePaging(1, pageSize);

    private int ActiveModuleCount => Session.Snapshot?.Modules.Count(static module => module.IsActive) ?? 0;
    private int UiModuleCount => Session.Snapshot?.Modules.Count(static module => module.IsUiModule) ?? 0;
    private int WebModuleCount => Session.Snapshot?.Modules.Count(static module => module.IsWebModule) ?? 0;
    private int MaximumDependencyDepth => Session.Snapshot?.Modules
        .Select(static module => module.DependencyDepth)
        .DefaultIfEmpty(0)
        .Max() ?? 0;
    private double MaximumModuleCost => Session.Snapshot?.Modules
        .Select(ModuleCost)
        .DefaultIfEmpty(0)
        .Max() ?? 0;
    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(Session.ModuleSearch)
                                     || Session.ModuleStateFilter != ModuleCatalogStateFilter.All
                                     || Session.ModuleCapabilityFilter != ModuleCatalogCapabilityFilter.All
                                     || !string.IsNullOrWhiteSpace(Session.ModuleAssemblyFilter)
                                     || Session.OnlyModulesWithDependencies
                                     || Session.MinimumModuleCostMs > 0;

    private void ResetFilters() => Session.SetModuleFilters(
        string.Empty,
        ModuleCatalogStateFilter.All,
        ModuleCatalogCapabilityFilter.All,
        assembly: null,
        onlyWithDependencies: false,
        minimumCostMs: 0);

    private string ModuleRowClass(ModuleDiagnosticsModule module, int _) =>
        Session.SelectedModule?.ModuleKey == module.ModuleKey ? "module-row-selected" : string.Empty;

    private static string ModuleIcon(ModuleDiagnosticsModule module) => module switch
    {
        { IsUiModule: true } => MoIcons.Dashboard,
        { IsWebModule: true } => MoIcons.Globe,
        _ => MoIcons.Puzzle
    };

    private static double ModuleCost(ModuleDiagnosticsModule module) =>
        module.SerialCallbackDurationMs + module.StartupWorkDurationMs;
}
