@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation
<section class="job-schedule-panel" aria-labelledby="job-schedule-heading">
    <header><div><h2 id="job-schedule-heading">@L[Declaration.JobType==JobType.Recurring ? "Architecture:Cursor" : "JobDetail:Schedule:TriggeredTitle"]</h2><p>@L[Declaration.JobType==JobType.Recurring ? "Architecture:CursorNote" : "JobDetail:Schedule:TriggeredDescription"]</p></div>@if(Declaration.JobType==JobType.Recurring) { <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.CalendarDays" OnClick="OnInspectSchedule">@L["Workspace:EditCron"]</MudButton> }</header>
    <div class="job-schedule-panel__cursor"><SchedulerScheduleState Summary="@Summary" /></div>
    @if(Declaration.JobType==JobType.Recurring)
    {
        <dl><div><dt>@L["JobDetail:Schedule:CronExpression"]</dt><dd><code>@Schedule.CronExpression</code><CronDescriptionBadge Expression="@Schedule.CronExpression" ShowExpression="false" ResolveDescription="true" /></dd></div><div><dt>@L["JobDetail:Schedule:TimeZone"]</dt><dd><code>@Schedule.TimeZoneId</code></dd></div><div><dt>@L["Policy:Provenance:Declared"]</dt><dd><code>@Declaration.CronExpression</code></dd></div><div><dt>@L["Policy:Provenance:Override"]</dt><dd><code>@(Summary.Definition.Policy.Overrides.ScheduleOverride?.CronExpression ?? L["Policy:InheritDefault"])</code></dd></div><div><dt>@L["Architecture:StartBound"]</dt><dd>@(Schedule.StartTimeUtc is {} start ? TimePresentation.FormatScheduleTimestamp(start) : L["Architecture:Unbounded"])</dd></div><div><dt>@L["Architecture:EndBound"]</dt><dd>@(Schedule.EndTimeUtc is {} end ? TimePresentation.FormatScheduleTimestamp(end) : L["Architecture:Unbounded"])</dd></div></dl>
        @if(IsManualSuppressed || IsOperatorPaused || !Summary.Definition.IsPresent) { <p class="job-schedule-panel__notice">@ScheduleStatusDescription</p> }
    }
    else { <dl><div><dt>@L["JobDetail:Contract:ArgumentsKey"]</dt><dd><code>@Declaration.JobArgsKey</code></dd></div></dl> }
</section>
@code {
    /// <summary>
    /// Gets the operational snapshot whose schedule is rendered.
    /// </summary>
    [Parameter, EditorRequired]
    public JobOperationalSummary Summary { get; set; } = null!;

    /// <summary>
    /// Gets the callback that opens the complete editable recurring schedule and policy workbench.
    /// </summary>
    [Parameter]
    public EventCallback OnInspectSchedule { get; set; }

    private JobDeclaration Declaration => Summary.Definition.Declaration;

    private RecurringScheduleDefinition Schedule => Summary.Definition.EffectiveConfiguration.Schedule!;

    private bool IsOperatorPaused => JobSchedulerUiPresentation.IsOperatorPaused(Summary);

    private bool IsManualSuppressed => JobSchedulerUiPresentation.IsManualSuppressed(Summary);

    private string ScheduleStatusLabel => (IsOperatorPaused, IsManualSuppressed) switch
    {
        (true, true) => L["Catalog:Lifecycle:OperatorAndManual"],
        (true, false) => L["Catalog:Lifecycle:OperatorPaused"],
        (false, true) => L["Catalog:Lifecycle:ManualSuppressed"],
        _ => L[$"RecurringScheduleStatuses:{Summary.RecurringScheduleStatus}"]
    };

    private string ScheduleStatusDescription => (IsOperatorPaused, IsManualSuppressed) switch
    {
        (true, true) => L["JobDetail:Schedule:SuspensionDescriptions:OperatorAndManual"],
        (true, false) => L["JobDetail:Schedule:SuspensionDescriptions:OperatorPolicy"],
        (false, true) => L["JobDetail:Schedule:SuspensionDescriptions:ManualMode"],
        _ => L[$"JobDetail:Schedule:StatusDescriptions:{Summary.RecurringScheduleStatus}"]
    };

    private Color ScheduleStatusColor => IsOperatorPaused
        ? Color.Warning
        : IsManualSuppressed
            ? Color.Info
            : JobSchedulerUiPresentation.GetRecurringScheduleStatusColor(Summary.RecurringScheduleStatus);

    private string ScheduleStatusIcon => IsOperatorPaused
        ? MoIcons.PauseCircle
        : IsManualSuppressed
            ? MoIcons.Bug
            : Summary.RecurringScheduleStatus == JobRecurringScheduleStatus.Scheduled
                ? MoIcons.Clock
                : MoIcons.Info;
}
