@using Monica.UI.Shell.Models
@using Monica.UI.Shell.State
@using Monica.UI.Shell.Support

<header class="mo-navbar" data-layout="@(Shell.Layout == ShellNavigationLayout.Sidebar ? "sidebar" : "topbar")">
    <div class="mobile-navigation-toggle">
        <MudIconButton @ref="_mobileNavigationTrigger" Icon="@MoIcons.Menu" OnClick="OpenMobileNavigation"
                       aria-label="@L["NavBar:OpenNavigation"]" />
    </div>
    <div class="topbar-brand"><NavBarBrand /></div>
    <div class="sidebar-breadcrumb">
        <MoIcon Icon="@(ActiveCategory?.Icon ?? MoIcons.Shapes)" Size="16px" />
        <span class="breadcrumb-category">@ActiveCategory?.DisplayName</span>
        @foreach (var ancestor in ActiveAncestors)
        {
            <span class="breadcrumb-divider" aria-hidden="true">/</span>
            <span class="breadcrumb-category">@ancestor.DisplayName</span>
        }
        @if (ActiveItem is not null)
        {
            <span class="breadcrumb-divider" aria-hidden="true">/</span>
            <span class="breadcrumb-page">@ActiveItem.ResolveText(LocalizationCatalog)</span>
        }
    </div>
    <nav class="navbar-nav" @ref="_desktopNavRef" aria-label="@L["NavBar:Navigation"]">
        @foreach (var category in VisibleCategories)
        {
            <NavBarDropdown @key="category.Id" Group="@category" ActiveItem="@ActiveItem" />
        }
        @if (HasMoreCategories)
        {
            <NavBarMore Categories="@MoreCategories" ActiveItem="@ActiveItem" />
        }
    </nav>
    <NavBarActions />
    <div class="navbar-measurements" @ref="_measurementRailRef" aria-hidden="true">
        @foreach (var category in AllCategories)
        {
            <div data-nav-measure="category">
                <span class="navbar-measure-link">
                    @if (!string.IsNullOrEmpty(category.Icon))
                    {
                        <MoIcon Icon="@category.Icon" Class="navbar-measure-icon" />
                    }
                    @category.DisplayName
                    <MoIcon Icon="@MoIcons.ChevronDown" Class="navbar-measure-chevron" />
                </span>
            </div>
        }
        <div data-nav-measure="more">
            <span class="navbar-measure-link">@L["NavBar:More"]
                <MoIcon Icon="@MoIcons.ChevronDown" Class="navbar-measure-chevron" />
            </span>
        </div>
    </div>
</header>

<aside class="mo-sidebar" aria-label="@L["NavBar:Navigation"]" data-collapsed="@Shell.SidebarCollapsed.ToString().ToLowerInvariant()">
    <div class="category-rail">
        <div class="rail-brand"><NavBarBrand IconOnly="true" /></div>
        <nav class="rail-categories" @ref="_categoryRailRef" aria-label="@L["NavBar:Navigation"]" @onkeydown="HandleContextDrawerKeyDown">
            @foreach (var category in AllCategories)
            {
                <div @key="category.Id" class="rail-category @(IsSelectedCategory(category) ? "selected" : null)" data-navigation-category-id="@category.Id.Value">
                    <MudTooltip Text="@category.DisplayName" Placement="Placement.Right" Delay="0" Duration="0" Arrow="false"
                                Class="mo-navigation-rail-tooltip" Visible="@(_visibleCategoryTooltipId == category.Id)"
                                VisibleChanged="@((bool visible) => SetCategoryTooltipVisible(category.Id, visible))">
                        @if (Shell.SidebarCollapsed)
                        {
                            <MudIconButton @ref="_contextNavigationTriggers[category.Id]" Icon="@GetCategoryIcon(category)" Ripple="false"
                                           OnClick="@(() => OpenContextNavigation(category))"
                                           aria-label="@category.DisplayName"
                                           aria-expanded="@(IsContextCategoryOpen(category) ? "true" : "false")"
                                           aria-controls="mo-context-navigation" />
                        }
                        else
                        {
                            <MudIconButton Icon="@GetCategoryIcon(category)" OnClick="@(() => SelectCategory(category))" Ripple="false"
                                           aria-label="@category.DisplayName"
                                           aria-pressed="@(category == SelectedCategory ? "true" : "false")" />
                        }
                    </MudTooltip>
                </div>
            }
        </nav>
        <div class="rail-collapse">
            <MudIconButton Icon="@(Shell.SidebarCollapsed ? MoIcons.ExpandSidebar : MoIcons.CollapseSidebar)"
                           OnClick="Shell.ToggleSidebarAsync"
                           title="@(Shell.SidebarCollapsed ? L["NavBar:ExpandSidebar"] : L["NavBar:CollapseSidebar"])"
                           aria-label="@(Shell.SidebarCollapsed ? L["NavBar:ExpandSidebar"] : L["NavBar:CollapseSidebar"])" />
        </div>
    </div>
    <div class="sidebar-context">
        <div class="sidebar-identity"><NavBarBrand ShowIcon="false" Contextual="true" /></div>
        <div class="sidebar-pages">
        @if (SelectedCategory is { } selected)
        {
            <NavigationCategoryHeader Group="@selected" />
            <MudNavMenu Class="sidebar-tree">
                <NavigationTree @key="selected.Id" Group="@selected" ActiveItem="@ActiveItem" />
            </MudNavMenu>
        }
        </div>
        <div class="sidebar-footer">
            <button type="button" class="sidebar-collapse" @onclick="Shell.ToggleSidebarAsync">
                <MoIcon Icon="@MoIcons.CollapseSidebar" Size="16px" />
                <span>@L["NavBar:CollapseSidebar"]</span>
            </button>
        </div>
    </div>
</aside>

<div class="context-navigation-host">
<MudDrawer id="mo-context-navigation" Open="@IsContextNavigationOpen" OpenChanged="ContextNavigationChanged"
           Variant="DrawerVariant.Temporary" Width="248px" Elevation="0" Overlay="false"
           Class="mo-context-navigation" aria-label="@(ContextCategory?.DisplayName ?? L["NavBar:Navigation"])">
    @if (IsContextNavigationOpen && ContextCategory is { } contextCategory)
    {
        <div class="context-navigation-content" @onkeydown="HandleContextDrawerKeyDown">
            <div class="context-navigation-header">
                <div class="sidebar-identity"><NavBarBrand ShowIcon="false" Contextual="true" /></div>
                <MudIconButton Icon="@MoIcons.Close" OnClick="CloseContextNavigation" Size="Size.Small"
                               aria-label="@L["NavBar:CloseNavigation"]" />
            </div>
            <NavigationCategoryHeader Group="@contextCategory" />
            <CascadingValue Value="@((MudBlazor.Interfaces.INavigationEventReceiver)this)" IsFixed="true">
                <ContextNavigationTree @key="contextCategory.Id" Group="@contextCategory" ActiveItem="@ActiveItem" />
            </CascadingValue>
        </div>
    }
</MudDrawer>
<MudOverlay Visible="@IsContextNavigationOpen" AutoClose="true" OnClosed="CloseContextNavigation"
            LockScroll="false" Class="mo-context-navigation-overlay mud-skip-overlay-section" />
</div>

<MudDrawer Open="@_mobileNavigationOpen" OpenChanged="MobileNavigationChanged"
           Variant="DrawerVariant.Temporary" Width="min(320px, 90vw)" Elevation="0"
           Class="mo-mobile-navigation mo-viewport-drawer" aria-label="@L["NavBar:Navigation"]">
    <div class="mobile-navigation-content" @onkeydown="HandleDrawerKeyDown">
        @if (_mobileNavigationOpen)
        {
        <MudFocusTrap>
            <div class="mobile-navigation-header">
                <NavBarBrand ShowIcon="false" Contextual="true" />
                <MudIconButton Icon="@MoIcons.Close" OnClick="CloseMobileNavigation"
                               aria-label="@L["NavBar:CloseNavigation"]" />
            </div>
            <CascadingValue Value="@((MudBlazor.Interfaces.INavigationEventReceiver)this)" IsFixed="true">
            <nav class="mobile-navigation-tree" aria-label="@L["NavBar:Navigation"]">
                <div class="sidebar-navigation-label">@L["NavBar:Explore"]</div>
                @foreach (var category in AllCategories)
                {
                    <MoNavigationGroup @key="category.Id" Group="@category" ActiveItem="@ActiveItem"
                                       IsRoot="true" ShowGroupIcon="true" InitiallyExpanded="false" />
                }
            </nav>
            </CascadingValue>
        </MudFocusTrap>
        }
    </div>
</MudDrawer>
