@using Monica.UI.Shared.Components.States
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.DataChannel.UIDataChannel.Models
@using Monica.DataChannel.UIDataChannel.Support
@inject IStringLocalizer<DataChannelResource> L

<MudDialog>
    <DialogContent>
        <div class="exception-details-dialog">
            <header class="exception-details-identity">
                <span>@L["Exceptions:Details:Eyebrow"]</span>
                <h2>@ChannelId</h2>
                <p>@L["Exceptions:Details:Captured", UiTime.Format(ExceptionInfo.CapturedAt)]</p>
            </header>
            <section class="exception-details-strip" aria-label="@L["Exceptions:Details:SummaryAriaLabel"]">
                <div>
                    <span>@L["Exceptions:Columns:CurrentCount"]</span>
                    <strong>@ExceptionInfo.CurrentExceptions</strong>
                </div>
                <div>
                    <span>@L["Exceptions:Columns:HistoricalCount"]</span>
                    <strong>@ExceptionInfo.TotalExceptions</strong>
                </div>
                <div>
                    <span>@L["Exceptions:Columns:PoolSize"]</span>
                    <strong>@ExceptionInfo.MaxPoolSize</strong>
                </div>
                <div>
                    <span>@L["Exceptions:Details:Shown"]</span>
                    <strong>@ExceptionInfo.Exceptions.Count <small>/ @ExceptionInfo.RequestedCount</small>
                    </strong>
                </div>
            </section>
            <p class="exception-details-help">@L["Exceptions:Details:SubsetHelp"]</p>
            <div class="exception-pipeline-identity">
                <span>@L["Exceptions:Columns:PipelineId"]</span>
                <code>@ExceptionInfo.PipelineId</code>
            </div>
            <div class="exception-records">
                @if (ExceptionInfo.Exceptions.Count == 0)
                {
                    <MoContentState Compact="true"><p>@L["Exceptions:Details:Empty"]</p></MoContentState>
                }
                else
                {
                    <MudDataGrid T="ExceptionDetailInfo" Items="ExceptionInfo.Exceptions" Square="true" Elevation="0" Filterable="true" SortMode="SortMode.Multiple" Hover="true" Dense="true" ReadOnly="true" Breakpoint="Breakpoint.Md" SortIcon="@MoIcons.ArrowUp" DragIndicatorIcon="@MoIcons.GripVertical" FilterIconEmpty="@MoIcons.Filter" FilterIconFilled="@MoIcons.Filter" FilterIconClear="@MoIcons.FilterOff" ColumnOptionsIcon="@MoIcons.MoreVertical">
                        <Columns>
                            <PropertyColumn Property="item => item.Timestamp" Title="@L["Exceptions:Columns:Timestamp"]" HeaderClass="exception-record-time" CellClass="exception-record-time">
                                <CellTemplate>
                                    <time class="exception-record-value">@UiTime.Format(context.Item.Timestamp)</time>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="item => item.SourceType" Title="@L["Exceptions:Columns:SourceType"]" HeaderClass="exception-record-source" CellClass="exception-record-source">
                                <CellTemplate>
                                    <span class="exception-record-value">@(string.IsNullOrEmpty(context.Item.SourceType) ? L["Exceptions:Details:SourceUnavailable"].Value : context.Item.SourceType)</span>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="item => item.ExceptionType" Title="@L["Exceptions:Columns:ExceptionType"]" HeaderClass="exception-record-type" CellClass="exception-record-type">
                                <CellTemplate>
                                    <span class="exception-record-value">@context.Item.ExceptionType</span>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="item => item.Message" Title="@L["Exceptions:Columns:Message"]" HeaderClass="exception-record-message" CellClass="exception-record-message">
                                <CellTemplate>
                                    <span class="exception-record-preview">@Preview(context.Item.Message, 160)</span>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="item => item.Description" Title="@L["Exceptions:Columns:Description"]" HeaderClass="exception-record-description" CellClass="exception-record-description">
                                <CellTemplate>
                                    <span class="exception-record-preview">@Preview(context.Item.Description, 120)</span>
                                </CellTemplate>
                            </PropertyColumn>
                            <TemplateColumn Title="@L["Common:Columns:Actions"]" Sortable="false" Filterable="false" HeaderClass="exception-record-actions" CellClass="exception-record-actions">
                                <CellTemplate>
                                    <MudButton Size="Size.Small" Color="Color.Primary" OnClick="() => _selectedException = context.Item" aria-label="@L["Exceptions:Details:InspectRecord", context.Item.Sequence]">@L["Common:Actions:Details"]</MudButton>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <NoRecordsContent>
                            <MoContentState Compact="true"><p>@L["Exceptions:Details:NoMatches"]</p></MoContentState>
                        </NoRecordsContent>
                    </MudDataGrid>
                }
            </div>
            @if (_selectedException is { } selected)
            {
                <section class="exception-inspector" aria-labelledby="exception-inspector-title">
                    <header class="exception-inspector__header">
                        <div>
                            <span>@L["Exceptions:Details:InspectorEyebrow"]</span>
                            <h3 id="exception-inspector-title">@selected.ExceptionType</h3>
                        </div>
                        <MudIconButton Icon="@MoIcons.Close" Size="Size.Small" OnClick="() => _selectedException = null" aria-label="@L["Exceptions:Details:CloseSelection"]" />
                    </header>
                    @if (!string.IsNullOrEmpty(selected.CaptureError))
                    {
                        <div class="exception-capture-error">
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@MoIcons.Warning">
                                <strong>@L["Exceptions:Details:CaptureFailed"]</strong>
                                <p>@selected.CaptureError</p>
                            </MudAlert>
                        </div>
                    }
                    <MudTabs Elevation="0" Rounded="false" MinimumTabWidth="var(--datachannel-tab-min-width, 160px)" PrevIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight">
                        <MudTabPanel Text="@L["Exceptions:Details:Tabs:Evidence"]">
                            <div class="exception-inspector__tab">
                                <dl class="exception-facts">
                                    <div>
                                        <dt>@L["Exceptions:Columns:Timestamp"]</dt>
                                        <dd>@UiTime.Format(selected.Timestamp)</dd>
                                    </div>
                                    <div>
                                        <dt>@L["Exceptions:Details:Sequence"]</dt>
                                        <dd>@selected.Sequence</dd>
                                    </div>
                                    <div>
                                        <dt>@L["Exceptions:Columns:SourceType"]</dt>
                                        <dd>@(string.IsNullOrEmpty(selected.SourceType) ? L["Exceptions:Details:SourceUnavailable"].Value : selected.SourceType)</dd>
                                    </div>
                                    @if (!string.IsNullOrEmpty(selected.SourceDescription))
                                    {
                                        <div>
                                            <dt>@L["Exceptions:Details:SourceDescription"]</dt>
                                            <dd>@selected.SourceDescription</dd>
                                        </div>
                                    }
                                </dl>
                                <h4>@L["Exceptions:Details:MessageTitle"]</h4>
                                <p class="exception-message">@selected.Message</p>
                                @if (!string.IsNullOrEmpty(selected.Description))
                                {
                                    <h4>@L["Exceptions:Columns:Description"]</h4>
                                    <p class="exception-description">@selected.Description</p>
                                }
                            </div>
                        </MudTabPanel>
                        <MudTabPanel Text="@L["Exceptions:Details:Tabs:StackTrace"]">
                            <div class="exception-inspector__tab">
                                <div class="exception-stack">
                                    <StackTraceViewer Message="@selected.StackTrace" />
                                </div>
                            </div>
                        </MudTabPanel>
                    </MudTabs>
                </section>
            }
        </div>
    </DialogContent>
</MudDialog>

@code {
    /// <summary>Gets or sets the exact channel identity associated with this frozen exception evidence.</summary>
    [Parameter, EditorRequired]
    public string ChannelId { get; set; } = string.Empty;

    /// <summary>Gets or sets the captured retained subset and its complete retained and lifetime counters.</summary>
    [Parameter, EditorRequired]
    public DataChannelExceptionInfo ExceptionInfo { get; set; } = null!;

    private ExceptionDetailInfo? _selectedException;
    protected override void OnInitialized() => _selectedException = ExceptionInfo.Exceptions.FirstOrDefault();

    private static string Preview(string value, int maximumLength)
    {
        var singleLine = value.Replace('\r', ' ').Replace('\n', ' ').Trim();
        return singleLine.Length > maximumLength ? singleLine[..maximumLength].TrimEnd() + "…" : singleLine;
    }
}
