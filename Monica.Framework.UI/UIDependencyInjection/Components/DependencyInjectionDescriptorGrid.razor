@using Microsoft.Extensions.DependencyInjection
@using Monica.DependencyInjection.Models
@inject IStringLocalizer<DependencyInjectionResource> L

<div class="di-grid-root">
    <MudDataGrid DragIndicatorIcon="@MoIcons.GripVertical" SortIcon="@MoIcons.ArrowUp" FilterIconEmpty="@MoIcons.Filter" FilterIconFilled="@MoIcons.Filter" FilterIconClear="@MoIcons.FilterOff" ColumnOptionsIcon="@MoIcons.MoreVertical" T="DependencyInjectionDescriptorInfo"
                 Items="Items"
                 Dense="true"
                 Hover="true"
                 RowsPerPage="20"
                 SortMode="SortMode.Multiple"
                 Breakpoint="Breakpoint.None"
                 Elevation="0">
        <Columns>
            <TemplateColumn T="DependencyInjectionDescriptorInfo"
                            Title="@L["Page:Grid:Columns:Service"]"
                            Sortable="true"
                            SortBy="@(item => item.ServiceType)">
                <CellTemplate>
                    <div class="di-service-cell">
                        <MudTooltip Text="@context.Item.ServiceType">
                            <span class="di-type-name">@context.Item.ServiceTypeDisplayName</span>
                        </MudTooltip>
                        @if (!string.IsNullOrWhiteSpace(context.Item.ServiceAssemblyName))
                        {
                            <span class="di-assembly-name">@context.Item.ServiceAssemblyName</span>
                        }
                        <div class="di-service-markers">
                            @if (context.Item.IsAutoRegistered)
                            {
                                <MudTooltip Text="@L["Page:Grid:Badges:AutoRegistered"]">
                                    <span class="di-source-marker">@L["Page:Filters:SourceOptions:AutoRegistered"]</span>
                                </MudTooltip>
                            }

                            @if (HasIssue(context.Item, DependencyInjectionDiagnosticSeverity.Warning))
                            {
                                <MudTooltip Text="@L["Page:Grid:Badges:Warning"]">
                                    <MoIcon Icon="@MoIcons.Warning" Style="color:var(--mud-palette-warning)" Size="1.25rem" />
                                </MudTooltip>
                            }

                            @if (HasIssue(context.Item, DependencyInjectionDiagnosticSeverity.Error))
                            {
                                <MudTooltip Text="@L["Page:Grid:Badges:Error"]">
                                    <MoIcon Icon="@MoIcons.Error" Style="color:var(--mud-palette-error)" Size="1.25rem" />
                                </MudTooltip>
                            }

                            @if (context.Item.IsKeyedService)
                            {
                                <MudTooltip Text="@L["Page:Grid:Badges:Keyed"]">
                                    <MoIcon Icon="@MoIcons.Key" Style="color:var(--mud-palette-info)" Size="1.25rem" />
                                </MudTooltip>
                            }

                        </div>
                    </div>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn T="DependencyInjectionDescriptorInfo"
                            Title="@L["Page:Grid:Columns:Lifetime"]"
                            Sortable="true"
                            SortBy="@(item => item.Lifetime)">
                <CellTemplate>
                    <span class="di-lifetime">@GetLifetimeText(context.Item.Lifetime)</span>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn T="DependencyInjectionDescriptorInfo"
                            Title="@L["Page:Grid:Columns:Implementation"]"
                            Sortable="true"
                            SortBy="@(item => item.ImplementationType ?? item.FactoryDisplay ?? string.Empty)">
                <CellTemplate>
                    <div class="di-implementation-cell">
                        <MudTooltip Text="@GetImplementationTooltip(context.Item)">
                            <span class="di-type-name">@GetImplementationTitle(context.Item)</span>
                        </MudTooltip>

                        @if (!string.IsNullOrWhiteSpace(context.Item.ImplementationAssemblyName)
                             && !string.Equals(context.Item.ImplementationAssemblyName, context.Item.ServiceAssemblyName, StringComparison.Ordinal))
                        {
                            <span class="di-assembly-name">@context.Item.ImplementationAssemblyName</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(context.Item.FactoryDisplay) && !string.IsNullOrWhiteSpace(context.Item.ImplementationType))
                        {
                            <span class="di-factory-name">@context.Item.FactoryDisplay</span>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn T="DependencyInjectionDescriptorInfo"
                            TProperty="string"
                            Property="x => x.ServiceKey"
                            Sortable="true"
                            Title="@L["Page:Grid:Columns:ServiceKey"]">
                <CellTemplate>
                    @if (context.Item.IsKeyedService)
                    {
                        <code class="di-service-key">@GetTextOrFallback(context.Item.ServiceKey)</code>
                    }
                    else
                    {
                        <span class="di-unkeyed">@L["Page:Grid:States:Unkeyed"]</span>
                    }
                </CellTemplate>
            </PropertyColumn>

            <TemplateColumn T="DependencyInjectionDescriptorInfo"
                            Title="@L["Page:Grid:Columns:Kind"]"
                            Sortable="true"
                            SortBy="@(item => item.ImplementationKind)">
                <CellTemplate>
                    <span class="di-kind">@L[$"Page:Grid:Kinds:{context.Item.ImplementationKind}"]</span>
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn T="DependencyInjectionDescriptorInfo"
                            TProperty="int"
                            Property="x => x.Index"
                            Sortable="true"
                            Title="@L["Page:Grid:Columns:Index"]" />

            <TemplateColumn T="DependencyInjectionDescriptorInfo"
                            Title="@L["Page:Grid:Columns:Actions"]"
                            Sortable="false">
                <CellTemplate>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               aria-label="@L["Page:Grid:Actions:ViewDetailsFor", context.Item.ServiceTypeDisplayName]"
                               Class="di-details-action"
                               OnClick="() => OnViewDetails.InvokeAsync(context.Item)">
                        @L["Page:Grid:Actions:ViewDetails"]
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudDataGridPager T="DependencyInjectionDescriptorInfo" PageSizeOptions="@PageSizeOptions" />
        </PagerContent>
    </MudDataGrid>
</div>

@code {
    private static readonly int[] PageSizeOptions = [20, 50, 100];

    [Parameter]
    public IReadOnlyList<DependencyInjectionDescriptorInfo> Items { get; set; } = [];

    [Parameter]
    public EventCallback<DependencyInjectionDescriptorInfo> OnViewDetails { get; set; }

    private string GetLifetimeText(ServiceLifetime lifetime)
    {
        return L[$"Page:Shared:Lifetimes:{lifetime}"];
    }

    private string GetTextOrFallback(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? L["Page:States:NotAvailable"] : value;
    }

    private string GetImplementationTitle(DependencyInjectionDescriptorInfo item)
    {
        return item.ImplementationTypeDisplayName
               ?? item.ImplementationType
               ?? item.FactoryDisplay
               ?? L["Page:States:NotAvailable"];
    }

    private string GetImplementationTooltip(DependencyInjectionDescriptorInfo item)
    {
        return item.ImplementationType
               ?? item.FactoryDisplay
               ?? L["Page:States:NotAvailable"];
    }

    private bool HasIssue(DependencyInjectionDescriptorInfo item, DependencyInjectionDiagnosticSeverity severity)
    {
        return severity == DependencyInjectionDiagnosticSeverity.Error
            ? item.HasErrorIssues
            : item.HasWarningIssues;
    }
}
