@attribute [Route(PAGE_URL)]
@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["PageNotFound:PageTitle"]</PageTitle>

<ShellPageState HeadingId="not-found-page-title"
                Title="@L["PageNotFound:Title"]"
                Description="@L["PageNotFound:Message"]"
                RecoveryHint="@L["PageNotFound:Recovery"]"
                Icon="@MoIcons.Search"
                Severity="Severity.Info"
                HomeLabel="@L["Common:GoHome"]" />

@code {
    public const string PAGE_URL = "/not-found";
}
