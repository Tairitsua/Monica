@using Monica.UI.Shared.Components.States
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using System.Globalization
@using Monica.SignalR.Models
@using Monica.UI.Shared.Components.Dialogs
@inject IStringLocalizer<SignalRResource> L

<section class="signalr-connected-users" aria-labelledby="@_headingId" aria-busy="@(IsLoading ? "true" : "false")">
    <MudPaper Square="true" Elevation="0" Class="connected-users-surface">
        <header class="connected-users-heading">
            <div>
                <h2 id="@_headingId">@L["UISignalR:ConnectedUsers:Title", ConnectedUsers.Count]</h2>
                <p>@L["UISignalR:ConnectedUsers:Scope"]</p>
                @if (CapturedAtUtc is { } capturedAt)
                {
                    <span class="connected-users-capture">@L["UISignalR:ConnectedUsers:CapturedAt", FormatUtc(capturedAt)]</span>
                }
            </div>
            <MudButton OnClick="RefreshAsync" StartIcon="@MoIcons.Refresh" Color="Color.Primary"
                       Size="Size.Small" Variant="Variant.Outlined" Disabled="IsLoading">@L["UISignalR:ConnectedUsers:Refresh"]</MudButton>
        </header>

        @if (LoadFailed)
        {
            <div class="connected-users-feedback"><MudAlert Severity="Severity.Warning" Dense="true" Icon="@MoIcons.Warning">@L[DataLoaded ? "UISignalR:ConnectedUsers:LoadFailedRetained" : "UISignalR:ConnectedUsers:LoadFailed"]</MudAlert></div>
        }
        @if (IsLoading)
        {
            @if (!DataLoaded)
            {
                <MoContentState Loading="true" Compact="true"><MudProgressCircular Size="Size.Small" Indeterminate="true" /><span>@L["UISignalR:ConnectedUsers:Loading"]</span></MoContentState>
            }
            else
            {
                <div class="connected-users-loading" role="status"><MudProgressCircular Size="Size.Small" Indeterminate="true" /><span>@L["UISignalR:ConnectedUsers:Loading"]</span></div>
            }
        }

        @if (!DataLoaded)
        {
            @if (!IsLoading && !LoadFailed)
            {
                <div class="connected-users-empty"><MoIcon Icon="@MoIcons.Users" Size="2.25rem" /><p>@L["UISignalR:ConnectedUsers:NotLoaded"]</p></div>
            }
        }
        else if (ConnectedUsers.Count == 0)
        {
            <div class="connected-users-empty">
                <MoIcon Icon="@MoIcons.Users" Size="2.25rem" />
                <h3>@L["UISignalR:ConnectedUsers:Empty"]</h3>
                <p>@L["UISignalR:ConnectedUsers:EmptyHelp"]</p>
            </div>
        }
        else
        {
            <div class="connected-users-query">
                <MudTextField T="string" Value="@_query" ValueChanged="ChangeQuery" Immediate="true" Clearable="true"
                              Label="@L["UISignalR:ConnectedUsers:Search"]" Placeholder="@L["UISignalR:ConnectedUsers:SearchPlaceholder"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" ClearIcon="@MoIcons.Close" />
                <span>@L["UISignalR:ConnectedUsers:SearchSummary", MatchingCount, ConnectedUsers.Count]</span>
            </div>
            <div class="connected-users-table-owner">
                <MudTable T="SignalRConnectedUserInfo" @ref="_table" Items="@ConnectedUsers" Filter="MatchesQuery"
                          Dense="true" Hover="true" Square="true" Elevation="0" Breakpoint="Breakpoint.Xs" RowsPerPage="10">
                    <HeaderContent>
                        <MudTh Class="connection-id-cell"><MudTableSortLabel T="SignalRConnectedUserInfo" SortBy="@(user => user.ConnectionId)" SortIcon="@MoIcons.ArrowUp">@L["UISignalR:ConnectedUsers:Columns:ConnectionId"]</MudTableSortLabel></MudTh>
                        <MudTh Class="connection-user-cell"><MudTableSortLabel T="SignalRConnectedUserInfo" SortBy="@(user => user.UserName ?? string.Empty)" SortIcon="@MoIcons.ArrowUp">@L["UISignalR:ConnectedUsers:Columns:UserName"]</MudTableSortLabel></MudTh>
                        <MudTh Class="connection-tracking-cell"><MudTableSortLabel T="SignalRConnectedUserInfo" SortBy="@(user => user.ConnectionTime)" InitialDirection="SortDirection.Descending" SortIcon="@MoIcons.ArrowUp">@L["UISignalR:ConnectedUsers:Columns:ConnectionTime"]</MudTableSortLabel></MudTh>
                        <MudTh Class="connection-actions-cell">@L["UISignalR:ConnectedUsers:Columns:Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="connection-id-cell" DataLabel="@L["UISignalR:ConnectedUsers:Columns:ConnectionId"]">
                            <div class="connection-cell"><code>@context.ConnectionId</code></div>
                        </MudTd>
                        <MudTd Class="connection-user-cell" DataLabel="@L["UISignalR:ConnectedUsers:Columns:UserName"]">
                            <div class="connection-cell">
                                <strong>@DisplayValue(context.UserName)</strong>
                                <span class="connection-field-label">@L["UISignalR:ConnectedUsers:Columns:UserId"]</span>
                                <code>@DisplayValue(context.UserId)</code>
                            </div>
                        </MudTd>
                        <MudTd Class="connection-tracking-cell" DataLabel="@L["UISignalR:ConnectedUsers:Columns:ConnectionTime"]">
                            <div class="connection-cell">
                                <time datetime="@context.ConnectionTime.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)">@FormatUtc(context.ConnectionTime)</time>
                                <MudChip T="string" Size="Size.Small" Color="@(context.IsAuthenticated ? Color.Success : Color.Default)" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                                    @L[context.IsAuthenticated ? "UISignalR:Common:Authenticated" : "UISignalR:Common:Unauthenticated"]
                                </MudChip>
                            </div>
                        </MudTd>
                        <MudTd Class="connection-actions-cell" DataLabel="@L["UISignalR:ConnectedUsers:Columns:Actions"]">
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@(() => ShowUserDetails(context))"
                                       Class="connection-inspect-action" aria-label="@L["UISignalR:ConnectedUsers:InspectConnection", context.ConnectionId]">
                                @L["UISignalR:ConnectedUsers:ViewDetails"]
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="connected-users-empty">
                            <MoIcon Icon="@MoIcons.SearchOff" Size="2.25rem" />
                            <h3>@L["UISignalR:ConnectedUsers:NoMatches"]</h3>
                            <p>@L["UISignalR:ConnectedUsers:NoMatchesHelp"]</p>
                            <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="@(() => ChangeQuery(string.Empty))">@L["UISignalR:ConnectedUsers:ClearSearch"]</MudButton>
                        </div>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="@PageSizes" RowsPerPageString="@L["UISignalR:ConnectedUsers:RowsPerPage"]" InfoFormat="@L["UISignalR:ConnectedUsers:PageInfo"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" />
                    </PagerContent>
                </MudTable>
            </div>
        }
    </MudPaper>
</section>

<MudDialog @bind-Visible="_dialogVisible" Options="@_dialogOptions" ContentClass="pa-0">
    <TitleContent><MoDialogHeading Text="@L["UISignalR:ConnectedUsers:DetailsTitle"]" /></TitleContent>
    <DialogContent>
        @if (_selectedUser is { } selected)
        {
            <div class="connection-details">
                <div class="connection-details-note">
                    <p>@L["UISignalR:ConnectedUsers:FrozenHint"]</p>
                    @if (_selectedCapturedAtUtc is { } capturedAt)
                    {
                        <span>@L["UISignalR:ConnectedUsers:CapturedAt", FormatUtc(capturedAt)]</span>
                    }
                </div>
                <section class="connection-details-section">
                    <h3>@L["UISignalR:ConnectedUsers:BasicInfoTitle"]</h3>
                    <dl class="connection-details-facts">
                        <div><dt>@L["UISignalR:ConnectedUsers:Columns:ConnectionId"]</dt><dd><code>@selected.ConnectionId</code></dd></div>
                        <div><dt>@L["UISignalR:ConnectedUsers:Columns:UserName"]</dt><dd>@DisplayValue(selected.UserName)</dd></div>
                        <div><dt>@L["UISignalR:ConnectedUsers:Columns:UserId"]</dt><dd><code>@DisplayValue(selected.UserId)</code></dd></div>
                        <div><dt>@L["UISignalR:ConnectedUsers:Columns:AuthenticationStatus"]</dt><dd><MudChip T="string" Size="Size.Small" Color="@(selected.IsAuthenticated ? Color.Success : Color.Default)" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@L[selected.IsAuthenticated ? "UISignalR:Common:Authenticated" : "UISignalR:Common:Unauthenticated"]</MudChip></dd></div>
                        <div><dt>@L["UISignalR:ConnectedUsers:Columns:ConnectionTime"]</dt><dd><time datetime="@selected.ConnectionTime.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture)">@FormatUtc(selected.ConnectionTime)</time></dd></div>
                    </dl>
                </section>
                <section class="connection-details-section">
                    <h3>@L["UISignalR:ConnectedUsers:ClaimsTitle", selected.Claims.Count]</h3>
                    @if (selected.Claims.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Icon="@MoIcons.Info">@L["UISignalR:ConnectedUsers:ClaimsEmpty"]</MudAlert>
                    }
                    else
                    {
                        <p class="connection-claims-note">@L["UISignalR:ConnectedUsers:ClaimsNote"]</p>
                        <dl class="connection-claims">
                            @foreach (var claim in selected.Claims.OrderBy(pair => pair.Key, StringComparer.Ordinal))
                            {
                                <div>
                                    <dt><span>@L["UISignalR:ConnectedUsers:ClaimType"]</span><code>@claim.Key</code></dt>
                                    <dd><span>@L["UISignalR:ConnectedUsers:ClaimValue"]</span><code>@claim.Value</code></dd>
                                </div>
                            }
                        </dl>
                    }
                </section>
            </div>
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="CloseDetails" Color="Color.Default">@L["UISignalR:ConnectedUsers:Close"]</MudButton></DialogActions>
</MudDialog>

@code {
    /// <summary>Gets or sets the host's captured tracked-connection rows, without deduplicating users.</summary>
    [Parameter] public IReadOnlyList<SignalRConnectedUserInfo> ConnectedUsers { get; set; } = [];

    /// <summary>Gets or sets the awaited callback for refreshing the host registry snapshot.</summary>
    [Parameter] public EventCallback OnRefreshClicked { get; set; }

    /// <summary>Gets or sets whether a registry snapshot has been captured. Defaults to true for existing consumers.</summary>
    [Parameter] public bool DataLoaded { get; set; } = true;

    /// <summary>Gets or sets whether the owning state is currently loading the registry snapshot.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Gets or sets whether the latest registry read failed.</summary>
    [Parameter] public bool LoadFailed { get; set; }

    /// <summary>Gets or sets the UTC time of the latest successful registry capture.</summary>
    [Parameter] public DateTime? CapturedAtUtc { get; set; }

    private readonly string _headingId = $"signalr-connected-users-{Guid.NewGuid():N}";
    private static readonly int[] PageSizes = [10, 20, 50];
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
    private MudTable<SignalRConnectedUserInfo>? _table;
    private string _query = string.Empty;
    private bool _dialogVisible;
    private SignalRConnectedUserInfo? _selectedUser;
    private DateTime? _selectedCapturedAtUtc;
    private int MatchingCount => ConnectedUsers.Count(MatchesQuery);

    private Task RefreshAsync() => OnRefreshClicked.InvokeAsync();

    private void ChangeQuery(string value)
    {
        _query = value;
        _table?.NavigateTo(Page.First);
    }

    private bool MatchesQuery(SignalRConnectedUserInfo user)
    {
        var query = _query.Trim();
        return query.Length == 0
            || user.ConnectionId.Contains(query, StringComparison.OrdinalIgnoreCase)
            || (user.UserName?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            || (user.UserId?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false)
            || user.Claims.Any(claim => claim.Key.Contains(query, StringComparison.OrdinalIgnoreCase)
                || claim.Value.Contains(query, StringComparison.OrdinalIgnoreCase));
    }

    private void ShowUserDetails(SignalRConnectedUserInfo user)
    {
        // A detached copy keeps the exact inspected evidence stable across refreshes and disconnects.
        _selectedUser = new SignalRConnectedUserInfo
        {
            ConnectionId = user.ConnectionId,
            ConnectionTime = user.ConnectionTime,
            UserName = user.UserName,
            UserId = user.UserId,
            IsAuthenticated = user.IsAuthenticated,
            Claims = new Dictionary<string, string>(user.Claims, StringComparer.Ordinal)
        };
        _selectedCapturedAtUtc = CapturedAtUtc;
        _dialogVisible = true;
    }

    private void CloseDetails() => _dialogVisible = false;
    private string DisplayValue(string? value) => string.IsNullOrEmpty(value) ? L["UISignalR:Common:None"].Value : value;
    private string FormatUtc(DateTime value) => UiTime.Format(value);
}
