@using Monica.JobScheduler.UI.Localization
@using Monica.UI.Shared.Components.Navigation
@using Monica.UI.Shared.Components.Visual
@using Microsoft.AspNetCore.Components.Sections

@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation
@inject IOptions<ModuleJobSchedulerOption> SchedulerOptions
@inject JobSchedulerFacade Facade
@inject IJobSchedulerUiAccess Access
@implements IAsyncDisposable

<CascadingValue Value="@this" IsFixed="true">
<CascadingValue Value="@_actionsKey" Name="SchedulerWorkspaceActions" IsFixed="true">
<div class="scheduler-workspace mo-page-shell mo-page-shell--full-width">
    <div class="scheduler-workspace__header">
        <span class="scheduler-workspace__seal" aria-hidden="true"><MoIcon Icon="@CurrentIcon" Size="1.5rem" /></span>
        <MoPageMasthead Title="@Title" Crumb="@L["Workspace:Eyebrow"]">
            <Meta>
                <span class="scheduler-workspace__readiness" data-ready="@(_ready?.ToString().ToLowerInvariant())" title="@L["Runtime:Plane:LocalOnly"]"><i aria-hidden="true"></i>@L[_ready is true ? "Workspace:LoopsReady" : _ready is false ? "Workspace:LoopsPending" : "Workspace:ReadinessUnknown"]</span>
                <span class="scheduler-workspace__scope">@L["Workspace:Scope", SchedulerOptions.Value.SchedulerScopeKey]</span>
                <span class="scheduler-workspace__zone" title="@TimePresentation.TimeZoneDisplayName">@L["Workspace:TimeZone", TimePresentation.TimeZoneId]</span>
            </Meta>
            <Actions><SectionOutlet SectionId="@_actionsKey" /></Actions>
        </MoPageMasthead>
    </div>

    <MoWorkbenchNavigation Label="@L["Workspace:Navigation:AriaLabel"]">
        @foreach (var route in ROUTES)
        {
            <a href="@route.Url" aria-current="@(IsCurrentRoute(route.Url) ? "page" : null)">
                <MoIcon Icon="@route.Icon" aria-hidden="true" Size="1.5rem" />
                <span>@L[route.LabelKey]</span>
            </a>
        }
        @if (Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.StartsWith("/job-scheduler/jobs/", StringComparison.OrdinalIgnoreCase))
        {
            <a href="@Navigation.Uri" aria-current="page"><MoIcon Icon="@MoIcons.FileText" Size="1.25rem" /><span>@L["Pages:JobDetail:Title"]</span></a>
        }
    </MoWorkbenchNavigation>

    <div class="scheduler-workspace__content">
        @ChildContent
    </div>
</div>
</CascadingValue>
</CascadingValue>

@code {
    private static readonly (string Url, string LabelKey, string Icon)[] ROUTES =
    [
        ("/job-scheduler", "Workspace:Navigation:Overview", MoIcons.Dashboard),
        ("/job-scheduler/catalog", "Workspace:Navigation:Catalog", MoIcons.Package),
        ("/job-scheduler/executions", "Workspace:Navigation:Executions", MoIcons.Receipt),
        ("/job-scheduler/statistics", "Workspace:Navigation:Statistics", MoIcons.ChartTrend),
        ("/job-scheduler/runtime", "Workspace:Navigation:Runtime", MoIcons.HeartPulse)
    ];

    /// <summary>
    /// Gets or sets the route-specific workspace heading.
    /// </summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the route-specific operational description.
    /// </summary>
    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the legacy section hint supplied by existing callers.
    /// </summary>
    /// <remarks>The exact current URL path determines the active route link.</remarks>
    [Parameter]
    public int ActivePanelIndex { get; set; }

    /// <summary>
    /// Gets or sets the route body.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private readonly object _actionsKey = new();
    private string CurrentIcon => ActivePanelIndex == 0 ? MoIcons.CalendarCheck : ROUTES[Math.Clamp(ActivePanelIndex, 0, ROUTES.Length - 1)].Icon;
    private readonly SchedulerOperationLifetime _lifetime = new();
    private bool? _ready;
    private DateTimeOffset? _readinessCapture;
    private int _readinessVersion;

    internal async Task ObserveCaptureAsync(DateTimeOffset? capturedAtUtc)
    {
        if (_lifetime.IsRetired || capturedAtUtc is null || capturedAtUtc == _readinessCapture) return;
        _readinessCapture = capturedAtUtc;
        var version = ++_readinessVersion;
        try
        {
            await _lifetime.RunAsync(async token =>
            {
                var authorized = await Access.IsAuthorizedAsync(token);
                if (!authorized) { _lifetime.TryApply(() => _ready = null); return; }
                var result = await Facade.GetRuntimeOverviewAsync(token);
                _lifetime.TryApply(() =>
                {
                    if (version == _readinessVersion)
                        _ready = result.IsFailed(out _, out var overview) ? null
                            : overview.LocalPlane.SchedulingReady && overview.LocalPlane.WorkerReady;
                });
            });
            if (!_lifetime.IsRetired) await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (_lifetime.IsRetired) { }
        catch (Exception)
        {
            if (_lifetime.TryApply(() => _ready = null)) await InvokeAsync(StateHasChanged);
        }
    }
    /// <inheritdoc />
    public ValueTask DisposeAsync() => _lifetime.RetireAsync(() => ValueTask.CompletedTask);

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private bool IsCurrentRoute(string route) => string.Equals(
        Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.TrimEnd('/'),
        route,
        StringComparison.OrdinalIgnoreCase);
}
