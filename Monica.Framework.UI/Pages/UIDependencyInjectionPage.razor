@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@attribute [Route(PAGE_URL)]
@using Microsoft.Extensions.DependencyInjection
@using Monica.Core.Results
@using Monica.DependencyInjection.Facades
@using Monica.DependencyInjection.Models
@using Monica.Framework.UI.UIDependencyInjection.Components
@using Monica.Framework.UI.UIDependencyInjection.Dialogs
@using Monica.Framework.UI.UIDependencyInjection.State
@inject DependencyInjectionDiagnosticsFacade DiagnosticsFacade
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<DependencyInjectionResource> L
@implements IDisposable

<PageTitle>@L["Page:PageTitle"]</PageTitle>

<div class="di-page">
    <div class="di-page__container">
        <header class="di-header">
            <div class="di-header__copy">
                <span class="di-header__eyebrow">@L["Page:Header:Eyebrow"]</span>
                <h1>@L["Page:Header:Title"]</h1>
                <p>@L["Page:Header:Description"]</p>
                @if (_state.Snapshot is { } headerSnapshot)
                {
                    <time class="di-header__capture" datetime="@headerSnapshot.CapturedAt.ToString("O")">
                        <MoIcon Icon="@MoIcons.Clock" Size="1.25rem" />
                        @L["Page:Header:GeneratedAt", UiTime.Format(headerSnapshot.CapturedAt)]
                    </time>
                }
            </div>
            <div class="di-header__actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@MoIcons.Refresh"
                           OnClick="RefreshAsync" Disabled="@_state.IsLoading">
                    @L["Page:Header:Refresh"]
                </MudButton>
            </div>
        </header>

        @if (_state.Snapshot is { } compositionSnapshot)
        {
            <section class="di-composition" aria-label="@L["Page:Summary:AriaLabel"]">
                <div class="di-composition__identity">
                    <div class="di-composition__label">
                        <MoIcon Icon="@MoIcons.Workflow" Size="1.25rem" />
                        <span>@L["Page:Composition:RegistryLabel"]</span>
                    </div>
                    <div class="di-composition__total">
                        <strong>@compositionSnapshot.TotalDescriptorCount.ToString("N0")</strong>
                        <span>@L["Page:Summary:Total"]</span>
                    </div>
                    <p class="di-composition__hint">@L["Page:Composition:CachedHint"]</p>
                    <dl class="di-composition__categories">
                        <div><dt>@L["Page:Summary:AutoRegistered"]</dt><dd>@compositionSnapshot.AutoRegisteredDescriptorCount.ToString("N0")</dd></div>
                        <div><dt>@L["Page:Summary:Keyed"]</dt><dd>@compositionSnapshot.KeyedDescriptorCount.ToString("N0")</dd></div>
                        <div><dt>@L["Page:Summary:Factories"]</dt><dd>@compositionSnapshot.FactoryDescriptorCount.ToString("N0")</dd></div>
                        <div><dt>@L["Page:Composition:Instances"]</dt><dd>@compositionSnapshot.InstanceDescriptorCount.ToString("N0")</dd></div>
                    </dl>
                    <span class="di-composition__category-hint">@L["Page:Composition:CategoriesHint"]</span>
                </div>
                <div class="di-composition__lifetimes">
                    <h2 id="di-lifetimes-title">@L["Page:Composition:LifetimesTitle"]</h2>
                    <dl class="di-lifetime-list">
                        @foreach (var lifetime in new[] { ServiceLifetime.Singleton, ServiceLifetime.Scoped, ServiceLifetime.Transient })
                        {
                            var count = compositionSnapshot.Descriptors.Count(descriptor => descriptor.Lifetime == lifetime);
                            var share = compositionSnapshot.Descriptors.Count == 0 ? 0d : count * 100d / compositionSnapshot.Descriptors.Count;
                            <div class="di-lifetime" data-lifetime="@lifetime">
                                <div class="di-lifetime__label"><dt>@L[$"Page:Shared:Lifetimes:{lifetime}"]</dt><dd>@count.ToString("N0")</dd></div>
                                <div class="di-lifetime__track" aria-hidden="true"><span style="@($"width: {share.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></span></div>
                            </div>
                        }
                    </dl>
                    <div class="di-convention-totals">
                        <span class="di-convention-total @(compositionSnapshot.AutoRegistrationWarningCount > 0 ? "has-warning" : null)">
                            <i aria-hidden="true"></i>@L["Page:Summary:Warnings"]<strong>@compositionSnapshot.AutoRegistrationWarningCount.ToString("N0")</strong>
                        </span>
                        <span class="di-convention-total @(compositionSnapshot.AutoRegistrationErrorCount > 0 ? "has-error" : null)">
                            <i aria-hidden="true"></i>@L["Page:Summary:Errors"]<strong>@compositionSnapshot.AutoRegistrationErrorCount.ToString("N0")</strong>
                        </span>
                    </div>
                </div>
            </section>
        }

        @if (_state.Snapshot is { AutoRegistrationIssues.Count: > 0 } issueSnapshot)
        {
            <section class="di-issues-section" aria-labelledby="di-issues-title">
                <header class="di-section-heading">
                    <h2 id="di-issues-title">@L["Page:Issues:Title"]</h2>
                    <p>@L["Page:Issues:Description"]</p>
                </header>
                <DependencyInjectionAutoRegistrationIssueList Items="issueSnapshot.AutoRegistrationIssues" />
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(_state.LoadError))
        {
            <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Variant="Variant.Outlined">
                @L["Page:Messages:RefreshFailed", _state.LoadError]
            </MudAlert>
        }

        <section class="di-registry" aria-labelledby="di-registry-title">
            <header class="di-section-heading di-registry__heading">
                <h2 id="di-registry-title">@L["Page:Registry:Title"]</h2>
                <p>@L["Page:Registry:Description"]</p>
            </header>
            <DependencyInjectionDescriptorFilterBar State="_state"
                                                    FilteredCount="@_state.FilteredDescriptors.Count"
                                                    FiltersChanged="HandleFiltersChangedAsync" />
            @if (_state.IsLoading && !_state.HasData)
            {
                <div class="di-state-shell" role="status">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                    <p>@L["Page:States:Loading"]</p>
                </div>
            }
            else if (!_state.HasData)
            {
                <div class="di-state-shell"><MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Variant="Variant.Outlined">@L["Page:States:LoadFailed"]</MudAlert></div>
            }
            else if (_state.FilteredDescriptors.Count == 0)
            {
                <div class="di-state-shell"><MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Variant="Variant.Outlined">@L["Page:States:Empty"]</MudAlert></div>
            }
            else
            {
                <DependencyInjectionDescriptorGrid Items="_state.FilteredDescriptors" OnViewDetails="ShowDetailsAsync" />
            }
        </section>
    </div>
</div>

@code {
    public const string PAGE_URL = "/dependency-injection";

    private readonly DependencyInjectionPageState _state = new();
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LoadAsync(showSuccessMessage: false);
        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    private Task RefreshAsync() => LoadAsync(showSuccessMessage: true);

    private async Task LoadAsync(bool showSuccessMessage)
    {
        if (_disposed)
        {
            return;
        }

        _state.BeginLoad();
        StateHasChanged();

        if ((await DiagnosticsFacade.GetSnapshotAsync()).IsFailed(out var error, out var snapshot))
        {
            if (!_disposed)
            {
                _state.FailLoad(error);
                Snackbar.Add(L["Page:Messages:RefreshFailed", error], Severity.Error);
            }
            return;
        }

        if (_disposed)
        {
            return;
        }

        _state.ApplySnapshot(snapshot);
        if (showSuccessMessage)
        {
            Snackbar.Add(L["Page:Messages:RefreshSucceeded"], Severity.Success);
        }
    }

    private Task HandleFiltersChangedAsync()
    {
        if (!_disposed)
        {
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private async Task ShowDetailsAsync(DependencyInjectionDescriptorInfo descriptor)
    {
        try
        {
            var parameters = new DialogParameters<DependencyInjectionDescriptorDetailDialog>
            {
                { x => x.Descriptor, descriptor }
            };

            await DialogService.ShowAsync<DependencyInjectionDescriptorDetailDialog>(
                L["Page:Dialog:Title"],
                parameters,
                new DialogOptions
                {
                    MaxWidth = MaxWidth.ExtraLarge,
                    FullWidth = true,
                    CloseButton = true,
                    CloseOnEscapeKey = true
                });
        }
        catch (Exception ex)
        {
            Snackbar.Add(L["Page:Messages:DialogOpenFailed", ex.Message], Severity.Error);
        }
    }

    public void Dispose() => _disposed = true;
}
