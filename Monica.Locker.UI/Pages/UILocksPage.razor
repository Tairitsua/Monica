@attribute [Route(PAGE_URL)]
@inject NavigationManager Navigation

@code {
    public const string PAGE_URL = "/leases/locks";
    [SupplyParameterFromQuery] public string? Provider { get; set; }

    protected override void OnParametersSet() => Navigation.NavigateTo(
        Navigation.GetUriWithQueryParameters(Navigation.ToAbsoluteUri("leases").ToString(),
            new Dictionary<string, object?> { ["section"] = "locker", ["provider"] = Provider }), replace: true);
}
