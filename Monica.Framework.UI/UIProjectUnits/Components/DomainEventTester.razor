@using Monica.UI.Shared.Components.Json
@using Monica.UI.Shared.Components.States
@using Monica.ProjectUnits.Facades
@using Monica.Core.Results
@using System.Text.Json
@using Monica.Core.JsonSerialization.Abstractions
@using Monica.Core.JsonSerialization.Services.Support
@using Monica.ProjectUnits.Models
@inject ProjectUnitsFacade ProjectUnitsFacade
@inject IJsonSerializerOptionsProvider JsonSerializerOptionsProvider
@inject ISnackbar Snackbar
@inject IStringLocalizer<ProjectUnitsResource> L
@implements IDisposable

<section class="event-desk">
    <header class="event-desk__heading">
        <div>
            <span class="event-desk__eyebrow">@L["DomainEventTester:Desk:Eyebrow"]</span>
            <h1>@L["DomainEventTester:Header:Title"]</h1>
            <p>@L["DomainEventTester:Header:Description"]</p>
        </div>
        <div class="event-desk__refresh">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadDomainEventsAsync"
                       StartIcon="@MoIcons.Refresh" Disabled="@(_loading || _publishing)">
                @L["DomainEventTester:Actions:Refresh"]
            </MudButton>
        </div>
    </header>

    @if (_loadError is not null)
    {
        <div class="event-desk__error" role="alert">@_loadError</div>
    }

    <div class="event-desk__workspace">
        <section class="event-descriptors" aria-label="@L["DomainEventTester:Sections:EventList"]">
            <header class="event-descriptors__header">
                <h3>@L["DomainEventTester:Sections:EventList"]</h3>
                <span>@_domainEvents.Count</span>
            </header>
            @if (_loading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            <div class="event-descriptors__list" tabindex="0" aria-label="@L["DomainEventTester:Sections:EventList"]">
                @foreach (var descriptor in _domainEvents)
                {
                    <button type="button" @key="descriptor.Info.Key"
                            class="event-descriptor @(_selectedEvent?.Info.Key == descriptor.Info.Key ? "event-descriptor--selected" : null)"
                            aria-pressed="@(_selectedEvent?.Info.Key == descriptor.Info.Key ? "true" : "false")"
                            disabled="@(_loading || _publishing)" @onclick="@(() => SelectEvent(descriptor))">
                        <span class="event-descriptor__title">@descriptor.Info.Title</span>
                        <code><ProjectUnitIdentityText Value="@descriptor.Info.Key" /></code>
                    </button>
                }
                @if (!_loading && _loadError is null && _domainEvents.Count == 0)
                {
                    <MoContentState Compact="true"><p>@L["DomainEventTester:States:Empty"]</p></MoContentState>
                }
            </div>
        </section>

        <section class="event-payload" aria-label="@L["DomainEventTester:Sections:EventTester"]">
            <header class="event-payload__header">
                <span class="event-desk__eyebrow">@L["DomainEventTester:Desk:DraftLabel"]</span>
                <h3>@(_selectedEvent?.Info.Title ?? L["DomainEventTester:Sections:EventTester"].Value)</h3>
                <p>@L["DomainEventTester:Desk:DispatchHint"]</p>
            </header>
            @if (_selectedEvent is { } selected)
            {
                <div class="event-payload__identity">
                    <MudTextField T="string" Value="@selected.EventKey" Label="@L["DomainEventTester:Fields:EventName"]"
                                  Variant="Variant.Outlined" ReadOnly="true" />
                </div>
                <div class="event-payload__editor">
                    <MoJson @bind-Value="_eventContent" ReadOnly="false" Rows="18" Label="@L["DomainEventTester:Fields:EventContent"]" Placeholder="@L["DomainEventTester:Fields:EventContentPlaceholder"]" Disabled="@_publishing" />
                </div>
                <footer class="event-payload__actions">
                    <p>@L["DomainEventTester:Desk:DraftHint"]</p>
                    <div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PublishEventAsync"
                                   StartIcon="@MoIcons.Send" Disabled="@(_loading || _publishing || string.IsNullOrWhiteSpace(selected.EventKey))">
                            @(_publishing ? L["DomainEventTester:Actions:Publishing"] : L["DomainEventTester:Actions:Publish"])
                        </MudButton>
                    </div>
                </footer>
            }
            else
            {
                <div class="event-payload__unselected">
                    <MoIcon Icon="@MoIcons.Braces" Size="1.5rem" />
                    <p>@L["DomainEventTester:States:NoSelection"]</p>
                </div>
            }
        </section>
    </div>
</section>

@code {
    private List<ProjectUnitDomainEventInfo> _domainEvents = [];
    private bool _loading;
    private bool _publishing;
    private bool _disposed;
    private string? _loadError;
    private ProjectUnitDomainEventInfo? _selectedEvent;
    private string _eventContent = string.Empty;

    protected override Task OnInitializedAsync() => LoadDomainEventsAsync();

    private async Task LoadDomainEventsAsync()
    {
        if (_disposed || _loading || _publishing) return;
        _loading = true;
        _loadError = null;
        try
        {
            var result = await ProjectUnitsFacade.GetDomainEventsAsync();
            if (_disposed) return;
            if (result.IsFailed(out var error, out var data))
            {
                _loadError = L["Shared:Messages:LoadFailed", error];
                Snackbar.Add(_loadError, Severity.Error);
                return;
            }
            _domainEvents = data ?? [];
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _loadError = L["Shared:Messages:LoadException", ex.Message];
            Snackbar.Add(_loadError, Severity.Error);
        }
        finally
        {
            if (!_disposed)
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private void SelectEvent(ProjectUnitDomainEventInfo eventInfo)
    {
        if (_disposed || _loading || _publishing) return;
        _selectedEvent = eventInfo;
        _eventContent = JsonSerializer.Serialize(eventInfo.Structure,
            JsonSerializerOptionsProvider.SerializerOptions.Copy(options => options.WriteIndented = true)) ?? "{}";
    }

    private async Task PublishEventAsync()
    {
        if (_disposed || _loading || _publishing) return;
        if (_selectedEvent is not { } selected || string.IsNullOrWhiteSpace(selected.EventKey) || string.IsNullOrWhiteSpace(_eventContent))
        {
            Snackbar.Add(L["DomainEventTester:Messages:SelectEventAndContent"], Severity.Warning);
            return;
        }

        var eventKey = selected.EventKey;
        var payload = _eventContent;
        _publishing = true;
        try
        {
            var result = await ProjectUnitsFacade.PublishDomainEventAsync(eventKey, payload);
            if (_disposed) return;
            if (result.IsFailed(out var error))
            {
                Snackbar.Add(L["DomainEventTester:Messages:PublishFailed", error], Severity.Error);
                return;
            }
            Snackbar.Add(L["DomainEventTester:Messages:PublishSucceeded"], Severity.Success);
        }
        catch (Exception ex)
        {
            if (!_disposed) Snackbar.Add(L["DomainEventTester:Messages:PublishException", ex.Message], Severity.Error);
        }
        finally
        {
            if (!_disposed)
            {
                _publishing = false;
                StateHasChanged();
            }
        }
    }

    public void Dispose() => _disposed = true;
}
