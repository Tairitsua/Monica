@using Microsoft.Extensions.Localization
@using Monica.Markdown.Localization
@using Monica.Markdown.Models
@using Monica.Markdown.UIMarkdown.Support
@inject IStringLocalizer<MarkdownResource> L

<div class="document-metadata">
    @if (Document.FrontMatter is { } frontMatter)
    {
        var author = AuthorDisplay;
        var customMetadata = GetCustomMetadata().ToArray();

        @if (frontMatter.Tags.Count > 0 || !string.IsNullOrWhiteSpace(author))
        {
            <div class="metadata-summary">
                @foreach (var tag in frontMatter.Tags)
                {
                    <span class="metadata-tag" title="@tag">@tag</span>
                }

                @if (!string.IsNullOrWhiteSpace(author))
                {
                    <span class="metadata-author" title="@author">
                        <span class="metadata-label">@L["MarkdownViewer:Metadata:Author"]</span>
                        <span class="metadata-author-value">@author</span>
                    </span>
                }
            </div>
        }

        @if (customMetadata.Length > 0)
        {
            <div class="metadata-custom-row">
                @foreach (var field in customMetadata)
                {
                    <span class="metadata-custom" title="@($"{field.Key}: {field.Value}")">
                        <span class="metadata-custom-key">@field.Key:</span>
                        <span class="metadata-custom-value">@field.Value</span>
                    </span>
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>
    /// Gets or sets the selected catalog document whose authored tags, author, and custom front matter
    /// are displayed as encoded inline metadata. Required. Documents without front matter display no metadata.
    /// </summary>
    [Parameter, EditorRequired]
    public MarkdownDocument Document { get; set; } = null!;

    private static readonly HashSet<string> ReservedKeys =
        new(StringComparer.OrdinalIgnoreCase) { "title", "date", "tags", "author" };

    private string? AuthorDisplay =>
        Document.FrontMatter is { } frontMatter
        && frontMatter.RawMetadata.TryGetValue("author", out var author)
        && author is not null
            ? MarkdownMetadataFormatter.FormatValue(author)
            : null;

    private IEnumerable<KeyValuePair<string, string>> GetCustomMetadata() =>
        Document.FrontMatter?.RawMetadata
            .Where(field => !ReservedKeys.Contains(field.Key) && field.Value is not null)
            .Select(field => new KeyValuePair<string, string>(
                field.Key, MarkdownMetadataFormatter.FormatValue(field.Value)))
        ?? [];
}
