@using Monica.UI.Shared.Components.States
@using Monica.Tool.Extensions
@inject IStringLocalizer<RepositoryUIResource> L

<div class="repository-migrations">
    <section class="migration-command">
        <div><span>@L["Workbench:Migrations:Eyebrow"]</span><h3>@L["Migrations:Title"]</h3><p>@(MigrationUpdatesEnabled ? L["Workbench:Migrations:CommandScope"] : L["Migrations:DisabledInProduction"])</p></div>
        <div class="migration-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.Download" Disabled="@(!CanUpdateSelected)" OnClick="OnUpdateSelected">@L["Migrations:Actions:UpdateSelected"]</MudButton><MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.CheckCheck" Disabled="@(!CanUpdateAll)" OnClick="OnUpdateAll">@L["Migrations:Actions:UpdateAll"]</MudButton></div>
    </section>
    @if (IsUpdating) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
    @if (Status is null) { <section><MoContentState Compact="true">@L["Migrations:Empty"]</MoContentState></section> }
    else if (Status.HasError) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">@Status.ErrorMessage</MudAlert> }
    else
    {
        <div class="migration-summary"><div><span>@L["Workbench:Migrations:AssemblyCount"]</span><strong>@Status.AllMigrations.Count</strong></div><div data-tone="success"><span>@L["Workbench:Migrations:AppliedCount"]</span><strong>@Status.AppliedCurrentAssemblyMigrations.Count</strong></div><div data-tone="warning"><span>@L["Workbench:Migrations:PendingCount"]</span><strong>@Status.PendingMigrations.Count</strong></div><div data-tone="info"><span>@L["Workbench:Migrations:ExternalCount"]</span><strong>@Status.ExternalAppliedMigrations.Count</strong></div></div>
        <section class="migration-assembly">
            <header><span>@L["Workbench:Migrations:AssemblyEyebrow"]</span><h3>@L["Migrations:Lists:CurrentAssembly"]</h3><p>@L["Migrations:ContextNote", string.IsNullOrWhiteSpace(Status.MigrationAssembly) ? L["Common:Values:Unavailable"].Value : Status.MigrationAssembly]</p></header>
            <div class="migration-filters"><MudTextField T="string" @bind-Value="_search" Immediate="true" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Label="@L["Workbench:Migrations:Search"]" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" ClearIcon="@MoIcons.Close" /><MudChipSet T="RepositoryMigrationApplicationState" @bind-SelectedValues="_states" SelectionMode="SelectionMode.MultiSelection" CheckMark="true">@foreach (var state in Enum.GetValues<RepositoryMigrationApplicationState>()) { <MudChip T="RepositoryMigrationApplicationState" Value="state" Color="@StateColor(state)" Variant="Variant.Outlined" Class="@("migration-status-" + state.ToString().ToLowerInvariant())" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@L[$"Migrations:States:{state}"] <span class="migration-filter-count">@Status.CurrentAssemblyMigrations.Count(item => item.State == state)</span></MudChip> }</MudChipSet></div>
            <div class="migration-table-frame"><MudTable T="RepositoryMigrationAssemblyItem" Items="FilteredMigrations" Dense="true" Hover="true" Square="true" Elevation="0" Breakpoint="Breakpoint.Xs" RowsPerPage="10"><HeaderContent><MudTh><MudTableSortLabel T="RepositoryMigrationAssemblyItem" SortBy="@(item => item.MigrationId)" InitialDirection="SortDirection.Ascending" SortIcon="@MoIcons.ArrowUp">@L["Workbench:Migrations:Identifier"]</MudTableSortLabel></MudTh><MudTh><MudTableSortLabel T="RepositoryMigrationAssemblyItem" SortBy="@(item => item.State)" SortIcon="@MoIcons.ArrowUp">@L["Workbench:Migrations:State"]</MudTableSortLabel></MudTh></HeaderContent><RowTemplate><MudTd DataLabel="@L["Workbench:Migrations:Identifier"].Value"><code>@context.MigrationId</code></MudTd><MudTd DataLabel="@L["Workbench:Migrations:State"].Value"><span class="migration-state" data-tone="@context.State.ToString().ToLowerInvariant()">@L[$"Migrations:States:{context.State}"]</span></MudTd></RowTemplate><NoRecordsContent><MoContentState Compact="true">@L[Status.AllMigrations.Count == 0 ? "Migrations:Lists:NoMigrations" : "Workbench:Migrations:NoMatches"]</MoContentState></NoRecordsContent><PagerContent><MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" RowsPerPageString="@L["Workbench:RowsPerPage"]" InfoFormat="@L["Workbench:PageInfo"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" /></PagerContent></MudTable></div>
        </section>
        <section class="migration-history">
            <header><span>@L["Workbench:Migrations:HistoryEyebrow"]</span><h3>@L["Migrations:Lists:ExternalApplied"]</h3><p>@L["Migrations:Lists:ExternalAppliedDescription"]</p></header>
            @if (Status.ExternalAppliedMigrations.Count == 0) { <MoContentState Compact="true">@L["Migrations:Lists:NoExternalApplied"]</MoContentState> }
            else { <div class="migration-table-frame"><MudTable T="string" Items="Status.ExternalAppliedMigrations" Dense="true" Square="true" Elevation="0" Breakpoint="Breakpoint.Xs" RowsPerPage="10"><HeaderContent><MudTh>@L["Workbench:Migrations:Identifier"]</MudTh><MudTh>@L["Workbench:Migrations:State"]</MudTh></HeaderContent><RowTemplate><MudTd DataLabel="@L["Workbench:Migrations:Identifier"].Value"><code>@context</code></MudTd><MudTd DataLabel="@L["Workbench:Migrations:State"].Value"><span class="migration-state" data-tone="external">@L["Migrations:States:Applied"]</span></MudTd></RowTemplate><PagerContent><MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" RowsPerPageString="@L["Workbench:RowsPerPage"]" InfoFormat="@L["Workbench:PageInfo"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" /></PagerContent></MudTable></div> }
            <footer>@L["Migrations:Summary:HistoryRows", Status.AppliedMigrations.Count]</footer>
        </section>
    }
    @if (UpdateResults.Count > 0)
    {
        <section class="migration-results"><header><span>@L["Workbench:Migrations:ResultsEyebrow"]</span><h3>@L["Migrations:Results:Title"]</h3><p>@L["Workbench:Migrations:ResultsScope"]</p></header><div class="migration-table-frame"><MudTable T="RepositoryMigrationUpdateResult" Items="UpdateResults" Dense="true" Hover="true" Square="true" Elevation="0" Breakpoint="Breakpoint.Xs" RowsPerPage="10"><HeaderContent><MudTh>@L["Migrations:Results:Columns:Context"]</MudTh><MudTh>@L["Migrations:Results:Columns:Status"]</MudTh><MudTh>@L["Migrations:Results:Columns:Attempted"]</MudTh><MudTh>@L["Migrations:Results:Columns:Duration"]</MudTh><MudTh>@L["Migrations:Results:Columns:Message"]</MudTh></HeaderContent><RowTemplate><MudTd DataLabel="@L["Migrations:Results:Columns:Context"].Value"><strong>@context.Registration.DbContextType.GetCleanFullName()</strong><span class="migration-result-assembly">@context.Registration.AssemblyName</span></MudTd><MudTd DataLabel="@L["Migrations:Results:Columns:Status"].Value"><span class="migration-state" data-tone="@(!context.Succeeded ? "failed" : context.Skipped ? "external" : "applied")">@L[!context.Succeeded ? "Migrations:Results:Status:Failed" : context.Skipped ? "Migrations:Results:Status:Skipped" : "Migrations:Results:Status:Succeeded"]</span></MudTd><MudTd DataLabel="@L["Migrations:Results:Columns:Attempted"].Value"><details><summary>@context.AttemptedMigrations.Count</summary><ul>@foreach (var migration in context.AttemptedMigrations) { <li><code>@migration</code></li> }</ul></details></MudTd><MudTd DataLabel="@L["Migrations:Results:Columns:Duration"].Value"><code>@context.Duration.ToString("c")</code></MudTd><MudTd DataLabel="@L["Migrations:Results:Columns:Message"].Value">@(context.ErrorMessage ?? context.Message ?? L["Common:Values:Unavailable"].Value)</MudTd></RowTemplate><PagerContent><MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" RowsPerPageString="@L["Workbench:RowsPerPage"]" InfoFormat="@L["Workbench:PageInfo"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" /></PagerContent></MudTable></div></section>
    }
</div>

@code {
    [Parameter] public RepositoryMigrationStatus? Status { get; set; }
    [Parameter] public IReadOnlyList<RepositoryMigrationUpdateResult> UpdateResults { get; set; } = [];
    [Parameter] public bool MigrationUpdatesEnabled { get; set; }
    [Parameter] public bool HasAnyPendingMigration { get; set; }
    [Parameter] public bool IsUpdating { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public EventCallback OnUpdateSelected { get; set; }
    [Parameter] public EventCallback OnUpdateAll { get; set; }
    private string? _search;
    private IReadOnlyCollection<RepositoryMigrationApplicationState>? _states = Enum.GetValues<RepositoryMigrationApplicationState>();
    private bool CanUpdateSelected => MigrationUpdatesEnabled && Status?.HasPendingMigrations == true && !IsUpdating && !IsBusy;
    private bool CanUpdateAll => MigrationUpdatesEnabled && HasAnyPendingMigration && !IsUpdating && !IsBusy;
    private IEnumerable<RepositoryMigrationAssemblyItem> FilteredMigrations => (Status?.CurrentAssemblyMigrations ?? []).Where(item => _states?.Contains(item.State) == true && (string.IsNullOrWhiteSpace(_search) || item.MigrationId.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)));
    private static Color StateColor(RepositoryMigrationApplicationState state) => state switch { RepositoryMigrationApplicationState.Applied => Color.Success, RepositoryMigrationApplicationState.Pending => Color.Warning, _ => Color.Info };
}
