@using Monica.UI.Shared.Components.States
@using System.Globalization
@using Monica.ProjectUnits.Facades
@using Monica.Core.Results
@using Monica.ProjectUnits.Models
@inject ProjectUnitsFacade ProjectUnitsFacade
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<ProjectUnitsResource> L
@implements IAsyncDisposable

<section class="enum-info-viewer" @ref="_viewerContainer">
    <header class="enum-info-viewer__heading">
        <div>
            <span class="enum-info-viewer__eyebrow">@L["EnumInfoViewer:Desk:Eyebrow"]</span>
            <h1>@L["EnumInfoViewer:Header:Title"]</h1>
            <p>@L["EnumInfoViewer:Header:Description"]</p>
        </div>
        <div class="enum-info-viewer__refresh">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAllEnumsAsync"
                       StartIcon="@MoIcons.Refresh" Disabled="@_loading">@L["Shared:Actions:Refresh"]</MudButton>
        </div>
    </header>
    <div class="enum-info-viewer__toolbar">
        <div class="enum-info-viewer__search-input">
            <MudTextField ClearIcon="@MoIcons.Close" T="string" Value="@_searchText" ValueChanged="OnSearchTextChanged" Immediate="true" Clearable="true"
                          Variant="Variant.Outlined" Label="@L["EnumInfoViewer:Desk:SearchLabel"]"
                          Placeholder="@L["EnumInfoViewer:Search:Placeholder"]" Adornment="Adornment.Start"
                          AdornmentIcon="@MoIcons.Search" Disabled="@(_loading || _enumGroups.Count == 0)" />
        </div>
        <div class="enum-info-viewer__toolbar-actions">
            <span class="enum-info-viewer__search-summary" role="status">@GetSearchSummary()</span>
            <MudIconButton Icon="@MoIcons.ArrowUp" aria-label="@L["Shared:Actions:PreviousMatch"]"
                           OnClick="GoToPreviousMatchAsync" Disabled="@(_loading || !HasSearchMatches)" />
            <MudIconButton Icon="@MoIcons.ArrowDown" aria-label="@L["Shared:Actions:NextMatch"]"
                           OnClick="GoToNextMatchAsync" Disabled="@(_loading || !HasSearchMatches)" />
        </div>
        <p>@L["EnumInfoViewer:Search:Hint"]</p>
    </div>
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    @if (_loadError is not null)
    {
        <div class="enum-info-viewer__error" role="alert">@_loadError</div>
    }
    <nav class="enum-info-viewer__stages" aria-label="@L["EnumInfoViewer:Desk:StagesLabel"]">
        <button type="button" disabled="@_interopFailed" @onclick="@(() => RevealPane(SearchSection.Assembly))">01 · @L["EnumInfoViewer:Panels:Assemblies"]</button>
        <button type="button" disabled="@(_interopFailed || SelectedAssembly is null)" @onclick="@(() => RevealPane(SearchSection.Enum))">02 · @L["EnumInfoViewer:Panels:Enums"]</button>
        <button type="button" disabled="@(_interopFailed || SelectedEnum is null)" @onclick="@(() => RevealPane(SearchSection.Value))">03 · @L["EnumInfoViewer:Panels:Values"]</button>
    </nav>

    <div class="enum-info-viewer__grid">
        <section class="enum-info-viewer__panel enum-info-viewer__panel--assemblies">
            <header class="enum-info-viewer__panel-header">
                <span class="enum-info-viewer__stage-number">01</span>
                <div><h3>@L["EnumInfoViewer:Panels:Assemblies"]</h3><p>@GetAssemblyPanelSummary()</p></div>
            </header>
            <div class="enum-info-viewer__panel-content" tabindex="0" aria-label="@L["EnumInfoViewer:Panels:Assemblies"]" @ref="_assemblyContainer">
                @for (var assemblyIndex = 0; assemblyIndex < _enumGroups.Count; assemblyIndex++)
                {
                    var currentAssemblyIndex = assemblyIndex;
                    var group = _enumGroups[currentAssemblyIndex];
                    var itemClass = GetAssemblyItemClass(currentAssemblyIndex);
                    <button type="button" class="@itemClass" data-search-key="@GetAssemblySearchKey(currentAssemblyIndex)"
                            aria-pressed="@(_selectedAssemblyIndex == currentAssemblyIndex ? "true" : "false")"
                            aria-current="@(itemClass.Contains("enum-info-viewer__item--current", StringComparison.Ordinal) ? "true" : null)"
                            disabled="@_loading" @onclick="@(() => SelectAssembly(currentAssemblyIndex))">
                        <span class="enum-info-viewer__item-top">
                            <span class="enum-info-viewer__item-title"><MudHighlighter Text="@GetShortAssemblyName(group.From)" HighlightedTexts="@_searchTerms" Class="enum-info-viewer__highlight" /></span>
                            <span class="enum-info-viewer__item-badge">@L.GetCountText(ProjectUnitsCountText.Enum, group.Enums.Count)</span>
                        </span>
                        @if (!string.IsNullOrWhiteSpace(group.From))
                        {
                            <span class="enum-info-viewer__assembly-full-name"><MudHighlighter Text="@group.From" HighlightedTexts="@_searchTerms" Class="enum-info-viewer__highlight" /></span>
                        }
                    </button>
                }
                @if (!_loading && _loadError is null && _enumGroups.Count == 0)
                {
                    <MoContentState Compact="true"><p>@L["EnumInfoViewer:States:Empty"]</p></MoContentState>
                }
            </div>
        </section>
        <section class="enum-info-viewer__panel enum-info-viewer__panel--enums">
            <header class="enum-info-viewer__panel-header">
                <span class="enum-info-viewer__stage-number">02</span>
                <div><h3>@L["EnumInfoViewer:Panels:Enums"]</h3><p>@GetEnumPanelSummary()</p></div>
            </header>
            <div class="enum-info-viewer__panel-content" tabindex="0" aria-label="@L["EnumInfoViewer:Panels:Enums"]" @ref="_enumContainer">
                @if (SelectedAssembly is { } assembly && _selectedAssemblyIndex is int selectedAssemblyIndex)
                {
                    @for (var enumIndex = 0; enumIndex < assembly.Enums.Count; enumIndex++)
                    {
                        var currentEnumIndex = enumIndex;
                        var enumInfo = assembly.Enums[currentEnumIndex];
                        var itemClass = GetEnumItemClass(selectedAssemblyIndex, currentEnumIndex);
                        <button type="button" class="@itemClass" data-search-key="@GetEnumSearchKey(selectedAssemblyIndex, currentEnumIndex)"
                                aria-pressed="@(_selectedEnumIndex == currentEnumIndex ? "true" : "false")"
                                aria-current="@(itemClass.Contains("enum-info-viewer__item--current", StringComparison.Ordinal) ? "true" : null)"
                                disabled="@_loading" @onclick="@(() => SelectEnum(selectedAssemblyIndex, currentEnumIndex))">
                            <span class="enum-info-viewer__item-top">
                                <span class="enum-info-viewer__item-title"><MudHighlighter Text="@enumInfo.Name" HighlightedTexts="@_searchTerms" Class="enum-info-viewer__highlight" /></span>
                                <span class="enum-info-viewer__item-badge">@L.GetCountText(ProjectUnitsCountText.EnumValue, enumInfo.Values.Count)</span>
                            </span>
                        </button>
                    }
                }
                else
                {
                    <MoContentState Compact="true"><p>@L["EnumInfoViewer:States:SelectAssembly"]</p></MoContentState>
                }
            </div>
        </section>
        <section class="enum-info-viewer__panel enum-info-viewer__panel--values">
            <header class="enum-info-viewer__panel-header">
                <span class="enum-info-viewer__stage-number">03</span>
                <div><h3>@L["EnumInfoViewer:Panels:Values"]</h3><p>@GetValuePanelSummary()</p></div>
            </header>
            <div class="enum-info-viewer__panel-content" tabindex="0" aria-label="@L["EnumInfoViewer:Panels:Values"]" @ref="_valueContainer">
                @if (SelectedEnum is { } selectedEnum && _selectedAssemblyIndex is int valueAssemblyIndex && _selectedEnumIndex is int valueEnumIndex)
                {
                    <div class="enum-info-viewer__selected-enum">
                        <strong><MudHighlighter Text="@selectedEnum.Name" HighlightedTexts="@_searchTerms" Class="enum-info-viewer__highlight" /></strong>
                        <span>@L.GetCountText(ProjectUnitsCountText.EnumValue, selectedEnum.Values.Count)</span>
                        <p>@L["EnumInfoViewer:Desk:PositionHint"]</p>
                    </div>
                    @for (var valueIndex = 0; valueIndex < selectedEnum.Values.Count; valueIndex++)
                    {
                        var currentValueIndex = valueIndex;
                        var value = selectedEnum.Values[currentValueIndex];
                        var itemClass = GetValueItemClass(valueAssemblyIndex, valueEnumIndex, currentValueIndex);
                        <button type="button" class="@itemClass" data-search-key="@GetValueSearchKey(valueAssemblyIndex, valueEnumIndex, currentValueIndex)"
                                aria-current="@(itemClass.Contains("enum-info-viewer__item--current", StringComparison.Ordinal) ? "true" : null)"
                                disabled="@_loading" @onclick="@(() => SelectValueMatch(valueAssemblyIndex, valueEnumIndex, currentValueIndex))">
                            <span class="enum-info-viewer__item-top">
                                <span class="enum-info-viewer__item-title"><MudHighlighter Text="@value.Name" HighlightedTexts="@_searchTerms" Class="enum-info-viewer__highlight" /></span>
                                <span class="enum-info-viewer__value-index"><span>@L["EnumInfoViewer:Desk:Position"]</span><MudHighlighter Text="@value.Index.ToString(CultureInfo.InvariantCulture)" HighlightedTexts="@_searchTerms" Class="enum-info-viewer__highlight" /></span>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(value.Description))
                            {
                                <span class="enum-info-viewer__item-description"><MudHighlighter Text="@value.Description" HighlightedTexts="@_searchTerms" Class="enum-info-viewer__highlight" /></span>
                            }
                        </button>
                    }
                }
                else
                {
                    <MoContentState Compact="true"><p>@L["EnumInfoViewer:States:SelectEnum"]</p></MoContentState>
                }
            </div>
        </section>
    </div>
</section>

@code {
    private readonly HashSet<int> _matchedAssemblyIndices = [];
    private readonly HashSet<(int AssemblyIndex, int EnumIndex)> _matchedEnumIndices = [];
    private readonly HashSet<(int AssemblyIndex, int EnumIndex, int ValueIndex)> _matchedValueIndices = [];
    private readonly List<SearchMatch> _searchMatches = [];
    private readonly List<SearchScrollRequest> _pendingScrollRequests = [];
    private readonly SemaphoreSlim _jsGate = new(1, 1);
    private readonly CancellationTokenSource _lifetime = new();

    private IJSObjectReference? _jsModule;
    private IJSObjectReference? _scrollController;
    private Task? _disposeTask;
    private ElementReference _viewerContainer;
    private CancellationToken _lifetimeToken;
    private bool _disposed;
    private bool _interopFailed;
    private bool _loaded;
    private bool _cancelPendingScroll;
    private string? _loadError;
    private SearchSection? _pendingFocusSection;
    private long _scrollRevision;
    private ElementReference _assemblyContainer;
    private ElementReference _enumContainer;
    private ElementReference _valueContainer;

    private List<DtoAssemblyEnumInfo> _enumGroups = [];
    private List<string> _searchTerms = [];
    private string _searchText = string.Empty;
    private bool _loading;
    private int _currentMatchIndex = -1;
    private int? _selectedAssemblyIndex;
    private int? _selectedEnumIndex;

    private DtoAssemblyEnumInfo? SelectedAssembly =>
        _selectedAssemblyIndex is int assemblyIndex
        && assemblyIndex >= 0
        && assemblyIndex < _enumGroups.Count
            ? _enumGroups[assemblyIndex]
            : null;

    private DtoEnumInfo? SelectedEnum =>
        SelectedAssembly is not null
        && _selectedEnumIndex is int enumIndex
        && enumIndex >= 0
        && enumIndex < SelectedAssembly.Enums.Count
            ? SelectedAssembly.Enums[enumIndex]
            : null;

    private bool HasSearchQuery => _searchTerms.Count > 0;

    private bool HasSearchMatches => _searchMatches.Count > 0;

    protected override Task OnInitializedAsync()
    {
        _lifetimeToken = _lifetime.Token;
        return LoadAllEnumsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _interopFailed) return;
        var acquired = false;
        try
        {
            await _jsGate.WaitAsync(_lifetimeToken);
            acquired = true;
            if (_disposed) return;
            if (_jsModule is null)
            {
                var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import",
                    "./_content/Monica.Framework.UI/UIProjectUnits/enumInfoViewer.js");
                if (_disposed)
                {
                    await module.DisposeAsync();
                    return;
                }
                _jsModule = module;
            }
            if (_scrollController is null)
            {
                var controller = await _jsModule.InvokeAsync<IJSObjectReference>("createScrollController", _viewerContainer);
                if (_disposed)
                {
                    await StopControllerAsync(controller);
                    return;
                }
                _scrollController = controller;
            }

            var requests = _pendingScrollRequests.ToArray();
            _pendingScrollRequests.Clear();
            var cancelPendingScroll = _cancelPendingScroll;
            _cancelPendingScroll = false;
            var focusSection = _pendingFocusSection;
            _pendingFocusSection = null;
            var revision = _scrollRevision;
            if (cancelPendingScroll || requests.Length > 0)
            {
                await _scrollController.InvokeVoidAsync("cancelPending");
            }
            if (requests.Length > 0)
            {
                foreach (var request in requests)
                {
                    if (_disposed || revision != _scrollRevision) return;
                    await _scrollController.InvokeVoidAsync("scrollToMatch", GetContainer(request.Section), request.SearchKey);
                }
            }
            if (!_disposed && revision == _scrollRevision && focusSection is { } section)
            {
                await _scrollController.InvokeVoidAsync("revealPane", GetContainer(section));
            }
        }
        catch (OperationCanceledException) when (_lifetimeToken.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (JSException ex)
        {
            if (!_disposed)
            {
                _interopFailed = true;
                Snackbar.Add(L["EnumInfoViewer:Desk:NavigationFailed", ex.Message], Severity.Error);
                StateHasChanged();
            }
        }
        finally
        {
            if (acquired) _jsGate.Release();
        }
    }

    private ElementReference GetContainer(SearchSection section) => section switch
    {
        SearchSection.Assembly => _assemblyContainer,
        SearchSection.Enum => _enumContainer,
        SearchSection.Value => _valueContainer,
        _ => default
    };

    private void RevealPane(SearchSection section)
    {
        if (_disposed) return;
        _pendingFocusSection = section;
    }

    private async Task LoadAllEnumsAsync()
    {
        if (_disposed || _loading) return;
        _loading = true;
        _loadError = null;
        StateHasChanged();

        try
        {
            var selectedAssemblyFrom = SelectedAssembly?.From;
            var selectedEnumName = SelectedEnum?.Name;

            var result = await ProjectUnitsFacade.GetEnumInfoAsync();
            if (_disposed) return;
            if (result.IsFailed(out var error, out var data))
            {
                _loadError = L["Shared:Messages:LoadFailed", error];
                Snackbar.Add(_loadError, Severity.Error);
                return;
            }

            _enumGroups = data ?? [];
            _loaded = true;

            if (HasSearchQuery)
            {
                RebuildSearchMatches(selectFirstMatch: true);
            }
            else
            {
                RestoreSelection(selectedAssemblyFrom, selectedEnumName);
            }
        }
        catch (Exception ex)
        {
            if (_disposed) return;
            _loadError = L["Shared:Messages:LoadException", ex.Message];
            Snackbar.Add(_loadError, Severity.Error);
        }
        finally
        {
            if (!_disposed)
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private Task OnSearchTextChanged(string? value)
    {
        if (_disposed || _loading) return Task.CompletedTask;
        _searchText = value ?? string.Empty;
        RebuildSearchMatches(selectFirstMatch: true);
        return Task.CompletedTask;
    }

    private void SelectAssembly(int assemblyIndex)
    {
        if (_disposed || _loading) return;
        CancelPendingNavigation();
        _selectedAssemblyIndex = assemblyIndex;
        _selectedEnumIndex = null;
        SyncCurrentMatchFromSelection(SearchTargetType.Assembly, assemblyIndex, null, null);
    }

    private void SelectEnum(int assemblyIndex, int enumIndex)
    {
        if (_disposed || _loading) return;
        CancelPendingNavigation();
        _selectedAssemblyIndex = assemblyIndex;
        _selectedEnumIndex = enumIndex;
        SyncCurrentMatchFromSelection(SearchTargetType.Enum, assemblyIndex, enumIndex, null);
    }

    private void SelectValueMatch(int assemblyIndex, int enumIndex, int valueIndex)
    {
        if (_disposed || _loading) return;
        CancelPendingNavigation();
        _selectedAssemblyIndex = assemblyIndex;
        _selectedEnumIndex = enumIndex;
        SyncCurrentMatchFromSelection(SearchTargetType.Value, assemblyIndex, enumIndex, valueIndex);
    }

    private Task GoToPreviousMatchAsync()
    {
        if (_disposed || _loading || !HasSearchMatches)
        {
            return Task.CompletedTask;
        }

        _currentMatchIndex = (_currentMatchIndex - 1 + _searchMatches.Count) % _searchMatches.Count;
        ActivateCurrentMatch(requestScroll: true);
        return Task.CompletedTask;
    }

    private Task GoToNextMatchAsync()
    {
        if (_disposed || _loading || !HasSearchMatches)
        {
            return Task.CompletedTask;
        }

        _currentMatchIndex = (_currentMatchIndex + 1) % _searchMatches.Count;
        ActivateCurrentMatch(requestScroll: true);
        return Task.CompletedTask;
    }

    private void RebuildSearchMatches(bool selectFirstMatch)
    {
        _matchedAssemblyIndices.Clear();
        _matchedEnumIndices.Clear();
        _matchedValueIndices.Clear();
        _searchMatches.Clear();
        CancelPendingNavigation();

        _searchTerms = ParseSearchTerms(_searchText);

        if (!HasSearchQuery)
        {
            _currentMatchIndex = -1;
            return;
        }

        for (var assemblyIndex = 0; assemblyIndex < _enumGroups.Count; assemblyIndex++)
        {
            var group = _enumGroups[assemblyIndex];
            if (MatchesAssembly(group))
            {
                _matchedAssemblyIndices.Add(assemblyIndex);
                _searchMatches.Add(new SearchMatch(SearchTargetType.Assembly, assemblyIndex, null, null));
            }

            for (var enumIndex = 0; enumIndex < group.Enums.Count; enumIndex++)
            {
                var enumInfo = group.Enums[enumIndex];
                if (MatchesEnum(enumInfo))
                {
                    _matchedEnumIndices.Add((assemblyIndex, enumIndex));
                    _searchMatches.Add(new SearchMatch(SearchTargetType.Enum, assemblyIndex, enumIndex, null));
                }

                for (var valueIndex = 0; valueIndex < enumInfo.Values.Count; valueIndex++)
                {
                    var value = enumInfo.Values[valueIndex];
                    if (!MatchesValue(value))
                    {
                        continue;
                    }

                    _matchedValueIndices.Add((assemblyIndex, enumIndex, valueIndex));
                    _searchMatches.Add(new SearchMatch(SearchTargetType.Value, assemblyIndex, enumIndex, valueIndex));
                }
            }
        }

        if (!HasSearchMatches)
        {
            _currentMatchIndex = -1;
            return;
        }

        _currentMatchIndex = selectFirstMatch ? 0 : Math.Clamp(_currentMatchIndex, 0, _searchMatches.Count - 1);
        ActivateCurrentMatch(requestScroll: true);
    }

    private void ActivateCurrentMatch(bool requestScroll)
    {
        var match = CurrentMatch;
        if (match is null)
        {
            return;
        }

        _selectedAssemblyIndex = match.AssemblyIndex;
        _selectedEnumIndex = match.EnumIndex;

        if (!requestScroll)
        {
            return;
        }

        CancelPendingNavigation();
        _pendingScrollRequests.Add(new SearchScrollRequest(SearchSection.Assembly, GetAssemblySearchKey(match.AssemblyIndex)));

        if (match.EnumIndex is int enumIndex)
        {
            _pendingScrollRequests.Add(new SearchScrollRequest(SearchSection.Enum, GetEnumSearchKey(match.AssemblyIndex, enumIndex)));
        }

        if (match is { EnumIndex: int ownerEnumIndex, ValueIndex: int valueIndex })
        {
            _pendingScrollRequests.Add(new SearchScrollRequest(
                SearchSection.Value,
                GetValueSearchKey(match.AssemblyIndex, ownerEnumIndex, valueIndex)));
        }
    }

    private void SyncCurrentMatchFromSelection(
        SearchTargetType targetType,
        int assemblyIndex,
        int? enumIndex,
        int? valueIndex)
    {
        if (!HasSearchMatches)
        {
            return;
        }

        var matchedIndex = _searchMatches.FindIndex(match =>
            match.TargetType == targetType
            && match.AssemblyIndex == assemblyIndex
            && match.EnumIndex == enumIndex
            && match.ValueIndex == valueIndex);

        if (matchedIndex >= 0)
        {
            _currentMatchIndex = matchedIndex;
        }
    }

    private void CancelPendingNavigation()
    {
        _pendingScrollRequests.Clear();
        _pendingFocusSection = null;
        _scrollRevision++;
        _cancelPendingScroll = true;
    }

    private void RestoreSelection(string? selectedAssemblyFrom, string? selectedEnumName)
    {
        _selectedAssemblyIndex = null;
        _selectedEnumIndex = null;

        if (string.IsNullOrWhiteSpace(selectedAssemblyFrom))
        {
            return;
        }

        var assemblyIndex = _enumGroups.FindIndex(group =>
            string.Equals(group.From, selectedAssemblyFrom, StringComparison.Ordinal));

        if (assemblyIndex < 0)
        {
            return;
        }

        _selectedAssemblyIndex = assemblyIndex;

        if (string.IsNullOrWhiteSpace(selectedEnumName))
        {
            return;
        }

        var enumIndex = _enumGroups[assemblyIndex].Enums.FindIndex(enumInfo =>
            string.Equals(enumInfo.Name, selectedEnumName, StringComparison.Ordinal));

        if (enumIndex >= 0)
        {
            _selectedEnumIndex = enumIndex;
        }
    }

    private bool MatchesAssembly(DtoAssemblyEnumInfo group)
    {
        return MatchesText(GetShortAssemblyName(group.From), group.From);
    }

    private bool MatchesEnum(DtoEnumInfo enumInfo)
    {
        return MatchesText(enumInfo.Name);
    }

    private bool MatchesValue(DtoEnumValue value)
    {
        return MatchesText(
            value.Index.ToString(CultureInfo.InvariantCulture),
            value.Name,
            value.Description);
    }

    private bool MatchesText(params string?[] values)
    {
        if (!HasSearchQuery)
        {
            return false;
        }

        var searchableText = string.Join(' ',
            values.Where(static value => !string.IsNullOrWhiteSpace(value)));

        if (string.IsNullOrWhiteSpace(searchableText))
        {
            return false;
        }

        return _searchTerms.All(term =>
            searchableText.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static List<string> ParseSearchTerms(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return [];
        }

        return value
            .Split([' ', '\t', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private SearchMatch? CurrentMatch =>
        _currentMatchIndex >= 0 && _currentMatchIndex < _searchMatches.Count
            ? _searchMatches[_currentMatchIndex]
            : null;

    private string GetAssemblyPanelSummary()
    {
        if (!_loaded)
        {
            return L["EnumInfoViewer:Summaries:NotLoaded"];
        }

        return L.GetCountText(ProjectUnitsCountText.Assembly, _enumGroups.Count);
    }

    private string GetEnumPanelSummary()
    {
        if (SelectedAssembly is null)
        {
            return L["EnumInfoViewer:Summaries:SelectAssembly"];
        }

        return L.GetCountText(ProjectUnitsCountText.Enum, SelectedAssembly.Enums.Count);
    }

    private string GetValuePanelSummary()
    {
        if (SelectedEnum is null)
        {
            return L["EnumInfoViewer:Summaries:SelectEnum"];
        }

        return L.GetCountText(ProjectUnitsCountText.EnumValue, SelectedEnum.Values.Count);
    }

    private string GetSearchSummary()
    {
        if (!HasSearchQuery)
        {
            return L["EnumInfoViewer:Summaries:StartSearch"];
        }

        if (!HasSearchMatches)
        {
            return L.GetCountText(ProjectUnitsCountText.Match, 0);
        }

        return L["EnumInfoViewer:Summaries:MatchProgress", _currentMatchIndex + 1, _searchMatches.Count];
    }

    private string GetAssemblyItemClass(int assemblyIndex)
    {
        return BuildItemClass(
            isSelected: _selectedAssemblyIndex == assemblyIndex,
            isMatched: _matchedAssemblyIndices.Contains(assemblyIndex),
            isCurrent: CurrentMatch is
            {
                TargetType: SearchTargetType.Assembly,
                AssemblyIndex: var currentAssemblyIndex
            } && currentAssemblyIndex == assemblyIndex);
    }

    private string GetEnumItemClass(int assemblyIndex, int enumIndex)
    {
        return BuildItemClass(
            isSelected: _selectedAssemblyIndex == assemblyIndex && _selectedEnumIndex == enumIndex,
            isMatched: _matchedEnumIndices.Contains((assemblyIndex, enumIndex)),
            isCurrent: CurrentMatch is
            {
                TargetType: SearchTargetType.Enum,
                AssemblyIndex: var currentAssemblyIndex,
                EnumIndex: var currentEnumIndex
            } && currentAssemblyIndex == assemblyIndex && currentEnumIndex == enumIndex);
    }

    private string GetValueItemClass(int assemblyIndex, int enumIndex, int valueIndex)
    {
        return BuildItemClass(
            isSelected: false,
            isMatched: _matchedValueIndices.Contains((assemblyIndex, enumIndex, valueIndex)),
            isCurrent: CurrentMatch is
            {
                TargetType: SearchTargetType.Value,
                AssemblyIndex: var currentAssemblyIndex,
                EnumIndex: var currentEnumIndex,
                ValueIndex: var currentValueIndex
            }
            && currentAssemblyIndex == assemblyIndex
            && currentEnumIndex == enumIndex
            && currentValueIndex == valueIndex);
    }

    private static string BuildItemClass(bool isSelected, bool isMatched, bool isCurrent)
    {
        var classes = new List<string> { "enum-info-viewer__item" };

        if (isSelected)
        {
            classes.Add("enum-info-viewer__item--selected");
        }

        if (isMatched)
        {
            classes.Add("enum-info-viewer__item--match");
        }

        if (isCurrent)
        {
            classes.Add("enum-info-viewer__item--current");
        }

        return string.Join(' ', classes);
    }

    private static string GetAssemblySearchKey(int assemblyIndex) => $"assembly-{assemblyIndex}";

    private static string GetEnumSearchKey(int assemblyIndex, int enumIndex) => $"enum-{assemblyIndex}-{enumIndex}";

    private static string GetValueSearchKey(int assemblyIndex, int enumIndex, int valueIndex) =>
        $"value-{assemblyIndex}-{enumIndex}-{valueIndex}";

    private string GetShortAssemblyName(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            return L["Shared:Labels:Unknown"];
        }

        var parts = fullName.Split(',');
        return parts.Length > 0 ? parts[0] : fullName;
    }

    public ValueTask DisposeAsync() => new(_disposeTask ??= DisposeCoreAsync());

    private async Task DisposeCoreAsync()
    {
        if (_disposed) return;
        _disposed = true;
        _lifetime.Cancel();
        _pendingScrollRequests.Clear();
        _pendingFocusSection = null;
        await _jsGate.WaitAsync();
        try
        {
            var controller = _scrollController;
            var module = _jsModule;
            _scrollController = null;
            _jsModule = null;
            try
            {
                if (controller is not null) await StopControllerAsync(controller);
            }
            finally
            {
                if (module is not null) await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        finally
        {
            _jsGate.Release();
            _jsGate.Dispose();
            _lifetime.Dispose();
        }
    }

    private static async ValueTask StopControllerAsync(IJSObjectReference controller)
    {
        try
        {
            await controller.InvokeVoidAsync("dispose");
        }
        catch (JSDisconnectedException) { }
        finally
        {
            await controller.DisposeAsync();
        }
    }

    private sealed class SearchMatch(
        SearchTargetType targetType,
        int assemblyIndex,
        int? enumIndex,
        int? valueIndex)
    {
        public SearchTargetType TargetType { get; } = targetType;

        public int AssemblyIndex { get; } = assemblyIndex;

        public int? EnumIndex { get; } = enumIndex;

        public int? ValueIndex { get; } = valueIndex;
    }

    private sealed class SearchScrollRequest(SearchSection section, string searchKey)
    {
        public SearchSection Section { get; } = section;

        public string SearchKey { get; } = searchKey;
    }

    private enum SearchTargetType
    {
        Assembly,
        Enum,
        Value
    }

    private enum SearchSection
    {
        Assembly,
        Enum,
        Value
    }
}
