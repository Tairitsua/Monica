@using Monica.UI.Shared.Components.Dialogs
@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.Markdown.Models
@inject IStringLocalizer<AIResource> L

<div class="knowledge-dialog-owner">
<MudDialog DefaultFocus="DefaultFocus.FirstChild" ContentClass="pa-0 knowledge-dialog-content" ActionsClass="pa-0" Style="width:calc(100vw - 24px);max-height:calc(100dvh - 24px);margin:12px;overflow:hidden">
    <TitleContent><MoDialogHeading Text="@L["KnowledgeBase:DocumentImport:Title"]" /></TitleContent>
    <DialogContent>
        <div class="document-selection-content">
            @if (AvailableDocuments.FirstOrDefault() is { } source)
            {
                <p class="source-group">@L["KnowledgeDialogs:SourceGroup", source.GroupKey]</p>
            }
            <MudTextField T="string" @bind-Value="_filter" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Label="@L["KnowledgeDialogs:FilterSources"]" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" />
            <div class="selection-header">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @L["RAG:DocumentSelection:Selected", SelectedDocuments.Count]
                </MudText>
                <div class="selection-actions">
                    <MudButton Size="Size.Small"
                               OnClick="SelectAll"
                               Disabled="@(SelectedDocuments.Count == AvailableDocuments.Count)">
                        @L["RAG:DocumentSelection:SelectAll"]
                    </MudButton>
                    <MudButton Size="Size.Small"
                               OnClick="DeselectAll"
                               Disabled="@(SelectedDocuments.Count == 0)">
                        @L["RAG:DocumentSelection:DeselectAll"]
                    </MudButton>
                </div>
            </div>

            <MudDivider Class="my-3" />

            <div class="document-list">
                @foreach (var doc in FilteredDocuments)
                {
                    <div class="document-item">
                        <MudCheckBox CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="bool"
                                     aria-label="@doc.Title"
                                     Value="@SelectedDocuments.Contains(doc.RelativePath)"
                                     ValueChanged="@((bool value) => ToggleDocument(doc.RelativePath, value))"
                                     Color="Color.Primary"
                                     Dense="true" />
                        <div class="document-info">
                            <MudText Typo="Typo.body2">@doc.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @doc.RelativePath
                            </MudText>
                        </div>
                        @if (ExistingDocumentIds.Contains(doc.RelativePath))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                @L["KnowledgeBase:DocumentImport:AlreadyAdded"]
                            </MudChip>
                        }
                    </div>
                }
                @if (!FilteredDocuments.Any())
                {
                    <MoContentState Compact="true" role="status">@L["KnowledgeDialogs:NoMatchingSources"]</MoContentState>
                }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="dialog-actions">
            <MudButton OnClick="Cancel">@L["Common:Cancel"]</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       OnClick="Submit"
                       Disabled="@(SelectedDocuments.Count == 0)">
                @L["KnowledgeDialogs:AddSelected", SelectedDocuments.Count]
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
</div>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public List<MarkdownDocument> AvailableDocuments { get; set; } = new();

    [Parameter]
    public HashSet<string> ExistingDocumentIds { get; set; } = new();

    private HashSet<string> SelectedDocuments { get; set; } = new();
    private string _filter = string.Empty;
    private IEnumerable<MarkdownDocument> FilteredDocuments => AvailableDocuments.Where(document =>
        string.IsNullOrWhiteSpace(_filter) || document.Title.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)
        || document.RelativePath.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase));

    private void ToggleDocument(string documentId, bool isChecked)
    {
        if (isChecked)
        {
            if (!SelectedDocuments.Contains(documentId))
                SelectedDocuments.Add(documentId);
        }
        else
        {
            SelectedDocuments.Remove(documentId);
        }

    }

    private void SelectAll()
    {
        SelectedDocuments = AvailableDocuments.Select(d => d.RelativePath).ToHashSet();
    }

    private void DeselectAll()
    {
        SelectedDocuments.Clear();
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Submit()
    {
        if (SelectedDocuments.Count == 0) return;
        MudDialog.Close(DialogResult.Ok(SelectedDocuments.ToList()));
    }
}
