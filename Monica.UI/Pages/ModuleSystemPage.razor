@attribute [Route(MODULE_SYSTEM_DASHBOARD_URL)]
@attribute [Route(MODULE_SYSTEM_SECTION_URL)]
@implements IAsyncDisposable
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.Core.Results
@using Monica.UI.Localization
@using Monica.UI.Shell.Support
@using Monica.UI.UIModuleSystem.State
@using Monica.UI.UIModuleSystem.Support
@inject ModuleSystemWorkbenchSessionFactory SessionFactory
@inject PageAccessEvaluator PageAccess
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IStringLocalizer<ModuleSystemResource> L

<PageTitle>@L["Page:Title"]</PageTitle>

<div class="module-workbench-page">
    @if (!_accessChecked)
    {
        <div class="workbench-centered-state" role="status">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1">@L["Access:Checking"]</MudText>
        </div>
    }
    else if (!_isAuthorized || _session?.IsAccessDenied == true)
    {
        <div class="workbench-centered-state" role="alert">
            <MoIcon Icon="@MoIcons.Lock" Style="color:var(--mud-palette-warning)" Size="2.25rem" />
            <MudText Typo="Typo.h5">@L["Access:DeniedTitle"]</MudText>
            <MudText Typo="Typo.body1">@L["Access:DeniedDescription"]</MudText>
        </div>
    }
    else if (_session is not null)
    {
        <MudDrawerContainer Class="workbench-drawer-container">
            <ModuleWorkbenchHeader Session="@_session"
                                   RefreshRequested="@Refresh"
                                   ExportRequested="@ExportAsync"
                                   BaselineSelected="@ImportBaselineAsync"
                                   HelpRequested="@OpenHelp" />

            <nav class="workbench-section-navigation" aria-label="@L["Aria:SectionNavigation"]">
                <div class="workbench-desktop-sections">
                    @foreach (var workbenchSection in Sections)
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   Class="@(workbenchSection == _session.Section ? "is-active" : null)"
                                   StartIcon="@SectionIcon(workbenchSection)"
                                   aria-current="@(workbenchSection == _session.Section ? "page" : null)"
                                   OnClick="@(() => NavigateToSection(workbenchSection))">
                            @SectionText(workbenchSection)
                        </MudButton>
                    }
                </div>
                <div class="workbench-mobile-section">
                    <MudSelect T="ModuleSystemWorkbenchSection"
                               Label="@L["Common:Section"]"
                               Value="@_session.Section"
                               ValueChanged="@NavigateToSection"
                               FullWidth="true" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                        @foreach (var workbenchSection in Sections)
                        {
                            <MudSelectItem T="ModuleSystemWorkbenchSection" Value="@workbenchSection">
                                @SectionText(workbenchSection)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </div>
            </nav>

            <main class="workbench-main" id="module-workbench-content">
                @if (_session.Snapshot is null)
                {
                    <ModuleWorkbenchLoadState Session="@_session" RetryRequested="@Refresh" />
                }
                else
                {
                    @switch (_session.Section)
                    {
                        case ModuleSystemWorkbenchSection.Overview:
                            <ModuleWorkbenchOverview Session="@_session"
                                                     ModuleSelected="@SelectModule" />
                            break;
                        case ModuleSystemWorkbenchSection.Performance:
                            <ModuleWorkbenchPerformance Session="@_session"
                                                        ModuleSelected="@SelectModule" />
                            break;
                        case ModuleSystemWorkbenchSection.Modules:
                            <ModuleWorkbenchModules Session="@_session"
                                                    ModuleSelected="@SelectModule" />
                            break;
                        case ModuleSystemWorkbenchSection.Dependencies:
                            <ModuleWorkbenchDependencies Session="@_session"
                                                         ModuleSelected="@SelectModule" />
                            break;
                        case ModuleSystemWorkbenchSection.Discovery:
                            <ModuleWorkbenchDiscovery Session="@_session" />
                            break;
                    }
                }
            </main>

            <ModuleWorkbenchModuleDrawer Session="@_session"
                                         OpenChanged="@OnModuleDrawerOpenChanged"
                                         ModuleSelected="@SelectModule"
                                         NavigateToDependencies="@OpenSelectedDependencies" />
            <ModuleWorkbenchHelpDrawer Session="@_session" OpenChanged="@OnHelpOpenChanged" />
        </MudDrawerContainer>
    }
</div>

@code {
    public const string MODULE_SYSTEM_DASHBOARD_URL = "/module-system-dashboard";
    public const string MODULE_SYSTEM_SECTION_URL = "/module-system-dashboard/{Section}";
    private const string FILE_TRANSFER_MODULE_PATH = "./_content/Monica.UI/js/module-workbench-file.js";
    private const long MAX_BASELINE_SIZE_BYTES = 10 * 1024 * 1024;
    private static readonly ModuleSystemWorkbenchSection[] Sections = Enum.GetValues<ModuleSystemWorkbenchSection>();

    [Parameter] public string? Section { get; set; }
    [SupplyParameterFromQuery(Name = "module")] public string? SelectedModuleId { get; set; }

    private ModuleSystemWorkbenchSession? _session;
    private Task _pendingRender = Task.CompletedTask;
    private bool _accessChecked;
    private bool _isAuthorized;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        var isAuthorized = await PageAccess.IsAuthorizedAsync(MODULE_SYSTEM_DASHBOARD_URL);
        if (_disposed)
        {
            return;
        }

        _isAuthorized = isAuthorized;
        _accessChecked = true;
        if (!isAuthorized)
        {
            return;
        }

        _session = SessionFactory.Create(
            () => PageAccess.IsAuthorizedAsync(MODULE_SYSTEM_DASHBOARD_URL));
        _session.Changed += HandleSessionChanged;
        _session.SetSection(ModuleSystemWorkbenchSectionExtensions.Parse(Section));
        await _session.InitializeAsync();
        if (_disposed)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(SelectedModuleId))
        {
            _session.SelectModule(SelectedModuleId, openDrawer: true);
        }
    }

    protected override void OnParametersSet()
    {
        if (_session is null)
        {
            return;
        }

        _session.SetSection(ModuleSystemWorkbenchSectionExtensions.Parse(Section));
        if (string.IsNullOrWhiteSpace(SelectedModuleId))
        {
            if (_session.IsModuleDrawerOpen)
            {
                _session.CloseModuleDrawer();
            }

            return;
        }

        if (!_session.IsModuleDrawerOpen
            || !string.Equals(_session.SelectedModule?.ModuleKey.Id, SelectedModuleId, StringComparison.Ordinal))
        {
            _session.SelectModule(SelectedModuleId, openDrawer: true);
        }
    }

    private void HandleSessionChanged()
    {
        _pendingRender = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private async Task Refresh()
    {
        if (_session is not null)
        {
            await _session.RefreshAsync();
            if (!_disposed && !_session.IsAccessDenied)
                await _session.RefreshResourceActivationsAsync();
        }
    }

    private void NavigateToSection(ModuleSystemWorkbenchSection section)
    {
        if (_session is null)
        {
            return;
        }

        _session.SetSection(section);
        var uri = $"{MODULE_SYSTEM_DASHBOARD_URL}/{section.ToRouteSegment()}";
        if (_session is { IsModuleDrawerOpen: true, SelectedModule: { } selectedModule })
        {
            uri = $"{uri}?module={Uri.EscapeDataString(selectedModule.ModuleKey.Id)}";
        }

        Navigation.NavigateTo(uri, replace: true);
    }

    private void SelectModule(ModuleDiagnosticsModule module)
    {
        if (_session is null)
        {
            return;
        }

        var preserveCriticalSelection = _session.SelectedTraceSpanId is not null
                                        && _session.SelectedModule?.ModuleKey == module.ModuleKey;
        _session.SelectModule(
            module,
            drawerTabIndex: preserveCriticalSelection ? _session.ModuleDrawerTabIndex : 0);
        var uri = Navigation.GetUriWithQueryParameter("module", module.ModuleKey.Id);
        Navigation.NavigateTo(uri, replace: true);
    }

    private Task OnModuleDrawerOpenChanged(bool isOpen)
    {
        if (_session is null)
        {
            return Task.CompletedTask;
        }

        if (!isOpen)
        {
            _session.CloseModuleDrawer();
            ClearSelectedModuleQuery();
        }

        return Task.CompletedTask;
    }

    private void OpenSelectedDependencies()
    {
        _session?.CloseModuleDrawer();
        NavigateToSection(ModuleSystemWorkbenchSection.Dependencies);
    }

    private void OpenHelp()
    {
        _session?.SetHelpDrawer(true);
        ClearSelectedModuleQuery();
    }

    private void ClearSelectedModuleQuery()
    {
        var uri = Navigation.GetUriWithQueryParameter("module", (string?)null);
        if (!string.Equals(uri, Navigation.Uri, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(uri, replace: true);
        }
    }

    private Task OnHelpOpenChanged(bool isOpen)
    {
        _session?.SetHelpDrawer(isOpen);
        return Task.CompletedTask;
    }

    private async Task ExportAsync()
    {
        var session = _session;
        if (session is null)
        {
            return;
        }

        var result = await session.CreateExportAsync();
        if (_disposed || !ReferenceEquals(session, _session))
        {
            return;
        }

        if (result.IsFailed(out _, out var export))
        {
            Snackbar.Add(L["Export:Failed"], Severity.Error);
            return;
        }

        IJSObjectReference? module = null;
        try
        {
            module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", FILE_TRANSFER_MODULE_PATH);
            if (_disposed)
            {
                return;
            }

            var json = JsonSerializer.Serialize(export, new JsonSerializerOptions { WriteIndented = true });
            await module.InvokeVoidAsync(
                "downloadJson",
                $"monica-module-diagnostics-{export.Revision}.json",
                json);
        }
        catch (JSDisconnectedException)
        {
            // The browser circuit disconnected during an explicit export action.
        }
        catch (JSException)
        {
            if (!_disposed)
            {
                Snackbar.Add(L["Export:Failed"], Severity.Error);
            }
        }
        finally
        {
            if (module is not null)
            {
                try
                {
                    await module.DisposeAsync();
                }
                catch (JSDisconnectedException)
                {
                    // The circuit disconnected before the late-created module reference could be released.
                }
                catch (JSException)
                {
                    // A failed browser context cannot retain a usable module reference.
                }
            }
        }
    }

    private async Task ImportBaselineAsync(InputFileChangeEventArgs args)
    {
        var session = _session;
        if (session is null)
        {
            return;
        }

        try
        {
            await using var stream = args.File.OpenReadStream(MAX_BASELINE_SIZE_BYTES);
            await session.ImportBaselineAsync(stream);
        }
        catch (IOException)
        {
            if (!_disposed && ReferenceEquals(session, _session))
            {
                Snackbar.Add(L["Comparison:FileTooLarge"], Severity.Error);
            }
        }
    }

    private string SectionText(ModuleSystemWorkbenchSection section) => L[$"Sections:{section}"];

    private static string SectionIcon(ModuleSystemWorkbenchSection section) => section switch
    {
        ModuleSystemWorkbenchSection.Overview => MoIcons.Dashboard,
        ModuleSystemWorkbenchSection.Performance => MoIcons.ChartLine,
        ModuleSystemWorkbenchSection.Modules => MoIcons.Grid,
        ModuleSystemWorkbenchSection.Dependencies => MoIcons.Workflow,
        ModuleSystemWorkbenchSection.Discovery => MoIcons.FileSearch,
        _ => MoIcons.Dashboard
    };

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        if (_session is not null)
        {
            _session.Changed -= HandleSessionChanged;
            await _session.DisposeAsync();
        }

        await _pendingRender;
    }
}
