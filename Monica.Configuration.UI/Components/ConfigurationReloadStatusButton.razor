@inject ConfigurationFacade Facade
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<span class="configuration-reload-status-anchor">
    <ConfigurationStatusIconButton Icon="@StatusIcon"
                                   Color="@StatusColor"
                                   Count="@DriftCount"
                                   ShowCount="@(DriftCount > 0)"
                                   Disabled="@_loading"
                                   Tooltip="@StatusTooltip"
                                   AriaLabel="@L["State:ReloadStatus:OpenDetails"].Value"
                                   OnClick="TogglePopover" />

    <MudPopover Open="@_popoverOpen"
                AnchorOrigin="Origin.BottomLeft"
                TransformOrigin="Origin.TopLeft"
                OverflowBehavior="OverflowBehavior.FlipAlways"
                Class="configuration-reload-status-popover"
                Style="width: min(44rem, calc(100vw - 48px)); box-sizing: border-box;"
                Paper="false">
        <div class="configuration-reload-status-popover-content">
        <MudPaper Elevation="6" Class="pa-3">
            <MudStack Spacing="2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MoIcon Icon="@StatusIcon" Style="@StatusIconStyle" Size="1.5rem" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1">@L["State:ReloadStatus:Title"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@StatusSummary</MudText>
                        </MudStack>
                    </MudStack>
                    <MudTooltip Text="@L["Common:Actions:Close"]">
                        <MudIconButton Icon="@MoIcons.Close"
                                       Size="Size.Small"
                                       OnClick="ClosePopover"
                                       aria-label="@L["Common:Actions:Close"]" />
                    </MudTooltip>
                </MudStack>

                @if (_loading && _report is null)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@L["Common:States:Loading"]</MudText>
                    </MudStack>
                }
                else if (_report is null)
                {
                    <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning">@L["State:ReloadStatus:Unavailable"]</MudAlert>
                }
                else
                {
                    <MudGrid Spacing="2">
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["State:ReloadStatus:ReloadCount"]</MudText>
                            <MudText Typo="Typo.body2">@_report.Runtime.ReloadCount</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["State:ReloadStatus:LastReloadedAt"]</MudText>
                            <MudText Typo="Typo.body2">@FormatTime(_report.Runtime.LastReloadedAt)</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["State:ReloadStatus:LastReloadDuration"]</MudText>
                            <MudText Typo="Typo.body2">@FormatDuration(_report.Runtime.LastReloadDuration)</MudText>
                        </MudItem>
                        @if (_report.EffectiveValueStore is { } effectiveStore)
                        {
                            <MudItem xs="6" sm="3">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["State:ReloadStatus:EffectiveStore"]</MudText>
                                <MudText Typo="Typo.body2">@effectiveStore.DisplayName</MudText>
                            </MudItem>
                        }
                    </MudGrid>

                    @if (!HasManagedStore)
                    {
                        <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["State:ReloadStatus:NoManagedDefinitions"]</MudAlert>
                    }
                    else if (!_report.Runtime.IsProviderActive)
                    {
                        <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning">@L["State:ReloadStatus:ProviderInactive"]</MudAlert>
                    }
                    else if (_report.IsCurrent)
                    {
                        <MudAlert Icon="@MoIcons.Success" Severity="Severity.Success">@L["State:ReloadStatus:DefinitionsCurrent"]</MudAlert>
                    }
                    else
                    {
                        <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@L["State:ReloadStatus:DriftDefinitions", DriftCount]</MudAlert>
                        <div class="configuration-reload-version-list">
                            @foreach (var item in DriftDefinitions)
                            {
                                <div class="configuration-reload-version-row">
                                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                                        <MudStack Spacing="0" Class="configuration-reload-definition-copy">
                                            <MudText Typo="Typo.subtitle2">@item.DisplayName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@item.DefinitionKey</MudText>
                                        </MudStack>
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="@VersionStatusColor(item.Status)"
                                                 Variant="Variant.Outlined">
                                            @VersionStatusLabel(item.Status)
                                        </MudChip>
                                    </MudStack>
                                    <MudGrid Spacing="2">
                                        <MudItem xs="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["State:ReloadStatus:RuntimeVersion"]</MudText>
                                            <MudText Typo="Typo.body2">@FormatVersion(item.RuntimeLoadedVersion)</MudText>
                                        </MudItem>
                                        <MudItem xs="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["State:ReloadStatus:StoreVersion"]</MudText>
                                            <MudText Typo="Typo.body2">@FormatVersion(item.EffectiveStoreVersion)</MudText>
                                        </MudItem>
                                        <MudItem xs="4">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["State:ReloadStatus:StoreModifiedAt"]</MudText>
                                            <MudText Typo="Typo.body2">@FormatTime(item.EffectiveLastModifiedAt)</MudText>
                                        </MudItem>
                                    </MudGrid>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_report.Runtime.LastFailureMessage))
                    {
                        <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning">
                            @L["State:ReloadStatus:LastFailure", FormatTime(_report.Runtime.LastFailedAt), _report.Runtime.LastFailureMessage]
                        </MudAlert>
                    }
                }

                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Spacing="1">
                    <MudButton Variant="Variant.Text"
                               Size="Size.Small"
                               StartIcon="@MoIcons.Refresh"
                               Disabled="@(_loading || _reloading)"
                               OnClick="RefreshAsync">
                        @L["State:ReloadStatus:RefreshStatus"]
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@MoIcons.Refresh"
                               Disabled="@(_loading || _reloading || _broadcasting || !HasManagedStore)"
                               OnClick="ReloadAsync">
                        @(_reloading ? L["State:ReloadStatus:Reloading"] : L["State:ReloadStatus:ManualReload"])
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Secondary"
                               Size="Size.Small"
                               StartIcon="@MoIcons.Megaphone"
                               Disabled="@(_loading || _reloading || _broadcasting || !HasManagedStore)"
                               OnClick="BroadcastReloadAllAsync">
                        @(_broadcasting ? L["State:ReloadStatus:Broadcasting"] : L["State:ReloadStatus:BroadcastReloadAll"])
                    </MudButton>
                </MudStack>
            </MudStack>
        </MudPaper>
        </div>
    </MudPopover>
    <MudOverlay Visible="@_popoverOpen"
                AutoClose="true"
                OnClosed="ClosePopover"
                LockScroll="false"
                Modal="false" />
</span>

@code {
    [Parameter] public EventCallback Reloaded { get; set; }

    private ConfigurationReloadStatusReport? _report;
    private bool _loading;
    private bool _reloading;
    private bool _broadcasting;
    private bool _popoverOpen;

    private int DriftCount => _report?.DriftCount ?? 0;

    private bool HasManagedStore => _report?.EffectiveValueStore is not null;

    private IEnumerable<ConfigurationDefinitionReloadStatus> DriftDefinitions =>
        (_report?.Definitions ?? [])
        .Where(static definition => definition.HasVersionDrift)
        .OrderBy(static definition => definition.DisplayName, StringComparer.OrdinalIgnoreCase);

    private Color StatusColor =>
        _report is null
            ? Color.Warning
            : !HasManagedStore
                ? Color.Info
            : !_report.Runtime.IsProviderActive
                ? Color.Warning
                : _report.IsCurrent
                    ? Color.Success
                    : Color.Error;

    private string StatusIconStyle => StatusColor switch
    {
        Color.Success => "color:var(--mud-palette-success)",
        Color.Error => "color:var(--mud-palette-error)",
        Color.Info => "color:var(--mud-palette-info)",
        _ => "color:var(--mud-palette-warning)"
    };

    private string StatusIcon =>
        _report is null
            ? MoIcons.Help
            : !HasManagedStore
                ? MoIcons.Info
            : !_report.Runtime.IsProviderActive
                ? MoIcons.Warning
                : _report.IsCurrent
                    ? MoIcons.Refresh
                    : MoIcons.SyncOff;

    private string StatusSummary =>
        _report is null
            ? L["State:ReloadStatus:Unavailable"].Value
            : !HasManagedStore
                ? L["State:ReloadStatus:NoManagedDefinitions"].Value
            : !_report.Runtime.IsProviderActive
                ? L["State:ReloadStatus:ProviderInactive"].Value
                : _report.IsCurrent
                    ? L["State:ReloadStatus:CurrentSummary"].Value
                    : L["State:ReloadStatus:DriftSummary", DriftCount].Value;

    private string StatusTooltip => $"{L["State:ReloadStatus:Title"]}: {StatusSummary}";

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    public async Task RefreshAsync()
    {
        _loading = true;
        try
        {
            var result = await Facade.GetRuntimeReloadStatusAsync();
            if (result.IsFailed(out var error, out var report))
            {
                Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
                _report = null;
                return;
            }

            _report = report;
        }
        finally
        {
            _loading = false;
        }
    }

    public async Task OpenAsync(ConfigurationReloadStatusReport report)
    {
        _report = report;
        _popoverOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadAsync()
    {
        if (!HasManagedStore) return;
        _reloading = true;
        try
        {
            var result = await Facade.ReloadRuntimeConfigurationAsync();
            if (result.IsFailed(out var error, out var report))
            {
                Snackbar.Add($"{L["State:ReloadStatus:ReloadFailed"]}: {error.Message}", Severity.Error);
                return;
            }

            _report = report;
            Snackbar.Add(L["State:ReloadStatus:ReloadSuccess"], Severity.Success);
            await Reloaded.InvokeAsync();
        }
        finally
        {
            _reloading = false;
        }
    }

    private async Task BroadcastReloadAllAsync()
    {
        if (!HasManagedStore) return;
        _broadcasting = true;
        try
        {
            var result = await Facade.BroadcastReloadAllAsync();
            if (result.IsFailed(out var error, out var broadcast))
            {
                Snackbar.Add($"{L["State:ReloadStatus:BroadcastFailed"]}: {error.Message}", Severity.Error);
                return;
            }

            await RefreshAsync();
            await Reloaded.InvokeAsync();
            if (broadcast.PostCommitIssues.Count == 0)
            {
                Snackbar.Add(L["State:ReloadStatus:BroadcastPublished"], Severity.Success);
                return;
            }

            Snackbar.Add(L["State:ReloadStatus:BroadcastWarning"], Severity.Warning);
            var parameters = new DialogParameters<ConfigurationPostCommitIssuesDialog>();
            parameters.Add(dialog => dialog.Issues, broadcast.PostCommitIssues);
            parameters.Add(dialog => dialog.SummaryText, L["State:ReloadStatus:BroadcastIssueSummary"].Value);
            var dialog = await DialogService.ShowAsync<ConfigurationPostCommitIssuesDialog>(
                L["State:ReloadStatus:BroadcastWarningTitle"],
                parameters,
                ConfigurationPostCommitIssuesDialog.DefaultOptions);
            await dialog.Result;
        }
        finally
        {
            _broadcasting = false;
        }
    }

    private void TogglePopover()
    {
        _popoverOpen = !_popoverOpen;
    }

    private void ClosePopover()
    {
        _popoverOpen = false;
    }

    private string FormatVersion(long? version)
    {
        return version is null ? L["State:ReloadStatus:UnknownValue"].Value : L["State:ReloadStatus:VersionValue", version.Value].Value;
    }

    private string FormatTime(DateTimeOffset? time)
    {
        return time is null ? L["State:ReloadStatus:Never"].Value : time.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
    }

    private string FormatDuration(TimeSpan? duration)
    {
        return duration is null
            ? L["State:ReloadStatus:Never"].Value
            : L["State:ReloadStatus:DurationMs", Math.Round(duration.Value.TotalMilliseconds, 1)].Value;
    }

    private string VersionStatusLabel(ConfigurationReloadVersionStatus status)
    {
        return L[$"State:ReloadStatus:Statuses:{status}"];
    }

    private static Color VersionStatusColor(ConfigurationReloadVersionStatus status)
    {
        return status switch
        {
            ConfigurationReloadVersionStatus.Current => Color.Success,
            ConfigurationReloadVersionStatus.Stale => Color.Error,
            ConfigurationReloadVersionStatus.Ahead => Color.Warning,
            ConfigurationReloadVersionStatus.NotLoaded => Color.Warning,
            ConfigurationReloadVersionStatus.MissingEffectiveValue => Color.Warning,
            _ => Color.Default
        };
    }
}
