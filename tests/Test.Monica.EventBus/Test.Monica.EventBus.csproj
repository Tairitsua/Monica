<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Test.Monica.EventBus</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <!-- Host-owned EventBus workbench scenarios exercise the real shell endpoint/static-asset pipeline. -->
    <OutputType>Library</OutputType>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Monica.ApplicationModel\Monica.ApplicationModel.csproj" />
    <ProjectReference Include="..\..\Monica.EventBus\Monica.EventBus.csproj" />
    <ProjectReference Include="..\..\Monica.Framework.UI\Monica.Framework.UI.csproj" />
    <ProjectReference Include="..\..\Monica.Testing\Monica.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
</Project>
