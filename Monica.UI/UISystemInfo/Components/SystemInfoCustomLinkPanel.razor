@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@using Monica.UI.UISystemInfo.Models
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IStringLocalizer<SystemInfoResource> L

@{
    var groups = BuildVisibleGroups();
    var visibleLinkCount = groups.Sum(static group => group.Links.Count);
}

@if (visibleLinkCount > 0)
{
    <section class="system-info-links" aria-labelledby="system-info-links-title">
        <header class="system-info-links__header">
            <span class="system-info-links__signal"><MoIcon Size="16px" Icon="@MoIcons.Link" /></span>
            <div>
                <h2 id="system-info-links-title">@L["CustomLinks:Title"]</h2>
                <p>@L["CustomLinks:Description"]</p>
            </div>
            <span class="system-info-links__count">@visibleLinkCount</span>
        </header>

        <div class="system-info-links__groups">
            @foreach (var group in groups)
            {
                <section class="system-info-links__group">
                    @if (group.HasTitle)
                    {
                        <div class="system-info-links__group-title">
                            <span>@group.Title</span>
                            <b>@group.Links.Count</b>
                        </div>
                    }

                    <div class="system-info-links__items">
                        @foreach (var link in group.Links)
                        {
                            <article class="system-info-link">
                                <a class="system-info-link__anchor"
                                   href="@link.Url"
                                   target="@TargetValue(link.Target)"
                                   rel="@LinkRelationship(link.Target)"
                                   title="@L["CustomLinks:Actions:Open"]">
                                    <span class="system-info-link__icon"><MoIcon Size="1.5rem" Icon="@link.Icon" /></span>
                                    <span class="system-info-link__identity">
                                        <strong>@link.GetDisplayName(L)</strong>
                                        @if (link.GetDescription(L) is { Length: > 0 } description)
                                        {
                                            <small>@description</small>
                                        }
                                    </span>
                                    <span class="system-info-link__target">@TargetLabel(link.Target)</span>
                                    <MoIcon Icon="@(link.Target == SystemInfoCustomLinkTarget.NewTab ? MoIcons.ArrowUpRight : MoIcons.ChevronRight)" Size="16px" />
                                </a>

                                @if (link.HasCredentials)
                                {
                                    <div class="system-info-link__access">
                                        <MudMenu AriaLabel="@L["CustomLinks:Actions:ShowAccess"]"
                                                 AnchorOrigin="Origin.BottomRight"
                                                 TransformOrigin="Origin.TopRight">
                                            <ActivatorContent Context="menu">
                                                <MudButton Variant="Variant.Text"
                                                           Color="Color.Primary"
                                                           Size="Size.Small"
                                                           StartIcon="@MoIcons.Key"
                                                           OnClick="menu.OpenAsync">
                                                    @L["CustomLinks:Labels:Access"]
                                                </MudButton>
                                            </ActivatorContent>
                                            <ChildContent>
                                                @if (link.HasUserName)
                                                {
                                                    <MudMenuItem title="@L["CustomLinks:Labels:UserName"]"
                                                                 OnClick="@(() => CopyValueAsync(
                                                        link.UserName!,
                                                        L["CustomLinks:Messages:CopyUserNameSucceeded"],
                                                        L["CustomLinks:Messages:CopyUserNameFailed"]))">
                                                        @L["CustomLinks:Actions:CopyUserName"]
                                                    </MudMenuItem>
                                                }
                                                @if (link.HasPassword)
                                                {
                                                    <MudMenuItem title="@L["CustomLinks:Labels:Password"]"
                                                                 OnClick="@(() => CopyValueAsync(
                                                        link.Password!,
                                                        L["CustomLinks:Messages:CopyPasswordSucceeded"],
                                                        L["CustomLinks:Messages:CopyPasswordFailed"]))">
                                                        @L["CustomLinks:Actions:CopyPassword"]
                                                    </MudMenuItem>
                                                }
                                            </ChildContent>
                                        </MudMenu>
                                    </div>
                                }
                            </article>
                        }
                    </div>
                </section>
            }
        </div>
    </section>
}

@code {
    [Parameter] public IReadOnlyCollection<SystemInfoCustomLink>? Links { get; set; }

    private IReadOnlyList<SystemInfoCustomLinkGroup> BuildVisibleGroups()
    {
        var visibleLinks = Links?
            .Where(static link => link.Enabled)
            .OrderBy(static link => link.Order)
            .ThenBy(link => link.GetDisplayName(L), StringComparer.CurrentCultureIgnoreCase)
            .ToList() ?? [];

        return visibleLinks
            .GroupBy(link => link.GetCategory(L))
            .Select(static group => new SystemInfoCustomLinkGroup(group.Key, group.ToList()))
            .ToArray();
    }

    private string TargetLabel(SystemInfoCustomLinkTarget target) => L[$"CustomLinks:Targets:{target}"].Value;

    private static string TargetValue(SystemInfoCustomLinkTarget target) => target switch
    {
        SystemInfoCustomLinkTarget.CurrentTab => "_self",
        SystemInfoCustomLinkTarget.NewTab => "_blank",
        SystemInfoCustomLinkTarget.ParentFrame => "_parent",
        SystemInfoCustomLinkTarget.TopFrame => "_top",
        _ => throw new ArgumentOutOfRangeException(nameof(target), target, null)
    };

    private static string? LinkRelationship(SystemInfoCustomLinkTarget target) =>
        target == SystemInfoCustomLinkTarget.NewTab ? "noopener noreferrer" : null;

    private async Task CopyValueAsync(string value, string successMessage, string failureMessage)
    {
        try
        {
            if (await JSRuntime.InvokeAsync<bool>("MoClipboard.copyText", value))
            {
                Snackbar.Add(successMessage, Severity.Success);
                return;
            }
        }
        catch (JSDisconnectedException)
        {
            return;
        }
        catch (JSException)
        {
            // The localized failure below is sufficient at this explicit browser boundary.
        }

        Snackbar.Add(failureMessage, Severity.Error);
    }
}
