@using Monica.UI.Shared.Components.States
@inject IStringLocalizer<RepositoryUIResource> L

<div class="migration-assembly-list">
    <div class="migration-assembly-list__header">
        <div>
            <MudText Typo="Typo.subtitle2">@Title</MudText>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">@Subtitle</MudText>
            }
        </div>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
            @L["Migrations:Lists:Count", Items.Count]
        </MudChip>
    </div>

    @if (Items.Count == 0)
    {
        <MoContentState Compact="true"><MudText Typo="Typo.body2" Color="Color.Secondary">@EmptyText</MudText></MoContentState>
    }
    else
    {
        <ul class="migration-state-list">
            @foreach (var item in Items)
            {
                <li>
                    <span class="migration-state-list__id">@item.MigrationId</span>
                    <MudChip T="string"
                             Size="Size.Small"
                             Color="@GetStateColor(item.State)"
                             Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                        @GetStateText(item.State)
                    </MudChip>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public IReadOnlyList<RepositoryMigrationAssemblyItem> Items { get; set; } = [];

    [Parameter] public string EmptyText { get; set; } = string.Empty;

    private Color GetStateColor(RepositoryMigrationApplicationState state)
    {
        return state switch
        {
            RepositoryMigrationApplicationState.Applied => Color.Success,
            RepositoryMigrationApplicationState.Pending => Color.Warning,
            _ => Color.Info
        };
    }

    private string GetStateText(RepositoryMigrationApplicationState state)
    {
        return state switch
        {
            RepositoryMigrationApplicationState.Applied => L["Migrations:States:Applied"],
            RepositoryMigrationApplicationState.Pending => L["Migrations:States:Pending"],
            _ => L["Migrations:States:Unknown"]
        };
    }
}
