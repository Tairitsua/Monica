@inject ConfigurationValueVisibility Visibility
@using Monica.UI.Shared.Components.Json
@using Monica.Configuration.UI.Localization
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudPaper Outlined="true" Class="pa-3">
                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">@Definition.DisplayName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Mutation:DefinitionKey"]: @Definition.DefinitionKey</MudText>
                    </MudStack>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@VersionText</MudChip>
                </MudStack>
                <div class="configuration-current-value-path">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Mutation:LogicalPath"]</MudText>
                    <code>@Node.RelativePath.ToCanonicalString()</code>
                </div>
            </MudPaper>

            @if (ScopedPendingChanges.Count == 0)
            {
                <div class="configuration-current-value-json">
                    <MoJson Value="@PendingDisplayJson" />
                </div>
            }
            else
            {
                <div class="configuration-current-value-diff">
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="2">
                            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Dialogs:CurrentValue:PendingDiffDirection"]</MudText>
                                <MudChip T="int" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@ScopedPendingChanges.Count</MudChip>
                            </MudStack>
                            <DiffViewer OriginText="@OriginalDisplayJson"
                                        NewText="@PendingDisplayJson"
                                        Options="@DiffOptions"
                                        ViewMode="EDiffViewMode.Split" />
                        </MudStack>
                    </MudPaper>
                </div>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (AllowJsonEdit)
        {
            <MudButton Variant="Variant.Outlined"
                       StartIcon="@MoIcons.Braces"
                       OnClick="EditJson">
                @L["Common:Actions:EditJson"]
            </MudButton>
        }
        <MudButton OnClick="Close">@L["Common:Actions:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public ConfigurationDefinition Definition { get; set; } = null!;
    [Parameter, EditorRequired] public ConfigurationNodeDefinition Node { get; set; } = null!;
    [Parameter] public ConfigurationEffectiveValue? EffectiveValue { get; set; }
    [Parameter] public IReadOnlyList<PendingChange> PendingChanges { get; set; } = [];
    [Parameter] public bool AllowJsonEdit { get; set; }

    private readonly DiffHighlightOptions DiffOptions = new()
    {
        Mode = EDiffHighlightMode.Line,
        ContextLines = 4,
        MaxCharacterDiffLength = 8000
    };

    private string VersionText => EffectiveValue?.Version is { } version
        ? $"v{version}"
        : L["Common:States:Empty"].Value;

    private IReadOnlyList<PendingChange> ScopedPendingChanges => PendingChanges
        .Where(change => ConfigurationPendingValueDocumentBuilder.IsInScope(change, Definition.DefinitionKey, Node.RelativePath))
        .OrderBy(change => change.LogicalPath.ToCanonicalString(), StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private string OriginalDisplayJson => BuildDisplayJson([]);

    private string PendingDisplayJson => BuildDisplayJson(ScopedPendingChanges);

    private string BuildDisplayJson(IReadOnlyList<PendingChange> pendingChanges)
    {
        var node = ConfigurationPendingValueDocumentBuilder.Build(
            Node,
            Definition.DefinitionKey,
            EffectiveValue?.DisplayValue,
            pendingChanges);
        return ConfigurationJsonDisplayFormatter.Format(node, Node, L["State:Value:Sensitive"], Visibility.ShowSensitiveValues);
    }

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(ConfigurationCurrentValuePreviewResult.Closed));
    }

    private void EditJson()
    {
        MudDialog.Close(DialogResult.Ok(ConfigurationCurrentValuePreviewResult.EditJson));
    }
}
