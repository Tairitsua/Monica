@using System.Globalization
@inject NavigationManager Navigation
@inject SchedulerTimePresentation TimePresentation
@inject IStringLocalizer<JobSchedulerResource> L
<div class="analytics-dashboard">
    <section class="an-signature" data-calm="@((FailedCount == 0).ToString().ToLowerInvariant())">
        <div class="an-band">@FilterContent</div>
        <div class="an-decision"><div><p class="display-label">@L["Workspace:FailedCompletions"]</p><div class="display">@FailedCount.ToString("N0")</div></div>
            <div class="an-finding"><p class="lede">@L["Workspace:AnalyticsSummary", Snapshot.CompletedTerminalCount, FailedCount] @if (Snapshot.TopJobsByFailures.FirstOrDefault() is { } top) { <a class="vmark" href="@JobUrl(top)">@top.JobName</a> <span>@L["Workspace:FailureShare", FormatShare(top.FailedCount,FailedCount)]</span> }</p><a class="an-open" href="@LedgerUrl(FailedCount > 0 ? JobExecutionState.Failed : null)">@L[FailedCount > 0 ? "Workspace:OpenFailures" : "Workspace:OpenRecords"] <MoIcon Icon="@MoIcons.ArrowRight" Size="1rem" /></a></div>
        </div>
        <p class="an-window" data-start="@Snapshot.StartTimeUtc.ToString("O")" data-end="@Snapshot.EndTimeUtc.ToString("O")">@TimePresentation.FormatRange(Snapshot.StartTimeUtc,Snapshot.EndTimeUtc) · @L["Analytics:Window:Bounds"]</p>
        <SchedulerCompletionTrend Snapshot="@Snapshot" Owner="@Owner" Job="@Job" />
        <dl class="an-facts">
            <div data-tone="success"><dt><i></i>@L["Analytics:Metrics:Reliability"]</dt><dd>@FormatRatio(Snapshot.Reliability,DecidedCount)</dd><small>@L["Analytics:Metrics:DecidedRuns",DecidedCount]</small></div>
            <div data-tone="warning"><dt><i></i>@L["Analytics:Metrics:ScheduleFulfillment"]</dt><dd>@FormatRatio(Snapshot.RecurringScheduleFulfillment,Snapshot.RecurringScheduleDispositionCount)</dd><small>@L["Analytics:Metrics:ScheduledDispositions",Snapshot.RecurringScheduleDispositionCount]</small></div>
            <div data-tone="info"><dt><i></i>@L["Analytics:Metrics:Throughput"]</dt><dd>@Snapshot.ExecutedThroughputPerHour.ToString("N1")<small>@L["Workspace:PerHour"]</small></dd><small>@L["Analytics:Metrics:ExecutionSample",Snapshot.ExecutedTerminalCount,WindowHours]</small></div>
        </dl>
    </section>
    <SchedulerExecutionStateShare Snapshot="@Snapshot" />
    <div class="an-evidence">
        <section class="an-ranking" data-tone="@(_volume ? "primary" : "error")">
            <header><div><h2>@L["Workspace:RankingTitle"]</h2><p>@L["Workspace:RankingDescription"]</p></div><div class="an-seg" role="group" aria-label="@L["Workspace:RankingTitle"]"><button type="button" aria-pressed="@((!_volume).ToString().ToLowerInvariant())" @onclick="@(() => SetRank(false))">@L["Workspace:RankFailures"]</button><button type="button" aria-pressed="@((_volume).ToString().ToLowerInvariant())" @onclick="@(() => SetRank(true))">@L["Workspace:RankVolume"]</button></div></header>
            <ol class="an-ranked">@foreach(var pair in Ranking.Take(_expanded ? int.MaxValue : 6).Select((item,index) => (item,index)))
            {
                var value = _volume ? pair.item.CompletedTerminalCount : pair.item.FailedCount; var total = _volume ? Snapshot.CompletedTerminalCount : FailedCount;
                <li><span class="an-rank-number">@((pair.index+1).ToString("00"))</span><div class="an-rank-copy"><a href="@JobUrl(pair.item)">@pair.item.JobName <MoIcon Icon="@MoIcons.ArrowUpRight" Size=".75rem" /></a><small>@pair.item.OwnerKey</small><progress max="@Math.Max(1,total)" value="@value" aria-label="@L["Workspace:FailureShare",FormatShare(value,total)]"></progress></div><a class="an-rank-value" href="@LedgerUrl(_volume ? null : JobExecutionState.Failed,pair.item.OwnerKey,pair.item.JobKey)"><b>@value.ToString("N0")</b><small>@FormatShare(value,total)</small><MoIcon Icon="@MoIcons.ChevronRight" Size=".875rem" /></a></li>
            }</ol>
            @if (Ranking.Count == 0) { <p class="an-empty">@L[_volume ? "Analytics:Rankings:VolumeEmpty" : "Analytics:Rankings:FailuresEmpty"]</p> }
            <footer><span>@L["Workspace:RankingCount",Math.Min(_expanded ? int.MaxValue : 6,Ranking.Count),Ranking.Count]</span>@if(Ranking.Count > 6) { <button type="button" @onclick="@(() => _expanded = !_expanded)">@L[_expanded ? "Workspace:CollapseJobs" : "Workspace:ShowAllJobs",Ranking.Count]</button> }</footer>
        </section>
        <SchedulerAnalyticsDurationEvidence Snapshot="@Snapshot" InspectExecution="@InspectExecution" />
    </div>
</div>
@code {
    /// <summary>Gets the accepted analytics capture.</summary>
    [Parameter,EditorRequired] public JobExecutionAnalyticsSnapshot Snapshot { get; set; } = null!;
    /// <summary>Gets the route's controls, retained by its asynchronous page owner.</summary>
    [Parameter] public RenderFragment? FilterContent { get; set; }
    /// <summary>Gets the exact owner and job drilldown scope.</summary>
    [Parameter] public string? Owner { get; set; }
    /// <summary>Gets the exact job drilldown scope.</summary>
    [Parameter] public string? Job { get; set; }
    /// <summary>Opens the exact displayed execution with the parent's authorization and dialog lifetime.</summary>
    [Parameter,EditorRequired] public EventCallback<JobExecutionAnalyticsSlowExecution> InspectExecution { get; set; }
    private bool _volume,_expanded;
    private long FailedCount => Snapshot.Trend.Sum(b => b.FailedCount);
    private long DecidedCount => Snapshot.Trend.Sum(b => b.SucceededCount+b.FailedCount);
    private string WindowHours => (Snapshot.EndTimeUtc-Snapshot.StartTimeUtc).TotalHours.ToString("G6",CultureInfo.CurrentCulture);
    private IReadOnlyList<JobExecutionAnalyticsJobRank> Ranking => _volume ? Snapshot.TopJobsByVolume : Snapshot.TopJobsByFailures;
    protected override void OnParametersSet() => _volume = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query).TryGetValue("rank",out var rank) && rank == "volume";
    private void SetRank(bool volume) { _volume=volume; _expanded=false; Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("rank",volume ? "volume" : null),replace:true); }
    private string JobUrl(JobExecutionAnalyticsJobRank job) => JobSchedulerUiUrls.JobDefinition(new JobId(job.OwnerKey,job.JobKey),Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery);
    private string LedgerUrl(JobExecutionState? state,string? owner=null,string? job=null) => SchedulerRouteBuilder.Ledger(new JobExecutionQuery { SchedulerScopeKey=string.Empty, OwnerKey=owner??Owner,JobKey=job??Job,States=state is {} value ? new[]{value}:null,CompletedAfterUtc=Snapshot.StartTimeUtc,CompletedBeforeUtc=Snapshot.EndTimeUtc.AddTicks(-1) },Snapshot.StartTimeUtc,Snapshot.EndTimeUtc);
    private static string FormatRatio(double value,long total) => total > 0 ? value.ToString("P1",CultureInfo.CurrentCulture) : "—";
    private static string FormatShare(long value,long total) => total > 0 ? (value/(double)total).ToString("P1",CultureInfo.CurrentCulture) : "—";
}
