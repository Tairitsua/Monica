@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@attribute [Route(PAGE_URL)]
@implements IAsyncDisposable
@inject HealthCheckPageSessionFactory SessionFactory
@inject PageAccessEvaluator PageAccess
@inject IStringLocalizer<HealthCheckResource> L

<PageTitle>@L["Page:Title"]</PageTitle>

<div class="health-page mo-page-shell mo-page-shell--full-width">
    @if (!_accessChecked)
    {
        <div class="health-page-state" role="status">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body1">@L["Access:Checking"]</MudText>
        </div>
    }
    else if (!_isAuthorized || _session?.IsAccessDenied == true)
    {
        <div class="health-page-state" role="alert">
            <MoIcon Icon="@MoIcons.Lock" Size="2.25rem" Style="color:var(--mud-palette-warning);" />
            <MudText Typo="Typo.h5">@L["Access:DeniedTitle"]</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">@L["Access:DeniedDescription"]</MudText>
        </div>
    }
    else if (_session is { } session)
    {
        <div class="health-workspace">
            <header class="health-page-header">
                <div class="health-page-heading">
                    <span class="health-page-eyebrow">@L["Page:Eyebrow"]</span>
                    <h1>@L["Page:Heading"]</h1>
                    <p>@L["Page:Subtitle"]</p>
                    <span class="health-host"><MoIcon Icon="@MoIcons.Server" Size="1.25rem" />@L["Page:CurrentHost", session.HostName]</span>
                </div>
                <div class="health-page-actions">
                    @if (session.Snapshot is { } snapshot)
                    {
                        <div class="health-last-check">
                            <span>@L["Page:LastChecked"]</span>
                            <time datetime="@snapshot.CheckedAt.ToString("O")" title="@UiTime.Format(snapshot.CheckedAt)">@UiTime.FormatTime(snapshot.CheckedAt)</time>
                        </div>
                    }
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@MoIcons.Refresh"
                               Class="health-refresh"
                               Disabled="@session.IsRefreshing"
                               OnClick="@(() => RefreshAsync(session))">
                        @L["Actions:Refresh"]
                    </MudButton>
                </div>
            </header>

            @if (session.RefreshError is { } refreshError)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Warning">
                    @L["State:RefreshFailed", refreshError]
                </MudAlert>
            }

            @switch (session.LoadState)
            {
                case HealthCheckPageLoadState.InitialLoading:
                    <div class="health-page-state" role="status">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">@L["State:Loading"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["State:LoadingDescription"]</MudText>
                    </div>
                    break;
                case HealthCheckPageLoadState.Failed:
                    <div class="health-page-state" role="alert">
                        <MoIcon Icon="@MoIcons.CloudOff" Size="2.25rem" Style="color:var(--mud-palette-error);" />
                        <MudText Typo="Typo.h6">@L["State:LoadFailed"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@session.LoadError</MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@MoIcons.Refresh"
                                   OnClick="@(() => RefreshAsync(session))">
                            @L["Actions:Retry"]
                        </MudButton>
                    </div>
                    break;
                case HealthCheckPageLoadState.Ready when session.Snapshot is not null:
                    <div class="health-page-content">
                        <HealthCheckOverview Session="@session" />
                        <HealthCheckEntryTable Session="@session" />
                    </div>
                    break;
            }

            <HealthCheckEntryDrawer Session="@session" />
        </div>
    }
</div>

@code {
    public const string PAGE_URL = "/health-checks";

    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private HealthCheckPageSession? _session;
    private bool _accessChecked;
    private bool _isAuthorized;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        bool isAuthorized;
        try
        {
            isAuthorized = await PageAccess.IsAuthorizedAsync(PAGE_URL, _lifetimeCancellation.Token);
        }
        catch (OperationCanceledException) when (_lifetimeCancellation.IsCancellationRequested)
        {
            return;
        }

        if (_disposed)
        {
            return;
        }

        _isAuthorized = isAuthorized;
        _accessChecked = true;
        if (!isAuthorized)
        {
            return;
        }

        var session = SessionFactory.Create(
            cancellationToken => PageAccess.IsAuthorizedAsync(PAGE_URL, cancellationToken));
        _session = session;
        session.Changed += HandleSessionChangedAsync;
        await session.InitializeAsync();
    }

    private Task HandleSessionChangedAsync()
    {
        return InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    private static Task RefreshAsync(HealthCheckPageSession session) => session.RefreshAsync();

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        await _lifetimeCancellation.CancelAsync();
        var session = _session;
        _session = null;
        if (session is null)
        {
            _lifetimeCancellation.Dispose();
            return;
        }

        session.Changed -= HandleSessionChangedAsync;
        await session.DisposeAsync();
        _lifetimeCancellation.Dispose();
    }
}
