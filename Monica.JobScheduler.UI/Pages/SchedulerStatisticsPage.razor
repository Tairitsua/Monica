@attribute [Route(PAGE_URL)]

@using System.Globalization
@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Executions.State
@using Monica.JobScheduler.UI.UIJobScheduler.Executions.Support

@inject SchedulerStatisticsPageStateFactory PageStateFactory
@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation
@inject IDialogService DialogService

@implements IAsyncDisposable

<PageTitle>@L["Analytics:PageTitle"]</PageTitle>

<SchedulerWorkspace Title="@L["Workspace:Pages:Statistics:Title"]"
                    Description="@L["Workspace:Pages:Statistics:Description"]"
                    ActivePanelIndex="3">
    @if (_state is { } state)
    {
        <div class="statistics-page">
            @if (state.Error is not null)
            {
                <MudAlert Severity="@(state.HasLoadedSnapshot ? Severity.Warning : Severity.Error)" Variant="Variant.Outlined" Dense="true" Icon="@(state.HasLoadedSnapshot ? MoIcons.Warning : MoIcons.Error)">
                    @(state.HasLoadedSnapshot ? L["Analytics:RefreshFailed", state.Error] : state.Error)
                </MudAlert>
            }
            @if (!state.AccessChecked && state.IsQueryFailed && !state.IsLoading)
            {
                <div class="statistics-page__unavailable" role="status">
                    <MoIcon Icon="@MoIcons.ChartTrend" aria-hidden="true" Size="1.5rem" />
                    <h2>@L["Analytics:Window:Unavailable"]</h2>
                    <p>@L["Analytics:Window:UnavailableDescription"]</p>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RefreshAsync">@L["Common:Retry"]</MudButton>
                </div>
            }
            else
            {
                <SchedulerAccessBoundary AccessChecked="@state.AccessChecked" IsAuthorized="@state.IsAuthorized">
                    <section class="statistics-window" aria-labelledby="statistics-window-heading" aria-busy="@(state.IsLoading ? "true" : "false")">
                        <div class="statistics-window__summary">
                            <div class="statistics-window__completion">
                                <span class="statistics-window__eyebrow" id="statistics-window-heading">@L["Analytics:Window:Completed"]</span>
                                <strong>@(state.Snapshot is { } result ? result.CompletedTerminalCount.ToString("N0", CultureInfo.CurrentCulture) : "—")</strong>
                                <span>@L["Analytics:Window:CompletedDescription"]</span>
                            </div>
                            <div class="statistics-window__evidence">
                                @if ((state.LoadedQuery ?? state.RequestedQuery) is { } query)
                                {
                                    <span class="statistics-window__eyebrow">@(state.HasLoadedSnapshot ? L["Analytics:Window:Accepted"] : L["Analytics:Window:Requested"])</span>
                                    <div class="statistics-window__interval" data-start="@query.StartTimeUtc.ToString("O")" data-end="@query.EndTimeUtc.ToString("O")">
                                        @TimePresentation.FormatRange(query.StartTimeUtc, query.EndTimeUtc)
                                    </div>
                                    <span>@L["Analytics:Window:Bounds"]</span>
                                }
                                @if (state.Snapshot is { } snapshot)
                                {
                                    <dl class="statistics-window__facts">
                                        <div><dt>@L["Analytics:Window:Resolved"]</dt><dd>@snapshot.Trend.Sum(bucket => bucket.SucceededCount + bucket.FailedCount).ToString("N0", CultureInfo.CurrentCulture)</dd></div>
                                        <div><dt>@L["Analytics:Window:Measured"]</dt><dd>@snapshot.Duration.Count.ToString("N0", CultureInfo.CurrentCulture)</dd></div>
                                        <div><dt>@L["Analytics:Window:Observed"]</dt><dd>@TimePresentation.FormatTimestamp(state.ObservedAtUtc)</dd></div>
                                    </dl>
                                }
                            </div>
                        </div>
                        <div class="statistics-window__controls">
                            <div class="statistics-window__presets" role="group" aria-label="@L["Analytics:Range:Title"]">
                                @foreach (var range in Enum.GetValues<SchedulerAnalyticsTimeRange>())
                                {
                                    <button type="button" class="@(state.TimeRange == range ? "is-selected" : null)"
                                            aria-pressed="@(state.TimeRange == range ? "true" : "false")"
                                            @onclick="@(() => SelectRangeAsync(range))">@L[$"Analytics:Range:{range}"]</button>
                                }
                                <MudTooltip Text="@L["Analytics:Range:Description", TimePresentation.TimeZoneId]">
                                    <MudIconButton Icon="@MoIcons.Info" Size="Size.Small" Color="Color.Inherit" aria-label="@L["Analytics:Range:Title"]" aria-description="@L["Analytics:Range:Description", TimePresentation.TimeZoneId]" />
                                </MudTooltip>
                            </div>
                            <button type="button" class="statistics-window__refresh" disabled="@state.IsLoading" @onclick="RefreshAsync">
                                <MoIcon Icon="@MoIcons.Refresh" Size="1.25rem" aria-hidden="true" />
                                <span>@L["Common:Refresh"]</span>
                            </button>
                        </div>
                    </section>
                    @if (state.IsLoading && !state.HasLoadedSnapshot)
                    {
                        <div class="statistics-page__loading" role="status">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                            <span>@L["Common:Loading"]</span>
                        </div>
                    }
                    else if (!state.HasLoadedSnapshot && state.IsQueryFailed)
                    {
                        <div class="statistics-page__unavailable" role="status">
                            <MoIcon Icon="@MoIcons.ChartTrend" aria-hidden="true" Size="1.5rem" />
                            <h2>@L["Analytics:Window:Unavailable"]</h2>
                            <p>@L["Analytics:Window:UnavailableDescription"]</p>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="RefreshAsync">@L["Common:Retry"]</MudButton>
                        </div>
                    }
                    else if (state.Snapshot is { } acceptedSnapshot)
                    {
                        @if (state.IsLoading)
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" aria-label="@L["Common:Loading"]" />
                        }
                        @if (state.IsQueryFailed && state.LoadedTimeRange is { } loadedRange)
                        {
                            <p class="statistics-page__retained">@L["Analytics:Window:Retained", L[$"Analytics:Range:{loadedRange}"]]</p>
                        }
                        <SchedulerAnalyticsDashboard Snapshot="@acceptedSnapshot" InspectExecution="InspectAsync" />
                    }
                </SchedulerAccessBoundary>
            }
        </div>
    }
</SchedulerWorkspace>

@code {
    /// <summary>Gets the route for cross-job scheduler analytics.</summary>
    public const string PAGE_URL = "/job-scheduler/statistics";

    private readonly SchedulerOperationLifetime _lifetime = new();
    private readonly object _retirementGate = new();
    private TaskCompletionSource? _retirement;
    private SchedulerStatisticsPageState? _state;
    private ExecutionDialogSession? _inspectors;

    protected override async Task OnInitializedAsync()
    {
        _inspectors = new(id => ExecutionDetailDialogLauncher.OpenAsync(DialogService, L, id), RefreshAsync);
        var state = PageStateFactory.Create();
        _state = state;
        state.Changed += OnStateChangedAsync;
        try { await _lifetime.RunAsync(_ => state.InitializeAsync()); }
        catch (OperationCanceledException) when (_lifetime.IsRetired) { }
    }

    private Task OnStateChangedAsync() => _lifetime.IsRetired ? Task.CompletedTask : InvokeAsync(() =>
    {
        if (!_lifetime.IsRetired) StateHasChanged();
    });

    private Task SelectRangeAsync(SchedulerAnalyticsTimeRange range) =>
        RunStateAsync(state => state.SetTimeRangeAsync(range));

    private Task RefreshAsync() => RunStateAsync(state => state.RefreshAsync());

    private async Task RunStateAsync(Func<SchedulerStatisticsPageState, Task> operation)
    {
        if (_state is not { } state || _lifetime.IsRetired) return;
        try { await _lifetime.RunAsync(_ => operation(state)); }
        catch (OperationCanceledException) when (_lifetime.IsRetired || state.IsDisposed) { }
    }

    private async Task InspectAsync(JobExecutionAnalyticsSlowExecution execution)
    {
        // The displayed immutable record supplies the exact identity before authorization can yield.
        var exactId = execution.InstanceId;
        if (_state is not { } state || _inspectors is not { } inspectors || _lifetime.IsRetired) return;
        try
        {
            await _lifetime.RunAsync(async _ =>
            {
                if (!await state.ReauthorizeAsync() || _lifetime.IsRetired || _state != state) return;
                await inspectors.OpenAsync(exactId);
            });
        }
        catch (OperationCanceledException) when (_lifetime.IsRetired || state.IsDisposed) { }
    }

    /// <inheritdoc />
    public ValueTask DisposeAsync()
    {
        TaskCompletionSource completion;
        lock (_retirementGate)
        {
            if (_retirement is not null) return new(_retirement.Task);
            completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
            _retirement = completion;
        }
        var state = _state;
        if (state is not null) state.Changed -= OnStateChangedAsync;
        // Retire every owner before joining so an outstanding native callback can finish against canceled reads.
        var operations = _lifetime.RetireAsync(() => ValueTask.CompletedTask);
        var inspectors = _inspectors?.DisposeAsync() ?? ValueTask.CompletedTask;
        var stateRetirement = state?.DisposeAsync() ?? ValueTask.CompletedTask;
        _ = CompleteRetirementAsync([operations, inspectors, stateRetirement], completion);
        return new(completion.Task);
    }

    private static async Task CompleteRetirementAsync(ValueTask[] owners, TaskCompletionSource completion)
    {
        var failures = new List<Exception>();
        foreach (var owner in owners)
        {
            try { await owner; } catch (Exception exception) { failures.Add(exception); }
        }
        if (failures.Count == 0) completion.TrySetResult();
        else completion.TrySetException(new AggregateException("Scheduler analytics retirement failed.", failures));
    }
}
