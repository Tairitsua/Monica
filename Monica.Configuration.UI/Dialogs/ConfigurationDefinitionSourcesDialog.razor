@implements IAsyncDisposable
@inject ConfigurationFacade Facade
@inject IDialogService DialogService
@using Monica.Configuration.UI.Localization
@using Monica.UI.Shared.Components.Dialogs
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent>
        <MoDialogHeading Text="@L["Sources:Definition:Title"]" />
    </TitleContent>
    <DialogContent>
        <div class="configuration-sources" aria-busy="@((_loading || _fileDialogOpen) ? "true" : "false")">
            <header class="configuration-sources-identity">
                <h3>@_definitionDisplayName</h3>
                <dl>
                    <div>
                        <dt>@L["Mutation:DefinitionKey"]</dt>
                        <dd><code dir="auto">@_definitionKey</code></dd>
                    </div>
                </dl>
            </header>

            <div class="configuration-sources-explanation">
                @if (_definitionKind == ConfigurationKind.Startup)
                {
                    <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Dense="true">@L["Startup:SourceContributions"]</MudAlert>
                }
                <p>@L["Sources:Definition:PriorityHelp"]</p>
                <p>@L["Sources:Definition:CountsHelp"]</p>
            </div>

            @if (_fileError is not null)
            {
                <div class="configuration-sources-state" aria-live="polite">
                    <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_fileError</MudAlert>
                </div>
            }

            @if (_loading)
            {
                <div class="configuration-sources-state" role="status">
                    <MudProgressLinear Indeterminate="true" Color="Color.Info" />
                    <p>@L["Common:States:Loading"]</p>
                </div>
            }
            else if (_error is not null)
            {
                <div class="configuration-sources-state">
                    <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_error</MudAlert>
                </div>
            }
            else if (_contributions.Count == 0)
            {
                <div class="configuration-sources-state configuration-sources-empty">
                    <MoIcon Icon="@MoIcons.Workflow" aria-hidden="true" Size="1.5rem" />
                    <p>@L["Sources:Definition:Empty"]</p>
                </div>
            }
            else
            {
                <div class="configuration-sources-evidence">
                    <MudTable T="ConfigurationDefinitionSourceContribution"
                              Items="@_contributions"
                              TableAttributes="@(new Dictionary<string, object?> { ["aria-label"] = L["Sources:Definition:Subtitle", _definitionDisplayName].Value })"
                              Breakpoint="Breakpoint.Xs"
                              Dense="false"
                              Hover="true"
                              Square="true"
                              Elevation="0">
                        <ColGroup>
                            <col class="configuration-sources-source-column" />
                            <col class="configuration-sources-number-column" />
                            <col class="configuration-sources-number-column" />
                            <col class="configuration-sources-number-column" />
                        </ColGroup>
                        <HeaderContent>
                            <MudTh>@L["Sources:Columns:Source"]</MudTh>
                            <MudTh Class="configuration-sources-number-cell">@L["Sources:Columns:Priority"]</MudTh>
                            <MudTh Class="configuration-sources-number-cell">@L["Sources:Columns:Supplied"]</MudTh>
                            <MudTh Class="configuration-sources-number-cell">@L["Sources:Columns:Effective"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Class="configuration-sources-source-cell" DataLabel="@L["Sources:Columns:Source"]">
                                <div class="configuration-sources-source">
                                    <div class="configuration-sources-source-heading">
                                        <p class="configuration-sources-source-name" dir="auto">@context.Source.DisplayName</p>
                                        <div class="configuration-sources-source-actions">
                                            <span class="configuration-sources-access" data-tone="@(context.Source.IsWritable ? "info" : "neutral")">
                                                @(context.Source.IsWritable ? L["Sources:Writable"] : L["Sources:ReadOnly"])
                                            </span>
                                            @if (context.Source.Kind == ConfigurationSourceKind.JsonFile)
                                            {
                                                <MudButton @key="context.Source.SourceKey" Class="configuration-sources-file-action"
                                                           Color="Color.Primary"
                                                           Variant="Variant.Text"
                                                           Size="Size.Small"
                                                           StartIcon="@MoIcons.FileText"
                                                           aria-label="@L["Sources:Actions:ViewFileFor", context.Source.DisplayName]"
                                                           Disabled="@FileButtonDisabled(context.Source)"
                                                           aria-disabled="@(_fileDialogOpen ? "true" : "false")"
                                                           OnClick="() => ViewFileAsync(context.Source)">
                                                    @L["Sources:Actions:ViewFile"]
                                                </MudButton>
                                            }
                                        </div>
                                    </div>
                                    <code class="configuration-sources-location" dir="auto">@SourcePath(context.Source)</code>
                                </div>
                            </MudTd>
                            <MudTd Class="configuration-sources-number-cell configuration-sources-priority-cell" DataLabel="@L["Sources:Columns:Priority"]">
                                <span class="configuration-sources-number">@context.Source.PriorityIndex</span>
                            </MudTd>
                            <MudTd Class="configuration-sources-number-cell" DataLabel="@L["Sources:Columns:Supplied"]">
                                <span class="configuration-sources-number">@context.SuppliedValueCount</span>
                            </MudTd>
                            <MudTd Class="configuration-sources-number-cell configuration-sources-effective-cell" DataLabel="@L["Sources:Columns:Effective"]">
                                <span class="configuration-sources-number">@context.EffectiveValueCount</span>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="configuration-sources-actions">
            <MudButton OnClick="CloseAsync">@L["Common:Actions:Close"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>
