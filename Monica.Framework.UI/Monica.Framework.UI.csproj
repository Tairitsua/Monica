  <ItemGroup>
    <ProjectReference Include="..\Monica.Core\Monica.Core.csproj" />
    <ProjectReference Include="..\Monica.DependencyInjection\Monica.DependencyInjection.csproj" />
    <ProjectReference Include="..\Monica.Framework\Monica.Framework.csproj" />
    <ProjectReference Include="..\Monica.JobScheduler.UI\Monica.JobScheduler.UI.csproj" />
    <ProjectReference Include="..\Monica.StateStore.UI\Monica.StateStore.UI.csproj" />
    <ProjectReference Include="..\Monica.UI\Monica.UI.csproj" />
    <ProjectReference Include="..\Monica.Logging\Monica.Logging.csproj" />
    <ProjectReference Include="..\Monica.BuildingBlocks\Monica.BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>
</Project>
