@using System.Text.RegularExpressions
@foreach (var part in Regex.Split(Template, @"(\{\d+\})"))
{
    if (part.Length > 2 && part[0] == '{' && int.TryParse(part.AsSpan(1, part.Length - 2), out var index) && index < Values.Count)
    {
        @Values[index]
    }
    else
    {
        @part
    }
}
@code {
    /// <summary>Gets a localized sentence containing numbered slots for safe, typed inline emphasis.</summary>
    [Parameter, EditorRequired] public string Template { get; set; } = string.Empty;
    /// <summary>Gets render fragments substituted for numbered slots; surrounding text remains HTML encoded.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<RenderFragment> Values { get; set; } = [];
}
