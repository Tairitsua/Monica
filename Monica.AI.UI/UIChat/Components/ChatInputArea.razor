@using Monica.AI.KnowledgeBase.Models
@using Microsoft.Extensions.Localization
@using Monica.AI.AgentCapabilities.Models
@using Monica.AI.UI.Localization
@using Monica.AI.UI.UIChat.Models
@using Monica.AI.UI.UIChat.Support
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<AIResource> L

<div class="input-area" data-short="@(Layout is { IsObserved: true, Height: <= 600 } ? "true" : "false")">
    <MudPaper Elevation="0" Class="input-container mo-self-painted">
        <ChatAttachments Attachments="@Attachments" SessionId="@SessionId" Removable="true" Disabled="@(IsSending || IsUploading || Disabled)" OnRemove="@OnRemoveAttachment" />
        <div class="input-top" @ref="_inputTopRef">
            <div class="composer-editor"
                 contenteditable="@EditorContentEditable"
                 data-composer-editor
                 data-session-id="@(SessionId ?? string.Empty)"
                 data-session-generation="@_draftGeneration"
                 data-placeholder="@_placeholderText"
                 role="textbox"
                 aria-multiline="true"
                 aria-label="@_placeholderText"
                 @onkeydown="@HandleKeyDown">
            </div>
            <MudPopover Open="@ShowReferencePicker"
                        AnchorOrigin="Origin.TopLeft"
                        TransformOrigin="Origin.BottomLeft"
                        Class="mo-ai-capability-popover"
                        Paper="false">
                <MudPaper Elevation="6" Class="capability-picker">
                    @if (FilteredCapabilityCandidates.Count == 0)
                    {
                        <div class="capability-empty">
                            <MoIcon Icon="@MoIcons.SearchOff" Size="1.25rem" />
                            <MudText Typo="Typo.body2">@L["Chat:CapabilityPicker:NoMatches"]</MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var candidate in FilteredCapabilityCandidates.Select((candidate, index) => (candidate, index)))
                        {
                            <button type="button"
                                    class="@GetCandidateClass(candidate.index)"
                                    @onclick="@(() => CompleteCandidate(candidate.candidate))">
                                <span class="candidate-icon">
                                    <MoIcon Icon="@GetReferenceIcon(candidate.candidate.Kind)" Size="1.25rem" />
                                </span>
                                <span class="candidate-copy">
                                    <span class="candidate-title">@candidate.candidate.Name</span>
                                    <span class="candidate-description">@candidate.candidate.Description</span>
                                </span>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                    @candidate.candidate.Kind
                                </MudChip>
                            </button>
                        }
                    }
                </MudPaper>
            </MudPopover>
        </div>
        <div class="input-bottom">
            <div class="input-actions-left">
                <InputFile id="@_uploadId" class="file-input" OnChange="@OnUpload" multiple accept="image/png,image/jpeg,image/webp,image/gif,.pdf,.docx,.txt,.md,.csv,.json,.xml,.html" disabled="@(IsSending || IsUploading || Disabled)" />
                <MudIconButton HtmlTag="label" for="@_uploadId" Icon="@MoIcons.Paperclip" Class="attachment-button" Disabled="@(IsSending || IsUploading || Disabled)" aria-label="@L["Workbench:Attach"]" title="@L["Workbench:Attach"]" />
                @if (KnowledgeBases is { Count: > 0 })
                {
                    <KnowledgeBaseSelector KnowledgeBases="@KnowledgeBases" SelectedIds="@SelectedKnowledgeBaseIds" SelectedIdsChanged="@SelectedKnowledgeBaseIdsChanged" Disabled="@(IsSending || IsUploading || Disabled)" />
                }
            </div>
            <div class="input-context">
                <ChatContextIndicator Usage="@ContextUsage" AutomaticCompaction="@AutomaticCompaction" AutomaticCompactionChanged="@AutomaticCompactionChanged" Disabled="@(IsSending || IsUploading || Disabled)" OnCompact="@OnCompact" CompactionThreshold="@CompactionThreshold" RetainedTurns="@RetainedTurns" OutputBudget="@OutputBudget" CompactionPreferencesChanged="@CompactionPreferencesChanged" />
            </div>
            <div class="input-model">
                <ChatModelSelector Providers="@Providers" ProviderId="@ProviderId" ModelName="@ModelName" CurrentModel="@CurrentModel" ReasoningLevel="@ReasoningLevel" AllowProviderSelection="@ShowProviderInfo" Disabled="@(IsSending || IsUploading || Disabled)" OnModelChanged="@OnModelChanged" ReasoningLevelChanged="@ReasoningLevelChanged" />
            </div>
            <div class="input-send">
                @if (IsSending)
                {
                    <MudIconButton Class="composer-stop" Icon="@MoIcons.Stop" Color="Color.Error" OnClick="HandleCancel" aria-label="@L["Chat:Input:Stop"]" />
                }
                else
                {
                    <MudIconButton Class="composer-send" Icon="@MoIcons.ArrowUp" Color="Color.Primary" Disabled="@((string.IsNullOrWhiteSpace(InputText) && Attachments.Count == 0) || EditorDisabled || IsUploading || AttachmentIncompatible || ModelName is null)" OnClick="HandleSend" aria-label="@L["Chat:Input:Send"]" />
                }
            </div>
        </div>
        @if (IsUploading) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
        @if (ImageIncompatible) { <MudAlert Icon="@MoIcons.Warning" Dense="true" Severity="Severity.Warning">@L["Workbench:ImageUnsupported"]</MudAlert> }
        @if (DocumentIncompatible) { <MudAlert Icon="@MoIcons.Warning" Dense="true" Severity="Severity.Warning">@L["Workbench:DocumentUnsupported"]</MudAlert> }
    </MudPaper>
    <div class="composer-options"><span class="composer-hint">@L["Workbench:ComposerHint"]</span></div>
</div>

@code {
    [CascadingParameter] private ChatWorkbenchLayout? Layout { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool IsSending { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ModelName { get; set; }
    [Parameter] public bool ShowProviderInfo { get; set; } = true;
    [Parameter] public LLMModelInfo? CurrentModel { get; set; }
    [Parameter] public string? ReasoningLevel { get; set; }
    [Parameter] public EventCallback<string?> ReasoningLevelChanged { get; set; }
    [Parameter] public IReadOnlyList<AIProviderInfo> Providers { get; set; } = [];
    [Parameter] public string? ProviderId { get; set; }
    [Parameter] public ChatContextUsage? ContextUsage { get; set; }
    [Parameter] public bool AutomaticCompaction { get; set; }
    [Parameter] public EventCallback<bool> AutomaticCompactionChanged { get; set; }
    [Parameter] public EventCallback OnCompact { get; set; }
    [Parameter] public double CompactionThreshold { get; set; } = .8;
    [Parameter] public int RetainedTurns { get; set; } = 4;
    [Parameter] public int? OutputBudget { get; set; }
    [Parameter] public EventCallback<(double Threshold, int RetainedTurns, int? OutputBudget)> CompactionPreferencesChanged { get; set; }
    [Parameter] public bool IsUploading { get; set; }
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public IReadOnlyList<ChatAttachmentReference> Attachments { get; set; } = [];
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnUpload { get; set; }
    [Parameter] public EventCallback<ChatAttachmentReference> OnRemoveAttachment { get; set; }
    private readonly string _uploadId = $"attachment-{Guid.NewGuid():N}";
    private bool AttachmentIncompatible => ImageIncompatible || DocumentIncompatible;
    private bool DocumentIncompatible => Attachments.Any(item => item.Kind == ChatAttachmentKind.Document && !item.HasExtractedText) && CurrentModel?.SupportsDocuments != true;
    private bool ImageIncompatible => Attachments.Any(item => item.Kind == ChatAttachmentKind.Image) && CurrentModel?.SupportsImage != true;
    [Parameter] public IReadOnlyList<AgentCapabilityReferenceCandidate> CapabilityCandidates { get; set; } = [];
    [Parameter] public EventCallback<ChatSendRequest> OnSend { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<(string ProviderId, string ModelName)> OnModelChanged { get; set; }
    [Parameter] public IReadOnlyList<KnowledgeBase>? KnowledgeBases { get; set; }
    [Parameter] public List<string> SelectedKnowledgeBaseIds { get; set; } = [];
    [Parameter] public EventCallback<List<string>> SelectedKnowledgeBaseIdsChanged { get; set; }

    public string InputText { get; set; } = string.Empty;
    private ElementReference _inputTopRef;
    private ChatComposerInteropSession? _interopSession;
    private bool _disposed;
    private readonly Dictionary<string, (string Text, int Caret, long Generation)> _sessionDrafts = new(StringComparer.Ordinal);
    private readonly Dictionary<string, long> _clearedDraftGenerations = new(StringComparer.Ordinal);
    private string? _draftSessionId;
    private bool _draftInitialized;
    private bool _forceDraftSynchronization = true;
    private bool _draftSynchronizationPending = true;
    private bool _focusDraftSynchronization;
    private long _draftGeneration = 1;
    private long _draftSynchronizationVersion;
    private string _placeholderText = string.Empty;
    private bool _referencePickerOpen;
    private string _referenceQuery = string.Empty;
    private int _referenceStartIndex = -1;
    private int _referenceEndIndex = -1;
    private int _caretIndex;
    private int _highlightedCandidateIndex;
    private bool ShowReferencePicker => _referencePickerOpen && !EditorDisabled;
    private bool EditorDisabled => IsSending || Disabled || _draftSynchronizationPending;
    private string EditorContentEditable => EditorDisabled ? "false" : "true";
    private static readonly IReadOnlyDictionary<string, string> REFERENCE_ICONS = new Dictionary<string, string>
    {
        ["skills"] = MoIcons.Sparkle,
        ["mcp"] = MoIcons.Workflow
    };
    private IReadOnlyList<AgentCapabilityReferenceCandidate> FilteredCapabilityCandidates =>
        CapabilityCandidates
            .Where(IsCandidateAvailable)
            .Where(MatchesReferenceQuery)
            .Take(8)
            .ToList();

    protected override void OnInitialized()
    {
        _placeholderText = Placeholder ?? L["Chat:Input:Placeholder"];
    }

    protected override void OnParametersSet()
    {
        if (!_draftInitialized)
        {
            _draftInitialized = true;
            _draftSessionId = SessionId;
            return;
        }
        if (string.Equals(_draftSessionId, SessionId, StringComparison.Ordinal)) return;
        _sessionDrafts.TryAdd(_draftSessionId ?? string.Empty, (InputText, _caretIndex, _draftGeneration));
        _draftSessionId = SessionId;
        var draft = _sessionDrafts.GetValueOrDefault(SessionId ?? string.Empty);
        InputText = draft.Text ?? string.Empty;
        _caretIndex = Math.Clamp(draft.Caret, 0, InputText.Length);
        CloseReferencePicker();
        _draftGeneration++;
        _draftSynchronizationVersion++;
        _draftSynchronizationPending = true;
        _focusDraftSynchronization = false;
        _forceDraftSynchronization = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }

        if (firstRender)
        {
            _interopSession = new ChatComposerInteropSession(JSRuntime, this);
            await _interopSession.InitializeAsync(
                _inputTopRef,
                InputText,
                _placeholderText,
                REFERENCE_ICONS,
                SessionId,
                _draftGeneration);
        }

        if (!_disposed && _interopSession is not null)
        {
            await SynchronizeEditorAsync(focus: false);
        }
    }

    private async Task HandleSend()
    {
        if (_disposed || (string.IsNullOrWhiteSpace(InputText) && Attachments.Count == 0) || EditorDisabled || IsUploading || AttachmentIncompatible || ModelName is null) return;
        var request = new ChatSendRequest(InputText.Trim());
        var draftSession = SessionId;
        var draftGeneration = _draftGeneration;
        var send = OnSend.InvokeAsync(request);
        var cleared = request.Accepted;
        if (cleared) await ClearDraftAsync(draftSession, draftGeneration);
        await send;
        if (!cleared && request.Accepted) await ClearDraftAsync(draftSession, draftGeneration);
    }

    private async Task ClearDraftAsync(string? draftSession, long draftGeneration)
    {
        var key = draftSession ?? string.Empty;
        _clearedDraftGenerations[key] = Math.Max(_clearedDraftGenerations.GetValueOrDefault(key), draftGeneration);
        if (!_sessionDrafts.TryGetValue(key, out var saved) || saved.Generation <= draftGeneration)
        {
            _sessionDrafts.Remove(key);
        }
        if (_disposed || !string.Equals(draftSession, SessionId, StringComparison.Ordinal) || draftGeneration != _draftGeneration) return;
        InputText = string.Empty;
        _caretIndex = 0;
        CloseReferencePicker();
        _draftGeneration++;
        _draftSynchronizationPending = true;
        await SyncEditorAsync(focus: false);
        if (!_disposed) StateHasChanged();
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_disposed || EditorDisabled || e.IsComposing)
        {
            return;
        }

        if (ShowReferencePicker)
        {
            if (e.Key == "ArrowDown")
            {
                MoveHighlight(1);
                StateHasChanged();
                return;
            }

            if (e.Key == "ArrowUp")
            {
                MoveHighlight(-1);
                StateHasChanged();
                return;
            }

            if (e.Key == "Tab")
            {
                await CompleteHighlightedCandidate();
                return;
            }

            if (e is { Key: "Enter", ShiftKey: false })
            {
                await CompleteHighlightedCandidate();
                return;
            }

            if (e.Key == "Escape")
            {
                CloseReferencePicker();
                StateHasChanged();
                return;
            }
        }

        // Enter to send, Shift+Enter for new line
        if (e is { Key: "Enter", ShiftKey: false })
        {
            await HandleSend();
        }
    }

    [JSInvokable]
    public Task HandleComposerInput(string? value, int caretIndex, string? sessionId = null, long sessionGeneration = 0)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        var key = sessionId ?? string.Empty;
        if ((_clearedDraftGenerations.TryGetValue(key, out var clearedGeneration) && sessionGeneration <= clearedGeneration)
            || (_sessionDrafts.TryGetValue(key, out var saved) && sessionGeneration < saved.Generation))
        {
            return Task.CompletedTask;
        }

        var text = value ?? string.Empty;
        var caret = Math.Clamp(caretIndex, 0, text.Length);
        // A queued callback retains its originating draft without replacing a later selection's editor.
        _sessionDrafts[key] = (text, caret, sessionGeneration);
        if (!string.Equals(sessionId, SessionId, StringComparison.Ordinal) || sessionGeneration != _draftGeneration)
        {
            return Task.CompletedTask;
        }
        InputText = text;
        _caretIndex = caret;
        UpdateReferencePicker();
        return InvokeAsync(StateHasChanged);
    }

    private void UpdateReferencePicker()
    {
        var searchEnd = Math.Clamp(_caretIndex, 0, InputText.Length);
        if (searchEnd == 0)
        {
            CloseReferencePicker();
            return;
        }

        var triggerIndex = FindReferenceTriggerIndex(searchEnd);
        if (triggerIndex < 0)
        {
            CloseReferencePicker();
            return;
        }

        var query = InputText[(triggerIndex + 1)..searchEnd];
        if (query.Any(char.IsWhiteSpace))
        {
            CloseReferencePicker();
            return;
        }

        _referenceQuery = query;
        _referenceStartIndex = triggerIndex;
        _referenceEndIndex = searchEnd;
        _referencePickerOpen = true;
        _highlightedCandidateIndex = Math.Clamp(_highlightedCandidateIndex, 0, Math.Max(FilteredCapabilityCandidates.Count - 1, 0));
    }

    private int FindReferenceTriggerIndex(int searchEnd)
    {
        for (var index = searchEnd - 1; index >= 0; index--)
        {
            var character = InputText[index];
            if (char.IsWhiteSpace(character))
            {
                return -1;
            }

            if (character is '/' or '$' && !IsStoredReferenceTokenPrefix(index))
            {
                return index;
            }
        }

        return -1;
    }

    private bool IsStoredReferenceTokenPrefix(int triggerIndex)
    {
        return InputText[triggerIndex] == '$'
               && triggerIndex > 0
               && InputText[triggerIndex - 1] == '[';
    }

    private void MoveHighlight(int delta)
    {
        var candidates = FilteredCapabilityCandidates;
        if (candidates.Count == 0)
        {
            _highlightedCandidateIndex = 0;
            return;
        }

        _highlightedCandidateIndex = (_highlightedCandidateIndex + delta + candidates.Count) % candidates.Count;
    }

    private async Task CompleteHighlightedCandidate()
    {
        var candidates = FilteredCapabilityCandidates;
        if (candidates.Count == 0)
        {
            return;
        }

        await CompleteCandidate(candidates[Math.Clamp(_highlightedCandidateIndex, 0, candidates.Count - 1)]);
    }

    private async Task CompleteCandidate(AgentCapabilityReferenceCandidate candidate)
    {
        if (_disposed || EditorDisabled) return;
        InsertReferenceToken(candidate);
        _sessionDrafts[SessionId ?? string.Empty] = (InputText, _caretIndex, _draftGeneration);
        CloseReferencePicker();
        StateHasChanged();
        await FocusAsync();
    }

    private void InsertReferenceToken(AgentCapabilityReferenceCandidate candidate)
    {
        var triggerIndex = _referenceStartIndex >= 0 && _referenceStartIndex < InputText.Length
            ? _referenceStartIndex
            : FindReferenceTriggerIndex(InputText.Length);
        if (triggerIndex < 0)
        {
            return;
        }

        var tokenEndIndex = _referenceEndIndex >= triggerIndex && _referenceEndIndex <= InputText.Length
            ? _referenceEndIndex
            : triggerIndex + 1;

        var token = AgentCapabilityReferenceTokenSyntax.Create(candidate.Kind, candidate.Name);
        var prefix = InputText[..triggerIndex];
        var suffix = InputText[tokenEndIndex..];
        var separator = suffix.Length == 0 || char.IsWhiteSpace(suffix[0]) ? string.Empty : " ";
        InputText = prefix + token + separator + suffix;
        _caretIndex = prefix.Length + token.Length + separator.Length;
    }

    private void CloseReferencePicker()
    {
        _referencePickerOpen = false;
        _referenceQuery = string.Empty;
        _referenceStartIndex = -1;
        _referenceEndIndex = -1;
        _highlightedCandidateIndex = 0;
    }

    private bool MatchesReferenceQuery(AgentCapabilityReferenceCandidate candidate)
    {
        if (string.IsNullOrWhiteSpace(_referenceQuery))
        {
            return true;
        }

        return Contains(candidate.Name, _referenceQuery)
               || Contains(candidate.Description, _referenceQuery)
               || candidate.ToolNames.Any(tool => Contains(tool, _referenceQuery))
               || Contains(candidate.Kind.ToString(), _referenceQuery);
    }

    private bool IsCandidateAvailable(AgentCapabilityReferenceCandidate candidate)
    {
        return candidate.IsEnabled;
    }

    private static bool Contains(string? text, string query)
    {
        return text?.Contains(query, StringComparison.OrdinalIgnoreCase) == true;
    }

    private string GetCandidateClass(int index)
    {
        return index == _highlightedCandidateIndex ? "candidate-item selected" : "candidate-item";
    }

    private static string GetReferenceIcon(AgentCapabilityKind kind)
    {
        return kind == AgentCapabilityKind.Skill
            ? MoIcons.Sparkle
            : MoIcons.Workflow;
    }

    public async Task FocusAsync()
    {
        await SyncEditorAsync(focus: true);
    }

    private async Task SyncEditorAsync(bool focus)
    {
        _draftSynchronizationVersion++;
        _forceDraftSynchronization = true;
        _focusDraftSynchronization |= focus;
        await SynchronizeEditorAsync(focus);
    }

    private async Task SynchronizeEditorAsync(bool focus)
    {
        if (!_disposed && _interopSession is not null)
        {
            var sessionId = SessionId;
            var generation = _draftGeneration;
            var version = _draftSynchronizationVersion;
            var accepted = await _interopSession.SynchronizeAsync(
                ShowReferencePicker,
                IsSending || Disabled,
                InputText,
                _caretIndex,
                focus || _focusDraftSynchronization,
                force: _forceDraftSynchronization,
                sessionId: sessionId,
                sessionGeneration: generation,
                synchronizationVersion: version);
            if (_disposed || !accepted || generation != _draftGeneration || version != _draftSynchronizationVersion
                || !string.Equals(sessionId, SessionId, StringComparison.Ordinal)) return;

            _forceDraftSynchronization = false;
            _focusDraftSynchronization = false;
            if (_draftSynchronizationPending)
            {
                _draftSynchronizationPending = false;
                StateHasChanged();
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        var interopSession = _interopSession;
        _interopSession = null;
        if (interopSession is not null)
        {
            await interopSession.DisposeAsync();
        }
    }
}
