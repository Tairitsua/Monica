@inject IStringLocalizer<HealthCheckResource> L
@inject NavigationManager Nav

<div class="rh-bulkhead">
    <header class="rh-bulkhead-head"><div class="rh-bulkhead-copy"><h3>@L["Roles:Board"]</h3><p>@L["Roles:BoardDesc"]</p></div>
        <div class="rh-legend">
            @foreach (var state in new[] { RoleHealthStatus.Healthy, RoleHealthStatus.Degraded, RoleHealthStatus.Faulted })
            {
                <span><i class="@(state == RoleHealthStatus.Faulted ? "rh-legend-quarantine" : "rh-cell-mark") @RoleHealthDisplay.Color(state).ToCssClass()"></i>@L[$"Roles:States:{state}"]</span>
            }
        </div>
    </header>
    @if (_ordered.Length > 0)
    {
        <div class="rh-chambers @(_ordered.Length == 1 ? "is-single" : null)" role="listbox" aria-label="@L["Roles:Board"]">
            @foreach (var criticality in Enum.GetValues<RoleCriticality>())
            {
                var chamber = _ordered.Where(role => role.EffectiveCriticality == criticality).ToArray();
                if (_ordered.Length == 1 && chamber.Length == 0) continue;
                var domains = chamber.GroupBy(role => role.DomainId).ToArray();
                <div class="rh-chamber @(criticality == RoleCriticality.Required ? "mo-vl-role--primary" : "mo-vl-role--info") @(chamber.Any(r => r.Status == RoleHealthStatus.Faulted) ? "has-fault" : null)" role="group" aria-label="@L[$"Roles:Chamber:{criticality}"]">
                    <header class="rh-chamber-head"><div class="rh-chamber-title-row"><span class="rh-chamber-icon"><MoIcon Icon="@(criticality == RoleCriticality.Required ? MoIcons.ShieldCheck : MoIcons.Shield)" Size="15px" /></span>
                        <div class="rh-chamber-copy"><h4>@L[$"Roles:Chamber:{criticality}"]</h4><p>@L[$"Roles:ChamberDesc:{criticality}"]</p></div><span class="rh-chamber-count">@chamber.Count(r => r.Status == RoleHealthStatus.Healthy) / @chamber.Length</span></div>
                    </header>
                    @if (domains.Length == 0) { <div class="rh-chamber-empty">@L["Roles:ChamberEmpty"]</div> }
                    <div class="rh-chamber-domains @(domains.Length >= 6 ? "is-grid" : null)">
                        @foreach (var domain in domains)
                        {
                            <div class="rh-domain-row"><span class="rh-domain-label" title="@domain.Key">@domain.Key</span><div class="rh-domain-cells">
                                @foreach (var role in domain)
                                {
                                    var index = Array.IndexOf(_ordered, role);
                                    <button @key="role.RoleId" @ref="_buttons[index]" type="button" role="option" aria-label="@($"{role.RoleId} · {L[$"Roles:States:{role.Status}"]}")" aria-selected="@((index == _selected).ToString().ToLowerInvariant())"
                                        tabindex="@(index == _selected ? 0 : -1)" class="rh-cell @RoleHealthDisplay.Color(role.Status).ToCssClass() is-@role.Status.ToString().ToLowerInvariant()"
                                        @onfocus="@(() => _selected = index)" @onmouseenter="@(() => _hover = index)" @onmouseleave="@(() => _hover = null)"
                                        @onkeydown="@(key => MoveAsync(key, index))" @onclick="@(() => Nav.NavigateTo(Nav.GetUriWithQueryParameter("role", role.RoleId)))">
                                        <span class="rh-cell-top"><i class="rh-cell-mark @(role.Status == RoleHealthStatus.Degraded ? "is-diamond" : null)"></i><b class="rh-cell-id">@role.RoleId</b>
                                        @if (role.OverrideCriticality.HasValue) { <i class="rh-cell-ov mo-vl-role--secondary" title="@L["Roles:Override"]"></i> }</span>
                                        @if (role.Status == RoleHealthStatus.Faulted) { <span class="rh-cell-sub"><span class="rh-micro-badge">503</span><small class="rh-micro-stage">@L[$"Roles:Stages:{role.Faults.FirstOrDefault()?.Stage}"]</small>
                                            @if (RoleHealthDisplay.CandidateReady(role)) { <span class="rh-micro-badge mo-vl-role--success">@L["Roles:Verified"]</span> }</span> }
                                    </button>
                                }
                            </div></div>
                        }
                    </div>
                </div>
            }
        </div>
        var readout = _ordered[_hover ?? _selected];
        <div class="rh-readout" aria-live="polite"><span class="rh-readout-text"><i class="rh-cell-mark @RoleHealthDisplay.Color(readout.Status).ToCssClass()"></i><b>@readout.RoleId</b> · @L[$"Roles:States:{readout.Status}"] @readout.Faults.FirstOrDefault()?.Summary</span><span class="rh-readout-hint">@L["Roles:KeyHint"]</span></div>
    }
    @if (Roles.Where(r => !r.IsActiveOnCurrentHost).ToArray() is { Length: > 0 } remote)
    {
        <div class="rh-remote-strip"><span>@L["Roles:RemotePlacement", remote.Length, string.Join(", ", remote.Select(r => r.AssignedAppId).Distinct())]</span><a href="@Nav.GetUriWithQueryParameter("inactive", "1")">@L["Roles:ShowRemote"]</a></div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RoleHealthEntrySnapshot> Roles { get; set; } = [];
    private RoleHealthEntrySnapshot[] _ordered = [];
    private ElementReference[] _buttons = [];
    private int _selected;
    private int? _hover;

    protected override void OnParametersSet()
    {
        var selected = _ordered.ElementAtOrDefault(_selected)?.RoleId;
        _ordered = Roles.Where(role => role.IsActiveOnCurrentHost).OrderBy(role => role.EffectiveCriticality)
            .ThenBy(role => role.DomainId, StringComparer.OrdinalIgnoreCase).ThenBy(RoleHealthDisplay.Severity)
            .ThenBy(role => role.RoleId, StringComparer.OrdinalIgnoreCase).ToArray();
        _selected = Math.Max(0, Array.FindIndex(_ordered, role => role.RoleId == selected));
        _hover = null;
        if (_buttons.Length != _ordered.Length) _buttons = new ElementReference[_ordered.Length];
    }

    private async Task MoveAsync(KeyboardEventArgs key, int index)
    {
        var next = key.Key switch { "Home" => 0, "End" => _buttons.Length - 1,
            "ArrowRight" or "ArrowDown" => Math.Min(index + 1, _buttons.Length - 1),
            "ArrowLeft" or "ArrowUp" => Math.Max(0, index - 1), _ => index };
        if (next != index) { _selected = next; await _buttons[next].FocusAsync(preventScroll: true); }
    }
}
