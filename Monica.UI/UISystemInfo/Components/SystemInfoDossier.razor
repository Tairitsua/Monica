@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Microsoft.Extensions.Localization
@using System.Globalization
@using Monica.UI.Localization
@using Monica.UI.UISystemInfo.Models
@using Monica.UI.UISystemInfo.Support
@inject IStringLocalizer<SystemInfoResource> L

<section class="system-info-dossier">
    <section class="system-info-evidence" aria-labelledby="system-info-runtime-title">
        <EvidenceHeader Icon="@MoIcons.Cpu" HeadingId="system-info-runtime-title" Title="@L["Page:Sections:Runtime:Title"]" Description="@L["Page:Sections:Runtime:Description"]" />
        <dl class="system-info-facts">
            <EvidenceRow Label="@L["Page:Sections:Runtime:DotNetRuntime"]" Value="@Snapshot.Process.RuntimeVersion" />
            <EvidenceRow Label="@L["Page:Sections:Runtime:ProcessArchitecture"]">
                <span>@Snapshot.Process.Architecture</span><span class="evidence-chip">@L[Snapshot.Process.Is64BitProcess ? "Page:Sections:Runtime:Values:Process64Bit" : "Page:Sections:Runtime:Values:Process32Bit"]</span>
            </EvidenceRow>
            <EvidenceRow Label="@L["Page:Sections:Runtime:Privilege"]" Monospace="false">
                <span class="evidence-chip"><MoIcon Icon="@MoIcons.Shield" Size="13px" />@Privilege</span>
            </EvidenceRow>
            <EvidenceRow Label="@L["Page:Sections:Runtime:SystemPageSize"]" Value="@SystemInfoDisplayFormatter.FormatByteCount(Snapshot.Process.PageSizeBytes, CultureInfo.CurrentCulture)" />
            <EvidenceRow Label="@L["Page:Sections:Runtime:UserInteractive"]" Value="@Interactive" Monospace="false" />
        </dl>
    </section>
    <section class="system-info-evidence" aria-labelledby="system-info-host-title">
        <EvidenceHeader Icon="@MoIcons.Server" Tone="neutral" HeadingId="system-info-host-title" Title="@L["Page:Sections:Environment:Title"]" Description="@L["Page:Sections:Environment:Description"]" />
        <dl class="system-info-facts">
            <EvidenceRow Label="@L["Page:Sections:Environment:Machine"]"><SystemInfoCopyValue Value="@Snapshot.Host.MachineName" Class="is-path" /></EvidenceRow>
            <EvidenceRow Label="@L["Page:Sections:Environment:ProcessUser"]" Value="@ProcessUser" />
            <EvidenceRow Label="@L["Page:Sections:Environment:OperatingSystem"]" Value="@Snapshot.Host.OperatingSystem" Monospace="false" />
            <EvidenceRow Label="@L["Page:Sections:Environment:OperatingSystemBitness"]" Value="@OperatingSystemBitness" Monospace="false" />
            <EvidenceRow Label="@L["Page:Sections:Environment:TimeZone"]" Value="@Snapshot.Host.TimeZone.ToDisplayString()" Monospace="false" />
            <EvidenceRow Label="@L["Page:Sections:Environment:WorkingDirectory"]" Wide="true"><SystemInfoCopyValue Value="@Snapshot.Host.CurrentDirectory" Class="is-path" /></EvidenceRow>
            <EvidenceRow Label="@L["Page:Sections:Environment:ProcessPath"]" Wide="true">
                @if (Snapshot.Process.ProcessPath is { Length: > 0 } path) { <SystemInfoCopyValue Value="@path" Class="is-path" /> } else { <span>—</span> }
            </EvidenceRow>
        </dl>
    </section>
    <section class="system-info-evidence" aria-labelledby="system-info-artifact-title">
        <EvidenceHeader Icon="@MoIcons.Package" Tone="artifact" HeadingId="system-info-artifact-title" Title="@L["Page:Sections:Artifact:Title"]" Description="@L["Page:Sections:Artifact:Description"]" />
        <dl class="system-info-facts">
            <EvidenceRow Label="@L["Page:Sections:Artifact:Product"]" Value="@Display(Snapshot.Artifact.ProductName)" Monospace="false" />
            <EvidenceRow Label="@L["Page:Sections:Artifact:ProductVersion"]">
                <span>@ProductVersion</span>
                @if (BuildMetadata is { Length: > 0 } metadata) { <SystemInfoCopyValue Value="@metadata" Text="@($"+{metadata[..Math.Min(7, metadata.Length)]}")" /> }
            </EvidenceRow>
            <EvidenceRow Label="@L["Page:Sections:Artifact:FileVersion"]" Value="@Display(Snapshot.Artifact.FileVersion)" />
            <EvidenceRow Label="@L["Page:Sections:Artifact:ArtifactTimestamp"]">
                <span>@UiTime.Format(Snapshot.Artifact.ArtifactTimestampUtc)</span>
                @if (Snapshot.Artifact.ArtifactTimestampUtc is { } timestamp && timestamp <= Snapshot.Process.StartedAtUtc)
                {
                    <small class="evidence-note">@L["Page:Sections:Artifact:BeforeProcess", SystemInfoDisplayFormatter.FormatDuration(Snapshot.Process.StartedAtUtc - timestamp)]</small>
                }
            </EvidenceRow>
            <EvidenceRow Label="@L["Page:Sections:Artifact:Company"]" Value="@Display(Snapshot.Artifact.CompanyName)" Monospace="false" />
            <EvidenceRow Label="@L["Page:Sections:Artifact:Legal"]" Value="@Display(Snapshot.Artifact.LegalCopyright)" Monospace="false" />
        </dl>
    </section>
</section>

@code {
    [Parameter, EditorRequired] public SystemInfoSnapshot Snapshot { get; set; } = null!;
    private string Privilege => L[Snapshot.Process.IsPrivileged ? "Page:Sections:Runtime:Values:Privileged" : "Page:Sections:Runtime:Values:NotPrivileged"].Value;
    private string Interactive => L[Snapshot.Process.IsInteractive ? "Page:Sections:Runtime:Values:Interactive" : "Page:Sections:Runtime:Values:NonInteractive"].Value;
    private string OperatingSystemBitness => L[Snapshot.Process.Is64BitOperatingSystem ? "Page:Sections:Environment:Values:System64Bit" : "Page:Sections:Environment:Values:System32Bit"].Value;
    private string ProcessUser => string.IsNullOrWhiteSpace(Snapshot.Host.UserDomainName) ? Snapshot.Host.UserName : $"{Snapshot.Host.UserDomainName}\\{Snapshot.Host.UserName}";
    private string ProductVersion => Display(Snapshot.Artifact.ProductVersion?.Split('+', 2)[0]);
    private string? BuildMetadata => Snapshot.Artifact.ProductVersion?.Split('+', 2) is [_, var metadata] ? metadata : null;
    private static string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
