@inherits SignalRWorkspaceView
@inject SignalRInvocationArgumentParser Parser
@inject Monica.SignalR.Facades.SignalRFacade Facade

<div class="sr-callbacks">
    <MoSemanticCallout Severity="MoVisualRole.Neutral" Title="@T("Workspace:CallbackScope")">@T("Workspace:CbContractHelp")</MoSemanticCallout>
    <div class="sr-cb-toolbar"><div class="mo-vl-chips"><MoFilterChip Pill="true" Label="@T("Workspace:CbFilterAll")" Count="S.HubMethods.Count" Role="MoVisualRole.Primary" Selected="@(!OnlyEnabled)" SelectedChanged='() => Context.Set("enabled", null)' /><MoFilterChip Pill="true" Label="@T("Workspace:CbFilterEnabled")" Count="Enabled" Role="MoVisualRole.Info" Selected="OnlyEnabled" SelectedChanged='() => Context.Set("enabled", "1")' /></div><div class="sr-cb-actions"><button class="sr-btn sr-btn-outline sr-btn-sm" disabled="@(!S.ConnectionState.IsConnected || Enabled == S.HubMethods.Count)" @onclick="EnableAll">@T("Workspace:CbEnableAll")</button><button class="sr-btn sr-btn-outline sr-btn-sm" disabled="@(!S.ConnectionState.IsConnected || Enabled == 0)" @onclick="DisableAll">@T("Workspace:CbDisableAll")</button><button class="sr-btn sr-btn-sm mo-vl-soft-action mo-vl-role--info" disabled="@(!S.ConnectionState.IsConnected || Enabled == 0 || _probing)" title="@T("Workspace:CbSimPushTip")" @onclick="Probe"><MoIcon Icon="@MoIcons.Zap" Size="13px" />@T("Workspace:CbSimPush")</button></div></div>
    <div class="sr-search"><MoIcon Icon="@MoIcons.Search" Size="14px" /><input type="search" placeholder="@T("Workspace:CbSearchPlaceholder")" aria-label="@T("Workspace:CbSearchPlaceholder")" value="@Query" @oninput='args => Context.Set("callbackQ", args.Value?.ToString())' /></div>
    @if (!S.ConnectionState.IsConnected) { <p class="sr-connect-hint"><MoIcon Icon="@MoIcons.Info" Size="14px" />@T("Workspace:CbConnectHelp")</p> }
    @if (Filtered.Count == 0) { <MoContentState Compact="true">@T(OnlyEnabled ? "Workspace:CbEmptyEnabled" : "Workspace:InvNoMatch")</MoContentState> }
    else
    {
        <ul class="sr-cb-list">
            @foreach (var method in Filtered)
            {
                <li class="sr-cb-row @(method.IsListening ? "is-on" : null)" @key="method.Name"><label class="sr-cb-check"><input type="checkbox" checked="@method.IsListening" disabled="@(!S.ConnectionState.IsConnected)" @onchange="args => Toggle(method, args.Value is true)" /><div class="sr-cb-copy"><strong>@method.Name</strong>@if (Catalog?.Methods.FirstOrDefault(item => item.Name == method.Name)?.Description is { Length: > 0 } description && description != method.Name) { <span class="sr-cb-desc">@description</span> }<code class="mono sr-break">@Signature(method, true)</code></div></label><SignalRBadge Text="@T("Workspace:CbReceived", method.ReceivedCount)" Role="@(method.ReceivedCount > 0 ? MoVisualRole.Info : MoVisualRole.Neutral)" /></li>
            }
        </ul>
    }
</div>

@code {
    private bool _probing;
    private bool OnlyEnabled => Context.Get("enabled") == "1";
    private string Query => Context.Get("callbackQ");
    private int Enabled => S.HubMethods.Count(method => method.IsListening);
    private List<HubMethodInfo> Filtered => S.HubMethods.Where(method => (!OnlyEnabled || method.IsListening) && (string.IsNullOrWhiteSpace(Query) || Signature(method).Contains(Query.Trim(), StringComparison.OrdinalIgnoreCase) || method.DisplayName.Contains(Query.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();
    private Task Toggle(HubMethodInfo method, bool enabled) => Context.Run(async () => { await S.ToggleMethodListenerAsync(method, enabled); });
    private Task EnableAll() => Context.Run(async () => { await S.EnableAllListenersAsync(); });
    private Task DisableAll() => Context.Run(async () => { await S.DisableAllListenersAsync(); });
    private Task Probe() => Context.Run(async () =>
    {
        if (_probing || !S.ConnectionState.IsConnected || S.HubMethods.FirstOrDefault(method => method.IsListening) is not { } method) return;
        _probing = true;
        try
        {
            var result = await Facade.SendDebugCallbackAsync(S.ConnectedHubRoute, S.ConnectionState.ConnectionId, method.Name,
                method.Args.Select(arg => Parser.ConvertValue(string.Empty, arg.TypeName)).ToArray());
            if (result.IsFailure()) throw new InvalidOperationException(result.Message);
            await S.LoadSendDiagnosticsAsync();
        }
        finally { _probing = false; }
    });
}
