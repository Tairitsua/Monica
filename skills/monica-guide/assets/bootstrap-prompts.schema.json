{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tairitsua/Monica/blob/dev/skills/monica-guide/assets/bootstrap-prompts.schema.json",
  "title": "Monica Guide Bootstrap Prompt Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "repository",
    "skill",
    "immutableRef",
    "catalogDigest",
    "distribution",
    "verifiedAgentTargets",
    "fallback",
    "locales"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./bootstrap-prompts.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 3
    },
    "repository": {
      "type": "string",
      "const": "Tairitsua/Monica"
    },
    "skill": {
      "type": "string",
      "const": "monica-guide"
    },
    "immutableRef": {
      "type": "string",
      "const": "{{MONICA_IMMUTABLE_REF}}"
    },
    "catalogDigest": {
      "type": "string",
      "const": "{{MONICA_CATALOG_DIGEST}}"
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "productBundle",
        "immutableSkillUrlTemplate",
        "clientDownloadUrl"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "const": "Tairitsua/Monica"
        },
        "productBundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assetNameTemplate",
            "sha256SumsAsset"
          ],
          "properties": {
            "assetNameTemplate": {
              "type": "string",
              "const": "monica-framework-v{version}-{rid}.zip"
            },
            "sha256SumsAsset": {
              "type": "string",
              "const": "SHA256SUMS"
            }
          }
        },
        "immutableSkillUrlTemplate": {
          "type": "string",
          "const": "https://github.com/Tairitsua/Monica/tree/{tag}/skills/{skill}"
        },
        "clientDownloadUrl": {
          "type": "string",
          "const": "https://monica.dpdns.org/downloads"
        }
      }
    },
    "verifiedAgentTargets": {
      "type": "array",
      "prefixItems": [
        {
          "const": "codex"
        },
        {
          "const": "claude-code"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installCommand",
        "verifyCommand"
      ],
      "properties": {
        "installCommand": {
          "type": "string",
          "minLength": 1
        },
        "verifyCommand": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en-US",
        "zh-CN"
      ],
      "properties": {
        "en-US": {
          "$ref": "#/$defs/localizedPrompt"
        },
        "zh-CN": {
          "$ref": "#/$defs/localizedPrompt"
        }
      }
    }
  },
  "$defs": {
    "localizedPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
