@using Monica.UI.Shared.Components.States
@using Monica.Tool.Extensions
@inject IStringLocalizer<RepositoryUIResource> L

<aside class="repository-context-rail" aria-label="@L["ContextRail:Title"]">
    <header class="rail-header"><div><span>@L["ContextRail:Eyebrow"]</span><h3>@L["ContextRail:Title"]</h3><p>@L["ContextRail:Subtitle", Contexts.Count]</p></div><MudIconButton Icon="@MoIcons.Refresh" aria-label="@L["Common:Actions:Refresh"]" Size="Size.Small" Disabled="IsLoading" OnClick="OnRefresh" /></header>
    <MudTextField T="string" @bind-Value="_search" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="@L["Workbench:ContextSearch"]" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" Clearable="true" ClearIcon="@MoIcons.Close" />
    @if (IsLoading && Contexts.Count == 0)
    {
        <MoContentState Compact="true" Loading="true"><MudProgressCircular Color="Color.Primary" Size="Size.Small" Indeterminate="true" /><span>@L["ContextRail:Loading"]</span></MoContentState>
    }
    else if (Contexts.Count == 0)
    {
        <MoContentState Compact="true">@L["ContextRail:Empty"]</MoContentState>
    }
    else if (!VisibleContexts.Any())
    {
        <MoContentState Compact="true">@L["Workbench:ContextNoMatches"]</MoContentState>
    }
    else
    {
        <div class="context-list">
            @foreach (var context in VisibleContexts)
            {
                <button type="button" class="context-item" title="@context.Registration.DbContextType.GetCleanFullName()" aria-pressed="@(context.Registration.ContextId == SelectedContextId ? "true" : "false")" disabled="@IsLoading" @onclick="() => OnSelected.InvokeAsync(context.Registration.ContextId)">
                    <span class="context-item__title">@context.Registration.DbContextType.GetCleanName()</span>
                    <span class="context-item__subtitle">@context.ProviderName</span>
                    <span class="context-item__badges"><span class="context-status" data-tone="@(context.CanConnect ? "success" : context.HasError ? "warning" : "error")">@(context.CanConnect ? L["ContextRail:Status:Connected"] : context.HasError ? L["Workbench:Overview:Incomplete"] : L["ContextRail:Status:Disconnected"])</span>
                    @if (context.PendingMigrationCount > 0) { <span class="context-pending">@L["ContextRail:Status:Pending", context.PendingMigrationCount]</span> }
                    </span>
                </button>
            }
        </div>
    }
</aside>

@code {
    [Parameter] public IReadOnlyList<RepositoryDbContextSnapshot> Contexts { get; set; } = [];
    [Parameter] public string? SelectedContextId { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback<string> OnSelected { get; set; }
    private string? _search;
    private IEnumerable<RepositoryDbContextSnapshot> VisibleContexts => Contexts.Where(context => string.IsNullOrWhiteSpace(_search) || string.Join(' ', context.Registration.DbContextType.GetCleanName(), context.Registration.DbContextType.GetCleanFullName(), context.Registration.FullName, context.Registration.AssemblyName, context.ProviderName, context.Connection?.Database).Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
}
