@inject ConfigurationValueVisibility Visibility
@using Monica.Configuration.UI.Localization
@using Monica.UI.Shared.Components.Dialogs
@inject ConfigurationFacade Facade
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L
@implements IAsyncDisposable

<MudDialog ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent><MoDialogHeading Text="@L["Sources:Chain:Title"]" /></TitleContent>
    <DialogContent>
        <div class="configuration-source-chain">
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_error is not null)
        {
            <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_error</MudAlert>
        }
        else if (_chain is null || (_chain.Values.Count == 0 && _chain.StartupActualValue is null))
        {
            <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["Sources:Chain:Empty"]</MudAlert>
        }
        else
        {
            <MudStack Spacing="2">
                <code class="configuration-source-chain-path">@_chain.ConfigurationPath</code>
                @if (_chain.Kind == ConfigurationKind.Startup)
                {
                    <ConfigurationStartupStatus Candidate="@_chain.StartupActualValue?.StartupCandidate" />
                    <ConfigurationStartupValues Value="@_chain.StartupActualValue" />
                }
                @foreach (var group in SourceGroups)
                {
                    @if (group.Label is not null)
                    {
                        <MudText Typo="Typo.subtitle2">@group.Label</MudText>
                    }
                    @if (group.Values.Count == 0)
                    {
                        <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Dense="true">@L["Sources:Chain:Empty"]</MudAlert>
                    }
                    @foreach (var value in group.Values)
                    {
                        <div class="@SourceCardClass(value)">
                        <MudPaper Square="true" Elevation="0" Class="configuration-source-card">
                            <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
                                <MudStack Spacing="0">
                                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudText Typo="Typo.subtitle2">@value.Source.DisplayName</MudText>
                                        @if (value.IsEffective)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="configuration-source-effective">@L["Sources:Effective"]</MudChip>
                                        }
                                        <MudChip T="int" Size="Size.Small" Variant="Variant.Outlined">@value.Source.PriorityIndex</MudChip>
                                    </MudStack>
                                    <code class="configuration-source-chain-path">@SourcePath(value.Source)</code>
                                </MudStack>
                                <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="@(_chain.Kind != ConfigurationKind.Startup && value.Source.IsWritable ? "configuration-source-writable" : null)">
                                        @(_chain.Kind != ConfigurationKind.Startup && value.Source.IsWritable ? L["Sources:Writable"] : L["Sources:ReadOnly"])
                                    </MudChip>
                                    @if (CanEdit(value))
                                    {
                                        <MudTooltip Text="@L["Sources:Actions:EditSource"]">
                                            <MudIconButton Icon="@MoIcons.Edit"
                                                           aria-label="@L["Sources:Actions:EditSource"]"
                                                           Size="Size.Small"
                                                           Color="Color.Default"
                                                           OnClick="() => EditSourceAsync(value)" />
                                        </MudTooltip>
                                    }
                                </MudStack>
                            </MudStack>
                            <MudDivider Class="my-2" />
                            <p class="configuration-source-chain-value">@DisplayValue(value)</p>
                            @if (!value.Source.IsWritable && !string.IsNullOrWhiteSpace(value.Source.ReadOnlyReason))
                            {
                                <p class="configuration-source-chain-reason">@value.Source.ReadOnlyReason</p>
                            }
                        </MudPaper>
                        </div>
                    }
                }
            </MudStack>
        }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="configuration-source-chain-actions">
        <MudButton OnClick="Close">@L["Common:Actions:Close"]</MudButton>
            </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    /// <summary>Gets the locally discovered authoritative definition inspected by this native dialog.</summary>
    [Parameter, EditorRequired] public ConfigurationDefinition Definition { get; set; } = null!;
    /// <summary>Gets the schema node used by an explicitly permitted scalar source editor.</summary>
    [Parameter, EditorRequired] public ConfigurationNodeDefinition Node { get; set; } = null!;
    /// <summary>Gets an optional exact diagnostic path; it may inspect a path beyond the supplied ancestor schema.</summary>
    [Parameter] public LogicalPath? LogicalPath { get; set; }
    /// <summary>Gets whether the caller permits editing writable JSON sources; the default is true.</summary>
    /// <remarks>Diagnostic paths without an exact matching schema node remain inspectable and cannot be edited here.</remarks>
    [Parameter] public bool AllowSourceEdit { get; set; } = true;

    private readonly ConfigurationOperationLifetime _operations = new();
    private ConfigurationDefinition _definition = null!;
    private ConfigurationNodeDefinition _node = null!;
    private LogicalPath _path = null!;
    private bool _allowSourceEdit;
    private ConfigurationSourceChain? _chain;
    private string? _error;
    private bool _loading = true;
    private bool _editing;
    private long _loadGeneration;

    protected override async Task OnInitializedAsync()
    {
        // Native parameters define one frozen diagnostic target for this dialog's lifetime.
        _definition = Definition;
        _node = Node;
        _path = LogicalPath ?? Node.RelativePath;
        _allowSourceEdit = AllowSourceEdit;
        await LoadAsync();
    }

    private bool CanEdit(ConfigurationSourceValue value) => !_operations.IsRetired && _allowSourceEdit
        && _definition.Kind != ConfigurationKind.Startup
        && _node.RelativePath.Equals(_path) && value.Source.IsWritable
        && value.Source.Kind == ConfigurationSourceKind.JsonFile;

    private IEnumerable<(string? Label, IReadOnlyList<ConfigurationSourceValue> Values)> SourceGroups
    {
        get
        {
            if (_chain is null) yield break;
            if (_chain.Kind == ConfigurationKind.Startup)
            {
                yield return (L["Startup:ActualSources"], _chain.StartupValues);
                yield return (L["Startup:CandidateSources"], _chain.Values);
            }
            else
            {
                yield return (null, _chain.Values);
            }
        }
    }

    private async Task LoadAsync()
    {
        if (_operations.IsRetired) return;
        var generation = ++_loadGeneration;
        var definitionKey = _definition.DefinitionKey;
        var path = _path;
        _loading = true;
        try
        {
            await _operations.RunAsync(async token =>
            {
                var result = await Facade.GetSourceChainAsync(definitionKey, path, Visibility.ShowSensitiveValues);
                token.ThrowIfCancellationRequested();
                _operations.TryApply(() =>
                {
                    if (generation != _loadGeneration) return;
                    if (result.IsFailed(out var error, out var chain)) _error = error.Message;
                    else { _chain = chain; _error = null; }
                    _loading = false;
                });
            });
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
    }

    private async Task EditSourceAsync(ConfigurationSourceValue value)
    {
        if (!CanEdit(value) || _editing) return;
        var definition = _definition;
        var node = _node;
        var capturedValue = value;
        _editing = true; // Admission only; keep the native opener available for focus restoration.
        try
        {
            await _operations.RunAsync(async _ =>
            {
                var parameters = new DialogParameters<ConfigurationSourceValueEditDialog>();
                parameters.Add(dialog => dialog.Definition, definition);
                parameters.Add(dialog => dialog.Node, node);
                parameters.Add(dialog => dialog.SourceValue, capturedValue);
                var result = await _operations.ShowDialogAsync(() => DialogService.ShowAsync<ConfigurationSourceValueEditDialog>(
                    L["Sources:Edit:Title"], parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true }));
                if (_operations.IsRetired || result is not { Canceled: false, Data: ConfigurationMutationGroupApplyResult applied }) return;
                var issues = applied.PostCommitIssues;
                Snackbar.Add(applied.Status == ConfigurationMutationGroupApplyStatus.PartiallyApplied
                        ? L["Group:PartiallyApplied"] : L["Sources:Edit:Saved"],
                    issues.Count == 0 && applied.Status == ConfigurationMutationGroupApplyStatus.Applied ? Severity.Success : Severity.Warning);
                await LoadAsync();
                if (_operations.IsRetired || issues.Count == 0) return;
                var issueParameters = new DialogParameters<ConfigurationPostCommitIssuesDialog>();
                issueParameters.Add(dialog => dialog.Issues, issues);
                await _operations.ShowDialogAsync(() => DialogService.ShowAsync<ConfigurationPostCommitIssuesDialog>(
                    L["Dialogs:PostCommitIssues:Title"], issueParameters, ConfigurationPostCommitIssuesDialog.DefaultOptions));
            });
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
        finally { _editing = false; }
    }

    private static string SourcePath(ConfigurationSourceDescriptor source) => source.PhysicalPath ?? source.SourcePath ?? source.ProviderType;

    private string DisplayValue(ConfigurationSourceValue value) => Visibility.ShouldMask(value.IsSensitive)
        ? L["State:Value:Sensitive"] : value.DisplayValue ?? L["Value:States:Empty"];

    private static string SourceCardClass(ConfigurationSourceValue value) => value.IsEffective
        ? "configuration-source-card-shell effective-source" : "configuration-source-card-shell";

    private void Close()
    {
        if (!_operations.IsRetired) MudDialog.Close();
    }

    /// <summary>Closes and drains actual nested native results and in-flight source reads exactly once.</summary>
    /// <remarks>Facade, dialog service and snackbar are borrowed; retirement never disposes them.</remarks>
    public ValueTask DisposeAsync() => _operations.RetireAsync();
}
