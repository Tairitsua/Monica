@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.Support
@using Monica.EventBus.Models
@inject IStringLocalizer<EventBusResource> L

@if (Subscription is { } row)
{
    <div class="subscription-inspector">
        <header class="subscription-inspector-identity"><span>@L.GetSubscriptionScopeText(row.Scope) · @L.GetDiscoveryModeText(row.IsAutoDiscovered)</span><h2>@row.EventTypeShortName</h2><code>@row.EventType</code></header>
        <div class="subscription-inspector-capture"><span>@L["Inspector:FrozenCapture"]</span><time>@UiTime.Format(CapturedAt)</time></div>
        <MudTabs PrevIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" Elevation="0" Rounded="false">
            <MudTabPanel Text="@L["Inspector:Routing"]">
                <section class="subscription-inspector-section">
                    <div class="subscription-inspector-status"><EventBusStatusBadge Tone="row.StateColor">@L.GetSubscriptionStateText(row.State)</EventBusStatusBadge><p>@L["Inspector:RegistrationHelp"]</p></div>
                    <dl class="subscription-inspector-facts">
                        <div><dt>@L["SubscriptionDetail:Fields:SubscriptionId"]</dt><dd><code>@row.SubscriptionId</code></dd></div>
                        <div><dt>@L["SubscriptionDetail:Fields:ServiceKey"]</dt><dd><code>@EventBusPresentation.KeyText(row.ServiceKey, L)</code></dd></div>
                        <div class="subscription-inspector-wide"><dt>@L["SubscriptionDetail:Fields:EventType"]</dt><dd><code>@row.EventType</code></dd></div>
                        <div class="subscription-inspector-wide"><dt>@L["SubscriptionDetail:Fields:TopicName"]</dt><dd><code>@row.TopicName</code></dd></div>
                    </dl>
                    <h3>@L["SubscriptionDetail:Sections:HandlerInformation"]</h3>
                    <dl class="subscription-inspector-facts">
                        @if (row.HandlerType != null)
                        {
                            <div class="subscription-inspector-wide"><dt>@L["SubscriptionDetail:Fields:HandlerType"]</dt><dd><code>@row.HandlerType</code></dd></div>
                        }
                        else
                        {
                            <div><dt>@L["SubscriptionDetail:Fields:DeclaringType"]</dt><dd><code>@row.ActionDeclaringType</code></dd></div>
                            <div><dt>@L["SubscriptionDetail:Fields:MethodName"]</dt><dd><code>@row.ActionMethodName</code></dd></div>
                            <div class="subscription-inspector-wide"><dt>@L["SubscriptionDetail:Fields:MethodSignature"]</dt><dd><code>@row.ActionMethodSignature</code></dd></div>
                            <div><dt>@L["Shared:Fields:StaticMethod"]</dt><dd>@(row.ActionIsStatic is { } isStatic ? L[isStatic ? "Shared:Common:Yes" : "Shared:Common:No"].Value : L["Shared:Labels:Unknown"].Value)</dd></div>
                        }
                        <div class="subscription-inspector-wide"><dt>@L["SubscriptionDetail:Fields:HandlerFactory"]</dt><dd><code>@row.HandlerFactoryType</code></dd></div>
                    </dl>
                    <h3>@L["SubscriptionDetail:Sections:Lifecycle"]</h3>
                    <dl class="subscription-inspector-facts">
                        <div><dt>@L["SubscriptionDetail:Timeline:Created"]</dt><dd><time>@UiTime.Format(row.CreatedAt)</time></dd></div>
                        <div><dt>@L["SubscriptionDetail:Timeline:Activated"]</dt><dd><time>@(row.ActivatedAt is { } activated ? UiTime.Format(activated) : L["Inspector:NoTimestamp"].Value)</time></dd></div>
                        <div><dt>@L["SubscriptionDetail:Timeline:Deactivated"]</dt><dd><time>@(row.DeactivatedAt is { } deactivated ? UiTime.Format(deactivated) : L["Inspector:NoTimestamp"].Value)</time></dd></div>
                    </dl>
                </section>
            </MudTabPanel>
            <MudTabPanel Text="@L["SubscriptionDetail:Sections:Runtime"]">
                <section class="subscription-inspector-section">
                    @if (row.TopicStatus != null)
                    {
                        <EventBusTopicEvidence Status="row.TopicStatus" />
                    }
                    else
                    {
                        <div class="subscription-inspector-empty"><MoIcon Icon="@MoIcons.RadioOff" Size="1.5rem" /><h3>@L[row.Scope == EventSubscriptionScope.Local ? "Registry:LocalRuntime" : "Registry:NotReported"]</h3><p>@L[row.Scope == EventSubscriptionScope.Local ? "Inspector:LocalHelp" : "SubscriptionDetail:Runtime:NoData"]</p></div>
                    }
                </section>
            </MudTabPanel>
            <MudTabPanel Text="@L["SubscriptionDetail:Sections:Metadata"]">
                <section class="subscription-inspector-section">
                    @if (row.Metadata.Count > 0)
                    {
                        <dl class="subscription-inspector-metadata">@foreach (var metadata in row.Metadata.OrderBy(pair => pair.Key, StringComparer.Ordinal)) { <div><dt><code>@metadata.Key</code></dt><dd><code>@metadata.Value</code></dd></div> }</dl>
                    }
                    else
                    {
                        <div class="subscription-inspector-empty"><MoIcon Icon="@MoIcons.Braces" Size="1.5rem" /><p>@L["Inspector:NoMetadata"]</p></div>
                    }
                </section>
            </MudTabPanel>
        </MudTabs>
    </div>
}

@code {
    [Parameter] public SubscriptionViewModel? Subscription { get; set; }
    [Parameter] public DateTimeOffset CapturedAt { get; set; } = DateTimeOffset.UtcNow;
}
