@attribute [Route(PAGE_URL)]
@implements IAsyncDisposable
@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.UI.Shared.Components
@using Monica.AI.UI.UIKnowledgeBase.State
@inject IStringLocalizer<AIResource> L

<PageTitle>@L["KnowledgeBase:Navigation:Manage"]</PageTitle>
<div class="knowledge-base-manage-page">
    <KnowledgeRagHeader Title="@L["KnowledgeWorkbench:Knowledge"]" Description="@L["KnowledgeWorkbench:KnowledgeDescription"]" CurrentRoute="@PAGE_URL">
        <Actions><MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.Add" OnClick="PageState.ShowCreateKnowledgeBaseDialogAsync">@L["Common:Create"]</MudButton></Actions>
    </KnowledgeRagHeader>
    <div class="knowledge-workspace">
        @if (!PageState.IsInitialLoading && string.IsNullOrWhiteSpace(PageState.CatalogErrorMessage) && PageState.KnowledgeBases.Count == 0)
        {
            <section class="knowledge-empty"><MoContentState><MoIcon Icon="@MoIcons.Library" Size="1.5rem" /><h2>@L["KnowledgeWorkbench:FirstCollection"]</h2><p>@L["KnowledgeWorkbench:FirstCollectionHint"]</p><MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.Add" OnClick="PageState.ShowCreateKnowledgeBaseDialogAsync">@L["Common:Create"]</MudButton></MoContentState></section>
        }
        else
        {
        <div class="knowledge-workspace-grid">
            <KnowledgeBaseCatalog Items="PageState.KnowledgeBases" Selected="PageState.SelectedKnowledgeBase" IsLoading="PageState.IsInitialLoading" LoadingText="@PageState.LoadingPhaseText" ErrorMessage="@PageState.CatalogErrorMessage" SelectionChanged="PageState.SelectKnowledgeBaseAsync" Retry="PageState.InitializeAsync" FocusRequested="FocusDossierAsync" />
            <section class="knowledge-dossier" aria-busy="@((PageState.IsInitialLoading || PageState.IsSelectionLoading).ToString().ToLowerInvariant())">
                @if (PageState.IsInitialLoading || PageState.IsSelectionLoading)
                {
                    <div class="knowledge-loading"><MoContentState Loading="true"><p>@PageState.LoadingPhaseText</p><MudProgressLinear Value="PageState.LoadingProgressValue" Color="Color.Primary" /></MoContentState></div>
                }
                else if (PageState.SelectedKnowledgeBase is { } kb)
                {
                    <header class="collection-identity">
                        <div class="collection-identity-top">
                            <div class="collection-copy"><span class="collection-label">@L["KnowledgeWorkbench:Collection"]</span><h2 @ref="_dossierHeading" tabindex="-1">@kb.Name</h2><code>@kb.Id</code></div>
                            <div class="collection-actions"><MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@MoIcons.Edit" OnClick="PageState.ShowEditKnowledgeBaseDialogAsync">@L["Common:Edit"]</MudButton><MudMenu Icon="@MoIcons.MoreHorizontal" AriaLabel="@L["KnowledgeWorkbench:CollectionActions"]"><MudMenuItem Icon="@MoIcons.Delete" IconColor="Color.Error" OnClick="PageState.DeleteSelectedKnowledgeBaseAsync">@L["Common:Delete"]</MudMenuItem></MudMenu></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(kb.Description)) { <p class="collection-description">@kb.Description</p> }
                        <div class="collection-facts"><span>@L["KnowledgeWorkbench:DocumentCount", kb.DocumentCount]</span><span>@L["KnowledgeWorkbench:RecordedChunks", kb.ChunkCount]</span><span class="binding-state">@(KnowledgeBaseManagePageState.IsRagEnabled(kb) ? L["KnowledgeWorkbench:ModelBound"] : L["KnowledgeBase:RagStatus:LookupOnly"])</span></div>
                        @if (KnowledgeBaseManagePageState.IsRagEnabled(kb)) { <div class="collection-binding"><MoIcon Icon="@MoIcons.Cpu" Size="1.5rem" /><span>@kb.EmbeddingModelName <small>@PageState.GetProviderDisplayLabel(kb.EmbeddingProviderId, kb.EmbeddingModelName)</small></span></div> }
                    </header>
                    <KnowledgeBaseImportActions PageState="PageState" />
                    <KnowledgeBaseDocumentInventorySection PageState="PageState" />
                }
                else
                {
                    <div class="knowledge-empty"><MoContentState><MoIcon Icon="@MoIcons.Library" Size="1.5rem" /><h2>@L["KnowledgeWorkbench:ChooseCollection"]</h2><p>@L["KnowledgeWorkbench:ChooseCollectionHint"]</p></MoContentState></div>
                }
            </section>
        </div>
        }
    </div>
</div>
@code {
    private ElementReference _dossierHeading;
    private readonly Monica.AI.UI.Shared.Support.KnowledgeDossierFocus _dossierFocus = new();
    private async Task FocusDossierAsync(Monica.AI.KnowledgeBase.Models.KnowledgeBase selected)
    {
        if (_retired || PageState.IsRetired || PageState.SelectedKnowledgeBase?.Id != selected.Id) return;
        var generation = PageState.SelectionGeneration;
        await InvokeAsync(() =>
        {
            if (_retired || PageState.IsRetired || PageState.SelectionGeneration != generation
                || PageState.SelectedKnowledgeBase?.Id != selected.Id) return;
            _dossierFocus.Request(selected.Id, generation);
            StateHasChanged();
        });
    }
    protected override Task OnAfterRenderAsync(bool firstRender) => _dossierFocus.AfterRenderAsync(
        (id, generation) => !_retired && !PageState.IsRetired && !PageState.IsSelectionLoading
            && PageState.SelectionGeneration == generation && PageState.SelectedKnowledgeBase?.Id == id,
        () => _dossierHeading.FocusAsync().AsTask());
}
