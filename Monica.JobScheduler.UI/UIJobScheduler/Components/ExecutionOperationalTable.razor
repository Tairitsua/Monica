@inject NavigationManager Navigation
@using Monica.JobScheduler.UI.Localization

<section class="execution-ledger @(HasLoadedSnapshot ? null : "execution-ledger--unavailable")" aria-labelledby="execution-ledger-title">
    <header class="execution-ledger__heading"><h2 id="execution-ledger-title">@L["Executions:Title"] @if(HasLoadedSnapshot) { <small>@TotalCount.ToString("N0")</small> }</h2><div class="execution-ledger__ordering"><div role="group" aria-label="@L["Executions:Sort:Field"]">@foreach(var field in Enum.GetValues<JobExecutionSortField>()) { <button type="button" aria-pressed="@((_sortField==field).ToString().ToLowerInvariant())" disabled="@(IsLoading || CommandsDisabled)" @onclick="@(() => ChangeSortFieldAsync(field))">@FormatSortField(field)</button> }</div><button type="button" disabled="@(IsLoading || CommandsDisabled)" @onclick="@(() => ChangeSortDirectionAsync(_sortDirection==SortDirection.Descending ? SortDirection.Ascending : SortDirection.Descending))"><MoIcon Icon="@(_sortDirection==SortDirection.Descending ? MoIcons.ArrowDown : MoIcons.ArrowUp)" Size="13px"/>@FormatSortDirection(_sortDirection)</button></div></header>
    @if(FilterContent is not null) { <div class="execution-ledger__filters">@FilterContent</div> }

    <div class="execution-ledger__data">
        <MudTable @ref="_table"
                  T="ExecutionPresentationRow"
                  ServerData="LoadServerDataAsync"
                  RowsPerPage="@PageSize"
                  Dense="true"
                  Hover="true"
                  Breakpoint="Breakpoint.Xs"
                  TableAttributes="@(new Dictionary<string, object?> { ["aria-label"] = L["Executions:Title"].Value })"
                  HorizontalScrollbar="false"
                  Elevation="0"
                  Square="true">
            <ColGroup><col class="execution-ledger__state-column" /><col class="execution-ledger__identity-column" /><col class="execution-ledger__recorded-column" /><col class="execution-ledger__duration-column" /><col class="execution-ledger__attempt-column" /><col class="execution-ledger__instance-column" /></ColGroup>
            <HeaderContent>
                <MudTh>@L["Executions:Columns:State"]</MudTh><MudTh>@L["Executions:Columns:Definition"]</MudTh><MudTh>@L["Executions:Columns:Created"]</MudTh><MudTh>@L["Executions:Columns:Duration"]</MudTh><MudTh>@L["Workspace:ClaimsAndFailures"]</MudTh><MudTh>@L["ExecutionDetail:Instance"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                @if (HasLoadedSnapshot)
                {
                    var execution = context.Capture;
                    <MudTd DataLabel="@L["Executions:Columns:State"]"><button type="button" class="execution-ledger__state" data-state="@execution.State.ToString().ToLowerInvariant()" disabled="@CommandsDisabled" aria-label="@L["Executions:Actions:OpenDetailsFor", JobSchedulerUiPresentation.GetJobDisplayName(execution.Template), execution.InstanceId]" @onclick="@(() => InspectAsync(execution))"><i></i>@L[$"ExecutionStates:{execution.State}"]</button></MudTd>
                    <MudTd DataLabel="@L["Executions:Columns:Definition"]"><div class="execution-ledger__identity"><a class="execution-ledger__name" href="@JobSchedulerUiUrls.JobDefinition(new JobId(execution.Template.OwnerKey, execution.Template.JobKey), Navigation.ToAbsoluteUri(Navigation.Uri).PathAndQuery)">@JobSchedulerUiPresentation.GetJobDisplayName(execution.Template)</a><small class="execution-ledger__owner">@execution.Template.OwnerKey</small></div></MudTd>
                    <MudTd DataLabel="@L["Executions:Columns:Created"]"><div class="execution-ledger__recorded"><time datetime="@execution.CreatedAtUtc.ToString("O")" title="@TimePresentation.FormatTimestamp(execution.CreatedAtUtc)">@(ObservedAtUtc is { } at ? TimePresentation.FormatListTimestamp(execution.CreatedAtUtc, at) : TimePresentation.FormatTimestamp(execution.CreatedAtUtc))</time><small>@L[$"ExecutionOrigins:{execution.Origin}"]</small></div></MudTd>
                    <MudTd Class="execution-ledger__number" DataLabel="@L["Executions:Columns:Duration"]">@FormatDuration(execution)</MudTd>
                    <MudTd Class="execution-ledger__number" DataLabel="@L["Workspace:ClaimsAndFailures"]"><span title="@($"{L["Executions:Evidence:Claims"]}: {execution.ExecutionAttempt} · {L["Executions:Evidence:ConsumedFailures"]}: {execution.RetryAttempt}")">@execution.ExecutionAttempt / @execution.RetryAttempt</span></MudTd>
                    <MudTd DataLabel="@L["ExecutionDetail:Instance"]"><div class="execution-ledger__actions"><button type="button" class="execution-ledger__instance" title="@execution.InstanceId" disabled="@CommandsDisabled" aria-label="@L["Executions:Actions:OpenDetailsFor", JobSchedulerUiPresentation.GetJobDisplayName(execution.Template), execution.InstanceId]" @onclick="@(() => InspectAsync(execution))">@JobSchedulerUiPresentation.ShortIdentity(execution.InstanceId)</button>
                        @if (!execution.IsTerminal || context.RetainCancellationOpener)
                        {
                            <MudTooltip Text="@L["Executions:Actions:Cancel"]"><MudIconButton Icon="@MoIcons.StopCircle" Color="Color.Warning" Size="Size.Small" Disabled="@CommandsDisabled" aria-disabled="@((CommandsDisabled || execution.IsTerminal) ? "true" : "false")" OnClick="@(() => RequestCancellationAsync(context, execution))" aria-label="@L["Executions:Actions:CancelFor", execution.InstanceId]" /></MudTooltip>
                        }
                    </div></MudTd>
                }
            </RowTemplate>
            <LoadingContent>
                <div class="execution-ledger__empty"><p>@L["Executions:SnapshotPending"]</p></div>
            </LoadingContent>
            <NoRecordsContent>
                <div class="execution-ledger__empty">
                    <MoIcon Icon="@(IsQueryFailed ? MoIcons.CloudOff : MoIcons.Receipt)" Size="2.25rem" />
                    <p>@(IsQueryFailed ? L["Executions:SnapshotUnavailable"] : HasLoadedSnapshot ? EmptyText ?? L["Executions:Empty"] : L["Executions:SnapshotPending"])</p>
                </div>
            </NoRecordsContent>
            <PagerContent>
                @if (HasLoadedSnapshot)
                {
                    <MudTablePager PageSizeOptions="@PageSizeOptions"
                                   RowsPerPageString="@L["Executions:Filters:PageSize"]"
                                   InfoFormat="@L["Catalog:Pagination:Range"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" />
                }
            </PagerContent>
        </MudTable>
    </div>
</section>
