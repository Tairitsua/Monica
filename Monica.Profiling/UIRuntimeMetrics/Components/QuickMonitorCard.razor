@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using System.Globalization
@using Monica.Profiling.RuntimeMetrics.Models
@using Monica.Profiling.UIRuntimeMetrics.Support
@inject IStringLocalizer<RuntimeMetricsResource> L

<section class="runtime-vitals" aria-label="@L["Vitals:AriaLabel"]" aria-busy="@(IsLoading && DataPoint is null)">
    <div class="runtime-vitals__layout">
        <article class="runtime-vitals__cpu" data-vital="cpu">
            <div class="runtime-vitals__identity">
                <span class="runtime-vitals__eyebrow">@L["Vitals:Eyebrow"]</span>
                <MoIcon Icon="@MoIcons.Gauge" Size="1.25rem" aria-hidden="true" />
            </div>
            <div class="runtime-vitals__cpu-measurement">
                <span class="runtime-vitals__label">@L["Vitals:Cpu"]</span>
                <strong class="runtime-vitals__cpu-value">@RuntimeMetricsDisplayFormatter.Percent(DataPoint?.CpuUsagePercent)</strong>
            </div>
            <p class="runtime-vitals__sample">
                @if (DataPoint is not null)
                {
                    <time datetime="@RuntimeMetricsDisplayFormatter.MachineTime(DataPoint.Timestamp)"
                          title="@RuntimeMetricsDisplayFormatter.MachineTime(DataPoint.Timestamp)">
                        @L["Vitals:Sampled", UiTime.FormatTime(RuntimeMetricsDisplayFormatter.AsUtc(DataPoint.Timestamp))]
                    </time>
                }
                else
                {
                    @(IsLoading ? L["Common:LoadingValue"] : L["Vitals:Waiting"])
                }
            </p>
        </article>

        <div class="runtime-vitals__memory">
            <article class="runtime-vitals__working-set" data-vital="working-set">
                <span class="runtime-vitals__label">@L["Vitals:WorkingSet"]</span>
                <strong class="runtime-vitals__memory-value">@RuntimeMetricsDisplayFormatter.Megabytes(DataPoint?.WorkingSetMB)</strong>
                @if (DataPoint is not null && PreviousDataPoint is not null)
                {
                    <span class="runtime-vitals__delta">
                        @L["Vitals:Delta", RuntimeMetricsDisplayFormatter.SignedMegabytes(DataPoint.WorkingSetMB - PreviousDataPoint.WorkingSetMB)]
                    </span>
                }
            </article>
            <article class="runtime-vitals__heap" data-vital="gc-heap">
                <div class="runtime-vitals__heap-measurement">
                    <span class="runtime-vitals__label">@L["Vitals:GcHeap"]</span>
                    <strong class="runtime-vitals__heap-value">@RuntimeMetricsDisplayFormatter.Megabytes(DataPoint?.GcHeapSizeMB)</strong>
                </div>
                @if (DataPoint is not null && PreviousDataPoint is not null)
                {
                    <span class="runtime-vitals__delta">
                        @L["Vitals:Delta", RuntimeMetricsDisplayFormatter.SignedMegabytes(DataPoint.GcHeapSizeMB - PreviousDataPoint.GcHeapSizeMB)]
                    </span>
                }
            </article>
        </div>

        <div class="runtime-vitals__supporting">
            <article class="runtime-vitals__fact" data-vital="threads">
                <span class="runtime-vitals__label">@L["Vitals:Threads"]</span>
                <strong class="runtime-vitals__fact-value">@(DataPoint?.ThreadCount.ToString(CultureInfo.CurrentCulture) ?? "—")</strong>
            </article>
            <article class="runtime-vitals__fact" data-vital="gc-time">
                <span class="runtime-vitals__label">@L["Vitals:GcTime"]</span>
                <strong class="runtime-vitals__fact-value">@RuntimeMetricsDisplayFormatter.Percent(DataPoint?.TimeInGcPercent)</strong>
            </article>
            <article class="runtime-vitals__fact" data-vital="allocation">
                <span class="runtime-vitals__label">@L["Vitals:AllocationRate"]</span>
                <strong class="runtime-vitals__fact-value">@RuntimeMetricsDisplayFormatter.ReportedAllocationRate(DataPoint?.AllocationRateBytesPerSecond)</strong>
            </article>
        </div>
    </div>
</section>

@code {
    /// <summary>
    /// Gets or sets the latest captured observation, or null before an observation is available.
    /// </summary>
    [Parameter] public RuntimeMetricsPoint? DataPoint { get; set; }

    /// <summary>
    /// Gets or sets the observation from the previous successful view read for memory comparisons.
    /// </summary>
    [Parameter] public RuntimeMetricsPoint? PreviousDataPoint { get; set; }

    /// <summary>
    /// Gets or sets whether the view is refreshing. Captured values remain visible during refresh.
    /// </summary>
    [Parameter] public bool IsLoading { get; set; }
}
