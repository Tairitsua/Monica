@using Monica.Configuration.UI.Localization
@using Monica.UI.Shared.Components.Dialogs
@using Monica.UI.UIDiffHighlight.Models
@inject ConfigurationFacade Facade
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L
@implements IAsyncDisposable

<MudDialog Class="configuration-history-diff-dialog" ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent><MoDialogHeading Text="@DialogTitle" /></TitleContent>
    <DialogContent>
        <div class="configuration-history-diff-dialog-content">
            @if (_group is not null || _focusPath is not null)
            {
                <header class="configuration-history-diff-context">
                    @if (_group is not null)
                    {
                        <p>@L["History:Dialog:GroupSubtitle", _group.MutationCount, _group.DefinitionKeys.Count]</p>
                        <span class="configuration-history-diff-badge" data-tone="@GroupTone(_group.Status)">@StatusText(_group.Status)</span>
                        <dl><div><dt>@L["History:Dialog:MutationGroup"]</dt><dd><code>@_group.GroupId</code></dd></div></dl>
                    }
                    @if (_focusPath is not null)
                    {
                        <dl><div><dt>@L["History:Dialog:LogicalPath"]</dt><dd><code>@_focusPath.ToCanonicalString()</code></dd></div></dl>
                    }
                </header>
            }
            @if (_entries.Count == 0)
            {
                <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info">@L["History:Dialog:NoPreview"]</MudAlert>
            }
            else
            {
                <div class="configuration-history-diff-layout">
                    <nav class="configuration-history-diff-navigation" aria-label="@L["History:Dialog:Timeline"]">
                        <h3>@L["History:Dialog:Timeline"]</h3>
                        <div class="configuration-history-diff-native-selection">
                            <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="HistoryTimelineEntry" Value="@_selectedEntry" ValueChanged="SelectEntry"
                                       Label="@L["History:Dialog:Timeline"]" Variant="Variant.Outlined" Dense="true"
                                       ToStringFunc="@(entry => entry?.Title ?? string.Empty)">
                                @foreach (var entry in _entries)
                                {
                                    <MudSelectItem T="HistoryTimelineEntry" Value="@entry">
                                        <div class="configuration-history-diff-option">
                                            <strong>@entry.Title</strong>
                                            <span>@entry.Subtitle</span>
                                            <time datetime="@entry.Time.ToString("O")">@FormatTime(entry.Time)</time>
                                        </div>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                        <div class="configuration-history-diff-entry-list">
                            @foreach (var entry in _entries)
                            {
                                <div class="configuration-history-diff-entry" data-tone="@TargetTone(entry.Rows)" data-selected="@(entry == _selectedEntry ? "true" : "false")" @key="entry.Id">
                                    <MudButton Variant="Variant.Text" Color="Color.Default" FullWidth="true"
                                               aria-pressed="@(entry == _selectedEntry ? "true" : "false")" OnClick="() => SelectEntry(entry)">
                                        <div class="configuration-history-diff-entry-content">
                                            <MoIcon Icon="@entry.Icon" Size="1.25rem" />
                                            <div><strong>@entry.Title</strong><span>@entry.Subtitle</span><time datetime="@entry.Time.ToString("O")">@FormatTime(entry.Time)</time></div>
                                        </div>
                                    </MudButton>
                                </div>
                            }
                        </div>
                    </nav>
                    @if (_selectedEntry is { } selected)
                    {
                        <section class="configuration-history-diff-evidence">
                            <header class="configuration-history-diff-selection-heading">
                                <h3>@selected.Title</h3><p>@selected.Subtitle</p>
                                <div class="configuration-history-diff-selection-actions">
                                    <span class="configuration-history-diff-badge" data-tone="@TargetTone(selected.Rows)"><MoIcon Icon="@TargetIcon(selected.Rows)" Size="1.25rem" />@TargetKindText(selected.Rows)</span>
                                    <span class="configuration-history-diff-badge">@L["History:Dialog:Version", selected.Version]</span>
                                    @if (selected.Id != GROUP_SUMMARY_ENTRY_ID)
                                    {
                                        <span class="configuration-history-diff-badge" data-tone="@(selected.MutationKind == ConfigurationMutationKind.Remove ? "warning" : "info")">@MutationText(selected.MutationKind)</span>
                                    }
                                    <MudTooltip Text="@SelectedRollbackTooltip">
                                        <MudButton Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" StartIcon="@MoIcons.Restore"
                                                   Disabled="@(!CanRollbackSelectedEntry)" OnClick="RollbackSelectedEntryAsync">@L["Rollback:Confirm"]</MudButton>
                                    </MudTooltip>
                                </div>
                            </header>
                            <dl class="configuration-history-diff-facts">
                                <div><dt>@L["History:Columns:Time"]</dt><dd><time datetime="@selected.Time.ToString("O")">@FormatTime(selected.Time)</time></dd></div>
                                <div><dt>@L["History:Dialog:Operator"]</dt><dd>@OperatorText(selected.Rows[0])<code>@ValueOrEmpty(selected.Rows[0].ModifierId)</code></dd></div>
                                <div class="configuration-history-diff-fact-wide"><dt>@L["Group:Reason"]</dt><dd>@ReasonText(selected.Rows)</dd></div>
                            </dl>
                            <div class="configuration-history-diff-targets">
                                @foreach (var row in selected.Rows)
                                {
                                    <section class="configuration-history-diff-target" @key="row.HistoryId">
                                        <div class="configuration-history-diff-target-heading"><strong>@DefinitionDisplay(row.DefinitionKey)</strong><span class="configuration-history-diff-badge" data-tone="@TargetTone(new[] { row })">@TargetKindText(new[] { row })</span></div>
                                        <dl class="configuration-history-diff-facts">
                                            <div><dt>@L["History:Dialog:Definition"]</dt><dd><code>@row.DefinitionKey</code></dd></div>
                                            <div><dt>@L["History:Dialog:LogicalPath"]</dt><dd><code>@row.LogicalPath.ToCanonicalString()</code></dd></div>
                                            <div><dt>@L["History:Dialog:HistoryRecord"]</dt><dd><code>@row.HistoryId</code></dd></div>
                                            <div><dt>@L["History:Dialog:Target"]</dt><dd>@TargetDisplay(row)</dd></div>
                                            @if (row.MutationGroupId is not null)
                                            {
                                                <div class="configuration-history-diff-fact-wide"><dt>@L["History:Dialog:MutationGroup"]</dt><dd><code>@row.MutationGroupId</code></dd></div>
                                            }
                                            @if (row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)
                                            {
                                                <div><dt>@L["History:Dialog:SourceProvider"]</dt><dd>@ValueOrEmpty(row.SourceProviderType)</dd></div>
                                                <div><dt>@L["History:Dialog:SourceConfigurationPath"]</dt><dd><code>@ValueOrEmpty(row.SourceConfigurationPath ?? row.ConfigurationPath)</code></dd></div>
                                                <div class="configuration-history-diff-fact-wide"><dt>@L["History:Dialog:SourcePhysicalPath"]</dt><dd><code>@ValueOrEmpty(row.SourcePhysicalPath)</code></dd></div>
                                                <div><dt>@L["History:Dialog:SourceRevisionBefore"]</dt><dd><code>@ValueOrEmpty(row.SourceRevisionBefore)</code></dd></div>
                                                <div><dt>@L["History:Dialog:SourceRevisionAfter"]</dt><dd><code>@ValueOrEmpty(row.SourceRevisionAfter)</code></dd></div>
                                            }
                                        </dl>
                                    </section>
                                }
                            </div>
                            <ConfigurationHistoryDiffPreview Rows="@selected.Rows" ViewMode="EDiffViewMode.Unified" />
                        </section>
                    }
                </div>
            }
            @if (_loadError is not null)
            {
                <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_loadError</MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="configuration-history-diff-dialog-actions">
            @if (_hasMore)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.ChevronDown" Disabled="@_loadingMore" OnClick="LoadMoreAsync">@L["History:Actions:LoadMore"]</MudButton>
            }
            <MudButton OnClick="Close">@L["Common:Actions:Close"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>
@code {
    private const string GROUP_SUMMARY_ENTRY_ID = "group";

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Gets the captured immutable history rows initially inspected by this dialog.</summary>
    [Parameter] public IReadOnlyList<ConfigurationValueHistory> Rows { get; set; } = [];
    /// <summary>Gets locally available definition metadata used to gate rollback.</summary>
    [Parameter] public IReadOnlyList<ConfigurationDefinitionSummary> Definitions { get; set; } = [];
    /// <summary>Gets an optional authoritative definition for member history.</summary>
    [Parameter] public ConfigurationDefinition? Definition { get; set; }
    /// <summary>Gets whether the caller permits rollback; the default is true.</summary>
    [Parameter] public bool AllowRollback { get; set; } = true;
    /// <summary>Gets an optional persisted group whose exact identity is frozen on initialization.</summary>
    [Parameter] public ConfigurationMutationGroup? Group { get; set; }
    /// <summary>Gets an optional localized native dialog heading.</summary>
    [Parameter] public string? Title { get; set; }
    /// <summary>Gets the optional exact logical-path context.</summary>
    [Parameter] public LogicalPath? FocusPath { get; set; }
    /// <summary>Gets the captured bounded query used to load subsequent mutation units.</summary>
    [Parameter] public ConfigurationHistoryPageRequest? HistoryRequest { get; set; }
    /// <summary>Gets the accepted initial page and its continuation cursor.</summary>
    [Parameter] public ConfigurationHistoryPageResult? InitialPage { get; set; }

    private readonly ConfigurationOperationLifetime _operations = new();
    private IReadOnlyList<ConfigurationDefinitionSummary> _definitions = [];
    private ConfigurationDefinition? _definition;
    private ConfigurationMutationGroup? _group;
    private LogicalPath? _focusPath;
    private string? _title;
    private bool _allowRollback;
    private bool _rollbackOpening;
    private string? _loadError;
    private readonly List<ConfigurationValueHistory> _loadedRows = [];
    private readonly List<HistoryTimelineEntry> _entries = [];
    private ConfigurationHistoryPageRequest? _pagingRequest;
    private HistoryTimelineEntry? _selectedEntry;
    private ConfigurationHistoryCursor? _nextCursor;
    private bool _hasMore;
    private bool _loadingMore;

    private string DialogTitle => !string.IsNullOrWhiteSpace(_title)
        ? _title!
        : _group is not null
            ? L["History:Dialog:GroupTitle", _group.Label]
            : L["History:Dialog:Title"];



    private bool CanRollbackSelectedEntry =>
        !_operations.IsRetired && _allowRollback
        && _selectedEntry is { Rows.Count: > 0 } entry
        && (_group is null || _group.Status != ConfigurationMutationGroupStatus.RolledBack)
        && entry.Rows.All(CanRollbackRow);

    private string SelectedRollbackTooltip => !_allowRollback
        ? L["History:Actions:RollbackBlockedRetired"].Value
        : CanRollbackSelectedEntry
            ? L["Rollback:Confirm"].Value
            : L["History:Actions:RollbackBlockedMetadata"].Value;

    protected override void OnInitialized()
    {
        _definitions = Definitions.ToArray();
        _definition = Definition;
        _group = Group is null ? null : Group with { DefinitionKeys = Group.DefinitionKeys.ToArray() };
        _focusPath = FocusPath;
        _title = Title;
        _allowRollback = AllowRollback;
        _loadedRows.AddRange(InitialPage?.Items ?? Rows);
        _pagingRequest = HistoryRequest is null || InitialPage is null
            ? null
            : HistoryRequest with { };
        _nextCursor = InitialPage?.NextCursor;
        _hasMore = _pagingRequest is not null && InitialPage?.HasMore is true;
        RebuildEntries();
    }

    private void RebuildEntries()
    {
        _entries.Clear();
        var orderedRows = _loadedRows
            .OrderByDescending(row => row.ModifiedTime)
            .ThenByDescending(row => row.Version)
            .ThenByDescending(row => row.HistoryId, StringComparer.Ordinal)
            .ToArray();
        var focusedSinglePath = _group is null && _focusPath is not null;

        if (_group is not null && orderedRows.Length > 1)
        {
            _entries.Add(new HistoryTimelineEntry(
                GROUP_SUMMARY_ENTRY_ID,
                L["History:Dialog:GroupSummary"],
                L["History:Dialog:GroupSubtitle", _group.MutationCount, _group.DefinitionKeys.Count],
                _group.CreatedTime,
                orderedRows,
                ConfigurationMutationKind.Set,
                orderedRows.Max(row => row.Version),
                Color.Primary,
                MoIcons.Folder));
        }

        foreach (var displayRow in ConfigurationHistoryDisplayGrouper.Collapse(orderedRows))
        {
            _entries.Add(new HistoryTimelineEntry(
                displayRow.Id,
                TimelineTitle(displayRow, focusedSinglePath),
                TimelineSubtitle(displayRow, focusedSinglePath),
                displayRow.ModifiedTime,
                displayRow.Rows.ToArray(),
                displayRow.Representative.MutationKind,
                displayRow.Version,
                TargetColor(displayRow.Rows),
                TimelineIcon(displayRow)));
        }

        _selectedEntry = _entries.FirstOrDefault(entry => _selectedEntry?.Id == entry.Id) ?? _entries.FirstOrDefault();
    }

    private async Task LoadMoreAsync()
    {
        if (_operations.IsRetired || _loadingMore || !_hasMore || _pagingRequest is null || _nextCursor is null) return;
        var request = _pagingRequest with { Cursor = _nextCursor };
        _loadingMore = true;
        _loadError = null;
        try
        {
            await _operations.RunAsync(async token =>
            {
                try
                {
                    var result = await Facade.QueryHistoryPageAsync(request);
                    token.ThrowIfCancellationRequested();
                    _operations.TryApply(() =>
                    {
                        if (result.IsFailed(out var error, out var page)) { _loadError = error.Message; return; }
                        var ids = _loadedRows.Select(row => row.HistoryId).ToHashSet(StringComparer.OrdinalIgnoreCase);
                        _loadedRows.AddRange(page.Items.Where(row => ids.Add(row.HistoryId)));
                        _nextCursor = page.NextCursor;
                        _hasMore = page.HasMore;
                        RebuildEntries();
                    });
                }
                finally { _operations.TryApply(() => _loadingMore = false); }
            });
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
        catch (Exception exception) when (!_operations.IsRetired) { _loadError = exception.Message; }
    }

    private void SelectEntry(HistoryTimelineEntry? entry)
    {
        if (entry is not null && !_rollbackOpening) _operations.TryApply(() => _selectedEntry = entry);
    }
    private string DefinitionDisplay(string definitionKey)
    {
        if (_definition is not null && string.Equals(_definition.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))
        {
            return _definition.DisplayName;
        }

        return _definitions.FirstOrDefault(definition =>
            string.Equals(definition.DefinitionKey, definitionKey, StringComparison.OrdinalIgnoreCase))?.DisplayName ?? definitionKey;
    }

    private bool CanRollbackRow(ConfigurationValueHistory row)
    {
        if (_definition is not null
            && string.Equals(_definition.DefinitionKey, row.DefinitionKey, StringComparison.OrdinalIgnoreCase))
        {
            return _definition.SchemaVersion == row.SchemaVersion
                   && !string.IsNullOrWhiteSpace(row.SchemaHash)
                   && string.Equals(_definition.SchemaHash, row.SchemaHash, StringComparison.Ordinal);
        }

        var summary = _definitions.FirstOrDefault(definition =>
            string.Equals(definition.DefinitionKey, row.DefinitionKey, StringComparison.OrdinalIgnoreCase));
        return summary is { CanMutate: true }
               && summary.SchemaVersion == row.SchemaVersion
               && !string.IsNullOrWhiteSpace(row.SchemaHash)
               && string.Equals(summary.SchemaHash, row.SchemaHash, StringComparison.Ordinal);
    }

    private string TimelineTitle(ConfigurationValueHistory row, bool focusedSinglePath)
    {
        return focusedSinglePath ? TargetDisplay(row) : DefinitionDisplay(row.DefinitionKey);
    }

    private string TimelineTitle(ConfigurationHistoryDisplayRow row, bool focusedSinglePath)
    {
        return row.IsCollapsed
            ? row.DisplayPath.ToCanonicalString()
            : TimelineTitle(row.Representative, focusedSinglePath);
    }

    private string TimelineSubtitle(ConfigurationValueHistory row, bool focusedSinglePath)
    {
        return focusedSinglePath
            ? L["History:Dialog:TimelineFocusedSubtitle", MutationText(row.MutationKind), row.Version]
            : L["History:Dialog:TimelineRowSubtitle", row.LogicalPath.ToCanonicalString(), TargetDisplay(row)];
    }

    private string TimelineSubtitle(ConfigurationHistoryDisplayRow row, bool focusedSinglePath)
    {
        return row.IsCollapsed
            ? L["History:Dialog:CollapsedTimelineSubtitle", row.Rows.Count, TargetKindText(row.Rows)]
            : TimelineSubtitle(row.Representative, focusedSinglePath);
    }

    private string TargetDisplay(ConfigurationValueHistory row)
    {
        return row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource
            ? row.SourceDisplayName ?? L["History:Targets:External"]
            : L["History:Targets:Monica"];
    }

    private string TargetKindText(IReadOnlyList<ConfigurationValueHistory> rows)
    {
        if (rows.All(row => row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource))
        {
            return L["History:Targets:External"];
        }

        return rows.Any(row => row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)
            ? L["History:Targets:Mixed"]
            : L["History:Targets:Monica"];
    }
    private static Color TargetColor(IReadOnlyList<ConfigurationValueHistory> rows)
    {
        return rows.Any(row => row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)
            ? Color.Warning
            : Color.Primary;
    }

    private static Color TargetColor(ConfigurationValueHistory row)
    {
        return row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource
            ? Color.Warning
            : Color.Info;
    }

    private static string TargetIcon(IReadOnlyList<ConfigurationValueHistory> rows)
    {
        return rows.Any(row => row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)
            ? MoIcons.FileText
            : MoIcons.Database;
    }

    private static string TimelineIcon(ConfigurationHistoryDisplayRow row)
    {
        return row.IsCollapsed
            ? MoIcons.Workflow
            : TimelineIcon(row.Representative);
    }

    private static string TimelineIcon(ConfigurationValueHistory row)
    {
        return row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource
            ? MoIcons.FileText
            : MutationIcon(row.MutationKind);
    }

    private string ValueOrEmpty(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? L["Common:States:Empty"] : value;
    }

    private string MutationText(ConfigurationMutationKind kind) => kind == ConfigurationMutationKind.Remove ? L["Mutation:Kinds:Remove"] : L["Mutation:Kinds:Set"];
    private string FormatTime(DateTimeOffset value) => TimeDisplay.Format(value);
    private static string TargetTone(IReadOnlyList<ConfigurationValueHistory> rows) => rows.Any(row => row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource) ? "warning" : "primary";
    private static string GroupTone(ConfigurationMutationGroupStatus status) => status switch
    {
        ConfigurationMutationGroupStatus.Applied => "success",
        ConfigurationMutationGroupStatus.PartiallyApplied => "warning",
        _ => "secondary"
    };
    private string StatusText(ConfigurationMutationGroupStatus status)
    {
        return L[$"Group:StatusValues:{status}"];
    }

    private string OperatorText(ConfigurationValueHistory history)
    {
        return string.IsNullOrWhiteSpace(history.ModifierName)
            ? history.ModifierId ?? L["Common:States:Empty"]
            : history.ModifierName!;
    }

    private string ReasonText(IReadOnlyList<ConfigurationValueHistory> rows)
    {
        var reason = rows
            .Select(row => row.Reason)
            .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));
        return string.IsNullOrWhiteSpace(reason) ? L["Common:States:Empty"] : reason!;
    }

    private static string MutationIcon(ConfigurationMutationKind kind)
    {
        return kind switch
        {
            ConfigurationMutationKind.Remove => MoIcons.Delete,
            _ => MoIcons.Edit
        };
    }

    private async Task RollbackSelectedEntryAsync()
    {
        if (_operations.IsRetired || _rollbackOpening || _selectedEntry is null) return;
        if (!CanRollbackSelectedEntry)
        {
            Snackbar.Add(_allowRollback ? L["History:Actions:RollbackBlockedMetadata"] : L["History:Actions:RollbackBlockedRetired"], Severity.Warning);
            return;
        }
        var selected = _selectedEntry;
        var rows = selected.Rows.ToArray();
        var group = _group;
        var parameters = new DialogParameters<RollbackConfirmationDialog>();
        string title;
        if (group is not null && (selected.Id == GROUP_SUMMARY_ENTRY_ID || group.MutationCount == 1))
        {
            parameters.Add(dialog => dialog.Group, group);
            parameters.Add(dialog => dialog.GroupRows, rows);
            title = L["Rollback:GroupTitle"];
        }
        else if (rows.Length == 1)
        {
            parameters.Add(dialog => dialog.HistoryRow, rows[0]);
            parameters.Add(dialog => dialog.GroupRows, rows);
            title = L["Rollback:SingleTitle"];
        }
        else
        {
            parameters.Add(dialog => dialog.GroupRows, rows);
            title = L["Rollback:SelectionTitle"];
        }
        _rollbackOpening = true;
        try
        {
            await _operations.RunAsync(async _ =>
            {
                try
                {
                    var result = await _operations.ShowDialogAsync(() => DialogService.ShowAsync<RollbackConfirmationDialog>(title, parameters,
                        new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true }));
                    if (!_operations.IsRetired && result is { Canceled: false, Data: ConfigurationHistoryRollbackDialogResult rollback })
                        MudDialog.Close(DialogResult.Ok(rollback));
                }
                finally { _operations.TryApply(() => _rollbackOpening = false); }
            });
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
    }

    private void Close() { if (!_operations.IsRetired) MudDialog.Close(); }
    /// <summary>Rejects new work and drains actual page loads and nested rollback dialog results.</summary>
    public ValueTask DisposeAsync() => _operations.RetireAsync();
    private sealed record HistoryTimelineEntry(
        string Id,
        string Title,
        string Subtitle,
        DateTimeOffset Time,
        IReadOnlyList<ConfigurationValueHistory> Rows,
        ConfigurationMutationKind MutationKind,
        long Version,
        Color Color,
        string Icon);
}
