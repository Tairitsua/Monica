@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.Components.Forms
@using Monica.Configuration.UI.Localization
@inject ConfigurationParameterPackageService PackageService
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog>
    <DialogContent>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@L["Validation:FragmentNotice"]</MudAlert>
        <div class="configuration-import-dialog-content">
            <MudStack Spacing="3">
            <MudPaper Outlined="true" Class="pa-3">
                <MudStack Spacing="1">
                    <MudText Typo="Typo.subtitle2">@L["ImportExport:Import:Title"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@L["ImportExport:Import:Subtitle"]</MudText>
                </MudStack>
            </MudPaper>

            <MudFileUpload T="IBrowserFile"
                           Accept=".json,application/json"
                           FilesChanged="OnFileSelected"
                           MaximumFileCount="1">
                <CustomContent Context="upload">
                    <MudPaper Outlined="true" Class="pa-6 configuration-import-upload" @onclick="upload.OpenFilePickerAsync">
                        <MudStack AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Large" Color="Color.Primary" />
                            <MudText Typo="Typo.body2">@L["ImportExport:Import:Upload"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">.json</MudText>
                        </MudStack>
                    </MudPaper>
                </CustomContent>
            </MudFileUpload>

            @if (_loading)
            {
                <ConfigurationPackageProgressPanel Progress="@_progress" />
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }

            @if (_report is not null && _review is not null)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="6" md="3">
                        <MudChip T="int" Color="Color.Primary" Variant="Variant.Outlined">@L["ImportExport:Report:Changes", _review.Changes.Count]</MudChip>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudChip T="int" Color="Color.Error" Variant="Variant.Outlined">@L["ImportExport:Report:Issues", _review.ValidationIssues.Count]</MudChip>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudChip T="int" Color="Color.Warning" Variant="Variant.Outlined">@L["ImportExport:Report:Diagnostics", _report.AllDiagnostics.Count]</MudChip>
                    </MudItem>
                    <MudItem xs="6" md="3">
                        <MudChip T="int" Variant="Variant.Outlined">@L["ImportExport:Report:Definitions", _review.Definitions.Count]</MudChip>
                    </MudItem>
                </MudGrid>

                @if (_report.Document is not null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @L["ImportExport:Import:PackageMeta", _report.Document.ExportedAt.LocalDateTime, _report.Document.ExportedBy ?? L["Common:States:Empty"], _report.Document.SystemVersion ?? L["Common:States:Empty"]]
                    </MudText>
                }

                @if (_report.AllDiagnostics.Count > 0)
                {
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle2">@L["ImportExport:Diagnostics:Title"]</MudText>
                            @foreach (var diagnostic in _report.AllDiagnostics)
                            {
                                <MudAlert Severity="@DiagnosticSeverity(diagnostic)" Dense="true">
                                    @diagnostic.Message
                                </MudAlert>
                            }
                        </MudStack>
                    </MudPaper>
                }

                <ConfigurationPendingReviewTabs Review="_review"
                                                ActionMode="ConfigurationPendingReviewActionMode.Exclude"
                                                UndoRequested="UndoReview" />
            }
            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Common:Actions:Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.PlaylistAddCheck"
                   Disabled="@(_review?.HasItems is not true)"
                   OnClick="Apply">
            @L["Common:Actions:Apply"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const long MAX_IMPORT_BYTES = 10 * 1024 * 1024;

    private static readonly JsonSerializerOptions PackageJsonOptions = new(ConfigurationJsonDisplayFormatter.ReadableJsonOptions)
    {
        PropertyNameCaseInsensitive = true,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private ConfigurationImportReport? _report;
    private ConfigurationPendingReviewState? _review;
    private ConfigurationPackageProgress _progress = new()
    {
        Operation = ConfigurationPackageProgressOperation.Import,
        Stage = ConfigurationPackageProgressStage.ReadingPackage
    };
    private bool _loading;
    private string? _error;

    private async Task OnFileSelected(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        _loading = true;
        _error = null;
        _report = null;
        _review = null;
        ReportProgress(new ConfigurationPackageProgress
        {
            Operation = ConfigurationPackageProgressOperation.Import,
            Stage = ConfigurationPackageProgressStage.ReadingPackage
        });
        try
        {
            await using var stream = file.OpenReadStream(MAX_IMPORT_BYTES);
            var document = await JsonSerializer.DeserializeAsync<ConfigurationExportDocument>(stream, PackageJsonOptions);
            if (document is null)
            {
                _error = L["ImportExport:Import:InvalidPackage"];
                return;
            }

            var progress = new Progress<ConfigurationPackageProgress>(ReportProgress);
            _report = await PackageService.AnalyzeImportAsync(document, file.Name, progress);
            _review = new ConfigurationPendingReviewState(_report.Changes, _report.ValidationIssues);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ReportProgress(ConfigurationPackageProgress progress)
    {
        _progress = progress;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Apply()
    {
        if (_report is null || _review?.HasItems is not true)
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(_review.Filter(_report)));
    }

    private void UndoReview(ConfigurationPendingReviewUndoRequest request)
    {
        _review?.Undo(request);
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private static Severity DiagnosticSeverity(ConfigurationImportDiagnostic diagnostic)
    {
        return diagnostic.Severity switch
        {
            ConfigurationImportDiagnosticSeverity.Error => Severity.Error,
            ConfigurationImportDiagnosticSeverity.Warning => Severity.Warning,
            _ => Severity.Info
        };
    }
}
