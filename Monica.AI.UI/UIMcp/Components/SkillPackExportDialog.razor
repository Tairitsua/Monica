@using Microsoft.Extensions.Localization
@using Monica.AI.Mcp.Facades
@using Monica.AI.Mcp.Models
@using Monica.AI.UI.Localization
@using Monica.Core.Results
@inject McpFacade McpFacade
@inject ISnackbar Snackbar
@using Monica.UI.Shared.Components.Dialogs
@using Monica.AI.UI.Shared.Support
@inject IStringLocalizer<AIResource> L
@implements IAsyncDisposable

<MudDialog Style="width:calc(100vw - 24px);max-height:calc(100dvh - 24px);margin:12px" Gutters="false" TitleClass="pa-0" ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent>
        <div class="export-dialog-heading"><MoDialogHeading Text="@L["Capabilities:Mcp:ExportSkill:Title"]" /></div>
    </TitleContent>
    <DialogContent>
        <div class="export-form">
            <MudText Typo="Typo.body2">
                @L["Capabilities:Mcp:ExportSkill:Summary", ServerName, ToolCount]
            </MudText>

            <MudTextField T="string" Disabled="@_isExporting"
                          @bind-Value="@_endpoint"
                          Label="@L["Capabilities:Mcp:Dialog:Endpoint"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Required="true"
                          RequiredError="@L["Common:Validation:Required"]"
                          Error="@(!string.IsNullOrWhiteSpace(EndpointValidationMessage))"
                          ErrorText="@EndpointValidationMessage" />

            <MudTextField T="string" Disabled="@_isExporting"
                          @bind-Value="@_targetRoot"
                          Label="@L["Capabilities:Mcp:ExportSkill:TargetRoot"]"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          Required="true"
                          RequiredError="@L["Common:Validation:Required"]"
                          HelperText="@L["Capabilities:Mcp:ExportSkill:TargetRootHint"]" />
            @if (_error is not null) { <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Dense="true">@_error</MudAlert> }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="export-dialog-actions">
        <MudButton OnClick="Cancel">@L["Common:Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(!CanSubmit)"
                   aria-disabled="@((_isExporting || !CanSubmit).ToString().ToLowerInvariant())"
                   OnClick="ExportAsync">
            @if (_isExporting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            @L["Capabilities:Mcp:ExportSkill:Submit"]
        </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string ServerName { get; set; } = string.Empty;
    [Parameter] public string DefaultEndpoint { get; set; } = string.Empty;
    [Parameter] public int ToolCount { get; set; }

    private string _endpoint = string.Empty;
    private string _targetRoot = string.Empty;
    private bool _isExporting, _initialized;
    private string? _error;
    private readonly AIAdministrationOperationLifetime _lifetime = new();

    private string? EndpointValidationMessage
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_endpoint))
            {
                return null;
            }

            return Uri.TryCreate(_endpoint.Trim(), UriKind.Absolute, out var uri)
                   && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps)
                ? null
                : L["Capabilities:Mcp:Dialog:EndpointInvalid"].Value;
        }
    }

    private bool CanSubmit
        => !string.IsNullOrWhiteSpace(_endpoint)
           && !string.IsNullOrWhiteSpace(_targetRoot)
           && string.IsNullOrWhiteSpace(EndpointValidationMessage);

    protected override void OnParametersSet()
    {
        if (_initialized) return;
        _initialized = true;
        if (string.IsNullOrEmpty(_endpoint))
        {
            _endpoint = DefaultEndpoint;
        }

        if (string.IsNullOrEmpty(_targetRoot))
        {
            var userProfile = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);
            _targetRoot = Path.Combine(userProfile, ".agents", "skills");
        }
    }

    private Task ExportAsync() => _lifetime.RunAsync(async cancellationToken =>
    {
        if (!CanSubmit || _isExporting || _lifetime.IsRetired) return;
        var server = ServerName;
        var endpoint = _endpoint.Trim();
        var targetRoot = _targetRoot.Trim();
        _isExporting = true; _error = null;
        try
        {
            // File writes are synchronous; drain the actual host operation even when retirement cancels its UI owner.
            var result = await Task.Run(() => McpFacade.ExportSkillPack(server, endpoint, targetRoot), cancellationToken);
            if (_lifetime.IsRetired || cancellationToken.IsCancellationRequested) return;
            var error = result.WithoutData();
            var export = result.Data;
            if (result.IsFailure() || export is null)
            {
                _error = string.IsNullOrWhiteSpace(error.Message) ? L["Error:Generic"] : error.Message;
                return;
            }
            Snackbar.Add(L["Capabilities:Mcp:ExportSkill:Success", export.SkillDirectoryPath, export.Pack.ToolCount], Severity.Success);
            MudDialog.Close(DialogResult.Ok(export));
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception) { if (!_lifetime.IsRetired) _error = L["Error:Generic"]; }
        finally { if (!_lifetime.IsRetired) _isExporting = false; }
    });

    /// <summary>Cancels pending admission and drains host filesystem export before releasing the dialog.</summary>
    public ValueTask DisposeAsync() => _lifetime.RetireAsync();

    private async Task Cancel()
    {
        var retirement = DisposeAsync();
        MudDialog.Cancel();
        await retirement;
    }
}
