@using Monica.EventBus.Models
@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.Support
@using Monica.UI.Shared.Components.Dialogs
@using Monica.UI.Shared.Components.Navigation
@using Monica.UI.Shared.Components.States
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@inject Microsoft.Extensions.Hosting.IHostEnvironment Host

@{
    var capture = State.Snapshot;
    var showInspection = capture is not null && Inspection is not null;
    var tone = State.RefreshError is not null ? capture is null ? "error" : "warning"
        : IsEmpty ? "neutral" : capture is null || State.AutoRefresh ? "info" : "neutral";
}
<PageTitle>@Title</PageTitle>
<CascadingValue Value="this">
    <div class="eb-page mo-page-shell mo-page-shell--workbench" aria-busy="@(State.IsRefreshing ? "true" : "false")">
        <MoPageMasthead Icon="@SectionIcon(View)" Title="@Title" Crumb="@L["Precision:Eyebrow"]">
            <Meta>
                <span class="status is-pill mo-vl-role--@tone"><span class="status-dot @(State.AutoRefresh && State.RefreshError is null && capture is not null && !IsEmpty ? "is-live" : null)" aria-hidden="true"></span>
                    @L[State.RefreshError is not null ? capture is null ? "Precision:FailedStatus" : "Precision:StaleStatus"
                        : capture is null ? "Precision:LoadingStatus" : IsEmpty ? "Precision:EmptyStatus" : State.AutoRefresh ? "Precision:Live" : "Precision:Paused"]
                </span>
                <MoCopyButton Value="@Host.ApplicationName" Label="@L["Precision:CopyField", Host.ApplicationName]">
                    <MoIcon Icon="@MoIcons.Server" Size="13px" /><span>@L["Precision:ScopeChip", Host.ApplicationName]</span>
                </MoCopyButton>
                <span class="chip is-outline" title="@UiTime.TimeZone.Id"><span>@L["Precision:TzChip", UiTime.FormatZoneLabel(capture?.CapturedAt ?? DateTimeOffset.UtcNow)]</span></span>
            </Meta>
            <Actions>
                <div class="eb-capture-time">
                    <span>@L["Precision:Captured"]</span>
                    @if (capture is not null)
                    {
                        <time datetime="@capture.CapturedAt.ToString("O")" title="@UiTime.Format(capture.CapturedAt)">@UiTime.FormatTime(capture.CapturedAt)</time>
                    }
                    else { <b>@L["Precision:NotCaptured"]</b> }
                </div>
                <button type="button" class="btn btn-outline eb-auto" role="switch" aria-checked="@(State.AutoRefresh ? "true" : "false")"
                        @onclick="() => AutoRefreshChanged(!State.AutoRefresh)">
                    <span class="status-dot mo-vl-role--@tone" aria-hidden="true"></span>@L[State.RefreshError is not null ? "Precision:AutoFailing" : State.AutoRefresh ? "Precision:AutoOn" : "Precision:AutoOff"]
                </button>
                <button type="button" class="btn btn-primary" @onclick="RefreshAsync" disabled="@(State.IsRefreshing || _retired)">
                    <MoIcon Class="i" Icon="@MoIcons.Refresh" Size="15px" />@L["Precision:Refresh"]
                </button>
            </Actions>
        </MoPageMasthead>

        <MoWorkbenchNavigation Compact="true" Class="eb-wbn" Label="@L["Precision:NavLabel"]">
            @foreach (var section in Enum.GetValues<EventBusWorkbenchView>())
            {
                var (count, role) = NavigationCount(section);
                <a href="@Route(section)" class="eb-wbn-link" aria-current="@(View == section ? "page" : null)">
                    <MoIcon Icon="@SectionIcon(section)" Size="15px" /><span>@SectionTitle(section)</span>
                    @if (count is not null) { <span class="eb-wbn-count mo-vl-role--@role">@count</span> }
                </a>
            }
        </MoWorkbenchNavigation>

        @if (capture is null || IsEmpty && View is not (EventBusWorkbenchView.Changes or EventBusWorkbenchView.TestTools))
        {
            <section class="surface eb-state-panel">
                <MoContentState Loading="@(capture is null && State.RefreshError is null)" role="@(State.RefreshError is not null ? "alert" : "status")">
                    <span class="tile mo-vl-role--@(State.RefreshError is not null ? "error" : IsEmpty ? "neutral" : "info")">
                        <MoIcon Icon="@(State.RefreshError is not null ? MoIcons.Error : IsEmpty ? MoIcons.Network : MoIcons.Refresh)" Size="18px" />
                    </span>
                    <h2>@L[State.RefreshError is not null ? "Precision:LoadFailedTitle" : IsEmpty ? "Precision:EmptyHostTitle" : "Precision:LoadingTitle"]</h2>
                    <p>@L[State.RefreshError is not null ? "Precision:LoadFailedBody" : IsEmpty ? "Precision:EmptyHostBody" : "Precision:LoadingBody"]</p>
                    @if (State.RefreshError is { } failure) { <p class="mono eb-state-err">@failure</p> }
                    @if (IsEmpty || State.RefreshError is not null)
                    {
                        <button type="button" class="btn btn-outline" @onclick="RefreshAsync"><MoIcon Icon="@MoIcons.Refresh" Size="15px" />@L["Precision:Retry"]</button>
                    }
                </MoContentState>
            </section>
        }
        else
        {
            @if (State.RefreshError is { } latestFailure)
            {
                <div class="callout mo-vl-role--warning" role="status"><span class="tile"><MoIcon Icon="@MoIcons.Warning" Size="16px" /></span>
                    <div><b>@L["Precision:StaleTitle"]</b><p>@L["Precision:StaleBody", UiTime.Format(capture.CapturedAt)] <span class="eb-err-inline mono">@latestFailure</span></p></div>
                </div>
            }
            @switch (View)
            {
                case EventBusWorkbenchView.Overview: <EventBusOverview /> break;
                case EventBusWorkbenchView.Providers: <EventBusProviderList /> break;
                case EventBusWorkbenchView.Subscriptions: <EventBusRegistry /> break;
                case EventBusWorkbenchView.Changes: <EventBusChangesLedger /> break;
                case EventBusWorkbenchView.TestTools: <EventBusTestPanel /> break;
            }
        }
    </div>
    <MoSideSheet Open="@showInspection" OpenChanged="OnInspectionVisibilityChanged" Width="520px" Compact="true" CloseLabel="@L["Precision:InspClose"]">
        <TitleContent>
            @if (showInspection)
            {
                <div class="eb-overlay">
                    <CascadingValue Value="this"><EventBusInspectionHeading /></CascadingValue>
                </div>
            }
        </TitleContent>
        <HeaderContent>
            @if (showInspection && Inspection is { } selection && InspectionTime is { } frozen)
            {
                <div class="eb-overlay">
                    <div class="eb-sheet-stamp"><MoIcon Icon="@MoIcons.Lock" Size="14px" />
                        @L[selection.Key == "changeId" ? "Precision:InspFrozenChange" : "Precision:InspFrozen", UiTime.Format(frozen)]
                    </div>
                </div>
            }
        </HeaderContent>
        <ChildContent>
            @if (showInspection)
            {
                <div class="eb-overlay">
                    <CascadingValue Value="this"><EventBusInspector @key="Inspection" /></CascadingValue>
                </div>
            }
        </ChildContent>
    </MoSideSheet>
</CascadingValue>
