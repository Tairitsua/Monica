@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Executions.State
@using Monica.JobScheduler.UI.UIJobScheduler.Executions.Support

@inject JobExecutionsStateFactory PageStateFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation
@inject NavigationManager Navigation

@implements IAsyncDisposable

@if (_routeError)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@L["Executions:Filters:InvalidRange"]</MudAlert>
    <MudButton Variant="Variant.Outlined" OnClick="ResetAsync">@L["Catalog:Actions:Reset"]</MudButton>
}
else if (_state is { } state)
{
    <div class="execution-ledger-content">
        @if (state.Error is not null)
        {
            <MudAlert Severity="@(state.HasLoadedSnapshot ? Severity.Warning : Severity.Error)" Variant="Variant.Outlined" Dense="true" Icon="@(state.HasLoadedSnapshot ? MoIcons.Warning : MoIcons.Error)">
                @(state.HasLoadedSnapshot ? L["Executions:RefreshFailed", state.Error] : state.Error)
            </MudAlert>
        }
        <SchedulerAccessBoundary AccessChecked="@state.AccessChecked" IsAuthorized="@state.IsAuthorized">
            <SchedulerSnapshotActions CapturedAtUtc="@state.ObservedAtUtc" IsLoading="@(state.IsLoading || state.IsMutating)" RefreshRequested="RefreshAsync" />
            @if (state.HasLoadedSnapshot && state.LoadedQuery is { } acceptedQuery && state.ObservedAtUtc is { } acceptedAt)
            {
                <SchedulerLedgerTrajectory Query="@acceptedQuery" ObservedAtUtc="@acceptedAt" StateSelected="SelectTrajectoryStateAsync" AllStatesSelected="@(() => SelectStatesAsync([]))" FilterContent="@LedgerFilters" />
            }
            <ExecutionOperationalTable @ref="_table" ServerData="@state.LoadTableAsync"
                                       TotalCount="@state.TotalCount" HasLoadedSnapshot="@state.HasLoadedSnapshot"
                                       IsQueryFailed="@state.IsQueryFailed" ObservedAtUtc="@state.ObservedAtUtc"
                                       PageSize="@state.PageSize" PageSizeOptions="@state.PageSizeOptions"
                                       IsLoading="@state.IsLoading"
                                       InspectRequested="InspectAsync" RequestCancellation="RequestCancellationAsync">

            </ExecutionOperationalTable>
        </SchedulerAccessBoundary>
    </div>
}

@code {
    /// <summary>Gets or sets the initial comma-separated state filter for this immutable route owner.</summary>
    [Parameter]
    public string? InitialStates { get; set; }

    /// <summary>Gets or sets the exact initial inspector ID; the ledger uses it as a substring search.</summary>
    [Parameter]
    public string? InitialInstanceId { get; set; }

    /// <summary>Gets the exact owner selected by the entry route.</summary>
    [Parameter] public string? InitialOwner { get; set; }
    /// <summary>Gets the exact job selected by the entry route.</summary>
    [Parameter] public string? InitialJob { get; set; }
    /// <summary>Gets the exact inclusive creation bound, preserving ISO fractional precision and offsets.</summary>
    [Parameter] public string? InitialFrom { get; set; }
    /// <summary>Gets the exact exclusive creation bound, preserving ISO fractional precision and offsets.</summary>
    [Parameter] public string? InitialTo { get; set; }
    /// <summary>Gets the initial route-held identifier search.</summary>
    [Parameter] public string? InitialSearch { get; set; }
    /// <summary>Gets the initial route-held rolling preset.</summary>
    [Parameter] public string? InitialRange { get; set; }
    /// <summary>Gets the requested creation or completion interval basis.</summary>
    [Parameter] public string? InitialTime { get; set; }

    private (string?,string?,string?,string?,string?,string?,string?,string?,string?)? _routeParameters;
    private (string?,string?,string?,string?,string?,string?,string?,string?,string?) RouteParameters => (InitialStates,InitialInstanceId,InitialOwner,InitialJob,InitialFrom,InitialTo,InitialSearch,InitialRange,InitialTime);
    private static readonly ExecutionTimeRange[] Presets=[ExecutionTimeRange.LastHour,ExecutionTimeRange.Last24Hours,ExecutionTimeRange.Last7Days,ExecutionTimeRange.Last30Days,ExecutionTimeRange.All];
    private string RangeKey(ExecutionTimeRange range) => range switch { ExecutionTimeRange.LastHour => "1h",ExecutionTimeRange.Last24Hours => "24h",ExecutionTimeRange.Last7Days => "7d",ExecutionTimeRange.Last30Days => "30d",_ => "all" };
    private Task SetRangeAsync(ExecutionTimeRange range) { if(_state is {} state) state.TimeRange=range;return ApplyAsync(); }
    private void SetTime(string basis) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("time",basis=="created" ? null : basis));
    private Task SearchAsync(string value) { if(_state is {} state) state.SearchText=value;return ApplyAsync(); }
    private RenderFragment LedgerFilters => @<div class="ledger-filter-band">
        <div class="ledger-filter-seg" role="group" aria-label="@L["Workspace:TimeBasis"]"><button type="button" aria-pressed="@((InitialTime != "completed").ToString().ToLowerInvariant())" @onclick='@(() => SetTime("created"))'>@L["Workspace:RecordedTime"]</button><button type="button" aria-pressed="@((InitialTime == "completed").ToString().ToLowerInvariant())" @onclick='@(() => SetTime("completed"))'>@L["Workspace:CompletedTime"]</button></div>
        <div class="ledger-filter-seg" role="group" aria-label="@L["Executions:Filters:TimeRange"]">@foreach(var range in Presets) { <button type="button" aria-pressed="@((_state?.TimeRange==range).ToString().ToLowerInvariant())" @onclick="@(() => SetRangeAsync(range))">@L[$"Workspace:LedgerRanges:{RangeKey(range)}"]</button> }</div>
        <div class="ledger-filter-search"><MudTextField T="string" Value="@_state?.SearchText" Placeholder="@L["Executions:Filters:SearchPlaceholder"]" aria-label="@L["Executions:Filters:Search"]" Immediate="true" DebounceInterval="350" OnDebounceIntervalElapsed="SearchAsync" Clearable="true" ClearIcon="@MoIcons.Close" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" Variant="Variant.Outlined" Margin="Margin.Dense" /></div>
        @if(InitialOwner is not null || InitialJob is not null || _state?.TimeRange==ExecutionTimeRange.Exact || !string.IsNullOrEmpty(_state?.SearchText)) { <div class="ledger-filter-context"><span>@InitialOwner @InitialJob</span>@if(_state?.LoadedQuery is {} query && (query.CompletedAfterUtc ?? query.CreatedAfterUtc) is {} start && (query.CompletedBeforeUtc ?? query.CreatedBeforeUtc) is {} end) { <time>@TimePresentation.FormatRange(start,end)</time> }<button type="button" @onclick="ResetAsync">@L["Executions:Actions:Reset"] <MoIcon Icon="@MoIcons.Close" Size="12px"/></button></div> }
    </div>;
    private readonly SchedulerOperationLifetime _lifetime = new();
    private readonly object _retirementGate = new();
    private TaskCompletionSource? _retirement;
    private JobExecutionsPageState? _state;
    private ExecutionOperationalTable? _table;
    private ExecutionDialogSession? _inspectors;
    private SchedulerDialogSession<CancellationRequest>? _confirmations;
    private bool _initialInspectorOpened;
    private bool _routeError;

    protected override async Task OnInitializedAsync()
    {
        _inspectors = new(id => ExecutionDetailDialogLauncher.OpenAsync(DialogService, L, id), RefreshAsync);
        _confirmations = new(OpenConfirmationAsync, CompleteCancellationAsync);
        var state = PageStateFactory.CreatePageState();
        _state = state;
        _routeParameters=RouteParameters;
        state.StateChanged += OnStateChangedAsync;
        if (!TryParseBound(InitialFrom, out var from) || !TryParseBound(InitialTo, out var to)
            || to == DateTimeOffset.MinValue || (from.HasValue && to.HasValue && to <= from))
        {
            _routeError = true;
            return;
        }
        _routeParameters=RouteParameters;
        state.ApplyInitialQuery(InitialStates, InitialInstanceId, InitialOwner, InitialJob, from, to, InitialSearch, InitialRange, InitialTime == "completed");
        try { await _lifetime.RunAsync(_ => state.InitializeAsync()); }
        catch (OperationCanceledException) when (_lifetime.IsRetired) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if(_routeParameters == RouteParameters || _state is not {} state || _lifetime.IsRetired) return;
        _routeParameters=RouteParameters;
        if(!TryParseBound(InitialFrom,out var from) || !TryParseBound(InitialTo,out var to) || to==DateTimeOffset.MinValue || (from.HasValue && to.HasValue && to<=from)) { _routeError=true;return; }
        _routeError=false;
        state.ApplyInitialQuery(InitialStates,InitialInstanceId,InitialOwner,InitialJob,from,to,InitialSearch,InitialRange,InitialTime=="completed");
        _initialInspectorOpened=false;
        if(_table is not null) await _table.ReloadFromFirstPageAsync();
        else await state.InitializeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_initialInspectorOpened || _lifetime.IsRetired || _state is not { AccessChecked: true, IsAuthorized: true, IsLoading: false }
            || string.IsNullOrWhiteSpace(InitialInstanceId)) return;
        _initialInspectorOpened = true;
        await InspectIdAsync(InitialInstanceId);
    }

    private Task OnStateChangedAsync() => _lifetime.IsRetired ? Task.CompletedTask : InvokeAsync(() =>
    {
        if (!_lifetime.IsRetired) StateHasChanged();
    });



    private static bool TryParseBound(string? value, out DateTimeOffset? bound)
    {
        bound = null;
        if (value is null) return true;
        if (long.TryParse(value, System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var milliseconds))
        {
            try { bound = DateTimeOffset.FromUnixTimeMilliseconds(milliseconds); return true; }
            catch (ArgumentOutOfRangeException) { return false; }
        }
        if (!DateTimeOffset.TryParse(value, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var parsed)) return false;
        bound = parsed;
        return true;
    }

    private string FormatAcceptedQuery(JobExecutionQuery query)
    {
        var states = query.States is { Count: > 0 }
            ? string.Join(", ", query.States.Select(state => L[$"ExecutionStates:{state}"].Value))
            : L["Executions:Filters:AnyState"].Value;
        return L["Executions:QueryDescription", states, query.SearchText ?? L["Executions:AnyIdentifier"].Value,
            (query.CompletedAfterUtc ?? query.CreatedAfterUtc) is { } start ? TimePresentation.FormatTimestamp(start) : "—",
            (query.CompletedBeforeUtc ?? query.CreatedBeforeUtc) is { } end ? TimePresentation.FormatTimestamp(end) : "—",
            query.PageNumber].Value;
    }

    private async Task SelectStatesAsync(IReadOnlyCollection<JobExecutionState> states)
    {
        if (_lifetime.IsRetired) return;
        _state?.SetSelectedStates(states);
        await ApplyAsync();
    }

    private Task SelectTrajectoryStateAsync(JobExecutionState state)
    {
        var states=_state?.SelectedStates.ToHashSet() ?? [];
        if(!states.Add(state)) states.Remove(state);
        return SelectStatesAsync(states.ToArray());
    }

    private Task ApplyAsync()
    {
        if (_table is null || _lifetime.IsRetired || _state is not { } state || state.HasInvalidCustomRange) return Task.CompletedTask;
        string? from = state.TimeRange == ExecutionTimeRange.Exact ? InitialFrom : null;
        string? to = state.TimeRange == ExecutionTimeRange.Exact ? InitialTo : null;
        if (state.TimeRange == ExecutionTimeRange.Custom)
        {
            from = state.CustomStartDate is { } start ? TimePresentation.GetStartOfSchedulerCalendarDayUtc(start).ToString("O") : null;
            to = state.CustomEndDate is { } end ? TimePresentation.GetStartOfSchedulerCalendarDayUtc(end.AddDays(1)).ToString("O") : null;
        }
        var range = state.TimeRange switch { ExecutionTimeRange.LastHour => "1h", ExecutionTimeRange.Last24Hours => "24h", ExecutionTimeRange.Last7Days => "7d", ExecutionTimeRange.Last30Days => "30d", _ => null };
        var url = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrEmpty(state.SearchText) ? null : state.SearchText,
            ["states"] = state.SelectedStates.Count == 0 ? null : string.Join(',', state.SelectedStates),
            ["range"] = range, ["from"] = from, ["to"] = to, ["instanceId"] = null
        });
        if (url == Navigation.Uri) return _table.ReloadFromFirstPageAsync();
        Navigation.NavigateTo(url);
        return Task.CompletedTask;
    }

    private async Task ResetAsync()
    {
        if (_lifetime.IsRetired) return;
        if (Navigation.ToAbsoluteUri(Navigation.Uri).Query.Length > 0) { Navigation.NavigateTo(JobExecutionsPage.PAGE_URL); return; }
        _state?.ResetFilters();
        await ApplyAsync();
    }

    private Task RefreshAsync() => _table is null || _lifetime.IsRetired ? Task.CompletedTask : _table.ReloadAsync();
    private Task InspectAsync(JobExecutionInstance execution) => InspectIdAsync(execution.InstanceId);

    private async Task InspectIdAsync(string exactId)
    {
        if (_inspectors is null || _lifetime.IsRetired) return;
        try { await _inspectors.OpenAsync(exactId); }
        catch (OperationCanceledException) when (_lifetime.IsRetired) { }
    }

    private async Task RequestCancellationAsync(JobExecutionInstance execution)
    {
        var state = _state;
        // Freeze the clicked identity before authorization or native confirmation can yield.
        var exactId = execution.InstanceId;
        if (state is null || _confirmations is null || _lifetime.IsRetired) return;
        try
        {
            if (!await state.ReauthorizeAsync() || _lifetime.IsRetired || _state != state) return;
            await _confirmations.OpenAsync(new(state, exactId));
        }
        catch (OperationCanceledException) when (_lifetime.IsRetired || state.IsDisposed) { }
    }

    private Task<IDialogReference> OpenConfirmationAsync(CancellationRequest request)
    {
        var parameters = new DialogParameters<MudMessageBox>
        {
            { box => box.Title, L["Executions:Cancel:Title"].Value },
            { box => box.MessageContent, (RenderFragment)(builder =>
                {
                    builder.OpenComponent<ExecutionCancellationMessage>(0);
                    builder.AddAttribute(1, nameof(ExecutionCancellationMessage.Message), L["Executions:Cancel:Message", request.InstanceId].Value);
                    builder.CloseComponent();
                }) },
            { box => box.YesText, L["Executions:Actions:Cancel"].Value },
            { box => box.CancelText, L["Common:Keep"].Value }
        };
        return DialogService.ShowAsync<MudMessageBox>(null, parameters,
            new DialogOptions { CloseButton = true, CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small });
    }

    private async Task CompleteCancellationAsync(CancellationRequest request, DialogResult? confirmation)
    {
        if (_lifetime.IsRetired || _state != request.State || confirmation is not { Canceled: false, Data: true }) return;
        try
        {
            var result = await request.State.RequestCancellationAsync(request.InstanceId);
            if (_lifetime.IsRetired || _state != request.State) return;
            var feedback = ExecutionUiPresentation.GetCancellationFeedback(result, L);
            Snackbar.Add(feedback.Message, feedback.Severity);
            await RefreshAsync();
        }
        catch (OperationCanceledException) when (_lifetime.IsRetired || request.State.IsDisposed) { }
    }

    /// <inheritdoc />
    public ValueTask DisposeAsync()
    {
        TaskCompletionSource completion;
        lock (_retirementGate)
        {
            if (_retirement is not null) return new(_retirement.Task);
            completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
            _retirement = completion;
        }
        var state = _state;
        if (state is not null) state.StateChanged -= OnStateChangedAsync;
        // Start every owner before joining to avoid a dialog callback waiting on an uncanceled state read.
        var operations = _lifetime.RetireAsync(() => ValueTask.CompletedTask);
        var inspectors = _inspectors?.DisposeAsync() ?? ValueTask.CompletedTask;
        var confirmations = _confirmations?.DisposeAsync() ?? ValueTask.CompletedTask;
        var stateRetirement = state?.DisposeAsync() ?? ValueTask.CompletedTask;
        _ = CompleteRetirementAsync([operations, inspectors, confirmations, stateRetirement], completion);
        return new(completion.Task);
    }

    private static async Task CompleteRetirementAsync(ValueTask[] owners, TaskCompletionSource completion)
    {
        var failures = new List<Exception>();
        foreach (var owner in owners)
        {
            try { await owner; } catch (Exception exception) { failures.Add(exception); }
        }
        if (failures.Count == 0) completion.TrySetResult();
        else completion.TrySetException(new AggregateException("Execution ledger retirement failed.", failures));
    }

    private sealed record CancellationRequest(JobExecutionsPageState State, string InstanceId);
}
