@using Monica.Profiling.UIRuntimeMetrics.Support
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using System.Globalization
@using System.Runtime
@using Monica.Profiling.MemoryDiagnostics.Models
@using Monica.Profiling.UIMemoryAnalysis.Support
@inject IStringLocalizer<MemoryAnalysisResource> L

<section class="memory-overview" aria-label="@L["Overview:MetricsAriaLabel"]" aria-busy="@(IsLoading && Snapshot is null)">
    <div class="memory-lens">
        <div class="memory-lens__sources">
            <article class="memory-lens__immediate">
                <header class="memory-lens__source">
                    <span>@L["Overview:Sources:Immediate"]</span>
                    <MoIcon Icon="@MoIcons.Cpu" Size="1.25rem" aria-hidden="true" />
                </header>
                <div class="memory-lens__primary" data-memory-fact="working-set">
                    <h2>@L["Overview:WorkingSet"]</h2>
                    <strong>@MemoryAnalysisDisplayFormatter.Bytes(Snapshot?.WorkingSetBytes)</strong>
                </div>
                <div class="memory-lens__secondary" data-memory-fact="managed-memory">
                    <span>@L["Overview:ManagedMemory"]</span>
                    <strong>@MemoryAnalysisDisplayFormatter.Bytes(Snapshot?.TotalManagedMemory)</strong>
                </div>
                <p>@L["Overview:Sources:ImmediateHelp"]</p>
            </article>
            <article class="memory-lens__last-gc">
                <header class="memory-lens__source">
                    <span>@L["Overview:Sources:LastGc"]</span>
                    <MoIcon Icon="@MoIcons.Layers" Size="1.25rem" aria-hidden="true" />
                </header>
                <div class="memory-lens__primary" data-memory-fact="gc-heap">
                    <h2>@L["Overview:ManagedHeap"]</h2>
                    <strong>@MemoryAnalysisDisplayFormatter.Bytes(Snapshot?.GcHeapSizeBytes)</strong>
                </div>
                <div class="memory-lens__secondary" data-memory-fact="committed">
                    <span>@L["Overview:Committed"]</span>
                    <strong>@MemoryAnalysisDisplayFormatter.Bytes(Snapshot?.CommittedBytes)</strong>
                </div>
                <p>@L["Overview:Sources:LastGcHelp"]</p>
            </article>
        </div>
        <footer class="memory-lens__context">
            <p>@L["Overview:Sources:Independent"]</p>
            <div class="memory-lens__read-times">
                <div>
                    <span>@L["Overview:Snapshot:CapturedAt"]</span>
                    @if (Snapshot is not null)
                    {
                        <time data-field="SnapshotTimestamp" datetime="@MemoryAnalysisDisplayFormatter.MachineTime(Snapshot.Timestamp)"
                              title="@MemoryAnalysisDisplayFormatter.MachineTime(Snapshot.Timestamp)">@UiTime.Format(RuntimeMetricsDisplayFormatter.AsUtc(Snapshot.Timestamp))</time>
                    }
                    else
                    {
                        <span>@(IsLoading ? L["Common:LoadingValue"] : L["Common:Unavailable"])</span>
                    }
                </div>
                @if (CapturedAt is { } capturedAt)
                {
                    <div><span>@L["Overview:Snapshot:ViewRead"]</span>
                        <time data-field="CapturedAt" datetime="@capturedAt.ToString("O")">@UiTime.Format(capturedAt)</time>
                    </div>
                }
            </div>
        </footer>
    </div>

    <div class="memory-overview__support">
        <article class="memory-collections">
            <header class="memory-overview__section-heading">
                <span>@L["Overview:Collections:Eyebrow"]</span>
                <h2>@L["Overview:Collections:Title"]</h2>
            </header>
            <dl class="memory-collections__values">
                <div data-memory-fact="gen0-collections"><dt>@L["Common:Generation", 0]</dt><dd>@MemoryAnalysisDisplayFormatter.Count(Snapshot?.Gen0Collections)</dd></div>
                <div data-memory-fact="gen1-collections"><dt>@L["Common:Generation", 1]</dt><dd>@MemoryAnalysisDisplayFormatter.Count(Snapshot?.Gen1Collections)</dd></div>
                <div data-memory-fact="gen2-collections"><dt>@L["Common:Generation", 2]</dt><dd>@MemoryAnalysisDisplayFormatter.Count(Snapshot?.Gen2Collections)</dd></div>
            </dl>
            <p>@L["Overview:Collections:Help"]</p>
        </article>
        <article class="memory-configuration">
            <header class="memory-overview__section-heading">
                <span>@L["Overview:Configuration:Eyebrow"]</span>
                <h2>@L["Overview:Configuration:Title"]</h2>
            </header>
            <dl class="memory-configuration__values">
                <div><dt>@L["Overview:Configuration:GcType"]</dt>
                    <dd data-memory-fact="gc-mode">@(Snapshot is null ? L["Common:Unavailable"] : Snapshot.IsServerGC ? L["Overview:Configuration:ServerGc"] : L["Overview:Configuration:WorkstationGc"])</dd>
                </div>
                <div><dt>@L["Overview:Configuration:LatencyMode"]</dt><dd data-memory-fact="latency-mode">@LatencyMode</dd></div>
                <div><dt>@L["Overview:Snapshot:MaxGeneration"]</dt><dd>@GC.MaxGeneration.ToString(CultureInfo.CurrentCulture)</dd></div>
            </dl>
        </article>
    </div>

    @if (Snapshot is not null)
    {
        <details class="memory-overview__raw">
            <summary>@L["Overview:Raw:Title"]</summary>
            <dl>
                <div><dt>@L["Overview:WorkingSet"] <small>@L["Common:RawBytes"]</small></dt><dd data-raw-field="WorkingSetBytes">@MemoryAnalysisDisplayFormatter.Raw(Snapshot.WorkingSetBytes)</dd></div>
                <div><dt>@L["Overview:ManagedMemory"] <small>@L["Common:RawBytes"]</small></dt><dd data-raw-field="TotalManagedMemory">@MemoryAnalysisDisplayFormatter.Raw(Snapshot.TotalManagedMemory)</dd></div>
                <div><dt>@L["Overview:ManagedHeap"] <small>@L["Common:RawBytes"]</small></dt><dd data-raw-field="GcHeapSizeBytes">@MemoryAnalysisDisplayFormatter.Raw(Snapshot.GcHeapSizeBytes)</dd></div>
                <div><dt>@L["Overview:Committed"] <small>@L["Common:RawBytes"]</small></dt><dd data-raw-field="CommittedBytes">@MemoryAnalysisDisplayFormatter.Raw(Snapshot.CommittedBytes)</dd></div>
                <div><dt>@L["Overview:Snapshot:CapturedAt"]</dt><dd><time datetime="@MemoryAnalysisDisplayFormatter.MachineTime(Snapshot.Timestamp)">@UiTime.Format(RuntimeMetricsDisplayFormatter.AsUtc(Snapshot.Timestamp))</time></dd></div>
            </dl>
        </details>
    }
</section>

@code {
    /// <summary>Gets or sets the process memory read and its independently GC-reported heap context.</summary>
    [Parameter] public MemorySnapshot? Snapshot { get; set; }

    /// <summary>Gets or sets whether a read is in progress. Captured evidence remains visible.</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>Gets or sets the successful view read time; this is different from the snapshot timestamp.</summary>
    [Parameter] public DateTimeOffset? CapturedAt { get; set; }

    private string LatencyMode => Snapshot is null ? L["Common:Unavailable"] : Snapshot.LatencyMode switch
    {
        GCLatencyMode.Batch => L["Overview:Configuration:LatencyModes:Batch"],
        GCLatencyMode.Interactive => L["Overview:Configuration:LatencyModes:Interactive"],
        GCLatencyMode.LowLatency => L["Overview:Configuration:LatencyModes:LowLatency"],
        GCLatencyMode.SustainedLowLatency => L["Overview:Configuration:LatencyModes:SustainedLowLatency"],
        GCLatencyMode.NoGCRegion => L["Overview:Configuration:LatencyModes:NoGCRegion"],
        _ => L["Common:Unknown"]
    };
}
