@attribute [Route(PAGE_URL)]

@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.UIJobScheduler.Components
@using Monica.JobScheduler.UI.UIJobScheduler.State
@using Monica.JobScheduler.UI.UIJobScheduler.Support

@inject SchedulerRuntimePageStateFactory PageStateFactory
@inject IOptions<ModuleJobSchedulerUIOption> UiOptions
@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation

@implements IAsyncDisposable

<PageTitle>@L["Runtime:PageTitle"]</PageTitle>

<SchedulerWorkspace Title="@L["Workspace:Pages:Runtime:Title"]"
                    Description="@L["Workspace:Pages:Runtime:Description"]"
                    ActivePanelIndex="4">
    @if (_state is { } state)
    {
        <div class="runtime-page">
            @if (state.IsQueryFailed)
            {
                <MudAlert Severity="@(state.HasLoadedSnapshot ? Severity.Warning : Severity.Error)" Variant="Variant.Outlined" Dense="true" Icon="@(state.HasLoadedSnapshot ? MoIcons.Warning : MoIcons.Error)">
                    @(state.HasLoadedSnapshot ? L["Runtime:RefreshFailed", state.Error ?? L["Runtime:Observation:NoDiagnostic"]] : state.Error ?? L["Runtime:Observation:UnavailableDescription"])
                </MudAlert>
            }
            @if (!state.AccessChecked && state.IsQueryFailed && !state.IsLoading)
            {
                <div class="runtime-page__unavailable" role="status">
                    <MoIcon Icon="@MoIcons.Server" aria-hidden="true" Size="1.5rem" />
                    <h2>@L["Runtime:Observation:Unavailable"]</h2>
                    <p>@L["Runtime:Observation:UnavailableDescription"]</p>
                    <MudButton Variant="Variant.Outlined" OnClick="RefreshAsync">@L["Common:Retry"]</MudButton>
                </div>
            }
            else
            {
                <SchedulerAccessBoundary AccessChecked="@state.AccessChecked" IsAuthorized="@state.IsAuthorized">
                    <section class="runtime-observation" aria-label="@L["Runtime:Observation:Title"]" aria-busy="@(state.IsLoading ? "true" : "false")">
                        <dl>
                            <div>
                                <dt>@L["Runtime:Observation:Captured"]</dt>
                                <dd><time datetime="@state.Overview?.CapturedAtUtc.ToString("O")">@TimePresentation.FormatTimestamp(state.Overview?.CapturedAtUtc)</time></dd>
                            </div>
                            <div>
                                <dt>@L["Runtime:Observation:Accepted"]</dt>
                                <dd><time datetime="@state.LastRefreshedUtc?.ToString("O")">@TimePresentation.FormatTimestamp(state.LastRefreshedUtc)</time></dd>
                            </div>
                            <div>
                                <dt>@L["Runtime:Observation:Cadence"]</dt>
                                <dd>@(UiOptions.Value.AutoRefreshInterval > TimeSpan.Zero ? SchedulerRuntimePresentation.FormatInterval(UiOptions.Value.AutoRefreshInterval, L) : L["Runtime:Observation:Manual"])</dd>
                            </div>
                        </dl>
                        <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" Disabled="@state.IsLoading" OnClick="RefreshAsync">@L["Common:Refresh"]</MudButton>
                    </section>
                    @if (state.IsLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" aria-label="@L["Common:Loading"]" />
                    }
                    @if (state.Overview is { } overview)
                    {
                        <div class="runtime-page__host-grid">
                            <SchedulerRuntimeLocalPlaneCard Overview="@overview" />
                            <SchedulerRuntimeIdentityCard Overview="@overview" />
                        </div>
                        <SchedulerOwnerInsightTable Overview="@overview" />
                    }
                    else if (state.IsQueryFailed && !state.IsLoading)
                    {
                        <div class="runtime-page__unavailable" role="status">
                            <MoIcon Icon="@MoIcons.Server" aria-hidden="true" Size="1.5rem" />
                            <h2>@L["Runtime:Observation:Unavailable"]</h2>
                            <p>@L["Runtime:Observation:UnavailableDescription"]</p>
                        </div>
                    }
                    @if (!state.IsLoading || state.HasLoadedWorkerInsight || !state.HasWorkerInsight)
                    {
                        <SchedulerWorkerInsightPanel Workers="@state.Workers"
                                                     HasWorkerInsight="@state.HasWorkerInsight"
                                                     HasLoadedWorkerInsight="@state.HasLoadedWorkerInsight"
                                                     IsWorkerInsightFailed="@state.IsWorkerInsightFailed"
                                                     WorkerInsightError="@state.WorkerInsightError"
                                                     WorkerInsightObservedAtUtc="@state.WorkerInsightObservedAtUtc" />
                    }
                    @if (state.Overview is { } configurationSnapshot)
                    {
                        <SchedulerRuntimeConfigurationPanel Overview="@configurationSnapshot" />
                    }
                </SchedulerAccessBoundary>
            }
        </div>
    }
</SchedulerWorkspace>

@code {
    /// <summary>Gets the route for serving-host runtime and separately sourced registry observations.</summary>
    public const string PAGE_URL = "/job-scheduler/runtime";

    private readonly SchedulerOperationLifetime _lifetime = new();
    private readonly object _retirementGate = new();
    private TaskCompletionSource? _retirement;
    private SchedulerRuntimePageState? _state;

    protected override async Task OnInitializedAsync()
    {
        var state = PageStateFactory.Create(UiOptions.Value.AutoRefreshInterval);
        _state = state;
        state.Changed += OnStateChangedAsync;
        try { await _lifetime.RunAsync(_ => state.InitializeAsync()); }
        catch (OperationCanceledException) when (_lifetime.IsRetired) { }
    }

    private Task OnStateChangedAsync() => _lifetime.IsRetired ? Task.CompletedTask : InvokeAsync(() =>
    {
        if (!_lifetime.IsRetired) StateHasChanged();
    });

    private async Task RefreshAsync()
    {
        if (_state is not { } state || _lifetime.IsRetired) return;
        try { await _lifetime.RunAsync(_ => state.RefreshAsync()); }
        catch (OperationCanceledException) when (_lifetime.IsRetired || state.IsDisposed) { }
    }

    /// <inheritdoc />
    public ValueTask DisposeAsync()
    {
        TaskCompletionSource completion;
        lock (_retirementGate)
        {
            if (_retirement is not null) return new(_retirement.Task);
            completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
            _retirement = completion;
        }
        var state = _state;
        if (state is not null) state.Changed -= OnStateChangedAsync;
        // Start both retirements before joining a renderer callback that may still be completing a read.
        var operations = _lifetime.RetireAsync(() => ValueTask.CompletedTask);
        var stateRetirement = state?.DisposeAsync() ?? ValueTask.CompletedTask;
        _ = CompleteRetirementAsync([operations, stateRetirement], completion);
        return new(completion.Task);
    }

    private static async Task CompleteRetirementAsync(ValueTask[] owners, TaskCompletionSource completion)
    {
        var failures = new List<Exception>();
        foreach (var owner in owners)
        {
            try { await owner; } catch (Exception exception) { failures.Add(exception); }
        }
        if (failures.Count == 0) completion.TrySetResult();
        else completion.TrySetException(new AggregateException("Scheduler runtime retirement failed.", failures));
    }
}
