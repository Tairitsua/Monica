@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation
<section class="rt-signature" aria-labelledby="rt-readiness">
    <div class="rt-decision" data-role="@(Ready ? "success" : "warning")"><div><p class="display-label">@L["Workspace:ServingHost"]</p><h2 id="rt-readiness" class="rt-statement">@L[Ready ? "Workspace:LocallyReady" : "Runtime:Plane:NotReady"]</h2><p class="rt-host-key">@Overview.Configuration.OwnerKey</p></div><div class="rt-finding"><p class="lede">@L[Ready ? "Workspace:LocalReadyFinding" : "Workspace:LocalUnreadyFinding",LocalJobs]</p><p>@L["Runtime:Plane:LocalOnly"]</p></div></div>
    <div class="rt-path" aria-label="@L["Workspace:RuntimePath"]">
        <div class="rt-stage" data-role="success"><div class="rt-stage-title"><span class="tile"><MoIcon Icon="@MoIcons.CalendarCheck" Size="18px"/></span><h3>@L["Runtime:Plane:Scheduling"]</h3></div><p>@L["Workspace:MaterializeDescription"]</p><span class="status" data-role="@(Overview.LocalPlane.SchedulingReady ? "success" : "warning")"><i></i>@L[Overview.LocalPlane.SchedulingReady ? "Runtime:Plane:Ready" : "Runtime:Plane:NotReady"]</span><div class="rt-stage-fact"><span>@L["Workspace:Poll"]</span><b>@TimePresentation.FormatDuration(Overview.Configuration.SchedulingPollInterval)</b></div></div>
        <span class="rt-connector" aria-hidden="true"><MoIcon Icon="@MoIcons.ArrowRight" Size="19px"/></span>
        <div class="rt-stage" data-role="neutral"><div class="rt-stage-title"><span class="tile"><MoIcon Icon="@MoIcons.Database" Size="18px"/></span><h3>@L["Runtime:Store:Title"]</h3></div><p>@L["Workspace:DurableDescription"]</p><span class="rt-store-name">@Overview.Store.Kind</span><a class="rt-stage-link" href="/job-scheduler/executions?states=Queued&range=all">@L["Workspace:ViewQueue"] <MoIcon Icon="@MoIcons.ArrowRight" Size="13px"/></a></div>
        <span class="rt-connector" aria-hidden="true"><MoIcon Icon="@MoIcons.ArrowRight" Size="19px"/></span>
        <div class="rt-stage" data-role="@(Overview.LocalPlane.WorkerReady ? "info" : "warning")"><div class="rt-stage-title"><span class="tile"><MoIcon Icon="@MoIcons.Server" Size="18px"/></span><h3>@L["Runtime:Plane:Worker"]</h3></div><p>@L["Workspace:ClaimDescription"]</p><span class="status" data-role="@(Overview.LocalPlane.WorkerReady ? "success" : "warning")"><i></i>@L[Overview.LocalPlane.WorkerReady ? "Runtime:Plane:Ready" : "Runtime:Plane:NotReady"]</span><div class="rt-stage-fact"><span>@L["Workspace:Poll"]</span><b>@TimePresentation.FormatDuration(Overview.Configuration.WorkerPollInterval)</b></div></div>
        <div class="rt-capacity"><span>@L["Runtime:Plane:InFlight"]</span><strong>@Overview.LocalPlane.InFlightExecutions<small> / @Overview.Configuration.MaxWorkerExecutionThreads</small></strong><div class="rt-slots" aria-label="@L["Workspace:Slots",Overview.LocalPlane.InFlightExecutions,Overview.Configuration.MaxWorkerExecutionThreads]">@for(var i=0;i<Math.Min(32,Overview.Configuration.MaxWorkerExecutionThreads);i++) { <span class="@(i<Overview.LocalPlane.InFlightExecutions ? "is-busy" : null)" data-role="info"></span> }@if(Overview.Configuration.MaxWorkerExecutionThreads>32) { <small>+@(Overview.Configuration.MaxWorkerExecutionThreads-32)</small> }</div></div>
    </div>
    <details class="rt-host-details"><summary><MoIcon Icon="@MoIcons.ChevronRight" Size="14px"/>@L["Runtime:Identity:Title"]<span>@Overview.Configuration.WorkerInstanceId</span></summary><div class="rt-identity"><dl>
        <div><dt>@L["Runtime:Identity:Owner"]</dt><dd>@string.Join(", ",Overview.Configuration.OwnerKeys)</dd></div><div><dt>@L["Runtime:Identity:Scope"]</dt><dd>@Overview.Configuration.SchedulerScopeKey</dd></div><div><dt>@L["Runtime:Identity:WorkerInstanceId"]</dt><dd>@Overview.Configuration.WorkerInstanceId <SchedulerCopyButton Value="@Overview.Configuration.WorkerInstanceId"/></dd></div><div><dt>@L["Runtime:Store:Provider"]</dt><dd>@(Overview.Store.Provider ?? L["Runtime:Store:NoProvider"])</dd></div><div><dt>@L["Runtime:Identity:CronTimeZone"]</dt><dd>@Overview.Configuration.CronTimeZoneId</dd></div><div><dt>@L["Runtime:Plane:Scheduling"]</dt><dd>@(Overview.LocalPlane.SchedulingMessage ?? L["Runtime:Plane:NoMessage"])</dd></div><div><dt>@L["Runtime:Plane:Worker"]</dt><dd>@(Overview.LocalPlane.WorkerMessage ?? L["Runtime:Plane:NoMessage"])</dd></div><div><dt>@L["Runtime:Plane:LastOwnerWork"]</dt><dd>@TimePresentation.FormatTimestamp(Overview.LocalPlane.LastOwnerSchedulingWorkAtUtc)</dd></div><div><dt>@L["Runtime:Plane:LastRecoveryWork"]</dt><dd>@TimePresentation.FormatTimestamp(Overview.LocalPlane.LastLeaseRecoveryWorkAtUtc)</dd></div><div><dt>@L["Runtime:Plane:LastCleanupWork"]</dt><dd>@TimePresentation.FormatTimestamp(Overview.LocalPlane.LastHistoryCleanupWorkAtUtc)</dd></div>
    </dl><p>@L["Runtime:Plane:WorkTimeHelp"]</p>@if(!Overview.Configuration.AutonomousWork) { <MudAlert Severity="Severity.Info" Dense="true">@L["Runtime:Identity:ManualModeHelp"]</MudAlert> }</div></details>
    @if(!Ready) { <div class="rt-diagnostic"><MudAlert Severity="Severity.Warning" Dense="true">@(Overview.LocalPlane.WorkerMessage ?? Overview.LocalPlane.SchedulingMessage ?? L["Runtime:Plane:NoMessage"])</MudAlert></div> }
</section>
@code {
    /// <summary>Gets accepted serving-host evidence; no readiness is inferred for other replicas.</summary>
    [Parameter,EditorRequired] public JobSchedulerRuntimeOverview Overview { get; set; } = null!;
    private bool Ready => Overview.LocalPlane.SchedulingReady && Overview.LocalPlane.WorkerReady;
    private int LocalJobs => Overview.Owners.Where(owner => Overview.Configuration.OwnerKeys.Contains(owner.OwnerKey,StringComparer.Ordinal)).Sum(owner => owner.PresentCount);
}
