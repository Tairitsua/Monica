@using Monica.JobScheduler.UI.UIJobScheduler.Executions.Support
@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation

<section class="execution-history" aria-labelledby="execution-history-heading">
    <header class="execution-history__heading"><h3 id="execution-history-heading">@L["ExecutionDetail:History"]</h3><small>@L["ExecutionDetail:HistoryCount", Entries.Count]</small></header>
    @if (Entries.Count == 0) { <p class="execution-history__empty">@L["ExecutionDetail:EmptyHistory"]</p> }
    else
    {
        var ordered = Entries.OrderBy(entry => entry.TimestampUtc).ToArray();
        <ol class="execution-history__timeline">@for (var index = 0; index < ordered.Length; index++)
        {
            var entry = ordered[index];
            @if (index > 0) { <li class="execution-history__gap" aria-hidden="true">+@TimePresentation.FormatPreciseDuration(entry.TimestampUtc - ordered[index - 1].TimestampUtc)</li> }
            <li class="execution-history__entry" data-state="@entry.NewState?.ToString().ToLowerInvariant()">
                <i class="execution-history__node" aria-hidden="true"></i>
                <div class="execution-history__body"><strong>@L[$"ExecutionHistoryKinds:{entry.Kind}"]@(" ") @if (entry.NewState is { } state) { <span>· @L[$"ExecutionStates:{state}"]</span> }</strong>
                    @if (entry.Message.Length > 180 || entry.Message.Contains('\n'))
                    {
                        <details class="execution-history__message"><summary>@entry.Message.Split('\n')[0]</summary><pre>@entry.Message</pre><small>@L[$"LogLevels:{entry.LogLevel}"]</small></details>
                    }
                    else
                    {
                        <p>@entry.Message @if (!string.IsNullOrEmpty(entry.WorkerInstanceId)) { <span class="execution-history__worker" title="@entry.WorkerInstanceId">· @JobSchedulerUiPresentation.ShortIdentity(entry.WorkerInstanceId)</span> }</p>
                    }
                </div>
                <time title="@TimePresentation.FormatExecutionTimestamp(entry.TimestampUtc)" datetime="@entry.TimestampUtc.ToString("O")">@TimePresentation.FormatExecutionClock(entry.TimestampUtc)</time>
            </li>
        }</ol>
    }
</section>

@code {
    /// <summary>Gets the complete retained append-only execution history. Display sorting never modifies the source.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<JobExecutionHistoryEntry> Entries { get; set; } = [];
}
