@using Monica.JobScheduler.UI.Localization

<section class="catalog-table" aria-labelledby="catalog-table-title">
    <header class="catalog-table__heading">
        <div><h2 id="catalog-table-title">@L["Catalog:Title"]</h2><span class="catalog-table__count">@L["Workspace:Matches", TotalCount]</span></div>
        <div class="catalog-table__heading-actions">
            @if (_visibleSummaries.Any(IsRecurring))
            {
                <MudCheckBox T="bool" Value="@AreAllRecurringSelected" ValueChanged="AllRecurringSelectionChanged" Disabled="@IsMutating" Dense="true" Color="Color.Primary" Label="@L["Catalog:Selection:SelectPage"]" aria-label="@L["Catalog:Selection:SelectAll"]" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" />
            }
        </div>
    </header>
    @if (FilterContent is not null) { <div class="catalog-table__filters">@FilterContent</div> }
    @if (SelectionContent is not null) { <div class="catalog-table__selection-toolbar">@SelectionContent</div> }
    <div class="catalog-table__data">
        <MudTable @ref="_table" T="JobOperationalSummary" ServerData="LoadServerDataAsync" RowsPerPage="@PageSize" Dense="true" Hover="true" Breakpoint="Breakpoint.Xs" SortLabel="@L["Catalog:SortLabel"]"
                  TableAttributes="@(new Dictionary<string, object?> { ["aria-label"] = L["Catalog:Title"].Value })" HorizontalScrollbar="false" Elevation="0" Square="true" AllowUnsorted="false">
            <ColGroup><col class="catalog-table__selection-column" /><col class="catalog-table__definition-column" /><col class="catalog-table__plan-column" /><col class="catalog-table__standing-column" /><col class="catalog-table__evidence-column" /><col class="catalog-table__next-column" /></ColGroup>
            <HeaderContent>
                <MudTh><MudCheckBox T="bool" Value="@AreAllRecurringSelected" ValueChanged="AllRecurringSelectionChanged" Disabled="@IsMutating" Dense="true" Color="Color.Primary" aria-label="@L["Catalog:Selection:SelectAll"]" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" /></MudTh>
                <MudTh>@L["Catalog:Columns:Definition"]</MudTh>
                <MudTh>@L["Catalog:Columns:Schedule"]</MudTh><MudTh>@L["Workspace:Standing"]</MudTh><MudTh>@L["Catalog:Columns:LastRun"]</MudTh><MudTh>@L["Catalog:Columns:NextRun"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{ var definition = context.Definition; var effective = definition.EffectiveConfiguration; }
                <MudTd Class="catalog-table__selection-cell" DataLabel="@L["Workspace:SelectRow"]">
                    @if (IsRecurring(context)) { <MudCheckBox T="bool" Value="@SelectedJobIds.Contains(definition.Id)" ValueChanged="@(_ => SelectionToggled.InvokeAsync(context))" Disabled="@IsMutating" Dense="true" Color="Color.Primary" aria-label="@L["Catalog:Selection:SelectJob", effective.JobName]" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" /> }
                </MudTd>
                <MudTd Class="catalog-table__definition-cell" DataLabel="@L["Catalog:Columns:Definition"]">
                    <div class="catalog-table__identity">
                        <div class="catalog-table__identity-line"><i data-tone="@StandingTone(CatalogStanding(context))"></i><a class="catalog-table__identity-name" href="@GetDetailHref(context)">@effective.JobName</a>
                            <MudMenu Icon="@MoIcons.MoreHorizontal" Size="Size.Small" AriaLabel="@L["Catalog:Columns:Actions"]">
                                @if (IsRecurring(context)) { <MudMenuItem Icon="@(IsOperatorPaused(context) ? MoIcons.PlayCircle : MoIcons.PauseCircle)" Disabled="@IsMutating" title="@GetToggleDisabledTooltip(context)" OnClick="@(() => DisabledStateToggled.InvokeAsync(context))">@GetToggleDisabledLabel(context)</MudMenuItem> }
                                <MudMenuItem Icon="@MoIcons.Play" Disabled="@(IsMutating || !definition.IsPresent || (!IsRecurring(context) && definition.IsDisabled))" OnClick="@(() => RunRequested.InvokeAsync(context))">@L["Catalog:Actions:Run"]</MudMenuItem>
                                <MudMenuItem Icon="@MoIcons.ArrowUpRight" Href="@GetDetailHref(context)">@L["Catalog:Actions:Details"]</MudMenuItem>
                                <MudMenuItem Icon="@MoIcons.Copy" OnClick="@(() => CopyJobKeyAsync(definition.Declaration.JobKey))">@L["Workspace:CopyJobKey"]</MudMenuItem>
                            </MudMenu>
                        </div>
                        <a class="catalog-table__owner" href="@($"/job-scheduler/catalog?owner={Uri.EscapeDataString(definition.OwnerKey)}")">@definition.OwnerKey</a>
                    </div>
                </MudTd>
                <MudTd Class="catalog-table__plan-cell" DataLabel="@L["Catalog:Columns:Schedule"]">
                    <div class="catalog-table__stack">
                        @if (IsRecurring(context)) { <span>@GetCronDescription(context)</span><code>@effective.Schedule!.CronExpression</code> }
                        else { <span>@L["Catalog:OnDemand"]</span><code>@(definition.Declaration.JobArgsKey ?? L["Catalog:Triggered:NoArguments"])</code> }
                    </div>
                </MudTd>
                <MudTd Class="catalog-table__standing-cell" DataLabel="@L["Workspace:Standing"]"><span class="catalog-table__standing" data-tone="@StandingTone(CatalogStanding(context))" title="@GetLifecycleDescription(context)"><i></i>@L[$"Workspace:Standings:{CatalogStanding(context)}"]</span></MudTd>
                <MudTd Class="catalog-table__evidence-cell" DataLabel="@L["Catalog:Columns:LastRun"]">
                    @if (context.LatestExecution is { } latest)
                    {
                        <button type="button" class="catalog-table__latest" title="@latest.InstanceId" aria-label="@L["Executions:Actions:OpenDetailsFor", effective.JobName, latest.InstanceId]" @onclick="@(() => OpenLatestExecutionAsync(latest.InstanceId))">
                            <span class="catalog-table__latest-state" data-state="@latest.State.ToString().ToLowerInvariant()"><i></i>@L[$"ExecutionStates:{latest.State}"] <MoIcon Icon="@MoIcons.ChevronRight" Size=".75rem" /></span>
                            <time datetime="@latest.CreatedAtUtc.ToString("O")" title="@TimePresentation.FormatTimestamp(latest.CreatedAtUtc)">@TimePresentation.FormatListTimestamp(latest.CreatedAtUtc, TimeProvider.GetUtcNow())</time>
                            <span class="catalog-table__duration"><small>@L["Executions:Columns:Duration"]</small><b>@TimePresentation.FormatExecutionDuration(latest, TimeProvider.GetUtcNow())</b></span>
                        </button>
                    }
                    else { <span class="catalog-table__never-run">@L["Catalog:History:NeverRun"]</span> }
                </MudTd>
                <MudTd Class="catalog-table__next-cell" DataLabel="@L["Catalog:Columns:NextRun"]">
                    <div class="catalog-table__stack">
                        @if (context.NextOccurrenceUtc is { } next && context.RecurringScheduleStatus == JobRecurringScheduleStatus.Scheduled)
                        { <time datetime="@next.ToString("O")" title="@GetNextRunTooltip(next)">@TimePresentation.FormatListTimestamp(next, TimeProvider.GetUtcNow())</time><small>@L["Workspace:Planned"]</small> }
                        else { <span class="catalog-table__never-run">@(IsRecurring(context) ? GetNextRunStatusLabel(context) : L["Catalog:OnDemand"])</span> }
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><div class="catalog-table__empty"><MoIcon Icon="@MoIcons.Package" Size="2rem" /><p>@(IsQueryFailed ? L["Catalog:QueryUnavailable"] : EmptyText ?? L["Catalog:Empty"])</p></div></NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="@PageSizeOptions" RowsPerPageString="@L["Catalog:Filters:PageSize"]" InfoFormat="@L["Catalog:Pagination:Range"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" /></PagerContent>
        </MudTable>
    </div>
</section>
