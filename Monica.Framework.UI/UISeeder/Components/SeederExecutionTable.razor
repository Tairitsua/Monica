@using Monica.UI.Shared.Components.States
@inject IStringLocalizer<SeederResource> L
@inject NavigationManager Navigation

@if (Session.Graph is { } graph)
{
    var seeders = Session.FilteredSeeders;
    <section class="seeder-ledger" aria-labelledby="seeder-ledger-title">
        <header class="seeder-ledger-heading">
            <div>
                <h2 id="seeder-ledger-title">@L["Table:Title"]</h2>
                <p>@L["Table:Subtitle"]</p>
            </div>
            <span class="seeder-result-count" role="status">@L.FormatSeederFilterResults(seeders.Count, graph.Run.TotalCount)</span>
        </header>
        @if (graph.Run.TotalCount > 0)
        {
            <SeederFilters Session="@Session" />
        }
        @if (seeders.Count == 0)
        {
            <div class="seeder-ledger-empty">
                <MoContentState Compact="true" data-testid="seeder-table-empty">
                    <MoIcon Icon="@(graph.Run.TotalCount == 0 ? MoIcons.Sprout : MoIcons.Search)" Size="24px" />
                    <h3>@L[graph.Run.TotalCount == 0 ? "Table:NoSeeders" : "Table:Empty"]</h3>
                    <p>@L[graph.Run.TotalCount == 0 ? "Table:NoSeedersDescription" : "Table:EmptyDescription"]</p>
                </MoContentState>
            </div>
        }
        else
        {
            <table class="seeder-ledger-table" role="table" aria-labelledby="seeder-ledger-title">
                <colgroup><col class="seeder-col-name" /><col class="seeder-col-policy" /><col class="seeder-col-state" />
                    <col class="seeder-col-attempts" /><col class="seeder-col-duration" /><col class="seeder-col-inspect" /></colgroup>
                <thead role="rowgroup">
                    <tr role="row">
                        <th scope="col">@L["Table:Columns:Name"]</th>
                        <th scope="col">@L["Table:Columns:Policy"]</th>
                        <th scope="col">@L["Table:Columns:Status"]</th>
                        <th scope="col" class="seeder-numeric">@L["Table:Columns:Attempts"]</th>
                        <th scope="col" class="seeder-numeric">@L["Table:Columns:Duration"]</th>
                        <th scope="col"><span class="seeder-visually-hidden">@L["Table:Columns:Actions"]</span></th>
                    </tr>
                </thead>
                <tbody role="rowgroup">
                    @foreach (var seeder in seeders)
                    {
                        var outside = SeederGraphView.IsOutsideBatch(seeder);
                        var prerequisites = string.Join(", ", seeder.Dependencies.Select(name =>
                            graph.ByType.GetValueOrDefault(name)?.SeederName ?? SeederDisplay.ShortName(name)));
                        <tr role="row" @key="seeder.SeederTypeName" data-status="@seeder.Status">
                            <td role="cell" class="seeder-ledger-identity">
                                <div class="seeder-row-heading">
                                    <span class="seeder-ledger-wave">@(outside ? "—" : $"W{graph.GetWave(seeder)}")</span>
                                    <a class="seeder-ledger-link"
                                       id="@SeederDisplay.DetailsTriggerId(seeder.SeederTypeName)"
                                       href="@SeederDisplay.EvidenceUrl(Navigation, seeder.SeederTypeName)"
                                       aria-haspopup="dialog"
                                       aria-label="@L["Actions:DetailsFor", seeder.SeederName]"
                                       aria-expanded="@((Session.IsDetailsOpen && Session.SelectedSeeder?.SeederTypeName == seeder.SeederTypeName) ? "true" : "false")">
                                        @seeder.SeederName
                                    </a>
                                    @if (!seeder.ParticipatesInReadiness)
                                    {
                                        <small class="seeder-participation-note">@L["Details:OutsideReadiness"]</small>
                                    }
                                </div>
                                <code class="seeder-ledger-type">@seeder.SeederTypeName</code>
                                <div class="seeder-ledger-dependencies">
                                    <MoIcon Icon="@MoIcons.Workflow" Size="12px" />
                                    <span>
                                        @(seeder.Dependencies.Length == 0 ? L["Table:NoDependencies"] :
                                            L["Table:DependenciesNamed", L.FormatSeederDependencyCount(seeder.Dependencies.Length), prerequisites])
                                    </span>
                                </div>
                                @if (seeder.Status is SeederStatus.Blocked or SeederStatus.Failed && seeder.ErrorMessage is { Length: > 0 } error)
                                {
                                    <p class="seeder-ledger-diagnostic" title="@error">@error</p>
                                }
                            </td>
                            <td role="cell" data-label="@L["Table:Columns:Policy"]">
                                <div class="seeder-ledger-policy">
                                    @PolicyPill(L.GetText(seeder.Criticality), seeder.CriticalitySource)
                                    @PolicyPill(L.GetText(seeder.ExecutionMode), seeder.ExecutionModeSource,
                                        seeder.ExecutionMode == SeederExecutionMode.Exclusive ? "third" : null)
                                    @PolicyPill(L.GetText(seeder.FailureBehavior), seeder.FailureBehaviorSource,
                                        seeder.FailureBehavior == SeederFailureBehavior.FailFast ? "error" : null)
                                </div>
                            </td>
                            <td role="cell" data-label="@L["Table:Columns:Status"]">
                                <SeederStatusMark Text="@L.GetText(seeder.Status)" Tone="@SeederDisplay.Tone(seeder.Status)" Pill="true" />
                            </td>
                            <td role="cell" data-label="@L["Table:Columns:Attempts"]" class="seeder-numeric">
                                <span class="seeder-ledger-value @(seeder.MaxAttemptsSource == SeederPolicySource.SeederOverride ? "is-override" : null)"
                                      title="@L.FormatSeederAttemptsSummary(seeder.Attempts, seeder.MaxAttempts)">
                                    @L["Table:AttemptsValue", seeder.Attempts, seeder.MaxAttempts]
                                </span>
                            </td>
                            <td role="cell" data-label="@L["Table:Columns:Duration"]" class="seeder-numeric">
                                <span class="seeder-ledger-value">@(seeder.Duration is { } duration ? L.FormatSeederDuration(duration) : "—")</span>
                            </td>
                            <td role="cell" class="seeder-ledger-arrow" aria-hidden="true">
                                <MoIcon Icon="@MoIcons.ChevronRight" Size="14px" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    [Parameter, EditorRequired] public SeederPageSession Session { get; set; } = default!;

    private RenderFragment PolicyPill(string text, SeederPolicySource source, string? tone = null) =>
        @<span class="seeder-policy-pill @(source == SeederPolicySource.SeederOverride ? "is-override" : null)"
               style="--seeder-policy-tone:@SeederDisplay.ToneColor(tone ?? "neutral")">
            @text
            @if (source == SeederPolicySource.SeederOverride)
            {
                <b>@L["Table:Override"]</b>
            }
        </span>;
}
