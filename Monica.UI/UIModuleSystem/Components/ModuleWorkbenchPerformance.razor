@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.Core.Modularity.Models
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.State
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<ModuleSystemResource> L

@if (Session.Snapshot is { } snapshot)
{
    <div class="performance-layout">
        <ModuleCompositionWaterfall Session="@Session" ModuleSelected="@ModuleSelected" />

        @if (snapshot.Summary.PerformanceBudgets.Length > 0)
        {
            <section class="mo-vl-panel performance-panel performance-budgets" aria-labelledby="performance-budgets-title">
                <header class="mo-vl-panel-head">
                    <div>
                        <p class="mo-vl-eyebrow">@L["Performance:Budgets:Eyebrow"]</p>
                        <h2 id="performance-budgets-title" class="mo-vl-panel-title">@L["Performance:Budgets:Title"]</h2>
                    </div>
                </header>
                <div class="budget-list">
                    @foreach (var budget in snapshot.Summary.PerformanceBudgets)
                    {
                        <article class="budget-row" data-budget-exceeded="@(budget.IsExceeded ? "true" : "false")">
                            <div class="budget-row__identity">
                                <strong>@L[$"Enums:Budget:{budget.Kind}"]</strong>
                                <span>@L["Performance:Budgets:Measurement",
                                    ModuleDiagnosticsDisplay.Duration(budget.ActualDurationMs),
                                    ModuleDiagnosticsDisplay.Duration(budget.LimitDurationMs)]</span>
                            </div>
                            <MoTwoRoleMeter PrimaryValue="@budget.ActualDurationMs"
                                            ScaleMaximum="@budget.LimitDurationMs"
                                            PrimaryRole="@(budget.IsExceeded ? MoVisualRole.Warning : MoVisualRole.Success)"
                                            AccessibleDescription="@L["Performance:Budgets:MeterAria",
                                                L[$"Enums:Budget:{budget.Kind}"],
                                                ModuleDiagnosticsDisplay.Duration(budget.ActualDurationMs),
                                                ModuleDiagnosticsDisplay.Duration(budget.LimitDurationMs)]" />
                            <span class="budget-row__utilization mo-vl-mono">@L["Performance:Budgets:Utilization", budget.Utilization.ToString("P0")]</span>
                        </article>
                    }
                </div>
            </section>
        }

        <div class="performance-grid @(!snapshot.BlockingChain.IsEmpty ? "performance-grid--causal" : null)">
            <section class="mo-vl-panel performance-panel performance-contributors" aria-labelledby="contributors-title">
                <header class="mo-vl-panel-head">
                    <div>
                        <p class="mo-vl-eyebrow">@L["Performance:Contributors:Eyebrow"]</p>
                        <h2 id="contributors-title" class="mo-vl-panel-title">@L["Performance:Contributors:Title"] <span class="performance-record-count">@Session.PerformanceContributors.Count</span></h2>
                    </div>
                    <div class="mo-vl-legend">
                        <span><i class="mo-vl-swatch mo-vl-role--primary"></i>@L["Modules:Cost:Callbacks"]</span>
                        <span><i class="mo-vl-swatch mo-vl-role--info"></i>@L["Modules:Cost:StartupWork"]</span>
                    </div>
                </header>
                <div class="contributor-filters">
                    <div class="performance-field">
                        <MudSelect T="int" Label="@L["Performance:Filters:Limit"]" Value="@Session.PerformanceContributorLimit" ValueChanged="@SetContributorLimit" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                            <MudSelectItem T="int" Value="10">10</MudSelectItem>
                            <MudSelectItem T="int" Value="25">25</MudSelectItem>
                            <MudSelectItem T="int" Value="50">50</MudSelectItem>
                            <MudSelectItem T="int" Value="0">@L["Common:All"]</MudSelectItem>
                        </MudSelect>
                    </div>
                    <div class="performance-field">
                        <MudNumericField T="double" Label="@L["Performance:Filters:MinimumMs"]" Value="@Session.PerformanceMinimumDurationMs" ValueChanged="@SetMinimumDuration" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </div>
                    <div class="performance-field performance-field--switch">
                        <MudSwitch T="bool" Label="@L["Performance:Filters:HideZero"]" Value="@Session.HideZeroDurationContributors" ValueChanged="@SetHideZero" Color="Color.Primary" />
                    </div>
                </div>
                <MoRankedLedger Rows="@ContributorRows"
                                AriaLabel="@L["Overview:Ledger:Aria"]"
                                EmptyText="@L["Performance:Contributors:Empty"]"
                                HeaderLabels="@ContributorHeaders"
                                FooterNote="@L["Modules:Cost:ScaleHint"]"
                                OnRowSelected="@SelectContributorAsync" />
            </section>

            @if (snapshot.BlockingChain.IsEmpty)
            {
                <section class="performance-blocking-summary" aria-labelledby="blocking-title">
                    <MoIcon Icon="@MoIcons.Unlink" Size="1.25rem" />
                    <div><h2 id="blocking-title">@L["Performance:Blocking:Title"]</h2><p>@L["Performance:Blocking:Empty"]</p></div>
                </section>
            }
            else
            {
                <section class="mo-vl-panel performance-panel performance-blocking" aria-labelledby="blocking-title">
                    <header class="mo-vl-panel-head">
                        <div>
                            <p class="mo-vl-eyebrow">@L["Performance:Blocking:Eyebrow"]</p>
                            <h2 id="blocking-title" class="mo-vl-panel-title">@L["Performance:Blocking:Title"]</h2>
                        </div>
                    </header>
                    <div class="blocking-list">
                        @foreach (var segment in snapshot.BlockingChain.OrderByDescending(static segment => segment.BlockingDurationMs))
                        {
                            var module = snapshot.Modules.FirstOrDefault(candidate => candidate.ModuleKey == segment.ModuleKey);
                            <article @key="segment.SegmentId">
                                <button type="button" disabled="@(module is null)" @onclick="@(() => SelectModuleAsync(module))">
                                    <span><strong>@(module?.TypeName ?? segment.ModuleKey.Value)</strong><small>@L[$"Enums:Barrier:{segment.Barrier}"] · @segment.WorkItemId</small></span>
                                    <code>@ModuleDiagnosticsDisplay.Duration(segment.BlockingDurationMs)</code>
                                </button>
                                <div class="blocking-linkage">
                                    <div><span>@L["Performance:Blocking:BarrierSpan"]</span><IdentifierValue Value="@segment.BarrierSpanId" /></div>
                                    <div><span>@L["Performance:Blocking:WorkSpan"]</span><IdentifierValue Value="@segment.WorkSpanId" /></div>
                                    @if (!string.IsNullOrWhiteSpace(segment.CommitSpanId))
                                    {
                                        <div><span>@L["Performance:Blocking:CommitSpan", ModuleDiagnosticsDisplay.Duration(segment.CommitDurationMs)]</span><IdentifierValue Value="@(segment.CommitSpanId!)" /></div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>

        @if (Session.Comparison is { } comparison)
        {
            <section class="mo-vl-panel performance-panel comparison-evidence" aria-labelledby="comparison-evidence-title">
                <header class="mo-vl-panel-head">
                    <div>
                        <p class="mo-vl-eyebrow">@L["Comparison:Eyebrow"]</p>
                        <h2 id="comparison-evidence-title" class="mo-vl-panel-title">@L["Comparison:EvidenceTitle"]</h2>
                    </div>
                </header>
                <div class="comparison-facts">
                    <MoFactGrid Facts="ComparisonFacts(comparison)" />
                </div>
                <div class="comparison-changes">
                    <MudExpansionPanels MultiExpansion="true">
                        <MudExpansionPanel Text="@L["Comparison:AddedModules", comparison.AddedModules.Count]" Icon="@MoIcons.ChevronDown"><ChangeList Values="@comparison.AddedModules" EmptyText="@L["Comparison:NoChanges"]" /></MudExpansionPanel>
                        <MudExpansionPanel Text="@L["Comparison:RemovedModules", comparison.RemovedModules.Count]" Icon="@MoIcons.ChevronDown"><ChangeList Values="@comparison.RemovedModules" EmptyText="@L["Comparison:NoChanges"]" /></MudExpansionPanel>
                        <MudExpansionPanel Text="@L["Comparison:AddedEdges", comparison.AddedEdges.Count]" Icon="@MoIcons.ChevronDown"><ChangeList Values="@comparison.AddedEdges" EmptyText="@L["Comparison:NoChanges"]" /></MudExpansionPanel>
                        <MudExpansionPanel Text="@L["Comparison:RemovedEdges", comparison.RemovedEdges.Count]" Icon="@MoIcons.ChevronDown"><ChangeList Values="@comparison.RemovedEdges" EmptyText="@L["Comparison:NoChanges"]" /></MudExpansionPanel>
                    </MudExpansionPanels>
                </div>
            </section>
        }

        <section class="mo-vl-panel performance-panel performance-discovery" aria-labelledby="discovery-stages-title">
            <header class="mo-vl-panel-head">
                <div>
                    <p class="mo-vl-eyebrow">@L["Performance:Discovery:Eyebrow"]</p>
                    <h2 id="discovery-stages-title" class="mo-vl-panel-title">@L["Performance:Discovery:Title"]</h2>
                </div>
            </header>
            <ol class="stage-strip" role="region" aria-labelledby="discovery-stages-title" tabindex="0">
                @foreach (var stage in snapshot.TypeDiscovery.Stages)
                {
                    <li>
                        <span>@ModuleDiagnosticsDisplay.Stage(stage.Stage, L)</span>
                        <MoTwoRoleMeter PrimaryValue="@stage.DurationMs"
                                        ScaleMaximum="@TotalDiscoveryDurationMs"
                                        AccessibleDescription="@L["Performance:Discovery:StageAria",
                                            ModuleDiagnosticsDisplay.Stage(stage.Stage, L),
                                            ModuleDiagnosticsDisplay.Duration(stage.DurationMs)]" />
                        <strong title="@ModuleDiagnosticsDisplay.ExactMilliseconds(stage.DurationMs)">@ModuleDiagnosticsDisplay.Duration(stage.DurationMs)</strong>
                    </li>
                }
            </ol>
        </section>

        <section class="mo-vl-panel performance-panel performance-startup-work" aria-labelledby="startup-work-title">
            <header class="mo-vl-panel-head">
                <div>
                    <p class="mo-vl-eyebrow">@L["Performance:StartupWork:Eyebrow"]</p>
                    <h2 id="startup-work-title" class="mo-vl-panel-title">@L["Performance:StartupWork:Title"]</h2>
                </div>
            </header>
            <div class="startup-work-table-wrapper" role="region" aria-labelledby="startup-work-title" tabindex="0">
                <MudTable T="ModuleDiagnosticsTraceSpan" Items="@StartupWorkSpans" RowsPerPage="10" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
                    <HeaderContent>
                        <MudTh>@L["Performance:Columns:Module"]</MudTh>
                        <MudTh>@L["Performance:Columns:WorkItem"]</MudTh>
                        <MudTh>@L["Performance:Columns:Queue"]</MudTh>
                        <MudTh>@L["Performance:Columns:Duration"]</MudTh>
                        <MudTh>@L["Performance:Columns:State"]</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="work">
                        <MudTd DataLabel="@L["Performance:Columns:Module"]">@TracePrimaryLabel(work)</MudTd>
                        <MudTd DataLabel="@L["Performance:Columns:WorkItem"]"><code>@(work.WorkItemId ?? work.Name ?? L["Common:NotAvailable"])</code></MudTd>
                        <MudTd DataLabel="@L["Performance:Columns:Queue"]"><code>@ModuleDiagnosticsDisplay.Duration(work.QueueDurationMs ?? 0)</code></MudTd>
                        <MudTd DataLabel="@L["Performance:Columns:Duration"]"><code>@ModuleDiagnosticsDisplay.Duration(work.DurationMs)</code></MudTd>
                        <MudTd DataLabel="@L["Performance:Columns:State"]">
                            <span class="performance-work-state @(work.IsFailed ? "performance-work-state--failed" : work.IsComplete ? "performance-work-state--complete" : "performance-work-state--running")">
                                @(work.IsFailed ? L["Enums:SpanState:Failed"] : work.IsComplete ? L["Enums:SpanState:Complete"] : L["Enums:SpanState:Running"])
                            </span>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MoContentState Compact="true"><p>@L["Performance:StartupWork:Empty"]</p></MoContentState></NoRecordsContent>
                    <PagerContent><MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" RowsPerPageString="@L["Common:RowsPerPage"]" InfoFormat="@L["Common:PagerInfo"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" /></PagerContent>
                </MudTable>
            </div>
        </section>
    </div>
}

@code {
    [Parameter, EditorRequired] public ModuleSystemWorkbenchSession Session { get; set; } = default!;
    [Parameter] public EventCallback<ModuleDiagnosticsModule> ModuleSelected { get; set; }

    private MoLedgerHeaderLabels ContributorHeaders => new(
        L["Overview:Ledger:Column:Rank"],
        L["Modules:Columns:Module"],
        L["Modules:Columns:Cost"],
        L["Performance:Columns:Total"]);

    private IReadOnlyList<MoLedgerRow> ContributorRows => Session.PerformanceContributors
        .Select(module => new MoLedgerRow(
            module.TypeName,
            module.AssemblyName,
            PrimaryValue: module.SerialCallbackDurationMs,
            SecondaryValue: module.StartupWorkDurationMs,
            MeterScale: MaximumModuleCost,
            MeterPrimaryCaption: L["Overview:Ledger:Cap:Callback", ModuleDiagnosticsDisplay.Duration(module.SerialCallbackDurationMs)],
            MeterSecondaryCaption: L["Overview:Ledger:Cap:Work", ModuleDiagnosticsDisplay.Duration(module.StartupWorkDurationMs)],
            Total: ModuleDiagnosticsDisplay.Duration(ModuleCost(module)),
            Key: module.ModuleKey.Id))
        .ToArray();

    private Task SelectContributorAsync(MoLedgerRow row) => SelectModuleAsync(
        Session.Snapshot?.Modules.FirstOrDefault(module => module.ModuleKey.Id == row.Key));

    private IReadOnlyList<ModuleDiagnosticsTraceSpan> StartupWorkSpans => Session.Snapshot?.TraceSpans
        .Where(static span => span.Kind == ModuleDiagnosticsTraceSpanKind.StartupWork)
        .OrderByDescending(static span => span.DurationMs)
        .ToArray() ?? [];

    private double MaximumModuleCost => Session.Snapshot?.Modules
        .Select(ModuleCost)
        .DefaultIfEmpty(0)
        .Max() ?? 0;

    private string TracePrimaryLabel(ModuleDiagnosticsTraceSpan span) => Session.Snapshot is { } snapshot
        ? ModuleDiagnosticsDisplay.TraceSpan(span, snapshot, L).Primary
        : span.Name ?? L[$"Enums:TraceKind:{span.Kind}"];

    private void SetContributorLimit(int value) => Session.SetPerformanceFilters(
        value,
        Session.PerformanceMinimumDurationMs,
        Session.HideZeroDurationContributors);

    private void SetMinimumDuration(double value) => Session.SetPerformanceFilters(
        Session.PerformanceContributorLimit,
        value,
        Session.HideZeroDurationContributors);

    private void SetHideZero(bool value) => Session.SetPerformanceFilters(
        Session.PerformanceContributorLimit,
        Session.PerformanceMinimumDurationMs,
        value);

    private async Task SelectModuleAsync(ModuleDiagnosticsModule? module)
    {
        if (module is not null)
        {
            await ModuleSelected.InvokeAsync(module);
        }
    }

    private static double ModuleCost(ModuleDiagnosticsModule module) =>
        module.SerialCallbackDurationMs + module.StartupWorkDurationMs;

    private IReadOnlyList<MoFact> ComparisonFacts(ModuleDiagnosticsComparison comparison) =>
    [
        new(L["Overview:Kpis:Composition"], SignedDuration(comparison.TotalDurationDeltaMs)),
        new(L["Overview:Kpis:TypeDiscovery"], SignedDuration(comparison.TypeDiscoveryDurationDeltaMs)),
        new(L["Comparison:ModulesChanged"], $"+{comparison.AddedModules.Count} / -{comparison.RemovedModules.Count}"),
        new(L["Comparison:EdgesChanged"], $"+{comparison.AddedEdges.Count} / -{comparison.RemovedEdges.Count}"),
    ];

    private double TotalDiscoveryDurationMs => Session.Snapshot?.TypeDiscovery.Stages
        .Sum(static stage => stage.DurationMs) ?? 0;

    private static string SignedDuration(double duration) =>
        $"{(duration > 0 ? "+" : duration < 0 ? "-" : string.Empty)}{ModuleDiagnosticsDisplay.Duration(Math.Abs(duration))}";
}
