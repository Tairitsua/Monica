@attribute [Route(PAGE_URL)]
@implements IAsyncDisposable
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using Monica.Core.Results
@using Monica.Modules
@using Monica.UI.Localization
@using Monica.UI.UISystemInfo.Components
@using Monica.UI.UISystemInfo.Dialogs
@using Monica.UI.UISystemInfo.State
@inject IDialogService DialogService
@inject SystemInfoPageSessionFactory SessionFactory
@inject ISnackbar Snackbar
@inject IOptions<ModuleSystemInfoUIOption> SystemInfoUIOptions
@inject IStringLocalizer<SystemInfoResource> L

<PageTitle>@L["Page:Title"]</PageTitle>

<div class="system-info-page">
    <SystemInfoPageHeader Snapshot="@_session?.Snapshot" EnableRestart="@SystemInfoUIOptions.Value.EnableSelfRestartAction"
                          IsRefreshing="@(_session?.IsRefreshing == true)"
                          RestartRequested="@(_session?.RestartRequested == true)"
                          RefreshRequested="RefreshAsync"
                          RestartRequestedCallback="RequestSelfRestartAsync" />

    @if (_session is null || (_session.Snapshot is null && _session.LoadState == SystemInfoPageLoadState.InitialLoading))
    {
        <SystemInfoLoadState IsLoading="true" />
    }
    else if (_session.Snapshot is null)
    {
        <SystemInfoLoadState Error="@_session.LoadError" RetryRequested="RefreshAsync" />
    }
    else
    {
        var snapshot = _session.Snapshot;

        <SystemInfoServiceHero Snapshot="@snapshot" NowUtc="@_session.NowUtc" />

        <div class="system-info-lower">
            <SystemInfoDossier Snapshot="@snapshot" />
            <div class="system-info-side">
                <SystemInfoCustomLinkPanel Links="@SystemInfoUIOptions.Value.CustomLinks" />
                <SystemInfoEndpoints Snapshot="@snapshot" />
            </div>
        </div>
    }
</div>

@code {
    public const string PAGE_URL = "/system-info";

    private SystemInfoPageSession? _session;
    private int _disposed;

    protected override async Task OnInitializedAsync()
    {
        var session = SessionFactory.Create();
        _session = session;
        session.Changed += HandleSessionChanged;
        await session.InitializeAsync();
    }

    private Task HandleSessionChanged() => IsDisposed
        ? Task.CompletedTask
        : InvokeAsync(StateHasChanged);

    private async Task RefreshAsync()
    {
        var session = _session;
        if (IsDisposed || session is null)
        {
            return;
        }

        var refreshed = await session.RefreshAsync();
        // Disposal can run while the request is suspended. Feedback belongs only to the page
        // instance that still owns this session.
        if (!OwnsSession(session))
        {
            return;
        }

        if (!refreshed)
        {
            if (session.RefreshError is { Length: > 0 } error)
            {
                Snackbar.Add(L["Page:Messages:RefreshFailed", error], Severity.Error);
            }

            return;
        }

        Snackbar.Add(L["Page:Messages:RefreshSucceeded"], Severity.Success);
    }

    private async Task RequestSelfRestartAsync()
    {
        var session = _session;
        if (IsDisposed || session is null || session.RestartRequested)
        {
            return;
        }

        var parameters = new DialogParameters<SystemInfoRestartConfirmDialog>
        {
            { dialog => dialog.DelaySeconds, Math.Max(0d, SystemInfoUIOptions.Value.SelfRestartDelay.TotalSeconds) }
        };
        var dialog = await DialogService.ShowAsync<SystemInfoRestartConfirmDialog>(
            L["Page:Dialogs:Restart:Title"],
            parameters,
            new DialogOptions
            {
                CloseOnEscapeKey = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true
            });

        if (!OwnsSession(session))
        {
            return;
        }

        var dialogResult = await dialog.Result;
        if (!OwnsSession(session) || dialogResult is not { Canceled: false })
        {
            return;
        }

        var result = session.RequestSelfRestart();
        if (result.IsFailed(out var error))
        {
            Snackbar.Add(L["Page:Messages:RestartFailed", error.Message ?? string.Empty], Severity.Error);
            return;
        }

        Snackbar.Add(
            result.Message ?? L["Page:Messages:RestartRequestedFallback"].Value,
            Severity.Warning);
    }

    public async ValueTask DisposeAsync()
    {
        if (Interlocked.Exchange(ref _disposed, 1) != 0)
        {
            return;
        }

        var session = _session;
        _session = null;
        if (session is not null)
        {
            session.Changed -= HandleSessionChanged;
            await session.DisposeAsync();
        }
    }

    private bool IsDisposed => Volatile.Read(ref _disposed) != 0;

    private bool OwnsSession(SystemInfoPageSession session) =>
        !IsDisposed && ReferenceEquals(_session, session);
}
