@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@attribute [Route(PAGE_URL)]
@implements IAsyncDisposable
@using Monica.Framework.UI.UIExecutionPipeline.Components
@using Monica.Framework.UI.UIExecutionPipeline.State
@inject ExecutionPipelinePageState PageState
@inject ISnackbar Snackbar
@inject IStringLocalizer<ExecutionPipelineResource> L

<PageTitle>@L["Page:PageTitle"]</PageTitle>

<div class="execution-pipeline-page" aria-busy="@PageState.IsLoading.ToString().ToLowerInvariant()">
    <div class="execution-pipeline-page__content">
        <header class="execution-pipeline-page__header">
            <div class="execution-pipeline-page__heading">
                <span class="execution-pipeline-page__eyebrow">@L["Page:Header:Eyebrow"]</span>
                <h1>@L["Page:Header:Title"]</h1>
                <p>@L["Page:Header:Description"]</p>
            </div>
            <div class="execution-pipeline-page__actions">
                @if (PageState.Snapshot is { } snapshot)
                {
                    <div class="execution-pipeline-page__capture">
                        <span>@L["Page:Header:CaptureLabel"]</span>
                        <time datetime="@snapshot.CapturedAt.ToString("O")">
                            @UiTime.Format(snapshot.CapturedAt)
                        </time>
                        <small>@L["Page:Header:LocalTime"]</small>
                    </div>
                }
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@MoIcons.Refresh"
                           Disabled="@PageState.IsLoading"
                           OnClick="RefreshAsync">
                    @L["Page:Header:Refresh"]
                </MudButton>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(PageState.LoadError))
        {
            <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Variant="Variant.Outlined"
                      Class="execution-pipeline-page__error"
                      data-testid="execution-pipeline-load-error">
                @L["Page:Messages:RefreshFailed", PageState.LoadError]
            </MudAlert>
        }

        @if (PageState.IsLoading && PageState.Snapshot is null)
        {
            <div class="execution-pipeline-page__state" role="status" data-testid="execution-pipeline-loading">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
                <p>@L["Page:States:Loading"]</p>
            </div>
        }
        else if (PageState.Snapshot is { } catalog)
        {
            <ExecutionPipelineSummary Snapshot="@catalog" />

            <section class="execution-pipeline-page__catalog" aria-label="@L["Page:Catalog:AriaLabel"]">
                @if (PageState.IsLoading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary"
                                       Class="execution-pipeline-page__refresh-progress" />
                }
                <MudTabs PrevIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" Rounded="false"
                         Outlined="false"
                         Elevation="0"
                         ApplyEffectsToContainer="false"
                         Class="execution-pipeline-page__tabs mo-self-painted"
                         TabPanelsClass="execution-pipeline-page__tab-panel">
                    <MudTabPanel Text="@L["Page:Tabs:PlansWithCount", catalog.Plans.Length]" Icon="@MoIcons.Route">
                        @if (catalog.Plans.IsDefaultOrEmpty)
                        {
                            <div class="execution-pipeline-page__state" data-testid="execution-pipeline-observed-empty">
                                <span class="execution-pipeline-page__state-icon">
                                    <MoIcon Icon="@MoIcons.Route" Size="1.5rem" />
                                </span>
                                <h2>@L["Page:States:NoObservedPlansTitle"]</h2>
                                <p>@L["Page:States:NoObservedPlans"]</p>
                            </div>
                        }
                        else
                        {
                            <ExecutionPipelinePlanFilterBar State="@PageState" />
                            <ExecutionPipelinePlanExplorer Plans="@PageState.FilteredPlans"
                                                           SelectedPlan="@PageState.SelectedPlan"
                                                           PlanSelected="PageState.SelectPlan" />
                        }
                    </MudTabPanel>
                    <MudTabPanel Text="@L["Page:Tabs:RegistrationsWithCount", catalog.Registrations.Length]" Icon="@MoIcons.Puzzle">
                        <ExecutionPipelineRegistrationTable Registrations="@catalog.Registrations" />
                    </MudTabPanel>
                </MudTabs>
            </section>
        }
        else if (!PageState.IsLoading)
        {
            <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Variant="Variant.Outlined" Class="execution-pipeline-page__error">
                @L["Page:States:LoadFailed"]
            </MudAlert>
        }
    </div>
</div>

@code {
    public const string PAGE_URL = "/execution-pipeline";

    private Task _pendingRender = Task.CompletedTask;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        PageState.StateChanged += OnStateChanged;
        await PageState.InitializeAsync();
    }

    private async Task RefreshAsync()
    {
        var succeeded = await PageState.RefreshAsync();
        if (_disposed)
        {
            return;
        }

        Snackbar.Add(
            succeeded
                ? L["Page:Messages:RefreshSucceeded"]
                : L["Page:Messages:RefreshFailed", PageState.LoadError ?? L["Page:States:LoadFailed"]],
            succeeded ? Severity.Success : Severity.Error);
    }

    private void OnStateChanged()
    {
        _pendingRender = InvokeAsync(() =>
        {
            if (!_disposed)
            {
                StateHasChanged();
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        PageState.StateChanged -= OnStateChanged;
        await _pendingRender;
    }
}
