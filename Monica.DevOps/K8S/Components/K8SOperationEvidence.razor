@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.DevOps.K8S.Models
@using Monica.DevOps.Localization
@inject IStringLocalizer<K8SResource> L

<div class="k8s-operation-evidence">
    <section class="evidence-panel @(Failure is null ? "evidence--completed" : "evidence--failed")" role="status" aria-live="polite">
        <div class="evidence-summary">
            <span class="evidence-icon"><MoIcon Icon="@(Failure is null ? MoIcons.Success : MoIcons.Error)" Size="1.25rem" /></span>
            <div>
                <h2>@L[Failure is null ? "Workbench:Operation:Completed" : "Workbench:Operation:Failed"]</h2>
                <p class="operation-context">@Namespace · @Scope · @UiTime.Format(CompletedAt)</p>
                <p class="evidence-finding">@(Failure ?? L["Workbench:Operation:Readiness"].Value)</p>
                @if (Failure is not null) { <p class="evidence-warning">@L["Workbench:Operation:Partial"]</p> }
            </div>
        </div>
        @if (Failure is null)
        {
            <details class="evidence-disclosure">
                <summary>@L["Workbench:Operation:Details"]</summary>
                <div class="operation-details">
                    <dl class="evidence-facts">
                        <div><dt>@L["Workbench:Operation:Targets"]</dt><dd>@(Restart?.AffectedTargets.Count ?? Scale?.AffectedTargets.Count ?? 0)</dd></div>
                        <div><dt>@L["Workbench:Operation:Workloads"]</dt><dd>@(Restart?.Workloads.Count ?? Scale?.Workloads.Count ?? 0)</dd></div>
                        <div><dt>@L["Workbench:Operation:Commands"]</dt><dd>@(Restart?.ExecutedCommands.Count ?? Scale?.ExecutedCommands.Count ?? 0)</dd></div>
                    </dl>
                    <section>
                        <h3>@L["Workbench:Operation:Targets"]</h3>
                        <ul class="evidence-list">@foreach (var target in Restart?.AffectedTargets ?? Scale?.AffectedTargets ?? []) { <li>@target</li> }</ul>
                    </section>
                    <section>
                        <h3>@L["Workbench:Operation:Workloads"]</h3>
                        <ul class="evidence-list evidence-list--workloads">
                            @foreach (var workload in Restart?.Workloads ?? []) { <li><span>@workload.DisplayName</span><span class="workload-replicas">@workload.ReplicaStatus</span></li> }
                            @foreach (var workload in Scale?.Workloads ?? [])
                            {
                                <li><span>@workload.Kind/@workload.Name</span><span class="workload-replicas">@L["OperationReview:ReplicaChange"]: @workload.CurrentReplicas → @workload.TargetReplicas<small>@L["OperationReview:RecordedReplicas"]: @(workload.PreviousReplicas?.ToString() ?? L["Common:Empty"].Value)</small></span></li>
                            }
                        </ul>
                    </section>
                    @if ((Restart?.IgnoredTargets.Count ?? Scale?.IgnoredTargets.Count ?? 0) > 0)
                    {
                        <section>
                            <h3>@L["Workbench:Operation:Ignored"]</h3>
                            <ul class="evidence-list">
                                @foreach (var target in Restart?.IgnoredTargets ?? []) { <li><span>@target.DisplayName</span><small>@target.Reason</small></li> }
                                @foreach (var target in Scale?.IgnoredTargets ?? []) { <li><span>@target.DisplayName</span><small>@target.Reason</small></li> }
                            </ul>
                        </section>
                    }
                    <section>
                        <h3>@L["Workbench:Operation:Commands"]</h3>
                        <div class="executed-commands"><pre>@string.Join(Environment.NewLine, Restart?.ExecutedCommands ?? Scale?.ExecutedCommands ?? [])</pre></div>
                    </section>
                </div>
            </details>
        }
    </section>
</div>

@code {
    /// <summary>The actual completed restart result, when this operation restarted workloads.</summary>
    [Parameter] public K8SRestartResult? Restart { get; set; }
    /// <summary>The actual completed scale result, when this operation changed replicas.</summary>
    [Parameter] public K8SScaleResult? Scale { get; set; }
    /// <summary>The actual failed command envelope message; partial effects are unknown.</summary>
    [Parameter] public string? Failure { get; set; }
    /// <summary>The captured operation namespace.</summary>
    [Parameter] public string Namespace { get; set; } = string.Empty;
    /// <summary>The actual backend scope for completed commands, or localized attempted request scope on failure.</summary>
    [Parameter] public string Scope { get; set; } = string.Empty;
    /// <summary>The backend completion time or failed attempt completion time.</summary>
    [Parameter] public DateTimeOffset CompletedAt { get; set; }
}
