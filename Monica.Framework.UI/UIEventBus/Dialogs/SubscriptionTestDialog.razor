@using Monica.UI.Shared.Components.Json
@using Monica.UI.Shared.Components.States
@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.Core.Results
@using Monica.EventBus.Models
@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.State
@using Monica.Framework.UI.UIEventBus.Support
@using Monica.UI.Shared.Components.Dialogs
@implements IAsyncDisposable
@inject EventBusTestService TestService
@inject ISnackbar Snackbar
@inject IStringLocalizer<EventBusResource> L

<MudDialog>
    <TitleContent><MoDialogHeading Text="@L["SubscriptionTestDialog:Title", _subscription?.EventTypeShortName ?? L["Shared:Labels:Unknown"].Value]" /></TitleContent>
    <DialogContent>
        <div class="runtime-test">
            @if (_subscription is null || _subscriptionId is null)
            {
                <MoContentState Compact="true"><MoIcon Icon="@MoIcons.Info" Size="1.5rem" /><p>@L["SubscriptionTestDialog:States:NotSelected"]</p></MoContentState>
            }
            else
            {
                <header class="runtime-test-target">
                    <div class="runtime-test-target-title"><span>@L["RuntimeTest:Target"]</span><h2>@_subscription.EventTypeShortName</h2><code>@_subscription.EventType</code></div>
                    <dl>
                        <div><dt>@L["SubscriptionTestDialog:Fields:TopicName"]</dt><dd><code>@_subscription.TopicName</code></dd></div>
                        <div><dt>@L["SubscriptionTestDialog:Fields:Scope"]</dt><dd>@L.GetSubscriptionScopeText(_subscription.Scope)</dd></div>
                        <div><dt>@L["SubscriptionTestDialog:Fields:Provider"]</dt><dd><code>@ProviderKey</code></dd></div>
                        <div><dt>@L["SubscriptionTestDialog:Fields:Handler"]</dt><dd><code>@L.GetHandlerDisplayText(_subscription)</code></dd></div>
                    </dl>
                </header>
                <div class="runtime-test-warning"><MoIcon Icon="@MoIcons.Info" Size="1.25rem" /><p>@L["RuntimeTest:Fanout"]</p></div>
                <div class="runtime-test-workspace">
                    <section class="runtime-test-publish">
                        <header class="runtime-test-heading"><span>01</span><div><h3>@L["RuntimeTest:Compose"]</h3><p>@L["RuntimeTest:ValidationHelp"]</p></div></header>
                        <div class="runtime-test-editor">
                            <MoJson @bind-Value="_jsonPayload" ReadOnly="false" Rows="12" Label="@L["SubscriptionTestDialog:Fields:JsonSample"]" Disabled="@(Inactive || _commandBusy || _replayLocalMessage)" />
                            @if (!string.IsNullOrWhiteSpace(_validationMessage))
                            {
                                <p class="runtime-test-validation" data-error="@(_hasValidationError ? "true" : "false")" role="status">@_validationMessage</p>
                            }
                            <div class="runtime-test-editor-actions">
                                <div><MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ValidateJson" Disabled="@Inactive" aria-disabled="@BusyAttribute">@L["SubscriptionTestDialog:Actions:ValidateJson"]</MudButton><MudButton Color="Color.Default" OnClick="LoadSampleJson" Disabled="@Inactive" aria-disabled="@BusyAttribute">@L["SubscriptionTestDialog:Actions:ResetSample"]</MudButton></div>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Send" OnClick="PublishAsync" Disabled="@Inactive" aria-disabled="@BusyAttribute" aria-busy="@(_publishing ? "true" : "false")">@(_publishing ? L["SubscriptionTestDialog:Actions:Publishing"] : L["SubscriptionTestDialog:Actions:PublishEvent"])</MudButton>
                            </div>
                            <p class="runtime-test-note">@L["RuntimeTest:AcceptanceHelp"]</p>
                            <MudDivider />
                            <p class="runtime-test-note">@L["RuntimeTest:LocalDeliveryHelp"]</p>
                            <MudCheckBox T="bool" Value="_replayLocalMessage" ValueChanged="SetReplayLocalMessage" Label="@L["RuntimeTest:ReplayMessage"]" Disabled="@(Inactive || _commandBusy || _localMessage is null)" />
                            @if (_localMessage is not null)
                            {
                                <p class="runtime-test-note">@L["RuntimeTest:MessageIdentity", _localMessage.Metadata.MessageId ?? string.Empty]</p>
                            }
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.Play" OnClick="DeliverLocallyAsync" Disabled="@(Inactive || _commandBusy || !_subscription.CanDeliverLocally)" aria-busy="@(_deliveringLocally ? "true" : "false")">@(_deliveringLocally ? L["RuntimeTest:DeliveringLocally"] : L["RuntimeTest:DeliverLocally"])</MudButton>
                            @if (!_subscription.CanDeliverLocally)
                            {
                                <p class="runtime-test-note">@L["Services:Test:LocalTargetUnavailable"]</p>
                            }
                        </div>
                    </section>
                    <section class="runtime-test-receive">
                        <header class="runtime-test-heading"><span>02</span><div><h3>@L["RuntimeTest:Receive"]</h3><p>@L["RuntimeTest:ReceiveHelp"]</p></div><span class="runtime-test-listener-state" data-listening="@(_listenerSnapshot.IsListening ? "true" : "false")">@(_listenerSnapshot.IsListening ? L["TestBench:Listening"] : L["TestBench:Stopped"])</span></header>
                        <div class="runtime-test-listener-actions">
                            <MudButton Variant="Variant.Outlined" Color="@(_listenerSnapshot.IsListening ? Color.Warning : Color.Primary)" StartIcon="@(_listenerSnapshot.IsListening ? MoIcons.StopCircle : MoIcons.Play)" OnClick="ToggleListeningAsync" Disabled="@(Inactive || (!_listenerSnapshot.IsListening && _subscription.Activation != Monica.Core.TypeDiscovery.Abstractions.ActivationMode.Automatic))" aria-disabled="@BusyAttribute" aria-busy="@(_listenerBusy ? "true" : "false")">@(_listenerSnapshot.IsListening ? L["SubscriptionTestDialog:Actions:StopListening"] : L["SubscriptionTestDialog:Actions:StartListening"])</MudButton>
                            <MudButton Color="Color.Default" OnClick="ClearMessages" Disabled="@Inactive" aria-disabled="@(_commandBusy || _listenerSnapshot.MessageCount == 0 ? "true" : "false")">@L["SubscriptionTestDialog:Actions:Clear"]</MudButton>
                        </div>
                        <div class="runtime-test-retained"><strong>@L["TestBench:Retained", _listenerSnapshot.MessageCount]</strong>@if (_listenerSnapshot.StartedAt is { } startedAt) { <span>@L["RuntimeTest:Started", UiTime.FormatTime(startedAt)]</span> }</div>
                        @if (_listenerSnapshot.MessageCount == 0)
                        {
                            <div class="runtime-test-empty"><MoIcon Icon="@MoIcons.Inbox" Size="1.5rem" /><h4>@L["SubscriptionTestDialog:States:NoMessages"]</h4><p>@L["RuntimeTest:EmptyHelp"]</p></div>
                        }
                        else
                        {
                            <ol class="runtime-test-receipts">
                                @foreach (var message in _listenerSnapshot.Messages.Reverse())
                                {
                                    <li @key="message">
                                        <header><span><MoIcon Icon="@MoIcons.ArrowDownLeft" Size="1.25rem" />@L["TestBench:Received"]</span><time>@UiTime.FormatTime(message.ReceivedAt)</time></header>
                                        <dl><div><dt>@L["SubscriptionTestDialog:Fields:TopicName"]</dt><dd><code>@message.TopicName</code></dd></div><div><dt>@L["SubscriptionTestDialog:Fields:EventType"]</dt><dd><code>@message.EventType</code></dd></div></dl>
                                        <MoJson Value="@message.PayloadJson" ShowLineNumbers="false" />
                                    </li>
                                }
                            </ol>
                        }
                        <footer class="runtime-test-listener-help"><MoIcon Icon="@MoIcons.Info" Size="1.25rem" /><p>@L["RuntimeTest:ListenerLifetime"]</p></footer>
                    </section>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions><MudButton Color="Color.Default" OnClick="Close">@L["SubscriptionTestDialog:Actions:Close"]</MudButton></DialogActions>
</MudDialog>

@code {
    /// <summary>Gets or sets the registry row whose exact event, topic, scope and key are captured for this test.</summary>
    /// <remarks>
    /// Diagnostic payloads are sent immediately through the selected transport or local dispatcher, without
    /// Outbox staging. The scoped test service owns the listener after this dialog closes; the dialog owns
    /// cancellation and draining of its admitted commands and rendering timer.
    /// </remarks>
    [Parameter] public SubscriptionViewModel? Subscription { get; set; }
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = null!;

    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly object _disposeSync = new();
    private CancellationToken _lifetimeToken;
    private PeriodicTimer? _refreshTimer;
    private Task? _refreshTask;
    private Task? _commandTask;
    private Task? _disposeTask;
    private SubscriptionViewModel? _subscription;
    private EventSubscriptionId? _subscriptionId;
    private RuntimeTestListenerSnapshot _listenerSnapshot = new();
    private string _jsonPayload = "{}";
    private string? _validationMessage;
    private bool _hasValidationError;
    private bool _commandBusy;
    private bool _publishing;
    private bool _deliveringLocally;
    private bool _replayLocalMessage;
    private EventMessage? _localMessage;
    private bool _listenerBusy;
    private bool _closed;
    private bool _retired;
    private bool Inactive => _retired || _closed;
    private string BusyAttribute => _commandBusy ? "true" : "false";
    private string ProviderKey => EventBusPresentation.KeyText(_subscription?.ServiceKey, L);

    protected override void OnInitialized()
    {
        _lifetimeToken = _lifetimeCancellation.Token;
        _subscription = Subscription is null ? null : EventBusWorkbenchState.CloneSubscription(Subscription);
        if (_subscription is not null && Guid.TryParse(_subscription.SubscriptionId, out var id))
        {
            _subscriptionId = new EventSubscriptionId(id);
            LoadSampleJson();
            RefreshListenerSnapshot();
            _refreshTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
            _refreshTask = RefreshLoopAsync(_refreshTimer, _lifetimeToken);
        }
    }

    private void LoadSampleJson()
    {
        if (Inactive || _commandBusy || _replayLocalMessage || _subscriptionId is not { } id) return;
        if (TestService.CreateRuntimeJsonSample(id).IsFailed(out var error, out var sample))
        {
            _jsonPayload = "{}";
            _hasValidationError = true;
            _validationMessage = error.Message;
            return;
        }
        _jsonPayload = sample ?? "{}";
        _hasValidationError = false;
        _validationMessage = L["SubscriptionTestDialog:Messages:SampleGenerated"];
    }

    private void ValidateJson()
    {
        if (Inactive || _commandBusy || _subscriptionId is not { } id) return;
        if (TestService.ValidateRuntimePayload(id, _jsonPayload).IsFailed(out var error))
        {
            _hasValidationError = true;
            _validationMessage = error.Message ?? L["SubscriptionTestDialog:Messages:JsonValidationFailed"];
            Snackbar.Add(_validationMessage, Severity.Error);
            return;
        }
        _hasValidationError = false;
        _validationMessage = L["SubscriptionTestDialog:Messages:JsonValidationSucceeded"];
        Snackbar.Add(_validationMessage, Severity.Success);
    }

    private Task PublishAsync()
    {
        if (Inactive || _commandBusy || _subscriptionId is not { } id) return Task.CompletedTask;
        var payload = _jsonPayload;
        _publishing = true;
        return AdmitCommandAsync(async () =>
        {
            var result = await TestService.PublishRuntimePayloadAsync(id, payload, _lifetimeToken);
            if (Inactive) return;
            if (result.IsFailed(out var error))
            {
                _hasValidationError = true;
                _validationMessage = error.Message ?? L["SubscriptionTestDialog:Messages:PublishFailed"];
                Snackbar.Add(_validationMessage, Severity.Error);
                return;
            }
            _hasValidationError = false;
            _validationMessage = L["TestBench:Accepted"];
            Snackbar.Add(L["TestBench:Accepted"], Severity.Success);
        });
    }

    private Task ToggleListeningAsync() => _listenerSnapshot.IsListening ? StopListeningAsync() : StartListeningAsync();

    private void SetReplayLocalMessage(bool replay)
    {
        if (Inactive || _commandBusy) return;
        _replayLocalMessage = replay && _localMessage is not null;
        if (_replayLocalMessage) _jsonPayload = System.Text.Encoding.UTF8.GetString(_localMessage!.Body.Span);
    }

    private Task DeliverLocallyAsync()
    {
        if (Inactive || _commandBusy || _subscription?.CanDeliverLocally != true || _subscriptionId is not { } id)
            return Task.CompletedTask;
        if (!_replayLocalMessage)
        {
            if (TestService.PrepareLocalTestMessage(id, _jsonPayload).IsFailed(out var error, out var prepared))
            {
                _hasValidationError = true;
                _validationMessage = error.Message;
                return Task.CompletedTask;
            }
            _localMessage = prepared;
        }
        if (_localMessage is not { } message) return Task.CompletedTask;
        _deliveringLocally = true;
        return AdmitCommandAsync(async () =>
        {
            var result = await TestService.DeliverLocalTestMessageAsync(id, message, _lifetimeToken);
            if (Inactive) return;
            if (result.IsFailed(out var error))
            {
                _hasValidationError = true;
                _validationMessage = error.Message;
            }
            else
            {
                _hasValidationError = false;
                _validationMessage = L["RuntimeTest:LocalDeliveryCompleted"];
            }
            Snackbar.Add(_validationMessage ?? string.Empty, _hasValidationError ? Severity.Error : Severity.Success);
        });
    }

    private Task StartListeningAsync()
    {
        if (Inactive || _commandBusy || _listenerSnapshot.IsListening || _subscriptionId is not { } id) return Task.CompletedTask;
        _listenerBusy = true;
        return AdmitCommandAsync(async () =>
        {
            var result = await TestService.StartRuntimeListenerAsync(id);
            // The scoped service owns this listener, including a start completed after close.
            if (Inactive) return;
            if (result.IsFailed(out var error, out var snapshot))
            {
                Snackbar.Add(error.Message ?? L["SubscriptionTestDialog:Messages:StartListeningFailed"], Severity.Error);
                return;
            }
            _listenerSnapshot = snapshot ?? new();
            Snackbar.Add(L["SubscriptionTestDialog:Messages:StartListeningSucceeded"], Severity.Success);
        });
    }

    private Task StopListeningAsync()
    {
        if (Inactive || _commandBusy || !_listenerSnapshot.IsListening || _subscriptionId is not { } id) return Task.CompletedTask;
        _listenerBusy = true;
        return AdmitCommandAsync(async () =>
        {
            var result = await TestService.StopRuntimeListenerAsync(id);
            if (Inactive) return;
            if (result.IsFailed(out var error))
            {
                Snackbar.Add(error.Message ?? L["SubscriptionTestDialog:Messages:StopListeningFailed"], Severity.Error);
                return;
            }
            RefreshListenerSnapshot();
            Snackbar.Add(L["SubscriptionTestDialog:Messages:StopListeningSucceeded"], Severity.Info);
        });
    }

    private Task AdmitCommandAsync(Func<Task> command)
    {
        if (Inactive || _commandBusy) return Task.CompletedTask;
        _commandBusy = true;
        return _commandTask = ExecuteCommandAsync(command);
    }

    private async Task ExecuteCommandAsync(Func<Task> command)
    {
        try { await command(); }
        finally
        {
            _commandBusy = false;
            _publishing = false;
            _deliveringLocally = false;
            _listenerBusy = false;
            if (!Inactive) StateHasChanged();
        }
    }

    private void ClearMessages()
    {
        if (Inactive || _commandBusy || _listenerSnapshot.MessageCount == 0 || _subscriptionId is not { } id) return;
        TestService.ClearRuntimeListenerMessages(id);
        RefreshListenerSnapshot();
        Snackbar.Add(L["SubscriptionTestDialog:Messages:ClearSucceeded"], Severity.Info);
    }

    private void RefreshListenerSnapshot()
    {
        if (_subscriptionId is { } id) _listenerSnapshot = TestService.GetRuntimeListenerSnapshot(id);
    }

    private async Task RefreshLoopAsync(PeriodicTimer timer, CancellationToken token)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(() =>
                {
                    if (Inactive || token.IsCancellationRequested) return;
                    RefreshListenerSnapshot();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested)
        {
            // Only the rendering timer belongs to the dialog; runtime listeners belong to the service.
        }
    }

    private void Close()
    {
        if (Inactive) return;
        _closed = true;
        MudDialog.Close();
    }

    public ValueTask DisposeAsync()
    {
        lock (_disposeSync) return new(_disposeTask ??= RetireAsync());
    }

    private async Task RetireAsync()
    {
        _retired = true;
        var failures = new List<Exception>();
        var timer = _refreshTimer;
        var refresh = _refreshTask;
        _refreshTimer = null;
        _refreshTask = null;
        try
        {
            try { _lifetimeCancellation.Cancel(); }
            catch (Exception error) { failures.Add(error); }
            try { timer?.Dispose(); }
            catch (Exception error) { failures.Add(error); }
            if (_commandTask is not null)
            {
                try { await _commandTask; }
                catch (OperationCanceledException) when (_lifetimeToken.IsCancellationRequested) { }
                catch (Exception error) { failures.Add(error); }
            }
            if (refresh is not null)
            {
                try { await refresh; }
                catch (Exception error) { failures.Add(error); }
            }
        }
        finally { _lifetimeCancellation.Dispose(); }
        if (failures.Count > 0) throw new AggregateException(failures);
    }
}
