@implements IDisposable
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IStringLocalizer<SeederResource> L

<button type="button" class="seeder-copy-button @(ChildContent is null ? "is-icon" : null)"
        aria-label="@Label" title="@Label" disabled="@_copying" @onclick="CopyAsync">
    @ChildContent
    <MoIcon Icon="@MoIcons.Copy" Size="13px" />
</button>

@code {
    /// <summary>Gets the exact text written to the clipboard.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    /// <summary>Gets the localized name of the copy action.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>Gets optional chip content preceding the copy icon.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private readonly CancellationTokenSource _lifetime = new();
    private bool _copying;

    private async Task CopyAsync()
    {
        if (_copying || _lifetime.IsCancellationRequested)
        {
            return;
        }

        _copying = true;
        var cancellationToken = _lifetime.Token;
        try
        {
            var copied = await JS.InvokeAsync<bool>("MoClipboard.copyText", cancellationToken, Text);
            if (!cancellationToken.IsCancellationRequested)
            {
                Snackbar.Add(L[copied ? "Actions:Copied" : "Actions:CopyFailed"], copied ? Severity.Success : Severity.Warning);
            }
        }
        catch (JSDisconnectedException)
        {
            // The owner has no connected browser to receive feedback.
        }
        catch (JSException) when (!cancellationToken.IsCancellationRequested)
        {
            Snackbar.Add(L["Actions:CopyFailed"], Severity.Warning);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The owning page or sheet retired the copy action.
        }
        finally
        {
            _copying = false;
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
