{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ordering": {
    "MaximumOrdersReturned": 100,
    "BacklogWarningThreshold": 10
  },
  "Deployment": {
    "Applications": {
      "monica-ordering-reference": {
        "Roles": ["ordering", "ordering.reporting"]
      }
    }
  },
  "AllowedHosts": "*"
}
