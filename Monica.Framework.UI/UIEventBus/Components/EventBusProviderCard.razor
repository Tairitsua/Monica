@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.Support
@inject IStringLocalizer<EventBusResource> L

<article class="provider-card">
    <header>@if (L.GetProviderModeText(Provider.IsDistributed) != L.GetProviderKindText(Provider.ProviderType)) { <EventBusStatusBadge Tone="@(Provider.IsDistributed ? Color.Secondary : Color.Info)">@L.GetProviderModeText(Provider.IsDistributed)</EventBusStatusBadge> }<h3 title="@Provider.ImplementationType">@L.GetProviderKindText(Provider.ProviderType)</h3><code>@EventBusPresentation.KeyText(Provider.ServiceKey, L)</code></header>
    <dl><div><dt>@L["ProviderDirectory:Registrations"]</dt><dd>@Provider.SubscriptionCount</dd></div><div><dt>@L["ProviderDirectory:Active"]</dt><dd>@Provider.ActiveSubscriptionCount</dd></div><div><dt>@L["ProviderDirectory:ReportedProblems"]</dt><dd>@Provider.UnhealthyTopicCount</dd></div></dl>
    <div class="provider-card-capabilities">
        @if (Provider.SupportsBulkPublish) { <span>@L["Providers:Capabilities:BulkPublish"]</span> }
        @if (Provider.SupportsStreaming) { <span>@L["Providers:Capabilities:Streaming"]</span> }
        @if (Provider.SupportsDeadLetterQueue) { <span>@L["Providers:Capabilities:DeadLetterQueue"]</span> }
        @if (Provider.HasOptionDiagnostics) { <span>@L["Providers:Capabilities:HasOptions"]</span> }
    </div>
    <MudButton Color="Color.Primary" EndIcon="@MoIcons.ArrowRight" OnClick="() => OnViewDetailsClicked.InvokeAsync(Provider)">@L["Providers:Card:ViewDetails"]</MudButton>
</article>

@code {
    /// <summary>Gets or sets the read-only captured provider registration and declared capabilities.</summary>
    [Parameter, EditorRequired] public EventBusProviderInfo Provider { get; set; } = null!;
    /// <summary>Gets or sets the owning caller's inspection action; the caller owns any resulting dialog lifetime.</summary>
    [Parameter] public EventCallback<EventBusProviderInfo> OnViewDetailsClicked { get; set; }
}
