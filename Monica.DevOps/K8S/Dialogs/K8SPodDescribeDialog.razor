@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.DevOps.Localization
@using Monica.DevOps.K8S.Models
@using Monica.UI.Shared.Components.Dialogs
@implements IAsyncDisposable
@inject IStringLocalizer<K8SResource> L

<MudDialog DefaultFocus="DefaultFocus.Element">
    <TitleContent><MoDialogHeading @ref="_heading" Text="@L["PodDialog:Title", PodName, NamespaceName]" /></TitleContent>
    <DialogContent>
        <div class="k8s-pod-inspector">
            <MudTabs Elevation="0" Rounded="false" KeepPanelsAlive="true" PrevIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight">
                <MudTabPanel Text="@L["Inspector:Summary"]">
                    <div class="tab-body">
                        <dl class="facts">
                            <dt>@L["PodDialog:Pod"]</dt><dd>@PodName</dd>
                            <dt>@L["PodDialog:Namespace"]</dt><dd>@NamespaceName</dd>
                            <dt>@L["PodDialog:Workload"]</dt><dd>@GetResolvedWorkload()</dd>
                            <dt>@L["PodDialog:ReportedOwner"]</dt><dd>@GetIdentity(Details.Summary.OwnerKind, Details.Summary.OwnerName)</dd>
                            <dt>@L["PodDialog:Phase"]</dt><dd><MudChip T="string" Color="@GetPhaseColor()" Variant="Variant.Outlined" Size="Size.Small" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@Details.Summary.PhaseDisplay</MudChip></dd>
                            <dt>@L["PodDialog:Ready"]</dt><dd><span>@Details.Summary.ReadyDisplay</span><MudChip T="string" Color="@(Details.Summary.IsReady ? Color.Success : Color.Warning)" Variant="Variant.Outlined" Size="Size.Small" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@(Details.Summary.IsReady ? L["DescribeDialog:ReadyStateReady"] : L["DescribeDialog:ReadyStateNotReady"])</MudChip></dd>
                            <dt>@L["PodDialog:Restarts"]</dt><dd>@Details.Summary.RestartCount</dd>
                            <dt>@L["PodDialog:Started"]</dt><dd>@UiTime.Format(Details.Summary.StartTimeUtc)</dd>
                            <dt>@L["PodDialog:Node"]</dt><dd>@DisplayValue(Details.Summary.NodeName)</dd>
                            <dt>@L["PodDialog:PodIp"]</dt><dd>@DisplayValue(Details.Summary.PodIp)</dd>
                            <dt>@L["PodDialog:Issue"]</dt><dd>@DisplayValue(Details.Summary.IssueSummary)</dd>
                        </dl>
                        @if (Details.Summary.HasIssue)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@MoIcons.Warning">@L["PodDialog:Attention"]</MudAlert>
                        }
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="@L["Inspector:Describe"]"><div class="tab-body"><div class="describe-output"><pre>@Details.DescriptionText</pre></div></div></MudTabPanel>
            </MudTabs>
        </div>
    </DialogContent>
    <DialogActions><MudButton Variant="Variant.Text" OnClick="Close">@L["Common:Close"]</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    /// <summary>Gets or sets exact provider evidence for this Pod.</summary>
    [Parameter] public K8SPodDetails Details { get; set; } = new();
    /// <summary>Gets or sets the parent inspector's resolved workload kind, independently of the reported owner.</summary>
    [Parameter] public string ResolvedWorkloadKind { get; set; } = string.Empty;
    /// <summary>Gets or sets the parent inspector's resolved workload name.</summary>
    [Parameter] public string ResolvedWorkloadName { get; set; } = string.Empty;
    /// <summary>Gets or sets the namespace captured before the Pod read.</summary>
    [Parameter] public string CapturedNamespace { get; set; } = string.Empty;
    /// <summary>Gets or sets the Pod name captured before the Pod read.</summary>
    [Parameter] public string CapturedPodName { get; set; } = string.Empty;
    private MoDialogHeading? _heading;
    private string PodName => string.IsNullOrWhiteSpace(CapturedPodName) ? Details.Summary.Name : CapturedPodName;
    private string NamespaceName => string.IsNullOrWhiteSpace(CapturedNamespace) ? Details.Summary.Namespace : CapturedNamespace;
    private void Close() => MudDialog?.Close();
    /// <summary>Drains the accessible heading's actual interop before the owned native result escapes.</summary>
    public ValueTask DisposeAsync() => _heading?.DisposeAsync() ?? ValueTask.CompletedTask;
    private Color GetPhaseColor() => Details.Summary.Phase.ToLowerInvariant() switch
    {
        "running" => Color.Info, "succeeded" => Color.Success, "pending" => Color.Warning, "failed" => Color.Error, _ => Color.Default
    };
    private string GetResolvedWorkload() => !string.IsNullOrWhiteSpace(ResolvedWorkloadKind) && !string.IsNullOrWhiteSpace(ResolvedWorkloadName)
        ? GetIdentity(ResolvedWorkloadKind, ResolvedWorkloadName) : GetIdentity(Details.Summary.WorkloadKind, Details.Summary.WorkloadName);
    private string DisplayValue(string value) => string.IsNullOrWhiteSpace(value) ? L["Common:Empty"].Value : value;
    private string GetIdentity(string kind, string name) => string.IsNullOrWhiteSpace(kind) || string.IsNullOrWhiteSpace(name) ? L["Common:Empty"].Value : $"{GetLocalizedKind(kind)}/{name}";
    private string GetLocalizedKind(string kind) => kind switch
    {
        "Service" => L["ResourceTypes:Service"].Value, "Deployment" => L["ResourceTypes:Deployment"].Value,
        "StatefulSet" => L["ResourceTypes:StatefulSet"].Value, "DaemonSet" => L["ResourceTypes:DaemonSet"].Value, _ => kind
    };
}
