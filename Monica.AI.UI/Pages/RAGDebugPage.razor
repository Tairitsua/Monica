@attribute [Route(PAGE_URL)]
@rendermode InteractiveServer
@using Monica.AI.KnowledgeBase.Facades
@using Monica.AI.RAG.Models
@using Monica.AI.RAG.Facades
@using Monica.AI.UI.Shared.Components
@using Monica.AI.UI.Localization
@using Monica.Core.Results;
@using Microsoft.Extensions.Localization
@using KnowledgeBaseModel = Monica.AI.KnowledgeBase.Models.KnowledgeBase
@inject RAGSearchFacade SearchFacade
@inject RAGIndexingFacade IndexingFacade
@inject KnowledgeBaseFacade KnowledgeBaseFacade
@inject EmbeddingModelFacade EmbeddingService
@inject IAIProviderFactory ProviderFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<AIResource> L

<PageTitle>@L["KnowledgeWorkbench:Retrieval:Title"]</PageTitle>

<div class="rag-debug-page">
    <KnowledgeRagHeader Title="@L["KnowledgeWorkbench:Retrieval:Title"]" Description="@L["KnowledgeWorkbench:Retrieval:Description"]" CurrentRoute="@PAGE_URL" />
    @if (_isLoading)
    {
        <MoContentState Loading="true"><MudProgressCircular Indeterminate="true" Size="Size.Small" /> @L["KnowledgeWorkbench:Retrieval:Loading"]</MoContentState>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_loadError <MudButton OnClick="LoadAsync">@L["KnowledgeWorkbench:Retrieval:Retry"]</MudButton></MudAlert>
    }
    else if (_knowledgeBases.Count == 0)
    {
        <div class="empty-state"><MoContentState><MoIcon Icon="@MoIcons.Database" Size="1.5rem" /><h2>@L["KnowledgeWorkbench:Retrieval:NoSources"]</h2><p>@L["KnowledgeWorkbench:Retrieval:NoSourcesHint"]</p><MudButton Href="/ai/knowledge-bases" Color="Color.Primary">@L["KnowledgeWorkbench:Retrieval:OpenSources"]</MudButton></MoContentState></div>
    }
    else
    {
        <div class="retrieval-grid">
            <aside class="scope-panel">
                <div class="scope-desktop">@ScopeContents</div>
                <details class="scope-disclosure" open="@_scopeOpen">
                    <summary @onclick="ToggleScope" @onclick:preventDefault="true">@L["KnowledgeWorkbench:Retrieval:SourcesSelected", _selectedKbIds.Count]</summary>
                    @ScopeContents
                </details>
            </aside>
            <main class="retrieval-main">
                <section class="query-workbench">
                    <h2>@L["KnowledgeWorkbench:Retrieval:Ask"]</h2>
                    <MudTextField T="string" @bind-Value="_searchQuery" Label="@L["RAG:Search:QueryLabel"]" Placeholder="@L["RAG:Search:Placeholder"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" OnKeyDown="HandleSearchKeyDown" />
                    <div class="query-settings">
                        <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="int" @bind-Value="_topK" Label="@L["RAG:Search:TopK"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var value in new[] { 3, 5, 10, 20 }) { <MudSelectItem T="int" Value="@value">@value</MudSelectItem> }
                        </MudSelect>
                        <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="string" Value="@_selectedEmbeddingModelKey" ValueChanged="OnEmbeddingModelChanged" Label="@L["KnowledgeWorkbench:Retrieval:QueryOverride"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@(string.Empty)">@L["KnowledgeWorkbench:Retrieval:UseOwnModel"]</MudSelectItem>
                            @foreach (var model in _embeddingModels)
                            {
                                <MudSelectItem T="string" Value="@model.ModelKey">@model.ModelName · @model.ProviderDisplayName · @L["RAG:EmbeddingModel:Dimensions", model.Dimensions?.ToString() ?? L["KnowledgeWorkbench:Retrieval:UnknownDimensions"].Value]</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                    <p class="query-note">@L["KnowledgeWorkbench:Retrieval:OverrideHint"]</p>
                    @if (!string.IsNullOrWhiteSpace(_modelError)) { <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error" Dense="true">@_modelError</MudAlert> }
                    @if (!string.IsNullOrEmpty(_embeddingWarningMessage)) { <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning" Dense="true">@_embeddingWarningMessage</MudAlert> }
                    <div class="run-row"><span>@L["KnowledgeWorkbench:Retrieval:SelectedCount", _selectedKbIds.Count]</span><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Search" OnClick="HandleSearch" Disabled="@(_isSearching || string.IsNullOrWhiteSpace(_searchQuery) || _selectedKbIds.Count == 0)">@(_isSearching ? L["RAG:Search:Searching"] : L["RAG:Search:Go"])</MudButton></div>
                    <p class="query-note">@L["KnowledgeWorkbench:Retrieval:CoverageHint"]</p>
                </section>
                <section class="results-region" aria-live="polite">
                    @if (_submitted is not null)
                    {
                        <div class="submitted-request"><h2>@L["KnowledgeWorkbench:Retrieval:SubmittedRequest"]</h2><p class="submitted-query">@_submitted.Query</p><p>@L["KnowledgeWorkbench:Retrieval:RequestedScope", _submitted.Ids.Length, string.Join(", ", _submitted.Names)]</p><p>@L["KnowledgeWorkbench:Retrieval:RequestSettings", _submitted.TopK, _submitted.ModelDisplay]</p></div>
                        @if (InputsChanged) { <MudAlert Icon="@MoIcons.Info" Severity="Severity.Info" Dense="true">@L["KnowledgeWorkbench:Retrieval:InputsChanged"]</MudAlert> }
                    }
                    @if (_isSearching) { <MoContentState Loading="true"><MudProgressCircular Indeterminate="true" Size="Size.Small" /> @L["RAG:Search:Searching"]</MoContentState> }
                    else if (!string.IsNullOrWhiteSpace(_searchErrorMessage)) { <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_searchErrorMessage</MudAlert> }
                    else if (_searchResults.Count > 0)
                    {
                        <h2>@L["KnowledgeWorkbench:Retrieval:ReturnedCount", _searchResults.Count]</h2>
                        <ol class="search-results">
                            @for (var index = 0; index < _searchResults.Count; index++)
                            {
                                var result = _searchResults[index];
                                <li><SearchResultCard Result="@result" Rank="@(index + 1)" KnowledgeBaseName="@GetResultBaseName(result)" OnClick="@(() => ShowChunkViewer(result))" /></li>
                            }
                        </ol>
                    }
                    else if (_submitted is not null) { <div class="empty-state"><MoContentState><h2>@L["KnowledgeWorkbench:Retrieval:NoChunks"]</h2><p>@L["KnowledgeWorkbench:Retrieval:NoChunksHint"]</p></MoContentState></div> }
                    else { <div class="empty-state"><MoContentState><MoIcon Icon="@MoIcons.Search" Size="1.5rem" /><h2>@L["KnowledgeWorkbench:Retrieval:InitialTitle"]</h2><p>@L["KnowledgeWorkbench:Retrieval:InitialHint"]</p></MoContentState></div> }
                </section>
            </main>
        </div>
    }
</div>

@code {
    private RenderFragment ScopeContents => @<div class="scope-body">
                        <h2>@L["RAG:Debug:KBSidebar:Title"]</h2>
                        <MudTextField T="string" @bind-Value="_scopeFilter" Immediate="true" Label="@L["KnowledgeWorkbench:Retrieval:FilterSources"]" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" />
                        <div class="scope-actions"><MudButton Size="Size.Small" OnClick="SelectAllKBs">@L["RAG:Debug:KBSidebar:SelectAll"]</MudButton><MudButton Size="Size.Small" OnClick="DeselectAllKBs">@L["RAG:Debug:KBSidebar:DeselectAll"]</MudButton></div>
                        <div class="scope-list">
                            @foreach (var kb in VisibleBases)
                            {
                                <div class="scope-row" @key="kb.Id">
                                    <MudCheckBox CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="bool" Value="@_selectedKbIds.Contains(kb.Id)" ValueChanged="@((bool selected) => OnKBCheckChanged(kb.Id, selected))" Dense="true">
                                        <div class="scope-info"><strong>@kb.Name</strong><code>@kb.Id</code>
                                            @if (!string.IsNullOrWhiteSpace(kb.Description)) { <p>@kb.Description</p> }
                                            <span>@L["RAG:Debug:KBSidebar:Stats", kb.DocumentCount, kb.ChunkCount]</span>
                                            <span>@(HasEmbeddingBinding(kb) ? GetKnowledgeBaseModelDisplay(kb) : L["KnowledgeWorkbench:Retrieval:Unbound"].Value)</span>
                                        </div>
                                    </MudCheckBox>
                                </div>
                            }
                            @if (!VisibleBases.Any()) { <MoContentState Compact="true">@L["KnowledgeWorkbench:Retrieval:NoScopeMatch"]</MoContentState> }
                        </div>
                        <div class="scope-done"><MudButton Size="Size.Small" OnClick="CloseScope">@L["KnowledgeWorkbench:Retrieval:Done"]</MudButton></div>
                    </div>;
}
