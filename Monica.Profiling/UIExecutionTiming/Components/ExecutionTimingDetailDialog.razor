@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using System.Globalization
@using Monica.Profiling.ExecutionTiming.Models
@using Monica.UI.Shared.Components.Dialogs
@inject IStringLocalizer<ExecutionTimingResource> L

<MudDialog>
    <TitleContent><MoDialogHeading Text="@(Completed is null ? L["Details:RunningTitle"] : L["Details:CompletedTitle"])" /></TitleContent>
    <DialogContent>
        <div class="timing-detail">
            <p class="timing-detail-capture">@L["Details:CaptureHelp"] <time datetime="@ExecutionTimingDisplayFormatter.FormatMachineDateTime(CapturedAt)">@UiTime.Format(CapturedAt)</time></p>
            <dl class="timing-detail-identity">
                <div><dt>@L["Details:DisplayName"]</dt><dd>@(Completed?.DisplayName ?? Running?.DisplayName)</dd></div>
                <div><dt>@L["Details:OperationKey"]</dt><dd><code>@(Completed?.OperationKey ?? Running?.OperationKey)</code></dd></div>
                @if (Running is { } operation)
                {
                    <div><dt>@L["Details:InvocationId"]</dt><dd><code>@operation.InvocationId</code></dd></div>
                    <div><dt>@L["Columns:Description"]</dt><dd>@(operation.Description ?? L["Common:Unavailable"])</dd></div>
                }
            </dl>
            <dl class="timing-detail-values">
                @if (Completed is { } item)
                {
                    <div><dt>@L["Columns:Executions"]</dt><dd>@item.ExecutionCount.ToString("N0")</dd></div>
                    <div><dt>@L["Details:MeanDuration"]</dt><dd>@ExecutionTimingDisplayFormatter.FormatDuration(item.AverageDurationMs)<small>@L["Details:RecordedMilliseconds", item.AverageDurationMs.ToString("R", CultureInfo.InvariantCulture)]</small></dd></div>
                    <div><dt>@L["Details:LatestDuration"]</dt><dd>@ExecutionTimingDisplayFormatter.FormatDuration(item.LastDurationMs)<small>@L["Details:RecordedMilliseconds", item.LastDurationMs.ToString(CultureInfo.InvariantCulture)]</small></dd></div>
                    <div><dt>@L["Columns:Rate"]</dt><dd>@ExecutionTimingDisplayFormatter.FormatRatePerMinute(item, CapturedAt)</dd></div>
                    <div><dt>@L["Details:MeanAllocation"]</dt><dd>@ExecutionTimingDisplayFormatter.FormatMemory(item.AverageMemoryBytes) @if (item.AverageMemoryBytes is { } meanBytes) { <small>@L["Details:RecordedBytes", meanBytes.ToString(CultureInfo.InvariantCulture)]</small> }</dd></div>
                    <div><dt>@L["Details:LatestAllocation"]</dt><dd>@ExecutionTimingDisplayFormatter.FormatMemory(item.LastMemoryBytes) @if (item.LastMemoryBytes is { } latestBytes) { <small>@L["Details:RecordedBytes", latestBytes.ToString(CultureInfo.InvariantCulture)]</small> }</dd></div>
                    <div><dt>@L["Details:FirstRecordedAt"]</dt><dd>@ExecutionTimingDisplayFormatter.FormatMachineDateTime(item.FirstRecordedAt)</dd></div>
                    <div><dt>@L["Columns:LastRecordedAt"]</dt><dd>@(item.LastRecordedAt.HasValue ? ExecutionTimingDisplayFormatter.FormatMachineDateTime(item.LastRecordedAt) : L["Common:Unavailable"])</dd></div>
                }
                @if (Running is { } active)
                {
                    <div><dt>@L["Columns:StartedAt"]</dt><dd>@ExecutionTimingDisplayFormatter.FormatMachineDateTime(active.StartedAt)</dd></div>
                    <div><dt>@L["Columns:RunningFor"]</dt><dd>@ExecutionTimingDisplayFormatter.FormatRunningDuration(active, CapturedAt)</dd></div>
                }
            </dl>
            <p class="timing-detail-note">@(Completed is null ? L["Running:CapturedHelp"] : L["Statistics:RateHelp"])</p>
            @if (Completed is not null) { <p class="timing-detail-note">@L["Details:AllocationHelp"]</p> }
        </div>
    </DialogContent>
    <DialogActions><MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Close())">@L["Common:Close"]</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    /// <summary>Gets or sets the immutable completed record captured when the inspector opened.</summary>
    [Parameter] public ExecutionTimingStatistics? Completed { get; set; }
    /// <summary>Gets or sets the immutable concrete invocation captured when the inspector opened.</summary>
    [Parameter] public RunningExecutionTimingInfo? Running { get; set; }
    /// <summary>Gets or sets the successful capture timestamp for displayed derived evidence.</summary>
    [Parameter, EditorRequired] public DateTimeOffset CapturedAt { get; set; }
}
