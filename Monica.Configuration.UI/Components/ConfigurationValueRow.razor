@using Monica.Configuration.UI.Localization
@using System.Text.Json.Nodes
@inject ConfigurationFacade Facade
@inject ConfigurationStateStore StateStore
@inject ConfigurationParameterPackageService PackageService
@inject ConfigurationPendingChangeCompactor ChangeCompactor
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<div class="@RowShellClass">
    <MudPaper Outlined="true" Class="pa-3 configuration-value-row">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
                <MudStack Spacing="1">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.subtitle2">@DisplayName</MudText>
                        @if (!string.IsNullOrWhiteSpace(Node.Description))
                        {
                            <MudTooltip Text="@Node.Description">
                                <MudIconButton Icon="@Icons.Material.Filled.Info"
                                               Size="Size.Small"
                                               Color="Color.Info"
                                               Variant="Variant.Text"
                                               Class="configuration-description-button" />
                            </MudTooltip>
                        }
                        @if (Node.IsSensitive)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@L["State:Value:Sensitive"]</MudChip>
                        }
                        @if (Node.ValidationRules.OfType<RequiredRule>().Any())
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">@L["State:Value:Required"]</MudChip>
                        }
                        @if (EffectiveReloadBehavior.RequiresProcessRestart())
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">@L["State:Value:RestartNeeded"]</MudChip>
                        }
                        @if (NonScalarEditorHint is { } editorHint)
                        {
                            <MudTooltip Text="@L["State:Editor:EditorHintTooltip", editorHint]">
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@editorHint</MudChip>
                            </MudTooltip>
                        }
                        @if (IsExternalEffectiveSource)
                        {
                            <MudTooltip Text="@EffectiveSourceTooltip">
                                <span class="configuration-inline-icon">
                                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                                             Size="Size.Small"
                                             Color="@EffectiveSourceIconColor" />
                                </span>
                            </MudTooltip>
                        }
                    </MudStack>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@PathLabel</MudText>
                </MudStack>
            </MudItem>

            <MudItem xs="12" md="6">
                @if (Node.NodeKind == ConfigurationNodeKind.Scalar)
                {
                    <MudStack Spacing="1" Class="configuration-scalar-cell">
                        <ConfigurationScalarEditor Node="@Node"
                                                   EffectiveValue="@EffectiveValue"
                                                   IsModified="@(PendingChange is not null)"
                                                   PendingChange="@PendingChange"
                                                   Disabled="@IsCurrentSourceReadOnly"
                                                   ValidationIssue="@ValidationIssue"
                                                   ValueChanged="StageScalar" />
                        @if (ValidationIssue is not null && !ScalarEditorShowsInlineError)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error" Class="configuration-scalar-validation-error">
                                @ValidationIssue.ValidationError
                            </MudText>
                        }
                    </MudStack>
                }
                else if (Node.IsScalarCollection())
                {
                    <MudStack Spacing="1" Class="configuration-scalar-cell">
                        <ConfigurationScalarCollectionEditor Node="@Node"
                                                             EffectiveValue="@EffectiveValue"
                                                             PendingChange="@PendingChange"
                                                             ScopedPendingChanges="@ScopedPendingChanges"
                                                             Disabled="@IsCurrentSourceReadOnly"
                                                             ValidationIssue="@ValidationIssue"
                                                             ValueChanged="StageScalarCollection" />
                    </MudStack>
                }
                else
                {
                    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="1">
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="PreviewComplexValue">
                            @L["State:Actions:PreviewValue"]
                        </MudButton>
                        @if (Node.NodeKind is ConfigurationNodeKind.Dictionary or ConfigurationNodeKind.List)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.DataObject"
                                       Disabled="@IsCurrentSourceReadOnly"
                                       OnClick="EditComplexValue">
                                @L["State:Actions:EditComplex"]
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.DataObject"
                                       Disabled="@IsCurrentSourceReadOnly"
                                       OnClick="EditComplexJsonAsync">
                                @L["Common:Actions:EditJson"]
                            </MudButton>
                        }
                    </MudStack>
                }
            </MudItem>

            <MudItem xs="12" md="2">
                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1">
                    @if (CanInspectSourceChain)
                    {
                        <MudTooltip Text="@L["Sources:Chain:Title"]">
                            <MudIconButton Icon="@Icons.Material.Filled.AccountTree"
                                           Size="Size.Small"
                                           OnClick="OpenSourceChainAsync" />
                        </MudTooltip>
                    }
                    <MudTooltip Text="@L["History:Title"]">
                        <MudIconButton Icon="@Icons.Material.Filled.History"
                                       Size="Size.Small"
                                       OnClick="OpenHistoryAsync" />
                    </MudTooltip>
                    @if (HasPendingChanges)
                    {
                        <MudTooltip Text="@L["State:Actions:Undo"]">
                            <MudIconButton Icon="@Icons.Material.Filled.Undo"
                                           Size="Size.Small"
                                           Color="Color.Warning"
                                           OnClick="Undo" />
                        </MudTooltip>
                    }
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>
</div>

@code {
    [Parameter, EditorRequired] public ConfigurationDefinition Definition { get; set; } = null!;
    [Parameter, EditorRequired] public ConfigurationNodeDefinition Node { get; set; } = null!;
    [Parameter] public ConfigurationEffectiveValue? EffectiveValue { get; set; }
    [Parameter] public ConfigurationSourceDescriptor? ExternalEffectiveSource { get; set; }
    [Parameter] public LogicalPath? HighlightedPath { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback CommittedChanged { get; set; }

    private PendingChange? PendingChange => StateStore.Get(Definition.DefinitionKey, Node.RelativePath);

    private ConfigurationValidationIssue? ValidationIssue => StateStore.GetValidationIssue(Definition.DefinitionKey, Node.RelativePath);

    private IReadOnlyList<PendingChange> ScopedPendingChanges => StateStore.GetScope(Definition.DefinitionKey, Node.RelativePath);

    private bool HasPendingChanges => Node.NodeKind == ConfigurationNodeKind.Scalar
        ? PendingChange is not null || ValidationIssue is not null
        : Node.IsScalarCollection()
            ? PendingChange is not null || ScopedPendingChanges.Count > 0 || ValidationIssue is not null
        : ScopedPendingChanges.Count > 0;

    private bool IsComplexNode => Node.NodeKind != ConfigurationNodeKind.Scalar && !Node.IsScalarCollection();

    private string RowShellClass => string.Join(' ', new[]
    {
        "configuration-value-row-shell",
        IsHighlighted ? "jump-highlight" : null,
        IsComplexNode && HasPendingChanges ? "modified-input" : null
    }.Where(static value => !string.IsNullOrWhiteSpace(value)));

    private bool IsHighlighted =>
        HighlightedPath is not null
        && (Node.RelativePath.Equals(HighlightedPath)
            || Node.IsScalarCollection() && IsPathPrefix(Node.RelativePath, HighlightedPath));

    private bool ScalarEditorShowsInlineError => Node.ValueKind == ConfigurationValueKind.TimeSpan;

    private string DisplayName => string.IsNullOrWhiteSpace(Node.DisplayName) ? Node.Name : Node.DisplayName!;

    private string PathLabel => Node.RelativePath.Depth == 0 ? L["State:Tree:Root"] : Node.RelativePath.ToCanonicalString();

    private ConfigurationSourceDescriptor? EffectiveSource => EffectiveValue?.EffectiveSource;

    private ConfigurationSourceDescriptor? EffectiveSourceForDisplay => EffectiveSource ?? ExternalEffectiveSource;

    private bool IsExternalEffectiveSource => EffectiveSourceForDisplay is { Kind: not ConfigurationSourceKind.MonicaEffectiveStore };

    private bool IsCurrentSourceReadOnly =>
        ReadOnly || EffectiveSource is { Kind: not ConfigurationSourceKind.MonicaEffectiveStore, IsWritable: false };

    private bool CanInspectSourceChain => Definition.Origin == ConfigurationDefinitionOrigin.LocalScan;

    private Color EffectiveSourceIconColor => IsCurrentSourceReadOnly ? Color.Default : Color.Warning;

    private string EffectiveSourceTooltip => EffectiveSourceForDisplay is not { } source
        ? string.Empty
        : source.IsWritable
            ? L["Sources:EffectiveSource:ExternalWritable", source.DisplayName, SourcePath(source)]
            : L["Sources:EffectiveSource:ExternalReadOnly", source.DisplayName, source.ReadOnlyReason ?? L["Sources:ReadOnly"]];

    private ConfigurationReloadBehavior EffectiveReloadBehavior => Node.ResolveEffectiveReloadBehavior(Definition);

    // Scalar string rows show the hint badge inside their editor; every other node kind surfaces the hint here.
    private string? NonScalarEditorHint => Node.EditorHint is null
                                          || (Node.NodeKind == ConfigurationNodeKind.Scalar
                                              && Node.ValueKind == ConfigurationValueKind.String)
        ? null
        : Node.EditorHint;

    private static bool IsPathPrefix(LogicalPath ancestor, LogicalPath path)
    {
        if (ancestor.Depth > path.Depth)
        {
            return false;
        }

        for (var index = 0; index < ancestor.Depth; index++)
        {
            if (!ancestor.Segments[index].Equals(path.Segments[index]))
            {
                return false;
            }
        }

        return true;
    }

    private bool IsCollectionSensitive =>
        Node.IsSensitive
        || Node.ListTemplate?.ItemTemplate.IsSensitive is true
        || Node.DictionaryTemplate?.ValueTemplate.IsSensitive is true;

    private IReadOnlyList<ConfigurationValidationRule> CollectionItemValidationRules =>
        Node.ListTemplate?.ItemTemplate.ValidationRules
        ?? Node.DictionaryTemplate?.ValueTemplate.ValidationRules
        ?? Node.ValidationRules;

    private async Task StageScalar(ConfigurationScalarEditResult result)
    {
        if (IsCurrentSourceReadOnly)
        {
            return;
        }

        if (!result.IsValid || result.StoredValue is null)
        {
            StateStore.ReportValidationIssue(new ConfigurationValidationIssue
            {
                DefinitionKey = Definition.DefinitionKey,
                DefinitionDisplayName = Definition.DisplayName,
                LogicalPath = Node.RelativePath,
                NodeDisplayName = DisplayName,
                InvalidDisplayValue = Node.IsSensitive ? L["State:Value:Sensitive"].Value : result.DisplayValue,
                ValidationError = result.ValidationError ?? L["State:Editor:InvalidPattern"],
                IsSensitive = Node.IsSensitive,
                ValidationRules = Node.ValidationRules
            });
            await Changed.InvokeAsync();
            return;
        }

        if (IsSameAsEffectiveValue(result))
        {
            await UndoScalarState();
            return;
        }

        StateStore.Stage(new PendingChange
        {
            DefinitionKey = Definition.DefinitionKey,
            DefinitionDisplayName = Definition.DisplayName,
            LogicalPath = Node.RelativePath,
            NodeDisplayName = DisplayName,
            MutationKind = ConfigurationMutationKind.Set,
            NewValue = result.StoredValue,
            OriginalDisplayValue = NormalizeEffectiveDisplayValue(),
            NewDisplayValue = result.DisplayValue,
            ExpectedSchemaVersion = Definition.SchemaVersion,
            IsSensitive = Node.IsSensitive,
            NodeKind = Node.NodeKind,
            ValueKind = Node.ValueKind,
            ReloadBehavior = EffectiveReloadBehavior
        }.WithTarget(Definition, EffectiveSource, EffectiveValue?.Version));
        await Changed.InvokeAsync();
    }

    private async Task StageScalarCollection(ConfigurationScalarCollectionEditResult result)
    {
        if (IsCurrentSourceReadOnly)
        {
            return;
        }

        if (!result.IsValid || result.StoredValue is null)
        {
            StateStore.ReportValidationIssue(new ConfigurationValidationIssue
            {
                DefinitionKey = Definition.DefinitionKey,
                DefinitionDisplayName = Definition.DisplayName,
                LogicalPath = Node.RelativePath,
                NodeDisplayName = DisplayName,
                InvalidDisplayValue = IsCollectionSensitive ? L["State:Value:Sensitive"].Value : result.InvalidDisplayValue ?? result.DisplayValue,
                ValidationError = result.ValidationError ?? L["State:Editor:InvalidPattern"],
                IsSensitive = IsCollectionSensitive,
                ValidationRules = CollectionItemValidationRules
            });
            await Changed.InvokeAsync();
            return;
        }

        if (IsSameAsEffectiveCollection(result.StoredValue.Json))
        {
            await UndoScalarState();
            return;
        }

        var originalJson = EffectiveCollectionJson();
        StateStore.Stage(new PendingChange
        {
            DefinitionKey = Definition.DefinitionKey,
            DefinitionDisplayName = Definition.DisplayName,
            LogicalPath = Node.RelativePath,
            NodeDisplayName = DisplayName,
            MutationKind = ConfigurationMutationKind.Set,
            NewValue = result.StoredValue,
            OriginalValue = originalJson is null ? null : ConfigurationStoredValue.FromJson(originalJson),
            OriginalDisplayValue = EffectiveValue?.DisplayValue,
            NewDisplayValue = result.DisplayValue,
            ExpectedSchemaVersion = Definition.SchemaVersion,
            IsSensitive = IsCollectionSensitive,
            NodeKind = Node.NodeKind,
            ValueKind = Node.ValueKind,
            ReloadBehavior = EffectiveReloadBehavior
        }.WithTarget(Definition, EffectiveSource, EffectiveValue?.Version));
        await Changed.InvokeAsync();
    }

    private bool IsSameAsEffectiveValue(ConfigurationScalarEditResult result)
    {
        var effectiveDisplayValue = EffectiveValue?.DisplayValue ?? string.Empty;
        if (Node.ValueKind == ConfigurationValueKind.TimeSpan)
        {
            return ConfigurationScalarTextCodec.TimeSpanEquals(result.DisplayValue, effectiveDisplayValue);
        }

        var effectiveStoredValue = TryCreateStoredValueFromDisplay(effectiveDisplayValue);
        if (effectiveStoredValue is not null && result.StoredValue is not null)
        {
            return StoredJsonEquals(effectiveStoredValue.Json, result.StoredValue.Json);
        }

        return string.Equals(result.DisplayValue, effectiveDisplayValue, StringComparison.Ordinal);
    }

    private string? NormalizeEffectiveDisplayValue()
    {
        return EffectiveValue?.DisplayValue is null
            ? null
            : ConfigurationScalarValueCodec.NormalizeDisplayValue(Node, EffectiveValue.DisplayValue);
    }

    private ConfigurationStoredValue? TryCreateStoredValueFromDisplay(string displayValue)
    {
        try
        {
            return ConfigurationScalarValueCodec.ConvertDisplayValue(Node, displayValue, L).StoredValue;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private bool IsSameAsEffectiveCollection(string storedJson)
    {
        var effectiveJson = EffectiveCollectionJson();
        return effectiveJson is not null && StoredJsonEquals(effectiveJson, storedJson);
    }

    private string? EffectiveCollectionJson()
    {
        if (string.IsNullOrWhiteSpace(EffectiveValue?.DisplayValue))
        {
            return Node.NodeKind switch
            {
                ConfigurationNodeKind.List => "[]",
                ConfigurationNodeKind.Dictionary => "{}",
                _ => null
            };
        }

        try
        {
            return JsonNode.Parse(EffectiveValue.DisplayValue)?.ToJsonString();
        }
        catch (JsonException)
        {
            return EffectiveValue.DisplayValue;
        }
    }

    private static bool StoredJsonEquals(string left, string right)
    {
        try
        {
            return JsonNode.DeepEquals(JsonNode.Parse(left), JsonNode.Parse(right));
        }
        catch (JsonException)
        {
            return string.Equals(left, right, StringComparison.Ordinal);
        }
    }

    private async Task UndoScalarState()
    {
        if (PendingChange is null && ValidationIssue is null)
        {
            return;
        }

        StateStore.Undo(Definition.DefinitionKey, Node.RelativePath);
        await Changed.InvokeAsync();
    }

    private async Task EditComplexValue()
    {
        if (IsCurrentSourceReadOnly)
        {
            return;
        }

        var effectiveValue = await LoadComplexEffectiveValueAsync();
        if (effectiveValue is null)
        {
            return;
        }

        var parameters = new DialogParameters<ComplexValueEditorDialog>();
        parameters.Add(dialog => dialog.Definition, Definition);
        parameters.Add(dialog => dialog.Node, Node);
        parameters.Add(dialog => dialog.EffectiveValue, effectiveValue);
        parameters.Add(dialog => dialog.PendingChanges, StateStore.GetPending());
        var dialog = await DialogService.ShowAsync<ComplexValueEditorDialog>(L["Dialogs:ComplexEditor:Title"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        });
        var result = await dialog.Result;
        if (result is not { Canceled: false })
        {
            return;
        }

        if (result.Data is IReadOnlyList<PendingChange> changes)
        {
            var scalarValues = await PackageService.LoadScalarEffectiveValuesAsync(Definition, Node, effectiveValue);
            var compactedChanges = ChangeCompactor.Compact(Definition, Node, effectiveValue, changes, scalarValues);
            StateStore.ReplaceScope(Definition.DefinitionKey, Node.RelativePath, compactedChanges);
            await Changed.InvokeAsync();
        }
    }

    private async Task PreviewComplexValue()
    {
        var effectiveValue = await LoadComplexEffectiveValueAsync();
        if (effectiveValue is null)
        {
            return;
        }

        var parameters = new DialogParameters<ConfigurationCurrentValuePreviewDialog>();
        parameters.Add(dialog => dialog.Definition, Definition);
        parameters.Add(dialog => dialog.Node, Node);
        parameters.Add(dialog => dialog.EffectiveValue, effectiveValue);
        parameters.Add(dialog => dialog.PendingChanges, StateStore.GetPending());
        parameters.Add(dialog => dialog.AllowJsonEdit, !IsCurrentSourceReadOnly);
        var dialog = await DialogService.ShowAsync<ConfigurationCurrentValuePreviewDialog>(L["Dialogs:CurrentValue:Title"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ConfigurationCurrentValuePreviewResult.EditJson })
        {
            await OpenJsonEditDialogAsync(effectiveValue);
        }
    }

    private async Task EditComplexJsonAsync()
    {
        if (IsCurrentSourceReadOnly)
        {
            return;
        }

        var effectiveValue = await LoadComplexEffectiveValueAsync();
        if (effectiveValue is null)
        {
            return;
        }

        await OpenJsonEditDialogAsync(effectiveValue);
    }

    private async Task OpenJsonEditDialogAsync(ConfigurationEffectiveValue effectiveValue)
    {
        var scalarValues = await PackageService.LoadScalarEffectiveValuesAsync(Definition, Node, effectiveValue);
        var parameters = new DialogParameters<ConfigurationJsonEditDialog>();
        parameters.Add(dialog => dialog.Definition, Definition);
        parameters.Add(dialog => dialog.Node, Node);
        parameters.Add(dialog => dialog.EffectiveValue, effectiveValue);
        parameters.Add(dialog => dialog.ScalarEffectiveValues, scalarValues);
        parameters.Add(dialog => dialog.PendingChanges, StateStore.GetPending());
        parameters.Add(dialog => dialog.CompactChanges, false);
        var dialog = await DialogService.ShowAsync<ConfigurationJsonEditDialog>(L["ImportExport:JsonEditor:Title"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ConfigurationJsonEditResult edit })
        {
            if (!StateStore.TryReplaceJsonEditorScope(edit))
            {
                Snackbar.Add(L["ImportExport:JsonEditor:PendingStateUnavailable"], Severity.Warning);
                return;
            }
            await Changed.InvokeAsync();
        }
    }

    private async Task<ConfigurationEffectiveValue?> LoadComplexEffectiveValueAsync()
    {
        var effectiveValueResult = await Facade.GetEffectiveValueAsync(Definition.DefinitionKey, Node.RelativePath);
        if (effectiveValueResult.IsFailed(out var error, out var loadedEffectiveValue))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            return null;
        }

        return loadedEffectiveValue;
    }

    private async Task OpenHistoryAsync()
    {
        var request = new ConfigurationHistoryPageRequest
        {
            DefinitionKey = Definition.DefinitionKey,
            LogicalPath = Node.RelativePath
        };
        var result = await Facade.QueryHistoryPageAsync(request);
        if (result.IsFailed(out var error, out var page))
        {
            Snackbar.Add($"{L["Common:Errors:LoadFailed"]}: {error.Message}", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<ConfigurationHistoryDiffDialog>();
        parameters.Add(dialog => dialog.HistoryRequest, request);
        parameters.Add(dialog => dialog.InitialPage, page);
        parameters.Add(dialog => dialog.Definition, Definition);
        parameters.Add(dialog => dialog.AllowRollback, !ReadOnly);
        parameters.Add(dialog => dialog.FocusPath, Node.RelativePath);
        parameters.Add(dialog => dialog.Title, L["History:Dialog:MutationTitle", Definition.DisplayName]);
        var dialog = await DialogService.ShowAsync<ConfigurationHistoryDiffDialog>(L["History:Dialog:Title"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true
        });
        var dialogResult = await dialog.Result;
        if (dialogResult is { Canceled: false, Data: ConfigurationHistoryRollbackDialogResult rollback })
        {
            await ConfigurationRollbackCompletionPresenter.ShowAsync(rollback, DialogService, Snackbar, L);
            await CommittedChanged.InvokeAsync();
            await Changed.InvokeAsync();
        }
    }

    private async Task OpenSourceChainAsync()
    {
        var parameters = new DialogParameters<ConfigurationSourceChainDialog>();
        parameters.Add(dialog => dialog.Definition, Definition);
        parameters.Add(dialog => dialog.Node, Node);
        await DialogService.ShowAsync<ConfigurationSourceChainDialog>(L["Sources:Chain:Title"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        });
    }

    private static string SourcePath(ConfigurationSourceDescriptor source)
    {
        return source.PhysicalPath ?? source.SourcePath ?? source.ProviderType;
    }

    private async Task Undo()
    {
        if (Node.IsScalarCollection())
        {
            StateStore.UndoScope(Definition.DefinitionKey, Node.RelativePath);
        }
        else if (Node.NodeKind == ConfigurationNodeKind.Scalar)
        {
            StateStore.Undo(Definition.DefinitionKey, Node.RelativePath);
        }
        else
        {
            StateStore.UndoScope(Definition.DefinitionKey, Node.RelativePath);
        }

        await Changed.InvokeAsync();
    }

}
