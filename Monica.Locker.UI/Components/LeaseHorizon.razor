@inject IStringLocalizer<LockerResource> L
@inject MoTimeFormatter Time

<div class="lh-wrap">
    <header class="lh-head">
        <div class="lh-head-copy"><h2>@L["Design:HorizonTitle"]</h2><p>@L["Design:HorizonDesc"]</p></div>
        <div class="mo-vl-segment lh-group-toggle" role="group" aria-label="@L["Design:HorizonTitle"]">
            <button type="button" aria-pressed="@(!ByHolder ? "true" : "false")" @onclick="@(() => Set("group", null))">
                <MoIcon Icon="@MoIcons.Database" Size="14px" />@L["Design:GroupAuthority"]
            </button>
            <button type="button" aria-pressed="@(ByHolder ? "true" : "false")" @onclick="@(() => Set("group", "holder"))">
                <MoIcon Icon="@MoIcons.Server" Size="14px" />@L["Design:GroupHolder"]
            </button>
        </div>
    </header>
    <div class="lh-controls">
        <label class="lh-search"><MoIcon Icon="@MoIcons.Search" Size="15px" /><input type="search" spellcheck="false" value="@Search" @oninput="@(e => Set("q", e.Value?.ToString()))" placeholder="@L["Design:Search"]" aria-label="@L["Design:Search"]" /></label>
        <div class="lh-sort">
            <span>@L["Design:SortLabel"]</span>
            <MudSelect T="string" aria-label="@L["Design:SortLabel"]" Value="@(Sort ?? "urgency")" ValueChanged="@(v => Set("sort", v == "urgency" ? null : v))" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("urgency")">@L["Design:SortUrgency"]</MudSelectItem>
                <MudSelectItem Value="@("tenure")">@L["Design:SortTenure"]</MudSelectItem>
                <MudSelectItem Value="@("name")">@L["Design:SortName"]</MudSelectItem>
            </MudSelect>
        </div>
    </div>
    <div class="lh-filter-row">
        <div class="lh-chips" role="group" aria-label="@L["Design:ColValidity"]">
            @foreach (var (id, label, role) in States)
            {
                <MoFilterChip Label="@L[label]" Role="@role" Pill="true" ShowDot="true" Class="mo-vl-chip--instrument" Selected="@(NormalizedState == id)"
                              Count="@_scope.Count(row => Matches(row, id))" SelectedChanged="@(() => Set("state", id))" />
            }
        </div>
        <div class="lh-active-pills">
            @if (Authorities.FirstOrDefault(item => item.Authority.Id == Authority) is { } source)
            {
                <button class="mo-vl-capsule @LeasePresentation.Role(source.Authority.Kind).ToCssClass()" @onclick="@(() => Set("authority", null))">
                    @L["Design:FilterAuthorityLabel", source.Authority.DisplayName]<MoIcon Icon="@MoIcons.Close" Size="12px" />
                </button>
            }
            @if (Holder is not null)
            {
                <button class="mo-vl-capsule mo-vl-role--primary" @onclick="@(() => Set("holder", null))">
                    @L["Design:FilterHolderLabel", Holder]<MoIcon Icon="@MoIcons.Close" Size="12px" />
                </button>
            }
            @if (HasFilters) { <button class="lh-ghost" type="button" @onclick="ClearAsync">@L["Design:ClearFilters"]</button> }
            <span class="lh-shown mo-vl-mono">@L["Design:ShownCount", _sorted.Count, Rows.Count]</span>
        </div>
    </div>
    @if (_sorted.Count == 0)
    {
        <MoContentState>
            <span class="mo-vl-tile @(_unavailable ? "mo-vl-role--error" : "mo-vl-role--neutral")">
                <MoIcon Icon="@(_unavailable ? MoIcons.Warning : Rows.Count == 0 ? MoIcons.Inbox : MoIcons.Search)" Size="18px" />
            </span>
            <h3>@L[_unavailable ? "Evidence:Unavailable" : Rows.Count == 0 ? "Evidence:Empty" : "Inventory:NoMatch"]</h3>
            <p>@L[_unavailable ? "Evidence:Retry" : Rows.Count == 0 ? "Evidence:Retention" : "Inventory:NoMatchDescription"]</p>
            @if (Rows.Count > 0) { <MudButton Variant="Variant.Outlined" OnClick="ClearAsync">@L["Design:ClearFilters"]</MudButton> }
            else { <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" OnClick="Retry">@L["Common:Refresh"]</MudButton> }
        </MoContentState>
    }
    else
    {
        <div class="lh-board" @onmouseleave="@(() => _active = null)">
            <div class="lh-col-head" aria-hidden="true">
                <span>@L["Design:ColRole"]</span><span>@L["Design:ColHolder"]</span>
                <div class="lh-axis-head">
                    @foreach (var tick in _ticks)
                    {
                        <span class="lh-tick @(tick == 0 ? "is-zero" : null)" style="left:@Pct(tick)">@Tick(tick)</span>
                    }
                </div>
                <span class="lh-col-end">@L["Design:ColValidity"]</span>
            </div>
            @foreach (var group in VisibleGroups())
            {
                <section class="lh-group" @key="group.Id">
                    @if (group.Source is { } info)
                    {
                        var authority = info.Authority;
                        var observed = info.Snapshot?.ObservedAtUtc;
                        var role = LeasePresentation.Role(authority.Kind).ToCssClass();
                        <header class="lh-group-head @role">
                            <div class="lh-group-id">
                                <span class="mo-vl-capsule @role"><MoIcon Icon="@LeasePresentation.Icon(authority.Kind)" Size="13px" />@L[$"Providers:{authority.Kind}"]</span>
                                <h3>@authority.DisplayName</h3>
                                <span class="lh-group-scope mo-vl-mono">@authority.Scope@(authority.NamePrefix.Length > 0 ? $" / {authority.NamePrefix}*" : null)</span>
                            </div>
                            <div class="lh-group-meta">
                                <span class="lh-cap-badge @(info.CanRevoke ? "mo-vl-role--primary" : "mo-vl-role--neutral")">@L[info.CanRevoke ? "Design:AuthorityRevocable" : "Design:AuthorityReadOnly"]</span>
                                @if (info.RefreshFailed)
                                {
                                    <span class="lh-cap-badge mo-vl-role--warning">@(observed is null ? L["Design:AuthorityFailNoData"] : L["Design:AuthorityStale", Time.FormatTime(observed)])</span>
                                }
                                else if (observed is not null)
                                {
                                    <time class="lh-group-clock mo-vl-mono" datetime="@observed.Value.ToString("O")">@Time.FormatTime(observed)</time>
                                }
                            </div>
                        </header>
                    }
                    else
                    {
                        var active = group.Rows.Count(row => !row.Expired);
                        var expired = group.Rows.Count - active;
                        var sources = string.Join(" + ", group.Rows.Select(row => row.Authority.DisplayName).Distinct());
                        <header class="lh-group-head is-holder">
                            <div class="lh-group-id">
                                <span class="mo-vl-tile mo-vl-role--neutral"><MoIcon Icon="@MoIcons.Server" Size="14px" /></span>
                                <h3 class="mo-vl-mono">@group.Id</h3>
                                <span class="lh-group-scope">@(expired > 0 ? L["Horizon:MixedRecords", active, expired] : L["Design:AuthorityRecords", active]) · @sources</span>
                            </div>
                            <button class="lh-ghost" type="button" @onclick="@(() => Set("holder", Holder == group.Id ? null : group.Id))">@L[Holder == group.Id ? "Design:ClearFilters" : "Design:FilterThisHolder"]</button>
                        </header>
                    }
                    @if (group.Rows.Count == 0)
                    {
                        <p class="lh-group-empty">@L[group.Source?.Snapshot is null ? "Evidence:Unavailable" : "Evidence:Empty"]</p>
                    }
                    else
                    {
                        <div class="lh-rows">
                        @foreach (var row in group.Rows)
                        {
                            var start = (row.Record.ConfirmedAtUtc - row.ObservedAtUtc).TotalSeconds;
                            var handover = !row.Expired && row.Tenure.TotalSeconds <= 120;
                            var (remainingValue, remainingUnit) = LeasePresentation.Duration(row.RemainingSeconds, L);
                            var signedRemaining = (row.Expired ? "−" : "+") + remainingValue;
                            var title = LeasePresentation.Title(row.Record.Resource.Name, L);
                            var warning = row.Expired || row.Tight;
                            var selected = Selection == (row.Authority.Id, row.Record.Resource.Name);
                            <button @key="(row.Authority.Id, row.Record.Resource)" data-lease-row
                                    class="lh-row @(row.Expired ? "is-expired" : null) @(selected ? "is-selected" : null)" type="button"
                                    aria-label="@($"{title} · {row.Record.Resource.Name} · {row.Record.HolderId} · {signedRemaining} {remainingUnit}")"
                                    aria-haspopup="dialog" @onfocus="@(() => _active = row)" @onmouseenter="@(() => _active = row)" @onclick="@(() => Inspect.InvokeAsync(row))">
                                <span class="lh-cell-role">
                                    <span class="lh-role-head">
                                        <i class="mo-vl-swatch mo-vl-swatch--label mo-vl-swatch--instrument @(row.Expired ? "mo-vl-role--warning" : "mo-vl-role--success")" aria-hidden="true"></i>
                                        <strong class="lh-role-title">@title</strong>
                                        @if (ByHolder) { <span class="mo-vl-capsule @LeasePresentation.Role(row.Authority.Kind).ToCssClass()">@L[$"Providers:{row.Authority.Kind}"]</span> }
                                    </span>
                                    <code class="lh-role-key">@row.Record.Resource.Name</code>
                                </span>
                                <span class="lh-cell-holder">
                                    @if (!ByHolder)
                                    {
                                        <span class="lh-holder-line"><MoIcon Icon="@MoIcons.Server" Size="13px" /><code class="lh-holder-id">@row.Record.HolderId</code></span>
                                    }
                                    <small class="lh-tenure @(handover ? "is-handover" : null)">@L[row.Expired ? "Design:HeldBeforeExpiry" : handover ? "Design:JustHandedOver" : "Design:HeldFor", Span(row.Tenure.TotalSeconds)]</small>
                                </span>
                                <span class="lh-cell-track" aria-hidden="true">
                                    <span class="lh-track">
                                        @foreach (var tick in _ticks) { <i class="lh-grid @(tick == 0 ? "is-zero" : null)" style="left:@Pct(tick)"></i> }
                                        @if (row.RemainingSeconds < -_left)
                                        {
                                            <i class="lh-expired-gap" style="@Segment(-_left, 0)"></i>
                                            <span class="lh-offscale-pin" style="max-width:calc(@Pct(0) - 8px)">
                                                <MoIcon Icon="@MoIcons.ChevronLeft" Size="12px" /><span>@L["Design:ExpiredPin", Span(row.RemainingSeconds)]</span>
                                            </span>
                                        }
                                        else if (row.Expired)
                                        {
                                            <i class="lh-bar-expired" style="@Segment(start, row.RemainingSeconds, 1)"></i>
                                            <i class="lh-expired-gap" style="@Segment(row.RemainingSeconds, 0)"></i>
                                        }
                                        else
                                        {
                                            <i class="lh-bar-elapsed" style="@Segment(start, 0, .5)"></i>
                                            @if (start >= -_left) { <i class="lh-confirm-dot" style="left:@Pct(start)"></i> }
                                            <i class="lh-bar-remain @(row.Tight ? "is-tight" : null)" style="@Segment(0, row.RemainingSeconds, 1.5)"></i>
                                        }
                                    </span>
                                    <span class="lh-mobile-scale mo-vl-mono">
                                        <span>@(row.Expired ? L["Design:StatusExpired"].Value : "−" + Span(start))</span><span>0s</span>
                                        <span>@(row.Expired ? null : "+" + Span(row.RemainingSeconds))</span>
                                    </span>
                                </span>
                                <span class="lh-cell-validity">
                                    <span class="lh-validity-main">
                                        <span class="lh-val-num @(warning ? "mo-vl-role--warning" : "mo-vl-role--success")">@signedRemaining<small>@remainingUnit</small></span>
                                        <span class="lh-val-sub">
                                            @if (warning)
                                            {
                                                <span class="lh-tag mo-vl-role--warning">@L[row.Expired ? row.Authority.Kind == LeaseAuthorityKind.Sql ? "Design:SqlRow" : "Design:StatusExpired" : "Design:TightTag"]</span>
                                            }
                                            else { <code>/ @Span(row.GrantSeconds)</code> }
                                        </span>
                                    </span>
                                    <MoIcon Icon="@MoIcons.ChevronRight" Size="15px" />
                                </span>
                            </button>
                        }
                        </div>
                    }
                </section>
            }
            @if (PageCount > 1)
            {
                <div class="lh-paging">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(_page == 0)" OnClick="@(() => ChangePage(-1))">@L["Design:PreviousPage"]</MudButton>
                    <span class="mo-vl-mono">@L["Design:PageOf", _page + 1, PageCount]</span>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@(_page == PageCount - 1)" OnClick="@(() => ChangePage(1))">@L["Design:NextPage"]</MudButton>
                </div>
            }
            <div class="lh-readout" aria-live="polite">
                @if (_active is { } current)
                {
                    <div class="lh-readout-text mo-vl-mono">
                        <strong>@LeasePresentation.Title(current.Record.Resource.Name, L)</strong>
                        @foreach (var (label, instant) in new[] { ("Timestamps:Acquired", current.Record.AcquiredAtUtc), ("Timestamps:Confirmed", current.Record.ConfirmedAtUtc), ("Timestamps:Observed", current.ObservedAtUtc), ("Timestamps:Expires", current.Record.ExpiresAtUtc) })
                        {
                            <span>@L[label] <time datetime="@instant.ToString("O")">@Time.FormatTime(instant)</time></span>
                        }
                    </div>
                }
                else
                {
                    <div class="lh-legend-bar">
                        <div class="mo-vl-legend">
                            <span><i class="lh-leg-dot" aria-hidden="true"></i>@L["Design:LegendConfirmed"]</span>
                            <span><i class="mo-vl-swatch mo-vl-swatch--label mo-vl-swatch--instrument mo-vl-role--success" aria-hidden="true"></i>@L["Design:LegendActive"]</span>
                            <span><i class="mo-vl-swatch mo-vl-swatch--label mo-vl-swatch--instrument mo-vl-role--warning" aria-hidden="true"></i>@L["Design:LegendExpired"]</span>
                            <span><i class="lh-leg-zero" aria-hidden="true"></i>@L["Design:LegendZero"]</span>
                        </div>
                        <span class="lh-readout-hint">@L["Design:ReadoutIdle"]</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<LeaseRow> Rows { get; set; } = [];
    [Parameter] public IReadOnlyList<LeaseAuthorityEvidence> Authorities { get; set; } = [];
    [Parameter] public string? Authority { get; set; }
    [Parameter] public string? EvidenceState { get; set; }
    [Parameter] public string? Search { get; set; }
    [Parameter] public string? Holder { get; set; }
    [Parameter] public string? Group { get; set; }
    [Parameter] public string? Sort { get; set; }
    [Parameter] public (string? Authority, string? Resource) Selection { get; set; }
    [Parameter] public EventCallback<(string Key, string? Value)> Filter { get; set; }
    [Parameter] public EventCallback ClearFilters { get; set; }
    [Parameter] public EventCallback Retry { get; set; }
    [Parameter] public EventCallback<LeaseRow> Inspect { get; set; }

    private sealed record HorizonGroup(string Id, LeaseAuthorityEvidence? Source, IReadOnlyList<LeaseRow> Rows);
    private const int PageSize = 25;
    private static readonly (string? Id, string Label, MoVisualRole Role)[] States = [
        (null, "Design:FilterAll", MoVisualRole.Neutral), ("active", "Design:FilterActive", MoVisualRole.Success), ("expired", "Design:FilterExpired", MoVisualRole.Warning)];
    private string? NormalizedState => EvidenceState switch { "unexpired" or "active" => "active", "expired" => "expired", _ => null };
    private bool ByHolder => Group == "holder";
    private bool HasFilters => Authority is not null || Holder is not null || NormalizedState is not null || !string.IsNullOrWhiteSpace(Search);
    private int PageCount => Math.Max(1, (_sorted.Count + PageSize - 1) / PageSize);
    private int _page;
    private bool _unavailable;
    private LeaseRow? _active;
    private List<LeaseRow> _scope = [], _sorted = [];
    private double _left, _right;
    private double[] _ticks = [];

    private IEnumerable<HorizonGroup> VisibleGroups()
    {
        var visible = _sorted.Skip(_page * PageSize).Take(PageSize).ToLookup(row => ByHolder ? row.Record.HolderId : row.Authority.Id);
        if (ByHolder)
            return visible.OrderByDescending(group => group.Any(row => row.Expired))
                .ThenByDescending(group => group.Count(row => !row.Expired)).ThenBy(group => group.Key, StringComparer.Ordinal)
                .Select(group => new HorizonGroup(group.Key, null, group.ToArray()));

        return Authorities.Where(source => visible.Contains(source.Authority.Id) || PageCount == 1 && !HasFilters)
            .Select(source => new HorizonGroup(source.Authority.Id, source, visible[source.Authority.Id].ToArray()));
    }

    private static bool Matches(LeaseRow row, string? state) => state switch { "active" => !row.Expired, "expired" => row.Expired, _ => true };
    private Task Set(string key, string? value) { ChangePage(-_page); return Filter.InvokeAsync((key, value)); }
    private Task ClearAsync() { ChangePage(-_page); return ClearFilters.InvokeAsync(); }

    private void ChangePage(int delta)
    {
        _page = Math.Clamp(_page + delta, 0, PageCount - 1);
        _active = null;
    }

    protected override void OnParametersSet()
    {
        var terms = Search?.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [];
        _scope = Rows.Where(row => (Authority is null || Authority == row.Authority.Id) && (Holder is null || Holder == row.Record.HolderId)
            && (terms.Length == 0 || MatchesSearch(row, terms))).ToList();
        var filtered = _scope.Where(row => Matches(row, NormalizedState));
        _sorted = (Sort switch
        {
            "tenure" => filtered.OrderBy(row => row.Expired).ThenBy(row => row.Tenure),
            "name" => filtered.OrderBy(row => row.Record.Resource.Name, StringComparer.Ordinal),
            _ => filtered.OrderBy(row => row.RemainingSeconds)
        }).ToList();
        _unavailable = Authorities.All(source => source.Snapshot is null);
        var active = Rows.Where(row => !row.Expired).ToArray();
        _left = Bound(active.Select(row => (row.ObservedAtUtc - row.Record.ConfirmedAtUtc).TotalSeconds).DefaultIfEmpty().Max());
        _right = Bound(active.Select(row => row.RemainingSeconds).DefaultIfEmpty().Max());
        _ticks = new[] { -_left, -_left / 2, 0, _right / 2, _right };
        _page = Math.Clamp(_page, 0, PageCount - 1);
        if (_active is { } prior)
            _active = _sorted.FirstOrDefault(row => row.Authority.Id == prior.Authority.Id && row.Record.Resource == prior.Record.Resource);
    }

    private bool MatchesSearch(LeaseRow row, string[] terms)
    {
        var evidence = string.Join(' ', row.Authority.DisplayName, row.Authority.Id, row.Authority.StoreKey, row.Record.Resource.Name,
            row.Record.HolderId, LeasePresentation.Title(row.Record.Resource.Name, L));
        return terms.All(term => evidence.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static double Bound(double value) => value <= 30 ? 30 : value <= 45 ? 45 : value <= 60 ? 60 : Math.Ceiling(value / 60) * 60;
    private double Position(double seconds) => Math.Clamp((seconds + _left) * 100 / (_left + _right), 0, 100);
    private string Pct(double seconds) => FormattableString.Invariant($"{Position(seconds):0.###}%");
    private string Segment(double from, double to, double minimum = 0) =>
        FormattableString.Invariant($"left:{Position(from):0.###}%;width:{Math.Min(100 - Position(from), Math.Max(minimum, Position(to) - Position(from))):0.###}%");
    private string Span(double seconds) => LeasePresentation.Span(seconds, L);
    private string Tick(double seconds) => seconds == 0 ? L["Design:AxisZero"] : (seconds < 0 ? "−" : "+") + Span(seconds).Replace(" ", "");
}
