@attribute [Route(PAGE_URL)]
@using System.Diagnostics
@using Microsoft.AspNetCore.Http
@using Microsoft.Extensions.Hosting
@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@inject IStringLocalizer<SharedResource> L
@inject IHostEnvironment HostEnvironment

<PageTitle>@L["Error:PageTitle"]</PageTitle>

<ShellPageState HeadingId="error-page-title"
                Title="@L["Error:Title"]"
                Description="@L["Error:Message"]"
                Icon="@MoIcons.Error"
                Severity="Severity.Error"
                HomeLabel="@L["Common:GoHome"]"
                EvidenceLabel="@L["Error:RequestId"]"
                EvidenceValue="@RequestId">
    @if (HostEnvironment.IsDevelopment())
    {
        <aside class="error-page__guidance" aria-labelledby="error-guidance-title">
            <span class="error-page__guidance-icon" aria-hidden="true">
                <MoIcon Icon="@MoIcons.Terminal" Size="20px" />
            </span>
            <div>
                <h2 id="error-guidance-title">@L["Error:DevelopmentHeading"]</h2>
                <p>@L["Error:DevelopmentGuidance"]</p>
            </div>
        </aside>
    }
</ShellPageState>

@code {
    public const string PAGE_URL = "/Error";

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
