@using Microsoft.Extensions.Localization
@using Monica.Markdown.Localization
@using Monica.Markdown.Models
@using Monica.Markdown.UIMarkdown.Support
@using Monica.Tool.Algorithms.Trees
@inject IStringLocalizer<MarkdownResource> L

<div class="tree-container">
    <div class="tree-header">
        <MudTextField T="string"
                      @bind-Value="SearchText"
                      Label="@L["MarkdownViewer:Placeholders:SearchFiles"]"
                      aria-label="@L["MarkdownViewer:Placeholders:SearchFiles"]"
                      Placeholder="@L["MarkdownViewer:Placeholders:SearchFiles"]"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@MoIcons.Search"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Class="tree-search" />
    </div>

    <div class="tree-content @(IsTreeEmpty ? "tree-content--empty" : null)">
        @if (IsTreeEmpty)
        {
            <MoContentState Compact="true" Class="tree-empty-state">
                <MoIcon Icon="@MoIcons.SearchOff"
                         Size="2.25rem"
                         Class="tree-empty-icon" />
                <MudText Typo="Typo.body2" Color="Color.Default" Class="tree-empty-text">
                    @(HasSearchText
                        ? L["MarkdownViewer:States:NoMatchingDocuments"]
                        : L["MarkdownViewer:States:NoDocumentsFound"])
                </MudText>
            </MoContentState>
        }
        else
        {
            <MudTreeView T="MarkdownDocumentNodeData"
                         Items="_treeItems"
                         SelectedValue="_selectedValue"
                         SelectedValueChanged="OnItemSelected"
                         Hover="true"
                         Dense="true"
                         Ripple="false"
                         Class="doc-tree-view" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus">
                <ItemTemplate>
                    <MudTreeViewItem T="MarkdownDocumentNodeData"
                                     Items="@context.Children"
                                     Value="@context.Value"
                                     Text="@context.Text"
                                     title="@context.Text"
                                     TextClass="@GetTextClass(context.Value)"
                                     Icon="@GetIcon(context.Value)"
                                     IconColor="Color.Inherit"
                                     Expanded="@context.Expanded"
                                     ExpandedChanged="@((bool expanded) => OnExpandedChanged(context, expanded))" ExpandButtonIcon="@MoIcons.ChevronRight" LoadingIcon="@MoIcons.Refresh" />
                </ItemTemplate>
            </MudTreeView>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public TreeNode<MarkdownDocumentNodeData>? TreeRoot { get; set; }

    [Parameter]
    public MarkdownDocument? SelectedDocument { get; set; }

    [Parameter]
    public EventCallback<MarkdownDocument?> SelectedDocumentChanged { get; set; }

    private readonly HashSet<string> _expandedPaths = new(StringComparer.OrdinalIgnoreCase);
    private TreeNode<MarkdownDocumentNodeData>? _lastTreeRoot;
    private string? _searchText;
    private MarkdownDocumentNodeData? _selectedValue;
    private List<DocumentTreeItemBuilder.DocumentTreeItem>? _treeItems;
    private bool HasSearchText => !string.IsNullOrWhiteSpace(_searchText);

    private bool IsTreeEmpty => _treeItems is null || _treeItems.Count == 0;

    private string? SearchText
    {
        get => _searchText;
        set
        {
            var normalized = string.IsNullOrWhiteSpace(value) ? null : value.Trim();
            if (_searchText == normalized)
            {
                return;
            }

            _searchText = normalized;
            ApplyTreeFilter();
        }
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastTreeRoot, TreeRoot))
        {
            _lastTreeRoot = TreeRoot;
            DocumentTreeItemBuilder.ResetExpandedPaths(_expandedPaths, TreeRoot);
        }

        _selectedValue = DocumentTreeItemBuilder.FindSelectedValue(TreeRoot, SelectedDocument);
        ApplyTreeFilter();
    }

    private void ApplyTreeFilter()
    {
        _treeItems = DocumentTreeItemBuilder.BuildTreeItems(TreeRoot, _searchText, _expandedPaths);
    }

    private async Task OnItemSelected(MarkdownDocumentNodeData? data)
    {
        if (data?.IsDocument == true && data.Document is not null)
        {
            _selectedValue = data;
            await SelectedDocumentChanged.InvokeAsync(data.Document);
        }
    }

    private void OnExpandedChanged(ITreeItemData<MarkdownDocumentNodeData> item, bool expanded)
    {
        if (item is not DocumentTreeItemBuilder.DocumentTreeItem documentTreeItem)
        {
            return;
        }

        documentTreeItem.Expanded = expanded;

        if (expanded)
        {
            _expandedPaths.Add(documentTreeItem.Path);
            return;
        }

        _expandedPaths.Remove(documentTreeItem.Path);
    }

    private static string GetIcon(MarkdownDocumentNodeData? data) =>
        data?.IsDocument == true
            ? MoIcons.FileText
            : MoIcons.Folder;

    private static string GetTextClass(MarkdownDocumentNodeData? data) =>
        data?.IsDocument == true
            ? "tree-item-label tree-item-label-file"
            : "tree-item-label tree-item-label-folder";
}
