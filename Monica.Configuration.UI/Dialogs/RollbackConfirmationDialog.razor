@using Monica.Configuration.UI.Localization
@using Monica.UI.UIDiffHighlight.Models
@inject ConfigurationFacade Facade
@inject IStringLocalizer<ConfigurationUIResource> L
@implements IDisposable

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                @RollbackWarning
            </MudAlert>

            <MudTextField T="string"
                          @bind-Value="_reason"
                          Label="@L["Group:Reason"]"
                          Variant="Variant.Outlined"
                          Lines="2" />

            @if (_loadingGroupRows || _loadingRollbackPreview)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_rollbackPreview is not null)
            {
                @foreach (var problem in _rollbackPreview.Problems)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@problem.Message</MudAlert>
                }
                @foreach (var report in _rollbackPreview.ValidationReports)
                {
                    <ConfigurationValidationReportView Title="@report.DefinitionDisplayName"
                       Coverage="@report.Coverage" Scope="@report.Scope" ValidationRevision="@report.ValidationRevision"
                       Target="@report.Target" HasEffectiveChange="@report.HasEffectiveChange"
                       IsValid="@report.IsValid" IsSchemaValid="@report.IsSchemaValid"
                       Issues="@report.Issues.Select(ConfigurationValidationPresentation.FromCandidate).ToArray()" />
                }
                <MudPaper Outlined="true" Class="pa-3">
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.subtitle2">@L["Rollback:PreviewTitle"]</MudText>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Storage">
                                @L["History:Dialog:MonicaTargetCount", PreviewRows.Count(row => row.TargetKind == ConfigurationMutationTargetKind.MonicaEffectiveStore)]
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Description">
                                @L["History:Dialog:ExternalTargetCount", PreviewRows.Count(row => row.TargetKind == ConfigurationMutationTargetKind.ExternalConfigurationSource)]
                            </MudChip>
                        </MudStack>
                        <ConfigurationHistoryDiffPreview Rows="@PreviewRows"
                                                         IsRollbackPreview="true"
                                                         ViewMode="EDiffViewMode.Split"
                                                         CurrentValuesByHistoryId="@_rollbackPreview!.CurrentValuesByHistoryId"
                                                         PreviewIdentity="@_rollbackPreview.PlanToken"
                                                         LoadingChanged="OnPreviewLoadingChanged" />
                    </MudStack>
                </MudPaper>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Severity="Severity.Error">@_error</MudAlert>
            }

            @if (_saving)
            {
                <MudProgressLinear Indeterminate="true" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">@L["Common:Actions:Cancel"]</MudButton>
        <MudButton OnClick="() => LoadRollbackPreviewAsync()" Disabled="@(_saving || _loadingGroupRows || _loadingRollbackPreview)">
            @L["Validation:PreviewRefresh"]
        </MudButton>
        <MudButton Color="Color.Warning"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Restore"
                   OnClick="RollbackAsync"
                   Disabled="@(_saving || _loadingGroupRows || _loadingRollbackPreview || _loadingDiffPreview || _rollbackPreview?.CanApply != true || PreviewRows.Count == 0)"
                   aria-label="@L["Rollback:Confirm"]">
            @L["Rollback:Confirm"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ConfigurationValueHistory? HistoryRow { get; set; }
    [Parameter] public ConfigurationMutationGroup? Group { get; set; }
    [Parameter] public IReadOnlyList<ConfigurationValueHistory> GroupRows { get; set; } = [];

    private string? _reason;
    private string? _error;
    private bool _saving;
    private bool _loadingGroupRows;
    private bool _loadingRollbackPreview;
    private bool _loadingDiffPreview = true;
    private bool _disposed;
    private long _previewGeneration;
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _previewCancellation;
    private IReadOnlyList<ConfigurationValueHistory> _loadedGroupRows = [];
    private ConfigurationHistoryRollbackPreview? _rollbackPreview;

    private bool IsGroupRollback => Group is not null;

    private bool IsBatchRollback => Group is null && HistoryRow is null && PreviewRows.Count > 1;

    private string RollbackWarning => IsGroupRollback
        ? L["Rollback:GroupWarning"]
        : IsBatchRollback
            ? L["Rollback:SelectionWarning"]
            : L["Rollback:SingleWarning"];

    private IReadOnlyList<ConfigurationValueHistory> PreviewRows =>
        HistoryRow is not null
            ? [HistoryRow]
            : GroupRows.Count > 0 ? GroupRows : _loadedGroupRows;

    protected override async Task OnInitializedAsync()
    {
        if (Group is not null && GroupRows.Count == 0)
        {
            _loadingGroupRows = true;
            var result = await Facade.GetGroupHistoryAsync(Group.GroupId);
            if (_disposed)
            {
                return;
            }
            if (result.IsFailed(out var error, out var rows))
            {
                _error = error.Message;
            }
            else
            {
                _loadedGroupRows = rows;
            }

            _loadingGroupRows = false;
        }

        if (string.IsNullOrWhiteSpace(_error))
        {
            await LoadRollbackPreviewAsync();
        }
    }

    private async Task LoadRollbackPreviewAsync(bool preserveError = false)
    {
        if (_disposed)
        {
            return;
        }

        var generation = ++_previewGeneration;
        _previewCancellation?.Cancel();
        _previewCancellation?.Dispose();
        var cancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _previewCancellation = cancellation;
        _rollbackPreview = null;
        if (!preserveError)
        {
            _error = null;
        }

        var historyIds = PreviewRows.Select(static row => row.HistoryId).ToArray();
        if (historyIds.Length == 0)
        {
            _error = L["Common:States:NotFound"];
            return;
        }

        _loadingRollbackPreview = true;
        try
        {
            var result = await Facade.PreviewHistoryRollbackAsync(historyIds, cancellation.Token);
            if (_disposed || generation != _previewGeneration)
            {
                return;
            }

            if (result.IsFailed(out var error, out var preview))
            {
                _error = preserveError && !string.IsNullOrWhiteSpace(_error)
                    ? $"{_error}{Environment.NewLine}{error.Message}" : error.Message;
                _rollbackPreview = result.Data;
            }
            else
            {
                _rollbackPreview = preview;
            }
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
        }
        finally
        {
            if (!_disposed && generation == _previewGeneration)
            {
                _loadingRollbackPreview = false;
            }
        }
    }

    private async Task RollbackAsync()
    {
        var preview = _rollbackPreview;
        if (_disposed || _saving || _loadingRollbackPreview || preview?.CanApply != true)
        {
            _error = L["Common:States:NotFound"];
            return;
        }

        _saving = true;
        _error = null;

        if (Group is not null)
        {
            var result = await Facade.RollbackGroupAsync(Group.GroupId, preview.PlanToken, _reason);
            if (result.IsFailed(out var error, out var appliedMutations))
            {
                await DisplayRejectionAsync(error.Message);
                return;
            }

            CompleteRollback(ConfigurationHistoryRollbackDialogResult.Applied(appliedMutations));
            return;
        }

        if (HistoryRow is null)
        {
            var rows = PreviewRows;
            if (rows.Count == 0)
            {
                _error = L["Common:States:NotFound"];
                _saving = false;
                return;
            }

            var batchResult = await Facade.RollbackHistoriesAsync(
                rows.Select(row => row.HistoryId).ToArray(),
                preview.PlanToken,
                _reason);
            if (batchResult.IsFailed(out var batchError, out var appliedMutations))
            {
                await DisplayRejectionAsync(batchError.Message);
                return;
            }

            CompleteRollback(ConfigurationHistoryRollbackDialogResult.Applied(appliedMutations));
            return;
        }

        var singleResult = await Facade.RollbackHistoryAsync(
            HistoryRow.HistoryId,
            preview.PlanToken,
            _reason);
        if (singleResult.IsFailed(out var singleError, out var appliedMutation))
        {
            await DisplayRejectionAsync(singleError.Message);
            return;
        }

        CompleteRollback(ConfigurationHistoryRollbackDialogResult.Applied(appliedMutation));
    }

    private void CompleteRollback(ConfigurationHistoryRollbackDialogResult rollback)
    {
        if (!_disposed)
        {
            MudDialog.Close(DialogResult.Ok(rollback));
        }
    }

    private async Task DisplayRejectionAsync(string? message)
    {
        if (_disposed)
        {
            return;
        }

        _error = message;
        await LoadRollbackPreviewAsync(preserveError: true);
        if (!_disposed)
        {
            _saving = false;
        }
    }

    private void OnPreviewLoadingChanged(bool loading)
    {
        _loadingDiffPreview = loading;
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    public void Dispose()
    {
        _disposed = true;
        ++_previewGeneration;
        _previewCancellation?.Cancel();
        _previewCancellation?.Dispose();
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
