@inject IStringLocalizer<RepositoryUIResource> L

<dl class="rp-key-values">
    @foreach (var (label, value, copy, role) in Items)
    {
        <div>
            <dt>@label</dt>
            <dd class="rp-key-value">
                @if (role is { } visualRole)
                {
                    <span class="mo-vl-capsule @visualRole.ToCssClass()">@value</span>
                }
                else
                {
                    <code>@(string.IsNullOrWhiteSpace(value) ? L["Persistence:Unavailable"].Value : value)</code>
                }
                @if (copy && !string.IsNullOrWhiteSpace(value))
                {
                    <MoCopyButton Value="@value" Label="@L["Persistence:CopyField", label]" />
                }
            </dd>
        </div>
    }
</dl>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Entry> Items { get; set; } = [];

    public readonly record struct Entry(string Label, string? Value, bool Copy = false, MoVisualRole? Role = null);
}
