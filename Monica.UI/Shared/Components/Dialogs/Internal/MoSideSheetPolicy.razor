@using Monica.UI.Shell.Support
@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@implements IAsyncDisposable
@inject IJSRuntime JS

<button type="button" @ref="_escape" hidden data-dismiss-on-escape="@(DismissRequested.HasDelegate ? "true" : null)"
        @onclick="DismissRequested"></button>

@code {
    [CascadingParameter] private IMudDialogInstance DialogInstance { get; set; } = default!;
    [Parameter, EditorRequired] public DialogOptions Options { get; set; } = default!;
    [Parameter] public EventCallback DismissRequested { get; set; }
    [Parameter] public bool FocusCloseOnOpen { get; set; }
    private DialogOptions? _applied;
    private ElementReference _escape;
    private JsModuleSession? _interop;
    private bool _retired;

    protected override async Task OnParametersSetAsync()
    {
        if (_applied == Options) return;
        _applied = Options;
        // This runs inside the native portal, including when its inline owner changes dismissal policy.
        await DialogInstance.SetOptionsAsync(Options);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_retired || (!DismissRequested.HasDelegate && !FocusCloseOnOpen) || _interop is not null) return;
        _interop = new(JS, "./_content/Monica.UI/js/side-sheet.js");
        try { await _interop.InvokeVoidAsync("bindSheet", _escape, firstRender && FocusCloseOnOpen); }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _retired = true;
        if (_interop is not null) await _interop.DisposeAsync();
    }
}
