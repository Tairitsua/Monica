<div class="mo-content-state @(Compact ? "mo-content-state--compact" : null) @Class"
     role="@(Loading ? "status" : null)" aria-busy="@(Loading ? "true" : null)" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Gets or sets localized state content, such as an icon, heading, explanation, and recovery action.</summary>
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }

    /// <summary>Gets or sets whether the caller is loading. Enables a polite status announcement and busy semantics.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>Gets or sets the compact treatment for a nested card or table; false reserves a standard results region.</summary>
    [Parameter] public bool Compact { get; set; }

    /// <summary>Gets or sets an optional identification class. The shared component owns alignment and spacing.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Gets or sets native attributes such as an accessible label, explicit status role, or test identity.</summary>
    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
