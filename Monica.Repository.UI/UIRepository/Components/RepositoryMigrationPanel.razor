@inject IStringLocalizer<RepositoryUIResource> L
@using static Monica.Repository.UI.UIRepository.Support.RepositoryPresentation

@{
    var state = Workbench.State;
    var registry = state.Contexts;
    var pending = registry.Where(context => !Incomplete(context) && context.PendingMigrationCount > 0).ToArray();
    var unreadable = registry.Where(Incomplete).ToArray();
    var aligned = registry.Count - unreadable.Length - pending.Length;
    var applied = registry.Sum(context => context.MigrationStatus?.AppliedCurrentAssemblyMigrations.Count ?? 0);
    var status = Context.MigrationStatus;
    var external = status is { HasError: false } ? status.ExternalAppliedMigrations : [];
    var timeout = state.MigrationCommandTimeout.TotalMinutes >= 1
        ? L["Persistence:CommandMinutes", state.MigrationCommandTimeout.TotalMinutes.ToString("0.##")].Value
        : Duration(state.MigrationCommandTimeout, L);
}
@if (!state.MigrationUpdatesEnabled)
{
    <MoSemanticCallout Severity="MoVisualRole.Warning" Icon="@MoIcons.Lock" Title="@L["Persistence:ProductionLock"]">
        @L["Migrations:DisabledInProduction"]
    </MoSemanticCallout>
}
<section class="mo-vl-surface rp-mig-sig">
    <RepositoryDecision Label="@L["Persistence:KnownPending"]" Value="@Workbench.PendingDisplay"
                        Population="@L["Persistence:MigrationPopulation", pending.Length, registry.Count]"
                        Annotation="@(unreadable.Length > 0 ? L["Persistence:PartialMigrationBadge", unreadable.Length].Value : null)"
                        Reasons="@(new (string, MoVisualRole, string)[] {
                            (L["Persistence:ContextsPending"], MoVisualRole.Warning, pending.Length.ToString()),
                            (L["Persistence:ContextsAligned"], MoVisualRole.Success, aligned.ToString()),
                            (L["Persistence:Unreadable"], MoVisualRole.Error, unreadable.Length.ToString()),
                            (L["Persistence:SelectedExternal"], MoVisualRole.Third, status is { HasError: false } ? external.Count.ToString() : "—")
                        })">
        @if (pending.Length == 0 && unreadable.Length == 0)
        {
            <MoRichFinding Template="@L["Persistence:MigrationsCalm"]" Values="@(new RenderFragment[] { Mark(registry.Count, MoVisualRole.Success) })" />
        }
        else
        {
            @if (pending.Length > 0)
            {
                <MoRichFinding Template="@L["Persistence:MigrationFinding"]" Values="@(new RenderFragment[] { ContextLinks(pending, MoVisualRole.Warning), Mark(Workbench.KnownPending, MoVisualRole.Warning) })" />
                @(" ")
            }
            @if (unreadable.Length > 0)
            {
                <MoRichFinding Template="@L["Persistence:UnreadableFinding"]" Values="@(new RenderFragment[] { ContextLinks(unreadable, MoVisualRole.Error) })" />
            }
        }
        @if (!state.MigrationUpdatesEnabled) { @(" ")@L["Persistence:ProductionFinding"] }
    </RepositoryDecision>
    <RepositoryFacts Label="@L["Persistence:KnownPending"]" Items="@(
        new (string, string, string, MoVisualRole)[] {
            (L["Persistence:ContextsPending"], $"{pending.Length}/{registry.Count}", L["Persistence:PendingContextsFact"], MoVisualRole.Warning),
            (L["Persistence:KnownPending"], Workbench.PendingDisplay, unreadable.Length == 0 ? L["Persistence:KnownPendingFact"] : L["Persistence:IncompleteCount", unreadable.Length], MoVisualRole.Warning),
            (L["Persistence:AppliedInAssembly"], applied.ToString(), L["Persistence:AssemblyAppliedFact"], MoVisualRole.Success),
            (L["Persistence:CommandTimeout"], timeout, L["Persistence:CommandTimeoutFact"], MoVisualRole.Third)
        })" />
    <RepositoryMigrationTrack Workbench="Workbench" SelectedId="@Context.Registration.ContextId" />
</section>

<section class="mo-vl-surface rp-mig-detail">
    <header class="mo-vl-surface-heading rp-surface-heading">
        <span class="mo-vl-tile @StandingRole(Standing(Context)).ToCssClass()"><MoIcon Icon="@MoIcons.Workflow" Size="16px" /></span>
        <div class="rp-heading-copy"><h2>@Context.Registration.DbContextName</h2><p>@L["Persistence:CommandScope", timeout]</p></div>
        <div class="rp-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Download" Size="Size.Small"
                       Disabled="@(!state.MigrationUpdatesEnabled || Workbench.Busy || state.ErrorMessage is not null || Context.PendingMigrationCount is not > 0)"
                       OnClick="@(() => Workbench.ConfirmUpdateAsync(Context, false))">@L["Migrations:Actions:UpdateSelected"]</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.CheckCheck" Size="Size.Small"
                       Disabled="@(!state.MigrationUpdatesEnabled || Workbench.Busy || state.ErrorMessage is not null || pending.Length == 0)"
                       OnClick="@(() => Workbench.ConfirmUpdateAsync(Context, true))">@L["Persistence:UpdateAll", Workbench.KnownPending]</MudButton>
        </div>
    </header>
    <div class="mo-vl-surface-body">
        <div class="rp-chips rp-mig-meta">
            <span class="rp-tag mono">@L["Persistence:AssemblyName"] · @(Context.MigrationAssembly ?? Context.Registration.AssemblyName)</span>
            <span class="rp-tag mono">@(Context.Connection?.Database ?? L["Persistence:Unavailable"].Value)</span>
            <span class="rp-tag mono">@(Context.ProviderName ?? L["Persistence:Unavailable"].Value)</span>
        </div>
        @if (status is null || status.HasError)
        {
            <MoSemanticCallout Severity="MoVisualRole.Error" Title="@L["Persistence:MigrationReadFailed"]">
                <code class="rp-read-error">@(status?.ErrorMessage ?? Context.ErrorMessage ?? L["Persistence:Unavailable"].Value)</code>
            </MoSemanticCallout>
        }
        else
        {
            <RepositoryFacts Label="@L["Persistence:MigrationReconciliation"]" Items="@(
                new (string, string, string, MoVisualRole)[] {
                    (L["Persistence:CurrentAssembly"], status.AllMigrations.Count.ToString(), "", MoVisualRole.Neutral),
                    (L["Persistence:AppliedInAssembly"], status.AppliedCurrentAssemblyMigrations.Count.ToString(), "", MoVisualRole.Success),
                    (L["Migrations:States:Pending"], status.PendingMigrations.Count.ToString(), "", MoVisualRole.Warning),
                    (L["Persistence:ExternalHistory"], external.Count.ToString(), "", MoVisualRole.Third)
                })" />
            <RepositoryMigrationInventory Workbench="Workbench" Status="status" External="external" />
        }
    </div>
</section>

@if (state.MigrationCommandError is { } failure)
{
    <MoSemanticCallout Severity="MoVisualRole.Error" Title="@L["Migrations:Messages:UpdateFailed"]"><code class="rp-read-error">@failure</code></MoSemanticCallout>
}
@if (state.UpdateResults.Count > 0)
{
    <section class="mo-vl-surface rp-mig-results">
        <header class="mo-vl-surface-heading rp-surface-heading">
            <span class="mo-vl-tile mo-vl-role--primary"><MoIcon Icon="@MoIcons.ClipboardCheck" Size="16px" /></span>
            <div class="rp-heading-copy"><h2>@L["Persistence:LastOutcomes"]</h2><p>@L["Persistence:OutcomesNote"]</p></div>
            <span class="rp-pill mo-vl-role--primary mono">@state.UpdateResults.Count</span>
        </header>
        <div class="mo-vl-surface-body rp-table-wrap">
            <table class="rp-table rp-results-table">
                <thead><tr>
                    <th scope="col">@L["Migrations:Results:Columns:Context"]</th><th scope="col">@L["Migrations:Results:Columns:Status"]</th>
                    <th scope="col">@L["Migrations:Results:Columns:Attempted"]</th><th scope="col">@L["Migrations:Results:Columns:Duration"]</th>
                    <th scope="col">@L["Migrations:Results:Columns:Message"]</th>
                </tr></thead>
                <tbody>
                    @foreach (var result in state.UpdateResults)
                    {
                        var tone = !result.Succeeded ? MoVisualRole.Error : result.Skipped ? MoVisualRole.Neutral : MoVisualRole.Success;
                        <tr>
                            <td data-label="@L["Migrations:Results:Columns:Context"]"><b>@result.Registration.DbContextName</b><small class="mono">@result.Registration.AssemblyName</small></td>
                            <td data-label="@L["Migrations:Results:Columns:Status"]">
                                <span class="rp-pill @tone.ToCssClass()"><i class="rp-swatch"></i>@L[!result.Succeeded ? "Migrations:Results:Status:Failed" : result.Skipped ? "Migrations:Results:Status:Skipped" : "Migrations:Results:Status:Succeeded"]</span>
                            </td>
                            <td data-label="@L["Migrations:Results:Columns:Attempted"]">
                                @if (result.AttemptedMigrations.Count > 0)
                                {
                                    <details class="rp-attempted"><summary class="mono">@L["Persistence:AttemptedCount", result.AttemptedMigrations.Count]</summary>
                                        <ul>@foreach (var id in result.AttemptedMigrations) { <li><code>@id</code></li> }</ul>
                                    </details>
                                }
                                else { <span class="mono">0</span> }
                            </td>
                            <td data-label="@L["Migrations:Results:Columns:Duration"]"><code>@Duration(result.Duration, L)</code></td>
                            <td data-label="@L["Migrations:Results:Columns:Message"]">
                                @(result.Succeeded
                                    ? result.Skipped ? L["Migrations:Messages:NoPending"].Value : L["Migrations:Messages:UpdateSucceeded", result.Registration.DbContextName].Value
                                    : result.ErrorMessage ?? L["Migrations:Messages:UpdateFailed"].Value)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public RepositoryWorkbench Workbench { get; set; } = null!;
    [Parameter, EditorRequired] public RepositoryDbContextSnapshot Context { get; set; } = null!;

    private static RenderFragment Mark(int value, MoVisualRole role) => @<MoValueMark Role="role">@value</MoValueMark>;
    private RenderFragment ContextLinks(IReadOnlyList<RepositoryDbContextSnapshot> contexts, MoVisualRole role) => @<text>
        @for (var i = 0; i < contexts.Count; i++)
        {
            var context = contexts[i];
            if (i > 0) { @L["Persistence:ListSeparator"] }
            <MoValueMark Role="role" Href="@Workbench.Url(("context", context.Registration.ContextId))">@context.Registration.DbContextName</MoValueMark>
        }
    </text>;
}
