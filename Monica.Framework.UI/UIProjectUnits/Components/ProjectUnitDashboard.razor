@using Monica.UI.Shared.Components.States
@using System.Globalization
@using Monica.Core.Results
@using Monica.Framework.UI.UIProjectUnits.Services
@using Monica.ProjectUnits.Models
@inject IProjectUnitsUiDataSource DataSource
@inject IStringLocalizer<ProjectUnitsResource> L
@implements IDisposable

<section class="pu-dashboard" data-testid="project-unit-dashboard">
    @if (_loading && _snapshot is null)
    {
        <div class="pu-dashboard__state" data-testid="project-unit-dashboard-loading"><MoContentState Loading="true"><MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
            <p>@L["ProjectUnitDashboard:States:Loading"]</p>
        </MoContentState></div>
    }
    @if (_error is not null)
    {
        <div class="pu-dashboard__error" data-testid="project-unit-dashboard-error" role="status"><MoContentState>
            <h2>@L["ProjectUnitDashboard:States:LoadFailedTitle"]</h2>
            <p>@_error</p>
            @if (_snapshot is not null)
            {
                <p>@L["ProjectUnitDashboard:States:Retained"]</p>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadDashboardAsync" Disabled="@_loading">
                @L["ProjectUnitDashboard:Actions:Retry"]
            </MudButton>
        </MoContentState></div>
    }
    @if (_snapshot is not null)
    {
        <div class="pu-dashboard__board">
            <section class="pu-dashboard__identity">
                <div class="pu-dashboard__identity-heading">
                    <span class="pu-dashboard__eyebrow">@L["ProjectUnitDashboard:Service:Eyebrow"]</span>
                    <MoIcon Icon="@MoIcons.Workflow" Size="1.5rem" />
                </div>
                <h2>@_snapshot.Service.AppName</h2>
                @if (!string.IsNullOrWhiteSpace(_snapshot.Service.AppVersion))
                {
                    <span class="pu-dashboard__version">@_snapshot.Service.AppVersion</span>
                }
                <div class="pu-dashboard__service">
                    @if (ShouldShowProjectName(_snapshot.Service))
                    {
                        <span data-testid="project-unit-service-project-name">@L["ProjectUnitDashboard:Service:ProjectName", _snapshot.Service.ProjectName]</span>
                    }
                    @if (ShouldShowAppId(_snapshot.Service))
                    {
                        <span data-testid="project-unit-service-app-id">@L["ProjectUnitDashboard:Service:AppId", _snapshot.Service.AppId]</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_snapshot.Service.DomainName))
                    {
                        <span>@L["ProjectUnitDashboard:Service:Domain", _snapshot.Service.DomainName]</span>
                    }
                </div>
                <div class="pu-dashboard__inventory" data-testid="project-unit-dashboard-metrics">
                    <div><strong>@_snapshot.TotalUnits</strong><span>@L["ProjectUnitDashboard:Metrics:TotalUnits"]</span></div>
                    <div><strong>@_snapshot.DistinctUnitTypes</strong><span>@L["ProjectUnitDashboard:Metrics:UnitTypes"]</span></div>
                </div>
                <p class="pu-dashboard__scope">@L["ProjectUnitDashboard:Service:Scope"]</p>
                <div class="pu-dashboard__entry-links">
                    <NavLink href="/project-units/catalog">@L["Page:Tabs:ProjectUnit"] <MoIcon Icon="@MoIcons.ArrowRight" Size="1.25rem" /></NavLink>
                    <NavLink href="/project-units/graph">@L["Page:Tabs:ArchitectureVisualization"] <MoIcon Icon="@MoIcons.ArrowRight" Size="1.25rem" /></NavLink>
                </div>
                <MudButton Variant="Variant.Outlined" OnClick="LoadDashboardAsync" Disabled="@_loading"
                           StartIcon="@MoIcons.Refresh" Class="pu-dashboard__refresh">
                    @L["Shared:Actions:Refresh"]
                </MudButton>
            </section>
            <section class="pu-dashboard__context" data-testid="project-unit-coverage">
                <header>
                    <div><span class="pu-dashboard__eyebrow">@L["ProjectUnitDashboard:Sections:CoverageEyebrow"]</span><h3>@L["ProjectUnitDashboard:Sections:Coverage"]</h3></div>
                    <span class="pu-dashboard__whole">@L["ProjectUnitDashboard:Sections:WholeCatalog"]</span>
                </header>
                <p>@L["ProjectUnitDashboard:Sections:CoverageHint"]</p>
                <div class="pu-dashboard__coverage">
                    @foreach (var metric in _snapshot.Coverage)
                    {
                        <div class="pu-dashboard__coverage-item">
                            <div class="pu-dashboard__coverage-title">
                                <h4>@GetCoverageTitle(metric.Kind)</h4>
                                <strong>@FormatPercentage(metric.Percentage)</strong>
                            </div>
                            <span>@L["ProjectUnitDashboard:Coverage:Ratio", metric.Covered, metric.Total]</span>
                            <MudProgressLinear Value="@ToDouble(metric.Percentage)" Color="@GetCoverageColor(metric.Kind)" Size="Size.Small" />
                        </div>
                    }
                </div>

            </section>
                <section class="pu-dashboard__topology" data-testid="project-unit-architecture-health">
                    <h4>@L["ProjectUnitDashboard:Sections:ArchitectureHealth"]</h4>
                    <p>@L["ProjectUnitDashboard:Sections:ArchitectureHealthHint"]</p>
                    <dl>
                        <div><dt>@L["ProjectUnitDashboard:Health:DependencyEdges"]</dt><dd>@_snapshot.Dependencies.EdgeCount</dd></div>
                        <div><dt>@L["ProjectUnitDashboard:Health:IsolatedUnits"]</dt><dd>@_snapshot.Dependencies.IsolatedUnitCount</dd></div>
                        <div><dt>@L["ProjectUnitDashboard:Health:Errors"]</dt><dd data-severity="error">@_snapshot.Alerts.ErrorCount</dd></div>
                        <div><dt>@L["ProjectUnitDashboard:Health:Warnings"]</dt><dd data-severity="warning">@_snapshot.Alerts.WarningCount</dd></div>
                        <div><dt>@L["ProjectUnitDashboard:Health:Information"]</dt><dd>@_snapshot.Alerts.InformationCount</dd></div>
                    </dl>
                </section>
        </div>
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        @if (_snapshot.TotalUnits == 0)
        {
            <div class="pu-dashboard__state" data-testid="project-unit-dashboard-empty"><MoContentState>
                <MoIcon Icon="@MoIcons.Package" Size="1.5rem" />
                <h3>@L["ProjectUnitDashboard:States:EmptyTitle"]</h3>
                <p>@L["ProjectUnitDashboard:States:EmptyDescription"]</p>
            </MoContentState></div>
        }
        else
        {
            <section class="pu-dashboard__composition" data-testid="project-unit-type-distribution">
                <header><h3>@L["ProjectUnitDashboard:Sections:Distribution"]</h3><p>@L["ProjectUnitDashboard:Sections:DistributionHint"]</p></header>
                <div class="pu-dashboard__segments" aria-hidden="true">
                    @foreach (var statistic in _snapshot.UnitTypes)
                    {
                        <span style="@GetSegmentStyle(statistic)"></span>
                    }
                </div>
                <ul class="pu-dashboard__type-ledger">
                    @foreach (var statistic in _snapshot.UnitTypes)
                    {
                        <li>
                            <span class="pu-dashboard__type-dot" style="@GetTypeColorStyle(statistic.UnitType)" aria-hidden="true"></span>
                            <span>@L.GetProjectUnitTypeText(statistic.UnitType)</span>
                            <strong>@statistic.Count</strong><span class="pu-dashboard__proportion">@FormatPercentage(statistic.Percentage)</span>
                        </li>
                    }
                </ul>
            </section>
            <section class="pu-dashboard__attention" data-testid="project-unit-coverage-gaps">
                <header>
                    <div><span class="pu-dashboard__eyebrow">@L["ProjectUnitDashboard:Sections:AttentionEyebrow"]</span><h3>@L["ProjectUnitDashboard:Sections:CoverageGaps"]</h3><p>@L["ProjectUnitDashboard:Sections:CoverageGapsHint"]</p></div>
                    <span class="pu-dashboard__attention-total">@_snapshot.CoverageGaps.Count</span>
                </header>
                @if (_snapshot.CoverageGaps.Count == 0)
                {
                    <MoContentState Compact="true"><p>@L["ProjectUnitDashboard:States:NoCoverageGaps"]</p></MoContentState>
                }
                else
                {
                    <div class="pu-dashboard__gap-filters">
                        <label class="pu-dashboard__gap-query">@L["ProjectUnitDashboard:Filters:Search"]<input type="search" value="@_gapQuery" @oninput="OnGapQueryChanged" placeholder="@L["ProjectUnitDashboard:Filters:Placeholder"]" /></label>
                        <label>@L["ProjectUnitDashboard:Filters:Type"]
                            <select value="@_gapType" @onchange="OnGapTypeChanged">
                                <option value="">@L["ProjectUnitDashboard:Filters:AllTypes"]</option>
                                @foreach (var type in _snapshot.UnitTypes)
                                {
                                    <option value="@type.UnitType">@L.GetProjectUnitTypeText(type.UnitType)</option>
                                }
                            </select>
                        </label>
                        <label>@L["ProjectUnitDashboard:Filters:Missing"]
                            <select value="@_gapCoverage" @onchange="OnGapCoverageChanged">
                                <option value="">@L["ProjectUnitDashboard:Filters:AllGaps"]</option>
                                @foreach (var kind in Enum.GetValues<ProjectUnitCoverageKind>())
                                {
                                    <option value="@kind">@GetCoverageTitle(kind)</option>
                                }
                            </select>
                        </label>
                        <label class="pu-dashboard__gap-alerts"><input type="checkbox" checked="@_gapOnlyAlerts" @onchange="OnGapAlertsChanged" />@L["ProjectUnitDashboard:Filters:OnlyAlerts"]</label>
                    </div>
                    <div class="pu-dashboard__gap-result">
                        <span>@L["ProjectUnitDashboard:Gaps:VisibleCount", _filteredGaps.Count, _snapshot.CoverageGaps.Count]</span>
                        @if (HasGapFilters)
                        {
                            <button type="button" @onclick="ResetGapFilters">@L["ProjectUnitDashboard:Filters:Reset"]</button>
                        }
                    </div>
                    @if (_filteredGaps.Count == 0)
                    {
                        <div class="pu-dashboard__state" role="status"><MoContentState><p>@L["ProjectUnitDashboard:States:NoGapMatches"]</p><button type="button" @onclick="ResetGapFilters">@L["ProjectUnitDashboard:Filters:Reset"]</button></MoContentState></div>
                    }
                    else
                    {
                        <ul class="pu-dashboard__gap-list">
                            @foreach (var gap in PagedGaps)
                            {
                                <li data-unit-key="@gap.Unit.Key">
                                    <div class="pu-dashboard__gap-identity"><strong>@gap.Unit.Title</strong><code>@gap.Unit.Key</code><span>@L.GetProjectUnitTypeText(gap.Unit.UnitType)</span></div>
                                    <div class="pu-dashboard__gap-evidence">
                                        <div class="pu-dashboard__gap-reasons">
                                            @foreach (var missing in gap.MissingCoverage)
                                            {
                                                <span>@L["ProjectUnitDashboard:Gaps:Missing", GetCoverageTitle(missing)]</span>
                                            }
                                        </div>
                                        @if (gap.Unit.Alerts.Count != 0)
                                        {
                                            <span class="pu-dashboard__gap-diagnostic" data-severity="@GetAlertTone(gap.Unit)"><MoIcon Icon="@MoIcons.Info" Size="1.25rem" />@L["ProjectUnitDashboard:Gaps:Alerts", gap.Unit.Alerts.Count]</span>
                                        }
                                    </div>
                                    <MudIconButton Icon="@MoIcons.ArrowRight" Size="Size.Small" Color="Color.Primary"
                                                   aria-label="@L["ProjectUnitDashboard:Actions:Inspect", gap.Unit.Title]" OnClick="@(() => OpenDetail(gap.Unit))" />
                                </li>
                            }
                        </ul>
                        <footer class="pu-dashboard__pager">
                            <span>@L["ProjectUnitDashboard:Gaps:PageRange", _gapPage * _gapPageSize + 1, Math.Min((_gapPage + 1) * _gapPageSize, _filteredGaps.Count), _filteredGaps.Count]</span>
                            <label>@L["ProjectUnitDashboard:Gaps:PageSize"]<select value="@_gapPageSize" @onchange="OnGapPageSizeChanged"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select></label>
                            <div class="pu-dashboard__page-actions">
                                <button type="button" disabled="@(_gapPage == 0)" aria-label="@L["ProjectUnitDashboard:Gaps:FirstPage"]" @onclick="@(() => SetGapPage(0))"><MoIcon Icon="@MoIcons.FirstPage" Size="1.25rem" /></button>
                                <button type="button" disabled="@(_gapPage == 0)" aria-label="@L["ProjectUnitDashboard:Gaps:PreviousPage"]" @onclick="@(() => SetGapPage(_gapPage - 1))"><MoIcon Icon="@MoIcons.ChevronLeft" Size="1.25rem" /></button>
                                <span>@L["ProjectUnitDashboard:Gaps:PageNumber", _gapPage + 1, GapPageCount]</span>
                                <button type="button" disabled="@(_gapPage >= GapPageCount - 1)" aria-label="@L["ProjectUnitDashboard:Gaps:NextPage"]" @onclick="@(() => SetGapPage(_gapPage + 1))"><MoIcon Icon="@MoIcons.ChevronRight" Size="1.25rem" /></button>
                                <button type="button" disabled="@(_gapPage >= GapPageCount - 1)" aria-label="@L["ProjectUnitDashboard:Gaps:LastPage"]" @onclick="@(() => SetGapPage(GapPageCount - 1))"><MoIcon Icon="@MoIcons.LastPage" Size="1.25rem" /></button>
                            </div>
                        </footer>
                    }
                }
            </section>
        }
    }
</section>

<ProjectUnitDetailDialog @bind-Visible="_detailDialogVisible" SelectedUnit="_selectedUnit" />

@code {
    private ProjectUnitDashboardSnapshot? _snapshot;
    private string? _error;
    private bool _loading;
    private bool _disposed;
    private int _loadVersion;
    private bool _detailDialogVisible;
    private ProjectUnitSummary? _selectedUnit;
    private string _gapQuery = string.Empty;
    private string _gapType = string.Empty;
    private string _gapCoverage = string.Empty;
    private bool _gapOnlyAlerts;
    private int _gapPage;
    private int _gapPageSize = 10;
    private List<ProjectUnitCoverageGap> _filteredGaps = [];
    private bool HasGapFilters => !string.IsNullOrEmpty(_gapQuery) || !string.IsNullOrEmpty(_gapType) || !string.IsNullOrEmpty(_gapCoverage) || _gapOnlyAlerts;
    private int GapPageCount => Math.Max(1, (_filteredGaps.Count + _gapPageSize - 1) / _gapPageSize);
    private IEnumerable<ProjectUnitCoverageGap> PagedGaps => _filteredGaps.Skip(_gapPage * _gapPageSize).Take(_gapPageSize);

    protected override Task OnInitializedAsync() => LoadDashboardAsync();

    private async Task LoadDashboardAsync()
    {
        if (_disposed || _loading) return;
        var version = ++_loadVersion;
        _loading = true;
        _error = null;
        try
        {
            var result = await DataSource.GetDashboardAsync();
            if (_disposed || version != _loadVersion) return;
            if (result.IsFailed(out var error, out var snapshot))
            {
                _error = L["ProjectUnitDashboard:States:LoadFailed", error];
                return;
            }
            _snapshot = snapshot;
            if (!string.IsNullOrEmpty(_gapType) && !(_snapshot?.UnitTypes.Any(type => type.UnitType.ToString() == _gapType) ?? false))
            {
                _gapType = string.Empty;
            }
            ApplyGapFilters(resetPage: false);
        }
        catch (Exception exception)
        {
            if (!_disposed && version == _loadVersion) _error = L["ProjectUnitDashboard:States:LoadFailed", exception.Message];
        }
        finally
        {
            if (!_disposed && version == _loadVersion) _loading = false;
        }
    }

    private void OnGapQueryChanged(ChangeEventArgs args) { _gapQuery = args.Value?.ToString() ?? string.Empty; ApplyGapFilters(); }
    private void OnGapTypeChanged(ChangeEventArgs args) { _gapType = args.Value?.ToString() ?? string.Empty; ApplyGapFilters(); }
    private void OnGapCoverageChanged(ChangeEventArgs args) { _gapCoverage = args.Value?.ToString() ?? string.Empty; ApplyGapFilters(); }
    private void OnGapAlertsChanged(ChangeEventArgs args) { _gapOnlyAlerts = args.Value is true; ApplyGapFilters(); }
    private void OnGapPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var size) && size is 10 or 25 or 50)
        {
            _gapPageSize = size;
            _gapPage = 0;
        }
    }
    private void SetGapPage(int page) => _gapPage = Math.Clamp(page, 0, GapPageCount - 1);
    private void ResetGapFilters()
    {
        _gapQuery = _gapType = _gapCoverage = string.Empty;
        _gapOnlyAlerts = false;
        ApplyGapFilters();
    }
    private void ApplyGapFilters(bool resetPage = true)
    {
        if (_disposed) return;
        _filteredGaps = (_snapshot?.CoverageGaps ?? []).Where(gap =>
            (string.IsNullOrWhiteSpace(_gapQuery) || gap.Unit.Title.Contains(_gapQuery, StringComparison.OrdinalIgnoreCase)
                || gap.Unit.Key.Contains(_gapQuery, StringComparison.OrdinalIgnoreCase)
                || (gap.Unit.Owner?.Contains(_gapQuery, StringComparison.OrdinalIgnoreCase) ?? false)
                || (gap.Unit.Description?.Contains(_gapQuery, StringComparison.OrdinalIgnoreCase) ?? false)
                || gap.Unit.Tags.Any(tag => tag.Contains(_gapQuery, StringComparison.OrdinalIgnoreCase)))
            && (string.IsNullOrEmpty(_gapType) || gap.Unit.UnitType.ToString() == _gapType)
            && (string.IsNullOrEmpty(_gapCoverage) || gap.MissingCoverage.Any(kind => kind.ToString() == _gapCoverage))
            && (!_gapOnlyAlerts || gap.Unit.Alerts.Count != 0)).ToList();
        _gapPage = resetPage ? 0 : Math.Clamp(_gapPage, 0, GapPageCount - 1);
    }

    private string GetCoverageTitle(ProjectUnitCoverageKind kind) => kind switch
    {
        ProjectUnitCoverageKind.Metadata => L["ProjectUnitDashboard:Coverage:Metadata"],
        ProjectUnitCoverageKind.Description => L["ProjectUnitDashboard:Coverage:Description"],
        ProjectUnitCoverageKind.Ownership => L["ProjectUnitDashboard:Coverage:Ownership"],
        ProjectUnitCoverageKind.Requirements => L["ProjectUnitDashboard:Coverage:Requirements"],
        _ => kind.ToString()
    };
    private static Color GetCoverageColor(ProjectUnitCoverageKind kind) => kind switch
    {
        ProjectUnitCoverageKind.Metadata => Color.Primary,
        ProjectUnitCoverageKind.Description => Color.Info,
        ProjectUnitCoverageKind.Ownership => Color.Success,
        ProjectUnitCoverageKind.Requirements => Color.Secondary,
        _ => Color.Default
    };
    private static string GetSegmentStyle(ProjectUnitTypeStatistics statistic) =>
        $"flex-grow:{statistic.Percentage.ToString(CultureInfo.InvariantCulture)};background:{GetTypeColor(statistic.UnitType)}";
    private static string GetTypeColorStyle(EProjectUnitType type) => $"background:{GetTypeColor(type)}";
    private static string GetTypeColor(EProjectUnitType type) => ProjectUnitVisualizationConfig.GetUnitTypeColorRole(type) switch
    {
        "primary" => "var(--mud-palette-primary)",
        "secondary" => "var(--mud-palette-secondary)",
        "tertiary" => "var(--mud-palette-tertiary)",
        "success" => "var(--mud-palette-success)",
        "warning" => "var(--mud-palette-warning)",
        "info" => "var(--mud-palette-info)",
        "error" => "var(--mud-palette-error)",
        _ => "var(--mud-palette-text-secondary)"
    };
    private static bool ShouldShowProjectName(ProjectUnitServiceIdentity service) => !string.Equals(service.ProjectName, service.AppName, StringComparison.OrdinalIgnoreCase);
    private static bool ShouldShowAppId(ProjectUnitServiceIdentity service) => !string.Equals(service.AppId, service.AppName, StringComparison.OrdinalIgnoreCase) && !string.Equals(service.AppId, service.ProjectName, StringComparison.OrdinalIgnoreCase);
    private static string FormatPercentage(decimal? percentage) => percentage is null ? "--" : $"{percentage:0.#}%";
    private static double ToDouble(decimal? value) => value is null ? 0d : decimal.ToDouble(value.Value);
    private static string GetAlertTone(ProjectUnitSummary unit) => unit.Alerts.Any(alert => alert.Level == EAlertLevel.Error) ? "error" : unit.Alerts.Any(alert => alert.Level == EAlertLevel.Warning) ? "warning" : "info";
    private void OpenDetail(ProjectUnitSummary unit)
    {
        if (_disposed) return;
        _selectedUnit = unit;
        _detailDialogVisible = true;
    }
    public void Dispose() { _disposed = true; ++_loadVersion; }
}
