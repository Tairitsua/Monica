@using Microsoft.Extensions.Localization
@using Monica.Markdown.Localization
@using Monica.Markdown.Models
@using Monica.Tool.Algorithms.Trees
@inject IStringLocalizer<MarkdownResource> L

<div class="sidebar">
    <div class="sidebar-group-switcher">
        <DocumentLibrarySwitcher CurrentGroup="CurrentGroup" CurrentCulture="@CurrentCulture" OnOpen="OnOpenGroupSwitcher" />
    </div>
    <div class="sidebar-pane-header">
        <h2 class="sidebar-pane-label">@L["MarkdownViewer:Toolbar:DocumentTree"]</h2>
        <span class="sidebar-pane-rule" aria-hidden="true"></span>
    </div>

    <div class="sidebar-tree">
        @if (!string.IsNullOrWhiteSpace(TreeError))
        {
            <div class="sidebar-error" role="status">
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Icon="@MoIcons.Error">
                    <MudText Typo="Typo.body2">@L["MarkdownViewer:States:TreeFailed"]</MudText>
                    <div class="sidebar-error-detail">@TreeError</div>
                </MudAlert>
            </div>
        }
        else if (CurrentTree is not null)
        {
            <DocumentTreePanel TreeRoot="CurrentTree"
                               SelectedDocument="SelectedDocument"
                               SelectedDocumentChanged="SelectedDocumentChanged" />
        }
    </div>
    <div class="sidebar-footer">
        <span class="footer-value" title="@FooterValue">@FooterValue</span>
        <MudIconButton Icon="@MoIcons.ChevronLeft"
                       Size="Size.Small"
                       OnClick="OnCollapseRequested"
                       title="@L["MarkdownViewer:Navbar:HideSidebar"]"
                       aria-label="@L["MarkdownViewer:Navbar:HideSidebar"]"
                       Class="sidebar-collapse-button" />
    </div>
</div>

@code {
    [Parameter]
    public MarkdownDocumentGroup? CurrentGroup { get; set; }

    [Parameter]
    public TreeNode<MarkdownDocumentNodeData>? CurrentTree { get; set; }

    [Parameter]
    public string? CurrentCulture { get; set; }

    /// <summary>
    /// Gets or sets the page-owned tree load error. Defaults to null.
    /// A nonempty error replaces the tree with encoded diagnostic text; loading and retry remain page-owned.
    /// </summary>
    [Parameter]
    public string? TreeError { get; set; }

    [Parameter]
    public MarkdownDocument? SelectedDocument { get; set; }

    [Parameter]
    public EventCallback<MarkdownDocument?> SelectedDocumentChanged { get; set; }

    [Parameter]
    public EventCallback OnCollapseRequested { get; set; }

    /// <summary>
    /// Requests the page-owned library chooser. Defaults to an unassigned callback; the sidebar does not own dialog lifetime or selection state.
    /// </summary>
    [Parameter]
    public EventCallback OnOpenGroupSwitcher { get; set; }

    private string FooterValue => !string.IsNullOrWhiteSpace(CurrentGroup?.Key)
        ? CurrentGroup.Key
        : CurrentGroup?.Title ?? L["MarkdownViewer:Navbar:UnknownKnowledgeBase"].Value;
}
